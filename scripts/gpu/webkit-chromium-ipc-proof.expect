#!/usr/bin/env expect

set timeout 180
set root [exec sh -c "cd [file dirname [info script]]/../.. && pwd"]
set build "$root/build-x86_64"
set kernel "$build/kernel/build/kernel/xv6.bin"
set fsimg [expr {[info exists env(FSIMG)] && $env(FSIMG) ne "" ? $env(FSIMG) : "$build/fs.img"}]
set stamp [clock format [clock seconds] -gmt 1 -format "%Y%m%dT%H%M%SZ"]
set outdir "$build/webkit-chromium-ipc-proof/$stamp"
exec mkdir -p $outdir
set runlog "$outdir/run.log"
set status "$outdir/status.txt"

set env(DISPLAY_MODE) "nographic"
set env(USE_KVM) "1"
set env(QEMU_GPU) "none"
set env(QEMU_INPUT) "virtio"
set env(QEMU_NET) "0"
set env(QEMU_AUDIO) "none"
set env(QEMU_APPEND) "root=/dev/disk0 netsurf=0 webkit=0 glsmoke=0 desktop=0 video=80x25"

log_file -a $runlog

proc finish {code label details} {
    global status runlog

    set fh [open $status w]
    puts $fh "status=$label $details runlog=$runlog"
    close $fh
    puts "\nWEBKIT-CHROMIUM-IPC-PROOF-$label $details log=$runlog"
    exit $code
}

spawn timeout --foreground 180 bash scripts/launch/run-qemu.sh x86_64 $kernel $fsimg

expect {
    -re {root:/#} {}
    -re {panic|fatal page fault|coredump: generating|exception} {
        finish 2 FAIL "reason=boot-crash"
    }
    timeout {
        finish 3 FAIL "reason=no-prompt"
    }
    eof {
        finish 4 FAIL "reason=early-eof"
    }
}

set saw_stream_pass 0
set saw_seqpacket_pass 0
set saw_passcred_pass 0
set saw_halfclose_pass 0
set saw_summary 0

send "/bin/webkitabitest chromium-ipc; /bin/shutdown\r"

expect {
    -re {PASS: Chromium-shaped stream SCM_RIGHTS epoll oneshot} {
        set saw_stream_pass 1
        exp_continue
    }
    -re {PASS: Chromium-shaped seqpacket SCM_RIGHTS bootstrap EOF} {
        set saw_seqpacket_pass 1
        exp_continue
    }
    -re {PASS: Chromium-shaped seqpacket PASSCRED bootstrap} {
        set saw_passcred_pass 1
        exp_continue
    }
    -re {PASS: Chromium-shaped seqpacket half-close SCM_RIGHTS} {
        set saw_halfclose_pass 1
        exp_continue
    }
    -re {webkitabitest: 4 passed, 0 skipped, 0 failed} {
        set saw_summary 1
        if {$saw_stream_pass && $saw_seqpacket_pass && $saw_passcred_pass && $saw_halfclose_pass} {
            catch { exec pkill -TERM -P [exp_pid] -f qemu-system-x86_64 }
            finish 0 PASS "reason=chromium-ipc saw_stream_pass=$saw_stream_pass saw_seqpacket_pass=$saw_seqpacket_pass saw_passcred_pass=$saw_passcred_pass saw_halfclose_pass=$saw_halfclose_pass saw_summary=$saw_summary"
        }
        exp_continue
    }
    -re {FAIL: Chromium-shaped stream SCM_RIGHTS epoll oneshot[^\r\n]*} {
        finish 5 FAIL "reason=reducer-fail saw_stream_pass=$saw_stream_pass saw_seqpacket_pass=$saw_seqpacket_pass saw_passcred_pass=$saw_passcred_pass saw_halfclose_pass=$saw_halfclose_pass saw_summary=$saw_summary"
    }
    -re {FAIL: Chromium-shaped seqpacket SCM_RIGHTS bootstrap EOF[^\r\n]*} {
        finish 5 FAIL "reason=reducer-fail saw_stream_pass=$saw_stream_pass saw_seqpacket_pass=$saw_seqpacket_pass saw_passcred_pass=$saw_passcred_pass saw_halfclose_pass=$saw_halfclose_pass saw_summary=$saw_summary"
    }
    -re {FAIL: Chromium-shaped seqpacket PASSCRED bootstrap[^\r\n]*} {
        finish 5 FAIL "reason=reducer-fail saw_stream_pass=$saw_stream_pass saw_seqpacket_pass=$saw_seqpacket_pass saw_passcred_pass=$saw_passcred_pass saw_halfclose_pass=$saw_halfclose_pass saw_summary=$saw_summary"
    }
    -re {FAIL: Chromium-shaped seqpacket half-close SCM_RIGHTS[^\r\n]*} {
        finish 5 FAIL "reason=reducer-fail saw_stream_pass=$saw_stream_pass saw_seqpacket_pass=$saw_seqpacket_pass saw_passcred_pass=$saw_passcred_pass saw_halfclose_pass=$saw_halfclose_pass saw_summary=$saw_summary"
    }
    -re {panic|fatal page fault|coredump: generating|exception} {
        finish 6 FAIL "reason=probe-crash saw_stream_pass=$saw_stream_pass saw_seqpacket_pass=$saw_seqpacket_pass saw_passcred_pass=$saw_passcred_pass saw_halfclose_pass=$saw_halfclose_pass saw_summary=$saw_summary"
    }
    eof {
        if {$saw_stream_pass && $saw_seqpacket_pass && $saw_passcred_pass && $saw_halfclose_pass && $saw_summary} {
            finish 0 PASS "reason=chromium-ipc saw_stream_pass=$saw_stream_pass saw_seqpacket_pass=$saw_seqpacket_pass saw_passcred_pass=$saw_passcred_pass saw_halfclose_pass=$saw_halfclose_pass saw_summary=$saw_summary"
        }
        finish 7 FAIL "reason=eof-missing-proof saw_stream_pass=$saw_stream_pass saw_seqpacket_pass=$saw_seqpacket_pass saw_passcred_pass=$saw_passcred_pass saw_halfclose_pass=$saw_halfclose_pass saw_summary=$saw_summary"
    }
    timeout {
        if {$saw_stream_pass && $saw_seqpacket_pass && $saw_passcred_pass && $saw_halfclose_pass && $saw_summary} {
            finish 0 PASS "reason=chromium-ipc saw_stream_pass=$saw_stream_pass saw_seqpacket_pass=$saw_seqpacket_pass saw_passcred_pass=$saw_passcred_pass saw_halfclose_pass=$saw_halfclose_pass saw_summary=$saw_summary"
        }
        finish 8 FAIL "reason=timeout saw_stream_pass=$saw_stream_pass saw_seqpacket_pass=$saw_seqpacket_pass saw_passcred_pass=$saw_passcred_pass saw_halfclose_pass=$saw_halfclose_pass saw_summary=$saw_summary"
    }
}
