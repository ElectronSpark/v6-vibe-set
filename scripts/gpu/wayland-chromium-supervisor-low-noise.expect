#!/usr/bin/env expect

set timeout 190
set root [exec sh -c "cd [file dirname [info script]]/../.. && pwd"]
set build "$root/build-x86_64"
set kernel "$build/kernel/build/kernel/xv6.bin"
set fsimg "$build/fs.img"
set outdir "$build/wayland-chromium-supervisor-low-noise"
exec mkdir -p $outdir
set runlog "$outdir/run.log"
set monitor "$outdir/qemu-monitor.sock"
set tmpimg "$outdir/wayland-chromium.fs.img"

set backend [expr {[info exists env(CHROMIUM_BACKEND)] ? $env(CHROMIUM_BACKEND) : "wayland"}]
set multiprocess [expr {[info exists env(CHROMIUM_MULTIPROCESS)] ? $env(CHROMIUM_MULTIPROCESS) : "1"}]
set extra_flags [expr {[info exists env(CHROMIUM_EXTRA_FLAGS)] ? $env(CHROMIUM_EXTRA_FLAGS) : ""}]
set lifecycle_trace [expr {[info exists env(CHROMIUM_LIFECYCLE_TRACE)] ? $env(CHROMIUM_LIFECYCLE_TRACE) : "0"}]
set syscall_trace [expr {[info exists env(CHROMIUM_SYSCALL_TRACE)] ? $env(CHROMIUM_SYSCALL_TRACE) : "0"}]
set syscall_enter_trace [expr {[info exists env(CHROMIUM_SYSCALL_ENTER_TRACE)] ? $env(CHROMIUM_SYSCALL_ENTER_TRACE) : "0"}]
set poll_summary [expr {[info exists env(CHROMIUM_POLL_SUMMARY)] ? $env(CHROMIUM_POLL_SUMMARY) : "0"}]
set surface_trace [expr {[info exists env(CHROMIUM_SURFACE_TRACE)] ? $env(CHROMIUM_SURFACE_TRACE) : "0"}]
set artifact_prefix [expr {[info exists env(CHROMIUM_ARTIFACT_PREFIX)] ? $env(CHROMIUM_ARTIFACT_PREFIX) : "wayland-chromium-low-noise"}]
set chromium_url [expr {[info exists env(CHROMIUM_URL)] ? $env(CHROMIUM_URL) : "about:blank"}]
set evidence_timers [expr {[info exists env(CHROMIUM_EVIDENCE_TIMERS)] ? $env(CHROMIUM_EVIDENCE_TIMERS) : "4"}]
set fbstat_timer [expr {[info exists env(CHROMIUM_FBSTAT_TIMER)] ? $env(CHROMIUM_FBSTAT_TIMER) : "1"}]
set guest_fbstat [expr {[info exists env(CHROMIUM_GUEST_FBSTAT)] ? $env(CHROMIUM_GUEST_FBSTAT) : "0"}]
set qemu_net [expr {[info exists env(CHROMIUM_QEMU_NET)] ? $env(CHROMIUM_QEMU_NET) : "0"}]
if {![string is integer -strict $evidence_timers] || $evidence_timers < 1} {
    set evidence_timers 4
}
if {$evidence_timers > 20} {
    set evidence_timers 20
}
if {![string is integer -strict $fbstat_timer] || $fbstat_timer < 0} {
    set fbstat_timer 1
}
if {$fbstat_timer >= $evidence_timers} {
    set fbstat_timer [expr {$evidence_timers - 1}]
}
set final_timer [expr {$evidence_timers - 1}]
set needed_timeout [expr {90 + ($evidence_timers * 15)}]
if {$needed_timeout > $timeout} {
    set timeout $needed_timeout
}
regsub -all {[^A-Za-z0-9._-]} $artifact_prefix {_} artifact_prefix
regsub -all {[^A-Za-z0-9._~:/?#@!$&'()*+,;=%-]} $chromium_url {_} chromium_url

set guest_ppm "/wayland-chromium-low-noise.ppm"
set host_ppm "$outdir/$artifact_prefix.ppm"
set host_png "$outdir/$artifact_prefix.png"
set artifact_runlog "$outdir/$artifact_prefix.run.log"
set mp_token [expr {$multiprocess eq "1" ? " host_chromium_multiprocess=1" : ""}]
set extra_token [expr {$extra_flags ne "" ? " host_chromium_extra_flags=$extra_flags" : ""}]
set trace_token [expr {$lifecycle_trace ne "0" ? " chrome_lifecycle_trace=1" : ""}]
set syscall_token [expr {$syscall_trace ne "0" ? " chrome_syscall_trace=1" : ""}]
set syscall_enter_token [expr {$syscall_enter_trace ne "0" ? " chrome_syscall_enter_trace=1" : ""}]
set poll_summary_token [expr {$poll_summary ne "0" ? " chrome_poll_summary=1" : " chrome_poll_summary=0"}]
set surface_trace_token [expr {$surface_trace ne "0" ? " host_chromium_surface_trace=1" : " host_chromium_surface_trace=0"}]
set fbstat_token [expr {$guest_fbstat ne "0" ? " host_chromium_fbstat=1" : " host_chromium_fbstat=0"}]
set append_token [expr {[info exists env(CHROMIUM_EXTRA_APPEND)] && $env(CHROMIUM_EXTRA_APPEND) ne "" ? " $env(CHROMIUM_EXTRA_APPEND)" : ""}]

exec sh -c "rm -f '$runlog' '$artifact_runlog' '$monitor' '$tmpimg' '$host_ppm' '$host_png'"
exec cp $fsimg $tmpimg
set startup_override "$outdir/startup-no-dbus"
exec sh -c "printf '%s\n' '# Temporary Chromium proof startup: skip host D-Bus helpers.' '/bin/weston-session' > '$startup_override'"
exec sh -c "printf '%s\n' 'rm /etc/startup' 'write $startup_override /etc/startup' | debugfs -w '$tmpimg' >/dev/null 2>&1"
catch { exec sh -c "debugfs -w -R 'rm $guest_ppm' '$tmpimg' >/dev/null 2>&1" }

set env(DISPLAY_MODE)          "gtk"
set env(USE_KVM)               "1"
set env(QEMU_GPU)              "virtio-vga-gl-primary"
set env(QEMU_INPUT)            "virtio"
set env(QEMU_NET)              $qemu_net
set env(QEMU_ALLOW_WSL_SDL_GL) "1"
set env(QEMU_VIRTIO_GPU_XRES)  "1280"
set env(QEMU_VIRTIO_GPU_YRES)  "800"
set env(QEMU_APPEND) "root=/dev/disk0 weston=1 video=1280x800 netsurf=0 webkit=0 host_chromium=1 host_chromium_url=$chromium_url host_chromium_backend=$backend$mp_token$extra_token$fbstat_token host_chromium_fbstat_timer=$fbstat_timer host_chromium_fbstat_path=$guest_ppm host_chromium_evidence=1 host_chromium_evidence_lines=360 host_chromium_evidence_timers=$evidence_timers$surface_trace_token$trace_token$syscall_token$syscall_enter_token$poll_summary_token chrome_drm_ioctl_trace=0$append_token"
set env(QEMU_EXTRA) "-monitor unix:$monitor,server,nowait"

proc monitor_screendump {sock dst} {
    catch { exec sh -c "printf 'screendump $dst\\n' | nc -U -w 4 -q 1 '$sock' >>'$dst.nc.log' 2>&1 || echo nc-failed >>'$dst.nc.log'" }
}

proc finish {code label} {
    global qemu_pid tmpimg guest_ppm host_ppm host_png runlog artifact_runlog monitor guest_fbstat

    monitor_screendump $monitor $host_ppm
    if {$code == 0 && $guest_fbstat ne "0" && ![file exists $host_ppm]} {
        catch { exec sh -c "debugfs -R 'dump $guest_ppm $host_ppm' '$tmpimg' >/dev/null 2>&1" }
    }

    catch { exec pkill -P $qemu_pid qemu-system-x86_64 }
    catch { exec kill $qemu_pid }
    sleep 1

    if {$code == 0} {
        if {![file exists $host_ppm]} {
            set fail_line "CHROMIUM-SUPERVISOR-LOW-NOISE-FAIL extract-ppm log=$artifact_runlog"
            set fail_log [open $runlog a]
            puts $fail_log $fail_line
            close $fail_log
            catch { exec cp $runlog $artifact_runlog }
            puts "\n$fail_line"
            exit 6
        }
        if {[catch { exec convert $host_ppm $host_png } convert_out]} {
            set fail_line "CHROMIUM-SUPERVISOR-LOW-NOISE-FAIL convert-png $convert_out log=$artifact_runlog"
            set fail_log [open $runlog a]
            puts $fail_log $fail_line
            close $fail_log
            catch { exec cp $runlog $artifact_runlog }
            puts "\n$fail_line"
            exit 6
        }
        set pass_line "$label log=$artifact_runlog host_ppm=$host_ppm host_png=$host_png"
        puts "\n$pass_line"
        set pass_log [open $runlog a]
        puts $pass_log $pass_line
        close $pass_log
    } else {
        set fail_line "$label log=$artifact_runlog"
        puts "\n$fail_line"
        set fail_log [open $runlog a]
        puts $fail_log $fail_line
        close $fail_log
    }
    catch { exec cp $runlog $artifact_runlog }
    exit $code
}

log_user 0
log_file -a $runlog
spawn timeout --foreground $timeout bash scripts/launch/run-qemu.sh x86_64 $kernel $tmpimg
set qemu_pid [exp_pid]

expect {
    -re "Chromium evidence end reason=timer-$final_timer" {
        finish 0 "CHROMIUM-SUPERVISOR-LOW-NOISE-DONE"
    }
    -re {Chromium fbstat capture timeout} {
        finish 7 "CHROMIUM-SUPERVISOR-LOW-NOISE-FAIL fbstat-timeout"
    }
    -re {Chromium evidence end reason=client-exit} {
        finish 0 "CHROMIUM-SUPERVISOR-LOW-NOISE-EXIT"
    }
    -re {panic|fatal page fault|coredump: generating|virtio_gpu: async command} {
        finish 3 "CHROMIUM-SUPERVISOR-LOW-NOISE-FAIL crash"
    }
    timeout {
        finish 4 "CHROMIUM-SUPERVISOR-LOW-NOISE-FAIL timeout"
    }
    eof {
        finish 5 "CHROMIUM-SUPERVISOR-LOW-NOISE-FAIL eof"
    }
}
