#!/usr/bin/env expect

set timeout 230
set root [exec sh -c "cd [file dirname [info script]]/../.. && pwd"]
set build "$root/build-x86_64"
set kernel "$build/kernel/build/kernel/xv6.bin"
set fsimg "$build/fs.img"
set outdir "$build/host-idle-x11-proof"
exec mkdir -p $outdir
set runlog "$outdir/run.log"
set tmpimg "$outdir/host-idle-x11.fs.img"

array set guest {
    before /host-idle-x11-before.ppm
    launch /host-idle-x11-launch.ppm
    input /host-idle-x11-input.ppm
    exit /host-idle-x11-exit.ppm
}

proc host_ppm {phase} {
    global outdir
    return "$outdir/host-idle-x11-$phase.ppm"
}

proc host_png {phase} {
    global outdir
    return "$outdir/host-idle-x11-$phase.png"
}

exec sh -c "rm -f '$runlog' '$tmpimg' '$outdir'/host-idle-x11-*.ppm '$outdir'/host-idle-x11-*.png '$outdir'/diff-*.txt"
exec cp $fsimg $tmpimg
foreach phase [array names guest] {
    catch { exec sh -c "debugfs -w -R 'rm $guest($phase)' '$tmpimg' >/dev/null 2>&1" }
}

set env(DISPLAY_MODE)          "gtk"
set env(USE_KVM)               "1"
set env(QEMU_GPU)              "virtio-vga-gl-primary"
set env(QEMU_INPUT)            "virtio"
set env(QEMU_NET)              "0"
set env(QEMU_ALLOW_WSL_SDL_GL) "1"
set env(QEMU_VIRTIO_GPU_XRES)  "1280"
set env(QEMU_VIRTIO_GPU_YRES)  "800"
set env(QEMU_APPEND) "root=/dev/disk0 weston=1 video=1280x800 netsurf=0 webkit=0"
set send_slow {1 .01}

proc fail {code label} {
    global qemu_pid runlog

    catch { exec pkill -P $qemu_pid qemu-system-x86_64 }
    puts "\n$label log=$runlog"
    exit $code
}

proc optional_prompt {} {
    global timeout

    set old_timeout $timeout
    set timeout 2
    expect {
        -re {root:/#} {}
        timeout {}
        eof {}
    }
    set timeout $old_timeout
}

proc capture_fb {phase marker label} {
    global guest

    send "fbstat ppm-current $guest($phase) 0 0 1280 800; sync; echo $marker\r"
    expect {
        -re "fb_ppm_current path=$guest($phase) screen=1280x800 scanout=1280x800" {}
        -re {fbstat: [^\r\n]+} { fail 20 "$label fbstat-error" }
        timeout { fail 20 "$label fbstat-timeout" }
        eof { fail 20 "$label fbstat-eof" }
    }
    expect {
        -re $marker {}
        timeout { fail 21 "$label marker-timeout" }
        eof { fail 21 "$label marker-eof" }
    }
    optional_prompt
}

proc extract_artifacts {} {
    global tmpimg guest outdir

    foreach phase {before launch input exit} {
        set ppm [host_ppm $phase]
        set png [host_png $phase]
        if {[catch { exec sh -c "debugfs -R 'dump $guest($phase) $ppm' '$tmpimg' >/dev/null 2>&1" } dump_out]} {
            puts "\nHOSTIDLE-X11-FAIL extract-$phase $dump_out"
            exit 30
        }
        if {[catch { exec convert $ppm $png } convert_out]} {
            puts "\nHOSTIDLE-X11-FAIL convert-$phase $convert_out"
            exit 31
        }
    }

    set launch_ae [exec sh -c "compare -metric AE '[host_ppm before]' '[host_ppm launch]' '$outdir/host-idle-x11-launch-diff.png' 2>&1 || true"]
    set input_ae [exec sh -c "compare -metric AE '[host_ppm launch]' '[host_ppm input]' '$outdir/host-idle-x11-input-diff.png' 2>&1 || true"]
    set exit_ae [exec sh -c "compare -metric AE '[host_ppm input]' '[host_ppm exit]' '$outdir/host-idle-x11-exit-diff.png' 2>&1 || true"]
    exec sh -c "printf '%s\\n' '$launch_ae' > '$outdir/diff-launch-ae.txt'; printf '%s\\n' '$input_ae' > '$outdir/diff-input-ae.txt'; printf '%s\\n' '$exit_ae' > '$outdir/diff-exit-ae.txt'"

    if {$launch_ae < 1000} {
        puts "\nHOSTIDLE-X11-FAIL launch-screenshot-unchanged changed_pixels=$launch_ae"
        exit 32
    }
    if {$input_ae < 100} {
        puts "\nHOSTIDLE-X11-FAIL input-screenshot-unchanged changed_pixels=$input_ae"
        exit 33
    }
    if {$exit_ae < 1000} {
        puts "\nHOSTIDLE-X11-FAIL exit-screenshot-unchanged changed_pixels=$exit_ae"
        exit 34
    }
    return [list $launch_ae $input_ae $exit_ae]
}

log_file -a $runlog
spawn timeout --foreground 220 bash scripts/launch/run-qemu.sh x86_64 $kernel $tmpimg
set qemu_pid [exp_pid]

expect {
    -re {weston-desktop-shell: loaded [0-9]+ desktop entries} {}
    -re {panic|fatal page fault|coredump: generating|virtio_gpu: async command} {
        fail 3 "HOSTIDLE-X11-FAIL crash-marker"
    }
    timeout { fail 4 "HOSTIDLE-X11-FAIL no-desktop" }
    eof { fail 5 "HOSTIDLE-X11-FAIL early-eof" }
}

sleep 3
send "\r"
expect {
    -re {root:/#} {}
    timeout { fail 5 "HOSTIDLE-X11-FAIL no-fresh-prompt" }
    eof { fail 5 "HOSTIDLE-X11-FAIL fresh-prompt-eof" }
}

capture_fb before "HOSTIDLE_FB_BEFORE_DONE" "HOSTIDLE-X11-FAIL before"

send "/usr/bin/xkbcomp -version; /bin/Xwayland -version; echo HOSTIDLE_RUNTIME_PROBE_DONE\r"
expect {
    -re {exec .*failed|not found|cannot execute} { fail 6 "HOSTIDLE-X11-FAIL missing-runtime-files" }
    -re {HOSTIDLE_RUNTIME_PROBE_DONE} {}
    timeout { fail 6 "HOSTIDLE-X11-FAIL missing-runtime-files" }
    eof { fail 6 "HOSTIDLE-X11-FAIL runtime-files-eof" }
}
optional_prompt

send -s "rm -f /tmp/host-idle-x11.log; XV6_GUI_SESSION=1 XDG_RUNTIME_DIR=/tmp DISPLAY=:0 /bin/host-idle-x11 -n -i -t XV6-IDLE-X11-PROOF &\r"
expect {
    -re {root:/#} {}
    -re {exec .*failed|not found|cannot execute} { fail 7 "HOSTIDLE-X11-FAIL launch" }
    timeout { fail 7 "HOSTIDLE-X11-FAIL no-prompt-after-launch" }
    eof { fail 7 "HOSTIDLE-X11-FAIL launch-eof" }
}

set old_timeout $timeout
set timeout 1
for {set i 0} {$i < 15} {incr i} {
    expect {
        -re {exec /usr/bin/xkbcomp failed|Keyboard initialization failed|Fatal server error} {
            fail 12 "HOSTIDLE-X11-FAIL xwayland-keyboard"
        }
        timeout {}
        eof { fail 12 "HOSTIDLE-X11-FAIL xwayland-eof" }
    }
}
set timeout $old_timeout

send "ps\r"
expect {
    -re {host-idle|Xwayland} {}
    timeout { fail 8 "HOSTIDLE-X11-FAIL process-missing" }
    eof { fail 8 "HOSTIDLE-X11-FAIL process-eof" }
}
optional_prompt

capture_fb launch "HOSTIDLE_FB_LAUNCH_DONE" "HOSTIDLE-X11-FAIL launch"

send "mouseinject 32768 32768 0; mouseinject 32768 32768 1; mouseinject 32768 32768 0; echo HOSTIDLE_FOCUS_DONE\r"
expect {
    -re {HOSTIDLE_FOCUS_DONE} {}
    timeout { fail 13 "HOSTIDLE-X11-FAIL focus-marker-timeout" }
    eof { fail 13 "HOSTIDLE-X11-FAIL focus-marker-eof" }
}
optional_prompt

sleep 1
send "keyinject text \"4+5\"; keyinject key enter; echo HOSTIDLE_KEYS_DONE\r"
expect {
    -re {HOSTIDLE_KEYS_DONE} {}
    timeout { fail 14 "HOSTIDLE-X11-FAIL key-marker-timeout" }
    eof { fail 14 "HOSTIDLE-X11-FAIL key-marker-eof" }
}
optional_prompt

sleep 2
capture_fb input "HOSTIDLE_FB_INPUT_DONE" "HOSTIDLE-X11-FAIL input"

send "keyinject chord ctrl+q; echo HOSTIDLE_QUIT_KEYS_DONE\r"
expect {
    -re {HOSTIDLE_QUIT_KEYS_DONE} {}
    timeout { fail 16 "HOSTIDLE-X11-FAIL quit-marker-timeout" }
    eof { fail 16 "HOSTIDLE-X11-FAIL quit-marker-eof" }
}
optional_prompt

sleep 5
send "ps; echo HOSTIDLE_AFTER_QUIT_PS_DONE\r"
expect {
    -re {host-idle} { fail 17 "HOSTIDLE-X11-FAIL process-still-running-after-quit" }
    -re {HOSTIDLE_AFTER_QUIT_PS_DONE} {}
    timeout { fail 17 "HOSTIDLE-X11-FAIL after-quit-ps-timeout" }
    eof { fail 17 "HOSTIDLE-X11-FAIL after-quit-ps-eof" }
}
optional_prompt

capture_fb exit "HOSTIDLE_FB_EXIT_DONE" "HOSTIDLE-X11-FAIL exit"

catch { exec pkill -P $qemu_pid qemu-system-x86_64 }
sleep 1
set aes [extract_artifacts]
puts "\nHOSTIDLE-X11-PASS launch_changed_pixels=[lindex $aes 0] input_changed_pixels=[lindex $aes 1] exit_changed_pixels=[lindex $aes 2] launch_png=[host_png launch] input_png=[host_png input] exit_png=[host_png exit] log=$runlog"
exit 0
