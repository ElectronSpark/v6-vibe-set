#!/usr/bin/env expect

set timeout 300
set root [exec sh -c "cd [file dirname [info script]]/../.. && pwd"]
set build "$root/build-x86_64"
set kernel "$build/kernel/build/kernel/xv6.bin"
set fsimg "$build/fs.img"
set outdir "$build/kwin-global-slot-proof"
exec mkdir -p $outdir
set runlog "$outdir/run.log"
set statuslog "$outdir/status.txt"
set tmpimg "$outdir/kwin-global-slot-proof.fs.img"
set empty_startup "$outdir/empty-startup"
set host_script "$outdir/kwin-global-slot-proof.sh.host"
set host_probe_log "$outdir/kwin-global-slot-probe.log"
set host_probe_status "$outdir/kwin-global-slot-probe.status"
set guest_script "/kwin-global-slot-proof.sh"
set guest_probe_log "/kwin-global-slot-probe.log"
set guest_probe_status "/kwin-global-slot-probe.status"

exec rm -f $runlog $statuslog $tmpimg $empty_startup $host_script $host_probe_log $host_probe_status
exec cp $fsimg $tmpimg
exec touch $empty_startup
catch { exec debugfs -w -R "rm /etc/startup" $tmpimg >/dev/null 2>@1 }
exec debugfs -w -R "write $empty_startup /etc/startup" $tmpimg >/dev/null 2>@1

set fh [open $host_script w]
puts $fh "#!/bin/sh"
puts $fh "rm -f $guest_probe_log $guest_probe_status"
puts $fh "echo status=running source=kwin-global-slot-probe >$guest_probe_status"
puts $fh "sync"
puts $fh "/bin/kwin-global-slot-probe >$guest_probe_log"
puts $fh "echo status=DONE source=kwin-global-slot-probe >$guest_probe_status"
puts $fh "sync"
puts $fh "cat $guest_probe_status"
close $fh

catch { exec debugfs -w -R "rm $guest_script" $tmpimg >/dev/null 2>@1 }
catch { exec debugfs -w -R "rm $guest_probe_log" $tmpimg >/dev/null 2>@1 }
catch { exec debugfs -w -R "rm $guest_probe_status" $tmpimg >/dev/null 2>@1 }
exec debugfs -w -R "write $host_script $guest_script" $tmpimg >/dev/null 2>@1

set env(DISPLAY_MODE) "gtk"
set env(USE_KVM) "1"
set env(QEMU_GPU) "virtio-vga-gl-primary"
set env(QEMU_INPUT) "virtio"
set env(QEMU_NET) "0"
set env(QEMU_ALLOW_WSL_SDL_GL) "1"
set env(QEMU_VIRTIO_GPU_XRES) "1280"
set env(QEMU_VIRTIO_GPU_YRES) "800"
set env(QEMU_APPEND) "root=/dev/disk0 netsurf=0 webkit=0 glsmoke=0 desktop=0 video=1280x800"
set send_slow {1 .01}

proc fail {code label} {
    global qemu_pid runlog statuslog

    catch { exec pkill -P $qemu_pid qemu-system-x86_64 }
    set fh [open $statuslog w]
    puts $fh "status=FAIL reason=$label log=$runlog"
    close $fh
    puts "\nKWIN-GLOBAL-SLOT-PROOF-FAIL reason=$label log=$runlog"
    exit $code
}

proc dump_guest_file {guest host label} {
    global tmpimg

    set tmp "$host.debugfs.[pid]"
    catch { file delete -force $tmp }
    if {[catch { exec sh -c "debugfs -R 'dump $guest $tmp' '$tmpimg' >/dev/null 2>&1" }]} {
        catch { file delete -force $tmp }
        fail 30 "dump-$label"
    }
    if {![file exists $tmp]} {
        fail 31 "dump-$label-missing"
    }
    file rename -force $tmp $host
}

proc analyze_probe_log {} {
    global host_probe_log host_probe_status statuslog runlog

    if {![file exists $host_probe_log] || [file size $host_probe_log] == 0} {
        fail 40 "empty-probe-log"
    }
    if {![file exists $host_probe_status] || [file size $host_probe_status] == 0} {
        fail 41 "empty-probe-status"
    }

    set fh [open $host_probe_log r]
    set log [read $fh]
    close $fh

    set sfh [open $host_probe_status r]
    set status [read $sfh]
    close $sfh

    if {![regexp {status=DONE source=kwin-global-slot-probe} $status]} {
        fail 42 "missing-completion-status"
    }
    if {![regexp {KWIN_GLOBAL_SLOT_PROBE_PASS} $log]} {
        fail 43 "missing-result-pass"
    }
    foreach label {workspace_self wayland_server_self cursors_self} {
        set re "KWIN_GLOBAL_SLOT_PROBE_SLOT:$label status=PASS"
        if {![regexp $re $log]} {
            fail 44 "missing-slot-pass-$label"
        }
    }

    set fh [open $statuslog w]
    puts $fh "status=PASS source=kwin-global-slot-probe log=$host_probe_log runlog=$runlog"
    close $fh
    puts "\nKWIN-GLOBAL-SLOT-PROOF-PASS probe_log=$host_probe_log status=$host_probe_status runlog=$runlog"
}

log_file -a $runlog
spawn timeout --foreground 300 bash scripts/launch/run-qemu.sh x86_64 $kernel $tmpimg
set qemu_pid [exp_pid]

expect {
    -re {root:/# ?} {}
    -re {panic|fatal page fault|coredump: generating|virtio_gpu: async command} {
        fail 3 "crash-marker"
    }
    timeout {
        fail 4 "no-prompt"
    }
    eof {
        fail 5 "early-eof"
    }
}

send "sh $guest_script; echo KWINGLOBALSLOTDONE\r"
expect {
    -re {status=DONE source=kwin-global-slot-probe} {
        exp_continue
    }
    -re {KWINGLOBALSLOTDONE} {}
    -re {panic|fatal page fault|coredump: generating|virtio_gpu: async command} {
        fail 6 "probe-crash-marker"
    }
    timeout {
        fail 7 "probe-timeout"
    }
    eof {
        fail 8 "probe-eof"
    }
}

catch { exec pkill -P $qemu_pid qemu-system-x86_64 }
set timeout 10
expect {
    eof {}
    timeout {
        catch { exec pkill -P $qemu_pid qemu-system-x86_64 }
    }
}

dump_guest_file $guest_probe_log $host_probe_log "probe-log"
dump_guest_file $guest_probe_status $host_probe_status "probe-status"
catch { file delete -force $tmpimg }
analyze_probe_log
exit 0
