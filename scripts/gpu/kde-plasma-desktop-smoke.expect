    if {$label ne ""} {
        return $label
    }
    if {$variant ne "oml-queue-depth-issue-state-timing"} {
        return ""
    }
    if {$requested_sample_interval eq ""} {
        set requested_sample_interval 1
    }
    if {![string is integer -strict $requested_sample_interval] ||
        $requested_sample_interval < 1 || $requested_sample_interval > 64} {
        return "x11-glx-fps-oml-issue-state-requested-sample-interval-invalid"
    }
    if {$get_sync_before_total eq ""} {
        return "x11-glx-fps-oml-issue-state-get-sync-before-total-missing"
