    }
    if {$post_issue_msc_delta_max eq ""} {
        return "x11-glx-fps-oml-issue-state-msc-delta-max-missing"
    }
    if {![string is integer -strict $post_issue_msc_delta_max]} {
        return "x11-glx-fps-oml-issue-state-msc-delta-max-invalid"
    }
    return ""
}

proc x11_present_fps_failure_suffix {saw_start saw_connect saw_dri3 saw_present saw_select saw_fd saw_fps_begin saw_fps_result fps_status fps_frames fps_elapsed fps_value issued completed outstanding requested_variant requested_depth result_variant queue_depth max_outstanding exit_status} {
    return "start=$saw_start connect=$saw_connect dri3=$saw_dri3 present=$saw_present select=$saw_select fd=$saw_fd fps_begin=$saw_fps_begin fps_result=$saw_fps_result fps_status=$fps_status frames=$fps_frames elapsed_seconds=$fps_elapsed fps=$fps_value issued=$issued completed=$completed outstanding=$outstanding requested_variant=$requested_variant requested_depth=$requested_depth result_variant=$result_variant queue_depth=$queue_depth max_outstanding=$max_outstanding exit_status=$exit_status"
}

proc x11_present_fps_queue_failure_label {requested_variant requested_depth result_variant issued completed outstanding queue_depth max_outstanding} {
    if {$requested_variant ne "queue-unchecked"} {
        return ""
    }
    if {$result_variant eq ""} {
        return "x11-present-fps-queue-result-variant-missing"
    }
    if {$result_variant ne "queue-unchecked"} {
        return "x11-present-fps-queue-result-variant-mismatch"
    }
    if {$requested_depth eq ""} {
        return "x11-present-fps-queue-requested-depth-missing"
    }
    if {$queue_depth eq ""} {
        return "x11-present-fps-queue-depth-missing"
    }
    if {$queue_depth != $requested_depth} {
        return "x11-present-fps-queue-depth-mismatch"
    }
    if {$max_outstanding eq ""} {
        return "x11-present-fps-queue-max-outstanding-missing"
    }
    if {$max_outstanding != $requested_depth} {
        return "x11-present-fps-queue-max-outstanding-mismatch"
    }
    if {$issued eq ""} {
        return "x11-present-fps-queue-issued-missing"
    }
    if {$completed eq ""} {
        return "x11-present-fps-queue-completed-missing"
    }
    if {$issued <= 0 || $completed <= 0} {
        return "x11-present-fps-queue-issued-completed-zero"
    }
    if {$issued != $completed} {
        return "x11-present-fps-queue-issued-completed-mismatch"
    }
    if {$outstanding eq "" || $outstanding != 0} {
        return "x11-present-fps-queue-outstanding"
    }
    return ""
}

proc x11_glx_fps_failure_label_from_line {line} {
    if {[regexp {host-x11-egl-smoke: phase=glx_present_trace[^\r\n]*status=FAIL[^\r\n]*reason=([^ \r\n]+)} $line -> reason]} {
        return "x11-glx-fps-present-trace-$reason"
    }
    if {[regexp {host-x11-egl-smoke: phase=glx_fps_result status=FAIL[^\r\n]*reason=([^ \r\n]+)} $line -> reason]} {
        return "x11-glx-fps-result-FAIL-$reason"
    }
    if {[regexp {host-x11-egl-smoke: phase=glx_fps_oml_[A-Za-z0-9_]+[^\r\n]*status=FAIL[^\r\n]*reason=([^ \r\n]+)} $line -> reason]} {
        return "x11-glx-fps-oml-$reason"
    }
    if {[regexp {host-x11-egl-smoke: phase=glx_fps_plain_oml_[A-Za-z0-9_]+[^\r\n]*status=FAIL[^\r\n]*reason=([^ \r\n]+)} $line -> reason]} {
        return "x11-glx-fps-plain-oml-$reason"
    }
    if {[regexp {host-x11-egl-smoke: phase=glx_fps_variant[^\r\n]*status=FAIL[^\r\n]*reason=([^ \r\n]+)} $line -> reason]} {
        return "x11-glx-fps-variant-$reason"
    }
    set label [x11_egl_failure_label_from_line $line]
    if {$label ne ""} {
        regsub {^x11-egl-} $label {x11-glx-fps-} label
    }
    return $label
}

proc x11_glx_present_trace_scan_log {text enabled_var available_var child_pid_var begin_var result_var result_status_var pixmap_var pixmap_checked_var register_var present_registration_var wait_var poll_var nonpresent_var pixmap_ms_var wait_ms_var poll_ms_var complete_var decode_failures_var missing_symbols_var failure_var} {
    upvar 1 $enabled_var enabled
    upvar 1 $available_var available
    upvar 1 $child_pid_var child_pid
    upvar 1 $begin_var saw_begin
    upvar 1 $result_var saw_result
    upvar 1 $result_status_var result_status
    upvar 1 $pixmap_var pixmap_calls
    upvar 1 $pixmap_checked_var pixmap_checked_calls
    upvar 1 $register_var register_special_xge_calls
    upvar 1 $present_registration_var present_special_registrations
    upvar 1 $wait_var wait_special_calls
    upvar 1 $poll_var poll_special_calls
    upvar 1 $nonpresent_var nonpresent_special_events
    upvar 1 $pixmap_ms_var pixmap_total_ms
    upvar 1 $wait_ms_var wait_special_total_ms
    upvar 1 $poll_ms_var poll_special_total_ms
    upvar 1 $complete_var complete_events
    upvar 1 $decode_failures_var complete_decode_failures
    upvar 1 $missing_symbols_var missing_symbols
    upvar 1 $failure_var failure_label

    set expect_glx_fps_child_spawn 0
    set trace_pid_hint ""
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {^probe_glx_present_trace=([0-9]+)} $line -> found_enabled]} {
            set enabled $found_enabled
        }
        if {[regexp {^probe_glx_present_trace_available=([0-9]+)} $line -> found_available]} {
            set available $found_available
        }
        if {[regexp {host-x11-egl-smoke: diag launch mode=glx-fps[^\r\n]*child_ld_preload=([^ \r\n]+)} $line -> found_child_ld_preload] &&
            $found_child_ld_preload ne "(unset)"} {
            set expect_glx_fps_child_spawn 1
        }
        if {$expect_glx_fps_child_spawn &&
            [regexp {host-x11-egl-smoke-launcher: phase=child_spawn status=PASS pid=([0-9]+)} $line -> found_child_pid]} {
            set child_pid $found_child_pid
            set expect_glx_fps_child_spawn 0
        }
        if {[regexp {host-x11-present-trace: phase=present_trace (status=BEGIN|status=FAIL)[^\r\n]*pid=([0-9]+)} $line -> _ found_pid]} {
            if {$trace_pid_hint eq ""} {
                set trace_pid_hint $found_pid
            }
            if {$enabled eq ""} {
                set enabled 1
            }
            if {$available eq ""} {
                set available 1
            }
        }
        if {[regexp {host-x11-present-trace: phase=present_trace_result status=[^ \r\n]+[^\r\n]*pid=([0-9]+)} $line -> found_pid]} {
            if {$trace_pid_hint eq ""} {
                set trace_pid_hint $found_pid
            }
            if {$enabled eq ""} {
                set enabled 1
            }
            if {$available eq ""} {
                set available 1
            }
        }
        if {$failure_label eq ""} {
            set label [x11_glx_fps_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }

    if {$child_pid eq ""} {
        set child_pid $trace_pid_hint
    }
    if {$child_pid eq ""} {
        return
    }

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {$child_pid ne "" &&
            [regexp {host-x11-present-trace: phase=present_trace status=BEGIN[^\r\n]*pid=([0-9]+)} $line -> found_pid] &&
            $found_pid eq $child_pid} {
            set saw_begin 1
        }
        if {$child_pid ne "" &&
            [regexp {host-x11-present-trace: phase=present_trace_result status=([^ \r\n]+)[^\r\n]*pid=([0-9]+)} $line -> found_status found_pid] &&
            $found_pid eq $child_pid} {
            set saw_result 1
            if {$found_status ne "PASS"} {
                set result_status $found_status
            } elseif {$result_status eq ""} {
                set result_status $found_status
            }
            if {[regexp {pixmap_calls=([0-9]+)} $line -> found_pixmap_calls]} {
                set pixmap_calls $found_pixmap_calls
            }
            if {[regexp {pixmap_checked_calls=([0-9]+)} $line -> found_pixmap_checked_calls]} {
                set pixmap_checked_calls $found_pixmap_checked_calls
            }
            if {[regexp {register_special_xge_calls=([0-9]+)} $line -> found_register_special_xge_calls]} {
                set register_special_xge_calls $found_register_special_xge_calls
            }
            if {[regexp {present_special_registrations=([0-9]+)} $line -> found_present_special_registrations]} {
                set present_special_registrations $found_present_special_registrations
            }
            if {[regexp {wait_special_calls=([0-9]+)} $line -> found_wait_special_calls]} {
                set wait_special_calls $found_wait_special_calls
            }
            if {[regexp {poll_special_calls=([0-9]+)} $line -> found_poll_special_calls]} {
                set poll_special_calls $found_poll_special_calls
            }
            if {[regexp {nonpresent_special_events=([0-9]+)} $line -> found_nonpresent_special_events]} {
                set nonpresent_special_events $found_nonpresent_special_events
            }
            if {[regexp {pixmap_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_pixmap_total_ms _]} {
                set pixmap_total_ms $found_pixmap_total_ms
            }
            if {[regexp {wait_special_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_wait_special_total_ms _]} {
                set wait_special_total_ms $found_wait_special_total_ms
            }
            if {[regexp {poll_special_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_poll_special_total_ms _]} {
                set poll_special_total_ms $found_poll_special_total_ms
            }
            if {[regexp {complete_events=([0-9]+)} $line -> found_complete_events]} {
                set complete_events $found_complete_events
            }
            if {[regexp {complete_decode_failures=([0-9]+)} $line -> found_complete_decode_failures]} {
                set complete_decode_failures $found_complete_decode_failures
            }
            if {[regexp {missing_symbols=([0-9]+)} $line -> found_missing_symbols]} {
                set missing_symbols $found_missing_symbols
            }
        }
        if {!$saw_result &&
            [regexp {host-x11-present-trace: phase=present_trace_progress[^\r\n]*pid=([0-9]+)} $line -> found_pid] &&
            $found_pid eq $child_pid} {
            if {[regexp {pixmap_calls=([0-9]+)} $line -> found_pixmap_calls]} {
                set pixmap_calls $found_pixmap_calls
            }
            if {[regexp {pixmap_checked_calls=([0-9]+)} $line -> found_pixmap_checked_calls]} {
                set pixmap_checked_calls $found_pixmap_checked_calls
            }
            if {[regexp {register_special_xge_calls=([0-9]+)} $line -> found_register_special_xge_calls]} {
                set register_special_xge_calls $found_register_special_xge_calls
            }
            if {[regexp {present_special_registrations=([0-9]+)} $line -> found_present_special_registrations]} {
                set present_special_registrations $found_present_special_registrations
            }
            if {[regexp {wait_special_calls=([0-9]+)} $line -> found_wait_special_calls]} {
                set wait_special_calls $found_wait_special_calls
            }
            if {[regexp {poll_special_calls=([0-9]+)} $line -> found_poll_special_calls]} {
                set poll_special_calls $found_poll_special_calls
            }
            if {[regexp {complete_events=([0-9]+)} $line -> found_complete_events]} {
                set complete_events $found_complete_events
            }
            if {[regexp {complete_decode_failures=([0-9]+)} $line -> found_complete_decode_failures]} {
                set complete_decode_failures $found_complete_decode_failures
            }
            if {[regexp {missing_symbols=([0-9]+)} $line -> found_missing_symbols]} {
                set missing_symbols $found_missing_symbols
            }
        }
    }
}

proc x11_glx_present_trace_failure_label {enabled available child_pid saw_begin saw_result result_status pixmap_calls pixmap_checked_calls register_special_xge_calls present_special_registrations wait_special_calls poll_special_calls nonpresent_special_events pixmap_total_ms wait_special_total_ms poll_special_total_ms complete_events complete_decode_failures missing_symbols} {
    if {$enabled ne "1"} {
        return "x11-glx-fps-present-trace-not-enabled"
    }
    if {$available ne "1"} {
        return "x11-glx-fps-present-trace-unavailable"
    }
    if {$child_pid eq ""} {
        return "x11-glx-fps-present-trace-child-pid-missing"
    }
    if {!$saw_begin} {
        return "x11-glx-fps-present-trace-begin-missing"
    }
    if {!$saw_result} {
        return "x11-glx-fps-present-trace-result-missing"
    }
    if {$result_status ne "PASS"} {
        return "x11-glx-fps-present-trace-result-$result_status"
    }
    foreach value [list $pixmap_calls $pixmap_checked_calls $register_special_xge_calls $present_special_registrations $wait_special_calls $poll_special_calls $nonpresent_special_events $complete_events $complete_decode_failures $missing_symbols] {
        if {$value eq "" || ![string is integer -strict $value] || $value < 0} {
            return "x11-glx-fps-present-trace-counter-invalid"
        }
    }
    foreach value [list $pixmap_total_ms $wait_special_total_ms $poll_special_total_ms] {
        if {$value eq "" || ![string is double -strict $value] || $value < 0} {
            return "x11-glx-fps-present-trace-timing-invalid"
        }
    }
    if {$missing_symbols != 0} {
        return "x11-glx-fps-present-trace-missing-symbols"
    }
    if {$pixmap_calls + $pixmap_checked_calls <= 0} {
        return "x11-glx-fps-present-trace-pixmap-missing"
    }
    if {$register_special_xge_calls <= 0 || $present_special_registrations <= 0} {
        return "x11-glx-fps-present-trace-present-registration-missing"
    }
    if {$wait_special_calls + $poll_special_calls <= 0} {
        return "x11-glx-fps-present-trace-special-wait-missing"
    }
    if {$complete_events <= 0} {
        return "x11-glx-fps-present-trace-complete-missing"
    }
    return ""
}

proc x11_glx_swap_trace_scan_log {text child_pid capable_var result_var result_status_var xcb_capable_var syscall_capable_var buffers_var buffers_msc_oml_var total_ms_var max_ms_var nested_pixmap_var nested_pixmap_checked_var nested_pixmap_ms_var nested_wait_var nested_poll_var nested_wait_ms_var nested_poll_ms_var nested_complete_var nested_xcb_flush_var nested_xcb_flush_ms_var nested_xcb_request_check_var nested_xcb_request_check_ms_var nested_xcb_wait_reply_var nested_xcb_wait_reply_ms_var nested_xcb_poll_reply_var nested_xcb_poll_reply_ms_var nested_xcb_wait_event_var nested_xcb_wait_event_ms_var nested_xcb_poll_event_var nested_xcb_poll_event_ms_var accounted_ms_var above_ms_var accounted_xcb_ms_var above_xcb_ms_var syscall_total_ms_var syscall_nested_x11_ms_var syscall_above_x11_ms_var syscall_ioctl_calls_var syscall_ioctl_total_ms_var syscall_ioctl_max_ms_var syscall_poll_ppoll_calls_var syscall_poll_ppoll_total_ms_var syscall_poll_ppoll_max_ms_var syscall_select_pselect_calls_var syscall_select_pselect_total_ms_var syscall_select_pselect_max_ms_var syscall_read_recv_calls_var syscall_read_recv_total_ms_var syscall_read_recv_max_ms_var syscall_write_send_calls_var syscall_write_send_total_ms_var syscall_write_send_max_ms_var missing_symbols_var recursion_skips_var} {
    upvar 1 $capable_var glx_swap_trace_capable
    upvar 1 $result_var saw_result
    upvar 1 $result_status_var result_status
    upvar 1 $xcb_capable_var glx_swap_xcb_trace_capable
    upvar 1 $syscall_capable_var glx_swap_syscall_trace_capable
    upvar 1 $buffers_var glx_swap_buffers_calls
    upvar 1 $buffers_msc_oml_var glx_swap_buffers_msc_oml_calls
    upvar 1 $total_ms_var glx_swap_total_ms
    upvar 1 $max_ms_var glx_swap_max_ms
    upvar 1 $nested_pixmap_var glx_swap_nested_pixmap_calls
    upvar 1 $nested_pixmap_checked_var glx_swap_nested_pixmap_checked_calls
    upvar 1 $nested_pixmap_ms_var glx_swap_nested_pixmap_total_ms
    upvar 1 $nested_wait_var glx_swap_nested_wait_special_calls
    upvar 1 $nested_poll_var glx_swap_nested_poll_special_calls
    upvar 1 $nested_wait_ms_var glx_swap_nested_wait_special_total_ms
    upvar 1 $nested_poll_ms_var glx_swap_nested_poll_special_total_ms
    upvar 1 $nested_complete_var glx_swap_nested_complete_events
    upvar 1 $nested_xcb_flush_var glx_swap_nested_xcb_flush_calls
    upvar 1 $nested_xcb_flush_ms_var glx_swap_nested_xcb_flush_total_ms
    upvar 1 $nested_xcb_request_check_var glx_swap_nested_xcb_request_check_calls
    upvar 1 $nested_xcb_request_check_ms_var glx_swap_nested_xcb_request_check_total_ms
    upvar 1 $nested_xcb_wait_reply_var glx_swap_nested_xcb_wait_reply_calls
    upvar 1 $nested_xcb_wait_reply_ms_var glx_swap_nested_xcb_wait_reply_total_ms
    upvar 1 $nested_xcb_poll_reply_var glx_swap_nested_xcb_poll_reply_calls
    upvar 1 $nested_xcb_poll_reply_ms_var glx_swap_nested_xcb_poll_reply_total_ms
    upvar 1 $nested_xcb_wait_event_var glx_swap_nested_xcb_wait_event_calls
    upvar 1 $nested_xcb_wait_event_ms_var glx_swap_nested_xcb_wait_event_total_ms
    upvar 1 $nested_xcb_poll_event_var glx_swap_nested_xcb_poll_event_calls
    upvar 1 $nested_xcb_poll_event_ms_var glx_swap_nested_xcb_poll_event_total_ms
    upvar 1 $accounted_ms_var glx_swap_accounted_present_ms
    upvar 1 $above_ms_var glx_swap_above_present_ms
    upvar 1 $accounted_xcb_ms_var glx_swap_accounted_xcb_ms
    upvar 1 $above_xcb_ms_var glx_swap_above_xcb_ms
    upvar 1 $syscall_total_ms_var glx_swap_syscall_total_ms
    upvar 1 $syscall_nested_x11_ms_var glx_swap_syscall_nested_x11_ms
    upvar 1 $syscall_above_x11_ms_var glx_swap_syscall_above_x11_ms
    upvar 1 $syscall_ioctl_calls_var glx_swap_syscall_ioctl_calls
    upvar 1 $syscall_ioctl_total_ms_var glx_swap_syscall_ioctl_total_ms
    upvar 1 $syscall_ioctl_max_ms_var glx_swap_syscall_ioctl_max_ms
    upvar 1 $syscall_poll_ppoll_calls_var glx_swap_syscall_poll_ppoll_calls
    upvar 1 $syscall_poll_ppoll_total_ms_var glx_swap_syscall_poll_ppoll_total_ms
    upvar 1 $syscall_poll_ppoll_max_ms_var glx_swap_syscall_poll_ppoll_max_ms
    upvar 1 $syscall_select_pselect_calls_var glx_swap_syscall_select_pselect_calls
    upvar 1 $syscall_select_pselect_total_ms_var glx_swap_syscall_select_pselect_total_ms
    upvar 1 $syscall_select_pselect_max_ms_var glx_swap_syscall_select_pselect_max_ms
    upvar 1 $syscall_read_recv_calls_var glx_swap_syscall_read_recv_calls
    upvar 1 $syscall_read_recv_total_ms_var glx_swap_syscall_read_recv_total_ms
    upvar 1 $syscall_read_recv_max_ms_var glx_swap_syscall_read_recv_max_ms
    upvar 1 $syscall_write_send_calls_var glx_swap_syscall_write_send_calls
    upvar 1 $syscall_write_send_total_ms_var glx_swap_syscall_write_send_total_ms
    upvar 1 $syscall_write_send_max_ms_var glx_swap_syscall_write_send_max_ms
    upvar 1 $missing_symbols_var glx_swap_missing_symbols
    upvar 1 $recursion_skips_var glx_swap_recursion_skips

    if {$child_pid eq ""} {
        return
    }
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-present-trace: phase=present_trace status=BEGIN[^\r\n]*pid=([0-9]+)[^\r\n]*glx_swap_trace=1} $line -> found_pid] &&
            $found_pid eq $child_pid} {
            set glx_swap_trace_capable 1
            if {[regexp {glx_swap_xcb_trace=1} $line]} {
                set glx_swap_xcb_trace_capable 1
            }
            if {[regexp {glx_swap_syscall_trace=1} $line]} {
                set glx_swap_syscall_trace_capable 1
            }
        }
        if {![regexp {host-x11-present-trace: phase=glx_swap_trace_result status=([^ \r\n]+)[^\r\n]*pid=([0-9]+)} $line -> found_status found_pid] ||
            $found_pid ne $child_pid} {
            continue
        }
        set glx_swap_trace_capable 1
        set saw_result 1
        if {[regexp {glx_swap_syscall_trace=1} $line]} {
            set glx_swap_syscall_trace_capable 1
        }
        if {$found_status ne "PASS"} {
            set result_status $found_status
        } elseif {$result_status eq ""} {
            set result_status $found_status
        }
        if {[regexp {glx_swap_buffers_calls=([0-9]+)} $line -> found]} {
            set glx_swap_buffers_calls $found
        }
        if {[regexp {glx_swap_buffers_msc_oml_calls=([0-9]+)} $line -> found]} {
            set glx_swap_buffers_msc_oml_calls $found
        }
        if {[regexp {glx_swap_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_total_ms $found
        }
        if {[regexp {glx_swap_max_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_max_ms $found
        }
        if {[regexp {glx_swap_nested_pixmap_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_pixmap_calls $found
        }
        if {[regexp {glx_swap_nested_pixmap_checked_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_pixmap_checked_calls $found
        }
        if {[regexp {glx_swap_nested_pixmap_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_pixmap_total_ms $found
        }
        if {[regexp {glx_swap_nested_wait_special_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_wait_special_calls $found
        }
        if {[regexp {glx_swap_nested_poll_special_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_poll_special_calls $found
        }
        if {[regexp {glx_swap_nested_wait_special_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_wait_special_total_ms $found
        }
        if {[regexp {glx_swap_nested_poll_special_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_poll_special_total_ms $found
        }
        if {[regexp {glx_swap_nested_complete_events=([0-9]+)} $line -> found]} {
            set glx_swap_nested_complete_events $found
        }
        if {[regexp {glx_swap_nested_xcb_flush_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_xcb_flush_calls $found
        }
        if {[regexp {glx_swap_nested_xcb_flush_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_xcb_flush_total_ms $found
        }
        if {[regexp {glx_swap_nested_xcb_request_check_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_xcb_request_check_calls $found
        }
        if {[regexp {glx_swap_nested_xcb_request_check_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_xcb_request_check_total_ms $found
        }
        if {[regexp {glx_swap_nested_xcb_wait_reply_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_xcb_wait_reply_calls $found
        }
        if {[regexp {glx_swap_nested_xcb_wait_reply_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_xcb_wait_reply_total_ms $found
        }
        if {[regexp {glx_swap_nested_xcb_poll_reply_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_xcb_poll_reply_calls $found
        }
        if {[regexp {glx_swap_nested_xcb_poll_reply_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_xcb_poll_reply_total_ms $found
        }
        if {[regexp {glx_swap_nested_xcb_wait_event_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_xcb_wait_event_calls $found
        }
        if {[regexp {glx_swap_nested_xcb_wait_event_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_xcb_wait_event_total_ms $found
        }
        if {[regexp {glx_swap_nested_xcb_poll_event_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_xcb_poll_event_calls $found
        }
        if {[regexp {glx_swap_nested_xcb_poll_event_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_xcb_poll_event_total_ms $found
        }
        if {[regexp {glx_swap_accounted_present_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_accounted_present_ms $found
        }
        if {[regexp {glx_swap_above_present_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_above_present_ms $found
        }
        if {[regexp {glx_swap_accounted_xcb_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_accounted_xcb_ms $found
            set glx_swap_xcb_trace_capable 1
        }
        if {[regexp {glx_swap_above_xcb_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_above_xcb_ms $found
            set glx_swap_xcb_trace_capable 1
        }
        if {[regexp {glx_swap_syscall_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_syscall_total_ms $found
            set glx_swap_syscall_trace_capable 1
        }
        if {[regexp {glx_swap_syscall_nested_x11_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_syscall_nested_x11_ms $found
            set glx_swap_syscall_trace_capable 1
        }
        if {[regexp {glx_swap_syscall_above_x11_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_syscall_above_x11_ms $found
            set glx_swap_syscall_trace_capable 1
        }
        foreach family {ioctl poll_ppoll select_pselect read_recv write_send} {
            set prefix "glx_swap_syscall_${family}"
            if {[regexp [format {%s_calls=([0-9]+)} $prefix] $line -> found]} {
                set glx_swap_syscall_${family}_calls $found
                set glx_swap_syscall_trace_capable 1
            }
            if {[regexp [format {%s_total_ms=([0-9]+(\.[0-9]+)?)} $prefix] $line -> found _]} {
                set glx_swap_syscall_${family}_total_ms $found
                set glx_swap_syscall_trace_capable 1
            }
            if {[regexp [format {%s_max_ms=([0-9]+(\.[0-9]+)?)} $prefix] $line -> found _]} {
                set glx_swap_syscall_${family}_max_ms $found
                set glx_swap_syscall_trace_capable 1
            }
        }
        if {[regexp {glx_swap_missing_symbols=([0-9]+)} $line -> found]} {
            set glx_swap_missing_symbols $found
        }
        if {[regexp {glx_swap_recursion_skips=([0-9]+)} $line -> found]} {
            set glx_swap_recursion_skips $found
        }
    }
}

proc x11_glx_swap_trace_failure_label {child_pid saw_result result_status xcb_capable syscall_capable glx_swap_buffers_calls glx_swap_buffers_msc_oml_calls glx_swap_total_ms glx_swap_max_ms glx_swap_nested_pixmap_calls glx_swap_nested_pixmap_checked_calls glx_swap_nested_pixmap_total_ms glx_swap_nested_wait_special_calls glx_swap_nested_poll_special_calls glx_swap_nested_wait_special_total_ms glx_swap_nested_poll_special_total_ms glx_swap_nested_complete_events glx_swap_nested_xcb_flush_calls glx_swap_nested_xcb_flush_total_ms glx_swap_nested_xcb_request_check_calls glx_swap_nested_xcb_request_check_total_ms glx_swap_nested_xcb_wait_reply_calls glx_swap_nested_xcb_wait_reply_total_ms glx_swap_nested_xcb_poll_reply_calls glx_swap_nested_xcb_poll_reply_total_ms glx_swap_nested_xcb_wait_event_calls glx_swap_nested_xcb_wait_event_total_ms glx_swap_nested_xcb_poll_event_calls glx_swap_nested_xcb_poll_event_total_ms glx_swap_accounted_present_ms glx_swap_above_present_ms glx_swap_accounted_xcb_ms glx_swap_above_xcb_ms glx_swap_syscall_total_ms glx_swap_syscall_nested_x11_ms glx_swap_syscall_above_x11_ms glx_swap_syscall_ioctl_calls glx_swap_syscall_ioctl_total_ms glx_swap_syscall_ioctl_max_ms glx_swap_syscall_poll_ppoll_calls glx_swap_syscall_poll_ppoll_total_ms glx_swap_syscall_poll_ppoll_max_ms glx_swap_syscall_select_pselect_calls glx_swap_syscall_select_pselect_total_ms glx_swap_syscall_select_pselect_max_ms glx_swap_syscall_read_recv_calls glx_swap_syscall_read_recv_total_ms glx_swap_syscall_read_recv_max_ms glx_swap_syscall_write_send_calls glx_swap_syscall_write_send_total_ms glx_swap_syscall_write_send_max_ms glx_swap_missing_symbols glx_swap_recursion_skips} {
    if {$child_pid eq ""} {
        return "x11-glx-fps-glx-swap-trace-child-pid-missing"
    }
    if {!$saw_result} {
        return "x11-glx-fps-glx-swap-trace-result-missing"
    }
    if {$result_status ne "PASS"} {
        return "x11-glx-fps-glx-swap-trace-result-$result_status"
    }
    foreach value [list $glx_swap_buffers_calls $glx_swap_buffers_msc_oml_calls $glx_swap_nested_pixmap_calls $glx_swap_nested_pixmap_checked_calls $glx_swap_nested_wait_special_calls $glx_swap_nested_poll_special_calls $glx_swap_nested_complete_events $glx_swap_missing_symbols $glx_swap_recursion_skips] {
        if {$value eq "" || ![string is integer -strict $value] || $value < 0} {
            return "x11-glx-fps-glx-swap-trace-counter-invalid"
        }
    }
    foreach value [list $glx_swap_total_ms $glx_swap_max_ms $glx_swap_nested_pixmap_total_ms $glx_swap_nested_wait_special_total_ms $glx_swap_nested_poll_special_total_ms $glx_swap_accounted_present_ms $glx_swap_above_present_ms] {
        if {$value eq "" || ![string is double -strict $value] || $value < 0} {
            return "x11-glx-fps-glx-swap-trace-timing-invalid"
        }
    }
    if {$xcb_capable} {
        foreach value [list $glx_swap_nested_xcb_flush_calls $glx_swap_nested_xcb_request_check_calls $glx_swap_nested_xcb_wait_reply_calls $glx_swap_nested_xcb_poll_reply_calls $glx_swap_nested_xcb_wait_event_calls $glx_swap_nested_xcb_poll_event_calls] {
            if {$value eq "" || ![string is integer -strict $value] || $value < 0} {
                return "x11-glx-fps-glx-swap-trace-xcb-counter-invalid"
            }
        }
        foreach value [list $glx_swap_nested_xcb_flush_total_ms $glx_swap_nested_xcb_request_check_total_ms $glx_swap_nested_xcb_wait_reply_total_ms $glx_swap_nested_xcb_poll_reply_total_ms $glx_swap_nested_xcb_wait_event_total_ms $glx_swap_nested_xcb_poll_event_total_ms $glx_swap_accounted_xcb_ms $glx_swap_above_xcb_ms] {
            if {$value eq "" || ![string is double -strict $value] || $value < 0} {
                return "x11-glx-fps-glx-swap-trace-xcb-timing-invalid"
            }
        }
        if {$glx_swap_accounted_xcb_ms > $glx_swap_total_ms + 0.010} {
            return "x11-glx-fps-glx-swap-trace-xcb-accounting-exceeds-total"
        }
        if {$glx_swap_accounted_present_ms + $glx_swap_accounted_xcb_ms > $glx_swap_total_ms + 0.010} {
            return "x11-glx-fps-glx-swap-trace-combined-accounting-exceeds-total"
        }
    }
    if {$syscall_capable} {
        foreach value [list $glx_swap_syscall_ioctl_calls $glx_swap_syscall_poll_ppoll_calls $glx_swap_syscall_select_pselect_calls $glx_swap_syscall_read_recv_calls $glx_swap_syscall_write_send_calls] {
            if {$value eq "" || ![string is integer -strict $value] || $value < 0} {
                return "x11-glx-fps-glx-swap-trace-syscall-counter-invalid"
            }
        }
        foreach value [list $glx_swap_syscall_total_ms $glx_swap_syscall_nested_x11_ms $glx_swap_syscall_above_x11_ms $glx_swap_syscall_ioctl_total_ms $glx_swap_syscall_ioctl_max_ms $glx_swap_syscall_poll_ppoll_total_ms $glx_swap_syscall_poll_ppoll_max_ms $glx_swap_syscall_select_pselect_total_ms $glx_swap_syscall_select_pselect_max_ms $glx_swap_syscall_read_recv_total_ms $glx_swap_syscall_read_recv_max_ms $glx_swap_syscall_write_send_total_ms $glx_swap_syscall_write_send_max_ms] {
            if {$value eq "" || ![string is double -strict $value] || $value < 0} {
                return "x11-glx-fps-glx-swap-trace-syscall-timing-invalid"
            }
        }
        if {$glx_swap_syscall_nested_x11_ms > $glx_swap_syscall_total_ms + 0.010} {
            return "x11-glx-fps-glx-swap-trace-syscall-nested-exceeds-total"
        }
        if {$glx_swap_syscall_nested_x11_ms + $glx_swap_syscall_above_x11_ms > $glx_swap_syscall_total_ms + 0.010} {
            return "x11-glx-fps-glx-swap-trace-syscall-accounting-exceeds-total"
        }
    }
    if {$glx_swap_missing_symbols != 0} {
        return "x11-glx-fps-glx-swap-trace-missing-symbols"
    }
    if {$glx_swap_buffers_calls + $glx_swap_buffers_msc_oml_calls <= 0} {
        return "x11-glx-fps-glx-swap-trace-swap-missing"
    }
    return ""
}

proc x11_present_fps_failure_label_from_line {line} {
    set line [string trim $line]
    if {[regexp {host-x11-dri3-present-smoke: phase=present_fps_result status=FAIL} $line]} {
        if {[regexp {reason=([^ \r\n]+)} $line -> reason]} {
            return "x11-present-fps-result-FAIL-$reason"
        }
        return "x11-present-fps-result-FAIL"
    }
    if {[regexp {host-x11-dri3-present-smoke: phase=([A-Za-z0-9_]+)[^\r\n]*status=FAIL} $line -> phase]} {
        return "x11-present-fps-${phase}-status-FAIL"
    }
    if {[regexp {host-x11-egl-smoke: phase=present_fps_variant[^\r\n]*status=FAIL[^\r\n]*reason=([^ \r\n]+)} $line -> reason]} {
        return "x11-present-fps-variant-$reason"
    }
    if {[regexp {host-x11-dri3-present-smoke: (connect|atom setup|event) (failed|eof)} $line -> phase reason]} {
        regsub -all { } $phase {_} phase
        return "x11-present-fps-${phase}-${reason}"
    }
    if {[regexp {No such file|cannot execute|not found} $line]} {
        return "x11-present-fps-exec-missing"
    }
    return ""
}

proc x11_egl_scan_glx_probe_log {text start_var connect_var egl_init_var glx_ext_var glx_version_var fbconfigs_var visual_var context_var current_var strings_var draw_var result_var failure_var} {
    upvar 1 $start_var saw_start
    upvar 1 $connect_var saw_connect
    upvar 1 $egl_init_var saw_egl_init
    upvar 1 $glx_ext_var saw_glx_ext
    upvar 1 $glx_version_var saw_glx_version
    upvar 1 $fbconfigs_var saw_fbconfigs
    upvar 1 $visual_var saw_visual
    upvar 1 $context_var saw_context
    upvar 1 $current_var saw_current
    upvar 1 $strings_var saw_strings
    upvar 1 $draw_var saw_draw
    upvar 1 $result_var saw_result
    upvar 1 $failure_var failure_label

    set in_glx_probe 0
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-egl-smoke: phase=start status=BEGIN mode=glx-probe} $line]} {
            set in_glx_probe 1
            set saw_start 1
        }
        if {!$in_glx_probe} {
            continue
        }
        if {[regexp {host-x11-egl-smoke: phase=x11_connect status=PASS} $line]} {
            set saw_connect 1
        }
        if {[regexp {host-x11-egl-smoke: phase=egl_initialize status=(PASS|FALLBACK)} $line]} {
            set saw_egl_init 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_query_extension status=PASS} $line]} {
            set saw_glx_ext 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_query_version status=PASS} $line]} {
            set saw_glx_version 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_fbconfigs status=PASS} $line]} {
            set saw_fbconfigs 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_choose_visual status=PASS} $line]} {
            set saw_visual 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_create_context status=PASS} $line]} {
            set saw_context 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_make_current status=PASS} $line]} {
            set saw_current 1
        }
        if {[regexp {host-x11-egl-smoke: phase=gl_strings status=PASS} $line]} {
            set saw_strings 1
        }
        if {[regexp {host-x11-egl-smoke: phase=draw status=PASS} $line]} {
            set saw_draw 1
        }
        if {[regexp {host-x11-egl-smoke: phase=result status=PASS} $line]} {
            set saw_result 1
        }
        if {$failure_label eq ""} {
            set label [x11_egl_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
}

proc x11_glx_fps_scan_log {text start_var connect_var egl_init_var glx_ext_var glx_version_var fbconfigs_var visual_var context_var current_var strings_var fps_begin_var fps_result_var fps_status_var fps_frames_var fps_elapsed_var fps_value_var variant_var requested_depth_var requested_sample_interval_var result_variant_var oml_available_var queue_depth_var sbc_issued_var sbc_completed_var max_pending_var oml_last_sbc_var gl_flush_total_var swap_msc_issue_total_var get_sync_before_total_var get_sync_after_total_var issue_state_sample_interval_var issue_state_sampled_ratio_var issue_state_first_sample_frame_var issue_state_last_sample_frame_var issue_state_first_sample_sbc_var issue_state_last_sample_sbc_var issue_state_samples_var post_issue_sbc_completed_count_var post_issue_sbc_lag_max_var post_issue_msc_delta_total_var post_issue_msc_delta_max_var swap_only_skipped_draw_frames_var swap_interval_requested_var swap_interval_set_api_var swap_interval_set_status_var swap_interval_before_var swap_interval_after_var plain_swap_issue_total_var plain_swap_avg_var plain_swap_max_var plain_oml_available_var plain_oml_samples_var plain_oml_sample_interval_var plain_oml_sampled_ratio_var plain_oml_first_sample_frame_var plain_oml_last_sample_frame_var plain_oml_get_sync_before_total_var plain_oml_get_sync_after_total_var plain_oml_before_first_sbc_var plain_oml_before_last_sbc_var plain_oml_after_first_sbc_var plain_oml_after_last_sbc_var plain_oml_post_swap_sbc_delta_total_var plain_oml_post_swap_sbc_delta_max_var plain_oml_post_swap_msc_delta_total_var plain_oml_post_swap_msc_delta_max_var plain_post_swap_xsync_total_var plain_post_swap_xsync_max_var failure_var} {
    upvar 1 $start_var saw_start
    upvar 1 $connect_var saw_connect
    upvar 1 $egl_init_var saw_egl_init
    upvar 1 $glx_ext_var saw_glx_ext
    upvar 1 $glx_version_var saw_glx_version
    upvar 1 $fbconfigs_var saw_fbconfigs
    upvar 1 $visual_var saw_visual
    upvar 1 $context_var saw_context
    upvar 1 $current_var saw_current
    upvar 1 $strings_var saw_strings
    upvar 1 $fps_begin_var saw_fps_begin
    upvar 1 $fps_result_var saw_fps_result
    upvar 1 $fps_status_var fps_status
    upvar 1 $fps_frames_var fps_frames
    upvar 1 $fps_elapsed_var fps_elapsed
    upvar 1 $fps_value_var fps_value
    upvar 1 $variant_var variant
    upvar 1 $requested_depth_var requested_depth
    upvar 1 $requested_sample_interval_var requested_sample_interval
    upvar 1 $result_variant_var result_variant
    upvar 1 $oml_available_var oml_available
    upvar 1 $queue_depth_var queue_depth
    upvar 1 $sbc_issued_var sbc_issued
    upvar 1 $sbc_completed_var sbc_completed
    upvar 1 $max_pending_var max_pending
    upvar 1 $oml_last_sbc_var oml_last_sbc
    upvar 1 $gl_flush_total_var gl_flush_total
    upvar 1 $swap_msc_issue_total_var swap_msc_issue_total
    upvar 1 $get_sync_before_total_var get_sync_before_total
    upvar 1 $get_sync_after_total_var get_sync_after_total
    upvar 1 $issue_state_sample_interval_var issue_state_sample_interval
    upvar 1 $issue_state_sampled_ratio_var issue_state_sampled_ratio
    upvar 1 $issue_state_first_sample_frame_var issue_state_first_sample_frame
    upvar 1 $issue_state_last_sample_frame_var issue_state_last_sample_frame
    upvar 1 $issue_state_first_sample_sbc_var issue_state_first_sample_sbc
    upvar 1 $issue_state_last_sample_sbc_var issue_state_last_sample_sbc
    upvar 1 $issue_state_samples_var issue_state_samples
    upvar 1 $post_issue_sbc_completed_count_var post_issue_sbc_completed_count
    upvar 1 $post_issue_sbc_lag_max_var post_issue_sbc_lag_max
    upvar 1 $post_issue_msc_delta_total_var post_issue_msc_delta_total
    upvar 1 $post_issue_msc_delta_max_var post_issue_msc_delta_max
    upvar 1 $swap_only_skipped_draw_frames_var swap_only_skipped_draw_frames
    upvar 1 $swap_interval_requested_var swap_interval_requested
    upvar 1 $swap_interval_set_api_var swap_interval_set_api
    upvar 1 $swap_interval_set_status_var swap_interval_set_status
    upvar 1 $swap_interval_before_var swap_interval_before
    upvar 1 $swap_interval_after_var swap_interval_after
    upvar 1 $plain_swap_issue_total_var plain_swap_issue_total
    upvar 1 $plain_swap_avg_var plain_swap_avg
    upvar 1 $plain_swap_max_var plain_swap_max
    upvar 1 $plain_oml_available_var plain_oml_available
    upvar 1 $plain_oml_samples_var plain_oml_samples
    upvar 1 $plain_oml_sample_interval_var plain_oml_sample_interval
    upvar 1 $plain_oml_sampled_ratio_var plain_oml_sampled_ratio
    upvar 1 $plain_oml_first_sample_frame_var plain_oml_first_sample_frame
    upvar 1 $plain_oml_last_sample_frame_var plain_oml_last_sample_frame
    upvar 1 $plain_oml_get_sync_before_total_var plain_oml_get_sync_before_total
    upvar 1 $plain_oml_get_sync_after_total_var plain_oml_get_sync_after_total
    upvar 1 $plain_oml_before_first_sbc_var plain_oml_before_first_sbc
    upvar 1 $plain_oml_before_last_sbc_var plain_oml_before_last_sbc
    upvar 1 $plain_oml_after_first_sbc_var plain_oml_after_first_sbc
    upvar 1 $plain_oml_after_last_sbc_var plain_oml_after_last_sbc
    upvar 1 $plain_oml_post_swap_sbc_delta_total_var plain_oml_post_swap_sbc_delta_total
    upvar 1 $plain_oml_post_swap_sbc_delta_max_var plain_oml_post_swap_sbc_delta_max
    upvar 1 $plain_oml_post_swap_msc_delta_total_var plain_oml_post_swap_msc_delta_total
    upvar 1 $plain_oml_post_swap_msc_delta_max_var plain_oml_post_swap_msc_delta_max
    upvar 1 plain_oml_after_sbc_delta_total plain_oml_after_sbc_delta_total
    upvar 1 plain_oml_after_sbc_delta_max plain_oml_after_sbc_delta_max
    upvar 1 plain_oml_after_msc_delta_total plain_oml_after_msc_delta_total
    upvar 1 plain_oml_after_msc_delta_max plain_oml_after_msc_delta_max
    upvar 1 $plain_post_swap_xsync_total_var plain_post_swap_xsync_total
    upvar 1 $plain_post_swap_xsync_max_var plain_post_swap_xsync_max
    upvar 1 $failure_var failure_label

    set in_glx_fps 0
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-egl-smoke: phase=start status=BEGIN mode=glx-fps} $line]} {
            set in_glx_fps 1
            set saw_start 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_fps status=BEGIN} $line] ||
            [regexp {host-x11-egl-smoke: phase=glx_fps_result status=(PASS|FAIL)} $line]} {
            set in_glx_fps 1
        }
        if {[regexp {^probe_glx_fps_variant=([^ \r\n]+)} $line -> found_variant]} {
            set variant $found_variant
        }
        if {[regexp {^probe_glx_fps_oml_queue_depth=([0-9]+)} $line -> found_requested_depth]} {
            set requested_depth $found_requested_depth
        }
        if {[regexp {^probe_glx_fps_oml_issue_state_sample_interval=([0-9]+)} $line -> found_requested_sample_interval]} {
            set requested_sample_interval $found_requested_sample_interval
        }
        if {!$in_glx_fps} {
            if {$failure_label eq ""} {
                set label [x11_glx_fps_failure_label_from_line $line]
                if {$label ne ""} {
                    set failure_label $label
                }
            }
            continue
        }
        if {[regexp {host-x11-egl-smoke: phase=x11_connect status=PASS} $line]} {
            set saw_connect 1
        }
        if {[regexp {host-x11-egl-smoke: phase=egl_initialize status=(PASS|FALLBACK)} $line]} {
            set saw_egl_init 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_query_extension status=PASS} $line]} {
            set saw_glx_ext 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_query_version status=PASS} $line]} {
            set saw_glx_version 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_fbconfigs status=PASS} $line]} {
            set saw_fbconfigs 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_choose_visual status=PASS} $line]} {
            set saw_visual 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_create_context status=PASS} $line]} {
            set saw_context 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_make_current status=PASS} $line]} {
            set saw_current 1
        }
        if {[regexp {host-x11-egl-smoke: phase=gl_strings status=PASS} $line]} {
            set saw_strings 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_fps status=BEGIN} $line]} {
            set saw_fps_begin 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_fps_result status=(PASS|FAIL)[^\r\n]*renderer="[^"]*"[^\r\n]*vendor="[^"]*"[^\r\n]*gl_version="[^"]*"[^\r\n]*direct_available=[0-9]+[^\r\n]*direct=-?[0-9]+[^\r\n]*frames=([0-9]+)[^\r\n]*elapsed_seconds=([0-9]+(\.[0-9]+)?)[^\r\n]*fps=([0-9]+(\.[0-9]+)?)} $line -> found_status found_frames found_elapsed _ found_fps]} {
            set saw_fps_result 1
            set fps_status $found_status
            set fps_frames $found_frames
            set fps_elapsed $found_elapsed
            set fps_value $found_fps
            if {[regexp {variant=([^ \r\n]+)} $line -> found_variant]} {
                set result_variant $found_variant
            }
            if {[regexp {oml_available=([0-9]+)} $line -> found_oml_available]} {
                set oml_available $found_oml_available
            }
            if {[regexp {oml_queue_depth=([0-9]+)} $line -> found_queue_depth]} {
                set queue_depth $found_queue_depth
            }
            if {[regexp {oml_sbc_issued=([0-9]+)} $line -> found_sbc_issued]} {
                set sbc_issued $found_sbc_issued
            }
            if {[regexp {oml_sbc_completed=([0-9]+)} $line -> found_sbc_completed]} {
                set sbc_completed $found_sbc_completed
            }
            if {[regexp {oml_max_pending_sbc=([0-9]+)} $line -> found_max_pending]} {
                set max_pending $found_max_pending
            }
            if {[regexp {oml_last_sbc=(-?[0-9]+)} $line -> found_oml_last_sbc]} {
                set oml_last_sbc $found_oml_last_sbc
            }
            if {[regexp {oml_gl_flush_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_gl_flush_total _]} {
                set gl_flush_total $found_gl_flush_total
            }
            if {[regexp {oml_swap_msc_issue_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_swap_msc_issue_total _]} {
                set swap_msc_issue_total $found_swap_msc_issue_total
            }
            if {[regexp {oml_get_sync_before_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_get_sync_before_total _]} {
                set get_sync_before_total $found_get_sync_before_total
            }
            if {[regexp {oml_get_sync_after_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_get_sync_after_total _]} {
                set get_sync_after_total $found_get_sync_after_total
            }
            if {[regexp {oml_issue_state_sample_interval=([0-9]+)} $line -> found_issue_state_sample_interval]} {
                set issue_state_sample_interval $found_issue_state_sample_interval
            }
            if {[regexp {oml_issue_state_sampled_ratio=([0-9]+/[0-9]+)} $line -> found_issue_state_sampled_ratio]} {
                set issue_state_sampled_ratio $found_issue_state_sampled_ratio
            }
            if {[regexp {oml_issue_state_first_sample_frame=([0-9]+)} $line -> found_issue_state_first_sample_frame]} {
                set issue_state_first_sample_frame $found_issue_state_first_sample_frame
            }
            if {[regexp {oml_issue_state_last_sample_frame=([0-9]+)} $line -> found_issue_state_last_sample_frame]} {
                set issue_state_last_sample_frame $found_issue_state_last_sample_frame
            }
            if {[regexp {oml_issue_state_first_sample_sbc=(-?[0-9]+)} $line -> found_issue_state_first_sample_sbc]} {
                set issue_state_first_sample_sbc $found_issue_state_first_sample_sbc
            }
            if {[regexp {oml_issue_state_last_sample_sbc=(-?[0-9]+)} $line -> found_issue_state_last_sample_sbc]} {
                set issue_state_last_sample_sbc $found_issue_state_last_sample_sbc
            }
            if {[regexp {oml_issue_state_samples=([0-9]+)} $line -> found_issue_state_samples]} {
                set issue_state_samples $found_issue_state_samples
            }
            if {[regexp {oml_post_issue_sbc_completed_count=([0-9]+)} $line -> found_post_issue_sbc_completed_count]} {
                set post_issue_sbc_completed_count $found_post_issue_sbc_completed_count
            }
            if {[regexp {oml_post_issue_sbc_lag_max=(-?[0-9]+)} $line -> found_post_issue_sbc_lag_max]} {
                set post_issue_sbc_lag_max $found_post_issue_sbc_lag_max
            }
            if {[regexp {oml_post_issue_msc_delta_total=(-?[0-9]+)} $line -> found_post_issue_msc_delta_total]} {
                set post_issue_msc_delta_total $found_post_issue_msc_delta_total
            }
            if {[regexp {oml_post_issue_msc_delta_max=(-?[0-9]+)} $line -> found_post_issue_msc_delta_max]} {
                set post_issue_msc_delta_max $found_post_issue_msc_delta_max
            }
            if {[regexp {swap_only_skipped_draw_frames=([0-9]+)} $line -> found_swap_only_skipped_draw_frames]} {
                set swap_only_skipped_draw_frames $found_swap_only_skipped_draw_frames
            }
            if {[regexp {swap_interval_requested=([0-9]+)} $line -> found_swap_interval_requested]} {
                set swap_interval_requested $found_swap_interval_requested
            }
            if {[regexp {swap_interval_set_api=([^ \r\n]+)} $line -> found_swap_interval_set_api]} {
                set swap_interval_set_api $found_swap_interval_set_api
            }
            if {[regexp {swap_interval_set_status=([^ \r\n]+)} $line -> found_swap_interval_set_status]} {
                set swap_interval_set_status $found_swap_interval_set_status
            }
            if {[regexp {swap_interval_before=(-?[0-9]+)} $line -> found_swap_interval_before]} {
                set swap_interval_before $found_swap_interval_before
            }
            if {[regexp {swap_interval_after=(-?[0-9]+)} $line -> found_swap_interval_after]} {
                set swap_interval_after $found_swap_interval_after
            }
            if {[regexp {plain_swap_issue_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_swap_issue_total _]} {
                set plain_swap_issue_total $found_plain_swap_issue_total
            }
            if {[regexp {plain_swap_avg_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_swap_avg _]} {
                set plain_swap_avg $found_plain_swap_avg
            }
            if {[regexp {plain_swap_max_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_swap_max _]} {
                set plain_swap_max $found_plain_swap_max
            }
            if {[regexp {plain_oml_available=([0-9]+)} $line -> found_plain_oml_available]} {
                set plain_oml_available $found_plain_oml_available
            }
            if {[regexp {plain_oml_samples=([0-9]+)} $line -> found_plain_oml_samples]} {
                set plain_oml_samples $found_plain_oml_samples
            }
            if {[regexp {plain_oml_sample_interval=([0-9]+)} $line -> found_plain_oml_sample_interval]} {
                set plain_oml_sample_interval $found_plain_oml_sample_interval
            }
            if {[regexp {plain_oml_sampled_ratio=([0-9]+/[0-9]+)} $line -> found_plain_oml_sampled_ratio]} {
                set plain_oml_sampled_ratio $found_plain_oml_sampled_ratio
            }
            if {[regexp {plain_oml_first_sample_frame=([0-9]+)} $line -> found_plain_oml_first_sample_frame]} {
                set plain_oml_first_sample_frame $found_plain_oml_first_sample_frame
            }
            if {[regexp {plain_oml_last_sample_frame=([0-9]+)} $line -> found_plain_oml_last_sample_frame]} {
                set plain_oml_last_sample_frame $found_plain_oml_last_sample_frame
            }
            if {[regexp {plain_oml_get_sync_before_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_oml_get_sync_before_total _]} {
                set plain_oml_get_sync_before_total $found_plain_oml_get_sync_before_total
            }
            if {[regexp {plain_oml_get_sync_after_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_oml_get_sync_after_total _]} {
                set plain_oml_get_sync_after_total $found_plain_oml_get_sync_after_total
            }
            if {[regexp {plain_oml_before_first_sbc=(-?[0-9]+)} $line -> found_plain_oml_before_first_sbc]} {
                set plain_oml_before_first_sbc $found_plain_oml_before_first_sbc
            }
            if {[regexp {plain_oml_before_last_sbc=(-?[0-9]+)} $line -> found_plain_oml_before_last_sbc]} {
                set plain_oml_before_last_sbc $found_plain_oml_before_last_sbc
            }
            if {[regexp {plain_oml_after_first_sbc=(-?[0-9]+)} $line -> found_plain_oml_after_first_sbc]} {
                set plain_oml_after_first_sbc $found_plain_oml_after_first_sbc
            }
            if {[regexp {plain_oml_after_last_sbc=(-?[0-9]+)} $line -> found_plain_oml_after_last_sbc]} {
                set plain_oml_after_last_sbc $found_plain_oml_after_last_sbc
            }
            if {[regexp {plain_oml_post_swap_sbc_delta_total=(-?[0-9]+)} $line -> found_plain_oml_post_swap_sbc_delta_total]} {
                set plain_oml_post_swap_sbc_delta_total $found_plain_oml_post_swap_sbc_delta_total
            }
            if {[regexp {plain_oml_post_swap_sbc_delta_max=(-?[0-9]+)} $line -> found_plain_oml_post_swap_sbc_delta_max]} {
                set plain_oml_post_swap_sbc_delta_max $found_plain_oml_post_swap_sbc_delta_max
            }
            if {[regexp {plain_oml_post_swap_msc_delta_total=(-?[0-9]+)} $line -> found_plain_oml_post_swap_msc_delta_total]} {
                set plain_oml_post_swap_msc_delta_total $found_plain_oml_post_swap_msc_delta_total
            }
            if {[regexp {plain_oml_post_swap_msc_delta_max=(-?[0-9]+)} $line -> found_plain_oml_post_swap_msc_delta_max]} {
                set plain_oml_post_swap_msc_delta_max $found_plain_oml_post_swap_msc_delta_max
            }
            if {[regexp {plain_oml_after_sbc_delta_total=(-?[0-9]+)} $line -> found_plain_oml_after_sbc_delta_total]} {
                set plain_oml_after_sbc_delta_total $found_plain_oml_after_sbc_delta_total
            }
            if {[regexp {plain_oml_after_sbc_delta_max=(-?[0-9]+)} $line -> found_plain_oml_after_sbc_delta_max]} {
                set plain_oml_after_sbc_delta_max $found_plain_oml_after_sbc_delta_max
            }
            if {[regexp {plain_oml_after_msc_delta_total=(-?[0-9]+)} $line -> found_plain_oml_after_msc_delta_total]} {
                set plain_oml_after_msc_delta_total $found_plain_oml_after_msc_delta_total
            }
            if {[regexp {plain_oml_after_msc_delta_max=(-?[0-9]+)} $line -> found_plain_oml_after_msc_delta_max]} {
                set plain_oml_after_msc_delta_max $found_plain_oml_after_msc_delta_max
            }
            if {[regexp {plain_post_swap_xsync_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_post_swap_xsync_total _]} {
                set plain_post_swap_xsync_total $found_plain_post_swap_xsync_total
            }
            if {[regexp {plain_post_swap_xsync_max_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_post_swap_xsync_max _]} {
                set plain_post_swap_xsync_max $found_plain_post_swap_xsync_max
            }
        }
        if {$failure_label eq ""} {
            set label [x11_glx_fps_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }

    if {$saw_fps_result && $fps_status eq "PASS"} {
        set saw_start 1
        set saw_connect 1
        set saw_egl_init 1
        set saw_glx_ext 1
        set saw_glx_version 1
        set saw_fbconfigs 1
        set saw_visual 1
        set saw_context 1
        set saw_current 1
        set saw_strings 1
        set saw_fps_begin 1
    }
}

proc x11_present_fps_scan_log {text start_var connect_var dri3_var present_var select_var fd_var fps_begin_var fps_result_var fps_status_var fps_frames_var fps_elapsed_var fps_value_var issued_var completed_var outstanding_var requested_variant_var requested_depth_var result_variant_var queue_depth_var max_outstanding_var failure_var} {
    upvar 1 $start_var saw_start
    upvar 1 $connect_var saw_connect
    upvar 1 $dri3_var saw_dri3
    upvar 1 $present_var saw_present
    upvar 1 $select_var saw_select
    upvar 1 $fd_var saw_fd
    upvar 1 $fps_begin_var saw_fps_begin
    upvar 1 $fps_result_var saw_fps_result
    upvar 1 $fps_status_var fps_status
    upvar 1 $fps_frames_var fps_frames
    upvar 1 $fps_elapsed_var fps_elapsed
    upvar 1 $fps_value_var fps_value
    upvar 1 $issued_var issued
    upvar 1 $completed_var completed
    upvar 1 $outstanding_var outstanding
    upvar 1 $requested_variant_var requested_variant
    upvar 1 $requested_depth_var requested_depth
    upvar 1 $result_variant_var result_variant
    upvar 1 $queue_depth_var queue_depth
    upvar 1 $max_outstanding_var max_outstanding
    upvar 1 $failure_var failure_label

    set in_present_fps 0
    set saw_dri3_ext 0
    set saw_dri3_version 0
    set saw_present_ext 0
    set saw_present_version 0
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-dri3-present-smoke: phase=start status=BEGIN mode=present-fps} $line]} {
            set in_present_fps 1
            set saw_start 1
        }
        if {!$in_present_fps} {
            if {[regexp {^probe_present_fps_variant=([^ \r\n]+)} $line -> found_variant]} {
                set requested_variant $found_variant
            }
            if {[regexp {^probe_present_fps_queue_depth=([0-9]+)} $line -> found_requested_depth]} {
                set requested_depth $found_requested_depth
            }
            if {$failure_label eq ""} {
                set label [x11_present_fps_failure_label_from_line $line]
                if {$label ne ""} {
                    set failure_label $label
                }
            }
            continue
        }
        if {[regexp {host-x11-dri3-present-smoke: connected root=} $line]} {
            set saw_connect 1
        }
        if {[regexp {host-x11-dri3-present-smoke: extension name=DRI3 present=1} $line]} {
            set saw_dri3_ext 1
        }
        if {[regexp {host-x11-dri3-present-smoke: dri3_version major=} $line]} {
            set saw_dri3_version 1
        }
        if {[regexp {host-x11-dri3-present-smoke: extension name=Present present=1} $line]} {
            set saw_present_ext 1
        }
        if {[regexp {host-x11-dri3-present-smoke: present_version major=} $line]} {
            set saw_present_version 1
        }
        if {[regexp {host-x11-dri3-present-smoke: present_select_input status=PASS} $line]} {
            set saw_select 1
        }
        if {[regexp {host-x11-dri3-present-smoke: dri3_open_fd status=PASS} $line]} {
            set saw_fd 1
        }
        if {[regexp {host-x11-dri3-present-smoke: phase=present_fps status=BEGIN} $line]} {
            set saw_fps_begin 1
        }
        if {[regexp {host-x11-dri3-present-smoke: phase=present_fps_result status=(PASS|FAIL)[^\r\n]*present_only=1[^\r\n]*gl_context=0[^\r\n]*gl_draw_total_ms=0[^\r\n]*gl_swap_total_ms=0[^\r\n]*frames=([0-9]+)[^\r\n]*elapsed_seconds=([0-9]+(\.[0-9]+)?)[^\r\n]*fps=([0-9]+(\.[0-9]+)?)[^\r\n]* issued=([0-9]+) completed=([0-9]+) outstanding=([0-9]+)( |$)} $line -> found_status found_frames found_elapsed _ found_fps _ found_issued found_completed found_outstanding _]} {
            set saw_fps_result 1
            set fps_status $found_status
            set fps_frames $found_frames
            set fps_elapsed $found_elapsed
            set fps_value $found_fps
            set issued $found_issued
            set completed $found_completed
            set outstanding $found_outstanding
            if {[regexp {variant=([^ \r\n]+)} $line -> found_variant]} {
                set result_variant $found_variant
            }
            if {[regexp {queue_depth=([0-9]+)} $line -> found_queue_depth]} {
                set queue_depth $found_queue_depth
            }
            if {[regexp {max_outstanding=([0-9]+)} $line -> found_max_outstanding]} {
                set max_outstanding $found_max_outstanding
            }
        }
        if {$failure_label eq ""} {
            set label [x11_present_fps_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
    set saw_dri3 [expr {$saw_dri3_ext && $saw_dri3_version}]
    set saw_present [expr {$saw_present_ext && $saw_present_version}]
}

proc x11_egl_glx_probe_prelaunch_marker {log_path} {
    global timeout x11_egl_artifact_prefix

    set marker "GLXPRE[pid]"
    set pass_line "host-x11-egl-smoke: phase=prelaunch_prompt_sync status=PASS mode=best-effort marker=$marker\n"

    set x11_egl_artifact_prefix $pass_line
    write_x11_egl_artifact_log ""

    set old_timeout $timeout
    send "\025"
    sleep 1
    send "\r"
    sleep 3
    optional_prompt
    set timeout $old_timeout
}

proc x11_egl_glx_probe_launch_diag {log_path reason interrupt initial_text} {
    global timeout x11_egl_artifact_prefix

    set diag "host-x11-egl-smoke: phase=launch_status_wait status=FAIL reason=$reason\n"
    append diag $initial_text
    if {$interrupt} {
        set old_timeout $timeout
        set timeout 10
        send "\003"
        sleep 1
        send "echo GLXDIAGREADY\r"
        expect {
            -re {(^|[\r\n])GLXDIAGREADY[\r\n]} {
                append diag $expect_out(buffer)
                foreach cmd [list "ls -l $log_path" "cat $log_path" "ps"] marker {GLXDIAGLS GLXDIAGCAT GLXDIAGPS} {
                    set marker_re [format {(^|[\r\n])%s[\r\n]} $marker]
                    send "$cmd; echo $marker\r"
                    expect {
                        -re $marker_re {
                            append diag $expect_out(buffer)
                        }
                        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                            append diag $expect_out(buffer)
                            break
                        }
                        timeout {
                            catch { append diag $expect_out(buffer) }
                            append diag "\nhost-x11-egl-smoke: phase=launch_status_wait_diag status=FAIL cmd={$cmd} reason=timeout\n"
                            break
                        }
                        eof {
                            catch { append diag $expect_out(buffer) }
                            append diag "\nhost-x11-egl-smoke: phase=launch_status_wait_diag status=FAIL cmd={$cmd} reason=eof\n"
                            break
                        }
                    }
                }
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                append diag $expect_out(buffer)
            }
            timeout {
                catch { append diag $expect_out(buffer) }
                append diag "\nhost-x11-egl-smoke: phase=launch_status_wait_diag status=FAIL reason=timeout\n"
            }
            eof {
                catch { append diag $expect_out(buffer) }
                append diag "\nhost-x11-egl-smoke: phase=launch_status_wait_diag status=FAIL reason=eof\n"
            }
        }
        set timeout $old_timeout
    }
    if {![regexp {\n$} $diag]} {
        append diag "\n"
    }
    append x11_egl_artifact_prefix $diag
    write_x11_egl_artifact_log ""
}

proc x11_egl_glx_probe_xopen_preflight {log_path {skip_diag 0}} {
    global timeout x11_egl_artifact_prefix

    set old_timeout $timeout
    set selected_display ""

    set log_redirect ">> $log_path"
    set preflight_steps [list \
        [list begin "printf '%s\\n' 'host-x11-egl-smoke: phase=x11_preflight status=BEGIN' $log_redirect"] \
        [list preflight_env "{ printf '%s\\n' 'host-x11-egl-smoke: diag preflight_env'; env | grep '^DISPLAY=' || printf '%s\\n' 'DISPLAY=(unset)'; env | grep '^XDG_RUNTIME_DIR=' || printf '%s\\n' 'XDG_RUNTIME_DIR=(unset)'; } $log_redirect"] \
        [list preflight_x11_unix "{ printf '%s\\n' 'host-x11-egl-smoke: diag preflight_x11_unix'; ls -ld /tmp/.X11-unix /tmp/.X11-unix/* || true; } $log_redirect"] \
        [list preflight_ps "{ printf '%s\\n' 'host-x11-egl-smoke: diag preflight_ps'; ps || true; } $log_redirect"] \
        [list preflight_kde_process_probe "{ printf '%s\\n' 'host-x11-egl-smoke: diag preflight_kde_process_probe'; /bin/kde-process-probe || true; } $log_redirect"] \
        [list pass "printf '%s\\n' 'host-x11-egl-smoke: phase=x11_preflight_diag status=PASS' $log_redirect"] \
    ]

    if {!$skip_diag} {
        foreach step_info $preflight_steps {
            set step [lindex $step_info 0]
            set cmd [lindex $step_info 1]
            set diag_marker "X11PREFLIGHTDIAG[pid]_$step"
            set marker_re [format {(^|[\r\n])%s:([0-9]+)[\r\n]} $diag_marker]

            set timeout 30
            send "$cmd; echo $diag_marker:\$?\r"
            expect {
                -re $marker_re {}
                -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                    set timeout $old_timeout
                    finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-crash"
                }
                timeout {
                    append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight status=FAIL reason=diag-timeout step=$step\n"
                    catch { append x11_egl_artifact_prefix $expect_out(buffer) }
                    write_x11_egl_artifact_log ""
                    set timeout $old_timeout
                    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-failed reason=diag-timeout step=$step"
                }
                eof {
                    set timeout $old_timeout
                    finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-eof"
                }
            }
        }
    } else {
        append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight status=BEGIN\n"
        append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight_diag status=SKIP reason=fps-candidate-only\n"
        write_x11_egl_artifact_log ""
    }

    foreach display {:0 :1} {
        set candidate_marker "X11PREFLIGHTCAND[pid][string map {: _} $display]"
        set marker_re [format {%s:([0-9]+)} $candidate_marker]
        set timeout 45
        append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight_candidate status=BEGIN display=$display\n"
        write_x11_egl_artifact_log ""
        send "DISPLAY=$display HOST_X11_EGL_SMOKE_MODE=x11-connect /bin/host-x11-egl-smoke --x11-connect-only; echo $candidate_marker:\$?\r"
        expect {
            -re $marker_re {
                set status [string trim $expect_out(1,string)]
                if {$status eq "0"} {
                    append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight_candidate status=PASS display=$display exit_status=$status\n"
                    append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight status=PASS selected_display=$display\n"
                    write_x11_egl_artifact_log ""
                    set selected_display $display
                    break
                } else {
                    append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight_candidate status=FAIL display=$display exit_status=$status\n"
                    write_x11_egl_artifact_log ""
                }
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                set timeout $old_timeout
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-crash display=$display"
            }
            timeout {
                append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight_candidate status=FAIL display=$display reason=timeout\n"
                write_x11_egl_artifact_log ""
                send "\003"
                sleep 1
                optional_prompt
            }
            eof {
                set timeout $old_timeout
                finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-eof display=$display"
            }
        }
    }

    set timeout $old_timeout
    if {$selected_display ne ""} {
        return $selected_display
    }

    set fail_marker "X11PREFLIGHTFAIL[pid]"
    set marker_re [format {%s:([0-9]+)} $fail_marker]
    set timeout 10
    append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight status=FAIL reason=no-display-candidate label=x11-egl-XOpenDisplay-preflight-failed displays=:0,:1\n"
    write_x11_egl_artifact_log ""
    send "echo $fail_marker:0\r"
    expect {
        -re $marker_re {}
        timeout {
            append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight status=FAIL reason=final-log-timeout label=x11-egl-XOpenDisplay-preflight-failed\n"
            write_x11_egl_artifact_log ""
        }
        eof {
            set timeout $old_timeout
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-eof"
        }
    }
    set timeout $old_timeout
    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-failed displays=:0,:1"
}

proc read_x11_egl_session_log {label} {
    global timeout guest_host_x11_egl_log
    global x11_egl_last_log_source x11_egl_last_log_bytes

    set artifact_text ""
    if {[read_x11_egl_host_artifact_log artifact_text]} {
        if {[x11_egl_session_log_complete $label $artifact_text]} {
            set x11_egl_last_log_source "host-artifact"
            set x11_egl_last_log_bytes [string length $artifact_text]
            return $artifact_text
        }
    }

    sync_prompt 60
    set old_timeout $timeout
    set timeout 60
    set done_marker "__KDE_X11_EGL_SESSION_LOG_DONE__[pid]"
    set log_text ""
    send "cat $guest_host_x11_egl_log; echo $done_marker\r"
    while {1} {
        expect {
            -re [format {(^|[\r\n])%s[\r\n]} $done_marker] {
                append log_text $expect_out(buffer)
                set timeout $old_timeout
                optional_prompt
                set x11_egl_last_log_source "guest-cat"
                set x11_egl_last_log_bytes [string length $log_text]
                return $log_text
            }
            -re {host-x11-egl-smoke: [^\r\n]+} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: [^\r\n]+} {
                append log_text $expect_out(buffer)
            }
            -re {cat: [^\r\n]+} {
                append log_text $expect_out(buffer)
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                append log_text $expect_out(buffer)
                set timeout $old_timeout
                write_x11_egl_artifact_log $log_text
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-log-crash"
            }
            timeout {
                set timeout $old_timeout
                write_x11_egl_artifact_log $log_text
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-log-timeout"
            }
            eof {
                set timeout $old_timeout
                write_x11_egl_artifact_log $log_text
                finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-log-eof"
            }
        }
    }
}

