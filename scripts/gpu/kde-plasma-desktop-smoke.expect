    $chromium_video_startup_ms < 0} {
    set chromium_video_startup_ms 8000
}
if {$chromium_video_startup_ms > 60000} {
    set chromium_video_startup_ms 60000
}
if {![string is integer -strict $chromium_video_sample_count] ||
    $chromium_video_sample_count < 0} {
    set chromium_video_sample_count 4
}
if {$chromium_video_sample_count > 12} {
