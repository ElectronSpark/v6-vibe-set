    set konsole_qt_event_trace_fd3_ready_in_glib_poll "0"
    set konsole_qt_event_trace_fd3_ready_in_glib_dispatch "0"
    set konsole_qt_event_trace_fd3_ready_in_glib_other_phase "0"
    set konsole_qt_event_trace_span_ready_during_calls "0"
    set konsole_qt_event_trace_max_fd3_ready_span_age_ms "missing"
    set konsole_qt_event_trace_max_fd3_ready_span_depth "missing"
    set konsole_qt_event_trace_max_span_ready_offset_ms "missing"
    set konsole_qt_event_trace_max_fd3_ready_glib_poll_age_ms "missing"
    set konsole_qt_event_trace_max_fd3_ready_glib_dispatch_age_ms "missing"
    set konsole_qt_event_trace_max_fd3_ready_glib_other_age_ms "missing"
    set konsole_qt_event_trace_glib_phase_count "0"
    set konsole_qt_event_trace_glib_phase_calls "0"
