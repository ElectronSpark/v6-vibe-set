    puts $fh "chromium_video_post_evidence chromium_egl_trace_callsite=$chromium_egl_trace_callsite"
    puts $fh "chromium_video_post_evidence chromium_egl_trace_wayland=$chromium_egl_trace_wayland"
    puts $fh "chromium_video_post_evidence chromium_egl_trace_gtk=$chromium_egl_trace_gtk"
    puts $fh "chromium_video_post_evidence chromium_egl_trace_dlsym_wrap=$chromium_egl_trace_dlsym_wrap"
    puts $fh "chromium_video_post_evidence chromium_mesa_egl_context_trace=$chromium_mesa_egl_context_trace"
    puts $fh "chromium_video_post_evidence chromium_mesa_egl_context_trace_summary=$mesa_egl_context_trace_summary"
    puts $fh "chromium_video_post_evidence chromium_egl_trace_log_present=[guest_artifact_real_file $chromium_egl_trace_log]"
    puts $fh "chromium_video_post_evidence chromium_egl_trace_summary=$egl_trace_summary"
    puts $fh "chromium_video_post_evidence kernel_lifecycle_summary=$kernel_lifecycle_summary"
    puts $fh "chromium_video_post_evidence no_connection_child_summary=$no_connection_child_summary"
    puts $fh "chromium_video_post_evidence zygote_admission_summary=[chromium_zygote_admission_summary]"
    puts $fh "chromium_video_post_evidence mojo_child_iot_summary=[chromium_mojo_child_iot_summary]"
    puts $fh "chromium_video_post_evidence mojo_browser_milestone_summary=[chromium_mojo_browser_milestone_summary]"
    puts $fh "chromium_video_post_evidence browser_fd_milestone_timeline_summary=[chromium_browser_fd_milestone_timeline_summary]"
    puts $fh "chromium_video_post_evidence browser_fd_linux_correlation_summary=[chromium_browser_fd_linux_correlation_summary]"
    puts $fh "chromium_video_post_evidence renderer_admission_milestone_summary=[chromium_renderer_admission_milestone_summary]"
    puts $fh "chromium_video_post_evidence renderer_semantic_role_gap_summary=[chromium_renderer_semantic_role_gap_summary]"
    puts $fh "chromium_video_post_evidence renderer_child_local_bootstrap_summary=[chromium_renderer_child_local_bootstrap_summary]"
    puts $fh "chromium_video_post_evidence chromium_egl_trace_entrypoint_seen=$egl_trace_entrypoint_seen"
    puts $fh "chromium_video_post_evidence chromium_egl_trace_activity_seen=$egl_trace_activity_seen"
    puts $fh "chromium_video_post_evidence perf_media_summary=$perf_media_summary"
    puts $fh "chromium_video_post_evidence perf_console_count=$perf_console_count"
    if {$perf_console_first ne ""} {
        puts $fh "chromium_video_post_evidence perf_console_first=$perf_console_first"
    }
    if {$perf_console_last ne ""} {
        puts $fh "chromium_video_post_evidence perf_console_last=$perf_console_last"
    }
    puts $fh "chromium_video_post_evidence gpu_init_error_count=$gpu_init_error_count gpu_config_error_count=$gpu_config_error_count gpu_exit_error_count=$gpu_exit_error_count gpu_error_pids=[join $gpu_error_pids ,]"
