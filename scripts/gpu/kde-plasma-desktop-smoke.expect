    x11_glx_fps_scan_log $log_text saw_start saw_connect saw_egl_init saw_glx_ext saw_glx_version saw_fbconfigs saw_visual saw_context saw_current saw_strings saw_fps_begin saw_fps_result fps_status fps_frames fps_elapsed fps_value variant requested_depth requested_sample_interval result_variant oml_available queue_depth sbc_issued sbc_completed max_pending oml_last_sbc gl_flush_total swap_msc_issue_total get_sync_before_total get_sync_after_total issue_state_sample_interval issue_state_sampled_ratio issue_state_first_sample_frame issue_state_last_sample_frame issue_state_first_sample_sbc issue_state_last_sample_sbc issue_state_samples post_issue_sbc_completed_count post_issue_sbc_lag_max post_issue_msc_delta_total post_issue_msc_delta_max swap_only_skipped_draw_frames swap_interval_requested swap_interval_set_api swap_interval_set_status swap_interval_before swap_interval_after plain_swap_issue_total plain_swap_avg plain_swap_max plain_oml_available plain_oml_samples plain_oml_sample_interval plain_oml_sampled_ratio plain_oml_first_sample_frame plain_oml_last_sample_frame plain_oml_get_sync_before_total plain_oml_get_sync_after_total plain_oml_before_first_sbc plain_oml_before_last_sbc plain_oml_after_first_sbc plain_oml_after_last_sbc plain_oml_post_swap_sbc_delta_total plain_oml_post_swap_sbc_delta_max plain_oml_post_swap_msc_delta_total plain_oml_post_swap_msc_delta_max plain_post_swap_xsync_total plain_post_swap_xsync_max failure_label
