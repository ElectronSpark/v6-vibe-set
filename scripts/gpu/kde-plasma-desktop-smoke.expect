proc stage_newstuff_stub_shim_if_enabled {} {
    global tmpimg outdir

    if {![env_bool KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB 0]} {
        return
    }

    set host_dir "/tmp/xv6-newstuff-shim"
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB_HOST_DIR)] &&
        $::env(KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB_HOST_DIR) ne ""} {
        set host_dir $::env(KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB_HOST_DIR)
    }

    set widgets "$host_dir/libKF5NewStuffWidgets.so.5"
    set core "$host_dir/libKF5NewStuffCore.so.5"
    set stage_log "$outdir/newstuff-shim-stage.log"

    if {![file exists $widgets] || ![file exists $core]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL newstuff-shim-missing host_dir=$host_dir"
        exit 8
    }

    exec sh -c "printf '%s\n' \
        'mkdir /opt/xv6-kde-abi-libs/newstuff-shim' \
        'rm /opt/xv6-kde-abi-libs/newstuff-shim/libKF5NewStuffWidgets.so.5' \
        'rm /opt/xv6-kde-abi-libs/newstuff-shim/libKF5NewStuffCore.so.5' \
        'write $widgets /opt/xv6-kde-abi-libs/newstuff-shim/libKF5NewStuffWidgets.so.5' \
        'write $core /opt/xv6-kde-abi-libs/newstuff-shim/libKF5NewStuffCore.so.5' \
        'stat /opt/xv6-kde-abi-libs/newstuff-shim/libKF5NewStuffWidgets.so.5' \
        'stat /opt/xv6-kde-abi-libs/newstuff-shim/libKF5NewStuffCore.so.5' \
        | debugfs -w '$tmpimg' >'$stage_log' 2>&1"
}

stage_newstuff_stub_shim_if_enabled

proc stage_qtmm_stub_shim_if_enabled {} {
    global tmpimg outdir root

    if {![env_bool KDE_APP_LAUNCH_PROBE_QTMM_STUB 0]} {
        return
    }

    set build_dir "$outdir/qtmm-shim-build"
    set build_log "$outdir/qtmm-shim-build.log"
    set build_script "$root/scripts/image/build-qtmm-shim.sh"
    set qtmm "$build_dir/libQt5Multimedia.so.5"
    set stage_log "$outdir/qtmm-shim-stage.log"

    file delete -force $build_dir
    if {![file executable $build_script]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL qtmm-shim-build-helper-missing path=$build_script"
        exit 8
    }

    if {[catch {
        exec $build_script $build_dir >$build_log 2>@1
    } build_err]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL qtmm-shim-build-failed log=$build_log error=$build_err"
        exit 8
    }

    if {![file exists $qtmm]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL qtmm-shim-missing build_dir=$build_dir"
        exit 8
    }

    exec sh -c "printf '%s\n' \
        'mkdir /opt/xv6-kde-abi-libs/qt5multimedia-shim' \
        'rm /opt/xv6-kde-abi-libs/qt5multimedia-shim/libQt5Multimedia.so.5' \
        'write $qtmm /opt/xv6-kde-abi-libs/qt5multimedia-shim/libQt5Multimedia.so.5' \
        'stat /opt/xv6-kde-abi-libs/qt5multimedia-shim/libQt5Multimedia.so.5' \
        | debugfs -w '$tmpimg' >'$stage_log' 2>&1"
}

stage_qtmm_stub_shim_if_enabled

proc stage_qt_minimal_imageformats_if_enabled {} {
    global tmpimg outdir

    if {![env_bool KDE_APP_LAUNCH_PROBE_QT_MINIMAL_IMAGEFORMATS 0]} {
        return
    }

    set dir "/usr/lib/x86_64-linux-gnu/qt5/plugins/imageformats"
    set stage_log "$outdir/qt-minimal-imageformats-stage.log"

    # Opt-in offline prune: remove the 18 exotic kimg_*.so imageformats plugins
    # (avif/jxl/exr/heif/raw/hdr/ani/eps/pcx/pic/psd/qoi/ras/rgb/tga/xcf/kra/ora)
    # from the per-run fs.img copy so QImageReader/QFactoryLoader no longer
    # dlopen()s them at first QIcon touch. KEEP libqsvg/libqjpeg/libqico/libqgif
    # (svg icons + belt-and-suspenders jpeg/ico/gif). A trailing ls -l captures
    # the surviving KEEP set as evidence. Operates on $tmpimg only; the committed
    # fs.img and overlay tree are untouched.
    exec sh -c "printf '%s\n' \
        'rm $dir/kimg_avif.so' \
        'rm $dir/kimg_jxl.so' \
        'rm $dir/kimg_exr.so' \
        'rm $dir/kimg_heif.so' \
        'rm $dir/kimg_raw.so' \
        'rm $dir/kimg_hdr.so' \
        'rm $dir/kimg_ani.so' \
        'rm $dir/kimg_eps.so' \
        'rm $dir/kimg_pcx.so' \
        'rm $dir/kimg_pic.so' \
        'rm $dir/kimg_psd.so' \
        'rm $dir/kimg_qoi.so' \
        'rm $dir/kimg_ras.so' \
        'rm $dir/kimg_rgb.so' \
        'rm $dir/kimg_tga.so' \
        'rm $dir/kimg_xcf.so' \
        'rm $dir/kimg_kra.so' \
        'rm $dir/kimg_ora.so' \
        'ls -l $dir' \
        | debugfs -w '$tmpimg' >'$stage_log' 2>&1"
}

stage_qt_minimal_imageformats_if_enabled

proc stage_plasma_tooltip_delay_if_enabled {} {
    global tmpimg outdir

    # Opt-in tooltip show-delay override for the taskbar-tooltip latency A/B.
    # Plasma ToolTipArea (plasma-framework 5.115 libcorebindingsplugin.so)
    # reads plasmarc [PlasmaToolTips] Delay with a compiled default of 700 ms
    # (binary-verified: readEntry("Delay", 700); Delay<=0 DISABLES tooltips,
    # so an "instant" arm must use a small POSITIVE value). The session writes
    # no user plasmarc and XDG_CONFIG_DIRS=/etc/xdg, so a staged
    # /etc/xdg/plasmarc wins via the KConfig system cascade. Operates on the
    # per-run fs.img copy only; committed image untouched; unset env =
    # byte-identical.
    if {![info exists ::env(KDE_SMOKE_PLASMA_TOOLTIP_DELAY_MS)] ||
        $::env(KDE_SMOKE_PLASMA_TOOLTIP_DELAY_MS) eq ""} {
        return
    }
    set delay $::env(KDE_SMOKE_PLASMA_TOOLTIP_DELAY_MS)
    if {![string is integer -strict $delay] || $delay <= 0} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL plasma-tooltip-delay-invalid value=$delay"
        exit 8
    }

    set host_rc "$outdir/plasmarc.tooltip-delay"
    set stage_log "$outdir/plasma-tooltip-delay-stage.log"
    set fh [open $host_rc "w"]
    puts $fh "\[PlasmaToolTips\]"
    puts $fh "Delay=$delay"
    close $fh

    exec sh -c "printf '%s\n' \
        'rm /etc/xdg/plasmarc' \
        'write $host_rc /etc/xdg/plasmarc' \
        'stat /etc/xdg/plasmarc' \
        | debugfs -w '$tmpimg' >'$stage_log' 2>&1"
}

stage_plasma_tooltip_delay_if_enabled
