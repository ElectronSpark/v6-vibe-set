    set konsole_child_run_to_first_setup_ms "missing"
    set konsole_child_setup_total_calls "missing"
    set konsole_child_setup_buckets "missing"
    set konsole_child_setup_slow_count "missing"
    set konsole_child_setup_max_bucket "missing"
    set konsole_child_setup_max_bucket_ms "missing"
    set konsole_last_setup_to_exec_begin_ms "missing"
    set konsole_child_run_to_exec_begin_ms "missing"
    set konsole_exec_begin_to_done_ms "missing"
    set konsole_exec_done_to_wrapper_start_ms "missing"
    set konsole_child_poll_detail_count "0"
    set konsole_child_poll_eintr_elapsed_ms "missing"
    set konsole_child_poll_eintr_kq_tmo "missing"
