if {![string is integer -strict $chromium_video_warmup_seconds] ||
    $chromium_video_warmup_seconds < 1} {
    set chromium_video_warmup_seconds 8
}
if {$chromium_video_warmup_seconds > 120} {
    set chromium_video_warmup_seconds 120
}
set chromium_video_startup_ms [expr {$chromium_video_warmup_seconds * 1000}]
if {[info exists env(KDE_SMOKE_CHROMIUM_VIDEO_STARTUP_MS)]} {
    set chromium_video_startup_ms $env(KDE_SMOKE_CHROMIUM_VIDEO_STARTUP_MS)
}
