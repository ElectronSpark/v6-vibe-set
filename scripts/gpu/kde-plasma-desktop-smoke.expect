    $chromium_video_fast_census_interval_ms < 20} {
    set chromium_video_fast_census_interval_ms 50
}
if {$chromium_video_fast_census_interval_ms > 1000} {
    set chromium_video_fast_census_interval_ms 1000
}
if {![string is integer -strict $chromium_video_wait_census_ms] ||
    $chromium_video_wait_census_ms < 0} {
    set chromium_video_wait_census_ms 0
}
if {$chromium_video_wait_census_ms > 60000} {
    set chromium_video_wait_census_ms 60000
}
if {![string is integer -strict $chromium_video_wait_census_interval_ms] ||
    $chromium_video_wait_census_interval_ms < 50} {
    set chromium_video_wait_census_interval_ms 250
}
if {$chromium_video_wait_census_interval_ms > 5000} {
    set chromium_video_wait_census_interval_ms 5000
}
if {![string is integer -strict $chromium_video_result_wait_seconds] ||
    $chromium_video_result_wait_seconds < 0} {
    set chromium_video_result_wait_seconds 0
}
if {$chromium_video_result_wait_seconds > 120} {
    set chromium_video_result_wait_seconds 120
}
if {![string is integer -strict $chromium_video_wait_for_playback_seconds] ||
    $chromium_video_wait_for_playback_seconds < 0} {
    set chromium_video_wait_for_playback_seconds 0
}
if {$chromium_video_wait_for_playback_seconds > 120} {
    set chromium_video_wait_for_playback_seconds 120
}
if {![string is integer -strict $pre_chromium_liveness_delay_seconds] ||
    $pre_chromium_liveness_delay_seconds < 0} {
    set pre_chromium_liveness_delay_seconds 0
}
if {$pre_chromium_liveness_delay_seconds > 60} {
    set pre_chromium_liveness_delay_seconds 60
}
if {![string is integer -strict $wayland_client_liveness_delay_seconds] ||
    $wayland_client_liveness_delay_seconds < 0} {
    set wayland_client_liveness_delay_seconds 5
}
if {$wayland_client_liveness_delay_seconds > 60} {
    set wayland_client_liveness_delay_seconds 60
}
if {![string is integer -strict $wayland_client_liveness_runtime_seconds] ||
    $wayland_client_liveness_runtime_seconds < 1} {
    set wayland_client_liveness_runtime_seconds 5
}
if {$wayland_client_liveness_runtime_seconds > 60} {
    set wayland_client_liveness_runtime_seconds 60
}
set chromium_video_kprofile_min_seconds [expr {12 + int(($chromium_video_startup_ms + 999) / 1000) + 15 + 5}]
if {$chromium_video_kprofile_min_seconds < 40} {
    set chromium_video_kprofile_min_seconds 40
}
if {![string is integer -strict $chromium_video_kprofile_seconds] ||
    $chromium_video_kprofile_seconds < $chromium_video_kprofile_min_seconds} {
    set chromium_video_kprofile_seconds $chromium_video_kprofile_min_seconds
}
if {$chromium_video_kprofile_seconds > 180} {
    set chromium_video_kprofile_seconds 180
}
proc assert_default_launch_contract {} {
    global root

    set dry [exec sh -c "cd '$root' && env -u QEMU_GPU -u QEMU_APPEND -u DISPLAY_MODE AUTO_BUILD=0 QEMU_DRY_RUN=1 ./scripts/launch/launch-gui.sh 2>&1"]
    set startup_fh [open "$root/rootfs-overlay/etc/startup" r]
    set startup [read $startup_fh]
    close $startup_fh
    if {![regexp {virtio-vga-gl} $dry]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL default-launch-no-virgl\n$dry"
        exit 8
    }
    if {[regexp {desktop=0} $dry]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL default-launch-desktop-disabled\n$dry"
        exit 8
    }
    if {[regexp {weston=1} $dry]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL default-launch-weston-cmdline\n$dry"
        exit 8
    }
    if {![regexp {(^|\n)[^\n]*XV6_DESKTOP_DEFAULT=kde[^\n]*/bin/xv6-desktop-session} $startup]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL default-launch-not-kde-startup\n$startup"
        exit 8
    }
    if {[regexp {(^|\n)[^\n]*LD_BIND_NOW=1[^\n]*XV6_DESKTOP_DEFAULT=kde[^\n]*/bin/xv6-desktop-session} $startup]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL default-launch-kde-startup-has-ld-bind-now\n$startup"
        exit 8
    }
}

assert_default_launch_contract

