    append suffix " log_source=$x11_egl_last_log_source log_bytes=$x11_egl_last_log_bytes log_path=$guest_host_x11_egl_log"
    append suffix " trace_enabled=$trace_enabled trace_available=$trace_available trace_child_pid=$trace_child_pid trace_begin=$trace_begin trace_result=$trace_result trace_status=$trace_status trace_pixmap_calls=$trace_pixmap_calls trace_pixmap_checked_calls=$trace_pixmap_checked_calls trace_register_special_xge_calls=$trace_register_special_xge_calls trace_present_special_registrations=$trace_present_special_registrations trace_wait_special_calls=$trace_wait_special_calls trace_poll_special_calls=$trace_poll_special_calls trace_nonpresent_special_events=$trace_nonpresent_special_events trace_pixmap_total_ms=$trace_pixmap_total_ms trace_wait_special_total_ms=$trace_wait_special_total_ms trace_poll_special_total_ms=$trace_poll_special_total_ms trace_complete_events=$trace_complete_events trace_decode_failures=$trace_decode_failures trace_missing_symbols=$trace_missing_symbols"
    append suffix " glx_swap_trace_capable=$glx_swap_trace_capable glx_swap_xcb_trace_capable=$glx_swap_xcb_trace_capable glx_swap_syscall_trace_capable=$glx_swap_syscall_trace_capable glx_swap_trace_result=$glx_swap_trace_result glx_swap_trace_status=$glx_swap_trace_status glx_swap_buffers_calls=$glx_swap_buffers_calls glx_swap_buffers_msc_oml_calls=$glx_swap_buffers_msc_oml_calls glx_swap_total_ms=$glx_swap_total_ms glx_swap_max_ms=$glx_swap_max_ms glx_swap_nested_pixmap_calls=$glx_swap_nested_pixmap_calls glx_swap_nested_pixmap_checked_calls=$glx_swap_nested_pixmap_checked_calls glx_swap_nested_pixmap_total_ms=$glx_swap_nested_pixmap_total_ms glx_swap_nested_wait_special_calls=$glx_swap_nested_wait_special_calls glx_swap_nested_poll_special_calls=$glx_swap_nested_poll_special_calls glx_swap_nested_wait_special_total_ms=$glx_swap_nested_wait_special_total_ms glx_swap_nested_poll_special_total_ms=$glx_swap_nested_poll_special_total_ms glx_swap_nested_complete_events=$glx_swap_nested_complete_events glx_swap_nested_xcb_flush_calls=$glx_swap_nested_xcb_flush_calls glx_swap_nested_xcb_flush_total_ms=$glx_swap_nested_xcb_flush_total_ms glx_swap_nested_xcb_request_check_calls=$glx_swap_nested_xcb_request_check_calls glx_swap_nested_xcb_request_check_total_ms=$glx_swap_nested_xcb_request_check_total_ms glx_swap_nested_xcb_wait_reply_calls=$glx_swap_nested_xcb_wait_reply_calls glx_swap_nested_xcb_wait_reply_total_ms=$glx_swap_nested_xcb_wait_reply_total_ms glx_swap_nested_xcb_poll_reply_calls=$glx_swap_nested_xcb_poll_reply_calls glx_swap_nested_xcb_poll_reply_total_ms=$glx_swap_nested_xcb_poll_reply_total_ms glx_swap_nested_xcb_wait_event_calls=$glx_swap_nested_xcb_wait_event_calls glx_swap_nested_xcb_wait_event_total_ms=$glx_swap_nested_xcb_wait_event_total_ms glx_swap_nested_xcb_poll_event_calls=$glx_swap_nested_xcb_poll_event_calls glx_swap_nested_xcb_poll_event_total_ms=$glx_swap_nested_xcb_poll_event_total_ms glx_swap_accounted_present_ms=$glx_swap_accounted_present_ms glx_swap_above_present_ms=$glx_swap_above_present_ms glx_swap_accounted_xcb_ms=$glx_swap_accounted_xcb_ms glx_swap_above_xcb_ms=$glx_swap_above_xcb_ms glx_swap_syscall_total_ms=$glx_swap_syscall_total_ms glx_swap_syscall_nested_x11_ms=$glx_swap_syscall_nested_x11_ms glx_swap_syscall_above_x11_ms=$glx_swap_syscall_above_x11_ms glx_swap_syscall_ioctl_calls=$glx_swap_syscall_ioctl_calls glx_swap_syscall_ioctl_total_ms=$glx_swap_syscall_ioctl_total_ms glx_swap_syscall_ioctl_max_ms=$glx_swap_syscall_ioctl_max_ms glx_swap_syscall_poll_ppoll_calls=$glx_swap_syscall_poll_ppoll_calls glx_swap_syscall_poll_ppoll_total_ms=$glx_swap_syscall_poll_ppoll_total_ms glx_swap_syscall_poll_ppoll_max_ms=$glx_swap_syscall_poll_ppoll_max_ms glx_swap_syscall_select_pselect_calls=$glx_swap_syscall_select_pselect_calls glx_swap_syscall_select_pselect_total_ms=$glx_swap_syscall_select_pselect_total_ms glx_swap_syscall_select_pselect_max_ms=$glx_swap_syscall_select_pselect_max_ms glx_swap_syscall_read_recv_calls=$glx_swap_syscall_read_recv_calls glx_swap_syscall_read_recv_total_ms=$glx_swap_syscall_read_recv_total_ms glx_swap_syscall_read_recv_max_ms=$glx_swap_syscall_read_recv_max_ms glx_swap_syscall_write_send_calls=$glx_swap_syscall_write_send_calls glx_swap_syscall_write_send_total_ms=$glx_swap_syscall_write_send_total_ms glx_swap_syscall_write_send_max_ms=$glx_swap_syscall_write_send_max_ms glx_swap_missing_symbols=$glx_swap_missing_symbols glx_swap_recursion_skips=$glx_swap_recursion_skips"
    host_screenshot "x11-egl" $host_x11_egl_png

    if {$failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $failure_label $suffix"
    }
    if {$session_status ne "PASS"} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-glx-fps-session-probe-$session_status exit_status=$exit_status $suffix"
    }
    if {$exit_status ne "0"} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-glx-fps-status-$exit_status $suffix"
    }
    if {!($saw_start && $saw_connect && $saw_egl_init && $saw_glx_ext && $saw_glx_version && $saw_fbconfigs && $saw_visual && $saw_context && $saw_current && $saw_strings && $saw_fps_begin && $saw_fps_result)} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-glx-fps-incomplete $suffix"
    }
    if {$fps_status ne "PASS"} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-glx-fps-result-$fps_status $suffix"
    }
    if {$fps_frames eq "" || $fps_frames <= 0} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-glx-fps-no-frames $suffix"
    }
    set trace_requested [regexp {(^|[[:space:]])kde_x11_egl_glx_present_trace=1([[:space:]]|$)} $qemu_append]
    if {$trace_requested || $trace_enabled eq "1"} {
        set trace_failure_label [x11_glx_present_trace_failure_label $trace_enabled $trace_available $trace_child_pid $trace_begin $trace_result $trace_status $trace_pixmap_calls $trace_pixmap_checked_calls $trace_register_special_xge_calls $trace_present_special_registrations $trace_wait_special_calls $trace_poll_special_calls $trace_nonpresent_special_events $trace_pixmap_total_ms $trace_wait_special_total_ms $trace_poll_special_total_ms $trace_complete_events $trace_decode_failures $trace_missing_symbols]
        if {$trace_failure_label ne ""} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $trace_failure_label $suffix"
        }
        if {$glx_swap_trace_capable || $glx_swap_trace_result} {
            set glx_swap_trace_failure_label [x11_glx_swap_trace_failure_label $trace_child_pid $glx_swap_trace_result $glx_swap_trace_status $glx_swap_xcb_trace_capable $glx_swap_syscall_trace_capable $glx_swap_buffers_calls $glx_swap_buffers_msc_oml_calls $glx_swap_total_ms $glx_swap_max_ms $glx_swap_nested_pixmap_calls $glx_swap_nested_pixmap_checked_calls $glx_swap_nested_pixmap_total_ms $glx_swap_nested_wait_special_calls $glx_swap_nested_poll_special_calls $glx_swap_nested_wait_special_total_ms $glx_swap_nested_poll_special_total_ms $glx_swap_nested_complete_events $glx_swap_nested_xcb_flush_calls $glx_swap_nested_xcb_flush_total_ms $glx_swap_nested_xcb_request_check_calls $glx_swap_nested_xcb_request_check_total_ms $glx_swap_nested_xcb_wait_reply_calls $glx_swap_nested_xcb_wait_reply_total_ms $glx_swap_nested_xcb_poll_reply_calls $glx_swap_nested_xcb_poll_reply_total_ms $glx_swap_nested_xcb_wait_event_calls $glx_swap_nested_xcb_wait_event_total_ms $glx_swap_nested_xcb_poll_event_calls $glx_swap_nested_xcb_poll_event_total_ms $glx_swap_accounted_present_ms $glx_swap_above_present_ms $glx_swap_accounted_xcb_ms $glx_swap_above_xcb_ms $glx_swap_syscall_total_ms $glx_swap_syscall_nested_x11_ms $glx_swap_syscall_above_x11_ms $glx_swap_syscall_ioctl_calls $glx_swap_syscall_ioctl_total_ms $glx_swap_syscall_ioctl_max_ms $glx_swap_syscall_poll_ppoll_calls $glx_swap_syscall_poll_ppoll_total_ms $glx_swap_syscall_poll_ppoll_max_ms $glx_swap_syscall_select_pselect_calls $glx_swap_syscall_select_pselect_total_ms $glx_swap_syscall_select_pselect_max_ms $glx_swap_syscall_read_recv_calls $glx_swap_syscall_read_recv_total_ms $glx_swap_syscall_read_recv_max_ms $glx_swap_syscall_write_send_calls $glx_swap_syscall_write_send_total_ms $glx_swap_syscall_write_send_max_ms $glx_swap_missing_symbols $glx_swap_recursion_skips]
            if {$glx_swap_trace_failure_label ne ""} {
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $glx_swap_trace_failure_label $suffix"
            }
        }
    }
    set swap_interval0_failure_label [x11_glx_fps_swap_interval0_failure_label $variant $result_variant $fps_frames $swap_only_skipped_draw_frames $swap_interval_requested $swap_interval_set_api $swap_interval_set_status $swap_interval_after $plain_swap_issue_total $plain_swap_avg $plain_swap_max]
    if {$swap_interval0_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $swap_interval0_failure_label $suffix"
    }
    set plain_oml_failure_label [x11_glx_fps_plain_oml_failure_label $variant $result_variant $fps_frames $swap_only_skipped_draw_frames $swap_interval_requested $swap_interval_set_api $swap_interval_set_status $swap_interval_after $plain_swap_issue_total $plain_swap_avg $plain_swap_max $plain_oml_available $plain_oml_samples $plain_oml_get_sync_before_total $plain_oml_get_sync_after_total $plain_oml_before_first_sbc $plain_oml_before_last_sbc $plain_oml_after_first_sbc $plain_oml_after_last_sbc $plain_oml_post_swap_sbc_delta_total $plain_oml_post_swap_sbc_delta_max $plain_oml_post_swap_msc_delta_total $plain_oml_post_swap_msc_delta_max $plain_post_swap_xsync_total $plain_post_swap_xsync_max]
    if {$plain_oml_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $plain_oml_failure_label $suffix"
    }
    set plain_oml_sampled_failure_label [x11_glx_fps_plain_oml_sampled_failure_label $variant $requested_sample_interval $result_variant $fps_frames $swap_only_skipped_draw_frames $swap_interval_requested $swap_interval_set_api $swap_interval_set_status $swap_interval_after $plain_swap_issue_total $plain_swap_avg $plain_swap_max $plain_oml_available $plain_oml_samples $plain_oml_sample_interval $plain_oml_sampled_ratio $plain_oml_first_sample_frame $plain_oml_last_sample_frame $plain_oml_get_sync_before_total $plain_oml_get_sync_after_total $plain_oml_before_first_sbc $plain_oml_before_last_sbc $plain_oml_after_first_sbc $plain_oml_after_last_sbc $plain_oml_post_swap_sbc_delta_total $plain_oml_post_swap_sbc_delta_max $plain_oml_post_swap_msc_delta_total $plain_oml_post_swap_msc_delta_max $plain_post_swap_xsync_total $plain_post_swap_xsync_max]
    if {$plain_oml_sampled_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $plain_oml_sampled_failure_label $suffix"
    }
    set plain_oml_sampled_after_failure_label [x11_glx_fps_plain_oml_sampled_after_failure_label $variant $requested_sample_interval $result_variant $fps_frames $swap_only_skipped_draw_frames $swap_interval_requested $swap_interval_set_api $swap_interval_set_status $swap_interval_after $plain_swap_issue_total $plain_swap_avg $plain_swap_max $plain_oml_available $plain_oml_samples $plain_oml_sample_interval $plain_oml_sampled_ratio $plain_oml_first_sample_frame $plain_oml_last_sample_frame $plain_oml_get_sync_before_total $plain_oml_get_sync_after_total $plain_oml_after_first_sbc $plain_oml_after_last_sbc $plain_oml_after_sbc_delta_total $plain_oml_after_sbc_delta_max $plain_oml_after_msc_delta_total $plain_oml_after_msc_delta_max $plain_post_swap_xsync_total $plain_post_swap_xsync_max]
    if {$plain_oml_sampled_after_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $plain_oml_sampled_after_failure_label $suffix"
    }
    set oml_failure_label [x11_glx_fps_oml_queue3_failure_label $variant $result_variant $oml_available $queue_depth $sbc_issued $sbc_completed $max_pending]
    if {$oml_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $oml_failure_label $suffix"
    }
    set oml_failure_label [x11_glx_fps_oml_queue_failure_label $variant "oml-queue-depth-swap-only" $requested_depth $result_variant $oml_available $queue_depth $sbc_issued $sbc_completed $max_pending "x11-glx-fps-oml-queue-depth"]
    if {$oml_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $oml_failure_label $suffix"
    }
    set oml_failure_label [x11_glx_fps_oml_flush_swap_failure_label $variant $requested_depth $result_variant $oml_available $queue_depth $sbc_issued $sbc_completed $max_pending $gl_flush_total $swap_msc_issue_total]
    if {$oml_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $oml_failure_label $suffix"
    }
    set oml_failure_label [x11_glx_fps_oml_issue_state_failure_label $variant $requested_depth $requested_sample_interval $result_variant $oml_available $queue_depth $sbc_issued $sbc_completed $max_pending $oml_last_sbc $gl_flush_total $swap_msc_issue_total $get_sync_before_total $get_sync_after_total $issue_state_sample_interval $issue_state_sampled_ratio $issue_state_first_sample_frame $issue_state_last_sample_frame $issue_state_first_sample_sbc $issue_state_last_sample_sbc $issue_state_samples $post_issue_sbc_completed_count $post_issue_sbc_lag_max $post_issue_msc_delta_total $post_issue_msc_delta_max]
    if {$oml_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $oml_failure_label $suffix"
    }
}

proc run_kde_x11_present_fps_session_probe {} {
    global x11_dri3_available host_x11_dri3_png

    if {!$x11_dri3_available} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-missing"
    }

    set session_result [wait_for_x11_egl_session_probe_terminal]
    set session_status [lindex $session_result 0]
    set exit_status [lindex $session_result 1]
    set log_text [read_x11_egl_session_log "x11-present-fps-session-probe"]
    write_x11_egl_artifact_log $log_text

    set saw_start 0
    set saw_connect 0
    set saw_dri3 0
    set saw_present 0
    set saw_select 0
    set saw_fd 0
    set saw_fps_begin 0
    set saw_fps_result 0
    set fps_status ""
    set fps_frames ""
    set fps_elapsed ""
    set fps_value ""
    set issued ""
    set completed ""
    set outstanding ""
    set requested_variant ""
    set requested_depth ""
    set result_variant ""
    set queue_depth ""
    set max_outstanding ""
    set failure_label ""
    x11_present_fps_scan_log $log_text saw_start saw_connect saw_dri3 saw_present saw_select saw_fd saw_fps_begin saw_fps_result fps_status fps_frames fps_elapsed fps_value issued completed outstanding requested_variant requested_depth result_variant queue_depth max_outstanding failure_label
    set suffix [x11_present_fps_failure_suffix $saw_start $saw_connect $saw_dri3 $saw_present $saw_select $saw_fd $saw_fps_begin $saw_fps_result $fps_status $fps_frames $fps_elapsed $fps_value $issued $completed $outstanding $requested_variant $requested_depth $result_variant $queue_depth $max_outstanding $exit_status]
    host_screenshot "x11-dri3" $host_x11_dri3_png

    if {$failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $failure_label $suffix"
    }
    if {$session_status ne "PASS"} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-session-probe-$session_status exit_status=$exit_status $suffix"
    }
    if {$exit_status ne "0"} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-status-$exit_status $suffix"
    }
    if {!($saw_start && $saw_connect && $saw_dri3 && $saw_present && $saw_select && $saw_fd && $saw_fps_begin && $saw_fps_result)} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-incomplete $suffix"
    }
    if {$fps_status ne "PASS"} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-result-$fps_status $suffix"
    }
    if {$fps_frames eq "" || $completed eq "" || $fps_frames <= 0 || $completed <= 0} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-no-frames $suffix"
    }
    if {$outstanding eq "" || $outstanding != 0} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-outstanding $suffix"
    }
    set queue_failure_label [x11_present_fps_queue_failure_label $requested_variant $requested_depth $result_variant $issued $completed $outstanding $queue_depth $max_outstanding]
    if {$queue_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $queue_failure_label $suffix"
    }
}

proc run_kde_x11_egl_glx_probe_only {} {
    global timeout host_x11_egl_png guest_host_x11_egl_log

    set old_timeout $timeout
    set log_path $guest_host_x11_egl_log
    set exit_status ""
    set preflight_display ""

    x11_egl_glx_probe_prelaunch_marker $log_path
    set timeout 120

    send "rm -f $log_path\r"
    sleep 2
    optional_prompt

    set preflight_display [x11_egl_glx_probe_xopen_preflight $log_path]

    send "DISPLAY=$preflight_display HOST_X11_EGL_SMOKE_MODE=glx-probe /bin/host-x11-egl-smoke --glx-probe-only; echo GLX:\$?\r"
    expect {
        -re {GLX:([0-9]+)} {
            set exit_status [string trim $expect_out(1,string)]
        }
        -re {exec .*failed|not found|cannot execute} {
            x11_egl_glx_probe_launch_diag $log_path "exec_failed" 0 $expect_out(buffer)
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-launch"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            x11_egl_glx_probe_launch_diag $log_path "crash" 0 $expect_out(buffer)
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-crash"
        }
        timeout {
            set launch_buffer ""
            catch { set launch_buffer $expect_out(buffer) }
            x11_egl_glx_probe_launch_diag $log_path "timeout" 1 $launch_buffer
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-timeout"
        }
        eof {
            set launch_buffer ""
            catch { set launch_buffer $expect_out(buffer) }
            x11_egl_glx_probe_launch_diag $log_path "eof" 0 $launch_buffer
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-eof"
        }
    }
    optional_prompt

    send "cat $log_path; echo __KDE_X11_EGL_GLX_PROBE_LOG_DONE__\r"
    set saw_done 0
    set log_text ""
    while {!$saw_done} {
        expect {
            -re {(^|[\r\n])__KDE_X11_EGL_GLX_PROBE_LOG_DONE__[\r\n]} {
                append log_text $expect_out(buffer)
                set saw_done 1
            }
            -re {host-x11-egl-smoke: [^\r\n]+} {
                append log_text $expect_out(buffer)
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                append log_text $expect_out(buffer)
                write_x11_egl_artifact_log $log_text
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-log-crash"
            }
            timeout {
                write_x11_egl_artifact_log $log_text
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-log-timeout"
            }
            eof {
                write_x11_egl_artifact_log $log_text
                finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-log-eof"
            }
        }
    }
    write_x11_egl_artifact_log $log_text

    set saw_start 0
    set saw_connect 0
    set saw_egl_init 0
    set saw_glx_ext 0
    set saw_glx_version 0
    set saw_fbconfigs 0
    set saw_visual 0
    set saw_context 0
    set saw_current 0
    set saw_strings 0
    set saw_draw 0
    set saw_result 0
    set failure_label ""
    x11_egl_scan_glx_probe_log $log_text saw_start saw_connect saw_egl_init saw_glx_ext saw_glx_version saw_fbconfigs saw_visual saw_context saw_current saw_strings saw_draw saw_result failure_label
    set suffix [x11_egl_glx_probe_failure_suffix $saw_start $saw_connect $saw_egl_init $saw_glx_ext $saw_glx_version $saw_fbconfigs $saw_visual $saw_context $saw_current $saw_strings $saw_draw $saw_result $exit_status]
    set timeout $old_timeout
    optional_prompt
    host_screenshot "x11-egl" $host_x11_egl_png
    if {$failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $failure_label $suffix"
    }
    if {$exit_status ne "0"} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-status-$exit_status $suffix"
    }
    if {!($saw_start && $saw_connect && $saw_egl_init && $saw_glx_ext && $saw_glx_version && $saw_fbconfigs && $saw_visual && $saw_context && $saw_current && $saw_strings && $saw_draw && $saw_result)} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-incomplete $suffix"
    }
}

proc run_kde_x11_egl_probe {} {
    global timeout x11_egl_available host_x11_egl_png guest_host_x11_egl_log

    set reducer [expr {[kde_smoke_reducer] eq "x11-egl"}]
    if {[info exists ::env(KDE_SMOKE_X11_EGL)] && $::env(KDE_SMOKE_X11_EGL) eq "0"} {
        if {$reducer} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-disabled"
        }
        return
    }
    if {!$x11_egl_available} {
        if {$reducer} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-missing"
        }
        note_visual_warning "x11-egl-smoke-missing"
        return
    }
    if {$reducer} {
        run_kde_x11_egl_glx_probe_only
        return
    }

    set old_timeout $timeout
    sync_prompt
    set timeout 90
    set log_path $guest_host_x11_egl_log

    send "rm -f $log_path; /bin/host-x11-egl-smoke & echo KDE_X11_EGL_LAUNCHED\r"
    expect {
        -re {KDE_X11_EGL_LAUNCHED} {}
        -re {exec .*failed|not found|cannot execute} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-launch"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-launch-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-launch-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-launch-eof" }
    }
    optional_prompt
    sleep 6

    send "cat $log_path; echo __KDE_X11_EGL_LOG_DONE__\r"
    set saw_start 0
    set saw_connect 0
    set saw_gl 0
    set saw_frame 0
    set saw_done 0
    set failure_label ""
    set log_text ""
    while {!$saw_done} {
        expect {
            -re {host-x11-egl-smoke: start} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-egl-smoke: connected display=} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-egl-smoke: (egl|glx) ready } {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-egl-smoke: frame=[0-9]+ mode=launch} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-egl-smoke: [^\r\n]*(failed|missing|status=FAIL)} {
                append log_text $expect_out(buffer)
            }
            -re {(^|[\r\n])__KDE_X11_EGL_LOG_DONE__[\r\n]} {
                append log_text $expect_out(buffer)
                set saw_done 1
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-log-crash"
            }
            timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-log-timeout" }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-log-eof" }
        }
    }
    write_x11_egl_artifact_log $log_text
    x11_egl_scan_launch_log $log_text saw_start saw_connect saw_gl saw_frame failure_label
    if {$failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $failure_label [x11_egl_failure_suffix $saw_start $saw_connect $saw_gl $saw_frame]"
    }
    if {!($saw_start && $saw_connect && $saw_gl && $saw_frame)} {
        optional_prompt
        set timeout 10
        send "ls -l $log_path /bin/host-x11-egl-smoke /opt/host-gui/host-x11-egl-smoke/bin/host-x11-egl-smoke /opt/host-gui/host-x11-egl-smoke/lib/ld-linux-x86-64.so.2; ps; echo KDE_X11_EGL_DIAG_DONE\r"
        expect {
            -re {KDE_X11_EGL_DIAG_DONE} {}
            timeout {}
            eof {}
        }
        set timeout $old_timeout
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-incomplete [x11_egl_failure_suffix $saw_start $saw_connect $saw_gl $saw_frame]"
    }
    optional_prompt
    host_screenshot "x11-egl" $host_x11_egl_png

    send "/bin/mouseinject 32768 32768 0; /bin/mouseinject 32768 32768 1; /bin/mouseinject 32768 32768 0; /bin/keyinject text xv6; /bin/keyinject key esc; echo KDE_X11_EGL_INPUT_DONE\r"
    expect {
        -re {KDE_X11_EGL_INPUT_DONE} {}
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-input-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-input-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-input-eof" }
    }
    optional_prompt
    sleep 3

    send "cat $log_path; echo __KDE_X11_EGL_EXIT_LOG_DONE__\r"
    set saw_input 0
    set saw_exit 0
    set saw_exit_done 0
    set exit_failure_label ""
    set exit_log_text ""
    while {!$saw_exit_done} {
        expect {
            -re {host-x11-egl-smoke: input_ready} {
                append exit_log_text $expect_out(buffer)
            }
            -re {host-x11-egl-smoke: exited} {
                append exit_log_text $expect_out(buffer)
            }
            -re {host-x11-egl-smoke: [^\r\n]*(failed|missing|status=FAIL)} {
                append exit_log_text $expect_out(buffer)
            }
            -re {(^|[\r\n])__KDE_X11_EGL_EXIT_LOG_DONE__[\r\n]} {
                append exit_log_text $expect_out(buffer)
                set saw_exit_done 1
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-exit-crash"
            }
            timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-exit-log-timeout" }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-exit-log-eof" }
        }
    }
    write_x11_egl_artifact_log $exit_log_text
    x11_egl_scan_exit_log $exit_log_text saw_input saw_exit exit_failure_label
    if {$exit_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-exit-$exit_failure_label"
    }
    set timeout $old_timeout
    optional_prompt
    if {!($saw_input && $saw_exit)} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-no-input-exit input=$saw_input exit=$saw_exit"
    }
}

proc x11_dri3_failure_label_from_line {line} {
    set line [string trim $line]
    if {[regexp {host-x11-dri3-present-smoke: ([A-Za-z0-9_]+)[^\r\n]*status=FAIL} $line -> phase]} {
        return "x11-dri3-${phase}-status-FAIL"
    }
    if {[regexp {host-x11-dri3-present-smoke: (connect|atom setup|event) (failed|eof)} $line -> phase reason]} {
        regsub -all { } $phase {_} phase
        return "x11-dri3-${phase}-${reason}"
    }
    if {[regexp {No such file|cannot execute|not found} $line]} {
        return "x11-dri3-exec-missing"
    }
    return ""
}

proc x11_dri3_scan_launch_log {text start_var connect_var dri3_var present_var map_var configure_var fd_var launch_present_var complete_var failure_var} {
    upvar 1 $start_var saw_start
    upvar 1 $connect_var saw_connect
    upvar 1 $dri3_var saw_dri3
    upvar 1 $present_var saw_present
    upvar 1 $map_var saw_map
    upvar 1 $configure_var saw_configure
    upvar 1 $fd_var saw_fd
    upvar 1 $launch_present_var saw_launch_present
    upvar 1 $complete_var saw_complete
    upvar 1 $failure_var failure_label

    set saw_dri3_ext 0
    set saw_dri3_version 0
    set saw_present_ext 0
    set saw_present_version 0
    set saw_present_select 0
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-dri3-present-smoke: start} $line]} {
            set saw_start 1
        }
        if {[regexp {host-x11-dri3-present-smoke: connected root=} $line]} {
            set saw_connect 1
        }
        if {[regexp {host-x11-dri3-present-smoke: extension name=DRI3 present=1} $line]} {
            set saw_dri3_ext 1
        }
        if {[regexp {host-x11-dri3-present-smoke: dri3_version major=} $line]} {
            set saw_dri3_version 1
        }
        if {[regexp {host-x11-dri3-present-smoke: extension name=Present present=1} $line]} {
            set saw_present_ext 1
        }
        if {[regexp {host-x11-dri3-present-smoke: present_version major=} $line]} {
            set saw_present_version 1
        }
        if {[regexp {host-x11-dri3-present-smoke: present_select_input status=PASS} $line]} {
            set saw_present_select 1
        }
        if {[regexp {host-x11-dri3-present-smoke: map_notify} $line]} {
            set saw_map 1
        }
        if {[regexp {host-x11-dri3-present-smoke: configure_notify} $line]} {
            set saw_configure 1
        }
        if {[regexp {host-x11-dri3-present-smoke: dri3_open_fd status=PASS} $line]} {
            set saw_fd 1
        }
        if {[regexp {host-x11-dri3-present-smoke: present_pixmap mode=launch serial=} $line]} {
            set saw_launch_present 1
        }
        if {$saw_launch_present && [regexp {host-x11-dri3-present-smoke: present_complete serial=} $line]} {
            set saw_complete 1
        }
        if {$failure_label eq ""} {
            set label [x11_dri3_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
    set saw_dri3 [expr {$saw_dri3_ext && $saw_dri3_version}]
    set saw_present [expr {$saw_present_ext && $saw_present_version && $saw_present_select}]
}

proc x11_dri3_scan_input_log {text input_var present_var complete_var failure_var} {
    upvar 1 $input_var saw_input
    upvar 1 $present_var saw_input_present
    upvar 1 $complete_var saw_input_complete
    upvar 1 $failure_var failure_label

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-dri3-present-smoke: input_ready} $line]} {
            set saw_input 1
        }
        if {[regexp {host-x11-dri3-present-smoke: present_pixmap mode=input serial=} $line]} {
            set saw_input_present 1
        }
        if {$saw_input_present && [regexp {host-x11-dri3-present-smoke: present_complete serial=} $line]} {
            set saw_input_complete 1
        }
        if {$failure_label eq ""} {
            set label [x11_dri3_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
}

proc x11_dri3_scan_exit_log {text sent_var received_var exit_var failure_var} {
    upvar 1 $sent_var saw_sent
    upvar 1 $received_var saw_received
    upvar 1 $exit_var saw_exit
    upvar 1 $failure_var failure_label

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-dri3-present-smoke: wm_delete_sent} $line]} {
            set saw_sent 1
        }
        if {[regexp {host-x11-dri3-present-smoke: wm_delete_received} $line]} {
            set saw_received 1
        }
        if {[regexp {host-x11-dri3-present-smoke: exited} $line]} {
            set saw_exit 1
        }
        if {$failure_label eq ""} {
            set label [x11_dri3_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
}

proc x11_dri3_launch_suffix {saw_start saw_connect saw_dri3 saw_present saw_map saw_configure saw_fd saw_launch_present saw_complete} {
    return "start=$saw_start connect=$saw_connect dri3=$saw_dri3 present=$saw_present map=$saw_map configure=$saw_configure fd=$saw_fd launch_present=$saw_launch_present complete=$saw_complete"
}

proc run_kde_x11_dri3_probe {} {
    global timeout x11_dri3_available host_x11_dri3_png

    if {!$x11_dri3_available} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-missing"
    }

    set old_timeout $timeout
    sync_prompt
    set timeout 90
    set log_path "/tmp/host-gui-host-x11-dri3-present-smoke.log"

    send "rm -f $log_path; /bin/host-x11-dri3-present-smoke & echo KDE_X11_DRI3_LAUNCHED\r"
    expect {
        -re {KDE_X11_DRI3_LAUNCHED} {}
        -re {exec .*failed|not found|cannot execute} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-launch"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-launch-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-launch-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-launch-eof" }
    }
    optional_prompt
    sleep 8

    send "cat $log_path; echo __KDE_X11_DRI3_LOG_DONE__\r"
    set saw_start 0
    set saw_connect 0
    set saw_dri3 0
    set saw_present 0
    set saw_map 0
    set saw_configure 0
    set saw_fd 0
    set saw_launch_present 0
    set saw_complete 0
    set saw_done 0
    set failure_label ""
    set log_text ""
    while {!$saw_done} {
        expect {
            -re {host-x11-dri3-present-smoke: start} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: connected root=} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: extension name=(DRI3|Present) present=} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: (dri3_version|present_version) major=} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: (present_select_input|dri3_open_fd) status=PASS} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: (map_notify|configure_notify)} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: present_(pixmap|complete) } {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: [^\r\n]*(failed|status=FAIL|event eof)} {
                append log_text $expect_out(buffer)
            }
            -re {(^|[\r\n])__KDE_X11_DRI3_LOG_DONE__[\r\n]} {
                append log_text $expect_out(buffer)
                set saw_done 1
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-log-crash"
            }
            timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-log-timeout" }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-log-eof" }
        }
    }
    x11_dri3_scan_launch_log $log_text saw_start saw_connect saw_dri3 saw_present saw_map saw_configure saw_fd saw_launch_present saw_complete failure_label
    if {$failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $failure_label [x11_dri3_launch_suffix $saw_start $saw_connect $saw_dri3 $saw_present $saw_map $saw_configure $saw_fd $saw_launch_present $saw_complete]"
    }
    if {!($saw_start && $saw_connect && $saw_dri3 && $saw_present && $saw_map && $saw_configure && $saw_fd && $saw_launch_present && $saw_complete)} {
        set timeout $old_timeout
        optional_prompt
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-incomplete [x11_dri3_launch_suffix $saw_start $saw_connect $saw_dri3 $saw_present $saw_map $saw_configure $saw_fd $saw_launch_present $saw_complete]"
    }
    optional_prompt
    host_screenshot "x11-dri3" $host_x11_dri3_png

    send "/bin/mouseinject 32768 32768 0; /bin/mouseinject 32768 32768 1; /bin/mouseinject 32768 32768 0; /bin/keyinject text xv6; echo KDE_X11_DRI3_INPUT_DONE\r"
    expect {
        -re {KDE_X11_DRI3_INPUT_DONE} {}
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-eof" }
    }
    optional_prompt
    sleep 3

    send "cat $log_path; echo __KDE_X11_DRI3_INPUT_LOG_DONE__\r"
    set saw_input 0
    set saw_input_present 0
    set saw_input_complete 0
    set saw_input_done 0
    set input_failure_label ""
    set input_log_text ""
    while {!$saw_input_done} {
        expect {
            -re {host-x11-dri3-present-smoke: input_ready} {
                append input_log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: present_(pixmap|complete) } {
                append input_log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: [^\r\n]*(failed|status=FAIL|event eof)} {
                append input_log_text $expect_out(buffer)
            }
            -re {(^|[\r\n])__KDE_X11_DRI3_INPUT_LOG_DONE__[\r\n]} {
                append input_log_text $expect_out(buffer)
                set saw_input_done 1
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-log-crash"
            }
            timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-log-timeout" }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-log-eof" }
        }
    }
    x11_dri3_scan_input_log $input_log_text saw_input saw_input_present saw_input_complete input_failure_label
    if {$input_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-$input_failure_label"
    }
    if {!($saw_input && $saw_input_present && $saw_input_complete)} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-no-input input=$saw_input present=$saw_input_present complete=$saw_input_complete"
    }

    send "/bin/keyinject key esc; echo KDE_X11_DRI3_ESC_DONE\r"
    expect {
        -re {KDE_X11_DRI3_ESC_DONE} {}
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-esc-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-esc-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-esc-eof" }
    }
    optional_prompt
    sleep 3

    send "cat $log_path; echo __KDE_X11_DRI3_EXIT_LOG_DONE__\r"
    set saw_sent 0
    set saw_received 0
    set saw_exit 0
    set saw_exit_done 0
    set exit_failure_label ""
    set exit_log_text ""
    while {!$saw_exit_done} {
        expect {
            -re {host-x11-dri3-present-smoke: wm_delete_sent} {
                append exit_log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: wm_delete_received} {
                append exit_log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: exited} {
                append exit_log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: [^\r\n]*(failed|status=FAIL|event eof)} {
                append exit_log_text $expect_out(buffer)
            }
            -re {(^|[\r\n])__KDE_X11_DRI3_EXIT_LOG_DONE__[\r\n]} {
                append exit_log_text $expect_out(buffer)
                set saw_exit_done 1
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-exit-crash"
            }
            timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-exit-log-timeout" }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-exit-log-eof" }
        }
    }
    x11_dri3_scan_exit_log $exit_log_text saw_sent saw_received saw_exit exit_failure_label
    if {$exit_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-exit-$exit_failure_label"
    }
    set timeout $old_timeout
    optional_prompt
    if {!($saw_sent && $saw_received && $saw_exit)} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-no-exit sent=$saw_sent received=$saw_received exit=$saw_exit"
    }
}

proc run_probe_suite {} {
    run_guest_check "/bin/kde-libinput-probe" "kde-libinput-probe" 20
    run_guest_check "/bin/kde-dlopen-probe" "kde-dlopen-probe" 30
    run_guest_check "/bin/kde-unix-socket-probe" "kde-unix-socket-probe" 20
    run_guest_check "/bin/kde-drm-probe" "kde-drm-probe" 30
    run_guest_check "/bin/kde-proc-mountinfo-probe" "kde-proc-mountinfo-probe" 30
    run_guest_check "/bin/kde-config-atomic-probe" "kde-config-atomic-probe" 30
    run_guest_check "/bin/kde-pulse-cookie-probe" "kde-pulse-cookie-probe" 30
    run_guest_check "/bin/kde-proc-comm-probe" "kde-proc-comm-probe" 20
    run_guest_check "/bin/kde-pty-shell-probe" "kde-pty-shell-probe" 30
}

proc run_late_kde_guardrails {} {
    run_wayland_seat_probe
    run_guest_check "/bin/kde-trash-stat-probe" "kde-trash-stat-probe" 20
    run_guest_check "/bin/kde-kwriteconfig-probe" "kde-kwriteconfig-probe" 60
    run_kwin_screenshot_probe
}

proc role_probe_once {required_label require_plasma require_xwayland} {
    global timeout
    set old_timeout $timeout
    sync_prompt
    set timeout 8
    set args ""
    if {$require_xwayland} {
        append args " --require-xwayland"
    }
    send "KDE_PROCESS_PROBE_TRACE=1 /bin/kde-process-probe$args\r"
    expect {
        -re {kde_process_probe[^\r\n]*kwin=([0-9]+)[^\r\n]*plasmashell=([0-9]+)[^\r\n]*xwayland=([0-9]+)[^\r\n]*} {
            set kwin $expect_out(1,string)
            set plasma $expect_out(2,string)
            set xwayland $expect_out(3,string)
            set timeout $old_timeout
            optional_prompt
            if {$kwin == "0"} {
                return 0
            }
            if {$require_plasma && $plasma == "0"} {
                return 0
            }
            if {$require_xwayland && $xwayland == "0"} {
                return 0
            }
            return 1
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL crash"
        }
        timeout {
            set timeout $old_timeout
            if {$require_plasma} {
                return 0
            }
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL role-probe-eof" }
    }
    set timeout $old_timeout
    optional_prompt
    return 0
}

proc wait_for_roles {required_label require_plasma require_xwayland attempts delay_seconds} {
    for {set i 0} {$i < $attempts} {incr i} {
        if {[role_probe_once $required_label $require_plasma $require_xwayland]} {
            return
        }
        sleep $delay_seconds
    }
    finish 7 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $required_label"
}

proc capture_fb {guest_path label} {
    global timeout
    if {![fb_visual_enabled]} {
        return
    }
    set old_timeout $timeout
    sync_prompt
    set timeout 20
    send "fbstat ppm-current $guest_path 0 0 1280 800; sync; echo KDE_FB_CAPTURE_DONE_$label\r"
    expect {
        -re "KDE_FB_CAPTURE_DONE_$label" {
            set timeout $old_timeout
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-crash"
        }
        -re {fbstat: [^\r\n]+} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-fbstat"
        }
        timeout {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-eof" }
    }
    set timeout $old_timeout
    optional_prompt
}

proc click_abs {x y done_label fail_label} {
    global timeout
    set old_timeout $timeout
    sync_prompt
    set timeout 20
    send "/bin/mouseinject $x $y 0; /bin/mouseinject $x $y 1; /bin/mouseinject $x $y 0; echo $done_label\r"
    expect {
        -re $done_label {
            set timeout $old_timeout
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $fail_label-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $fail_label-click-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $fail_label-click-eof" }
    }
    set timeout $old_timeout
    optional_prompt
}

proc double_click_abs {x y done_prefix fail_label} {
    global timeout
    set old_timeout $timeout
    sync_prompt
    set timeout 20
    set done_label "${done_prefix}_DONE"
    send "/bin/mouseinject dblclick $x $y 250000; echo $done_label\r"
    expect {
        -re $done_label {
            set timeout $old_timeout
        }
        -re {mouseinject: (open|write) [^\r\n]*failed} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $fail_label-click-failed"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $fail_label-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $fail_label-click-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $fail_label-click-eof" }
    }
    set timeout $old_timeout
    optional_prompt
    sleep 5
}

proc click_desktop_app_icons {} {
    # Seeded KDE desktop icons in a 1280x800 guest. Coordinates are xv6
    # absolute mouse coordinates, not pixels. The current desktop:/ KIO
    # activation path is tracked as a gap; these clicks still prove pointer
    # targeting and selection on each KDE launcher.
    click_abs 3000 3300 "KDE_DESKTOP_CHROMIUM_DONE" "desktop-chromium"
    click_abs 8900 3300 "KDE_DESKTOP_DOLPHIN_DONE" "desktop-dolphin"
    click_abs 14850 3300 "KDE_DESKTOP_KWRITE_DONE" "desktop-kwrite"
    click_abs 20800 3300 "KDE_DESKTOP_KONSOLE_DONE" "desktop-konsole"
}

proc try_clicked_desktop_process_probe {} {
    global timeout chromium_available

    set old_timeout $timeout
    sync_prompt
    set timeout 45
    set args "--require-apps --require-audio"
    if {$chromium_available} {
        append args " --require-chromium"
    }
    send [format {KDE_PROCESS_PROBE_TRACE=1 /bin/kde-process-probe %s; echo kde-clicked-apps-process-probe_STATUS:$?} $args]
    send "\r"
    expect {
        -re {kde_process_probe[^\r\n]*status=PASS} {
            set timeout $old_timeout
            optional_prompt
            return 1
        }
        -re {kde_process_probe[^\r\n]*status=WAIT} {
            puts "KDE-PLASMA-DESKTOP-SMOKE-WARN desktop-click-activation-did-not-launch-apps"
            set timeout $old_timeout
            optional_prompt
            return 0
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-clicked-apps-process-probe-crash"
        }
        timeout {
            puts "KDE-PLASMA-DESKTOP-SMOKE-WARN desktop-click-activation-process-probe-timeout"
            set timeout $old_timeout
            optional_prompt
            return 0
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-clicked-apps-process-probe-eof" }
    }
    set timeout $old_timeout
    optional_prompt
    return 0
}

proc run_direct_app_launch_probe {} {
    global chromium_available

    if {$chromium_available} {
        run_guest_check "/bin/kde-app-launch-probe --require-chromium" "kde-app-launch-probe" 120
    } else {
        run_guest_check "/bin/kde-app-launch-probe" "kde-app-launch-probe" 90
    }
}

log_file -a $runlog
spawn timeout --foreground $timeout bash scripts/launch/run-qemu.sh x86_64 $kernel $tmpimg
set qemu_pid [exp_pid]

expect {
    -re {FB: registered /dev/fb0 \(virtio-gpu direct 1280x800x32} {}
    -re {PANIC|fatal page fault|spin_lock reentry} {
        finish 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL early-crash"
    }
    timeout { finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL no-fb0" }
    eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL early-eof" }
}

expect {
    -re {xv6-desktop-session: selected desktop=kde} {}
    -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|exec failed|not found|status=127} {
        finish 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL launch-crash"
    }
    timeout { finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL no-desktop-dispatch" }
    eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL dispatch-eof" }
}

expect {
    -re {kde-session: starting KDE Plasma desktop} {}
    -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|exec failed|not found|status=127} {
        finish 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL session-crash"
    }
    timeout { finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL no-kde-session" }
    eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL session-eof" }
}

if {[kde_smoke_reducer] eq "x11-egl"} {
    wait_for_kde_session_ready
    set x11_egl_session_result [wait_for_x11_egl_session_probe_terminal]
    set x11_egl_session_status [lindex $x11_egl_session_result 0]
    set x11_egl_session_exit_status [lindex $x11_egl_session_result 1]
    if {$x11_egl_session_status eq "PASS" && $x11_egl_session_exit_status eq "0"} {
        finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=x11-egl session_probe=PASS"
    }
    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-session-probe-$x11_egl_session_status exit_status=$x11_egl_session_exit_status"
}

if {[kde_smoke_reducer] eq "x11-dri3"} {
    wait_for_kde_session_ready
    run_kde_x11_dri3_probe
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=x11-dri3"
}

if {[kde_smoke_reducer] eq "x11-glx-fps"} {
    wait_for_kde_session_ready
    run_kde_x11_glx_fps_session_probe
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=x11-glx-fps session_probe=PASS"
}

if {[kde_smoke_reducer] eq "x11-present-fps"} {
    wait_for_kde_session_ready
    run_kde_x11_present_fps_session_probe
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=x11-present-fps session_probe=PASS"
}

if {![legacy_serial_validation_enabled] && [guest_smoke_agent_enabled]} {
    wait_for_kde_session_ready
    sleep 10
    host_screenshot "startup" $host_startup_png
    wait_for_guest_smoke_agent
    capture_fb $guest_final_ppm "final-agent"
} else {
    if {![guest_smoke_agent_enabled] && ![legacy_serial_validation_enabled]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-WARN guest-agent-disabled-using-legacy-serial-validation"
    }
    optional_prompt
    wait_for_kde_session_ready
    sleep 45
    optional_prompt
    wait_for_roles "no-kwin" 0 0 90 1
    wait_for_roles "no-plasmashell" 1 0 180 1
    sleep 15
    capture_fb $guest_before_ppm "post-startup"
    host_screenshot "startup" $host_startup_png
    run_guest_check "KDE_PROCESS_PROBE_TRACE=1 /bin/kde-process-probe --require-audio" "kde-audio-process-probe" 20
    capture_fb $guest_before_ppm "input-before-desktop-icons"
    host_screenshot "input-before" $host_input_before_png
    click_desktop_app_icons
    sleep 35
    capture_fb $guest_after_ppm "input-after-desktop-icons"
    host_screenshot "input-after" $host_input_after_png
    set clicked_apps_launched [try_clicked_desktop_process_probe]
    if {!$clicked_apps_launched} {
        run_direct_app_launch_probe
    }
    run_optional_direct_app_launch_probe
    run_kde_x11_egl_probe
    sleep 10
    run_guest_check "KDE_PROCESS_PROBE_TRACE=1 /bin/kde-process-probe --require-apps --require-audio" "kde-apps-process-probe" 20
    run_probe_suite
    run_late_kde_guardrails
    capture_fb $guest_final_ppm "final-legacy"
}
finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE"
