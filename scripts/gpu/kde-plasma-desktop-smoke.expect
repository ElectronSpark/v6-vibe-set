    }
    puts $fh "chromium_video_post_evidence gpu_error_pid_context=[chromium_gpu_error_pid_context_summary]"
    puts $fh "chromium_video_post_evidence launcher_log_present=[expr {[file exists $wayland_chromium_log] ? 1 : 0}]"
    puts $fh "chromium_video_post_evidence launcher_crash_seen=$launcher_crash_seen launcher_crash_match=[evidence_quote $launcher_crash_match]"
    puts $fh "chromium_video_post_evidence launcher_loader_seen=$launcher_loader_seen launcher_loader_match=[evidence_quote $launcher_loader_match]"
    puts $fh "chromium_video_post_evidence rela_preprobe_summary=$rela_preprobe_summary"
    puts $fh "chromium_video_post_evidence host_egl_gbm_log_present=[guest_artifact_real_file $host_egl_gbm_log]"
    puts $fh "chromium_video_post_evidence host_egl_gbm_status_present=[guest_artifact_real_file $host_egl_gbm_status]"
    set egl_gbm_result [host_egl_gbm_result_line]
    if {$egl_gbm_result ne ""} {
        puts $fh "chromium_video_post_evidence host_egl_gbm_result=$egl_gbm_result"
    }
    if {$egl_gbm_smoke_result ne ""} {
        puts $fh "chromium_video_post_evidence host_egl_gbm_smoke_result=$egl_gbm_smoke_result"
    }
    if {$egl_gbm_status_line ne "missing"} {
        puts $fh "chromium_video_post_evidence host_egl_gbm_status=$egl_gbm_status_line"
    }
    puts $fh "chromium_video_post_evidence egl_chromium_offscreen_ready=$egl_chromium_offscreen_ready reason=$egl_chromium_offscreen_reason pbuffer_es3_count=$egl_chromium_pbuffer_es3_count pbuffer_es2_count=$egl_chromium_pbuffer_es2_count native_window_pbuffer_es3_count=$egl_chromium_native_window_pbuffer_es3_count native_window_pbuffer_es2_count=$egl_chromium_native_window_pbuffer_es2_count window_es3_count=$egl_chromium_window_es3_count window_es2_count=$egl_chromium_window_es2_count surfaceless_es3_count=$egl_chromium_surfaceless_es3_count surfaceless_es2_count=$egl_chromium_surfaceless_es2_count"
    foreach line $egl_chromium_config_lines {
        puts $fh "chromium_video_post_evidence egl_chromium_config_shape=$line"
    }
    puts $fh "chromium_video_post_evidence egl_chromium_context_attempts pbuffer_es3=$egl_chromium_attempt_pbuffer_es3 pbuffer_es2=$egl_chromium_attempt_pbuffer_es2 native_window_pbuffer_es3=$egl_chromium_attempt_native_window_pbuffer_es3 native_window_pbuffer_es2=$egl_chromium_attempt_native_window_pbuffer_es2 window_gbm_es3=$egl_chromium_attempt_window_gbm_es3 window_gbm_es2=$egl_chromium_attempt_window_gbm_es2 window_surfaceless_es3=$egl_chromium_attempt_window_surfaceless_es3 window_surfaceless_es2=$egl_chromium_attempt_window_surfaceless_es2 surfaceless_es3=$egl_chromium_attempt_surfaceless_es3 surfaceless_es2=$egl_chromium_attempt_surfaceless_es2"
    puts $fh "chromium_video_post_evidence egl_chromium_context_ready=$egl_chromium_context_ready reason=$egl_chromium_context_ready_reason"
    foreach line $egl_chromium_attempt_lines {
        puts $fh "chromium_video_post_evidence egl_chromium_context_attempt=$line"
    }
    puts $fh "chromium_video_post_evidence launch_probe_log_present=[expr {[file exists $chromium_launch_probe_log] ? 1 : 0}]"
    puts $fh "chromium_video_post_evidence launch_evidence_status=$launch_evidence_status"
    puts $fh "chromium_video_post_evidence sampler_log_present=[guest_artifact_real_file $chromium_video_sampler_log]"
    puts $fh "chromium_video_post_evidence sampler_status_present=[guest_artifact_real_file $chromium_video_sampler_status]"
    puts $fh "chromium_video_post_evidence sampler_completion_seen=$sampler_completion_seen sampler_result_pass=$sampler_result_pass sampler_result_skip=$sampler_result_skip fast_census_required=$fast_census_required fast_census_result_pass=$fast_census_result_pass fast_census_summary_seen=$fast_census_summary_seen"
    if {$sampler_status_line ne "missing"} {
        puts $fh "chromium_video_post_evidence sampler_status=$sampler_status_line"
    }
    if {$sampler_result_line ne ""} {
        puts $fh "chromium_video_post_evidence sampler_result=$sampler_result_line"
    }
    if {$fast_census_result_line ne ""} {
        puts $fh "chromium_video_post_evidence fast_census_result=$fast_census_result_line"
    }
    puts $fh "chromium_video_post_evidence capture_log_present=[guest_artifact_real_file $chromium_video_capture_log]"
    puts $fh "chromium_video_post_evidence capture_log_summary=$capture_log_summary"
    puts $fh "chromium_video_post_evidence capture_timing_summary=$capture_timing_summary"
    puts $fh "chromium_video_post_evidence capture_status=$capture_status_line"
    puts $fh "chromium_video_post_evidence capture_result_pass=$capture_result_pass"
    puts $fh "chromium_video_post_evidence capture_present_count=$capture_present_count capture_expected_count=$chromium_video_sample_count"
    puts $fh "chromium_video_post_evidence capture_motion_min_ae_delta=[chromium_video_motion_min_ae_delta]"
    puts $fh "chromium_video_post_evidence capture_nonblack_count=$capture_nonblack_count capture_first_nonblack_index=$capture_first_nonblack_index"
    puts $fh "chromium_video_post_evidence capture_changed_count=$capture_changed_count capture_post_nonblack_changed_count=$capture_post_nonblack_changed_count"
    puts $fh "chromium_video_post_evidence capture_frame_hash_summary=$frame_hash_summary"
    puts $fh "chromium_video_post_evidence scanout_sample_current_summary=$scanout_sample_current_summary"
    puts $fh "chromium_video_post_evidence scanout_read_summary=$scanout_read_summary"
    puts $fh "chromium_video_post_evidence drm_execbuffer_time_summary=$drm_execbuffer_time_summary"
    puts $fh "chromium_video_post_evidence process_summary=[chromium_process_evidence_summary]"
    puts $fh "chromium_video_post_evidence process_policy_summary=[chromium_process_policy_summary]"
    puts $fh "chromium_video_post_evidence fast_census_summary=$fast_census_summary"
    puts $fh "chromium_video_post_evidence role_lifecycle_summary=[chromium_process_role_lifecycle_summary]"
    if {$crash_match ne ""} {
        puts $fh "chromium_video_post_evidence crash_match=$crash_match"
    }
    puts $fh "chromium_video_post_evidence chromium_int3_summary=$int3_summary"
    puts $fh "chromium_video_post_evidence chromium_int3_context=$int3_context_summary"
    puts $fh "chromium_video_post_evidence chromium_syscall_tail=$syscall_tail_summary"
    puts $fh "chromium_video_post_evidence chromium_fault_summary=$fault_summary"
    puts $fh "chromium_video_post_evidence chromium_fault_context=$fault_context_summary"
    puts $fh "chromium_video_post_evidence kwin_alloc_trace_summary=$kwin_trace_summary"
    if {$launcher_wayland_failure ne ""} {
        puts $fh "chromium_video_post_evidence launcher_wayland_failure=$launcher_wayland_failure"
    }
    if {$metrics_line ne ""} {
        puts $fh "chromium_video_post_evidence metrics=$metrics_line"
    }
    if {$perf_start_line ne ""} {
        puts $fh "chromium_video_post_evidence perf_start=$perf_start_line"
    }
    if {$perf_startup_line ne ""} {
        puts $fh "chromium_video_post_evidence perf_startup=$perf_startup_line"
    }
    if {$perf_play_line ne ""} {
        puts $fh "chromium_video_post_evidence perf_play=$perf_play_line"
    }
    if {$perf_playing_line ne ""} {
        puts $fh "chromium_video_post_evidence perf_playing=$perf_playing_line"
    }
    if {$perf_tick_line ne ""} {
        puts $fh "chromium_video_post_evidence perf_tick=$perf_tick_line"
    }
    if {$perf_result_line ne ""} {
        puts $fh "chromium_video_post_evidence perf_result=$perf_result_line"
    }
    if {$result_line ne ""} {
        puts $fh "chromium_video_post_evidence result=$result_line"
    }
    puts $fh "chromium_video_post_evidence status=$status reason=$reason"
    close $fh

    return $reason
}

proc chromium_video_url_has_verified_asset {url} {
    if {[string first "file:///share/webkit/perf-video.html" $url] == 0} {
        return [expr {[debugfs_path_exists "/share/webkit/perf-video.html"] &&
                      [debugfs_path_exists "/share/webkit/perf-1280x800-60fps.mp4"]}]
    }
    if {[string first "file:///share/webkit/video-direct.html" $url] == 0} {
        return [expr {[debugfs_path_exists "/share/webkit/video-direct.html"] &&
                      [debugfs_path_exists "/share/webkit/long-test.mp4"]}]
    }
    return 0
}

proc chromium_video_select_url {} {
    global chromium_video_url chromium_video_proof_mode
    global chromium_video_limitation
    global chromium_video_startup_ms

    if {[info exists ::env(KDE_CHROMIUM_URL)] &&
        $::env(KDE_CHROMIUM_URL) ne ""} {
        set chromium_video_url $::env(KDE_CHROMIUM_URL)
        if {[chromium_video_url_has_verified_asset $chromium_video_url]} {
            set chromium_video_proof_mode "custom-url"
            set chromium_video_limitation ""
        } else {
            set chromium_video_proof_mode "launch-log-only"
            set chromium_video_limitation "custom-url-without-verified-local-video-asset"
        }
        return
    }

    if {[debugfs_path_exists "/share/webkit/perf-video.html"] &&
        [debugfs_path_exists "/share/webkit/perf-1280x800-60fps.mp4"]} {
        set chromium_video_url [format "file:///share/webkit/perf-video.html?asset=perf-1280x800-60fps.mp4&ms=15000&startupMs=%d&postFailObserveMs=12000&hud=1" $chromium_video_startup_ms]
        set chromium_video_proof_mode "local-video"
        set chromium_video_limitation ""
        return
    }

    if {[debugfs_path_exists "/share/webkit/video-direct.html"] &&
        [debugfs_path_exists "/share/webkit/long-test.mp4"]} {
        set chromium_video_url "file:///share/webkit/video-direct.html?asset=long-test.mp4"
        set chromium_video_proof_mode "video"
        set chromium_video_limitation ""
        return
    }

    set chromium_video_url "file:///share/webkit/video-direct.html"
    set chromium_video_proof_mode "launch-log-only"
    set chromium_video_limitation "no-local-video-asset"
}

proc stage_desktop_interaction_helper_script {} {
    global tmpimg outdir guest_desktop_interaction_script

    set interlaunch_delay_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_INTERLAUNCH_DELAY_MS)] &&
        [string is integer -strict $::env(KDE_APP_LAUNCH_PROBE_INTERLAUNCH_DELAY_MS)] &&
        $::env(KDE_APP_LAUNCH_PROBE_INTERLAUNCH_DELAY_MS) >= 0 &&
        $::env(KDE_APP_LAUNCH_PROBE_INTERLAUNCH_DELAY_MS) <= 60000} {
        set interlaunch_delay_default $::env(KDE_APP_LAUNCH_PROBE_INTERLAUNCH_DELAY_MS)
    }
    set konsole_wait_sample_default 500
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_WAIT_SAMPLE_MS)] &&
        [string is integer -strict $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_WAIT_SAMPLE_MS)] &&
        $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_WAIT_SAMPLE_MS) >= 0 &&
        $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_WAIT_SAMPLE_MS) <= 60000} {
        set konsole_wait_sample_default $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_WAIT_SAMPLE_MS)
    }
    set konsole_only_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_ONLY)]} {
        set konsole_only_value [string tolower $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_ONLY)]
        if {$konsole_only_value eq "1" || $konsole_only_value eq "true" ||
            $konsole_only_value eq "yes" || $konsole_only_value eq "on"} {
            set konsole_only_default 1
        }
    }
    set konsole_variant_default "baseline"
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT)] &&
        [lsearch -exact {baseline no-profile no-hold minimal} \
             $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT)] >= 0} {
        set konsole_variant_default $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT)
    }
    set konsole_snapshot_default ""
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_SNAPSHOT_MS)]} {
        set konsole_snapshot_value [string map {"\n" " " "\r" " " "\t" " "} $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_SNAPSHOT_MS)]
        if {[regexp {^[0-9, ]*$} $konsole_snapshot_value]} {
            set konsole_snapshot_default $konsole_snapshot_value
        }
    }
    set kprofile_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KPROFILE)]} {
        set kprofile_value [string tolower $::env(KDE_APP_LAUNCH_PROBE_KPROFILE)]
        if {$kprofile_value eq "1" || $kprofile_value eq "true" ||
            $kprofile_value eq "yes" || $kprofile_value eq "on"} {
            set kprofile_default 1
        }
    }
    set kprofile_hover_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER)]} {
        set hover_value [string tolower $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER)]
        if {$hover_value eq "1" || $hover_value eq "true" ||
            $hover_value eq "yes" || $hover_value eq "on"} {
            set kprofile_hover_default 1
        }
    }
    set kprofile_hover_label_default "taskbar-left-icons"
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_LABEL)] &&
        [regexp {^[A-Za-z0-9_.-]+$} $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_LABEL)]} {
        set kprofile_hover_label_default $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_LABEL)
    }
    set kprofile_hover_x_default 11000
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_X)] &&
        [string is integer -strict $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_X)] &&
        $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_X) >= 0 &&
        $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_X) <= 65535} {
        set kprofile_hover_x_default $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_X)
    }
    set kprofile_hover_y_default 64200
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_Y)] &&
        [string is integer -strict $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_Y)] &&
        $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_Y) >= 0 &&
        $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_Y) <= 65535} {
        set kprofile_hover_y_default $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_Y)
    }
    set kprofile_timeout_default 90000
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KPROFILE_TIMEOUT_MS)] &&
        [string is integer -strict $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_TIMEOUT_MS)] &&
        $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_TIMEOUT_MS) >= 1000 &&
        $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_TIMEOUT_MS) <= 120000} {
        set kprofile_timeout_default $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_TIMEOUT_MS)
    }
    set kprofile_userpc_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC)]} {
        set userpc_value [string tolower $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC)]
        if {$userpc_value eq "1" || $userpc_value eq "true" ||
            $userpc_value eq "yes" || $userpc_value eq "on"} {
            set kprofile_userpc_default 1
        }
    }
    set kprofile_vfs_enoent_attr_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR)]} {
        set vfs_enoent_attr_value [string tolower $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR)]
        if {$vfs_enoent_attr_value eq "1" ||
            $vfs_enoent_attr_value eq "true" ||
            $vfs_enoent_attr_value eq "yes" ||
            $vfs_enoent_attr_value eq "on"} {
            set kprofile_vfs_enoent_attr_default 1
        }
    }
    set kprofile_userpc_period_default ""
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD)] &&
        [string is integer -strict $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD)] &&
        $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD) > 0} {
        set kprofile_userpc_period_default $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD)
    }
    set kprofile_userpc_limit_default ""
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT)] &&
        [string is integer -strict $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT)] &&
        $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT) >= 0} {
        set kprofile_userpc_limit_default $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT)
    }
    set semantic_capture_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_SEMANTIC_CAPTURE)]} {
        set semantic_value [string tolower $::env(KDE_APP_LAUNCH_PROBE_SEMANTIC_CAPTURE)]
        if {$semantic_value eq "1" || $semantic_value eq "true" ||
            $semantic_value eq "yes" || $semantic_value eq "on"} {
            set semantic_capture_default 1
        }
    }
    set wayland_debug_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_WAYLAND_DEBUG)]} {
        set wayland_debug_value [string tolower $::env(KDE_APP_LAUNCH_PROBE_WAYLAND_DEBUG)]
        if {$wayland_debug_value eq "1" || $wayland_debug_value eq "true" ||
            $wayland_debug_value eq "yes" || $wayland_debug_value eq "on"} {
            set wayland_debug_default 1
        }
    }
    set konsole_wayland_event_trace_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_WAYLAND_EVENT_TRACE)]} {
        set trace_value [string tolower $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_WAYLAND_EVENT_TRACE)]
        if {$trace_value eq "1" || $trace_value eq "true" ||
            $trace_value eq "yes" || $trace_value eq "on"} {
            set konsole_wayland_event_trace_default 1
        }
    }
    set konsole_qt_event_trace_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE)]} {
        set qt_trace_value [string tolower $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE)]
        if {$qt_trace_value eq "1" || $qt_trace_value eq "true" ||
            $qt_trace_value eq "yes" || $qt_trace_value eq "on"} {
            set konsole_qt_event_trace_default 1
        }
    }
    set konsole_qt_bridge_trace_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_BRIDGE_TRACE)]} {
        set qt_bridge_trace_value [string tolower $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_BRIDGE_TRACE)]
        if {$qt_bridge_trace_value eq "1" || $qt_bridge_trace_value eq "true" ||
            $qt_bridge_trace_value eq "yes" || $qt_bridge_trace_value eq "on"} {
            set konsole_qt_bridge_trace_default 1
        }
    }
    set konsole_qt_cpp_trace_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE)]} {
        set qt_cpp_trace_value [string tolower $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE)]
        if {$qt_cpp_trace_value eq "1" || $qt_cpp_trace_value eq "true" ||
            $qt_cpp_trace_value eq "yes" || $qt_cpp_trace_value eq "on"} {
            set konsole_qt_cpp_trace_default 1
        }
    }
    set konsole_loader_trace_default 0
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_LOADER_TRACE)]} {
        set loader_trace_value [string tolower $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_LOADER_TRACE)]
        if {$loader_trace_value eq "1" || $loader_trace_value eq "true" ||
            $loader_trace_value eq "yes" || $loader_trace_value eq "on"} {
            set konsole_loader_trace_default 1
        }
    }
    set konsole_qt_event_trace_min_default 20
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_MIN_MS)] &&
        [string is integer -strict $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_MIN_MS)] &&
        $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_MIN_MS) >= 1 &&
        $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_MIN_MS) <= 10000} {
        set konsole_qt_event_trace_min_default $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_MIN_MS)
    }
    set konsole_qt_event_trace_limit_default 512
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_LIMIT)] &&
        [string is integer -strict $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_LIMIT)] &&
        $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_LIMIT) >= 0 &&
        $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_LIMIT) <= 1000000} {
        set konsole_qt_event_trace_limit_default $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_LIMIT)
    }
    set konsole_qt_cpp_trace_min_default 20
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_MIN_MS)] &&
        [string is integer -strict $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_MIN_MS)] &&
        $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_MIN_MS) >= 1 &&
        $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_MIN_MS) <= 10000} {
        set konsole_qt_cpp_trace_min_default $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_MIN_MS)
    }
    set konsole_qt_cpp_trace_limit_default 512
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_LIMIT)] &&
        [string is integer -strict $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_LIMIT)] &&
        $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_LIMIT) >= 0 &&
        $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_LIMIT) <= 1000000} {
        set konsole_qt_cpp_trace_limit_default $::env(KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_LIMIT)
    }
    set konsole_loader_trace_limit_default 4096
    if {[info exists ::env(KONSOLE_LOADER_TRACE_LIMIT)] &&
        [string is integer -strict $::env(KONSOLE_LOADER_TRACE_LIMIT)] &&
        $::env(KONSOLE_LOADER_TRACE_LIMIT) >= 0 &&
        $::env(KONSOLE_LOADER_TRACE_LIMIT) <= 1000000} {
        set konsole_loader_trace_limit_default $::env(KONSOLE_LOADER_TRACE_LIMIT)
    }
    set newstuff_stub_default 0
    if {[env_bool KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB 0]} {
        set newstuff_stub_default 1
    }
    set qtmm_stub_default 0
    if {[env_bool KDE_APP_LAUNCH_PROBE_QTMM_STUB 0]} {
        set qtmm_stub_default 1
    }
    set qt_minimal_imageformats_default 0
    if {[env_bool KDE_APP_LAUNCH_PROBE_QT_MINIMAL_IMAGEFORMATS 0]} {
        set qt_minimal_imageformats_default 1
    }

    set host_script "$outdir/kde-desktop-interaction-helper.sh.host"
    set fh [open $host_script w]
    puts $fh "#!/bin/bash"
    puts $fh "kind=\"\$1\""
    puts $fh "serial=\"\$2\""
    puts $fh "label=\"\$3\""
    puts $fh "shift 3"
    puts $fh "probe_rc=0"
    puts $fh "status=\"/kde-interaction-\${kind}-\${serial}-\${label}.status\""
    puts $fh "log=\"/kde-interaction-\${kind}-\${serial}-\${label}.log\""
    puts $fh "tmp=\"\${status}.tmp.\$\$.\${RANDOM:-0}\""
    puts $fh "/bin/rm -f \"\$status\" \"\$tmp\" \"\$log\""
    puts $fh "{"
    puts $fh {  now_ms() {
    local up sec frac
    up="$(/bin/cat /proc/uptime 2>/dev/null)"
    up="${up%% *}"
    sec="${up%.*}"
    frac="${up#*.}"
    if [ "$frac" = "$up" ]; then
      frac=0
    fi
    case "$sec" in
      ''|*[!0-9]*) echo 0; return ;;
    esac
    case "$frac" in
      ''|*[!0-9]*) frac=0 ;;
    esac
    frac="${frac}000"
    frac="${frac:0:3}"
    echo $((10#$sec * 1000 + 10#$frac))
  }
  clamp_abs16_coord() {
    local value="${1:-0}"
    case "$value" in
      ''|*[!0-9]*) value=0 ;;
    esac
    if [ "$value" -lt 0 ]; then
      value=0
    elif [ "$value" -gt 65535 ]; then
      value=65535
    fi
    echo "$value"
  }
  bound_mouse_target() {
    local requested_x="${1:-0}"
    local requested_y="${2:-0}"
    local x y sample screen_w screen_h bounds_source max_x max_y pixel_x pixel_y
    x="$(clamp_abs16_coord "$requested_x")"
    y="$(clamp_abs16_coord "$requested_y")"
    screen_w=1280
    screen_h=800
    bounds_source=default-1280x800
    sample="$(fbstat sample-current 0 0 1280 800 2>/dev/null || true)"
    if [[ "$sample" =~ screen=([0-9]+)x([0-9]+) ]]; then
      screen_w="${BASH_REMATCH[1]}"
      screen_h="${BASH_REMATCH[2]}"
      bounds_source=fbstat-current
    fi
    case "$screen_w" in ''|*[!0-9]*) screen_w=1280 ;; esac
    case "$screen_h" in ''|*[!0-9]*) screen_h=800 ;; esac
    if [ "$screen_w" -le 0 ]; then screen_w=1280; fi
    if [ "$screen_h" -le 0 ]; then screen_h=800; fi
    max_x=$((screen_w - 1))
    max_y=$((screen_h - 1))
    if [ "$max_x" -le 0 ]; then
      pixel_x=0
      BOUND_MOUSE_X=0
    else
      pixel_x=$(((x * max_x + 32767) / 65535))
      if [ "$pixel_x" -lt 0 ]; then pixel_x=0; fi
      if [ "$pixel_x" -gt "$max_x" ]; then pixel_x="$max_x"; fi
      BOUND_MOUSE_X=$(((pixel_x * 65535 + max_x / 2) / max_x))
    fi
    if [ "$max_y" -le 0 ]; then
      pixel_y=0
      BOUND_MOUSE_Y=0
    else
      pixel_y=$(((y * max_y + 32767) / 65535))
      if [ "$pixel_y" -lt 0 ]; then pixel_y=0; fi
      if [ "$pixel_y" -gt "$max_y" ]; then pixel_y="$max_y"; fi
      BOUND_MOUSE_Y=$(((pixel_y * 65535 + max_y / 2) / max_y))
    fi
    BOUND_MOUSE_FIELDS="input_source=guest requested_x=$requested_x requested_y=$requested_y bounded_x=$BOUND_MOUSE_X bounded_y=$BOUND_MOUSE_Y bounded_guest_pixel_x=$pixel_x bounded_guest_pixel_y=$pixel_y bounds_source=$bounds_source framebuffer=${screen_w}x${screen_h} workarea=0,0-${max_x},${max_y} coordinate_space=guest-mouseinject-absolute16 input_policy=guest-only pointer_injection=guest-mouseinject host_cursor_sync_enabled=0 host_cursor_sync=disabled qemu_monitor_input=0 monitor_path=disabled"
  }
  run_injection() {
    local mode="$1"
    shift
    local input_fields="$1"
    shift
    local start end rc status_text
    start="$(now_ms)"
    rc=0
    "$@" || rc=$?
    end="$(now_ms)"
    status_text=PASS
    if [ "$rc" -ne 0 ]; then
      status_text=FAIL
    fi
    echo "kde_interaction_helper phase=input-injection mode=$mode status=$status_text $input_fields start_ms=$start end_ms=$end elapsed_ms=$((end - start)) rc=$rc command=$*"
    return "$rc"
  }}
    puts $fh "  case \"\$kind\" in"
    puts $fh "    capture)"
    puts $fh "      fbstat ppm-current \"\$1\" 0 0 1280 800"
    puts $fh "      sync"
    puts $fh "      ;;"
    puts $fh "    sample)"
    puts $fh "      fbstat sample-current 0 0 1280 800"
    puts $fh "      ;;"
    puts $fh "    action)"
    puts $fh "      mode=\"\$1\""
    puts $fh "      shift"
    puts $fh "      case \"\$mode\" in"
    puts $fh "        move)"
    puts $fh "          bound_mouse_target \"\$1\" \"\$2\""
    puts $fh "          run_injection move \"\$BOUND_MOUSE_FIELDS\" /bin/mouseinject \"\$BOUND_MOUSE_X\" \"\$BOUND_MOUSE_Y\" 0"
    puts $fh "          ;;"
    puts $fh "        click)"
    puts $fh "          bound_mouse_target \"\$1\" \"\$2\""
    puts $fh "          run_injection click-move \"\$BOUND_MOUSE_FIELDS\" /bin/mouseinject \"\$BOUND_MOUSE_X\" \"\$BOUND_MOUSE_Y\" 0"
    puts $fh "          run_injection click-down \"\$BOUND_MOUSE_FIELDS\" /bin/mouseinject \"\$BOUND_MOUSE_X\" \"\$BOUND_MOUSE_Y\" 1"
    puts $fh "          run_injection click-up \"\$BOUND_MOUSE_FIELDS\" /bin/mouseinject \"\$BOUND_MOUSE_X\" \"\$BOUND_MOUSE_Y\" 0"
    puts $fh "          ;;"
    puts $fh "        key)"
    puts $fh "          run_injection key \"input_source=guest coordinate_space=guest-keyinject\" /bin/keyinject key \"\$1\""
    puts $fh "          ;;"
    puts $fh "        *)"
    puts $fh "          echo \"kde-interaction-helper: unknown action mode=\$mode\""
    puts $fh "          ;;"
    puts $fh "      esac"
    puts $fh "      ;;"
    puts $fh "    direct-launch)"
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_INTERLAUNCH_DELAY_MS:=$interlaunch_delay_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_WAIT_SAMPLE_MS:=$konsole_wait_sample_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_ONLY:=$konsole_only_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT:=$konsole_variant_default}\""
    puts $fh {      case "$KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT" in}
    puts $fh {        baseline|no-profile|no-hold|minimal) ;;}
    puts $fh {        *) echo "KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT_INVALID=$KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT"; KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT=baseline ;;}
    puts $fh {      esac}
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_SNAPSHOT_MS:=$konsole_snapshot_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KPROFILE:=$kprofile_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER:=$kprofile_hover_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_LABEL:=$kprofile_hover_label_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_X:=$kprofile_hover_x_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_Y:=$kprofile_hover_y_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KPROFILE_TIMEOUT_MS:=$kprofile_timeout_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC:=$kprofile_userpc_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR:=$kprofile_vfs_enoent_attr_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD:=$kprofile_userpc_period_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT:=$kprofile_userpc_limit_default}\""
    puts $fh {      case "$KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC" in}
    puts $fh {        1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]) KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC=1 ;;}
    puts $fh {        *) KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC=0 ;;}
    puts $fh {      esac}
    puts $fh {      case "$KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR" in}
    puts $fh {        1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]) KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR=1 ;;}
    puts $fh {        *) KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR=0 ;;}
    puts $fh {      esac}
    puts $fh {      case "$KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD" in}
    puts $fh {        ''|*[!0-9]*) KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD="" ;;}
    puts $fh {        0) KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD="" ;;}
    puts $fh {      esac}
    puts $fh {      case "$KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT" in}
    puts $fh {        ''|*[!0-9]*) KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT="" ;;}
    puts $fh {      esac}
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_SEMANTIC_CAPTURE:=$semantic_capture_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_WAYLAND_DEBUG:=$wayland_debug_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_WAYLAND_EVENT_TRACE:=$konsole_wayland_event_trace_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE:=$konsole_qt_event_trace_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_QT_BRIDGE_TRACE:=$konsole_qt_bridge_trace_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_MIN_MS:=$konsole_qt_event_trace_min_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_LIMIT:=$konsole_qt_event_trace_limit_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE:=$konsole_qt_cpp_trace_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_MIN_MS:=$konsole_qt_cpp_trace_min_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_LIMIT:=$konsole_qt_cpp_trace_limit_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_KONSOLE_LOADER_TRACE:=$konsole_loader_trace_default}\""
    puts $fh "      : \"\${KONSOLE_LOADER_TRACE_LIMIT:=$konsole_loader_trace_limit_default}\""
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB:=$newstuff_stub_default}\""
    puts $fh {      case "$KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB" in}
    puts $fh {        1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]) KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB=1 ;;}
    puts $fh {        *) KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB=0 ;;}
    puts $fh {      esac}
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_QTMM_STUB:=$qtmm_stub_default}\""
    puts $fh {      case "$KDE_APP_LAUNCH_PROBE_QTMM_STUB" in}
    puts $fh {        1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]) KDE_APP_LAUNCH_PROBE_QTMM_STUB=1 ;;}
    puts $fh {        *) KDE_APP_LAUNCH_PROBE_QTMM_STUB=0 ;;}
    puts $fh {      esac}
    puts $fh "      : \"\${KDE_APP_LAUNCH_PROBE_QT_MINIMAL_IMAGEFORMATS:=$qt_minimal_imageformats_default}\""
    puts $fh {      case "$KDE_APP_LAUNCH_PROBE_QT_MINIMAL_IMAGEFORMATS" in}
    puts $fh {        1|[Tt][Rr][Uu][Ee]|[Yy][Ee][Ss]|[Oo][Nn]) KDE_APP_LAUNCH_PROBE_QT_MINIMAL_IMAGEFORMATS=1 ;;}
    puts $fh {        *) KDE_APP_LAUNCH_PROBE_QT_MINIMAL_IMAGEFORMATS=0 ;;}
    puts $fh {      esac}
    puts $fh {      KDE_SMOKE_DIRECT_LAUNCH_INDEX="${1:-1}"}
    puts $fh {      KDE_SMOKE_DIRECT_LAUNCH_TEMPERATURE="${2:-cold}"}
    puts $fh {      KDE_SMOKE_DIRECT_LAUNCH_REPEAT_COUNT="${3:-1}"}
    puts $fh {      KDE_SMOKE_DIRECT_LAUNCH_REPEAT_DELAY_MS="${4:-1500}"}
    puts $fh {      case "$KDE_SMOKE_DIRECT_LAUNCH_INDEX" in ''|*[!0-9]*) KDE_SMOKE_DIRECT_LAUNCH_INDEX=1 ;; esac}
    puts $fh {      case "$KDE_SMOKE_DIRECT_LAUNCH_TEMPERATURE" in cold|warm) ;; *) KDE_SMOKE_DIRECT_LAUNCH_TEMPERATURE=warm ;; esac}
    puts $fh {      case "$KDE_SMOKE_DIRECT_LAUNCH_REPEAT_COUNT" in ''|*[!0-9]*) KDE_SMOKE_DIRECT_LAUNCH_REPEAT_COUNT=1 ;; esac}
    puts $fh {      case "$KDE_SMOKE_DIRECT_LAUNCH_REPEAT_DELAY_MS" in ''|*[!0-9]*) KDE_SMOKE_DIRECT_LAUNCH_REPEAT_DELAY_MS=1500 ;; esac}
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_INTERLAUNCH_DELAY_MS=\$KDE_APP_LAUNCH_PROBE_INTERLAUNCH_DELAY_MS\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_WAIT_SAMPLE_MS=\$KDE_APP_LAUNCH_PROBE_KONSOLE_WAIT_SAMPLE_MS\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_ONLY=\$KDE_APP_LAUNCH_PROBE_KONSOLE_ONLY\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT=\$KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_SNAPSHOT_MS=\$KDE_APP_LAUNCH_PROBE_KONSOLE_SNAPSHOT_MS\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KPROFILE=\$KDE_APP_LAUNCH_PROBE_KPROFILE\""
