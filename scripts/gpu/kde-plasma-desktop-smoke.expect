catch { exec sh -c "debugfs -w -R 'rm $guest_chromium_video_rela_preprobe_log' '$tmpimg' >/dev/null 2>&1" }
catch { exec sh -c "debugfs -w -R 'rm $guest_chromium_video_rela_preprobe_status' '$tmpimg' >/dev/null 2>&1" }
catch { exec sh -c "debugfs -w -R 'rm $guest_role_probe_log' '$tmpimg' >/dev/null 2>&1" }
catch { exec sh -c "debugfs -w -R 'rm $guest_konsole_phase_log' '$tmpimg' >/dev/null 2>&1" }
for {set i 0} {$i < $chromium_video_sample_count} {incr i} {
    set guest_chromium_video_ppm [format "/chromium-video-%02d.ppm" $i]
    catch { exec sh -c "debugfs -w -R 'rm $guest_chromium_video_ppm' '$tmpimg' >/dev/null 2>&1" }
}

set env(DISPLAY_MODE) [expr {
    [info exists env(KDE_SMOKE_DISPLAY_MODE)] ?
        $env(KDE_SMOKE_DISPLAY_MODE) : "gtk"
}]
if {$env(DISPLAY_MODE) ne "gtk" && $env(DISPLAY_MODE) ne "sdl"} {
    puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL display-mode=$env(DISPLAY_MODE) expected=gtk-or-sdl"
    exit 2
}
set env(USE_KVM) [expr {[info exists env(USE_KVM)] ? $env(USE_KVM) : "1"}]
set env(QEMU_GPU) [expr {[info exists env(QEMU_GPU)] ? $env(QEMU_GPU) : "virtio-vga-gl-primary"}]
set env(QEMU_INPUT) [expr {[info exists env(QEMU_INPUT)] ? $env(QEMU_INPUT) : "virtio"}]
set env(QEMU_NET) "0"
set env(QEMU_AUDIO) "none"
set env(QEMU_VIRTIO_GPU_XRES) "1280"
set env(QEMU_VIRTIO_GPU_YRES) "800"
set kde_smoke_reducer [expr {[info exists env(KDE_SMOKE_REDUCER)] ? $env(KDE_SMOKE_REDUCER) : ""}]
set kde_interaction_diagnostic_input [kde_interaction_diagnostic_input_enabled]
set kde_interaction_input_source [kde_interaction_input_source]
set kde_interaction_cursor_owner "default"
set kde_interaction_host_cursor_sync 0
set kde_interaction_monitor_path "disabled"
set kde_interaction_normal_reducer [expr {
    $kde_smoke_reducer eq "desktop-interaction-latency" ||
    $kde_smoke_reducer eq "desktop-interaction" ||
    $kde_smoke_reducer eq "desktop-color-wakeup"
}]
if {$kde_interaction_normal_reducer} {
    set kde_interaction_input_source "guest"
    set kde_interaction_host_cursor_sync 0
    set kde_interaction_monitor_path "disabled"
    set env(QEMU_GTK_CURSOR_MODE) "guest"
    set env(QEMU_GTK_SHOW_CURSOR) "off"
    set kde_interaction_cursor_owner "guest-forced-normal-interaction"
}
set qemu_timeout ""
if {[info exists env(KDE_SMOKE_QEMU_TIMEOUT_SECONDS)]} {
    set qemu_timeout $env(KDE_SMOKE_QEMU_TIMEOUT_SECONDS)
} elseif {[info exists env(KDE_SMOKE_TIMEOUT_SECONDS)]} {
    set qemu_timeout $env(KDE_SMOKE_TIMEOUT_SECONDS)
}
if {![string is integer -strict $qemu_timeout] || $qemu_timeout < 60} {
    if {$kde_smoke_reducer eq "chromium-video"} {
        set qemu_timeout 900
    } else {
        set qemu_timeout $timeout
    }
}
if {$qemu_timeout > 3600} {
    set qemu_timeout 3600
}
if {[info exists env(KDE_SMOKE_AGENT)]} {
    set kde_smoke_agent $env(KDE_SMOKE_AGENT)
} elseif {$kde_smoke_reducer eq "x11-egl" ||
          $kde_smoke_reducer eq "x11-dri3" ||
          $kde_smoke_reducer eq "x11-glx-fps" ||
          $kde_smoke_reducer eq "x11-present-fps" ||
          $kde_smoke_reducer eq "desktop-color-wakeup" ||
          $kde_smoke_reducer eq "kwin-screenshot" ||
          $kde_smoke_reducer eq "desktop-interaction-latency" ||
          $kde_smoke_reducer eq "chromium-video" ||
          $kde_smoke_reducer eq "kde-ready" ||
          $kde_smoke_reducer eq "kde-wayland-registry" ||
          $kde_smoke_reducer eq "kde-wayland-liveness" ||
          $kde_smoke_reducer eq "kde-wayland-client-liveness" ||
          $kde_smoke_reducer eq "pre-kwin-libinput"} {
    set kde_smoke_agent "0"
} else {
    set kde_smoke_agent "1"
}
set qemu_append "root=/dev/disk0 video=1280x800 netsurf=0 webkit=0"
if {$kde_smoke_agent ne "0"} {
    append qemu_append " kde_smoke_agent=1"
}
if {$kde_smoke_reducer eq "x11-egl"} {
    append qemu_append " kde_x11_egl_session_probe=1"
}
if {$kde_smoke_reducer eq "x11-glx-fps"} {
    append qemu_append " kde_x11_egl_session_probe=glx-fps"
}
if {$kde_smoke_reducer eq "x11-present-fps"} {
    append qemu_append " kde_x11_egl_session_probe=present-fps"
}
set present_sample_diag [expr {[info exists env(KDE_SMOKE_PRESENT_SAMPLE_DIAG)] ? $env(KDE_SMOKE_PRESENT_SAMPLE_DIAG) : ""}]
if {$present_sample_diag eq "" && $kde_smoke_reducer eq "desktop-color-wakeup"} {
    set present_sample_diag "1"
}
if {$present_sample_diag ne "" && $present_sample_diag ne "0"} {
    append qemu_append " fb_present_sample_diag=1 fb_present_sample_diag_limit=512"
}
set pre_kwin_libinput_probe_only [expr {
    [env_bool KDE_SMOKE_PRE_KWIN_LIBINPUT_PROBE_ONLY 0] ||
    $kde_smoke_reducer eq "pre-kwin-libinput"
}]
if {[env_bool KDE_SMOKE_PRE_KWIN_LIBINPUT_PROBE 0] ||
    $pre_kwin_libinput_probe_only} {
    append qemu_append " kde_pre_kwin_libinput_probe=1"
}
if {$pre_kwin_libinput_probe_only} {
    append qemu_append " kde_pre_kwin_libinput_probe_only=1"
}
if {[env_bool KDE_SMOKE_PLASMASHELL_CRASH_CAPTURE 1]} {
    append qemu_append " kde_plasmashell_crash_capture=1"
}
set plasmashell_disable_kcrash_default [expr {
    ($kde_smoke_reducer eq "chromium-video" && $chromium_launch_only eq "1") ||
    $kde_smoke_reducer eq "kde-wayland-client-liveness"
}]
if {[env_bool KDE_SMOKE_PLASMASHELL_DISABLE_KCRASH $plasmashell_disable_kcrash_default]} {
    append qemu_append " kde_plasmashell_disable_kcrash=1"
}
if {[env_bool KDE_SMOKE_PLASMASHELL_CORE 0]} {
    append qemu_append " kde_plasmashell_core=1"
}
if {$chromium_available} {
    append qemu_append " kde_smoke_require_chromium=1"
}
if {[info exists env(QEMU_APPEND_EXTRA)] && $env(QEMU_APPEND_EXTRA) ne ""} {
    append qemu_append " " $env(QEMU_APPEND_EXTRA)
}
set env(QEMU_APPEND) $qemu_append
set env(QEMU_EXTRA) "-monitor unix:$monitor,server,nowait -trace events=$qemu_trace_events,file=$qemu_trace"

proc screendump {} {
    global monitor ppm
    catch { exec sh -c "printf 'screendump $ppm\\n' | nc -U -w 4 -q 1 '$monitor' >>'$ppm.nc.log' 2>&1 || echo nc-failed >>'$ppm.nc.log'" }
}

proc monitor_screendump_to {path log_path} {
    global monitor

    catch { file delete -force $path }
    catch { file delete -force $log_path }
    catch { exec sh -c "printf 'screendump $path\\n' | nc -U -w 4 -q 1 '$monitor' >'$log_path' 2>&1" }
    return [expr {[file exists $path] && [file size $path] > 32}]
}

proc monitor_command {cmd {timeout_sec 4}} {
    global monitor outdir

    set log_path "$outdir/qemu-monitor-command.log"
    set cmd_path "$outdir/qemu-monitor-command-[pid]-[clock microseconds].txt"
    set fh [open $cmd_path w]
    puts $fh $cmd
    close $fh
    set rc [catch {
        exec sh -c "nc -U -w $timeout_sec -q 0 '$monitor' < '$cmd_path' >> '$log_path' 2>&1"
    } err]
    catch { file delete -force $cmd_path }
    if {$rc != 0} {
        desktop_interaction_log_line "phase=monitor action=command status=FAIL cmd=[evidence_quote $cmd] error=[evidence_quote $err]"
        return 0
    }
    desktop_interaction_log_line "phase=monitor action=command status=PASS cmd=[evidence_quote $cmd]"
    return 1
}

proc optional_monitor_screendump {} {
    if {[info exists ::env(KDE_SMOKE_QEMU_SCREENDUMP)] && $::env(KDE_SMOKE_QEMU_SCREENDUMP) ne "0"} {
        screendump
    }
}

proc host_screenshot {name path} {
    global root outdir
    catch { exec sh -c "'$root/scripts/gpu/capture-host-screen.sh' '$path' > '$outdir/kde-plasma-host-$name.log' 2>&1 || true" }
}

proc stage_host_cursor_sync_script {} {
    global host_cursor_sync_sh host_cursor_sync_ps1

    set ps [open $host_cursor_sync_ps1 w]
    puts $ps {Add-Type @"
using System;
using System.Runtime.InteropServices;
using System.Text;

public static class Xv6CursorNative {
    public delegate bool EnumWindowsProc(IntPtr hWnd, IntPtr lParam);

    [StructLayout(LayoutKind.Sequential)]
    public struct RECT {
        public int Left;
        public int Top;
        public int Right;
        public int Bottom;
    }

    [StructLayout(LayoutKind.Sequential)]
    public struct POINT {
        public int X;
        public int Y;
    }

    [DllImport("user32.dll")]
    public static extern bool EnumWindows(EnumWindowsProc lpEnumFunc,
                                          IntPtr lParam);
    [DllImport("user32.dll")]
    public static extern bool EnumChildWindows(IntPtr hWndParent,
                                               EnumWindowsProc lpEnumFunc,
                                               IntPtr lParam);
    [DllImport("user32.dll")]
    public static extern bool IsWindowVisible(IntPtr hWnd);
    [DllImport("user32.dll", CharSet = CharSet.Unicode)]
    public static extern int GetWindowText(IntPtr hWnd, StringBuilder text,
                                           int count);
    [DllImport("user32.dll")]
    public static extern bool GetWindowRect(IntPtr hWnd, out RECT rect);
    [DllImport("user32.dll")]
    public static extern bool GetClientRect(IntPtr hWnd, out RECT rect);
    [DllImport("user32.dll")]
    public static extern bool ClientToScreen(IntPtr hWnd, ref POINT point);
    [DllImport("user32.dll")]
    public static extern bool SetCursorPos(int x, int y);
}
"@

$title = $env:XV6_QEMU_WINDOW_TITLE
if ([string]::IsNullOrWhiteSpace($title)) {
    $title = "xv6-os QEMU"
}
$guestX = [int]$env:XV6_CURSOR_X
$guestY = [int]$env:XV6_CURSOR_Y
if ($guestX -lt 0) { $guestX = 0 }
if ($guestX -gt 65535) { $guestX = 65535 }
if ($guestY -lt 0) { $guestY = 0 }
if ($guestY -gt 65535) { $guestY = 65535 }

$found = [IntPtr]::Zero
$callback = [Xv6CursorNative+EnumWindowsProc]{
    param([IntPtr]$hWnd, [IntPtr]$lParam)
    if (-not [Xv6CursorNative]::IsWindowVisible($hWnd)) {
        return $true
    }
    $text = New-Object System.Text.StringBuilder 512
    [void][Xv6CursorNative]::GetWindowText($hWnd, $text, $text.Capacity)
    $name = $text.ToString()
    if ($name.Contains($title) -or
        ($title -eq "xv6-os QEMU" -and $name.Contains("QEMU"))) {
        $script:found = $hWnd
        return $false
    }
    return $true
}
[void][Xv6CursorNative]::EnumWindows($callback, [IntPtr]::Zero)
if ($found -eq [IntPtr]::Zero) {
    Write-Output "status=SKIP reason=window-not-found title=$title"
    exit 77
}

$rect = New-Object Xv6CursorNative+RECT
if (-not [Xv6CursorNative]::GetClientRect($found, [ref]$rect)) {
    Write-Output "status=FAIL reason=get-client-rect"
    exit 2
}
$origin = New-Object Xv6CursorNative+POINT
$origin.X = 0
$origin.Y = 0
if (-not [Xv6CursorNative]::ClientToScreen($found, [ref]$origin)) {
    Write-Output "status=FAIL reason=client-to-screen"
    exit 2
}

$width = $rect.Right - $rect.Left
$height = $rect.Bottom - $rect.Top
if ($width -le 0 -or $height -le 0) {
    Write-Output "status=FAIL reason=empty-client width=$width height=$height"
    exit 2
}

$displayX = $origin.X
$displayY = $origin.Y
$displayW = $width
$displayH = $height
$displaySource = "client"
$script:bestChildArea = 0
$script:bestChildRect = $null
$childCallback = [Xv6CursorNative+EnumWindowsProc]{
    param([IntPtr]$hWnd, [IntPtr]$lParam)
    if (-not [Xv6CursorNative]::IsWindowVisible($hWnd)) {
        return $true
    }
    $childRect = New-Object Xv6CursorNative+RECT
    if (-not [Xv6CursorNative]::GetWindowRect($hWnd, [ref]$childRect)) {
        return $true
    }
    $childW = $childRect.Right - $childRect.Left
    $childH = $childRect.Bottom - $childRect.Top
    if ($childW -lt 320 -or $childH -lt 240) {
        return $true
    }
    $area = $childW * $childH
    if ($area -gt $script:bestChildArea) {
        $script:bestChildArea = $area
        $script:bestChildRect = $childRect
    }
    return $true
}
[void][Xv6CursorNative]::EnumChildWindows($found, $childCallback,
                                          [IntPtr]::Zero)
if ($script:bestChildRect -ne $null) {
    $displayX = $script:bestChildRect.Left
    $displayY = $script:bestChildRect.Top
    $displayW = $script:bestChildRect.Right - $script:bestChildRect.Left
    $displayH = $script:bestChildRect.Bottom - $script:bestChildRect.Top
    $displaySource = "child-window"
}

$screenX = $displayX + [int][Math]::Round(($guestX / 65535.0) * ($displayW - 1))
$screenY = $displayY + [int][Math]::Round(($guestY / 65535.0) * ($displayH - 1))
if (-not [Xv6CursorNative]::SetCursorPos($screenX, $screenY)) {
    Write-Output "status=FAIL reason=set-cursor-pos screen_x=$screenX screen_y=$screenY"
    exit 2
}
Write-Output "status=PASS screen_x=$screenX screen_y=$screenY client_x=$($origin.X) client_y=$($origin.Y) client_w=$width client_h=$height display_source=$displaySource display_x=$displayX display_y=$displayY display_w=$displayW display_h=$displayH title=$title"
exit 0
}
    close $ps

    set sh [open $host_cursor_sync_sh w]
    puts $sh {#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 ]]; then
        echo "status=FAIL reason=usage"
        exit 2
fi
if ! command -v powershell.exe >/dev/null 2>&1 ||
   ! command -v wslpath >/dev/null 2>&1; then
        echo "status=SKIP reason=no-powershell"
        exit 77
fi
ps1_win=$(wslpath -w "$XV6_CURSOR_SYNC_PS1")
wslenv="XV6_CURSOR_X:XV6_CURSOR_Y:XV6_QEMU_WINDOW_TITLE"
wslenv="${wslenv}:XV6_CURSOR_SYNC_PS1"
if [[ -n "${WSLENV:-}" ]]; then
        wslenv="${wslenv}:${WSLENV}"
fi
XV6_CURSOR_X="$1" \
XV6_CURSOR_Y="$2" \
XV6_QEMU_WINDOW_TITLE="${QEMU_WINDOW_TITLE:-xv6-os QEMU}" \
XV6_CURSOR_SYNC_PS1="$XV6_CURSOR_SYNC_PS1" \
WSLENV="$wslenv" \
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ps1_win"
}
    close $sh
    catch { exec chmod +x $host_cursor_sync_sh }
}

proc sync_host_cursor_to_guest {x y} {
    global host_cursor_sync_sh host_cursor_sync_ps1
    global kde_interaction_host_cursor_sync
    global kde_interaction_diagnostic_input

    if {!$kde_interaction_host_cursor_sync ||
        !$kde_interaction_diagnostic_input} {
        return 0
    }

    set start_ms [clock milliseconds]
    set rc [catch {
        exec env XV6_CURSOR_SYNC_PS1=$host_cursor_sync_ps1 \
            $host_cursor_sync_sh $x $y
    } out]
    set elapsed_ms [expr {[clock milliseconds] - $start_ms}]
    set text [string map {"\t" " " "\r" "" "\n" " "} $out]
    if {$rc == 0} {
        desktop_interaction_log_line "phase=host-cursor-sync status=PASS x=$x y=$y elapsed_ms=$elapsed_ms detail=[evidence_quote $text]"
    } elseif {[regexp {status=SKIP} $out]} {
        desktop_interaction_log_line "phase=host-cursor-sync status=SKIP x=$x y=$y elapsed_ms=$elapsed_ms detail=[evidence_quote $text]"
    } else {
        desktop_interaction_log_line "phase=host-cursor-sync status=FAIL x=$x y=$y elapsed_ms=$elapsed_ms detail=[evidence_quote $text]"
    }
    return $elapsed_ms
}

proc fb_visual_enabled {} {
    return 1
}

proc desktop_interaction_active_sample_enabled {} {
    return [env_bool KDE_SMOKE_INTERACTION_ACTIVE_SAMPLE 1]
}

proc desktop_interaction_kprofile_enabled {} {
    return [env_bool KDE_APP_LAUNCH_PROBE_KPROFILE 0]
}

proc fb_visual_required {} {
    return [expr {[info exists ::env(KDE_SMOKE_REQUIRE_FB_VISUAL)] && $::env(KDE_SMOKE_REQUIRE_FB_VISUAL) ne "0"}]
}

proc note_visual_warning {message} {
    global visual_warnings

    if {$visual_warnings eq ""} {
        set visual_warnings $message
    } else {
        append visual_warnings "; " $message
    }
    puts "KDE-PLASMA-DESKTOP-SMOKE-WARN $message"
}

proc chromium_video_result_label {label} {
    global kde_smoke_reducer chromium_video_multiprocess
    global chromium_video_disable_audio_output

    if {$kde_smoke_reducer ne "chromium-video"} {
        return $label
    }
    if {[string first "chromium_multiprocess=" $label] < 0} {
        append label " chromium_multiprocess=$chromium_video_multiprocess"
    }
    if {[string first "chromium_disable_audio_output=" $label] < 0} {
        append label " chromium_disable_audio_output=$chromium_video_disable_audio_output"
    }
    return $label
}

proc write_final_status {code label stage} {
    global final_status kde_smoke_reducer
    global chromium_video_multiprocess chromium_video_disable_audio_output

    set label [chromium_video_result_label $label]
    set fh [open $final_status w]
    puts $fh "status_code=$code"
    puts $fh "label=$label"
    puts $fh "stage=$stage"
    puts $fh "reducer=$kde_smoke_reducer"
    if {$kde_smoke_reducer eq "chromium-video"} {
        puts $fh "chromium_multiprocess=$chromium_video_multiprocess"
        puts $fh "chromium_disable_audio_output=$chromium_video_disable_audio_output"
    }
    puts $fh "timestamp=[clock seconds]"
    close $fh
}

proc write_x11_egl_artifact_log {text} {
    global host_x11_egl_log x11_egl_artifact_prefix

    set fh [open $host_x11_egl_log w]
    puts -nonewline $fh $x11_egl_artifact_prefix
    puts -nonewline $fh $text
    close $fh
}

proc read_text_file {path} {
    set fh [open $path r]
    set text [read $fh]
    close $fh
    return $text
}

proc image_saturation_mean {path} {
    if {![file exists $path]} {
        return "missing"
    }
    if {[catch {
        exec convert $path -colorspace HSL -channel G -separate -format "%\[fx:mean\]" info:
    } value]} {
        regsub -all {[\r\n \t]+} $value {_} value
        return "error:$value"
    }
    return [string trim $value]
}

proc host_ppm_sample_stats {path label} {
    global outdir

    set black_ppm "$outdir/kde-interaction-black-1280x800.ppm"
    if {![file exists $black_ppm]} {
        if {[catch { exec convert -size 1280x800 xc:black $black_ppm } err]} {
            regsub -all {[\r\n \t]+} $err {_} err
            return [list "missing" -1 "missing" "monitor_sample_error=black_ref err=$err" -1]
        }
    }

    set nonblack -1
    if {![catch { exec sh -c "compare -metric AE '$path' '$black_ppm' null: 2>&1 || true" } ae]} {
        if {[regexp {([0-9]+)} $ae -> count]} {
            set nonblack $count
        }
    }

    set hash "missing"
    if {![catch { exec sh -c "sha256sum '$path' | awk '{print \$1}'" } sum]} {
        set sum [string trim $sum]
        if {[regexp {^[0-9a-fA-F]+$} $sum]} {
            set hash "0x[string range [string tolower $sum] 0 15]"
        }
    }

    set center "missing"
    if {![catch { exec convert $path -format "%\[hex:p{640,400}\]" info: } center_hex]} {
        set center "0x[string tolower [string trim $center_hex]]"
    }

    set sample_line "monitor_screendump label=$label path=$path nonzero=$nonblack nonblack=$nonblack hash=$hash center=$center"
    return [list $hash $nonblack $center $sample_line $nonblack]
}

proc write_color_metrics {diff_pixels} {
    global before_ppm after_ppm color_metrics

    set before_sat [image_saturation_mean $before_ppm]
    set after_sat [image_saturation_mean $after_ppm]
    set fh [open $color_metrics w]
    puts $fh "before_saturation_mean=$before_sat"
    puts $fh "after_saturation_mean=$after_sat"
    puts $fh "diff_pixels=$diff_pixels"
    if {[string is double -strict $before_sat] &&
        [string is double -strict $after_sat]} {
        puts $fh [format "saturation_delta=%.9f" [expr {$after_sat - $before_sat}]]
    } else {
        puts $fh "saturation_delta=missing"
    }
    close $fh
}

proc chromium_guest_artifact_clear_command {} {
    global guest_wayland_chromium_log guest_wayland_chromium_compat_log
    global guest_chrome_debug_log guest_chrome_debug_compat_log
    global guest_kwin_alloc_trace_log guest_kwin_ioctl_trace_log guest_kwin_loader_ifunc_log
    global guest_qtqml_ifunc_log guest_qtqml_ifunc_status
    global guest_chromium_process_evidence_log guest_chromium_launch_probe_log

    return "rm -f $guest_wayland_chromium_log $guest_wayland_chromium_compat_log $guest_chrome_debug_log $guest_chrome_debug_compat_log $guest_chromium_process_evidence_log $guest_chromium_launch_probe_log"
}

proc host_egl_gbm_result_line {} {
    global host_egl_gbm_log

    if {![file exists $host_egl_gbm_log]} {
        return ""
    }
    set text [read_text_file $host_egl_gbm_log]
    set result ""
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-egl-gbm-gl-smoke: phase=result status=} $line]} {
            set result $line
        }
        if {[regexp {host-egl-gbm-gl-smoke-launcher: phase=child_exit status=} $line]} {
            set result $line
        }
        if {[regexp {kde_chromium_video_egl_gbm_probe exit_status=} $line]} {
            set result $line
        }
    }
    return $result
}

proc host_egl_gbm_smoke_result_line {} {
    global host_egl_gbm_log

    if {![file exists $host_egl_gbm_log]} {
        return ""
    }
    set text [read_text_file $host_egl_gbm_log]
    set result ""
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-egl-gbm-gl-smoke: phase=result status=} $line]} {
            set result $line
        }
    }
    return $result
}

proc host_egl_gbm_chromium_config_metrics {offscreen_ready_var reason_var
                                           pbuffer_es3_var pbuffer_es2_var
                                           native_window_pbuffer_es3_var
                                           native_window_pbuffer_es2_var
                                           window_es3_var window_es2_var
                                           surfaceless_es3_var surfaceless_es2_var
                                           lines_var} {
    global host_egl_gbm_log

    upvar $offscreen_ready_var offscreen_ready
    upvar $reason_var reason
    upvar $pbuffer_es3_var pbuffer_es3
    upvar $pbuffer_es2_var pbuffer_es2
    upvar $native_window_pbuffer_es3_var native_window_pbuffer_es3
    upvar $native_window_pbuffer_es2_var native_window_pbuffer_es2
    upvar $window_es3_var window_es3
    upvar $window_es2_var window_es2
    upvar $surfaceless_es3_var surfaceless_es3
    upvar $surfaceless_es2_var surfaceless_es2
    upvar $lines_var lines

    set offscreen_ready "missing"
    set reason "shape-missing"
    set pbuffer_es3 "missing"
    set pbuffer_es2 "missing"
    set native_window_pbuffer_es3 "missing"
    set native_window_pbuffer_es2 "missing"
    set window_es3 "missing"
    set window_es2 "missing"
    set surfaceless_es3 "missing"
    set surfaceless_es2 "missing"
    set lines {}

    if {![file exists $host_egl_gbm_log]} {
        return
    }

    set text [read_text_file $host_egl_gbm_log]
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {![regexp {host-egl-gbm-gl-smoke: phase=egl_chromium_config_shape } $line]} {
            continue
        }
        lappend lines $line
        if {![regexp { profile=([^ \t]+) } " $line " -> profile] ||
            ![regexp { count=([0-9]+)} $line -> count]} {
            continue
        }

        switch -- $profile {
            chromium_offscreen_pbuffer_es3 {
                set pbuffer_es3 $count
            }
            chromium_offscreen_pbuffer_es2 {
                set pbuffer_es2 $count
            }
            chromium_native_window_pbuffer_es3 {
                set native_window_pbuffer_es3 $count
            }
            chromium_native_window_pbuffer_es2 {
                set native_window_pbuffer_es2 $count
            }
            chromium_window_only_es3 {
                set window_es3 $count
            }
            chromium_window_only_es2 {
                set window_es2 $count
            }
            chromium_surfaceless_es3 {
                set surfaceless_es3 $count
            }
            chromium_surfaceless_es2 {
                set surfaceless_es2 $count
            }
        }
    }

    if {$pbuffer_es3 ne "missing" && $pbuffer_es3 > 0} {
        set offscreen_ready 1
        set reason "es3_rgb_pbuffer_config"
    } elseif {$pbuffer_es3 ne "missing"} {
        set offscreen_ready 0
        set reason "no_es3_rgb_pbuffer_config"
    }
}

proc host_egl_gbm_chromium_attempt_metrics {pbuffer_es3_var pbuffer_es2_var
                                            native_window_pbuffer_es3_var
                                            native_window_pbuffer_es2_var
                                            window_gbm_es3_var window_gbm_es2_var
                                            window_surfaceless_es3_var
                                            window_surfaceless_es2_var
                                            surfaceless_es3_var surfaceless_es2_var
                                            lines_var} {
    global host_egl_gbm_log

    upvar $pbuffer_es3_var pbuffer_es3
    upvar $pbuffer_es2_var pbuffer_es2
    upvar $native_window_pbuffer_es3_var native_window_pbuffer_es3
    upvar $native_window_pbuffer_es2_var native_window_pbuffer_es2
    upvar $window_gbm_es3_var window_gbm_es3
    upvar $window_gbm_es2_var window_gbm_es2
    upvar $window_surfaceless_es3_var window_surfaceless_es3
    upvar $window_surfaceless_es2_var window_surfaceless_es2
    upvar $surfaceless_es3_var surfaceless_es3
    upvar $surfaceless_es2_var surfaceless_es2
    upvar $lines_var lines

    set pbuffer_es3 "missing"
    set pbuffer_es2 "missing"
    set native_window_pbuffer_es3 "missing"
    set native_window_pbuffer_es2 "missing"
    set window_gbm_es3 "missing"
    set window_gbm_es2 "missing"
    set window_surfaceless_es3 "missing"
    set window_surfaceless_es2 "missing"
    set surfaceless_es3 "missing"
    set surfaceless_es2 "missing"
    set lines {}

    if {![file exists $host_egl_gbm_log]} {
        return
    }

    set text [read_text_file $host_egl_gbm_log]
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {![regexp {host-egl-gbm-gl-smoke: phase=egl_chromium_context_attempt } $line]} {
            continue
        }
        lappend lines $line
        if {![regexp { profile=([^ \t]+) } " $line " -> profile] ||
            ![regexp { status=([^ \t]+) } " $line " -> status] ||
            ![regexp { reason=([^ \t]+)} $line -> reason]} {
            continue
        }
        set value "$status/$reason"

        switch -- $profile {
            chromium_offscreen_pbuffer_es3 {
                set pbuffer_es3 $value
            }
            chromium_offscreen_pbuffer_es2 {
                set pbuffer_es2 $value
            }
            chromium_native_window_pbuffer_es3 {
                set native_window_pbuffer_es3 $value
            }
            chromium_native_window_pbuffer_es2 {
                set native_window_pbuffer_es2 $value
            }
            chromium_window_only_gbm_surface_es3 {
                set window_gbm_es3 $value
            }
            chromium_window_only_gbm_surface_es2 {
                set window_gbm_es2 $value
            }
            chromium_window_only_surfaceless_es3 {
                set window_surfaceless_es3 $value
            }
            chromium_window_only_surfaceless_es2 {
                set window_surfaceless_es2 $value
            }
            chromium_surfaceless_es3 {
                set surfaceless_es3 $value
            }
            chromium_surfaceless_es2 {
                set surfaceless_es2 $value
            }
        }
    }
}

proc chromium_video_sampler_result_line {} {
    global chromium_video_sampler_log

    set result ""
    if {[file exists $chromium_video_sampler_log]} {
        set text [read_text_file $chromium_video_sampler_log]
        foreach raw_line [split $text "\n"] {
            set line [string trimright $raw_line "\r"]
            if {[regexp {kde_app_launch_probe chromium_sample_only=1 .*status=} $line]} {
                set result $line
            }
        }
    }
    return $result
}

proc chromium_video_fast_census_result_line {} {
    global chromium_video_sampler_log

    set result ""
    if {[file exists $chromium_video_sampler_log]} {
        set text [read_text_file $chromium_video_sampler_log]
        foreach raw_line [split $text "\n"] {
            set line [string trimright $raw_line "\r"]
            if {[regexp {kde_app_launch_probe chromium_fast_census_only=[01] .*status=} $line]} {
                set result $line
            }
        }
    }
    return $result
}

proc chromium_launcher_policy_summary {} {
    global wayland_chromium_log

    if {![file exists $wayland_chromium_log]} {
        return "available=0"
    }

    set text [read_text_file $wayland_chromium_log]
    set final_argc "missing"
    set use_gl "missing"
    set use_angle "missing"
    set target "missing"
    set egl_platform "missing"
    set simdutf "missing"
    set wayland_simdutf "missing"
    set wayland_debug_requested "missing"
    set wayland_debug "missing"
    set egl_trace "missing"
    set mesa_context_trace "missing"
    set mesa_extension_override "missing"
    set bundled_gl "missing"
    set ld_preload_trace 0
    set ld_preload_ifunc 0
    set argv_use_gl_count 0
    set argv_use_angle_count 0

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {wayland-chromium-launcher: final_argc=([0-9]+)} $line -> argc]} {
            set final_argc $argc
        }
        if {[regexp {wayland-chromium-launcher: argv_[0-9]+="([^"]*)"} $line -> arg]} {
            if {[regexp {^--use-gl=(.*)$} $arg -> value]} {
                set use_gl $value
                incr argv_use_gl_count
            } elseif {[regexp {^--use-angle=(.*)$} $arg -> value]} {
                set use_angle $value
                incr argv_use_angle_count
            } elseif {![string match "--*" $arg] &&
                      ![string match "/opt/host-gui/wayland-chromium/*" $arg]} {
                set target $arg
            }
        }
        if {[regexp {wayland-chromium-launcher: env EGL_PLATFORM="([^"]*)"} $line -> value]} {
            set egl_platform $value
        } elseif {[regexp {wayland-chromium-launcher: env SIMDUTF_FORCE_IMPLEMENTATION="([^"]*)"} $line -> value]} {
            set simdutf $value
        } elseif {[regexp {wayland-chromium-launcher: env WAYLAND_CHROMIUM_SIMDUTF_FORCE_IMPLEMENTATION="([^"]*)"} $line -> value]} {
            set wayland_simdutf $value
        } elseif {[regexp {wayland-chromium-launcher: env WAYLAND_CHROMIUM_EGL_TRACE="([^"]*)"} $line -> value]} {
            set egl_trace $value
        } elseif {[regexp {wayland-chromium-launcher: env XV6_MESA_EGL_CONTEXT_TRACE="([^"]*)"} $line -> value]} {
            set mesa_context_trace $value
        } elseif {[regexp {wayland-chromium-launcher: env MESA_EXTENSION_OVERRIDE="([^"]*)"} $line -> value]} {
            set mesa_extension_override $value
        } elseif {[regexp {wayland-chromium-launcher: env WAYLAND_CHROMIUM_BUNDLED_GL="([^"]*)"} $line -> value]} {
            set bundled_gl $value
        } elseif {[regexp {wayland-chromium-launcher: env WAYLAND_CHROMIUM_WAYLAND_DEBUG="([^"]*)"} $line -> value]} {
            set wayland_debug_requested $value
        } elseif {[regexp {wayland-chromium-launcher: env WAYLAND_DEBUG="([^"]*)"} $line -> value]} {
            set wayland_debug $value
        } elseif {[regexp {wayland-chromium-launcher: env LD_PRELOAD="([^"]*)"} $line -> value]} {
            if {[string first "chromium-egl-trace-preload" $value] >= 0} {
                set ld_preload_trace 1
            }
            if {[string first "libxv6-ifunc-memcpy.so" $value] >= 0} {
                set ld_preload_ifunc 1
            }
        }
    }

    return "available=1 final_argc=$final_argc use_gl=[evidence_quote $use_gl] use_angle=[evidence_quote $use_angle] target=[evidence_quote $target] egl_platform=[evidence_quote $egl_platform] simdutf=[evidence_quote $simdutf] wayland_simdutf=[evidence_quote $wayland_simdutf] wayland_debug_requested=[evidence_quote $wayland_debug_requested] wayland_debug=[evidence_quote $wayland_debug] egl_trace=[evidence_quote $egl_trace] mesa_context_trace=[evidence_quote $mesa_context_trace] mesa_extension_override=[evidence_quote $mesa_extension_override] bundled_gl=[evidence_quote $bundled_gl] ld_preload_trace=$ld_preload_trace ld_preload_ifunc=$ld_preload_ifunc argv_use_gl_count=$argv_use_gl_count argv_use_angle_count=$argv_use_angle_count"
}

proc chromium_wayland_debug_summary {} {
    global wayland_chromium_log

    if {![file exists $wayland_chromium_log]} {
        return "available=0"
    }

    set text [read_text_file $wayland_chromium_log]
    set wayland_debug_requested "missing"
    set wayland_debug "missing"
    set debug_line_count 0
    set protocol_line_count 0
    set surface_create_count 0
    set surface_line_count 0
    set attach_count 0
    set damage_count 0
    set damage_buffer_count 0
    set frame_count 0
    set commit_count 0
    set callback_done_count 0
    set frame_callback_done_count 0
    set attached_surface_count 0
    set damaged_surface_count 0
    set damage_buffer_surface_count 0
    set framed_surface_count 0
    set committed_surface_count 0
    set first_surface_create ""
    set last_surface_create ""
    set last_protocol_line ""
    set first_commit ""
    set last_commit ""
    array set created_surface_seen {}
    array set surface_seen {}
    array set surface_attach_count {}
    array set surface_damage_count {}
    array set surface_damage_buffer_count {}
    array set surface_damage_area_total {}
    array set surface_damage_area_max {}
    array set surface_frame_count {}
    array set surface_frame_done_count {}
    array set surface_commit_count {}
    array set surface_first_commit {}
    array set surface_last_commit {}
    array set surface_first_damage {}
    array set surface_last_damage {}
    array set surface_buffer_seen {}
    array set cursor_surface_seen {}
    array set attached_surface_seen {}
    array set damaged_surface_seen {}
    array set damage_buffer_surface_seen {}
    array set framed_surface_seen {}
    array set committed_surface_seen {}
    array set xdg_surface_to_wl_surface {}
    array set xdg_toplevel_surface_seen {}
    array set callback_seen {}
    array set frame_callback_seen {}
    array set frame_callback_done_seen {}
    array set frame_callback_surface {}

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {wayland-chromium-launcher: env WAYLAND_CHROMIUM_WAYLAND_DEBUG="([^"]*)"} $line -> value]} {
            set wayland_debug_requested $value
        } elseif {[regexp {wayland-chromium-launcher: env WAYLAND_DEBUG="([^"]*)"} $line -> value]} {
            set wayland_debug $value
        }
        if {[regexp {^\[[ \t]*[0-9.]+\]} $line]} {
            incr protocol_line_count
            set last_protocol_line $line
        }
        if {[regexp {^\[[ \t]*[0-9.]+\].*wl_} $line]} {
            incr debug_line_count
        }
        if {[regexp {wl_compositor[@#][0-9]+\.create_surface\(new id wl_surface[@#]([0-9]+)\)} $line -> created_surface_id]} {
            incr surface_create_count
            set created_surface_seen($created_surface_id) 1
            if {$first_surface_create eq ""} {
                set first_surface_create $line
            }
            set last_surface_create $line
        }
        if {[regexp {xdg_wm_base[@#][0-9]+\.get_xdg_surface\(new id xdg_surface[@#]([0-9]+), wl_surface[@#]([0-9]+)\)} $line -> xdg_surface_id wl_surface_id]} {
            set xdg_surface_to_wl_surface($xdg_surface_id) $wl_surface_id
        }
        if {[regexp {xdg_surface[@#]([0-9]+)\.get_toplevel\(new id xdg_toplevel[@#][0-9]+\)} $line -> xdg_surface_id] &&
            [info exists xdg_surface_to_wl_surface($xdg_surface_id)]} {
            set xdg_toplevel_surface_seen($xdg_surface_to_wl_surface($xdg_surface_id)) 1
        }
        if {[regexp {wl_pointer[@#][0-9]+\.set_cursor\([^,]+, wl_surface[@#]([0-9]+),} $line -> cursor_surface_id]} {
            set cursor_surface_seen($cursor_surface_id) 1
        }
        if {[regexp -- {->[^\r\n]*wl_surface[@#]([0-9]+)\.(attach|damage|damage_buffer|frame|commit)\(} $line -> surface_id method]} {
            incr surface_line_count
            set surface_seen($surface_id) 1
            switch -- $method {
                attach {
                    incr attach_count
                    incr surface_attach_count($surface_id)
                    set attached_surface_seen($surface_id) 1
                    if {[regexp {attach\((wl_buffer[@#][0-9]+|nil),} $line -> buffer_id] &&
                        $buffer_id ne "nil"} {
                        set surface_buffer_seen($surface_id,$buffer_id) 1
                    }
                }
                damage {
                    incr damage_count
                    incr surface_damage_count($surface_id)
                    set damaged_surface_seen($surface_id) 1
                    set surface_last_damage($surface_id) $line
                    if {![info exists surface_first_damage($surface_id)]} {
                        set surface_first_damage($surface_id) $line
                    }
                    if {[regexp {damage\((-?[0-9]+), (-?[0-9]+), ([0-9]+), ([0-9]+)\)} $line -> _x _y width height]} {
                        set area [expr {$width * $height}]
                        if {![info exists surface_damage_area_total($surface_id)]} {
                            set surface_damage_area_total($surface_id) 0
                        }
                        incr surface_damage_area_total($surface_id) $area
                        if {![info exists surface_damage_area_max($surface_id)] ||
                            $area > $surface_damage_area_max($surface_id)} {
                            set surface_damage_area_max($surface_id) $area
                        }
                    }
                }
                damage_buffer {
                    incr damage_buffer_count
                    incr surface_damage_buffer_count($surface_id)
                    set damage_buffer_surface_seen($surface_id) 1
                }
                frame {
                    incr frame_count
                    incr surface_frame_count($surface_id)
                    set framed_surface_seen($surface_id) 1
                    if {[regexp {new id wl_callback[@#]([0-9]+)} $line -> frame_callback_id]} {
                        set frame_callback_seen($frame_callback_id) 1
                        set frame_callback_surface($frame_callback_id) $surface_id
                    }
                }
                commit {
                    incr commit_count
                    incr surface_commit_count($surface_id)
                    set committed_surface_seen($surface_id) 1
                    if {$first_commit eq ""} {
                        set first_commit $line
                    }
                    set last_commit $line
                    if {![info exists surface_first_commit($surface_id)]} {
                        set surface_first_commit($surface_id) $line
                    }
                    set surface_last_commit($surface_id) $line
                }
            }
        }
        if {[regexp {wl_callback[@#]([0-9]+)\.done\(} $line -> callback_id]} {
            incr callback_done_count
            set callback_seen($callback_id) 1
            if {[info exists frame_callback_seen($callback_id)]} {
                incr frame_callback_done_count
                set frame_callback_done_seen($callback_id) 1
                if {[info exists frame_callback_surface($callback_id)]} {
                    set callback_surface_id $frame_callback_surface($callback_id)
                    incr surface_frame_done_count($callback_surface_id)
                    unset frame_callback_surface($callback_id)
                }
            }
        }
    }

    set primary_surface "missing"
    set primary_surface_role "missing"
    set primary_commit_count 0
    set primary_damage_area_total 0
    foreach pass {xdg_toplevel non_cursor any_surface} {
        set pass_primary_surface "missing"
        set pass_primary_commit_count 0
        set pass_primary_damage_area_total 0
        foreach surface_id [array names surface_seen] {
            if {$pass eq "xdg_toplevel"} {
                if {![info exists xdg_toplevel_surface_seen($surface_id)] ||
                    [info exists cursor_surface_seen($surface_id)]} {
                    continue
                }
            } elseif {$pass eq "non_cursor"} {
                if {[info exists cursor_surface_seen($surface_id)]} {
                    continue
                }
            }
            set commits 0
            set damage_area 0
            if {[info exists surface_commit_count($surface_id)]} {
                set commits $surface_commit_count($surface_id)
            }
            if {[info exists surface_damage_area_total($surface_id)]} {
                set damage_area $surface_damage_area_total($surface_id)
            }
            if {$pass_primary_surface eq "missing" ||
                $commits > $pass_primary_commit_count ||
                ($commits == $pass_primary_commit_count &&
                 $damage_area > $pass_primary_damage_area_total)} {
                set pass_primary_surface $surface_id
                set pass_primary_commit_count $commits
                set pass_primary_damage_area_total $damage_area
            }
        }
        if {$pass_primary_surface ne "missing"} {
            set primary_surface $pass_primary_surface
            set primary_surface_role $pass
            set primary_commit_count $pass_primary_commit_count
            set primary_damage_area_total $pass_primary_damage_area_total
            break
        }
    }

    set primary_attach_count 0
    set primary_damage_count 0
    set primary_damage_buffer_count 0
    set primary_damage_area_max 0
    set primary_frame_count 0
    set primary_frame_done_count 0
    set primary_buffer_count 0
    set primary_first_commit ""
    set primary_last_commit ""
    set primary_first_damage ""
    set primary_last_damage ""
    if {$primary_surface ne "missing"} {
        if {[info exists surface_attach_count($primary_surface)]} {
            set primary_attach_count $surface_attach_count($primary_surface)
        }
        if {[info exists surface_damage_count($primary_surface)]} {
            set primary_damage_count $surface_damage_count($primary_surface)
        }
        if {[info exists surface_damage_buffer_count($primary_surface)]} {
            set primary_damage_buffer_count $surface_damage_buffer_count($primary_surface)
        }
        if {[info exists surface_damage_area_max($primary_surface)]} {
            set primary_damage_area_max $surface_damage_area_max($primary_surface)
        }
        if {[info exists surface_frame_count($primary_surface)]} {
            set primary_frame_count $surface_frame_count($primary_surface)
        }
        if {[info exists surface_frame_done_count($primary_surface)]} {
            set primary_frame_done_count $surface_frame_done_count($primary_surface)
        }
        if {[info exists surface_first_commit($primary_surface)]} {
            set primary_first_commit $surface_first_commit($primary_surface)
        }
        if {[info exists surface_last_commit($primary_surface)]} {
            set primary_last_commit $surface_last_commit($primary_surface)
        }
        if {[info exists surface_first_damage($primary_surface)]} {
            set primary_first_damage $surface_first_damage($primary_surface)
        }
        if {[info exists surface_last_damage($primary_surface)]} {
            set primary_last_damage $surface_last_damage($primary_surface)
        }
        foreach key [array names surface_buffer_seen "$primary_surface,*"] {
            incr primary_buffer_count
        }
    }

    set surface_count [llength [array names surface_seen]]
    set created_surface_count [llength [array names created_surface_seen]]
    set active_surface_count $surface_count
    set surface_delivery_op_count $surface_line_count
    set attached_surface_count [llength [array names attached_surface_seen]]
    set damaged_surface_count [llength [array names damaged_surface_seen]]
    set damage_buffer_surface_count [llength [array names damage_buffer_surface_seen]]
    set framed_surface_count [llength [array names framed_surface_seen]]
    set committed_surface_count [llength [array names committed_surface_seen]]
    set created_surface_without_delivery_count 0
    foreach created_surface_id [array names created_surface_seen] {
        if {![info exists surface_seen($created_surface_id)]} {
            incr created_surface_without_delivery_count
        }
    }
    set cursor_surface_count [llength [array names cursor_surface_seen]]
    set xdg_toplevel_surface_count [llength [array names xdg_toplevel_surface_seen]]
    set primary_is_cursor [expr {$primary_surface ne "missing" &&
                                 [info exists cursor_surface_seen($primary_surface)] ? 1 : 0}]
    set primary_is_xdg_toplevel [expr {$primary_surface ne "missing" &&
                                       [info exists xdg_toplevel_surface_seen($primary_surface)] ? 1 : 0}]
    set callback_count [llength [array names callback_seen]]
    set frame_callback_count [llength [array names frame_callback_seen]]
    set frame_callback_done_unique_count [llength [array names frame_callback_done_seen]]
    set requested_enabled [expr {[summary_bool_value $wayland_debug_requested] ||
                                 [summary_bool_value $wayland_debug] ? 1 : 0}]
    set protocol_seen [expr {$debug_line_count > 0 ? 1 : 0}]
    set enabled [expr {$requested_enabled || $protocol_seen ? 1 : 0}]
    return "available=1 requested=[evidence_quote $wayland_debug_requested] wayland_debug=[evidence_quote $wayland_debug] enabled=$enabled requested_enabled=$requested_enabled protocol_seen=$protocol_seen protocol_line_count=$protocol_line_count debug_line_count=$debug_line_count surface_create_count=$surface_create_count created_surface_count=$created_surface_count created_surface_without_delivery_count=$created_surface_without_delivery_count surface_delivery_op_count=$surface_delivery_op_count active_surface_count=$active_surface_count surface_line_count=$surface_line_count surface_count=$surface_count cursor_surface_count=$cursor_surface_count xdg_toplevel_surface_count=$xdg_toplevel_surface_count attached_surface_count=$attached_surface_count damaged_surface_count=$damaged_surface_count damage_buffer_surface_count=$damage_buffer_surface_count framed_surface_count=$framed_surface_count committed_surface_count=$committed_surface_count attach_count=$attach_count damage_count=$damage_count damage_buffer_count=$damage_buffer_count frame_count=$frame_count commit_count=$commit_count frame_callback_count=$frame_callback_count frame_callback_done_count=$frame_callback_done_count frame_callback_done_unique_count=$frame_callback_done_unique_count callback_done_count=$callback_done_count callback_count=$callback_count primary_surface=$primary_surface primary_surface_role=$primary_surface_role primary_is_cursor=$primary_is_cursor primary_is_xdg_toplevel=$primary_is_xdg_toplevel primary_attach_count=$primary_attach_count primary_damage_count=$primary_damage_count primary_damage_buffer_count=$primary_damage_buffer_count primary_damage_area_total=$primary_damage_area_total primary_damage_area_max=$primary_damage_area_max primary_frame_count=$primary_frame_count primary_frame_done_count=$primary_frame_done_count primary_commit_count=$primary_commit_count primary_buffer_count=$primary_buffer_count first_surface_create=[evidence_quote $first_surface_create] last_surface_create=[evidence_quote $last_surface_create] last_protocol_line=[evidence_quote $last_protocol_line] first_commit=[evidence_quote $first_commit] last_commit=[evidence_quote $last_commit] primary_first_commit=[evidence_quote $primary_first_commit] primary_last_commit=[evidence_quote $primary_last_commit] primary_first_damage=[evidence_quote $primary_first_damage] primary_last_damage=[evidence_quote $primary_last_damage]"
}

proc summary_value {summary key default} {
    set pattern [format {(^| )%s=("[^"]*"|\S+)} $key]

    if {[regexp $pattern $summary -> _ value]} {
        if {[string length $value] >= 2 &&
            [string index $value 0] eq "\"" &&
            [string index $value end] eq "\""} {
            return [string range $value 1 end-1]
        }
        return $value
    }
    return $default
}

proc summary_bool_value {value} {
    set normalized [string tolower [string trim $value]]

    switch -- $normalized {
        "" -
        "0" -
        "false" -
        "no" -
        "off" -
        "missing" -
        "(unset)" {
            return 0
        }
        default {
            return 1
        }
    }
}

proc konsole_wayland_event_trace_summary {text} {
    set trace_count 0
    set poll_count 0
    set wl_count 0
    set pipe_read_count 0
    set get_fd_count 0
    set summary_count 0
    set max_poll_us 0
    set max_poll_op "missing"
    set max_poll_fd "missing"
    set max_poll_kind "missing"
    set max_poll_revents "missing"
    set max_poll_fionread "missing"
    set max_poll_target "missing"
    set max_wl_us 0
    set max_wl_op "missing"
    set max_poll_to_wl_us 0
    set max_write_to_poll_us 0
    set max_poll_to_read_us 0
    set first_fd3_target "missing"
    set first_fd9_target "missing"

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {![regexp {konsole-wayland-event-trace: ([^\r\n]*)} $line -> payload]} {
            continue
        }
        incr trace_count
        if {[regexp {^poll } $payload]} {
            incr poll_count
            set elapsed [summary_value $payload "elapsed_us" 0]
            set write_gap [summary_value $payload "write_to_poll_us" 0]
            if {[string is integer -strict $elapsed] && $elapsed > $max_poll_us} {
                set max_poll_us $elapsed
                set max_poll_op [summary_value $payload "op" "missing"]
                set max_poll_fd [summary_value $payload "fd" "missing"]
                set max_poll_kind [summary_value $payload "kind" "missing"]
                set max_poll_revents [summary_value $payload "revents" "missing"]
                set max_poll_fionread [summary_value $payload "fionread" "missing"]
                set max_poll_target [summary_value $payload "target" "missing"]
            }
            if {[string is integer -strict $write_gap] && $write_gap > $max_write_to_poll_us} {
                set max_write_to_poll_us $write_gap
            }
            if {[summary_value $payload "fd" "missing"] eq "3" &&
                $first_fd3_target eq "missing"} {
                set first_fd3_target [summary_value $payload "target" "missing"]
            }
            if {[summary_value $payload "fd" "missing"] eq "9" &&
                $first_fd9_target eq "missing"} {
                set first_fd9_target [summary_value $payload "target" "missing"]
            }
        } elseif {[regexp {^wl } $payload]} {
            incr wl_count
            set elapsed [summary_value $payload "elapsed_us" 0]
            set poll_gap [summary_value $payload "poll_to_wl_us" 0]
            if {[string is integer -strict $elapsed] && $elapsed > $max_wl_us} {
                set max_wl_us $elapsed
                set max_wl_op [summary_value $payload "op" "missing"]
            }
            if {[string is integer -strict $poll_gap] && $poll_gap > $max_poll_to_wl_us} {
                set max_poll_to_wl_us $poll_gap
            }
        } elseif {[regexp {^pipe-read } $payload]} {
            incr pipe_read_count
            set poll_gap [summary_value $payload "poll_to_read_us" 0]
            if {[string is integer -strict $poll_gap] && $poll_gap > $max_poll_to_read_us} {
                set max_poll_to_read_us $poll_gap
            }
        } elseif {[regexp {^wl-get-fd } $payload]} {
            incr get_fd_count
            set fd [summary_value $payload "fd" "missing"]
            if {$fd eq "3" && $first_fd3_target eq "missing"} {
                set first_fd3_target [summary_value $payload "target" "missing"]
            }
        } elseif {[regexp {^summary } $payload]} {
            incr summary_count
            foreach {key varname} {
                max_poll_us max_poll_us
                max_wl_us max_wl_us
                max_write_to_poll_us max_write_to_poll_us
                max_poll_to_read_us max_poll_to_read_us
            } {
                set value [summary_value $payload $key "missing"]
                if {[string is integer -strict $value] && $value > [set $varname]} {
                    set $varname $value
                }
            }
        }
    }

    set available [expr {$trace_count > 0 ? 1 : 0}]
    set max_poll_ms [expr {$max_poll_us / 1000}]
    set max_wl_ms [expr {$max_wl_us / 1000}]
    set max_poll_to_wl_ms [expr {$max_poll_to_wl_us / 1000}]
    set max_write_to_poll_ms [expr {$max_write_to_poll_us / 1000}]
    set max_poll_to_read_ms [expr {$max_poll_to_read_us / 1000}]
    set branch_hint "missing"
    if {$available} {
        if {$max_write_to_poll_ms >= 150} {
            set branch_hint "pipe_write_to_poll_wake_candidate"
        } elseif {$max_poll_to_wl_ms >= 150 || $max_poll_to_read_ms >= 150} {
            set branch_hint "post_readiness_userland_gap_candidate"
        } elseif {$max_poll_ms >= 150 && $max_poll_kind eq "wayland"} {
            set branch_hint "normal_libwayland_or_compositor_wait_candidate"
        } elseif {$max_poll_ms >= 150} {
            set branch_hint "poll_wait_candidate"
        } else {
            set branch_hint "no_ge_150ms_gap_in_preload_trace"
        }
    }

    return "available=$available trace_count=$trace_count poll_count=$poll_count wl_count=$wl_count pipe_read_count=$pipe_read_count get_fd_count=$get_fd_count summary_count=$summary_count max_poll_ms=$max_poll_ms max_poll_op=$max_poll_op max_poll_fd=$max_poll_fd max_poll_kind=$max_poll_kind max_poll_revents=$max_poll_revents max_poll_fionread=$max_poll_fionread max_poll_target=[evidence_quote $max_poll_target] max_wl_ms=$max_wl_ms max_wl_op=$max_wl_op max_poll_to_wl_ms=$max_poll_to_wl_ms max_write_to_poll_ms=$max_write_to_poll_ms max_poll_to_read_ms=$max_poll_to_read_ms first_fd3_target=[evidence_quote $first_fd3_target] first_fd9_target=[evidence_quote $first_fd9_target] branch_hint=$branch_hint"
}

proc konsole_qt_event_trace_summary {text} {
    set trace_count 0
    set fd3_ready_count 0
    set glib_count 0
    set glib_phase_count 0
    set wl_main_count 0
    set summary_count 0
    set max_ready_to_call_us 0
    set max_ready_to_glib_us 0
    set max_ready_to_wl_us 0
    set max_glib_iteration_us 0
    set max_glib_prepare_us 0
    set max_glib_query_us 0
    set max_glib_check_us 0
    set max_glib_dispatch_us 0
    set max_glib_poll_us 0
    set glib_poll_total_us 0
    set glib_dispatch_total_us 0
    set glib_phase_calls 0
    set glib_prepare_calls 0
    set glib_query_calls 0
    set glib_check_calls 0
    set glib_dispatch_calls 0
    set glib_poll_calls 0
    set max_wl_main_us 0
    set fd3_ready_in_active_span 0
    set fd3_ready_in_process_events 0
    set fd3_ready_in_glib_iteration 0
    set fd3_ready_in_send_wse 0
    set span_ready_during_calls 0
    set max_fd3_ready_span_age_us 0
    set max_fd3_ready_span_depth 0
    set max_span_ready_offset_us 0
    set fd3_ready_in_glib_poll 0
    set fd3_ready_in_glib_dispatch 0
    set fd3_ready_in_glib_other_phase 0
    set max_fd3_ready_glib_poll_age_us 0
    set max_fd3_ready_glib_dispatch_age_us 0
    set max_fd3_ready_glib_other_age_us 0
    set qt_bridge_enter_count 0
    set qt_bridge_exit_count 0
    set qt_bridge_process_events_enter_count 0
    set qt_bridge_process_events_exit_count 0
    set qt_bridge_glib_iteration_enter_count 0
    set qt_bridge_glib_iteration_exit_count 0
    set max_qt_bridge_ready_to_process_events_us 0
    set max_qt_bridge_ready_to_glib_iteration_us 0
    set max_qt_bridge_process_events_elapsed_us 0
    set max_qt_bridge_glib_iteration_elapsed_us 0
    set qt_bridge_public_wl_delta_max_us 0
    set qt_bridge_wl_fd_syscall_delta_max_us 0
    set qt_bridge_poll_count 0
    set qt_bridge_poll_slow_count 0
    set qt_bridge_poll_fd3_ready_count 0
    set qt_bridge_poll_fd3_ready_during_count 0
    set qt_bridge_poll_install_attempts 0
    set qt_bridge_poll_install_null_context 0
    set qt_bridge_poll_install_missing_get_poll_func 0
    set qt_bridge_poll_install_missing_set_poll_func 0
    set qt_bridge_poll_install_installed 0
    set qt_bridge_poll_install_already_wrapped 0
    set qt_bridge_poll_install_slot_full 0
    set qt_bridge_poll_install_last_context "missing"
    set qt_bridge_poll_max_elapsed_us 0
    set qt_bridge_poll_max_fd3_ready_offset_us 0
    set last_ready_seq "missing"
    set last_ready_revents "missing"
    set last_ready_fionread "missing"
    set output_dropped 0
    set output_limit "missing"

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {![regexp {konsole-qt-event-trace: ([^\r\n]*)} $line -> payload]} {
            continue
        }
        incr trace_count
        if {[regexp {^fd3-ready } $payload]} {
            incr fd3_ready_count
            set last_ready_seq [summary_value $payload "seq" $last_ready_seq]
            set last_ready_revents [summary_value $payload "revents" $last_ready_revents]
            set last_ready_fionread [summary_value $payload "fionread" $last_ready_fionread]
            set span_active [summary_value $payload "main_span_active" 0]
            set span_op [summary_value $payload "main_span_op" "none"]
            set span_age [summary_value $payload "main_span_age_us" 0]
            set span_depth [summary_value $payload "main_span_depth" 0]
            set glib_phase_active [summary_value $payload "main_glib_phase_active" 0]
            set glib_phase [summary_value $payload "main_glib_phase" "none"]
            set glib_phase_age [summary_value $payload "main_glib_phase_age_us" 0]
            if {[string is integer -strict $span_active] && $span_active > 0} {
                incr fd3_ready_in_active_span
                if {$span_op eq "process_events"} {
                    incr fd3_ready_in_process_events
                } elseif {$span_op eq "glib_iteration"} {
                    incr fd3_ready_in_glib_iteration
                } elseif {$span_op eq "send_window_system_events"} {
                    incr fd3_ready_in_send_wse
                }
            }
            if {[string is integer -strict $span_age] && $span_age > $max_fd3_ready_span_age_us} {
                set max_fd3_ready_span_age_us $span_age
            }
            if {[string is integer -strict $span_depth] && $span_depth > $max_fd3_ready_span_depth} {
                set max_fd3_ready_span_depth $span_depth
            }
            if {[string is integer -strict $glib_phase_active] && $glib_phase_active > 0} {
                if {$glib_phase eq "poll"} {
                    incr fd3_ready_in_glib_poll
                    if {[string is integer -strict $glib_phase_age] && $glib_phase_age > $max_fd3_ready_glib_poll_age_us} {
                        set max_fd3_ready_glib_poll_age_us $glib_phase_age
                    }
                } elseif {$glib_phase eq "dispatch"} {
                    incr fd3_ready_in_glib_dispatch
                    if {[string is integer -strict $glib_phase_age] && $glib_phase_age > $max_fd3_ready_glib_dispatch_age_us} {
                        set max_fd3_ready_glib_dispatch_age_us $glib_phase_age
                    }
                } else {
                    incr fd3_ready_in_glib_other_phase
                    if {[string is integer -strict $glib_phase_age] && $glib_phase_age > $max_fd3_ready_glib_other_age_us} {
                        set max_fd3_ready_glib_other_age_us $glib_phase_age
                    }
                }
            } elseif {$span_op eq "glib_iteration" &&
                      [string is integer -strict $span_active] && $span_active > 0} {
                incr fd3_ready_in_glib_other_phase
                if {[string is integer -strict $span_age] && $span_age > $max_fd3_ready_glib_other_age_us} {
                    set max_fd3_ready_glib_other_age_us $span_age
                }
            }
        } elseif {[regexp {^glib } $payload]} {
            incr glib_count
            set ready_gap [summary_value $payload "ready_to_call_us" 0]
            set elapsed [summary_value $payload "elapsed_us" 0]
            set ready_during [summary_value $payload "fd3_ready_during_span" 0]
            set ready_offset [summary_value $payload "fd3_ready_offset_us" 0]
            if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_call_us} {
                set max_ready_to_call_us $ready_gap
            }
            if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_glib_us} {
                set max_ready_to_glib_us $ready_gap
            }
            if {[summary_value $payload "op" "missing"] eq "iteration" &&
                [string is integer -strict $elapsed] && $elapsed > $max_glib_iteration_us} {
                set max_glib_iteration_us $elapsed
            }
            if {[string is integer -strict $ready_during] && $ready_during > 0} {
                incr span_ready_during_calls
            }
            if {[string is integer -strict $ready_offset] && $ready_offset > $max_span_ready_offset_us} {
                set max_span_ready_offset_us $ready_offset
            }
        } elseif {[regexp {^glib-phase } $payload]} {
            incr glib_phase_count
            set op [summary_value $payload "op" "missing"]
            set ready_gap [summary_value $payload "ready_to_call_us" 0]
            set elapsed [summary_value $payload "elapsed_us" 0]
            set total [summary_value $payload "total_us" 0]
            set ready_during [summary_value $payload "fd3_ready_during_phase" 0]
            set ready_offset [summary_value $payload "fd3_ready_offset_us" 0]
            if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_call_us} {
                set max_ready_to_call_us $ready_gap
            }
            if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_glib_us} {
                set max_ready_to_glib_us $ready_gap
            }
            if {[string is integer -strict $ready_during] && $ready_during > 0} {
                incr span_ready_during_calls
            }
            if {[string is integer -strict $ready_offset] && $ready_offset > $max_span_ready_offset_us} {
                set max_span_ready_offset_us $ready_offset
            }
            if {$op eq "prepare"} {
                incr glib_prepare_calls
                if {[string is integer -strict $elapsed] && $elapsed > $max_glib_prepare_us} {
                    set max_glib_prepare_us $elapsed
                }
            } elseif {$op eq "query"} {
                incr glib_query_calls
                if {[string is integer -strict $elapsed] && $elapsed > $max_glib_query_us} {
                    set max_glib_query_us $elapsed
                }
            } elseif {$op eq "check"} {
                incr glib_check_calls
                if {[string is integer -strict $elapsed] && $elapsed > $max_glib_check_us} {
                    set max_glib_check_us $elapsed
                }
            } elseif {$op eq "dispatch"} {
                incr glib_dispatch_calls
                if {[string is integer -strict $elapsed] && $elapsed > $max_glib_dispatch_us} {
                    set max_glib_dispatch_us $elapsed
                }
                if {[string is integer -strict $total] && $total > $glib_dispatch_total_us} {
                    set glib_dispatch_total_us $total
                }
            } elseif {$op eq "poll"} {
                incr glib_poll_calls
                if {[string is integer -strict $elapsed] && $elapsed > $max_glib_poll_us} {
                    set max_glib_poll_us $elapsed
                }
                if {[string is integer -strict $total] && $total > $glib_poll_total_us} {
                    set glib_poll_total_us $total
                }
            }
        } elseif {[regexp {^bridge-enter } $payload]} {
            incr qt_bridge_enter_count
            set op [summary_value $payload "op" "missing"]
            set ready_gap [summary_value $payload "ready_to_call_us" 0]
            if {$op eq "process_events"} {
                incr qt_bridge_process_events_enter_count
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_qt_bridge_ready_to_process_events_us} {
                    set max_qt_bridge_ready_to_process_events_us $ready_gap
                }
            } elseif {$op eq "glib_iteration"} {
                incr qt_bridge_glib_iteration_enter_count
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_qt_bridge_ready_to_glib_iteration_us} {
                    set max_qt_bridge_ready_to_glib_iteration_us $ready_gap
                }
            }
        } elseif {[regexp {^bridge-exit } $payload]} {
            incr qt_bridge_exit_count
            set op [summary_value $payload "op" "missing"]
            set ready_gap [summary_value $payload "ready_to_call_us" 0]
            set elapsed [summary_value $payload "elapsed_us" 0]
            set public_delta [summary_value $payload "public_wl_delta_us" 0]
            set wl_fd_delta [summary_value $payload "wl_fd_syscall_delta_us" 0]
            set ready_during [summary_value $payload "fd3_ready_during_span" 0]
            set ready_offset [summary_value $payload "fd3_ready_offset_us" 0]
            if {[string is integer -strict $public_delta] && $public_delta > $qt_bridge_public_wl_delta_max_us} {
                set qt_bridge_public_wl_delta_max_us $public_delta
            }
            if {[string is integer -strict $wl_fd_delta] && $wl_fd_delta > $qt_bridge_wl_fd_syscall_delta_max_us} {
                set qt_bridge_wl_fd_syscall_delta_max_us $wl_fd_delta
            }
            if {[string is integer -strict $ready_during] && $ready_during > 0} {
                incr span_ready_during_calls
            }
            if {[string is integer -strict $ready_offset] && $ready_offset > $max_span_ready_offset_us} {
                set max_span_ready_offset_us $ready_offset
            }
            if {$op eq "process_events"} {
                incr qt_bridge_process_events_exit_count
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_qt_bridge_ready_to_process_events_us} {
                    set max_qt_bridge_ready_to_process_events_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_qt_bridge_process_events_elapsed_us} {
                    set max_qt_bridge_process_events_elapsed_us $elapsed
                }
            } elseif {$op eq "glib_iteration"} {
                incr qt_bridge_glib_iteration_exit_count
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_qt_bridge_ready_to_glib_iteration_us} {
                    set max_qt_bridge_ready_to_glib_iteration_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_qt_bridge_glib_iteration_elapsed_us} {
                    set max_qt_bridge_glib_iteration_elapsed_us $elapsed
                }
            }
        } elseif {[regexp {^bridge-poll } $payload]} {
            incr qt_bridge_poll_count
            set elapsed [summary_value $payload "elapsed_us" 0]
            set ready_during [summary_value $payload "fd3_ready_during_poll" 0]
            set ready_offset [summary_value $payload "fd3_ready_offset_us" 0]
            set fd3_revents_after [summary_value $payload "fd3_revents_after" "0x0"]
            set fd3_fionread_after [summary_value $payload "fd3_fionread_after" 0]
            if {[string is integer -strict $elapsed] && $elapsed > $qt_bridge_poll_max_elapsed_us} {
                set qt_bridge_poll_max_elapsed_us $elapsed
            }
            if {[string is integer -strict $elapsed] && $elapsed >= 20000} {
                incr qt_bridge_poll_slow_count
            }
            if {[string is integer -strict $ready_during] && $ready_during > 0} {
                incr qt_bridge_poll_fd3_ready_during_count
            }
            if {[string is integer -strict $ready_offset] && $ready_offset > $qt_bridge_poll_max_fd3_ready_offset_us} {
                set qt_bridge_poll_max_fd3_ready_offset_us $ready_offset
            }
            if {$fd3_revents_after ne "0x0" ||
                ([string is integer -strict $fd3_fionread_after] && $fd3_fionread_after > 0)} {
                incr qt_bridge_poll_fd3_ready_count
            }
        } elseif {[regexp {^wl-main } $payload]} {
            incr wl_main_count
            set ready_gap [summary_value $payload "ready_to_call_us" 0]
            set elapsed [summary_value $payload "elapsed_us" 0]
            if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_call_us} {
                set max_ready_to_call_us $ready_gap
            }
            if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_wl_us} {
                set max_ready_to_wl_us $ready_gap
            }
            if {[string is integer -strict $elapsed] && $elapsed > $max_wl_main_us} {
                set max_wl_main_us $elapsed
            }
        } elseif {[regexp {^summary } $payload]} {
            incr summary_count
            foreach {key varname} {
                fd3_ready fd3_ready_count
                last_ready_seq last_ready_seq
                last_ready_revents last_ready_revents
                last_ready_fionread last_ready_fionread
                fd3_ready_in_active_span fd3_ready_in_active_span
                fd3_ready_in_process_events fd3_ready_in_process_events
                fd3_ready_in_glib_iteration fd3_ready_in_glib_iteration
                fd3_ready_in_send_wse fd3_ready_in_send_wse
                span_ready_during_calls span_ready_during_calls
                max_fd3_ready_span_age_us max_fd3_ready_span_age_us
                max_fd3_ready_span_depth max_fd3_ready_span_depth
                max_span_ready_offset_us max_span_ready_offset_us
                max_ready_to_call_us max_ready_to_call_us
                max_ready_to_glib_us max_ready_to_glib_us
                max_ready_to_wl_us max_ready_to_wl_us
                max_glib_iteration_us max_glib_iteration_us
                glib_phase_calls glib_phase_calls
                glib_prepare_calls glib_prepare_calls
                glib_query_calls glib_query_calls
                glib_check_calls glib_check_calls
                glib_dispatch_calls glib_dispatch_calls
                glib_poll_calls glib_poll_calls
                glib_poll_total_us glib_poll_total_us
                glib_dispatch_total_us glib_dispatch_total_us
                max_glib_prepare_us max_glib_prepare_us
                max_glib_query_us max_glib_query_us
                max_glib_check_us max_glib_check_us
                max_glib_dispatch_us max_glib_dispatch_us
                max_glib_poll_us max_glib_poll_us
                fd3_ready_in_glib_poll fd3_ready_in_glib_poll
                fd3_ready_in_glib_dispatch fd3_ready_in_glib_dispatch
                fd3_ready_in_glib_other_phase fd3_ready_in_glib_other_phase
                max_fd3_ready_glib_poll_age_us max_fd3_ready_glib_poll_age_us
                max_fd3_ready_glib_dispatch_age_us max_fd3_ready_glib_dispatch_age_us
                max_fd3_ready_glib_other_age_us max_fd3_ready_glib_other_age_us
                qt_bridge_enter_count qt_bridge_enter_count
                qt_bridge_exit_count qt_bridge_exit_count
                qt_bridge_process_events_enter_count qt_bridge_process_events_enter_count
                qt_bridge_process_events_exit_count qt_bridge_process_events_exit_count
                qt_bridge_glib_iteration_enter_count qt_bridge_glib_iteration_enter_count
                qt_bridge_glib_iteration_exit_count qt_bridge_glib_iteration_exit_count
                max_qt_bridge_ready_to_process_events_us max_qt_bridge_ready_to_process_events_us
                max_qt_bridge_ready_to_glib_iteration_us max_qt_bridge_ready_to_glib_iteration_us
                max_qt_bridge_process_events_elapsed_us max_qt_bridge_process_events_elapsed_us
                max_qt_bridge_glib_iteration_elapsed_us max_qt_bridge_glib_iteration_elapsed_us
                qt_bridge_public_wl_delta_max_us qt_bridge_public_wl_delta_max_us
                qt_bridge_wl_fd_syscall_delta_max_us qt_bridge_wl_fd_syscall_delta_max_us
                qt_bridge_poll_calls qt_bridge_poll_count
                qt_bridge_poll_slow qt_bridge_poll_slow_count
                qt_bridge_poll_fd3_ready qt_bridge_poll_fd3_ready_count
                qt_bridge_poll_fd3_ready_during qt_bridge_poll_fd3_ready_during_count
                qt_bridge_poll_install_attempts qt_bridge_poll_install_attempts
                qt_bridge_poll_install_null_context qt_bridge_poll_install_null_context
                qt_bridge_poll_install_missing_get_poll_func qt_bridge_poll_install_missing_get_poll_func
                qt_bridge_poll_install_missing_set_poll_func qt_bridge_poll_install_missing_set_poll_func
                qt_bridge_poll_install_installed qt_bridge_poll_install_installed
                qt_bridge_poll_install_already_wrapped qt_bridge_poll_install_already_wrapped
                qt_bridge_poll_install_slot_full qt_bridge_poll_install_slot_full
                qt_bridge_poll_install_last_context qt_bridge_poll_install_last_context
                qt_bridge_poll_max_elapsed_us qt_bridge_poll_max_elapsed_us
                qt_bridge_poll_max_fd3_ready_offset_us qt_bridge_poll_max_fd3_ready_offset_us
                max_wl_main_us max_wl_main_us
                output_dropped output_dropped
                output_limit output_limit
            } {
                set value [summary_value $payload $key "missing"]
                if {$value eq "missing"} {
                    continue
                }
                if {[string match "max_*" $key] || $key eq "fd3_ready" ||
                    [string match "fd3_ready_in_*" $key] ||
                    $key eq "span_ready_during_calls" ||
                    $key eq "output_dropped"} {
                    if {[string is integer -strict $value] && $value > [set $varname]} {
                        set $varname $value
                    }
                } else {
                    set $varname $value
                }
            }
        }
    }

    set available [expr {$trace_count > 0 ? 1 : 0}]
    if {$glib_phase_calls == 0 && $glib_phase_count > 0} {
        set glib_phase_calls $glib_phase_count
    }
    set max_ready_to_call_ms [expr {$max_ready_to_call_us / 1000}]
    set max_ready_to_glib_ms [expr {$max_ready_to_glib_us / 1000}]
    set max_ready_to_wl_ms [expr {$max_ready_to_wl_us / 1000}]
    set max_glib_iteration_ms [expr {$max_glib_iteration_us / 1000}]
    set glib_poll_total_ms [expr {$glib_poll_total_us / 1000}]
    set glib_dispatch_total_ms [expr {$glib_dispatch_total_us / 1000}]
    set max_glib_prepare_ms [expr {$max_glib_prepare_us / 1000}]
    set max_glib_query_ms [expr {$max_glib_query_us / 1000}]
    set max_glib_check_ms [expr {$max_glib_check_us / 1000}]
    set max_glib_dispatch_ms [expr {$max_glib_dispatch_us / 1000}]
    set max_glib_poll_ms [expr {$max_glib_poll_us / 1000}]
    set max_wl_main_ms [expr {$max_wl_main_us / 1000}]
    set max_fd3_ready_span_age_ms [expr {$max_fd3_ready_span_age_us / 1000}]
    set max_span_ready_offset_ms [expr {$max_span_ready_offset_us / 1000}]
    set max_fd3_ready_glib_poll_age_ms [expr {$max_fd3_ready_glib_poll_age_us / 1000}]
    set max_fd3_ready_glib_dispatch_age_ms [expr {$max_fd3_ready_glib_dispatch_age_us / 1000}]
    set max_fd3_ready_glib_other_age_ms [expr {$max_fd3_ready_glib_other_age_us / 1000}]
    set max_qt_bridge_ready_to_process_events_ms [expr {$max_qt_bridge_ready_to_process_events_us / 1000}]
    set max_qt_bridge_ready_to_glib_iteration_ms [expr {$max_qt_bridge_ready_to_glib_iteration_us / 1000}]
    set max_qt_bridge_process_events_elapsed_ms [expr {$max_qt_bridge_process_events_elapsed_us / 1000}]
    set max_qt_bridge_glib_iteration_elapsed_ms [expr {$max_qt_bridge_glib_iteration_elapsed_us / 1000}]
    set qt_bridge_poll_max_elapsed_ms [expr {$qt_bridge_poll_max_elapsed_us / 1000}]
    set qt_bridge_poll_max_fd3_ready_offset_ms [expr {$qt_bridge_poll_max_fd3_ready_offset_us / 1000}]
    set qt_bridge_missing_exit_count 0
    if {$qt_bridge_enter_count > $qt_bridge_exit_count} {
        set qt_bridge_missing_exit_count [expr {$qt_bridge_enter_count - $qt_bridge_exit_count}]
    }
    set qt_bridge_poll_install_summary_available [expr {$summary_count > 0 ? 1 : 0}]
    set branch_hint "missing"
    if {$available} {
        if {$output_dropped > 0} {
            set branch_hint "trace_output_dropped"
        } elseif {!$qt_bridge_poll_install_summary_available &&
                  $qt_bridge_poll_count > 0} {
            set branch_hint "bridge-poll-summary-missing"
        } elseif {$qt_bridge_poll_install_summary_available &&
                  ($qt_bridge_poll_install_missing_get_poll_func > 0 ||
                   $qt_bridge_poll_install_missing_set_poll_func > 0)} {
            set branch_hint "bridge-poll-not-installable"
        } elseif {$qt_bridge_poll_install_summary_available &&
                  $qt_bridge_poll_install_attempts > 0 &&
                  $qt_bridge_poll_install_installed == 0 &&
                  $qt_bridge_poll_install_already_wrapped == 0 &&
                  $qt_bridge_poll_install_null_context > 0} {
            set branch_hint "bridge-poll-null-context-only"
        } elseif {$qt_bridge_poll_install_summary_available &&
                  ($qt_bridge_poll_install_installed > 0 ||
                   $qt_bridge_poll_install_already_wrapped > 0) &&
                  $qt_bridge_poll_count == 0} {
            set branch_hint "bridge-poll-installed-no-poll"
        } elseif {$qt_bridge_poll_fd3_ready_during_count > 0 ||
                  $qt_bridge_poll_max_elapsed_ms >= 150} {
            set branch_hint "glib-poll-candidate"
        } elseif {$max_qt_bridge_ready_to_process_events_ms >= 150 ||
                  $max_qt_bridge_ready_to_glib_iteration_ms >= 150} {
            set branch_hint "bridge-enter-gap"
        } elseif {$qt_bridge_exit_count > 0 &&
                  $max_qt_bridge_process_events_elapsed_ms < 150 &&
                  $max_qt_bridge_glib_iteration_elapsed_ms < 150} {
            set branch_hint "bridge-short-move-to-dispatch-phase"
        } elseif {$fd3_ready_count == 0} {
            set branch_hint "no_fd3_ready_samples"
        } elseif {$fd3_ready_in_glib_poll > 0} {
            set branch_hint "readiness_during_glib_poll"
        } elseif {$fd3_ready_in_glib_dispatch > 0} {
            set branch_hint "readiness_during_glib_dispatch"
        } elseif {$fd3_ready_in_glib_other_phase > 0} {
            set branch_hint "readiness_during_glib_other_phase"
        } elseif {$fd3_ready_in_glib_iteration > 0} {
            set branch_hint "readiness_during_glib_iteration"
        } elseif {$fd3_ready_in_process_events > 0} {
            set branch_hint "readiness_during_process_events"
        } elseif {$fd3_ready_in_send_wse > 0} {
            set branch_hint "readiness_during_send_wse"
        } elseif {$max_ready_to_glib_ms >= 150 || $max_ready_to_wl_ms >= 150} {
            set branch_hint "qt_dispatcher_post_readiness_gap_candidate"
        } elseif {$max_glib_iteration_ms >= 150} {
            set branch_hint "glib_iteration_elapsed_candidate"
        } elseif {$max_glib_poll_ms >= 150} {
            set branch_hint "glib_poll_gap_candidate"
        } elseif {$max_glib_dispatch_ms >= 150} {
            set branch_hint "glib_dispatch_gap_candidate"
        } elseif {$max_wl_main_ms >= 150} {
            set branch_hint "libwayland_main_elapsed_candidate"
        } elseif {$glib_phase_calls > 0} {
            set branch_hint "glib_phase_short_move_to_qsocketnotifier"
        } else {
            set branch_hint "no_ge_150ms_qt_event_gap"
        }
    }
    if {!$qt_bridge_poll_install_summary_available} {
        foreach varname {
            qt_bridge_poll_install_attempts
            qt_bridge_poll_install_null_context
            qt_bridge_poll_install_missing_get_poll_func
            qt_bridge_poll_install_missing_set_poll_func
            qt_bridge_poll_install_installed
            qt_bridge_poll_install_already_wrapped
            qt_bridge_poll_install_slot_full
        } {
            set $varname "missing"
        }
        set qt_bridge_poll_install_last_context "missing"
    }

    return "available=$available trace_count=$trace_count fd3_ready_count=$fd3_ready_count glib_count=$glib_count glib_phase_count=$glib_phase_count wl_main_count=$wl_main_count summary_count=$summary_count fd3_ready_in_active_span=$fd3_ready_in_active_span fd3_ready_in_process_events=$fd3_ready_in_process_events fd3_ready_in_glib_iteration=$fd3_ready_in_glib_iteration fd3_ready_in_send_wse=$fd3_ready_in_send_wse fd3_ready_in_glib_poll=$fd3_ready_in_glib_poll fd3_ready_in_glib_dispatch=$fd3_ready_in_glib_dispatch fd3_ready_in_glib_other_phase=$fd3_ready_in_glib_other_phase span_ready_during_calls=$span_ready_during_calls max_fd3_ready_span_age_ms=$max_fd3_ready_span_age_ms max_fd3_ready_span_depth=$max_fd3_ready_span_depth max_span_ready_offset_ms=$max_span_ready_offset_ms max_fd3_ready_glib_poll_age_ms=$max_fd3_ready_glib_poll_age_ms max_fd3_ready_glib_dispatch_age_ms=$max_fd3_ready_glib_dispatch_age_ms max_fd3_ready_glib_other_age_ms=$max_fd3_ready_glib_other_age_ms qt_bridge_enter_count=$qt_bridge_enter_count qt_bridge_exit_count=$qt_bridge_exit_count qt_bridge_process_events_enter_count=$qt_bridge_process_events_enter_count qt_bridge_glib_iteration_enter_count=$qt_bridge_glib_iteration_enter_count max_qt_bridge_ready_to_process_events_ms=$max_qt_bridge_ready_to_process_events_ms max_qt_bridge_ready_to_glib_iteration_ms=$max_qt_bridge_ready_to_glib_iteration_ms max_qt_bridge_process_events_elapsed_ms=$max_qt_bridge_process_events_elapsed_ms max_qt_bridge_glib_iteration_elapsed_ms=$max_qt_bridge_glib_iteration_elapsed_ms qt_bridge_missing_exit_count=$qt_bridge_missing_exit_count qt_bridge_public_wl_delta_max=$qt_bridge_public_wl_delta_max_us qt_bridge_wl_fd_syscall_delta_max=$qt_bridge_wl_fd_syscall_delta_max_us qt_bridge_poll_count=$qt_bridge_poll_count qt_bridge_poll_slow_count=$qt_bridge_poll_slow_count qt_bridge_poll_fd3_ready_count=$qt_bridge_poll_fd3_ready_count qt_bridge_poll_fd3_ready_during_count=$qt_bridge_poll_fd3_ready_during_count qt_bridge_poll_install_attempts=$qt_bridge_poll_install_attempts qt_bridge_poll_install_null_context=$qt_bridge_poll_install_null_context qt_bridge_poll_install_missing_get_poll_func=$qt_bridge_poll_install_missing_get_poll_func qt_bridge_poll_install_missing_set_poll_func=$qt_bridge_poll_install_missing_set_poll_func qt_bridge_poll_install_installed=$qt_bridge_poll_install_installed qt_bridge_poll_install_already_wrapped=$qt_bridge_poll_install_already_wrapped qt_bridge_poll_install_slot_full=$qt_bridge_poll_install_slot_full qt_bridge_poll_install_last_context=$qt_bridge_poll_install_last_context qt_bridge_poll_max_elapsed_ms=$qt_bridge_poll_max_elapsed_ms qt_bridge_poll_max_fd3_ready_offset_ms=$qt_bridge_poll_max_fd3_ready_offset_ms max_ready_to_call_ms=$max_ready_to_call_ms max_ready_to_glib_ms=$max_ready_to_glib_ms max_ready_to_wl_ms=$max_ready_to_wl_ms max_glib_iteration_ms=$max_glib_iteration_ms glib_phase_calls=$glib_phase_calls glib_prepare_calls=$glib_prepare_calls glib_query_calls=$glib_query_calls glib_check_calls=$glib_check_calls glib_dispatch_calls=$glib_dispatch_calls glib_poll_calls=$glib_poll_calls glib_poll_total_ms=$glib_poll_total_ms glib_dispatch_total_ms=$glib_dispatch_total_ms max_glib_prepare_ms=$max_glib_prepare_ms max_glib_query_ms=$max_glib_query_ms max_glib_check_ms=$max_glib_check_ms max_glib_dispatch_ms=$max_glib_dispatch_ms max_glib_poll_ms=$max_glib_poll_ms max_wl_main_ms=$max_wl_main_ms last_ready_seq=$last_ready_seq last_ready_revents=$last_ready_revents last_ready_fionread=$last_ready_fionread output_dropped=$output_dropped output_limit=$output_limit branch_hint=$branch_hint"
}

proc konsole_qt_cpp_trace_summary {text} {
    set trace_count 0
    set fd3_ready_count 0
    set call_count 0
    set summary_count 0
    set total_calls 0
    set process_events_calls 0
    set send_wse_calls 0
    set flush_wse_calls 0
    set core_send_posted_calls 0
    set private_send_posted_calls 0
    set notify_internal2_calls 0
    set qsocketnotifier_event_calls 0
    set qwayland_handle_sync_calls 0
    set qwayland_request_sync_calls 0
    set qwayland_blocking_read_calls 0
    set qwayland_flush_requests_calls 0
    set raw_total_calls 0
    set raw_process_events_calls 0
    set raw_send_wse_calls 0
    set raw_flush_wse_calls 0
    set raw_core_send_posted_calls 0
    set raw_private_send_posted_calls 0
    set raw_notify_internal2_calls 0
    set raw_qsocketnotifier_event_calls 0
    set raw_qwayland_handle_sync_calls 0
    set raw_qwayland_request_sync_calls 0
    set raw_qwayland_blocking_read_calls 0
    set raw_qwayland_flush_requests_calls 0
    set qtwayland_public_calls 0
    set public_wl_event_thread_calls 0
    set public_wl_main_thread_calls 0
    set wl_connect_calls 0
    set wl_connect_to_fd_calls 0
    set wl_get_fd_calls 0
    set wl_prepare_read_calls 0
    set wl_prepare_read_queue_calls 0
    set wl_cancel_read_calls 0
    set wl_read_events_calls 0
    set wl_dispatch_calls 0
    set wl_dispatch_pending_calls 0
    set wl_dispatch_queue_pending_calls 0
    set wl_flush_calls 0
    set wl_roundtrip_calls 0
    set wl_roundtrip_queue_calls 0
    set wl_fd_syscall_calls 0
    set wl_fd_poll_calls 0
    set wl_fd_ppoll_calls 0
    set wl_fd_read_calls 0
    set wl_fd_write_calls 0
    set wl_fd_recvmsg_calls 0
    set wl_fd_sendmsg_calls 0
    set raw_qtwayland_public_calls 0
    set raw_public_wl_event_thread_calls 0
    set raw_public_wl_main_thread_calls 0
    set raw_wl_connect_calls 0
    set raw_wl_connect_to_fd_calls 0
    set raw_wl_get_fd_calls 0
    set raw_wl_prepare_read_calls 0
    set raw_wl_prepare_read_queue_calls 0
    set raw_wl_cancel_read_calls 0
    set raw_wl_read_events_calls 0
    set raw_wl_dispatch_calls 0
    set raw_wl_dispatch_pending_calls 0
    set raw_wl_dispatch_queue_pending_calls 0
    set raw_wl_flush_calls 0
    set raw_wl_roundtrip_calls 0
    set raw_wl_roundtrip_queue_calls 0
    set raw_wl_fd_syscall_calls 0
    set raw_wl_fd_poll_calls 0
    set raw_wl_fd_ppoll_calls 0
    set raw_wl_fd_read_calls 0
    set raw_wl_fd_write_calls 0
    set raw_wl_fd_recvmsg_calls 0
    set raw_wl_fd_sendmsg_calls 0
    set max_ready_to_call_us 0
    set max_ready_to_process_events_us 0
    set max_ready_to_send_wse_us 0
    set max_ready_to_flush_wse_us 0
    set max_ready_to_core_send_posted_us 0
    set max_ready_to_private_send_posted_us 0
    set max_ready_to_notify_internal2_us 0
    set max_ready_to_qsocketnotifier_event_us 0
    set max_ready_to_qwayland_handle_sync_us 0
    set max_ready_to_qwayland_request_sync_us 0
    set max_ready_to_qwayland_blocking_read_us 0
    set max_ready_to_qwayland_flush_requests_us 0
    set max_process_events_us 0
    set max_send_wse_us 0
    set max_flush_wse_us 0
    set max_core_send_posted_us 0
    set max_private_send_posted_us 0
    set max_notify_internal2_us 0
    set max_qsocketnotifier_event_us 0
    set max_qwayland_handle_sync_us 0
    set max_qwayland_request_sync_us 0
    set max_qwayland_blocking_read_us 0
    set max_qwayland_flush_requests_us 0
    set max_public_wl_elapsed_us 0
    set max_public_wl_ready_to_call_us 0
    set max_wl_fd_syscall_elapsed_us 0
    set max_wl_fd_syscall_ready_to_call_us 0
    set fd3_ready_in_active_span 0
    set fd3_ready_in_process_events 0
    set fd3_ready_in_glib_iteration 0
    set fd3_ready_in_send_wse 0
    set span_ready_during_calls 0
    set max_fd3_ready_span_age_us 0
    set max_fd3_ready_span_depth 0
    set max_span_ready_offset_us 0
    set output_dropped 0
    set output_limit "missing"

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {![regexp {konsole-qt-cpp-trace: ([^\r\n]*)} $line -> payload]} {
            continue
        }
        incr trace_count
        if {[regexp {^fd3-ready } $payload]} {
            incr fd3_ready_count
            set span_active [summary_value $payload "main_span_active" 0]
            set span_op [summary_value $payload "main_span_op" "none"]
            set span_age [summary_value $payload "main_span_age_us" 0]
            set span_depth [summary_value $payload "main_span_depth" 0]
            if {[string is integer -strict $span_active] && $span_active > 0} {
                incr fd3_ready_in_active_span
                if {$span_op eq "process_events"} {
                    incr fd3_ready_in_process_events
                } elseif {$span_op eq "glib_iteration"} {
                    incr fd3_ready_in_glib_iteration
                } elseif {$span_op eq "send_window_system_events"} {
                    incr fd3_ready_in_send_wse
                }
            }
            if {[string is integer -strict $span_age] && $span_age > $max_fd3_ready_span_age_us} {
                set max_fd3_ready_span_age_us $span_age
            }
            if {[string is integer -strict $span_depth] && $span_depth > $max_fd3_ready_span_depth} {
                set max_fd3_ready_span_depth $span_depth
            }
        } elseif {[regexp {^call } $payload]} {
            incr call_count
            incr raw_total_calls
            set op [summary_value $payload "op" "missing"]
            set ready_gap [summary_value $payload "ready_to_call_us" 0]
            set elapsed [summary_value $payload "elapsed_us" 0]
            set ready_during [summary_value $payload "fd3_ready_during_span" 0]
            set ready_offset [summary_value $payload "fd3_ready_offset_us" 0]
            if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_call_us} {
                set max_ready_to_call_us $ready_gap
            }
            if {[string is integer -strict $ready_during] && $ready_during > 0} {
                incr span_ready_during_calls
            }
            if {[string is integer -strict $ready_offset] && $ready_offset > $max_span_ready_offset_us} {
                set max_span_ready_offset_us $ready_offset
            }
            if {$op eq "process_events"} {
                incr raw_process_events_calls
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_process_events_us} {
                    set max_ready_to_process_events_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_process_events_us} {
                    set max_process_events_us $elapsed
                }
            } elseif {$op eq "send_window_system_events"} {
                incr raw_send_wse_calls
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_send_wse_us} {
                    set max_ready_to_send_wse_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_send_wse_us} {
                    set max_send_wse_us $elapsed
                }
            } elseif {$op eq "flush_window_system_events"} {
                incr raw_flush_wse_calls
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_flush_wse_us} {
                    set max_ready_to_flush_wse_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_flush_wse_us} {
                    set max_flush_wse_us $elapsed
                }
            } elseif {$op eq "core_send_posted_events"} {
                incr raw_core_send_posted_calls
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_core_send_posted_us} {
                    set max_ready_to_core_send_posted_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_core_send_posted_us} {
                    set max_core_send_posted_us $elapsed
                }
            } elseif {$op eq "private_send_posted_events"} {
                incr raw_private_send_posted_calls
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_private_send_posted_us} {
                    set max_ready_to_private_send_posted_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_private_send_posted_us} {
                    set max_private_send_posted_us $elapsed
                }
            } elseif {$op eq "notify_internal2"} {
                incr raw_notify_internal2_calls
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_notify_internal2_us} {
                    set max_ready_to_notify_internal2_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_notify_internal2_us} {
                    set max_notify_internal2_us $elapsed
                }
            } elseif {$op eq "qsocketnotifier_event"} {
                incr raw_qsocketnotifier_event_calls
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_qsocketnotifier_event_us} {
                    set max_ready_to_qsocketnotifier_event_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_qsocketnotifier_event_us} {
                    set max_qsocketnotifier_event_us $elapsed
                }
            } elseif {$op eq "qwayland_handle_sync"} {
                incr raw_qwayland_handle_sync_calls
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_qwayland_handle_sync_us} {
                    set max_ready_to_qwayland_handle_sync_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_qwayland_handle_sync_us} {
                    set max_qwayland_handle_sync_us $elapsed
                }
            } elseif {$op eq "qwayland_request_sync"} {
                incr raw_qwayland_request_sync_calls
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_qwayland_request_sync_us} {
                    set max_ready_to_qwayland_request_sync_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_qwayland_request_sync_us} {
                    set max_qwayland_request_sync_us $elapsed
                }
            } elseif {$op eq "qwayland_blocking_read"} {
                incr raw_qwayland_blocking_read_calls
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_qwayland_blocking_read_us} {
                    set max_ready_to_qwayland_blocking_read_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_qwayland_blocking_read_us} {
                    set max_qwayland_blocking_read_us $elapsed
                }
            } elseif {$op eq "qwayland_flush_requests"} {
                incr raw_qwayland_flush_requests_calls
                if {[string is integer -strict $ready_gap] && $ready_gap > $max_ready_to_qwayland_flush_requests_us} {
                    set max_ready_to_qwayland_flush_requests_us $ready_gap
                }
                if {[string is integer -strict $elapsed] && $elapsed > $max_qwayland_flush_requests_us} {
                    set max_qwayland_flush_requests_us $elapsed
                }
            }
        } elseif {[regexp {^public-wl } $payload]} {
            incr raw_qtwayland_public_calls
            set op [summary_value $payload "op" "missing"]
            set comm [summary_value $payload "comm" ""]
            set ready_gap [summary_value $payload "ready_to_call_us" 0]
            set elapsed [summary_value $payload "elapsed_us" 0]
            if {[string match "*WaylandEventThr*" $comm]} {
                incr raw_public_wl_event_thread_calls
            }
            if {[string match -nocase "*konsole*" $comm]} {
                incr raw_public_wl_main_thread_calls
            }
            if {[string is integer -strict $ready_gap] && $ready_gap > $max_public_wl_ready_to_call_us} {
                set max_public_wl_ready_to_call_us $ready_gap
            }
            if {[string is integer -strict $elapsed] && $elapsed > $max_public_wl_elapsed_us} {
                set max_public_wl_elapsed_us $elapsed
            }
            switch -- $op {
                connect { incr raw_wl_connect_calls }
                connect_to_fd { incr raw_wl_connect_to_fd_calls }
                get_fd { incr raw_wl_get_fd_calls }
                prepare_read { incr raw_wl_prepare_read_calls }
                prepare_read_queue { incr raw_wl_prepare_read_queue_calls }
                cancel_read { incr raw_wl_cancel_read_calls }
                read_events { incr raw_wl_read_events_calls }
                dispatch { incr raw_wl_dispatch_calls }
                dispatch_pending { incr raw_wl_dispatch_pending_calls }
                dispatch_queue_pending { incr raw_wl_dispatch_queue_pending_calls }
                flush { incr raw_wl_flush_calls }
                roundtrip { incr raw_wl_roundtrip_calls }
                roundtrip_queue { incr raw_wl_roundtrip_queue_calls }
            }
        } elseif {[regexp {^wl-fd-syscall } $payload]} {
            incr raw_wl_fd_syscall_calls
            set op [summary_value $payload "op" "missing"]
            set ready_gap [summary_value $payload "ready_to_call_us" 0]
            set elapsed [summary_value $payload "elapsed_us" 0]
            if {[string is integer -strict $ready_gap] && $ready_gap > $max_wl_fd_syscall_ready_to_call_us} {
                set max_wl_fd_syscall_ready_to_call_us $ready_gap
            }
            if {[string is integer -strict $elapsed] && $elapsed > $max_wl_fd_syscall_elapsed_us} {
                set max_wl_fd_syscall_elapsed_us $elapsed
            }
            switch -- $op {
                poll { incr raw_wl_fd_poll_calls }
                ppoll { incr raw_wl_fd_ppoll_calls }
                read { incr raw_wl_fd_read_calls }
                write { incr raw_wl_fd_write_calls }
                recvmsg { incr raw_wl_fd_recvmsg_calls }
                sendmsg { incr raw_wl_fd_sendmsg_calls }
            }
        } elseif {[regexp {^summary } $payload]} {
            incr summary_count
            foreach {key varname} {
                fd3_ready fd3_ready_count
                total_calls total_calls
                process_events_calls process_events_calls
                send_wse_calls send_wse_calls
                flush_wse_calls flush_wse_calls
                core_send_posted_calls core_send_posted_calls
                private_send_posted_calls private_send_posted_calls
                notify_internal2_calls notify_internal2_calls
                qsocketnotifier_event_calls qsocketnotifier_event_calls
                qwayland_handle_sync_calls qwayland_handle_sync_calls
                qwayland_request_sync_calls qwayland_request_sync_calls
                qwayland_blocking_read_calls qwayland_blocking_read_calls
                qwayland_flush_requests_calls qwayland_flush_requests_calls
                fd3_ready_in_active_span fd3_ready_in_active_span
                fd3_ready_in_process_events fd3_ready_in_process_events
                fd3_ready_in_glib_iteration fd3_ready_in_glib_iteration
                fd3_ready_in_send_wse fd3_ready_in_send_wse
                span_ready_during_calls span_ready_during_calls
                max_fd3_ready_span_age_us max_fd3_ready_span_age_us
                max_fd3_ready_span_depth max_fd3_ready_span_depth
                max_span_ready_offset_us max_span_ready_offset_us
                max_ready_to_call_us max_ready_to_call_us
                max_ready_to_process_events_us max_ready_to_process_events_us
                max_ready_to_send_wse_us max_ready_to_send_wse_us
                max_ready_to_flush_wse_us max_ready_to_flush_wse_us
                max_ready_to_core_send_posted_us max_ready_to_core_send_posted_us
                max_ready_to_private_send_posted_us max_ready_to_private_send_posted_us
                max_ready_to_notify_internal2_us max_ready_to_notify_internal2_us
                max_ready_to_qsocketnotifier_event_us max_ready_to_qsocketnotifier_event_us
                max_ready_to_qwayland_handle_sync_us max_ready_to_qwayland_handle_sync_us
                max_ready_to_qwayland_request_sync_us max_ready_to_qwayland_request_sync_us
                max_ready_to_qwayland_blocking_read_us max_ready_to_qwayland_blocking_read_us
                max_ready_to_qwayland_flush_requests_us max_ready_to_qwayland_flush_requests_us
                max_process_events_us max_process_events_us
                max_send_wse_us max_send_wse_us
                max_flush_wse_us max_flush_wse_us
                max_core_send_posted_us max_core_send_posted_us
                max_private_send_posted_us max_private_send_posted_us
                max_notify_internal2_us max_notify_internal2_us
                max_qsocketnotifier_event_us max_qsocketnotifier_event_us
                max_qwayland_handle_sync_us max_qwayland_handle_sync_us
                max_qwayland_request_sync_us max_qwayland_request_sync_us
                max_qwayland_blocking_read_us max_qwayland_blocking_read_us
                max_qwayland_flush_requests_us max_qwayland_flush_requests_us
                qtwayland_public_calls qtwayland_public_calls
                public_wl_event_thread_calls public_wl_event_thread_calls
                public_wl_main_thread_calls public_wl_main_thread_calls
                wl_connect_calls wl_connect_calls
                wl_connect_to_fd_calls wl_connect_to_fd_calls
                wl_get_fd_calls wl_get_fd_calls
                wl_prepare_read_calls wl_prepare_read_calls
                wl_prepare_read_queue_calls wl_prepare_read_queue_calls
                wl_cancel_read_calls wl_cancel_read_calls
                wl_read_events_calls wl_read_events_calls
                wl_dispatch_calls wl_dispatch_calls
                wl_dispatch_pending_calls wl_dispatch_pending_calls
                wl_dispatch_queue_pending_calls wl_dispatch_queue_pending_calls
                wl_flush_calls wl_flush_calls
                wl_roundtrip_calls wl_roundtrip_calls
                wl_roundtrip_queue_calls wl_roundtrip_queue_calls
                wl_fd_syscall_calls wl_fd_syscall_calls
                wl_fd_poll_calls wl_fd_poll_calls
                wl_fd_ppoll_calls wl_fd_ppoll_calls
                wl_fd_read_calls wl_fd_read_calls
                wl_fd_write_calls wl_fd_write_calls
                wl_fd_recvmsg_calls wl_fd_recvmsg_calls
                wl_fd_sendmsg_calls wl_fd_sendmsg_calls
                max_public_wl_elapsed_us max_public_wl_elapsed_us
                max_public_wl_ready_to_call_us max_public_wl_ready_to_call_us
                max_wl_fd_syscall_elapsed_us max_wl_fd_syscall_elapsed_us
                max_wl_fd_syscall_ready_to_call_us max_wl_fd_syscall_ready_to_call_us
                output_dropped output_dropped
                output_limit output_limit
            } {
                set value [summary_value $payload $key "missing"]
                if {$value eq "missing"} {
                    continue
                }
                if {[string is integer -strict $value] &&
                    ($key ne "output_limit" || $output_limit eq "missing" || $value > $output_limit)} {
                    set $varname $value
                } elseif {$key eq "output_limit"} {
                    set output_limit $value
                }
            }
        }
    }

    set raw_call_fallback_used 0
    foreach {varname raw_value} [list \
        total_calls $raw_total_calls \
        process_events_calls $raw_process_events_calls \
        send_wse_calls $raw_send_wse_calls \
        flush_wse_calls $raw_flush_wse_calls \
        core_send_posted_calls $raw_core_send_posted_calls \
        private_send_posted_calls $raw_private_send_posted_calls \
        notify_internal2_calls $raw_notify_internal2_calls \
        qsocketnotifier_event_calls $raw_qsocketnotifier_event_calls \
        qwayland_handle_sync_calls $raw_qwayland_handle_sync_calls \
        qwayland_request_sync_calls $raw_qwayland_request_sync_calls \
        qwayland_blocking_read_calls $raw_qwayland_blocking_read_calls \
        qwayland_flush_requests_calls $raw_qwayland_flush_requests_calls \
        qtwayland_public_calls $raw_qtwayland_public_calls \
        public_wl_event_thread_calls $raw_public_wl_event_thread_calls \
        public_wl_main_thread_calls $raw_public_wl_main_thread_calls \
        wl_connect_calls $raw_wl_connect_calls \
        wl_connect_to_fd_calls $raw_wl_connect_to_fd_calls \
        wl_get_fd_calls $raw_wl_get_fd_calls \
        wl_prepare_read_calls $raw_wl_prepare_read_calls \
        wl_prepare_read_queue_calls $raw_wl_prepare_read_queue_calls \
        wl_cancel_read_calls $raw_wl_cancel_read_calls \
        wl_read_events_calls $raw_wl_read_events_calls \
        wl_dispatch_calls $raw_wl_dispatch_calls \
        wl_dispatch_pending_calls $raw_wl_dispatch_pending_calls \
        wl_dispatch_queue_pending_calls $raw_wl_dispatch_queue_pending_calls \
        wl_flush_calls $raw_wl_flush_calls \
        wl_roundtrip_calls $raw_wl_roundtrip_calls \
        wl_roundtrip_queue_calls $raw_wl_roundtrip_queue_calls \
        wl_fd_syscall_calls $raw_wl_fd_syscall_calls \
        wl_fd_poll_calls $raw_wl_fd_poll_calls \
        wl_fd_ppoll_calls $raw_wl_fd_ppoll_calls \
        wl_fd_read_calls $raw_wl_fd_read_calls \
        wl_fd_write_calls $raw_wl_fd_write_calls \
        wl_fd_recvmsg_calls $raw_wl_fd_recvmsg_calls \
        wl_fd_sendmsg_calls $raw_wl_fd_sendmsg_calls] {
        if {[set $varname] == 0 && $raw_value > 0} {
            set $varname $raw_value
            set raw_call_fallback_used 1
        }
    }

    set available [expr {$trace_count > 0 ? 1 : 0}]
    set max_ready_to_call_ms [expr {$max_ready_to_call_us / 1000}]
    set max_ready_to_process_events_ms [expr {$max_ready_to_process_events_us / 1000}]
    set max_ready_to_send_wse_ms [expr {$max_ready_to_send_wse_us / 1000}]
    set max_ready_to_flush_wse_ms [expr {$max_ready_to_flush_wse_us / 1000}]
    set max_ready_to_core_send_posted_ms [expr {$max_ready_to_core_send_posted_us / 1000}]
    set max_ready_to_private_send_posted_ms [expr {$max_ready_to_private_send_posted_us / 1000}]
    set max_ready_to_notify_internal2_ms [expr {$max_ready_to_notify_internal2_us / 1000}]
    set max_ready_to_qsocketnotifier_event_ms [expr {$max_ready_to_qsocketnotifier_event_us / 1000}]
    set max_ready_to_qwayland_handle_sync_ms [expr {$max_ready_to_qwayland_handle_sync_us / 1000}]
    set max_ready_to_qwayland_request_sync_ms [expr {$max_ready_to_qwayland_request_sync_us / 1000}]
    set max_ready_to_qwayland_blocking_read_ms [expr {$max_ready_to_qwayland_blocking_read_us / 1000}]
    set max_ready_to_qwayland_flush_requests_ms [expr {$max_ready_to_qwayland_flush_requests_us / 1000}]
    set max_process_events_ms [expr {$max_process_events_us / 1000}]
    set max_send_wse_ms [expr {$max_send_wse_us / 1000}]
    set max_flush_wse_ms [expr {$max_flush_wse_us / 1000}]
    set max_core_send_posted_ms [expr {$max_core_send_posted_us / 1000}]
    set max_private_send_posted_ms [expr {$max_private_send_posted_us / 1000}]
    set max_notify_internal2_ms [expr {$max_notify_internal2_us / 1000}]
    set max_qsocketnotifier_event_ms [expr {$max_qsocketnotifier_event_us / 1000}]
    set max_qwayland_handle_sync_ms [expr {$max_qwayland_handle_sync_us / 1000}]
    set max_qwayland_request_sync_ms [expr {$max_qwayland_request_sync_us / 1000}]
    set max_qwayland_blocking_read_ms [expr {$max_qwayland_blocking_read_us / 1000}]
    set max_qwayland_flush_requests_ms [expr {$max_qwayland_flush_requests_us / 1000}]
    set max_public_wl_elapsed_ms [expr {$max_public_wl_elapsed_us / 1000}]
    set max_public_wl_ready_to_call_ms [expr {$max_public_wl_ready_to_call_us / 1000}]
    set max_wl_fd_syscall_elapsed_ms [expr {$max_wl_fd_syscall_elapsed_us / 1000}]
    set max_wl_fd_syscall_ready_to_call_ms [expr {$max_wl_fd_syscall_ready_to_call_us / 1000}]
    set max_fd3_ready_span_age_ms [expr {$max_fd3_ready_span_age_us / 1000}]
    set max_span_ready_offset_ms [expr {$max_span_ready_offset_us / 1000}]
    set qt_boundary_calls [expr {$qsocketnotifier_event_calls + $qwayland_handle_sync_calls + $qwayland_request_sync_calls + $qwayland_blocking_read_calls + $qwayland_flush_requests_calls}]
    set max_qwayland_ready_ms $max_ready_to_qwayland_handle_sync_ms
    foreach value [list $max_ready_to_qwayland_request_sync_ms $max_ready_to_qwayland_blocking_read_ms $max_ready_to_qwayland_flush_requests_ms] {
        if {$value > $max_qwayland_ready_ms} {
            set max_qwayland_ready_ms $value
        }
    }
    set max_qwayland_elapsed_ms $max_qwayland_handle_sync_ms
    foreach value [list $max_qwayland_request_sync_ms $max_qwayland_blocking_read_ms $max_qwayland_flush_requests_ms] {
        if {$value > $max_qwayland_elapsed_ms} {
            set max_qwayland_elapsed_ms $value
        }
    }
    set branch_hint "missing"
    if {$available} {
        if {$output_dropped > 0} {
            set branch_hint "trace_output_dropped"
        } elseif {$qt_boundary_calls == 0 && $qtwayland_public_calls > 0} {
            set branch_hint "qwayland_cpp_bypass_public_wl_seen"
        } elseif {$fd3_ready_count == 0} {
            set branch_hint "no_fd3_ready_samples"
        } elseif {$total_calls == 0} {
            set branch_hint "no_qt_cpp_hooks_interposed"
        } elseif {$qt_boundary_calls == 0} {
            set branch_hint "qt_boundary_not_interposed_or_not_called"
        } elseif {$fd3_ready_in_glib_iteration > 0} {
            set branch_hint "readiness_during_glib_iteration"
        } elseif {$fd3_ready_in_process_events > 0} {
            set branch_hint "readiness_during_process_events"
        } elseif {$fd3_ready_in_send_wse > 0} {
            set branch_hint "readiness_during_send_wse"
        } elseif {$raw_call_fallback_used &&
                  ($max_ready_to_process_events_ms >= 150 ||
                   $max_ready_to_send_wse_ms >= 150 ||
                   $max_ready_to_flush_wse_ms >= 150 ||
                   $max_ready_to_core_send_posted_ms >= 150 ||
                   $max_ready_to_private_send_posted_ms >= 150 ||
                   $max_ready_to_notify_internal2_ms >= 150)} {
            set max_wse_ready_ms [expr {$max_ready_to_send_wse_ms > $max_ready_to_flush_wse_ms ? $max_ready_to_send_wse_ms : $max_ready_to_flush_wse_ms}]
            set max_posted_ready_ms $max_ready_to_core_send_posted_ms
            if {$max_ready_to_private_send_posted_ms > $max_posted_ready_ms} {
                set max_posted_ready_ms $max_ready_to_private_send_posted_ms
            }
            if {$max_ready_to_notify_internal2_ms > $max_posted_ready_ms} {
                set max_posted_ready_ms $max_ready_to_notify_internal2_ms
            }
            if {$max_ready_to_process_events_ms >= $max_wse_ready_ms &&
                $max_ready_to_process_events_ms >= $max_posted_ready_ms} {
                set branch_hint "qeventdispatcher_process_events_gap_candidate"
            } elseif {$max_wse_ready_ms >= $max_posted_ready_ms} {
                set branch_hint "qwindowsysteminterface_gap_candidate"
            } else {
                set branch_hint "posted_or_notify_gap_candidate"
            }
        } elseif {$max_ready_to_process_events_ms >= 150} {
            set branch_hint "qeventdispatcher_process_events_gap_candidate"
        } elseif {$max_ready_to_send_wse_ms >= 150 || $max_ready_to_flush_wse_ms >= 150} {
            set branch_hint "qwindowsysteminterface_gap_candidate"
        } elseif {$max_ready_to_core_send_posted_ms >= 150 ||
                  $max_ready_to_private_send_posted_ms >= 150 ||
                  $max_ready_to_notify_internal2_ms >= 150} {
            set branch_hint "posted_or_notify_gap_candidate"
        } elseif {$max_ready_to_qsocketnotifier_event_ms >= 150} {
            set branch_hint "qsocketnotifier_event_gap_candidate"
        } elseif {$max_qwayland_ready_ms >= 150} {
            set branch_hint "qwayland_boundary_gap_candidate"
        } elseif {$max_process_events_ms >= 150} {
            set branch_hint "qeventdispatcher_elapsed_candidate"
        } elseif {$max_send_wse_ms >= 150 || $max_flush_wse_ms >= 150} {
            set branch_hint "qwindowsysteminterface_elapsed_candidate"
        } elseif {$max_qsocketnotifier_event_ms >= 150} {
            set branch_hint "qsocketnotifier_event_elapsed_candidate"
        } elseif {$max_qwayland_elapsed_ms >= 150} {
            set branch_hint "qwayland_boundary_elapsed_candidate"
        } else {
            set branch_hint "no_ge_150ms_qt_cpp_gap"
        }
    }

    return "available=$available trace_count=$trace_count fd3_ready_count=$fd3_ready_count call_count=$call_count summary_count=$summary_count total_calls=$total_calls process_events_calls=$process_events_calls send_wse_calls=$send_wse_calls flush_wse_calls=$flush_wse_calls core_send_posted_calls=$core_send_posted_calls private_send_posted_calls=$private_send_posted_calls notify_internal2_calls=$notify_internal2_calls qsocketnotifier_event_calls=$qsocketnotifier_event_calls qwayland_handle_sync_calls=$qwayland_handle_sync_calls qwayland_request_sync_calls=$qwayland_request_sync_calls qwayland_blocking_read_calls=$qwayland_blocking_read_calls qwayland_flush_requests_calls=$qwayland_flush_requests_calls qt_boundary_calls=$qt_boundary_calls qtwayland_public_calls=$qtwayland_public_calls public_wl_event_thread_calls=$public_wl_event_thread_calls public_wl_main_thread_calls=$public_wl_main_thread_calls wl_connect_calls=$wl_connect_calls wl_connect_to_fd_calls=$wl_connect_to_fd_calls wl_get_fd_calls=$wl_get_fd_calls wl_prepare_read_calls=$wl_prepare_read_calls wl_prepare_read_queue_calls=$wl_prepare_read_queue_calls wl_cancel_read_calls=$wl_cancel_read_calls wl_read_events_calls=$wl_read_events_calls wl_dispatch_calls=$wl_dispatch_calls wl_dispatch_pending_calls=$wl_dispatch_pending_calls wl_dispatch_queue_pending_calls=$wl_dispatch_queue_pending_calls wl_flush_calls=$wl_flush_calls wl_roundtrip_calls=$wl_roundtrip_calls wl_roundtrip_queue_calls=$wl_roundtrip_queue_calls wl_fd_syscall_calls=$wl_fd_syscall_calls wl_fd_poll_calls=$wl_fd_poll_calls wl_fd_ppoll_calls=$wl_fd_ppoll_calls wl_fd_read_calls=$wl_fd_read_calls wl_fd_write_calls=$wl_fd_write_calls wl_fd_recvmsg_calls=$wl_fd_recvmsg_calls wl_fd_sendmsg_calls=$wl_fd_sendmsg_calls fd3_ready_in_active_span=$fd3_ready_in_active_span fd3_ready_in_process_events=$fd3_ready_in_process_events fd3_ready_in_glib_iteration=$fd3_ready_in_glib_iteration fd3_ready_in_send_wse=$fd3_ready_in_send_wse span_ready_during_calls=$span_ready_during_calls max_fd3_ready_span_age_ms=$max_fd3_ready_span_age_ms max_fd3_ready_span_depth=$max_fd3_ready_span_depth max_span_ready_offset_ms=$max_span_ready_offset_ms max_ready_to_call_ms=$max_ready_to_call_ms max_ready_to_process_events_ms=$max_ready_to_process_events_ms max_ready_to_send_wse_ms=$max_ready_to_send_wse_ms max_ready_to_flush_wse_ms=$max_ready_to_flush_wse_ms max_ready_to_core_send_posted_ms=$max_ready_to_core_send_posted_ms max_ready_to_private_send_posted_ms=$max_ready_to_private_send_posted_ms max_ready_to_notify_internal2_ms=$max_ready_to_notify_internal2_ms max_ready_to_qsocketnotifier_event_ms=$max_ready_to_qsocketnotifier_event_ms max_ready_to_qwayland_handle_sync_ms=$max_ready_to_qwayland_handle_sync_ms max_ready_to_qwayland_request_sync_ms=$max_ready_to_qwayland_request_sync_ms max_ready_to_qwayland_blocking_read_ms=$max_ready_to_qwayland_blocking_read_ms max_ready_to_qwayland_flush_requests_ms=$max_ready_to_qwayland_flush_requests_ms max_public_wl_elapsed_ms=$max_public_wl_elapsed_ms max_public_wl_ready_to_call_ms=$max_public_wl_ready_to_call_ms max_wl_fd_syscall_elapsed_ms=$max_wl_fd_syscall_elapsed_ms max_wl_fd_syscall_ready_to_call_ms=$max_wl_fd_syscall_ready_to_call_ms max_process_events_ms=$max_process_events_ms max_send_wse_ms=$max_send_wse_ms max_flush_wse_ms=$max_flush_wse_ms max_core_send_posted_ms=$max_core_send_posted_ms max_private_send_posted_ms=$max_private_send_posted_ms max_notify_internal2_ms=$max_notify_internal2_ms max_qsocketnotifier_event_ms=$max_qsocketnotifier_event_ms max_qwayland_handle_sync_ms=$max_qwayland_handle_sync_ms max_qwayland_request_sync_ms=$max_qwayland_request_sync_ms max_qwayland_blocking_read_ms=$max_qwayland_blocking_read_ms max_qwayland_flush_requests_ms=$max_qwayland_flush_requests_ms output_dropped=$output_dropped output_limit=$output_limit branch_hint=$branch_hint"
}

proc summary_nonnegative_int {summary key default} {
    set value [summary_value $summary $key $default]

    if {[string is integer -strict $value] && $value >= 0} {
        return $value
    }
    return $default
}

proc konsole_child_launch_trace_summary {run_text phase_text} {
    set child_pid "missing"
    set clone_begin_ms "missing"
    set clone_done_ms "missing"
    set child_woken_ms "missing"
    set child_run_ms "missing"
    set exec_begin_ms "missing"
    set exec_done_ms "missing"
    set clone_done_to_child_run_ms "missing"
    set child_woken_to_run_ms "missing"
    set child_run_to_exec_begin_ms "missing"
    set exec_begin_to_done_ms "missing"
    set pts_to_clone_begin_ms "missing"
    set exec_done_to_wrapper_start_ms "missing"
    set parent_last_wait_role "missing"
    set parent_last_wait_age_ms "missing"
    set parent_last_wait_ms "missing"
    set parent_last_wait_ret "missing"
    set child_setup_total_calls "missing"
    set child_run_to_first_setup_ms "missing"
    set last_setup_to_exec_begin_ms "missing"
    set child_setup_buckets "missing"
    set child_setup_slow_count "missing"
    set child_setup_max_bucket "missing"
    set child_setup_max_bucket_ms "missing"
    set child_poll_detail_count 0
    set child_poll_eintr_elapsed_ms "missing"
    set child_poll_eintr_kq_tmo "missing"
    set child_poll_eintr_nevents "missing"
    set child_poll_eintr_kqueue_eintr "missing"
    set child_poll_eintr_signal_check_eintr "missing"
    set child_poll_eintr_pending "missing"
    set child_poll_eintr_blocked "missing"
    set child_poll_eintr_shared_pending "missing"
    set child_poll_eintr_first_unblocked "missing"
    set child_poll_eintr_last_signal "missing"
    set child_poll_eintr_last_signal_source "missing"
    set child_poll_eintr_last_signal_code "missing"
    set child_poll_eintr_last_signal_pid "missing"
    set child_poll_first_fd "missing"
    set child_poll_first_fd_events "missing"
    set child_poll_first_fd_revents "missing"
    set child_poll_first_fd_kind "missing"
    set child_poll_first_fd_notify_backed "missing"
    set child_poll_first_fd_requires_rescan "missing"
    set child_poll_first_fd_target "missing"
    set child_poll_ready_fd "missing"
    set child_poll_ready_fd_revents "missing"
    set child_poll_ready_fd_target "missing"
    set branch_hint "missing"
    set trace_count 0
    set wrapper_pid [summary_value $phase_text "wrapper_pid" "missing"]
    set launch_start_ms [summary_value $phase_text "konsole_launch_start_ms" "missing"]
    set pts_since_launch_ms [summary_value $phase_text "pty_pts_since_launch_ms" "missing"]
    set wrapper_start_ms [summary_value $phase_text "wrapper_start_ms" "missing"]

    if {[string is integer -strict $wrapper_pid] && $wrapper_pid > 0} {
        set child_pid $wrapper_pid
    }
    foreach raw_line [split $run_text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {![regexp {konsole-child-launch:} $line]} {
            continue
        }
        incr trace_count
        if {$child_pid eq "missing" &&
            [regexp {phase=exec_begin} $line] &&
            [regexp {path='/bin/kde-konsole-shell-wrapper'} $line]} {
            set pid [summary_value $line "pid" "missing"]
            if {[string is integer -strict $pid] && $pid > 0} {
                set child_pid $pid
            }
        }
    }

    if {$child_pid ne "missing"} {
        foreach raw_line [split $run_text "\n"] {
            set line [string trimright $raw_line "\r"]
            if {![regexp {konsole-child-launch:} $line]} {
                continue
            }
            set phase [summary_value $line "phase" "missing"]
            set pid [summary_value $line "pid" "missing"]
            set cpid [summary_value $line "child_pid" "missing"]
            if {$phase ne "clone_begin" && $pid ne $child_pid && $cpid ne $child_pid} {
                continue
            }
            if {$phase eq "clone_done"} {
                set clone_begin_ms [summary_value $line "clone_begin_ms" $clone_begin_ms]
                set clone_done_ms [summary_value $line "clone_done_ms" $clone_done_ms]
            } elseif {$phase eq "clone_begin"} {
                set valid_wait [summary_value $line "last_wait_valid" 0]
                set wait_role [summary_value $line "last_wait_role" "missing"]
                if {$valid_wait eq "1" && $wait_role ne "missing"} {
                    set parent_last_wait_role $wait_role
                    set parent_last_wait_age_ms [summary_value $line "last_wait_age_ms" $parent_last_wait_age_ms]
                    set parent_last_wait_ms [summary_value $line "last_wait_ms" $parent_last_wait_ms]
                    set parent_last_wait_ret [summary_value $line "last_wait_ret" $parent_last_wait_ret]
                }
            } elseif {$phase eq "child_woken"} {
                set child_woken_ms [summary_value $line "child_woken_ms" $child_woken_ms]
            } elseif {$phase eq "child_run"} {
                set child_run_ms [summary_value $line "child_run_ms" $child_run_ms]
                set clone_done_to_child_run_ms [summary_value $line "clone_done_to_run_ms" $clone_done_to_child_run_ms]
                set child_woken_to_run_ms [summary_value $line "child_woken_to_run_ms" $child_woken_to_run_ms]
            } elseif {$phase eq "child_setup_summary"} {
                set child_setup_total_calls [summary_value $line "total_calls" $child_setup_total_calls]
                set child_run_to_first_setup_ms [summary_value $line "child_run_to_first_setup_ms" $child_run_to_first_setup_ms]
                set last_setup_to_exec_begin_ms [summary_value $line "last_setup_to_exec_begin_ms" $last_setup_to_exec_begin_ms]
                set child_setup_slow_count [summary_value $line "slow_count" $child_setup_slow_count]
                set child_setup_max_bucket [summary_value $line "max_bucket" $child_setup_max_bucket]
                set child_setup_max_bucket_ms [summary_value $line "max_bucket_ms" $child_setup_max_bucket_ms]
                set child_setup_buckets [format "setsid:%s/%s,setpgid:%s/%s,ctty:%s/%s,pgrp:%s/%s,tcsets:%s/%s,ioctl_other:%s/%s,dup:%s/%s,close:%s/%s,close_range:%s/%s,fcntl:%s/%s,sigmask:%s/%s,sigaction:%s/%s,chdir:%s/%s,wait:%s/%s,poll:%s/%s" \
                    [summary_value $line "setsid_calls" 0] [summary_value $line "setsid_ms" 0] \
                    [summary_value $line "setpgid_calls" 0] [summary_value $line "setpgid_ms" 0] \
                    [summary_value $line "ioctl_ctty_calls" 0] [summary_value $line "ioctl_ctty_ms" 0] \
                    [summary_value $line "ioctl_pgrp_calls" 0] [summary_value $line "ioctl_pgrp_ms" 0] \
                    [summary_value $line "ioctl_tcsets_calls" 0] [summary_value $line "ioctl_tcsets_ms" 0] \
                    [summary_value $line "ioctl_other_calls" 0] [summary_value $line "ioctl_other_ms" 0] \
                    [summary_value $line "dup_calls" 0] [summary_value $line "dup_ms" 0] \
                    [summary_value $line "close_calls" 0] [summary_value $line "close_ms" 0] \
                    [summary_value $line "close_range_calls" 0] [summary_value $line "close_range_ms" 0] \
                    [summary_value $line "fcntl_calls" 0] [summary_value $line "fcntl_ms" 0] \
                    [summary_value $line "sigmask_calls" 0] [summary_value $line "sigmask_ms" 0] \
                    [summary_value $line "sigaction_calls" 0] [summary_value $line "sigaction_ms" 0] \
                    [summary_value $line "chdir_calls" 0] [summary_value $line "chdir_ms" 0] \
                    [summary_value $line "wait_calls" 0] [summary_value $line "wait_ms" 0] \
                    [summary_value $line "poll_calls" 0] [summary_value $line "poll_ms" 0]]
            } elseif {$phase eq "exec_begin"} {
                set exec_begin_ms [summary_value $line "exec_begin_ms" $exec_begin_ms]
                set child_run_to_exec_begin_ms [summary_value $line "child_run_to_exec_begin_ms" $child_run_to_exec_begin_ms]
            } elseif {$phase eq "exec_done"} {
                set exec_done_ms [summary_value $line "exec_done_ms" $exec_done_ms]
                set exec_begin_to_done_ms [summary_value $line "exec_begin_to_done_ms" $exec_begin_to_done_ms]
                if {$child_run_to_exec_begin_ms eq "missing"} {
                    set child_run_to_exec_begin_ms [summary_value $line "child_run_to_exec_begin_ms" $child_run_to_exec_begin_ms]
                }
            }
        }
    }

    foreach raw_line [split $run_text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {konsole-child-poll-detail:} $line]} {
            incr child_poll_detail_count
            if {[summary_value $line "ret" "missing"] eq "-4"} {
                set child_poll_eintr_elapsed_ms [summary_value $line "elapsed_ms" $child_poll_eintr_elapsed_ms]
                set child_poll_eintr_kq_tmo [summary_value $line "kq_tmo" $child_poll_eintr_kq_tmo]
                set child_poll_eintr_nevents [summary_value $line "nevents" $child_poll_eintr_nevents]
                set child_poll_eintr_kqueue_eintr [summary_value $line "kqueue_eintr" $child_poll_eintr_kqueue_eintr]
                set child_poll_eintr_signal_check_eintr [summary_value $line "signal_check_eintr" $child_poll_eintr_signal_check_eintr]
                set child_poll_eintr_pending [summary_value $line "pending" $child_poll_eintr_pending]
                set child_poll_eintr_blocked [summary_value $line "blocked" $child_poll_eintr_blocked]
                set child_poll_eintr_shared_pending [summary_value $line "shared_pending" $child_poll_eintr_shared_pending]
                set child_poll_eintr_first_unblocked [summary_value $line "first_unblocked" $child_poll_eintr_first_unblocked]
                set child_poll_eintr_last_signal [summary_value $line "last_signal" $child_poll_eintr_last_signal]
                set child_poll_eintr_last_signal_source [summary_value $line "last_signal_source" $child_poll_eintr_last_signal_source]
                set child_poll_eintr_last_signal_code [summary_value $line "last_signal_code" $child_poll_eintr_last_signal_code]
                set child_poll_eintr_last_signal_pid [summary_value $line "last_signal_pid" $child_poll_eintr_last_signal_pid]
            }
        } elseif {[regexp {konsole-child-poll-fd:} $line]} {
            set fd [summary_value $line "fd" "missing"]
            set revents [summary_value $line "revents" "missing"]
            set target [summary_value $line "target" "missing"]
            if {$child_poll_first_fd eq "missing"} {
                set child_poll_first_fd $fd
                set child_poll_first_fd_events [summary_value $line "events" $child_poll_first_fd_events]
                set child_poll_first_fd_revents $revents
                set child_poll_first_fd_kind [summary_value $line "kind" $child_poll_first_fd_kind]
                set child_poll_first_fd_notify_backed [summary_value $line "notify_backed" $child_poll_first_fd_notify_backed]
                set child_poll_first_fd_requires_rescan [summary_value $line "requires_rescan" $child_poll_first_fd_requires_rescan]
                set child_poll_first_fd_target $target
            }
            if {$revents ne "0x0" && $revents ne "0" && $revents ne "missing"} {
                set child_poll_ready_fd $fd
                set child_poll_ready_fd_revents $revents
                set child_poll_ready_fd_target $target
            }
        }
    }

    if {[string is integer -strict $launch_start_ms] &&
        [string is integer -strict $pts_since_launch_ms] &&
        [string is integer -strict $clone_begin_ms] &&
        $pts_since_launch_ms >= 0 && $clone_begin_ms > 0} {
        set pts_abs_ms [expr {$launch_start_ms + $pts_since_launch_ms}]
        set pts_to_clone_begin_ms [expr {$clone_begin_ms - $pts_abs_ms}]
    }
    if {[string is integer -strict $wrapper_start_ms] &&
        [string is integer -strict $exec_done_ms] &&
        $wrapper_start_ms > 0 && $exec_done_ms > 0} {
        set exec_done_to_wrapper_start_ms [expr {$wrapper_start_ms - $exec_done_ms}]
    }

    if {[string is integer -strict $child_run_to_exec_begin_ms] &&
        [string is integer -strict $child_setup_max_bucket_ms] &&
        $child_run_to_exec_begin_ms > 100 &&
        $child_setup_max_bucket_ms > 50 &&
        $child_setup_max_bucket ne "missing"} {
        set branch_hint "child_preexec_$child_setup_max_bucket"
    } elseif {[string is integer -strict $pts_to_clone_begin_ms] &&
        $pts_to_clone_begin_ms > 100} {
        set branch_hint "late_clone_exec_konsole_qt_event_loop"
    } elseif {[string is integer -strict $clone_done_to_child_run_ms] &&
              $clone_done_to_child_run_ms > 100} {
        set branch_hint "scheduler_wake_to_run"
    } elseif {[string is integer -strict $exec_done_to_wrapper_start_ms] &&
              $exec_done_to_wrapper_start_ms > 100} {
        set branch_hint "exec_loader_scheduler_handoff"
    } elseif {$trace_count > 0 && $child_pid ne "missing"} {
        set branch_hint "no_large_child_launch_gap"
    }

    return "available=[expr {$trace_count > 0 ? 1 : 0}] trace_count=$trace_count child_pid=$child_pid clone_begin_ms=$clone_begin_ms clone_done_ms=$clone_done_ms child_woken_ms=$child_woken_ms child_run_ms=$child_run_ms exec_begin_ms=$exec_begin_ms exec_done_ms=$exec_done_ms pts_to_clone_begin_ms=$pts_to_clone_begin_ms parent_last_wait_role=$parent_last_wait_role parent_last_wait_age_ms=$parent_last_wait_age_ms parent_last_wait_ms=$parent_last_wait_ms parent_last_wait_ret=$parent_last_wait_ret clone_done_to_child_run_ms=$clone_done_to_child_run_ms child_woken_to_run_ms=$child_woken_to_run_ms child_run_to_first_setup_ms=$child_run_to_first_setup_ms child_setup_total_calls=$child_setup_total_calls child_setup_buckets=$child_setup_buckets child_setup_slow_count=$child_setup_slow_count child_setup_max_bucket=$child_setup_max_bucket child_setup_max_bucket_ms=$child_setup_max_bucket_ms child_run_to_exec_begin_ms=$child_run_to_exec_begin_ms last_setup_to_exec_begin_ms=$last_setup_to_exec_begin_ms exec_begin_to_done_ms=$exec_begin_to_done_ms exec_done_to_wrapper_start_ms=$exec_done_to_wrapper_start_ms child_poll_detail_count=$child_poll_detail_count child_poll_eintr_elapsed_ms=$child_poll_eintr_elapsed_ms child_poll_eintr_kq_tmo=$child_poll_eintr_kq_tmo child_poll_eintr_nevents=$child_poll_eintr_nevents child_poll_eintr_kqueue_eintr=$child_poll_eintr_kqueue_eintr child_poll_eintr_signal_check_eintr=$child_poll_eintr_signal_check_eintr child_poll_eintr_pending=$child_poll_eintr_pending child_poll_eintr_blocked=$child_poll_eintr_blocked child_poll_eintr_shared_pending=$child_poll_eintr_shared_pending child_poll_eintr_first_unblocked=$child_poll_eintr_first_unblocked child_poll_eintr_last_signal=$child_poll_eintr_last_signal child_poll_eintr_last_signal_source=$child_poll_eintr_last_signal_source child_poll_eintr_last_signal_code=$child_poll_eintr_last_signal_code child_poll_eintr_last_signal_pid=$child_poll_eintr_last_signal_pid child_poll_first_fd=$child_poll_first_fd child_poll_first_fd_events=$child_poll_first_fd_events child_poll_first_fd_revents=$child_poll_first_fd_revents child_poll_first_fd_kind=$child_poll_first_fd_kind child_poll_first_fd_notify_backed=$child_poll_first_fd_notify_backed child_poll_first_fd_requires_rescan=$child_poll_first_fd_requires_rescan child_poll_first_fd_target=$child_poll_first_fd_target child_poll_ready_fd=$child_poll_ready_fd child_poll_ready_fd_revents=$child_poll_ready_fd_revents child_poll_ready_fd_target=$child_poll_ready_fd_target branch_hint=$branch_hint"
}

proc chromium_wayland_surface_delivery_matrix {wayland_summary perf_summary frame_hash_summary scanout_summary} {
    set available [summary_nonnegative_int $wayland_summary "available" 0]
    set enabled [summary_nonnegative_int $wayland_summary "enabled" 0]
    set requested_enabled [summary_nonnegative_int $wayland_summary "requested_enabled" -1]
    if {$requested_enabled < 0} {
        set requested_enabled [expr {[summary_bool_value [summary_value $wayland_summary "requested" "missing"]] ||
                                     [summary_bool_value [summary_value $wayland_summary "wayland_debug" "missing"]] ? 1 : 0}]
    }
    set protocol_seen [summary_nonnegative_int $wayland_summary "protocol_seen" -1]
    if {$protocol_seen < 0} {
        set debug_line_count [summary_nonnegative_int $wayland_summary "debug_line_count" 0]
        set protocol_seen [expr {$debug_line_count > 0 ? 1 : 0}]
    }
    if {!$enabled && ($requested_enabled || $protocol_seen)} {
        set enabled 1
    }
    set primary_surface [summary_value $wayland_summary "primary_surface" "missing"]
    set primary_surface_role [summary_value $wayland_summary "primary_surface_role" "missing"]
    set surface_create_count [summary_nonnegative_int $wayland_summary "surface_create_count" 0]
    set created_surface_count [summary_nonnegative_int $wayland_summary "created_surface_count" 0]
    set created_surface_without_delivery_count [summary_nonnegative_int $wayland_summary "created_surface_without_delivery_count" 0]
    set surface_delivery_op_count [summary_nonnegative_int $wayland_summary "surface_delivery_op_count" 0]
    set active_surface_count [summary_nonnegative_int $wayland_summary "active_surface_count" 0]
    set primary_attach_count [summary_nonnegative_int $wayland_summary "primary_attach_count" 0]
    set primary_damage_count [summary_nonnegative_int $wayland_summary "primary_damage_count" 0]
    set primary_damage_buffer_count [summary_nonnegative_int $wayland_summary "primary_damage_buffer_count" 0]
    set primary_frame_count [summary_nonnegative_int $wayland_summary "primary_frame_count" 0]
    set primary_frame_done_count [summary_nonnegative_int $wayland_summary "primary_frame_done_count" 0]
    set primary_commit_count [summary_nonnegative_int $wayland_summary "primary_commit_count" 0]
    set primary_buffer_count [summary_nonnegative_int $wayland_summary "primary_buffer_count" 0]
    set rvfc_count [summary_nonnegative_int $perf_summary "last_rvfc_count" 0]
    set result_fail_count [summary_nonnegative_int $perf_summary "result_fail_count" 0]
    set presented [summary_value $perf_summary "last_presented" "missing"]
    set decoded [summary_value $perf_summary "last_decoded" "missing"]
    set dropped [summary_value $perf_summary "last_dropped" "missing"]
    set capture_unique [summary_nonnegative_int $frame_hash_summary "unique_hash_count" 0]
    set scanout_unique [summary_nonnegative_int $scanout_summary "kms_sample_unique_hash_count" 0]
    set scanout_changed [summary_nonnegative_int $scanout_summary "kms_sample_changed_count" 0]
    set status "INFO"
    set reason "surface-delivery-not-classified"
    set chromium_surface_active 0
    set frame_ack_active 0
    set capture_static 0
    set scanout_static 0

    if {!$available || !$enabled} {
        return "available=$available enabled=$enabled requested_enabled=$requested_enabled protocol_seen=$protocol_seen status=SKIP reason=wayland-debug-disabled primary_surface=$primary_surface"
    }
    if {!$protocol_seen} {
        return "available=1 enabled=$enabled requested_enabled=$requested_enabled protocol_seen=$protocol_seen status=FAIL reason=wayland-debug-no-protocol-lines primary_surface=$primary_surface surface_create_count=$surface_create_count created_surface_count=$created_surface_count created_surface_without_delivery_count=$created_surface_without_delivery_count surface_delivery_op_count=$surface_delivery_op_count active_surface_count=$active_surface_count"
    }

    if {$primary_attach_count > 0 || $primary_damage_count > 0 ||
        $primary_damage_buffer_count > 0 || $primary_commit_count > 0} {
        set chromium_surface_active 1
    }
    if {$primary_frame_count > 0 && $primary_frame_done_count > 0} {
        set frame_ack_active 1
    }
    if {$capture_unique == 1} {
        set capture_static 1
    }
    if {$scanout_unique == 1 && $scanout_changed == 0} {
        set scanout_static 1
    }

    if {$primary_commit_count == 0} {
        set status "FAIL"
        set reason "no-primary-surface-commit"
    } elseif {$primary_attach_count == 0 && $primary_buffer_count == 0} {
        set status "FAIL"
        set reason "no-primary-surface-buffer"
    } elseif {$primary_frame_count > 0 && $primary_frame_done_count == 0} {
        set status "FAIL"
        set reason "no-frame-callback-done"
    } elseif {$rvfc_count > 0 && $chromium_surface_active && $frame_ack_active &&
              ($capture_static || $scanout_static)} {
        set status "WARN"
        set reason "surface-delivery-active-downstream-static"
    } elseif {$rvfc_count > 0 && $chromium_surface_active && $frame_ack_active} {
        set status "PASS"
        set reason "surface-delivery-active"
    } elseif {$chromium_surface_active && $frame_ack_active} {
        set status "INFO"
        set reason "surface-delivery-active-without-rvfc"
    }

    return "available=1 enabled=$enabled requested_enabled=$requested_enabled protocol_seen=$protocol_seen status=$status reason=$reason surface_create_count=$surface_create_count created_surface_count=$created_surface_count created_surface_without_delivery_count=$created_surface_without_delivery_count surface_delivery_op_count=$surface_delivery_op_count active_surface_count=$active_surface_count primary_surface=$primary_surface primary_surface_role=$primary_surface_role primary_attach_count=$primary_attach_count primary_damage_count=$primary_damage_count primary_damage_buffer_count=$primary_damage_buffer_count primary_frame_count=$primary_frame_count primary_frame_done_count=$primary_frame_done_count primary_commit_count=$primary_commit_count primary_buffer_count=$primary_buffer_count chromium_surface_active=$chromium_surface_active frame_ack_active=$frame_ack_active rvfc_count=$rvfc_count presented=$presented decoded=$decoded dropped=$dropped result_fail_count=$result_fail_count capture_unique_hash_count=$capture_unique scanout_unique_hash_count=$scanout_unique scanout_changed_count=$scanout_changed capture_static=$capture_static scanout_static=$scanout_static"
}

proc chromium_egl_trace_summary {} {
    global chromium_egl_trace_log

    if {![guest_artifact_real_file $chromium_egl_trace_log]} {
        return "available=0"
    }

    set text [read_text_file $chromium_egl_trace_log]
    set init_count 0
    set process_count 0
    set process_browser_count 0
    set process_renderer_count 0
    set process_gpu_count 0
    set process_zygote_count 0
    set process_gpu_use_gl_count 0
    set process_gpu_use_angle_count 0
    set process_gpu_disable_gpu_early_init_count 0
    set process_gpu_trace_env_count 0
    set process_gpu_log_env_count 0
    set process_gpu_env_egl_platform_count 0
    set process_gpu_env_ld_preload_trace_count 0
    set choose_count 0
    set choose_zero_count 0
    set choose_pbuffer_count 0
    set choose_window_count 0
    set choose_window_pbuffer_count 0
    set getproc_count 0
    set getproc_traced_count 0
    set getproc_choose_count 0
    set getproc_create_context_count 0
    set getproc_create_pbuffer_count 0
    set getproc_create_window_count 0
    set egl_get_display_count 0
    set egl_get_platform_display_count 0
    set egl_initialize_count 0
    set egl_initialize_fail_count 0
    set egl_bind_api_count 0
    set egl_query_string_count 0
    set egl_get_configs_count 0
    set egl_get_config_attrib_count 0
    set egl_get_error_count 0
    set gpu_egl_bootstrap_count 0
    set dlsym_count 0
    set dlsym_traced_count 0
    set dlsym_choose_count 0
    set dlsym_create_context_count 0
    set dlsym_create_pbuffer_count 0
    set dlsym_create_window_count 0
    set dlopen_count 0
    set open_count 0
    set openat_count 0
    set open_fail_count 0
    set openat_fail_count 0
    set render_open_count 0
    set browser_render_open_count 0
    set gpu_render_open_count 0
    set zygote_render_open_count 0
    set proc_open_count 0
    set proc_openat_count 0
    set proc_read_count 0
    set proc_drop_count 0
    set proc_cmdline_read_count 0
    set proc_comm_read_count 0
    set proc_stat_read_count 0
    set proc_status_read_count 0
    set prctl_count 0
    set prctl_set_name_count 0
    set prctl_get_name_count 0
    set ioctl_count 0
    set ioctl_fail_count 0
    set browser_ioctl_count 0
    set gpu_ioctl_count 0
    set zygote_ioctl_count 0
    set ioctl_elapsed_us_sum 0
    set ioctl_elapsed_us_max 0
    set ioctl_drm_version_count 0
    set ioctl_virtgpu_getparam_count 0
    set ioctl_virtgpu_context_init_count 0
    set ioctl_virtgpu_resource_create_count 0
    set ioctl_virtgpu_resource_create_blob_count 0
    set ioctl_virtgpu_execbuffer_count 0
    set ioctl_virtgpu_resource_info_count 0
    set ioctl_virtgpu_wait_count 0
    set ioctl_virtgpu_get_caps_count 0
    set execve_count 0
    set execve_gpu_count 0
    set execve_renderer_count 0
    set execve_return_count 0
    set execve_return_fail_count 0
    set fork_count 0
    set browser_fork_count 0
    set gpu_fork_count 0
    set zygote_fork_count 0
    set vfork_count 0
    set socketpair_count 0
    set browser_socketpair_count 0
    set gpu_socketpair_count 0
    set zygote_socketpair_count 0
    set ipc_count 0
    set ipc_read_count 0
    set ipc_write_count 0
    set ipc_send_count 0
    set ipc_recv_count 0
    set ipc_sendmsg_count 0
    set ipc_recvmsg_count 0
    set ipc_close_count 0
    set ipc_drop_count 0
    set ipc_fail_count 0
    set ipc_callsite_count 0
    set ipc_cmsg_count 0
    set ipc_scm_rights_count 0
    set ipc_scm_rights_fd_count 0
    set ipc_scm_credentials_count 0
    set ipc_cmsg_truncated_count 0
    set ipc_bytes_sum 0
    set epoll_create1_count 0
    set epoll_ctl_count 0
    set epoll_wait_count 0
    set epoll_pwait_count 0
    set epoll_ready_count 0
    set epoll_drop_count 0
    set epoll_callsite_count 0
    set wayland_marshal_count 0
    set wayland_marshal_flags_count 0
    set wayland_marshal_array_flags_count 0
    set wayland_marshal_legacy_count 0
    set wayland_marshal_constructor_count 0
    set wayland_marshal_array_count 0
    set wayland_marshal_array_constructor_count 0
    set wayland_marshal_drop_count 0
    set wayland_marshal_callsite_count 0
    set wayland_connect_count 0
    set wayland_wire_count 0
    set wayland_wire_write_count 0
    set wayland_wire_writev_count 0
    set wayland_wire_send_count 0
    set wayland_wire_sendto_count 0
    set wayland_wire_sendmsg_count 0
    set wayland_wire_unknown_count 0
    set wayland_wire_drop_count 0
    set wayland_wire_callsite_count 0
    set wayland_create_surface_count 0
    set wayland_get_xdg_surface_count 0
    set wayland_get_toplevel_count 0
    set wayland_surface_attach_count 0
    set wayland_surface_damage_count 0
    set wayland_surface_damage_buffer_count 0
    set wayland_surface_frame_count 0
    set wayland_surface_commit_count 0
    set wayland_xdg_ack_configure_count 0
    set wayland_wire_create_surface_count 0
    set wayland_wire_get_xdg_surface_count 0
    set wayland_wire_get_toplevel_count 0
    set wayland_wire_surface_attach_count 0
    set wayland_wire_surface_damage_count 0
    set wayland_wire_surface_damage_buffer_count 0
    set wayland_wire_surface_frame_count 0
    set wayland_wire_surface_commit_count 0
    set wayland_wire_xdg_ack_configure_count 0
    set gtk_event_count 0
    set gtk_drop_count 0
    set gtk_dlsym_count 0
    set gtk_widget_show_count 0
    set gtk_widget_realize_count 0
    set gtk_widget_map_count 0
    set gtk_widget_set_visible_count 0
    set gtk_window_present_count 0
    set gdk_window_show_count 0
    set gdk_window_ensure_native_count 0
    set gdk_wayland_surface_get_count 0
    set gdk_window_set_title_count 0
    set browser_ipc_count 0
    set gpu_ipc_count 0
    set zygote_ipc_count 0
    set create_context_count 0
    set create_pbuffer_count 0
    set create_window_count 0
    set egl_make_current_count 0
    set egl_swap_buffers_count 0
    set egl_swap_damage_count 0
    set egl_create_image_count 0
    set egl_create_image_fail_count 0
    set egl_destroy_image_count 0
    set wl_egl_window_create_count 0
    set wl_egl_window_resize_count 0
    set wl_egl_window_destroy_count 0
    set gbm_bo_create_count 0
    set gbm_bo_create_fail_count 0
    set gbm_bo_import_count 0
    set gbm_bo_import_fail_count 0
    set gbm_bo_destroy_count 0
    set first_open ""
    set last_open ""
    set first_proc ""
    set last_proc ""
    set first_prctl ""
    set last_prctl ""
    set first_ioctl ""
    set last_ioctl ""
    set first_execve ""
    set last_execve ""
    set first_fork ""
    set last_fork ""
    set first_socketpair ""
    set last_socketpair ""
    set first_ipc ""
    set last_ipc ""
    set first_epoll ""
    set last_epoll ""
    set first_wayland_marshal ""
    set last_wayland_marshal ""
    set first_wayland_wire ""
    set last_wayland_wire ""
    set first_gtk_event ""
    set last_gtk_event ""
    set first_getproc ""
    set last_getproc ""
    set first_egl_bootstrap ""
    set last_egl_bootstrap ""
    set first_dlsym ""
    set last_dlsym ""
    set first_dlopen ""
    set last_dlopen ""
    set first_choose ""
    set last_choose ""
    set first_graphics_buffer ""
    set last_graphics_buffer ""
    set first_process ""
    set last_process ""
    set first_gpu_process ""
    set last_gpu_process ""
    set first_gpu_env ""
    set last_gpu_env ""
    array set trace_pid_role {}

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {chromium_egl_trace phase=init } $line]} {
            incr init_count
        }
        if {[regexp {chromium_egl_trace phase=process } $line]} {
            incr process_count
            set last_process $line
            if {$first_process eq ""} {
                set first_process $line
            }
            if {[regexp { role=browser([ \t]|$)} $line]} {
                incr process_browser_count
                if {[regexp { pid=([0-9]+)} $line -> pid]} {
                    set trace_pid_role($pid) "browser"
                }
            } elseif {[regexp { role=renderer([ \t]|$)} $line]} {
                incr process_renderer_count
                if {[regexp { pid=([0-9]+)} $line -> pid]} {
                    set trace_pid_role($pid) "renderer"
                }
            } elseif {[regexp { role=gpu-process([ \t]|$)} $line]} {
                incr process_gpu_count
                if {[regexp { pid=([0-9]+)} $line -> pid]} {
                    set trace_pid_role($pid) "gpu-process"
                }
                set last_gpu_process $line
                if {$first_gpu_process eq ""} {
                    set first_gpu_process $line
                }
                if {[regexp { use_gl=1([ \t]|$)} $line]} {
                    incr process_gpu_use_gl_count
                }
                if {[regexp { use_angle=1([ \t]|$)} $line]} {
                    incr process_gpu_use_angle_count
                }
                if {[regexp { disable_gpu_early_init=1([ \t]|$)} $line]} {
                    incr process_gpu_disable_gpu_early_init_count
                }
                if {[regexp { trace_env=1([ \t]|$)} $line]} {
                    incr process_gpu_trace_env_count
                }
                if {[regexp { log_env=1([ \t]|$)} $line]} {
                    incr process_gpu_log_env_count
                }
            } elseif {[regexp { role=zygote([ \t]|$)} $line]} {
                incr process_zygote_count
                if {[regexp { pid=([0-9]+)} $line -> pid]} {
                    set trace_pid_role($pid) "zygote"
                }
            }
        } elseif {[regexp {chromium_egl_trace phase=process_env .* role=gpu-process([ \t]|$)} $line]} {
            set last_gpu_env $line
            if {$first_gpu_env eq ""} {
                set first_gpu_env $line
            }
            if {[regexp {entry="EGL_PLATFORM=} $line]} {
                incr process_gpu_env_egl_platform_count
            }
            if {[regexp {entry="LD_PRELOAD=[^"]*chromium-egl-trace-preload} $line]} {
                incr process_gpu_env_ld_preload_trace_count
            }
        }
        if {[regexp {chromium_egl_trace phase=eglGetProcAddress } $line]} {
            incr getproc_count
            set last_getproc $line
            if {$first_getproc eq ""} {
                set first_getproc $line
            }
            if {[regexp { traced=1([ \t]|$)} $line]} {
                incr getproc_traced_count
            }
            if {[regexp { name=eglChooseConfig([ \t]|$)} $line]} {
                incr getproc_choose_count
            } elseif {[regexp { name=eglCreateContext([ \t]|$)} $line]} {
                incr getproc_create_context_count
            } elseif {[regexp { name=eglCreatePbufferSurface([ \t]|$)} $line]} {
                incr getproc_create_pbuffer_count
            } elseif {[regexp { name=eglCreateWindowSurface([ \t]|$)} $line]} {
                incr getproc_create_window_count
            }
        } elseif {[regexp {chromium_egl_trace phase=(eglGetDisplay|eglGetPlatformDisplay|eglGetPlatformDisplayEXT|eglInitialize|eglBindAPI|eglQueryString|eglGetConfigs|eglGetConfigAttrib|eglGetError) pid=([0-9]+)} $line -> egl_phase pid]} {
            set role "unknown"
            if {[info exists trace_pid_role($pid)]} {
                set role $trace_pid_role($pid)
            }
            if {$egl_phase eq "eglGetDisplay"} {
                incr egl_get_display_count
            } elseif {$egl_phase eq "eglGetPlatformDisplay" || $egl_phase eq "eglGetPlatformDisplayEXT"} {
                incr egl_get_platform_display_count
            } elseif {$egl_phase eq "eglInitialize"} {
                incr egl_initialize_count
                if {[regexp { ret=0([ \t]|$)} $line]} {
                    incr egl_initialize_fail_count
                }
            } elseif {$egl_phase eq "eglBindAPI"} {
                incr egl_bind_api_count
            } elseif {$egl_phase eq "eglQueryString"} {
                incr egl_query_string_count
            } elseif {$egl_phase eq "eglGetConfigs"} {
                incr egl_get_configs_count
            } elseif {$egl_phase eq "eglGetConfigAttrib"} {
                incr egl_get_config_attrib_count
            } elseif {$egl_phase eq "eglGetError"} {
                incr egl_get_error_count
            }
            if {$role eq "gpu-process"} {
                incr gpu_egl_bootstrap_count
            }
            set last_egl_bootstrap $line
            if {$first_egl_bootstrap eq ""} {
                set first_egl_bootstrap $line
            }
        } elseif {[regexp {chromium_egl_trace phase=dlsym } $line]} {
            incr dlsym_count
            set last_dlsym $line
            if {$first_dlsym eq ""} {
                set first_dlsym $line
            }
            if {[regexp { traced=1([ \t]|$)} $line]} {
                incr dlsym_traced_count
            }
            if {[regexp { name=eglChooseConfig([ \t]|$)} $line]} {
                incr dlsym_choose_count
            } elseif {[regexp { name=eglCreateContext([ \t]|$)} $line]} {
                incr dlsym_create_context_count
            } elseif {[regexp { name=eglCreatePbufferSurface([ \t]|$)} $line]} {
                incr dlsym_create_pbuffer_count
            } elseif {[regexp { name=eglCreateWindowSurface([ \t]|$)} $line]} {
                incr dlsym_create_window_count
            }
            if {[regexp { name=(gtk_|gdk_)} $line]} {
                incr gtk_dlsym_count
            }
        } elseif {[regexp {chromium_egl_trace phase=dlopen } $line]} {
            incr dlopen_count
            set last_dlopen $line
            if {$first_dlopen eq ""} {
                set first_dlopen $line
            }
        } elseif {[regexp {chromium_egl_trace phase=(proc_open|proc_openat|proc_read|proc_drop) pid=([0-9]+)} $line -> proc_phase _pid]} {
            if {$proc_phase eq "proc_open"} {
                incr proc_open_count
            } elseif {$proc_phase eq "proc_openat"} {
                incr proc_openat_count
            } elseif {$proc_phase eq "proc_read"} {
                incr proc_read_count
                if {[regexp { kind=cmdline([ \t]|$)} $line]} {
                    incr proc_cmdline_read_count
                } elseif {[regexp { kind=comm([ \t]|$)} $line]} {
                    incr proc_comm_read_count
                } elseif {[regexp { kind=stat([ \t]|$)} $line]} {
                    incr proc_stat_read_count
                } elseif {[regexp { kind=status([ \t]|$)} $line]} {
                    incr proc_status_read_count
                }
            } elseif {$proc_phase eq "proc_drop"} {
                incr proc_drop_count
            }
            set last_proc $line
            if {$first_proc eq ""} {
                set first_proc $line
            }
        } elseif {[regexp {chromium_egl_trace phase=prctl pid=([0-9]+)} $line -> _pid]} {
            incr prctl_count
            if {[regexp { option=PR_SET_NAME([ \t]|$)} $line]} {
                incr prctl_set_name_count
            } elseif {[regexp { option=PR_GET_NAME([ \t]|$)} $line]} {
                incr prctl_get_name_count
            }
            set last_prctl $line
            if {$first_prctl eq ""} {
                set first_prctl $line
            }
        } elseif {[regexp {chromium_egl_trace phase=(open|openat) pid=([0-9]+).* fd=([-0-9]+).* render_fd=([0-9]+)} $line -> open_phase pid fd render_fd]} {
            set role "unknown"
            if {[info exists trace_pid_role($pid)]} {
                set role $trace_pid_role($pid)
            }
            if {$open_phase eq "open"} {
                incr open_count
                if {$fd < 0} {
                    incr open_fail_count
                }
            } else {
                incr openat_count
                if {$fd < 0} {
                    incr openat_fail_count
                }
            }
            set last_open $line
            if {$first_open eq ""} {
                set first_open $line
            }
            if {$render_fd ne "0"} {
                incr render_open_count
                if {$role eq "browser"} {
                    incr browser_render_open_count
                } elseif {$role eq "gpu-process"} {
                    incr gpu_render_open_count
                } elseif {$role eq "zygote"} {
                    incr zygote_render_open_count
                }
            }
        } elseif {[regexp {chromium_egl_trace phase=ioctl pid=([0-9]+).* elapsed_us=([0-9]+)} $line -> pid elapsed_us]} {
            set role "unknown"
            if {[info exists trace_pid_role($pid)]} {
                set role $trace_pid_role($pid)
            }
            incr ioctl_count
            if {[regexp { ret=([-0-9]+)} $line -> ret] && $ret < 0} {
                incr ioctl_fail_count
            }
            if {[regexp { request_name=([^ \t]+)} $line -> request_name]} {
                switch -- $request_name {
                    DRM_IOCTL_VERSION {
                        incr ioctl_drm_version_count
                    }
                    DRM_IOCTL_VIRTGPU_GETPARAM {
                        incr ioctl_virtgpu_getparam_count
                    }
                    DRM_IOCTL_VIRTGPU_CONTEXT_INIT {
                        incr ioctl_virtgpu_context_init_count
                    }
                    DRM_IOCTL_VIRTGPU_RESOURCE_CREATE {
                        incr ioctl_virtgpu_resource_create_count
                    }
                    DRM_IOCTL_VIRTGPU_RESOURCE_CREATE_BLOB {
                        incr ioctl_virtgpu_resource_create_blob_count
                    }
                    DRM_IOCTL_VIRTGPU_EXECBUFFER {
                        incr ioctl_virtgpu_execbuffer_count
                    }
                    DRM_IOCTL_VIRTGPU_RESOURCE_INFO {
                        incr ioctl_virtgpu_resource_info_count
                    }
                    DRM_IOCTL_VIRTGPU_WAIT {
                        incr ioctl_virtgpu_wait_count
                    }
                    DRM_IOCTL_VIRTGPU_GET_CAPS {
                        incr ioctl_virtgpu_get_caps_count
                    }
                }
            }
            incr ioctl_elapsed_us_sum $elapsed_us
            if {$elapsed_us > $ioctl_elapsed_us_max} {
                set ioctl_elapsed_us_max $elapsed_us
            }
            if {$role eq "browser"} {
                incr browser_ioctl_count
            } elseif {$role eq "gpu-process"} {
                incr gpu_ioctl_count
            } elseif {$role eq "zygote"} {
                incr zygote_ioctl_count
            }
            set last_ioctl $line
            if {$first_ioctl eq ""} {
                set first_ioctl $line
            }
        } elseif {[regexp {chromium_egl_trace phase=execve pid=([0-9]+)} $line -> _pid]} {
            incr execve_count
            if {[regexp { type=gpu-process([ \t]|$)} $line]} {
                incr execve_gpu_count
            } elseif {[regexp { type=renderer([ \t]|$)} $line]} {
                incr execve_renderer_count
            }
            set last_execve $line
            if {$first_execve eq ""} {
                set first_execve $line
            }
        } elseif {[regexp {chromium_egl_trace phase=execve_return pid=([0-9]+)} $line -> _pid]} {
            incr execve_return_count
            if {[regexp { ret=([-0-9]+)} $line -> ret] && $ret < 0} {
                incr execve_return_fail_count
            }
        } elseif {[regexp {chromium_egl_trace phase=fork pid=([0-9]+)} $line -> pid]} {
            set role "unknown"
            if {[info exists trace_pid_role($pid)]} {
                set role $trace_pid_role($pid)
            }
            incr fork_count
            if {$role eq "browser"} {
                incr browser_fork_count
            } elseif {$role eq "gpu-process"} {
                incr gpu_fork_count
            } elseif {$role eq "zygote"} {
                incr zygote_fork_count
            }
            set last_fork $line
            if {$first_fork eq ""} {
                set first_fork $line
            }
        } elseif {[regexp {chromium_egl_trace phase=vfork pid=([0-9]+)} $line -> _pid]} {
            incr vfork_count
        } elseif {[regexp {chromium_egl_trace phase=socketpair pid=([0-9]+)} $line -> pid]} {
            set role "unknown"
            if {[info exists trace_pid_role($pid)]} {
                set role $trace_pid_role($pid)
            }
            incr socketpair_count
            if {$role eq "browser"} {
                incr browser_socketpair_count
            } elseif {$role eq "gpu-process"} {
                incr gpu_socketpair_count
            } elseif {$role eq "zygote"} {
                incr zygote_socketpair_count
            }
            set last_socketpair $line
            if {$first_socketpair eq ""} {
                set first_socketpair $line
            }
        } elseif {[regexp {chromium_egl_trace phase=(ipc_read|ipc_write|ipc_send|ipc_recv|ipc_sendmsg|ipc_recvmsg|ipc_close|ipc_drop) pid=([0-9]+)} $line -> ipc_phase pid]} {
            set role "unknown"
            if {[info exists trace_pid_role($pid)]} {
                set role $trace_pid_role($pid)
            }
            incr ipc_count
            if {$ipc_phase eq "ipc_read"} {
                incr ipc_read_count
            } elseif {$ipc_phase eq "ipc_write"} {
                incr ipc_write_count
            } elseif {$ipc_phase eq "ipc_send"} {
                incr ipc_send_count
            } elseif {$ipc_phase eq "ipc_recv"} {
                incr ipc_recv_count
            } elseif {$ipc_phase eq "ipc_sendmsg"} {
                incr ipc_sendmsg_count
            } elseif {$ipc_phase eq "ipc_recvmsg"} {
                incr ipc_recvmsg_count
            } elseif {$ipc_phase eq "ipc_close"} {
                incr ipc_close_count
            } elseif {$ipc_phase eq "ipc_drop"} {
                incr ipc_drop_count
            }
            if {[regexp { ret=([-0-9]+)} $line -> ret]} {
                if {$ret < 0} {
                    incr ipc_fail_count
                } elseif {$ret > 0} {
                    incr ipc_bytes_sum $ret
                }
            }
            if {[regexp { cmsg_count=([0-9]+)} $line -> cmsg_count]} {
                incr ipc_cmsg_count $cmsg_count
            }
            if {[regexp { scm_rights=([0-9]+)} $line -> scm_rights_count]} {
                incr ipc_scm_rights_count $scm_rights_count
            }
            if {[regexp { scm_rights_fds=([0-9]+)} $line -> scm_rights_fds]} {
                incr ipc_scm_rights_fd_count $scm_rights_fds
            }
            if {[regexp { scm_credentials=([0-9]+)} $line -> scm_credentials_count]} {
                incr ipc_scm_credentials_count $scm_credentials_count
            }
            if {[regexp { cmsg_truncated=1([ \t]|$)} $line]} {
                incr ipc_cmsg_truncated_count
            }
            if {[regexp { callsite=1([ \t]|$)} $line]} {
                incr ipc_callsite_count
            }
            if {$role eq "browser"} {
                incr browser_ipc_count
            } elseif {$role eq "gpu-process"} {
                incr gpu_ipc_count
            } elseif {$role eq "zygote"} {
                incr zygote_ipc_count
            }
            set last_ipc $line
            if {$first_ipc eq ""} {
                set first_ipc $line
            }
        } elseif {[regexp {chromium_egl_trace phase=(epoll_create1|epoll_ctl|epoll_wait|epoll_pwait|epoll_drop) pid=([0-9]+)} $line -> epoll_phase _pid]} {
            if {$epoll_phase eq "epoll_create1"} {
                incr epoll_create1_count
            } elseif {$epoll_phase eq "epoll_ctl"} {
                incr epoll_ctl_count
            } elseif {$epoll_phase eq "epoll_wait"} {
                incr epoll_wait_count
            } elseif {$epoll_phase eq "epoll_pwait"} {
                incr epoll_pwait_count
            } elseif {$epoll_phase eq "epoll_drop"} {
                incr epoll_drop_count
            }
            if {[regexp { ret=([1-9][0-9]*)} $line]} {
                incr epoll_ready_count
            }
            if {[regexp { callsite=1([ \t]|$)} $line]} {
                incr epoll_callsite_count
            }
            set last_epoll $line
            if {$first_epoll eq ""} {
                set first_epoll $line
            }
        } elseif {[regexp {chromium_egl_trace phase=connect pid=([0-9]+).* wayland=1([ \t]|$)} $line -> _pid]} {
            incr wayland_connect_count
        } elseif {[regexp {chromium_egl_trace phase=(wayland_wire_[^ \t]*) pid=([0-9]+)} $line -> wayland_wire_phase _pid]} {
            if {$wayland_wire_phase eq "wayland_wire_drop"} {
                incr wayland_wire_drop_count
            } else {
                incr wayland_wire_count
                if {$wayland_wire_phase eq "wayland_wire_write"} {
                    incr wayland_wire_write_count
                } elseif {$wayland_wire_phase eq "wayland_wire_writev"} {
                    incr wayland_wire_writev_count
                } elseif {$wayland_wire_phase eq "wayland_wire_send"} {
                    incr wayland_wire_send_count
                } elseif {$wayland_wire_phase eq "wayland_wire_sendto"} {
                    incr wayland_wire_sendto_count
                } elseif {$wayland_wire_phase eq "wayland_wire_sendmsg"} {
                    incr wayland_wire_sendmsg_count
                } elseif {$wayland_wire_phase eq "wayland_wire_unknown"} {
                    incr wayland_wire_unknown_count
                }
                if {[regexp { callsite=1([ \t]|$)} $line]} {
                    incr wayland_wire_callsite_count
                }
                if {[regexp { class=([^ \t]+).* request=([^ \t]+)} $line -> class_name request_name]} {
                    if {$class_name eq "wl_compositor" && $request_name eq "create_surface"} {
                        incr wayland_wire_create_surface_count
                    } elseif {$class_name eq "xdg_wm_base" && $request_name eq "get_xdg_surface"} {
                        incr wayland_wire_get_xdg_surface_count
                    } elseif {$class_name eq "xdg_surface" && $request_name eq "get_toplevel"} {
                        incr wayland_wire_get_toplevel_count
                    } elseif {$class_name eq "xdg_surface" && $request_name eq "ack_configure"} {
                        incr wayland_wire_xdg_ack_configure_count
                    } elseif {$class_name eq "wl_surface"} {
                        switch -- $request_name {
                            attach {
                                incr wayland_wire_surface_attach_count
                            }
                            damage {
                                incr wayland_wire_surface_damage_count
                            }
                            damage_buffer {
                                incr wayland_wire_surface_damage_buffer_count
                            }
                            frame {
                                incr wayland_wire_surface_frame_count
                            }
                            commit {
                                incr wayland_wire_surface_commit_count
                            }
                        }
                    }
                }
                set last_wayland_wire $line
                if {$first_wayland_wire eq ""} {
                    set first_wayland_wire $line
                }
            }
        } elseif {[regexp {chromium_egl_trace phase=(wayland_marshal[^ \t]*) pid=([0-9]+)} $line -> wayland_phase _pid]} {
            if {$wayland_phase eq "wayland_marshal_drop"} {
                incr wayland_marshal_drop_count
            } else {
                incr wayland_marshal_count
                if {$wayland_phase eq "wayland_marshal_flags"} {
                    incr wayland_marshal_flags_count
                } elseif {$wayland_phase eq "wayland_marshal_array_flags"} {
                    incr wayland_marshal_array_flags_count
                } elseif {$wayland_phase eq "wayland_marshal"} {
                    incr wayland_marshal_legacy_count
                } elseif {[string match "wayland_marshal_constructor*" $wayland_phase]} {
                    incr wayland_marshal_constructor_count
                } elseif {$wayland_phase eq "wayland_marshal_array"} {
                    incr wayland_marshal_array_count
                } elseif {[string match "wayland_marshal_array_constructor*" $wayland_phase]} {
                    incr wayland_marshal_array_constructor_count
                }
                if {[regexp { callsite=1([ \t]|$)} $line]} {
                    incr wayland_marshal_callsite_count
                }
                if {[regexp { class=([^ \t]+).* request=([^ \t]+)} $line -> class_name request_name]} {
                    if {$class_name eq "wl_compositor" && $request_name eq "create_surface"} {
                        incr wayland_create_surface_count
                    } elseif {$class_name eq "xdg_wm_base" && $request_name eq "get_xdg_surface"} {
                        incr wayland_get_xdg_surface_count
                    } elseif {$class_name eq "xdg_surface" && $request_name eq "get_toplevel"} {
                        incr wayland_get_toplevel_count
                    } elseif {$class_name eq "xdg_surface" && $request_name eq "ack_configure"} {
                        incr wayland_xdg_ack_configure_count
                    } elseif {$class_name eq "wl_surface"} {
                        switch -- $request_name {
                            attach {
                                incr wayland_surface_attach_count
                            }
                            damage {
                                incr wayland_surface_damage_count
                            }
                            damage_buffer {
                                incr wayland_surface_damage_buffer_count
                            }
                            frame {
                                incr wayland_surface_frame_count
                            }
                            commit {
                                incr wayland_surface_commit_count
                            }
                        }
                    }
                }
                set last_wayland_marshal $line
                if {$first_wayland_marshal eq ""} {
                    set first_wayland_marshal $line
                }
            }
        } elseif {[regexp {chromium_egl_trace phase=((gtk|gdk)_[^ \t]+) pid=([0-9]+)} $line -> gtk_phase _prefix _pid]} {
            if {$gtk_phase eq "gtk_drop"} {
                incr gtk_drop_count
            } else {
                incr gtk_event_count
                if {[string match "gtk_widget_show*" $gtk_phase]} {
                    incr gtk_widget_show_count
                } elseif {[string match "gtk_widget_realize*" $gtk_phase]} {
                    incr gtk_widget_realize_count
                } elseif {[string match "gtk_widget_map*" $gtk_phase]} {
                    incr gtk_widget_map_count
                } elseif {[string match "gtk_widget_set_visible*" $gtk_phase]} {
                    incr gtk_widget_set_visible_count
                } elseif {[string match "gtk_window_present*" $gtk_phase]} {
                    incr gtk_window_present_count
                } elseif {[string match "gdk_window_show*" $gtk_phase]} {
                    incr gdk_window_show_count
                } elseif {[string match "gdk_window_ensure_native*" $gtk_phase]} {
                    incr gdk_window_ensure_native_count
                } elseif {[string match "gdk_wayland_window_get_wl_surface*" $gtk_phase]} {
                    incr gdk_wayland_surface_get_count
                } elseif {[string match "gdk_window_set_title*" $gtk_phase]} {
                    incr gdk_window_set_title_count
                }
                set last_gtk_event $line
                if {$first_gtk_event eq ""} {
                    set first_gtk_event $line
                }
            }
        } elseif {[regexp {chromium_egl_trace phase=eglChooseConfig_enter } $line]} {
            incr choose_count
            set last_choose $line
            if {$first_choose eq ""} {
                set first_choose $line
            }
            if {[regexp { after_num=0([ \t]|$)} $line]} {
                incr choose_zero_count
            }
            set has_pbuffer [regexp {surface_bits=[^ ]*pbuffer} $line]
            set has_window [regexp {surface_bits=[^ ]*window} $line]
            if {$has_pbuffer} {
                incr choose_pbuffer_count
            }
            if {$has_window} {
                incr choose_window_count
            }
            if {$has_pbuffer && $has_window} {
                incr choose_window_pbuffer_count
            }
        } elseif {[regexp {chromium_egl_trace phase=eglChooseConfig_exit } $line]} {
            set last_choose $line
            if {$first_choose eq ""} {
                set first_choose $line
            }
            if {[regexp { num_config=0([ \t]|$)} $line]} {
                incr choose_zero_count
            }
        } elseif {[regexp {chromium_egl_trace phase=eglCreateContext_enter } $line]} {
            incr create_context_count
        } elseif {[regexp {chromium_egl_trace phase=eglCreatePbufferSurface_enter } $line]} {
            incr create_pbuffer_count
        } elseif {[regexp {chromium_egl_trace phase=eglCreateWindowSurface_enter } $line]} {
            incr create_window_count
        } elseif {[regexp {chromium_egl_trace phase=(eglMakeCurrent|eglSwapBuffers|eglSwapBuffersWithDamageEXT|eglSwapBuffersWithDamageKHR|eglCreateImage|eglCreateImageKHR|eglDestroyImage|eglDestroyImageKHR|wl_egl_window_create|wl_egl_window_resize|wl_egl_window_destroy|gbm_bo_create|gbm_bo_create_with_modifiers|gbm_bo_create_with_modifiers2|gbm_bo_import|gbm_bo_destroy) } $line -> graphics_phase]} {
            switch -- $graphics_phase {
                eglMakeCurrent {
                    incr egl_make_current_count
                }
                eglSwapBuffers {
                    incr egl_swap_buffers_count
                }
                eglSwapBuffersWithDamageEXT -
                eglSwapBuffersWithDamageKHR {
                    incr egl_swap_damage_count
                }
                eglCreateImage -
                eglCreateImageKHR {
                    incr egl_create_image_count
                    if {[regexp { failed=1([ \t]|$)} $line]} {
                        incr egl_create_image_fail_count
                    }
                }
                eglDestroyImage -
                eglDestroyImageKHR {
                    incr egl_destroy_image_count
                }
                wl_egl_window_create {
                    incr wl_egl_window_create_count
                }
                wl_egl_window_resize {
                    incr wl_egl_window_resize_count
                }
                wl_egl_window_destroy {
                    incr wl_egl_window_destroy_count
                }
                gbm_bo_create -
                gbm_bo_create_with_modifiers -
                gbm_bo_create_with_modifiers2 {
                    incr gbm_bo_create_count
                    if {[regexp { ret=\(nil\)([ \t]|$)} $line] ||
                        [regexp { ret=0x0([ \t]|$)} $line]} {
                        incr gbm_bo_create_fail_count
                    }
                }
                gbm_bo_import {
                    incr gbm_bo_import_count
                    if {[regexp { ret=\(nil\)([ \t]|$)} $line] ||
                        [regexp { ret=0x0([ \t]|$)} $line]} {
                        incr gbm_bo_import_fail_count
                    }
                }
                gbm_bo_destroy {
                    incr gbm_bo_destroy_count
                }
            }
            set last_graphics_buffer $line
            if {$first_graphics_buffer eq ""} {
                set first_graphics_buffer $line
            }
        }
    }

    set wayland_wire_summary "wayland_connect=$wayland_connect_count wayland_wire=$wayland_wire_count wayland_wire_write=$wayland_wire_write_count wayland_wire_writev=$wayland_wire_writev_count wayland_wire_send=$wayland_wire_send_count wayland_wire_sendto=$wayland_wire_sendto_count wayland_wire_sendmsg=$wayland_wire_sendmsg_count wayland_wire_unknown=$wayland_wire_unknown_count wayland_wire_drop=$wayland_wire_drop_count wayland_wire_callsite=$wayland_wire_callsite_count wayland_wire_create_surface=$wayland_wire_create_surface_count wayland_wire_get_xdg_surface=$wayland_wire_get_xdg_surface_count wayland_wire_get_toplevel=$wayland_wire_get_toplevel_count wayland_wire_surface_attach=$wayland_wire_surface_attach_count wayland_wire_surface_damage=$wayland_wire_surface_damage_count wayland_wire_surface_damage_buffer=$wayland_wire_surface_damage_buffer_count wayland_wire_surface_frame=$wayland_wire_surface_frame_count wayland_wire_surface_commit=$wayland_wire_surface_commit_count wayland_wire_xdg_ack_configure=$wayland_wire_xdg_ack_configure_count first_wayland_wire=[evidence_quote $first_wayland_wire] last_wayland_wire=[evidence_quote $last_wayland_wire]"
    set ioctl_request_summary "ioctl_drm_version=$ioctl_drm_version_count ioctl_virtgpu_getparam=$ioctl_virtgpu_getparam_count ioctl_virtgpu_context_init=$ioctl_virtgpu_context_init_count ioctl_virtgpu_resource_create=$ioctl_virtgpu_resource_create_count ioctl_virtgpu_resource_create_blob=$ioctl_virtgpu_resource_create_blob_count ioctl_virtgpu_execbuffer=$ioctl_virtgpu_execbuffer_count ioctl_virtgpu_resource_info=$ioctl_virtgpu_resource_info_count ioctl_virtgpu_wait=$ioctl_virtgpu_wait_count ioctl_virtgpu_get_caps=$ioctl_virtgpu_get_caps_count"
    set graphics_buffer_summary "egl_make_current=$egl_make_current_count egl_swap_buffers=$egl_swap_buffers_count egl_swap_damage=$egl_swap_damage_count egl_create_image=$egl_create_image_count egl_create_image_fail=$egl_create_image_fail_count egl_destroy_image=$egl_destroy_image_count wl_egl_window_create=$wl_egl_window_create_count wl_egl_window_resize=$wl_egl_window_resize_count wl_egl_window_destroy=$wl_egl_window_destroy_count gbm_bo_create=$gbm_bo_create_count gbm_bo_create_fail=$gbm_bo_create_fail_count gbm_bo_import=$gbm_bo_import_count gbm_bo_import_fail=$gbm_bo_import_fail_count gbm_bo_destroy=$gbm_bo_destroy_count first_graphics_buffer=[evidence_quote $first_graphics_buffer] last_graphics_buffer=[evidence_quote $last_graphics_buffer]"
    set wayland_marshal_callsite_count "$wayland_marshal_callsite_count $wayland_wire_summary $ioctl_request_summary $graphics_buffer_summary"

    return "available=1 init=$init_count process=$process_count process_browser=$process_browser_count process_renderer=$process_renderer_count process_gpu=$process_gpu_count process_zygote=$process_zygote_count process_gpu_use_gl=$process_gpu_use_gl_count process_gpu_use_angle=$process_gpu_use_angle_count process_gpu_disable_gpu_early_init=$process_gpu_disable_gpu_early_init_count process_gpu_trace_env=$process_gpu_trace_env_count process_gpu_log_env=$process_gpu_log_env_count process_gpu_env_egl_platform=$process_gpu_env_egl_platform_count process_gpu_env_ld_preload_trace=$process_gpu_env_ld_preload_trace_count open=$open_count open_fail=$open_fail_count openat=$openat_count openat_fail=$openat_fail_count render_open=$render_open_count browser_render_open=$browser_render_open_count gpu_render_open=$gpu_render_open_count zygote_render_open=$zygote_render_open_count proc_open=$proc_open_count proc_openat=$proc_openat_count proc_read=$proc_read_count proc_drop=$proc_drop_count proc_cmdline_read=$proc_cmdline_read_count proc_comm_read=$proc_comm_read_count proc_stat_read=$proc_stat_read_count proc_status_read=$proc_status_read_count prctl=$prctl_count prctl_set_name=$prctl_set_name_count prctl_get_name=$prctl_get_name_count ioctl=$ioctl_count ioctl_fail=$ioctl_fail_count browser_ioctl=$browser_ioctl_count gpu_ioctl=$gpu_ioctl_count zygote_ioctl=$zygote_ioctl_count ioctl_elapsed_us_sum=$ioctl_elapsed_us_sum ioctl_elapsed_us_max=$ioctl_elapsed_us_max execve=$execve_count execve_gpu=$execve_gpu_count execve_renderer=$execve_renderer_count execve_return=$execve_return_count execve_return_fail=$execve_return_fail_count fork=$fork_count browser_fork=$browser_fork_count gpu_fork=$gpu_fork_count zygote_fork=$zygote_fork_count vfork=$vfork_count socketpair=$socketpair_count browser_socketpair=$browser_socketpair_count gpu_socketpair=$gpu_socketpair_count zygote_socketpair=$zygote_socketpair_count ipc=$ipc_count ipc_read=$ipc_read_count ipc_write=$ipc_write_count ipc_send=$ipc_send_count ipc_recv=$ipc_recv_count ipc_sendmsg=$ipc_sendmsg_count ipc_recvmsg=$ipc_recvmsg_count ipc_close=$ipc_close_count ipc_drop=$ipc_drop_count ipc_fail=$ipc_fail_count ipc_callsite=$ipc_callsite_count ipc_cmsg=$ipc_cmsg_count ipc_scm_rights=$ipc_scm_rights_count ipc_scm_rights_fds=$ipc_scm_rights_fd_count ipc_scm_credentials=$ipc_scm_credentials_count ipc_cmsg_truncated=$ipc_cmsg_truncated_count ipc_bytes_sum=$ipc_bytes_sum epoll_create1=$epoll_create1_count epoll_ctl=$epoll_ctl_count epoll_wait=$epoll_wait_count epoll_pwait=$epoll_pwait_count epoll_ready=$epoll_ready_count epoll_drop=$epoll_drop_count epoll_callsite=$epoll_callsite_count wayland_marshal=$wayland_marshal_count wayland_marshal_flags=$wayland_marshal_flags_count wayland_marshal_array_flags=$wayland_marshal_array_flags_count wayland_marshal_legacy=$wayland_marshal_legacy_count wayland_marshal_constructor=$wayland_marshal_constructor_count wayland_marshal_array=$wayland_marshal_array_count wayland_marshal_array_constructor=$wayland_marshal_array_constructor_count wayland_marshal_drop=$wayland_marshal_drop_count wayland_marshal_callsite=$wayland_marshal_callsite_count wayland_create_surface=$wayland_create_surface_count wayland_get_xdg_surface=$wayland_get_xdg_surface_count wayland_get_toplevel=$wayland_get_toplevel_count wayland_surface_attach=$wayland_surface_attach_count wayland_surface_damage=$wayland_surface_damage_count wayland_surface_damage_buffer=$wayland_surface_damage_buffer_count wayland_surface_frame=$wayland_surface_frame_count wayland_surface_commit=$wayland_surface_commit_count wayland_xdg_ack_configure=$wayland_xdg_ack_configure_count gtk_event=$gtk_event_count gtk_drop=$gtk_drop_count gtk_dlsym=$gtk_dlsym_count gtk_widget_show=$gtk_widget_show_count gtk_widget_realize=$gtk_widget_realize_count gtk_widget_map=$gtk_widget_map_count gtk_widget_set_visible=$gtk_widget_set_visible_count gtk_window_present=$gtk_window_present_count gdk_window_show=$gdk_window_show_count gdk_window_ensure_native=$gdk_window_ensure_native_count gdk_wayland_surface_get=$gdk_wayland_surface_get_count gdk_window_set_title=$gdk_window_set_title_count browser_ipc=$browser_ipc_count gpu_ipc=$gpu_ipc_count zygote_ipc=$zygote_ipc_count egl_get_display=$egl_get_display_count egl_get_platform_display=$egl_get_platform_display_count egl_initialize=$egl_initialize_count egl_initialize_fail=$egl_initialize_fail_count egl_bind_api=$egl_bind_api_count egl_query_string=$egl_query_string_count egl_get_configs=$egl_get_configs_count egl_get_config_attrib=$egl_get_config_attrib_count egl_get_error=$egl_get_error_count gpu_egl_bootstrap=$gpu_egl_bootstrap_count getproc=$getproc_count getproc_traced=$getproc_traced_count getproc_choose=$getproc_choose_count getproc_create_context=$getproc_create_context_count getproc_create_pbuffer=$getproc_create_pbuffer_count getproc_create_window=$getproc_create_window_count dlsym=$dlsym_count dlsym_traced=$dlsym_traced_count dlsym_choose=$dlsym_choose_count dlsym_create_context=$dlsym_create_context_count dlsym_create_pbuffer=$dlsym_create_pbuffer_count dlsym_create_window=$dlsym_create_window_count dlopen=$dlopen_count choose=$choose_count choose_zero=$choose_zero_count choose_pbuffer=$choose_pbuffer_count choose_window=$choose_window_count choose_window_pbuffer=$choose_window_pbuffer_count create_context=$create_context_count create_pbuffer=$create_pbuffer_count create_window=$create_window_count first_process=[evidence_quote $first_process] last_process=[evidence_quote $last_process] first_gpu_process=[evidence_quote $first_gpu_process] last_gpu_process=[evidence_quote $last_gpu_process] first_gpu_env=[evidence_quote $first_gpu_env] last_gpu_env=[evidence_quote $last_gpu_env] first_open=[evidence_quote $first_open] last_open=[evidence_quote $last_open] first_proc=[evidence_quote $first_proc] last_proc=[evidence_quote $last_proc] first_prctl=[evidence_quote $first_prctl] last_prctl=[evidence_quote $last_prctl] first_ioctl=[evidence_quote $first_ioctl] last_ioctl=[evidence_quote $last_ioctl] first_execve=[evidence_quote $first_execve] last_execve=[evidence_quote $last_execve] first_fork=[evidence_quote $first_fork] last_fork=[evidence_quote $last_fork] first_socketpair=[evidence_quote $first_socketpair] last_socketpair=[evidence_quote $last_socketpair] first_ipc=[evidence_quote $first_ipc] last_ipc=[evidence_quote $last_ipc] first_epoll=[evidence_quote $first_epoll] last_epoll=[evidence_quote $last_epoll] first_wayland_marshal=[evidence_quote $first_wayland_marshal] last_wayland_marshal=[evidence_quote $last_wayland_marshal] first_gtk_event=[evidence_quote $first_gtk_event] last_gtk_event=[evidence_quote $last_gtk_event] first_egl_bootstrap=[evidence_quote $first_egl_bootstrap] last_egl_bootstrap=[evidence_quote $last_egl_bootstrap] first_getproc=[evidence_quote $first_getproc] last_getproc=[evidence_quote $last_getproc] first_dlsym=[evidence_quote $first_dlsym] last_dlsym=[evidence_quote $last_dlsym] first_dlopen=[evidence_quote $first_dlopen] last_dlopen=[evidence_quote $last_dlopen] first_choose=[evidence_quote $first_choose] last_choose=[evidence_quote $last_choose]"
}

proc chromium_mesa_egl_context_trace_summary {} {
    global chromium_mesa_egl_context_trace
    global wayland_chromium_log chromium_launch_probe_log chrome_debug_log
    global chromium_egl_trace_log runlog

    set candidate_paths [list $wayland_chromium_log $chromium_launch_probe_log $chrome_debug_log $chromium_egl_trace_log]
    set fallback_paths [list $runlog]
    set files_seen 0
    set files_with_trace 0
    set line_count 0
    set parse_exit_count 0
    set parse_fail_count 0
    set init_exit_count 0
    set init_fail_count 0
    set dri_enter_count 0
    set dri_exit_count 0
    set dri_fail_count 0
    set first_line ""
    set last_line ""
    set first_fail ""
    set last_fail ""

    foreach phase {primary fallback} {
        if {$phase eq "primary"} {
            set paths $candidate_paths
        } else {
            if {$line_count > 0} {
                break
            }
            set paths $fallback_paths
        }

        foreach path $paths {
            if {![file exists $path] || [file size $path] == 0} {
                continue
            }
            incr files_seen
            set file_has_trace 0
            foreach raw_line [split [read_text_file $path] "\n"] {
                set line [string trimright $raw_line "\r"]
                if {![regexp {xv6_mesa_egl_context_trace phase=} $line]} {
                    continue
                }
                if {!$file_has_trace} {
                    incr files_with_trace
                    set file_has_trace 1
                }
                incr line_count
                set last_line $line
                if {$first_line eq ""} {
                    set first_line $line
                }

                set failed 0
                if {[regexp { phase=parse_exit([ \t]|$)} $line]} {
                    incr parse_exit_count
                    if {![regexp { err_name=EGL_SUCCESS([ \t]|$)} $line]} {
                        incr parse_fail_count
                        set failed 1
                    }
                } elseif {[regexp { phase=init_exit([ \t]|$)} $line]} {
                    incr init_exit_count
                    if {![regexp { err_name=EGL_SUCCESS([ \t]|$)} $line]} {
                        incr init_fail_count
                        set failed 1
                    }
                } elseif {[regexp { phase=dri2_create_context_enter([ \t]|$)} $line]} {
                    incr dri_enter_count
                } elseif {[regexp { phase=dri2_create_context_exit([ \t]|$)} $line]} {
                    incr dri_exit_count
                    if {![regexp { dri_error_name=__DRI_CTX_ERROR_SUCCESS([ \t]|$)} $line]} {
                        incr dri_fail_count
                        set failed 1
                    }
                }

                if {$failed} {
                    set last_fail $line
                    if {$first_fail eq ""} {
                        set first_fail $line
                    }
                }
            }
        }
    }

    set available [expr {$line_count > 0 ? 1 : 0}]
    return "available=$available requested=$chromium_mesa_egl_context_trace files_seen=$files_seen files_with_trace=$files_with_trace line_count=$line_count parse_exit=$parse_exit_count parse_fail=$parse_fail_count init_exit=$init_exit_count init_fail=$init_fail_count dri_enter=$dri_enter_count dri_exit=$dri_exit_count dri_fail=$dri_fail_count first_line=[evidence_quote $first_line] last_line=[evidence_quote $last_line] first_fail=[evidence_quote $first_fail] last_fail=[evidence_quote $last_fail]"
}

proc chromium_kernel_lifecycle_role_counts {roles counts_var prefix} {
    upvar 1 $counts_var counts

    foreach {bit name} {
        0x2 child_process
        0x8 gpu
        0x10 renderer
        0x20 utility
        0x40 zygote
        0x80 browser
    } {
        if {($roles & $bit) != 0} {
            incr counts(${prefix}_${name})
        }
    }
}

proc chromium_kernel_lifecycle_summary {} {
    global runlog chromium_egl_trace_log

    if {![file exists $runlog]} {
        return "available=0"
    }

    set text [read_text_file $runlog]
    set clone_count 0
    set clone_process_count 0
    set clone_thread_count 0
    set clone_vfork_count 0
    set clone_vm_count 0
    set exec_count 0
    set exit_count 0
    set reap_count 0
    set wait_reap_count 0
    set waitpid_reap_count 0
    set waitid_reap_count 0
    set first_clone ""
    set last_clone ""
    set first_exec ""
    set last_exec ""
    set first_exit ""
    set last_exit ""
    set first_reap ""
    set last_reap ""
    array set counts {
        clone_child_process 0 clone_gpu 0 clone_renderer 0 clone_utility 0 clone_zygote 0 clone_browser 0
        exec_child_process 0 exec_gpu 0 exec_renderer 0 exec_utility 0 exec_zygote 0 exec_browser 0
        exit_child_process 0 exit_gpu 0 exit_renderer 0 exit_utility 0 exit_zygote 0 exit_browser 0
        reap_child_process 0 reap_gpu 0 reap_renderer 0 reap_utility 0 reap_zygote 0 reap_browser 0
    }
    array set cloned {}
    array set cloned_process {}
    array set cloned_pid {}
    array set cloned_fork_pid {}
    array set execed {}
    array set exited {}
    array set reaped {}

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        set clone_line_match 0
        if {[regexp {chrome-lifecycle: clone .* child_pid=([0-9]+).* process=([0-9]+).* vfork=([0-9]+).* vm=([0-9]+).* child_pid_seq=([0-9]+).* child_roles=0x([0-9a-fA-F]+)} $line -> child_pid process vfork vm pid_seq roles_hex]} {
            set clone_line_match 1
        } elseif {[regexp {child_pid=([0-9]+).* process=([0-9]+).* vfork=([0-9]+).* vm=([0-9]+).* child_pid_seq=([0-9]+).* child_roles=0x([0-9a-fA-F]+).* parent_exec='[^']*chrom} $line -> child_pid process vfork vm pid_seq roles_hex]} {
            set clone_line_match 1
        }
        if {$clone_line_match} {
            incr clone_count
            if {$process ne "0"} {
                incr clone_process_count
                set cloned_process($pid_seq) 1
            } else {
                incr clone_thread_count
            }
            if {$vfork ne "0"} {
                incr clone_vfork_count
            }
            if {$vm ne "0"} {
                incr clone_vm_count
            }
            set cloned($pid_seq) 1
            set cloned_pid($child_pid) 1
            if {$vfork eq "0"} {
                set cloned_fork_pid($child_pid) 1
            }
            scan $roles_hex "%x" roles
            chromium_kernel_lifecycle_role_counts $roles counts clone
            set last_clone $line
            if {$first_clone eq ""} {
                set first_clone $line
            }
        } elseif {[regexp {chrome-lifecycle: exec .* pid_seq=([0-9]+).* chrome_roles=0x([0-9a-fA-F]+)} $line -> pid_seq roles_hex]} {
            incr exec_count
            set execed($pid_seq) 1
            scan $roles_hex "%x" roles
            chromium_kernel_lifecycle_role_counts $roles counts exec
            set last_exec $line
            if {$first_exec eq ""} {
                set first_exec $line
            }
        } elseif {[regexp {chrome-lifecycle: exit .* pid_seq=([0-9]+).* roles=0x([0-9a-fA-F]+)} $line -> pid_seq roles_hex]} {
            incr exit_count
            set exited($pid_seq) 1
            scan $roles_hex "%x" roles
            chromium_kernel_lifecycle_role_counts $roles counts exit
            set last_exit $line
            if {$first_exit eq ""} {
                set first_exit $line
            }
        } elseif {[regexp {^(?:\[[0-9]+\] )?(wait|waitpid|waitid): reaping .* pid_seq=([0-9]+).* roles=0x([0-9a-fA-F]+)} $line -> kind pid_seq roles_hex]} {
            incr reap_count
            if {$kind eq "wait"} {
                incr wait_reap_count
            } elseif {$kind eq "waitpid"} {
                incr waitpid_reap_count
            } elseif {$kind eq "waitid"} {
                incr waitid_reap_count
            }
            set reaped($pid_seq) 1
            scan $roles_hex "%x" roles
            chromium_kernel_lifecycle_role_counts $roles counts reap
            set last_reap $line
            if {$first_reap eq ""} {
                set first_reap $line
            }
        }
    }

    set preload_fork_child_count 0
    set preload_fork_without_kernel_clone 0
    set kernel_clone_without_preload_fork 0
    set first_preload_fork_without_kernel_clone ""
    set first_kernel_clone_without_preload_fork ""
    array set preload_fork_pid {}
    if {[file exists $chromium_egl_trace_log]} {
        set egl_text [read_text_file $chromium_egl_trace_log]
        foreach raw_line [split $egl_text "\n"] {
            set line [string trimright $raw_line "\r"]
            if {[regexp {chromium_egl_trace phase=fork pid=[0-9]+ child=([0-9]+)} $line -> child_pid]} {
                if {![info exists preload_fork_pid($child_pid)]} {
                    incr preload_fork_child_count
                    set preload_fork_pid($child_pid) 1
                }
                if {![info exists cloned_fork_pid($child_pid)]} {
                    incr preload_fork_without_kernel_clone
                    if {$first_preload_fork_without_kernel_clone eq ""} {
                        set first_preload_fork_without_kernel_clone $line
                    }
                }
            }
        }
        foreach child_pid [array names cloned_fork_pid] {
            if {![info exists preload_fork_pid($child_pid)]} {
                incr kernel_clone_without_preload_fork
                if {$first_kernel_clone_without_preload_fork eq ""} {
                    set first_kernel_clone_without_preload_fork $child_pid
                }
            }
        }
    }

    set process_clone_still_live_or_unobserved 0
    set process_clone_no_exec_seen 0
    foreach pid_seq [array names cloned_process] {
        if {![info exists exited($pid_seq)]} {
            incr process_clone_still_live_or_unobserved
        }
        if {![info exists execed($pid_seq)]} {
            incr process_clone_no_exec_seen
        }
    }
    set exit_without_reap 0
    foreach pid_seq [array names exited] {
        if {![info exists reaped($pid_seq)]} {
            incr exit_without_reap
        }
    }

    return "available=1 clone=$clone_count clone_process=$clone_process_count clone_thread=$clone_thread_count clone_vfork=$clone_vfork_count clone_vm=$clone_vm_count exec=$exec_count exit=$exit_count reap=$reap_count wait_reap=$wait_reap_count waitpid_reap=$waitpid_reap_count waitid_reap=$waitid_reap_count preload_fork_child=$preload_fork_child_count preload_fork_without_kernel_clone=$preload_fork_without_kernel_clone kernel_clone_without_preload_fork=$kernel_clone_without_preload_fork first_preload_fork_without_kernel_clone=[evidence_quote $first_preload_fork_without_kernel_clone] first_kernel_clone_without_preload_fork=[evidence_quote $first_kernel_clone_without_preload_fork] process_clone_still_live_or_unobserved=$process_clone_still_live_or_unobserved process_clone_no_exec_seen=$process_clone_no_exec_seen exit_without_reap=$exit_without_reap clone_child_process=$counts(clone_child_process) clone_gpu=$counts(clone_gpu) clone_renderer=$counts(clone_renderer) clone_utility=$counts(clone_utility) clone_zygote=$counts(clone_zygote) clone_browser=$counts(clone_browser) exec_child_process=$counts(exec_child_process) exec_gpu=$counts(exec_gpu) exec_renderer=$counts(exec_renderer) exec_utility=$counts(exec_utility) exec_zygote=$counts(exec_zygote) exec_browser=$counts(exec_browser) exit_child_process=$counts(exit_child_process) exit_gpu=$counts(exit_gpu) exit_renderer=$counts(exit_renderer) exit_utility=$counts(exit_utility) exit_zygote=$counts(exit_zygote) exit_browser=$counts(exit_browser) reap_child_process=$counts(reap_child_process) reap_gpu=$counts(reap_gpu) reap_renderer=$counts(reap_renderer) reap_utility=$counts(reap_utility) reap_zygote=$counts(reap_zygote) reap_browser=$counts(reap_browser) first_clone=[evidence_quote $first_clone] last_clone=[evidence_quote $last_clone] first_exec=[evidence_quote $first_exec] last_exec=[evidence_quote $last_exec] first_exit=[evidence_quote $first_exit] last_exit=[evidence_quote $last_exit] first_reap=[evidence_quote $first_reap] last_reap=[evidence_quote $last_reap]"
}

proc chromium_role_bits_text {roles_hex} {
    if {$roles_hex eq "" || $roles_hex eq "missing"} {
        return "missing"
    }
    scan $roles_hex "%x" roles
    set names {}
    foreach {bit name} {
        0x1 network
        0x2 child
        0x4 audio
        0x8 gpu
        0x10 renderer
        0x20 utility
        0x40 zygote
        0x80 browser
    } {
        if {($roles & $bit) != 0} {
            lappend names $name
        }
    }
    if {[llength $names] == 0} {
        return "none"
    }
    return [join $names +]
}

proc chromium_compact_trace_path {path} {
    if {$path eq ""} {
        return "missing"
    }
    if {$path eq "(none)" || $path eq "(unknown)" ||
        $path eq "custom" || $path eq "pipe"} {
        return $path
    }
    return [chromium_short_value [file tail $path] 48]
}

proc chromium_zygote_admission_summary {} {
    global runlog wayland_chromium_log

    if {![file exists $runlog]} {
        return "available=0 reason=runlog-missing"
    }

    array set no_connection_pid {}
    if {[file exists $wayland_chromium_log]} {
        foreach raw_line [split [read_text_file $wayland_chromium_log] "\n"] {
            set line [string trimright $raw_line "\r"]
            if {[regexp {^\[([0-9]+):[0-9]+:.*Terminating current process after 15 seconds with no connection} $line -> pid]} {
                set no_connection_pid($pid) 1
            }
        }
    }

    set launch_ids {}
    set launch_count 0
    array set active_launch {}
    array set child_to_launch {}
    array set pending_browser_ack_child {}
    array set type_count {}
    array set launch_zygote {}
    array set launch_sockfd {}
    array set launch_type {}
    array set launch_utility {}
    array set launch_sandbox {}
    array set launch_renderer_client_id {}
    array set launch_gpu_client_id {}
    array set launch_identity_source {}
    array set launch_cmsg {}
    array set launch_bytes {}
    array set launch_child {}
    array set launch_line {}
    array set launch_scm_entries {}
    array set launch_scm_fds {}
    array set launch_fd_entries {}
    array set launch_fd_file_match_count {}
    array set launch_child_ping_fd {}
    array set launch_child_ping_line {}
    array set launch_browser_ping_cred {}
    array set launch_browser_ack_fd {}
    array set launch_zygote_ack_fd {}
    array set launch_child_iot_count {}
    array set launch_child_iot_first {}
    array set launch_child_iot_last {}
    array set launch_child_iot_mapped_fd {}
    array set launch_child_iot_mapped_fds {}
    array set scm_file {}
    array set scm_index {}
    set pending_launch_payloads {}

    foreach raw_line [split [read_text_file $runlog] "\n"] {
        set line [string trimright $raw_line "\r"]

        if {[regexp {chrome-unix-ipc-payload: ([^ ]+) pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) fd=([0-9]+) ret=([-0-9]+) total=([0-9]+) flags=0x[0-9a-fA-F]+ cmsg=([0-9]+).* roles=0x([0-9a-fA-F]+) type=([^ ]+) initial_client_fd=([^ ]+) utility=([^ ]+) sandbox=([^ ]+).* ascii="([^"]*)"} $line -> op pid tgid name fd ret total cmsg roles_hex ptype pfd putility psandbox ascii]} {
            scan $roles_hex "%x" roles
            set payload_renderer_client_id "missing"
            if {[regexp { renderer_client_id=([^ ]+)} $line -> got_renderer_client_id] &&
                $got_renderer_client_id ne "-"} {
                set payload_renderer_client_id $got_renderer_client_id
            }
            set payload_gpu_client_id "missing"
            if {[regexp { gpu_client_id=([^ ]+)} $line -> got_gpu_client_id] &&
                $got_gpu_client_id ne "-"} {
                set payload_gpu_client_id $got_gpu_client_id
            }
            if {$op eq "sendmsg-enter" && $ptype ne "-" && $cmsg > 0 &&
                ($payload_renderer_client_id ne "missing" ||
                 $payload_gpu_client_id ne "missing")} {
                lappend pending_launch_payloads [list $ptype $ret $payload_renderer_client_id $payload_gpu_client_id]
            }
            if {$op eq "recvmsg-done" && $pid eq $tgid &&
                ($roles & 0x40) != 0 && $ptype ne "-" && $cmsg > 0} {
                incr launch_count
                set id $launch_count
                lappend launch_ids $id
                set active_launch($pid) $id
                if {![info exists type_count($ptype)]} {
                    set type_count($ptype) 0
                }
                incr type_count($ptype)
                set launch_zygote($id) $pid
                set launch_sockfd($id) $fd
                set launch_type($id) $ptype
                set launch_utility($id) $putility
                set launch_sandbox($id) $psandbox
                set launch_renderer_client_id($id) $payload_renderer_client_id
                set launch_gpu_client_id($id) $payload_gpu_client_id
                set launch_identity_source($id) "recv"
                set pending_match -1
                for {set i 0} {$i < [llength $pending_launch_payloads]} {incr i} {
                    lassign [lindex $pending_launch_payloads $i] pending_type pending_ret pending_renderer_client_id pending_gpu_client_id
                    if {$pending_type eq $ptype && $pending_ret eq $ret} {
                        if {$launch_renderer_client_id($id) eq "missing" &&
                            $pending_renderer_client_id ne "missing"} {
                            set launch_renderer_client_id($id) $pending_renderer_client_id
                            set launch_identity_source($id) "send"
                        }
                        if {$launch_gpu_client_id($id) eq "missing" &&
                            $pending_gpu_client_id ne "missing"} {
                            set launch_gpu_client_id($id) $pending_gpu_client_id
                            set launch_identity_source($id) "send"
                        }
                        set pending_match $i
                        break
                    }
                }
                if {$pending_match >= 0} {
                    set pending_launch_payloads [lreplace $pending_launch_payloads $pending_match $pending_match]
                }
                set launch_cmsg($id) $cmsg
                set launch_bytes($id) $ret
                set launch_child($id) "missing"
                set launch_line($id) [chromium_short_value $line 220]
                set launch_scm_entries($id) {}
                set launch_scm_fds($id) {}
                set launch_fd_entries($id) {}
                set launch_fd_file_match_count($id) 0
                set launch_child_ping_fd($id) "missing"
                set launch_child_ping_line($id) ""
                set launch_browser_ping_cred($id) 0
                set launch_browser_ack_fd($id) "missing"
                set launch_zygote_ack_fd($id) "missing"
                set launch_child_iot_count($id) 0
                set launch_child_iot_first($id) ""
                set launch_child_iot_last($id) ""
                set launch_child_iot_mapped_fd($id) "missing"
                set launch_child_iot_mapped_fds($id) {}
            }

            if {$op eq "sendmsg-enter" &&
                [string first "CHILD_PING" $ascii] >= 0 &&
                [info exists child_to_launch($tgid)]} {
                set id $child_to_launch($tgid)
                set launch_child_ping_fd($id) $fd
                set launch_child_ping_line($id) [chromium_short_value $line 180]
            }

            if {$op eq "sendmsg-enter" && $ret eq "12" &&
                [info exists pending_browser_ack_child($tgid)]} {
                set child $pending_browser_ack_child($tgid)
                if {[info exists child_to_launch($child)]} {
                    set id $child_to_launch($child)
                    set launch_browser_ack_fd($id) $fd
                }
                unset pending_browser_ack_child($tgid)
            }

            if {$op eq "recvmsg-done" && $ret eq "12" &&
                [info exists active_launch($pid)]} {
                set id $active_launch($pid)
                if {$launch_child_ping_fd($id) ne "missing"} {
                    set launch_zygote_ack_fd($id) $fd
                }
            }
            continue
        }

        if {[regexp {chrome-unix-ipc: scm-recv pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) sockfd=([0-9]+) newfd=([-0-9]+) path=([^ ]+) file=([^ ]+) f_flags=0x([0-9a-fA-F]+) index=([0-9]+) cloexec=([0-9]+)} $line -> pid tgid name sockfd newfd path file fflags index cloexec]} {
            if {[info exists active_launch($pid)]} {
                set id $active_launch($pid)
                if {$sockfd eq $launch_sockfd($id) && $newfd >= 0} {
                    lappend launch_scm_fds($id) $newfd
                    lappend launch_scm_entries($id) "$index->$newfd/[chromium_compact_trace_path $path]/0x$fflags/ce$cloexec"
                    set scm_file($id,$newfd) $file
                    set scm_index($id,$newfd) $index
                }
            }
            continue
        }

        if {[regexp {chrome-lifecycle: clone parent_pid=([0-9]+) parent_tgid=([0-9]+).* child_pid=([0-9]+) child_tgid=([0-9]+).* child_roles=0x([0-9a-fA-F]+)} $line -> parent parent_tgid child child_tgid child_roles]} {
            if {[info exists active_launch($parent)]} {
                set id $active_launch($parent)
                if {$launch_child($id) eq "missing"} {
                    set launch_child($id) $child
                    set child_to_launch($child) $id
                }
            }
            continue
        }

        if {[regexp {chrome-fd-trace: fdtable-entry pid=([0-9]+) tag=clone-child-prewake-lite fd=([0-9]+) cloexec=([0-9]+) file=([^ ]+) kind=([0-9]+) f_flags=0x([0-9a-fA-F]+).* path=([^ ]+) target=(.*)} $line -> pid fd cloexec file kind fflags path target]} {
            if {[info exists child_to_launch($pid)]} {
                set id $child_to_launch($pid)
                if {[lsearch -exact $launch_scm_fds($id) $fd] >= 0} {
                    set file_match 0
                    if {[info exists scm_file($id,$fd)] && $scm_file($id,$fd) eq $file} {
                        set file_match 1
                        incr launch_fd_file_match_count($id)
                    }
                    set index "?"
                    if {[info exists scm_index($id,$fd)]} {
                        set index $scm_index($id,$fd)
                    }
                    lappend launch_fd_entries($id) "$index:$fd/[chromium_compact_trace_path $path]/0x$fflags/ce$cloexec/fm$file_match"
                }
            }
            continue
        }

        if {[regexp {chrome-unix-ipc: scm-emit-cred pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) fd=([0-9]+).* cred_pid=([0-9]+).* payload=([0-9]+)} $line -> pid tgid name fd cred_pid payload]} {
            if {$payload eq "11" && [info exists child_to_launch($cred_pid)]} {
                set id $child_to_launch($cred_pid)
                set launch_browser_ping_cred($id) 1
                set pending_browser_ack_child($tgid) $cred_pid
            }
            continue
        }

        if {[regexp {tgid=([0-9]+) name=Chrome_ChildIOT} $line -> tgid] &&
            [info exists child_to_launch($tgid)]} {
            set id $child_to_launch($tgid)
            incr launch_child_iot_count($id)
            if {$launch_child_iot_first($id) eq ""} {
                set launch_child_iot_first($id) [chromium_short_value $line 180]
            }
            set launch_child_iot_last($id) [chromium_short_value $line 180]
            set activity_fd ""
            if {[regexp { sockfd=([0-9]+)} $line -> got_fd]} {
                set activity_fd $got_fd
            } elseif {[regexp { fd=([0-9]+)} $line -> got_fd]} {
                set activity_fd $got_fd
            }
            if {$activity_fd ne "" &&
                [lsearch -exact $launch_scm_fds($id) $activity_fd] >= 0 &&
                $launch_child_iot_mapped_fd($id) eq "missing"} {
                set launch_child_iot_mapped_fd($id) $activity_fd
            }
            if {$activity_fd ne "" &&
                [lsearch -exact $launch_scm_fds($id) $activity_fd] >= 0 &&
                [lsearch -exact $launch_child_iot_mapped_fds($id) $activity_fd] < 0} {
                lappend launch_child_iot_mapped_fds($id) $activity_fd
            }
        }
    }

    set type_counts {}
    foreach type [lsort [array names type_count]] {
        lappend type_counts "$type:$type_count($type)"
    }
    if {[llength $type_counts] == 0} {
        set type_counts "none"
    } else {
        set type_counts [join $type_counts ,]
    }

    set launch_with_child 0
    set renderer_launch_count 0
    set renderer_with_child 0
    set no_connection_children 0
    set renderer_no_connection_children 0
    set utility_no_connection_children 0
    set child_ping_count 0
    set browser_ping_cred_count 0
    set browser_ack_count 0
    set zygote_ack_count 0
    set child_iot_count 0
    set full_fd_match_launch_count 0
    set full_file_match_launch_count 0
    set contexts {}

    foreach id $launch_ids {
        set is_renderer [expr {$launch_type($id) eq "renderer"}]
        if {$is_renderer} {
            incr renderer_launch_count
        }
        set child $launch_child($id)
        set no_connection 0
        if {$child ne "missing"} {
            incr launch_with_child
            if {$is_renderer} {
                incr renderer_with_child
            }
            if {[info exists no_connection_pid($child)]} {
                set no_connection 1
                incr no_connection_children
                if {$is_renderer} {
                    incr renderer_no_connection_children
                } elseif {$launch_type($id) eq "utility"} {
                    incr utility_no_connection_children
                }
            }
        }
        if {$launch_child_ping_fd($id) ne "missing"} {
            incr child_ping_count
        }
        if {$launch_browser_ping_cred($id)} {
            incr browser_ping_cred_count
        }
        if {$launch_browser_ack_fd($id) ne "missing"} {
            incr browser_ack_count
        }
        if {$launch_zygote_ack_fd($id) ne "missing"} {
            incr zygote_ack_count
        }
        if {$launch_child_iot_count($id) > 0} {
            incr child_iot_count
        }

        set scm_count [llength $launch_scm_entries($id)]
        set fd_match_count [llength $launch_fd_entries($id)]
        if {$scm_count > 0 && $fd_match_count == $scm_count} {
            incr full_fd_match_launch_count
        }
        if {$scm_count > 0 && $launch_fd_file_match_count($id) == $scm_count} {
            incr full_file_match_launch_count
        }

        if {[llength $contexts] < 12} {
            set scm_map [chromium_short_value [join $launch_scm_entries($id) |] 260]
            set fd_map [chromium_short_value [join $launch_fd_entries($id) |] 260]
            set child_iot_mapped_fds [join $launch_child_iot_mapped_fds($id) ,]
            if {$child_iot_mapped_fds eq ""} {
                set child_iot_mapped_fds "missing"
            }
            lappend contexts "id=$id,zygote=$launch_zygote($id),sockfd=$launch_sockfd($id),type=$launch_type($id),utility=$launch_utility($id),sandbox=$launch_sandbox($id),launch_renderer_client_id=$launch_renderer_client_id($id),launch_gpu_client_id=$launch_gpu_client_id($id),launch_identity_source=$launch_identity_source($id),bytes=$launch_bytes($id),cmsg=$launch_cmsg($id),child=$child,no_connection=$no_connection,scm=$scm_count,fd_matches=$fd_match_count,file_matches=$launch_fd_file_match_count($id),scm_map=$scm_map,child_fd_map=$fd_map,child_ping_fd=$launch_child_ping_fd($id),browser_ping_cred=$launch_browser_ping_cred($id),browser_ack_fd=$launch_browser_ack_fd($id),zygote_ack_fd=$launch_zygote_ack_fd($id),child_iot_events=$launch_child_iot_count($id),child_iot_mapped_fd=$launch_child_iot_mapped_fd($id),child_iot_mapped_fds=$child_iot_mapped_fds"
        }
    }

    return "available=1 launch_count=$launch_count type_counts=$type_counts renderer_launch_count=$renderer_launch_count launch_with_child=$launch_with_child renderer_with_child=$renderer_with_child no_connection_children=$no_connection_children renderer_no_connection_children=$renderer_no_connection_children utility_no_connection_children=$utility_no_connection_children child_ping_count=$child_ping_count browser_ping_cred_count=$browser_ping_cred_count browser_ack_count=$browser_ack_count zygote_ack_count=$zygote_ack_count child_iot_count=$child_iot_count full_fd_match_launch_count=$full_fd_match_launch_count full_file_match_launch_count=$full_file_match_launch_count contexts=[evidence_quote [join $contexts {;}]]"
}

proc chromium_mojo_child_iot_summary {} {
    global runlog

    if {![file exists $runlog]} {
        return "available=0 reason=runlog-missing"
    }

    set payload_lines 0
    set recv_lines 0
    set send_lines 0
    set child_iot_tgids {}
    set global_interfaces {}
    array set child_ping_seen {}
    array set roles_hex {}
    array set payload_count {}
    array set recv_count {}
    array set send_count {}
    array set cmsg_count {}
    array set bytes_in {}
    array set bytes_out {}
    array set fds_seen {}
    array set interfaces_seen {}
    array set interface_count {}
    array set first_payload {}
    array set last_payload {}

    foreach raw_line [split [read_text_file $runlog] "\n"] {
        set line [string trimright $raw_line "\r"]

        if {[regexp {chrome-unix-ipc-payload: sendmsg-enter pid=([0-9]+) tgid=([0-9]+).* ret=11 .* ascii="CHILD_PING\.} $line -> pid tgid]} {
            set child_ping_seen($tgid) 1
        }

        if {![regexp {chrome-unix-ipc-payload: ([^ ]+) pid=([0-9]+) tgid=([0-9]+) name=Chrome_ChildIOT fd=([0-9]+) ret=([-0-9]+) total=([0-9]+).* cmsg=([0-9]+).* roles=0x([0-9a-fA-F]+).* ascii="([^"]*)"} $line -> op pid tgid fd ret total cmsg roles ascii]} {
            continue
        }

        incr payload_lines
        set child_iot_tgids [chromium_unique_append $child_iot_tgids $tgid]
        set roles_hex($tgid) $roles
        if {![info exists payload_count($tgid)]} {
            set payload_count($tgid) 0
            set recv_count($tgid) 0
            set send_count($tgid) 0
            set cmsg_count($tgid) 0
            set bytes_in($tgid) 0
            set bytes_out($tgid) 0
            set fds_seen($tgid) {}
            set interfaces_seen($tgid) {}
            set first_payload($tgid) ""
            set last_payload($tgid) ""
        }

        incr payload_count($tgid)
        set fds_seen($tgid) [chromium_unique_append $fds_seen($tgid) $fd]
        if {$cmsg > 0} {
            incr cmsg_count($tgid)
        }
        if {$first_payload($tgid) eq ""} {
            set first_payload($tgid) [chromium_short_value $line 180]
        }
        set last_payload($tgid) [chromium_short_value $line 180]

        if {$op eq "recvmsg-done"} {
            incr recv_lines
            incr recv_count($tgid)
            if {[string is integer -strict $ret] && $ret > 0} {
                set bytes_in($tgid) [expr {$bytes_in($tgid) + $ret}]
            }
        } elseif {$op eq "sendmsg-enter"} {
            incr send_lines
            incr send_count($tgid)
            if {[string is integer -strict $ret] && $ret > 0} {
                set bytes_out($tgid) [expr {$bytes_out($tgid) + $ret}]
            }
        }

        foreach iface [regexp -all -inline {[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*\.mojom\.[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*} $ascii] {
            set global_interfaces [chromium_unique_append $global_interfaces $iface]
            set interfaces_seen($tgid) [chromium_unique_append $interfaces_seen($tgid) $iface]
            if {![info exists interface_count($iface)]} {
                set interface_count($iface) 0
            }
            incr interface_count($iface)
        }
    }

    set interface_counts {}
    foreach iface [lsort $global_interfaces] {
        lappend interface_counts "$iface:$interface_count($iface)"
    }
    if {[llength $interface_counts] == 0} {
        set interface_counts "none"
    } else {
        set interface_counts [chromium_short_value [join $interface_counts ,] 420]
    }

    set contexts {}
    foreach tgid [lsort -integer $child_iot_tgids] {
        set child_ping [expr {[info exists child_ping_seen($tgid)] ? 1 : 0}]
        set iface_text [join [lsort $interfaces_seen($tgid)] |]
        if {$iface_text eq ""} {
            set iface_text "none"
        } else {
            set iface_text [chromium_short_value $iface_text 220]
        }
        set fd_text [join [lsort -integer $fds_seen($tgid)] ,]
        if {$fd_text eq ""} {
            set fd_text "missing"
        }
        if {[llength $contexts] < 12} {
            lappend contexts "tgid=$tgid,roles=[chromium_role_bits_text $roles_hex($tgid)],child_ping=$child_ping,payloads=$payload_count($tgid),recv=$recv_count($tgid),send=$send_count($tgid),cmsg_payloads=$cmsg_count($tgid),bytes_in=$bytes_in($tgid),bytes_out=$bytes_out($tgid),fds=$fd_text,interfaces=$iface_text,first=[chromium_short_value $first_payload($tgid) 140],last=[chromium_short_value $last_payload($tgid) 140]"
        }
    }

    return "available=1 payload_lines=$payload_lines recv_lines=$recv_lines send_lines=$send_lines child_iot_tgid_count=[llength $child_iot_tgids] interface_count=[llength $global_interfaces] interface_counts=$interface_counts contexts=[evidence_quote [join $contexts {;}]]"
}

proc chromium_mojo_browser_milestone_summary {} {
    global runlog

    if {![file exists $runlog]} {
        return "available=0 reason=runlog-missing"
    }

    set milestones {
        content.mojom.RenderMessageFilter
        blink.mojom.LocalFrameHost
        blink.mojom.LocalMainFrameHost
        gpu.mojom.GpuChannel
        font_service.mojom.FontService
        chrome.mojom.RendererConfiguration
        content.mojom.RendererVariationsConfiguration
        visitedlink.mojom.VisitedLinkNotificationSink
        metrics.mojom.ChildHistogramFetcherFactory
    }
    array set milestone_wanted {}
    array set milestone_count {}
    array set milestone_tgids {}
    array set milestone_roles {}
    array set milestone_names {}
    array set milestone_fds {}
    array set milestone_first {}
    array set milestone_last {}
    foreach iface $milestones {
        set milestone_wanted($iface) 1
        set milestone_count($iface) 0
        set milestone_tgids($iface) {}
        set milestone_roles($iface) {}
        set milestone_names($iface) {}
        set milestone_fds($iface) {}
        set milestone_first($iface) ""
        set milestone_last($iface) ""
    }

    set payload_lines 0
    set parsed_payload_lines 0
    set interface_lines 0
    set recv_lines 0
    set send_lines 0
    set milestone_lines 0
    set global_interfaces {}
    array set interface_count {}

    foreach raw_line [split [read_text_file $runlog] "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[string first "chrome-unix-ipc-payload:" $line] < 0} {
            continue
        }
        incr payload_lines

        if {![regexp {chrome-unix-ipc-payload: ([^ ]+) pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) fd=([0-9]+) ret=([-0-9]+) total=([0-9]+).* cmsg=([0-9]+).* roles=0x([0-9a-fA-F]+).* ascii="([^"]*)"} $line -> op pid tgid name fd ret total cmsg roles ascii]} {
            continue
        }

        incr parsed_payload_lines
        if {$op eq "recvmsg-done"} {
            incr recv_lines
        } elseif {$op eq "sendmsg-enter"} {
            incr send_lines
        }

        set ifaces [regexp -all -inline {[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*\.mojom\.[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*} $ascii]
        if {[llength $ifaces] == 0} {
            continue
        }
        incr interface_lines

        set line_has_milestone 0
        foreach iface $ifaces {
            set global_interfaces [chromium_unique_append $global_interfaces $iface]
            if {![info exists interface_count($iface)]} {
                set interface_count($iface) 0
            }
            incr interface_count($iface)

            if {![info exists milestone_wanted($iface)]} {
                continue
            }
            incr milestone_count($iface)
            set milestone_tgids($iface) [chromium_unique_append $milestone_tgids($iface) $tgid]
            set milestone_roles($iface) [chromium_unique_append $milestone_roles($iface) [chromium_role_bits_text $roles]]
            set milestone_names($iface) [chromium_unique_append $milestone_names($iface) $name]
            set milestone_fds($iface) [chromium_unique_append $milestone_fds($iface) $fd]
            if {$milestone_first($iface) eq ""} {
                set milestone_first($iface) "tgid=$tgid,pid=$pid,name=$name,fd=$fd,op=$op,ret=$ret,total=$total,cmsg=$cmsg,roles=[chromium_role_bits_text $roles],line=[chromium_short_value $line 140]"
            }
            set milestone_last($iface) "tgid=$tgid,pid=$pid,name=$name,fd=$fd,op=$op,ret=$ret,total=$total,cmsg=$cmsg,roles=[chromium_role_bits_text $roles],line=[chromium_short_value $line 140]"
            set line_has_milestone 1
        }
        if {$line_has_milestone} {
            incr milestone_lines
        }
    }

    set interface_counts {}
    foreach iface [lsort $global_interfaces] {
        lappend interface_counts "$iface:$interface_count($iface)"
    }
    if {[llength $interface_counts] == 0} {
        set interface_counts "none"
    } else {
        set interface_counts [chromium_short_value [join $interface_counts ,] 420]
    }

    set milestone_counts {}
    set present_milestones {}
    set missing_milestones {}
    set contexts {}
    foreach iface $milestones {
        lappend milestone_counts "$iface:$milestone_count($iface)"
        if {$milestone_count($iface) > 0} {
            set present_milestones [chromium_unique_append $present_milestones $iface]
            if {[llength $contexts] < 12} {
                set tgids [join [lsort -integer $milestone_tgids($iface)] ,]
                set roles [join [lsort $milestone_roles($iface)] |]
                set names [join [lsort $milestone_names($iface)] |]
                set fds [join [lsort -integer $milestone_fds($iface)] ,]
                lappend contexts "iface=$iface,count=$milestone_count($iface),tgids=$tgids,roles=$roles,names=$names,fds=$fds,first=[chromium_short_value $milestone_first($iface) 180],last=[chromium_short_value $milestone_last($iface) 180]"
            }
        } else {
            set missing_milestones [chromium_unique_append $missing_milestones $iface]
        }
    }

    set present_text [join $present_milestones |]
    if {$present_text eq ""} {
        set present_text "none"
    }
    set missing_text [join $missing_milestones |]
    if {$missing_text eq ""} {
        set missing_text "none"
    }

    return "available=1 payload_lines=$payload_lines parsed_payload_lines=$parsed_payload_lines interface_lines=$interface_lines recv_lines=$recv_lines send_lines=$send_lines unique_interface_count=[llength $global_interfaces] interface_counts=$interface_counts milestone_lines=$milestone_lines milestone_counts=[join $milestone_counts ,] present_milestones=$present_text missing_milestones=$missing_text contexts=[evidence_quote [join $contexts {;}]]"
}

proc chromium_browser_fd_milestone_timeline_summary {} {
    global runlog

    if {![file exists $runlog]} {
        return "available=0 reason=runlog-missing"
    }

    set linux_milestones {
        content.mojom.RenderMessageFilter
        blink.mojom.LocalFrameHost
        blink.mojom.LocalMainFrameHost
        gpu.mojom.GpuChannel
        font_service.mojom.FontService
    }
    set tracked_milestones {
        content.mojom.RenderMessageFilter
        blink.mojom.LocalFrameHost
        blink.mojom.LocalMainFrameHost
        gpu.mojom.GpuChannel
        font_service.mojom.FontService
        content.mojom.FrameHost
        blink.mojom.NonAssociatedLocalFrameHost
        blink.mojom.DomStorageProvider
        blink.mojom.RendererAudioOutputStreamFactory
        network.mojom.NetworkService
        storage.mojom.StorageService
        device.mojom.TimeZoneMonitor
    }
    array set tracked {}
    array set milestone_count {}
    array set milestone_first_ts {}
    foreach iface $tracked_milestones {
        set tracked($iface) 1
        set milestone_count($iface) 0
        set milestone_first_ts($iface) "missing"
    }

    set payload_lines 0
    set parsed_payload_lines 0
    set browser_payload_lines 0
    set recv_lines 0
    set send_lines 0
    set cmsg_payloads 0
    set truncated_payloads 0
    set browser_fds {}
    array set fd_payload_count {}
    array set fd_recv_count {}
    array set fd_send_count {}
    array set fd_cmsg_count {}
    array set fd_truncated_count {}
    array set fd_bytes_in {}
    array set fd_bytes_out {}
    array set fd_first_ts {}
    array set fd_last_ts {}
    array set fd_interfaces {}
    array set fd_timeline {}
    array set fd_iface_count {}
    array set fd_iface_first_ts {}
    array set fd_iface_first_context {}

    foreach raw_line [split [read_text_file $runlog] "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[string first "chrome-unix-ipc-payload:" $line] < 0} {
            continue
        }
        incr payload_lines

        set ts "missing"
        if {[regexp {^\[([0-9]+)\]} $line -> got_ts]} {
            set ts $got_ts
        }

        if {![regexp {chrome-unix-ipc-payload: ([^ ]+) pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) fd=([0-9]+) ret=([-0-9]+) total=([0-9]+).* cmsg=([0-9]+).* roles=0x([0-9a-fA-F]+).* ascii="([^"]*)"} $line -> op pid tgid name fd ret total cmsg roles_hex ascii]} {
            continue
        }
        incr parsed_payload_lines

        scan $roles_hex "%x" roles
        if {$name ne "Chrome_IOThread" || ($roles & 0x80) == 0} {
            continue
        }
        incr browser_payload_lines
        set browser_fds [chromium_unique_append $browser_fds $fd]
        if {![info exists fd_payload_count($fd)]} {
            set fd_payload_count($fd) 0
            set fd_recv_count($fd) 0
            set fd_send_count($fd) 0
            set fd_cmsg_count($fd) 0
            set fd_truncated_count($fd) 0
            set fd_bytes_in($fd) 0
            set fd_bytes_out($fd) 0
            set fd_first_ts($fd) "missing"
            set fd_last_ts($fd) "missing"
            set fd_interfaces($fd) {}
            set fd_timeline($fd) {}
        }

        incr fd_payload_count($fd)
        if {$fd_first_ts($fd) eq "missing"} {
            set fd_first_ts($fd) $ts
        }
        set fd_last_ts($fd) $ts
        if {$cmsg > 0} {
            incr cmsg_payloads
            incr fd_cmsg_count($fd)
        }
        set sample_len "missing"
        set full_len "missing"
        if {[regexp { sample_len=([0-9]+) full_len=([0-9]+)} $line -> sample_len full_len] &&
            $full_len > $sample_len} {
            incr truncated_payloads
            incr fd_truncated_count($fd)
        }
        if {$op eq "recvmsg-done"} {
            incr recv_lines
            incr fd_recv_count($fd)
            if {[string is integer -strict $ret] && $ret > 0} {
                set fd_bytes_in($fd) [expr {$fd_bytes_in($fd) + $ret}]
            }
        } elseif {$op eq "sendmsg-enter"} {
            incr send_lines
            incr fd_send_count($fd)
            if {[string is integer -strict $ret] && $ret > 0} {
                set fd_bytes_out($fd) [expr {$fd_bytes_out($fd) + $ret}]
            }
        }

        foreach iface [regexp -all -inline {[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*\.mojom\.[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*} $ascii] {
            set fd_interfaces($fd) [chromium_unique_append $fd_interfaces($fd) $iface]
            if {![info exists tracked($iface)]} {
                continue
            }
            incr milestone_count($iface)
            if {$milestone_first_ts($iface) eq "missing"} {
                set milestone_first_ts($iface) $ts
            }
            set key "$fd,$iface"
            if {![info exists fd_iface_count($key)]} {
                set fd_iface_count($key) 0
                set fd_iface_first_ts($key) $ts
                set fd_iface_first_context($key) "ts=$ts,pid=$pid,tgid=$tgid,fd=$fd,op=$op,ret=$ret,total=$total,cmsg=$cmsg,roles=[chromium_role_bits_text $roles_hex],line=[chromium_short_value $line 140]"
                lappend fd_timeline($fd) "$iface@$ts"
            }
            incr fd_iface_count($key)
        }
    }

    set milestone_counts {}
    set milestone_firsts {}
    foreach iface $tracked_milestones {
        lappend milestone_counts "$iface:$milestone_count($iface)"
        if {$milestone_count($iface) > 0} {
            lappend milestone_firsts "$iface@$milestone_first_ts($iface)"
        }
    }
    if {[llength $milestone_firsts] == 0} {
        set milestone_firsts "none"
    } else {
        set milestone_firsts [join $milestone_firsts ,]
    }

    set present_linux_milestones {}
    set missing_linux_milestones {}
    set linux_milestone_counts {}
    foreach iface $linux_milestones {
        lappend linux_milestone_counts "$iface:$milestone_count($iface)"
        if {$milestone_count($iface) > 0} {
            set present_linux_milestones [chromium_unique_append $present_linux_milestones $iface]
        } else {
            set missing_linux_milestones [chromium_unique_append $missing_linux_milestones $iface]
        }
    }
    set present_text [join $present_linux_milestones |]
    if {$present_text eq ""} {
        set present_text "none"
    }
    set missing_text [join $missing_linux_milestones |]
    if {$missing_text eq ""} {
        set missing_text "none"
    }

    set interesting_fd_count 0
    set contexts {}
    foreach fd [lsort -integer $browser_fds] {
        set timeline [join $fd_timeline($fd) >]
        if {$timeline eq ""} {
            set timeline "none"
        } else {
            incr interesting_fd_count
        }
        set iface_text [join [lsort $fd_interfaces($fd)] |]
        if {$iface_text eq ""} {
            set iface_text "none"
        } else {
            set iface_text [chromium_short_value $iface_text 260]
        }
        if {$timeline ne "none" && [llength $contexts] < 12} {
            set first_contexts {}
            foreach iface $tracked_milestones {
                set key "$fd,$iface"
                if {[info exists fd_iface_count($key)]} {
                    lappend first_contexts "$iface:$fd_iface_count($key):[chromium_short_value $fd_iface_first_context($key) 120]"
                }
            }
            lappend contexts "fd=$fd,payloads=$fd_payload_count($fd),recv=$fd_recv_count($fd),send=$fd_send_count($fd),cmsg_payloads=$fd_cmsg_count($fd),truncated=$fd_truncated_count($fd),bytes_in=$fd_bytes_in($fd),bytes_out=$fd_bytes_out($fd),first_ts=$fd_first_ts($fd),last_ts=$fd_last_ts($fd),timeline=$timeline,interfaces=$iface_text,first_contexts=[chromium_short_value [join $first_contexts |] 560]"
        }
    }

    return "available=1 payload_lines=$payload_lines parsed_payload_lines=$parsed_payload_lines browser_payload_lines=$browser_payload_lines browser_fd_count=[llength $browser_fds] interesting_fd_count=$interesting_fd_count recv_lines=$recv_lines send_lines=$send_lines cmsg_payloads=$cmsg_payloads truncated_payloads=$truncated_payloads linux_milestone_counts=[join $linux_milestone_counts ,] present_linux_milestones=$present_text missing_linux_milestones=$missing_text milestone_counts=[join $milestone_counts ,] milestone_firsts=$milestone_firsts contexts=[evidence_quote [join $contexts {;}]]"
}

proc chromium_browser_fd_linux_correlation_summary {} {
    global runlog

    if {![file exists $runlog]} {
        return "available=0 reason=runlog-missing"
    }

    set linux_fd115_milestones {
        content.mojom.RenderMessageFilter
        blink.mojom.LocalFrameHost
        blink.mojom.LocalMainFrameHost
    }
    set partial_frame_milestones {
        content.mojom.FrameHost
        blink.mojom.NonAssociatedLocalFrameHost
        blink.mojom.DomStorageProvider
        blink.mojom.RendererAudioOutputStreamFactory
    }
    set linux_gpu_font_milestones {
        gpu.mojom.GpuChannel
        font_service.mojom.FontService
    }
    set control_milestones {
        device.mojom.TimeZoneMonitor
    }
    set tracked_milestones [concat $linux_fd115_milestones $partial_frame_milestones $linux_gpu_font_milestones $control_milestones]
    array set tracked {}
    foreach iface $tracked_milestones {
        set tracked($iface) 1
    }

    set payload_lines 0
    set parsed_payload_lines 0
    set browser_payload_lines 0
    set browser_keys {}
    set browser_fds {}
    array set fd_payload_count {}
    array set fd_recv_count {}
    array set fd_send_count {}
    array set fd_cmsg_count {}
    array set fd_truncated_count {}
    array set fd_bytes_in {}
    array set fd_bytes_out {}
    array set fd_first_ts {}
    array set fd_last_ts {}
    array set fd_names {}
    array set fd_interfaces {}
    array set fd_timeline {}
    array set fd_iface_count {}
    array set fd_iface_first_ts {}
    array set fd_iface_first_context {}
    array set fd_state_event_count {}
    array set fd_state_recv_count {}
    array set fd_state_send_count {}
    array set fd_state_first_ts {}
    array set fd_state_last_ts {}
    array set fd_last_state {}

    foreach raw_line [split [read_text_file $runlog] "\n"] {
        set line [string trimright $raw_line "\r"]
        set ts "missing"
        if {[regexp {^\[([0-9]+)\]} $line -> got_ts]} {
            set ts $got_ts
        }

        if {[string first "chrome-unix-ipc-payload:" $line] >= 0} {
            incr payload_lines
            if {![regexp {chrome-unix-ipc-payload: ([^ ]+) pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) fd=([0-9]+) ret=([-0-9]+) total=([0-9]+).* cmsg=([0-9]+).* roles=0x([0-9a-fA-F]+).* ascii="([^"]*)"} $line -> op pid tgid name fd ret total cmsg roles_hex ascii]} {
                continue
            }
            incr parsed_payload_lines

            scan $roles_hex "%x" roles
            if {($roles & 0x80) == 0} {
                continue
            }
            incr browser_payload_lines

            set key "$tgid,$fd"
            set browser_keys [chromium_unique_append $browser_keys $key]
            set browser_fds [chromium_unique_append $browser_fds $fd]
            if {![info exists fd_payload_count($key)]} {
                set fd_payload_count($key) 0
                set fd_recv_count($key) 0
                set fd_send_count($key) 0
                set fd_cmsg_count($key) 0
                set fd_truncated_count($key) 0
                set fd_bytes_in($key) 0
                set fd_bytes_out($key) 0
                set fd_first_ts($key) "missing"
                set fd_last_ts($key) "missing"
                set fd_names($key) {}
                set fd_interfaces($key) {}
                set fd_timeline($key) {}
            }

            incr fd_payload_count($key)
            if {$fd_first_ts($key) eq "missing"} {
                set fd_first_ts($key) $ts
            }
            set fd_last_ts($key) $ts
            set fd_names($key) [chromium_unique_append $fd_names($key) $name]
            if {$cmsg > 0} {
                incr fd_cmsg_count($key)
            }
            set sample_len "missing"
            set full_len "missing"
            if {[regexp { sample_len=([0-9]+) full_len=([0-9]+)} $line -> sample_len full_len] &&
                $full_len > $sample_len} {
                incr fd_truncated_count($key)
            }
            if {$op eq "recvmsg-done"} {
                incr fd_recv_count($key)
                if {[string is integer -strict $ret] && $ret > 0} {
                    set fd_bytes_in($key) [expr {$fd_bytes_in($key) + $ret}]
                }
            } elseif {$op eq "sendmsg-enter"} {
                incr fd_send_count($key)
                if {[string is integer -strict $ret] && $ret > 0} {
                    set fd_bytes_out($key) [expr {$fd_bytes_out($key) + $ret}]
                }
            }

            foreach iface [regexp -all -inline {[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*\.mojom\.[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*} $ascii] {
                set fd_interfaces($key) [chromium_unique_append $fd_interfaces($key) $iface]
                if {![info exists tracked($iface)]} {
                    continue
                }
                if {![info exists fd_iface_count($key,$iface)]} {
                    set fd_iface_count($key,$iface) 0
                    set fd_iface_first_ts($key,$iface) $ts
                    set fd_iface_first_context($key,$iface) "ts=$ts,pid=$pid,tgid=$tgid,name=$name,fd=$fd,op=$op,ret=$ret,total=$total,cmsg=$cmsg,roles=[chromium_role_bits_text $roles_hex],line=[chromium_short_value $line 140]"
                    lappend fd_timeline($key) "$iface@$ts"
                }
                incr fd_iface_count($key,$iface)
            }
            continue
        }

        set state_match 0
        if {[regexp {chrome-unix-ipc: ([^ ]+) pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) fd=([0-9]+)} $line -> op pid tgid name fd]} {
            set state_match 1
        } elseif {[regexp {chrome-unix-ipc: ([^ ]+) pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) sockfd=([0-9]+)} $line -> op pid tgid name fd]} {
            set state_match 1
        }
        if {!$state_match} {
            continue
        }

        set key "$tgid,$fd"
        if {![info exists fd_state_event_count($key)]} {
            set fd_state_event_count($key) 0
            set fd_state_recv_count($key) 0
            set fd_state_send_count($key) 0
            set fd_state_first_ts($key) "missing"
            set fd_state_last_ts($key) "missing"
            set fd_last_state($key) "missing"
        }
        incr fd_state_event_count($key)
        if {$fd_state_first_ts($key) eq "missing"} {
            set fd_state_first_ts($key) $ts
        }
        set fd_state_last_ts($key) $ts
        if {$op eq "recvmsg-done"} {
            incr fd_state_recv_count($key)
        } elseif {$op eq "sendmsg-exit"} {
            incr fd_state_send_count($key)
        }

        set ret "missing"
        if {[regexp { ret=([-0-9]+)} $line -> got_ret]} {
            set ret $got_ret
        }
        if {[regexp {sk_shutdown=([^ ]+).* sk_err=([^ ]+).* sk_tx=([^ ]+).* sk_marks=([^ ]+).* peer_shutdown=([^ ]+).* peer_err=([^ ]+).* peer_tx=([^ ]+).* peer_marks=([^ ]+).* ready=([^ ]+)} $line -> sk_shutdown sk_err sk_tx sk_marks peer_shutdown peer_err peer_tx peer_marks ready]} {
            set fd_last_state($key) "op=$op,ret=$ret,sk_shutdown=$sk_shutdown,sk_err=$sk_err,sk_tx=$sk_tx,sk_marks=$sk_marks,peer_shutdown=$peer_shutdown,peer_err=$peer_err,peer_tx=$peer_tx,peer_marks=$peer_marks,ready=$ready"
        }
    }

    set best_fd115_key "missing"
    set best_fd115_score -1
    set gpu_keys {}
    set contexts {}
    foreach key [lsort $browser_keys] {
        set score 0
        foreach iface $linux_fd115_milestones {
            if {[info exists fd_iface_count($key,$iface)]} {
                incr score 5
            }
        }
        foreach iface $partial_frame_milestones {
            if {[info exists fd_iface_count($key,$iface)]} {
                incr score 2
            }
        }
        if {[info exists fd_iface_count($key,blink.mojom.LocalFrameHost)]} {
            incr score 10
        }
        if {$score > $best_fd115_score} {
            set best_fd115_score $score
            set best_fd115_key $key
        }
        foreach iface $linux_gpu_font_milestones {
            if {[info exists fd_iface_count($key,$iface)]} {
                set gpu_keys [chromium_unique_append $gpu_keys $key]
            }
        }
    }
    if {$best_fd115_score <= 0} {
        set best_fd115_key "missing"
    }

    set fd115_present {}
    set fd115_missing $linux_fd115_milestones
    set fd115_partial_present {}
    set fd115_state "missing"
    set fd115_analogue "missing"
    if {$best_fd115_key ne "missing"} {
        set parts [split $best_fd115_key ,]
        set fd115_analogue "tgid=[lindex $parts 0]/fd=[lindex $parts 1]"
        set fd115_missing {}
        foreach iface $linux_fd115_milestones {
            if {[info exists fd_iface_count($best_fd115_key,$iface)]} {
                set fd115_present [chromium_unique_append $fd115_present $iface]
            } else {
                set fd115_missing [chromium_unique_append $fd115_missing $iface]
            }
        }
        foreach iface $partial_frame_milestones {
            if {[info exists fd_iface_count($best_fd115_key,$iface)]} {
                set fd115_partial_present [chromium_unique_append $fd115_partial_present $iface]
            }
        }
        if {[info exists fd_last_state($best_fd115_key)]} {
            set fd115_state [chromium_short_value $fd_last_state($best_fd115_key) 260]
        }
    }

    set fd115_present_text [join $fd115_present |]
    if {$fd115_present_text eq ""} {
        set fd115_present_text "none"
    }
    set fd115_missing_text [join $fd115_missing |]
    if {$fd115_missing_text eq ""} {
        set fd115_missing_text "none"
    }
    set fd115_partial_text [join $fd115_partial_present |]
    if {$fd115_partial_text eq ""} {
        set fd115_partial_text "none"
    }

    set gpu_analogue_parts {}
    set gpu_missing_union {}
    foreach key [lsort $gpu_keys] {
        set parts [split $key ,]
        lappend gpu_analogue_parts "tgid=[lindex $parts 0]/fd=[lindex $parts 1]"
        foreach iface $linux_gpu_font_milestones {
            if {![info exists fd_iface_count($key,$iface)]} {
                set gpu_missing_union [chromium_unique_append $gpu_missing_union $iface]
            }
        }
    }
    set gpu_analogue_text [join $gpu_analogue_parts ,]
    if {$gpu_analogue_text eq ""} {
        set gpu_analogue_text "missing"
    }
    set gpu_missing_text [join $gpu_missing_union |]
    if {$gpu_missing_text eq ""} {
        set gpu_missing_text "none"
    }

    foreach key [lsort $browser_keys] {
        set parts [split $key ,]
        set tgid [lindex $parts 0]
        set fd [lindex $parts 1]
        set linux_present {}
        set linux_missing {}
        foreach iface $linux_fd115_milestones {
            if {[info exists fd_iface_count($key,$iface)]} {
                set linux_present [chromium_unique_append $linux_present $iface]
            } else {
                set linux_missing [chromium_unique_append $linux_missing $iface]
            }
        }
        set partial_present {}
        foreach iface $partial_frame_milestones {
            if {[info exists fd_iface_count($key,$iface)]} {
                set partial_present [chromium_unique_append $partial_present $iface]
            }
        }
        set gpu_present {}
        set gpu_missing {}
        foreach iface $linux_gpu_font_milestones {
            if {[info exists fd_iface_count($key,$iface)]} {
                set gpu_present [chromium_unique_append $gpu_present $iface]
            } else {
                set gpu_missing [chromium_unique_append $gpu_missing $iface]
            }
        }
        set control_present {}
        foreach iface $control_milestones {
            if {[info exists fd_iface_count($key,$iface)]} {
                set control_present [chromium_unique_append $control_present $iface]
            }
        }

        set class "other-browser-fd"
        if {[llength $linux_present] == [llength $linux_fd115_milestones]} {
            set class "linux-fd115-complete"
        } elseif {[llength $linux_present] > 0 || [llength $partial_present] > 0} {
            set class "linux-fd115-partial"
            if {[llength $gpu_present] > 0} {
                append class "+gpu"
            }
        } elseif {[llength $gpu_present] > 0} {
            set class "linux-fd133-134-gpu"
        } elseif {[llength $control_present] > 0} {
            set class "control-timezone"
        }

        set timeline [join $fd_timeline($key) >]
        if {$timeline eq ""} {
            set timeline "none"
        }
        set ifaces [join [lsort $fd_interfaces($key)] |]
        if {$ifaces eq ""} {
            set ifaces "none"
        } else {
            set ifaces [chromium_short_value $ifaces 260]
        }
        set state_events 0
        set state_recv 0
        set state_send 0
        set state_first "missing"
        set state_last "missing"
        set state "missing"
        if {[info exists fd_state_event_count($key)]} {
            set state_events $fd_state_event_count($key)
            set state_recv $fd_state_recv_count($key)
            set state_send $fd_state_send_count($key)
            set state_first $fd_state_first_ts($key)
            set state_last $fd_state_last_ts($key)
            set state [chromium_short_value $fd_last_state($key) 260]
        }

        set first_contexts {}
        foreach iface $tracked_milestones {
            if {[info exists fd_iface_count($key,$iface)]} {
                lappend first_contexts "$iface:$fd_iface_count($key,$iface):[chromium_short_value $fd_iface_first_context($key,$iface) 120]"
            }
        }
        if {$class eq "other-browser-fd" && $timeline eq "none"} {
            continue
        }
        if {[llength $contexts] < 12} {
            lappend contexts "tgid=$tgid,fd=$fd,class=$class,payloads=$fd_payload_count($key),recv=$fd_recv_count($key),send=$fd_send_count($key),cmsg_payloads=$fd_cmsg_count($key),truncated=$fd_truncated_count($key),bytes_in=$fd_bytes_in($key),bytes_out=$fd_bytes_out($key),names=[join [lsort $fd_names($key)] |],first_ts=$fd_first_ts($key),last_ts=$fd_last_ts($key),state_events=$state_events,state_recv=$state_recv,state_send=$state_send,state_first_ts=$state_first,state_last_ts=$state_last,last_state=$state,linux_fd115_present=[join $linux_present |],linux_fd115_missing=[join $linux_missing |],partial_present=[join $partial_present |],gpu_font_present=[join $gpu_present |],gpu_font_missing=[join $gpu_missing |],control_present=[join $control_present |],timeline=[chromium_short_value $timeline 360],interfaces=$ifaces,first_contexts=[chromium_short_value [join $first_contexts |] 560]"
        }
    }

    return "available=1 payload_lines=$payload_lines parsed_payload_lines=$parsed_payload_lines browser_payload_lines=$browser_payload_lines browser_fd_count=[llength $browser_fds] browser_key_count=[llength $browser_keys] linux_fd115_analogue=$fd115_analogue linux_fd115_present=$fd115_present_text linux_fd115_missing=$fd115_missing_text linux_fd115_partial_present=$fd115_partial_text linux_fd115_state=[evidence_quote $fd115_state] linux_fd133_134_analogues=$gpu_analogue_text linux_fd133_134_missing_union=$gpu_missing_text contexts=[evidence_quote [join $contexts {;}]]"
}

proc chromium_renderer_admission_milestone_summary {} {
    global runlog wayland_chromium_log chromium_process_evidence_log

    if {![file exists $runlog]} {
        return "available=0 reason=runlog-missing"
    }

    array set no_connection_pid {}
    array set no_connection_after_restart {}
    set no_connection_pids {}
    set network_restart_count 0
    set host_sequence {}
    set network_restart_seen 0
    if {[file exists $wayland_chromium_log]} {
        foreach raw_line [split [read_text_file $wayland_chromium_log] "\n"] {
            set line [string trimright $raw_line "\r"]
            if {[regexp {Network service crashed.*restarting service} $line]} {
                incr network_restart_count
                set network_restart_seen 1
                if {[llength $host_sequence] < 16} {
                    lappend host_sequence "network_restart"
                }
            }
            if {[regexp {^\[([0-9]+):[0-9]+:.*Terminating current process after 15 seconds with no connection} $line -> pid]} {
                set no_connection_pid($pid) 1
                set no_connection_after_restart($pid) $network_restart_seen
                set no_connection_pids [chromium_unique_append $no_connection_pids $pid]
                if {[llength $host_sequence] < 16} {
                    lappend host_sequence "no_connection:$pid"
                }
            }
        }
    }

    array set proc_pid_roles {}
    array set proc_pid_role_count {}
    array set proc_pid_role_first {}
    array set proc_pid_role_last {}
    array set proc_role_sample_seen {}
    set process_evidence_present [expr {[file exists $chromium_process_evidence_log] ? 1 : 0}]
    set renderer_sample_count 0
    set renderer_pid_sample_count 0
    if {$process_evidence_present} {
        foreach raw_line [split [read_text_file $chromium_process_evidence_log] "\n"] {
            set line [string trimright $raw_line "\r"]
            if {![regexp {kde_chromium_process_evidence process phase=([^ ]+) pid=([0-9]+) ppid=[-0-9]+ comm="[^"]*" role="([^"]*)"} $line -> phase pid role]} {
                continue
            }

            set sample_index [chromium_process_phase_index $phase]
            if {$sample_index < 0} {
                continue
            }

            set proc_pid_roles($pid) [chromium_unique_append [expr {[info exists proc_pid_roles($pid)] ? $proc_pid_roles($pid) : {}}] $role]
            set key "$pid,$role"
            if {![info exists proc_pid_role_count($key)]} {
                set proc_pid_role_count($key) 0
            }
            incr proc_pid_role_count($key)
            if {![info exists proc_pid_role_first($key)] || $sample_index < $proc_pid_role_first($key)} {
                set proc_pid_role_first($key) $sample_index
            }
            if {![info exists proc_pid_role_last($key)] || $sample_index > $proc_pid_role_last($key)} {
                set proc_pid_role_last($key) $sample_index
            }
            set role_sample_key "$role,$sample_index"
            set proc_role_sample_seen($role_sample_key) 1
        }

        foreach key [array names proc_role_sample_seen "renderer,*"] {
            incr renderer_sample_count
        }
        foreach key [array names proc_pid_role_count "*,renderer"] {
            incr renderer_pid_sample_count
        }
    }

    set browser_milestones {
        content.mojom.RenderMessageFilter
        blink.mojom.LocalFrameHost
        blink.mojom.LocalMainFrameHost
        gpu.mojom.GpuChannel
        font_service.mojom.FontService
    }
    set partial_frame_milestones {
        content.mojom.FrameHost
        blink.mojom.NonAssociatedLocalFrameHost
        blink.mojom.DomStorageProvider
        blink.mojom.RendererAudioOutputStreamFactory
        network.mojom.NetworkService
        storage.mojom.StorageService
    }
    set control_milestones {
        device.mojom.TimeZoneMonitor
    }
    array set browser_milestone_count {}
    array set browser_milestone_first_ts {}
    array set browser_milestone_first_context {}
    foreach iface [concat $browser_milestones $partial_frame_milestones $control_milestones] {
        set browser_milestone_count($iface) 0
        set browser_milestone_first_ts($iface) "missing"
        set browser_milestone_first_context($iface) ""
    }

    set launch_ids {}
    set launch_count 0
    array set active_launch {}
    array set child_to_launch {}
    array set type_count {}
    array set launch_zygote {}
    array set launch_sockfd {}
    array set launch_type {}
    array set launch_child {}
    array set launch_cmsg {}
    array set launch_bytes {}
    array set launch_child_ping {}
    array set launch_child_iot_payloads {}
    array set launch_child_iot_recv {}
    array set launch_child_iot_send {}
    array set launch_child_iot_bytes_in {}
    array set launch_child_iot_bytes_out {}
    array set launch_child_iot_interfaces {}
    array set launch_first_iot_ts {}
    array set launch_last_iot_ts {}
    array set launch_exit_status {}
    array set launch_exit_roles {}
    array set launch_clone_ts {}
    array set launch_exit_ts {}
    array set launch_fd_event_count {}
    array set launch_fd_recv_count {}
    array set launch_fd_send_count {}
    array set launch_fd_scm_recv_count {}
    array set launch_fd_bytes_in {}
    array set launch_fd_bytes_out {}
    array set launch_fd_first_ts {}
    array set launch_fd_last_ts {}
    array set launch_fd_last_state {}
    array set launch_fd_payload_count {}
    array set launch_fd_payload_first {}
    array set launch_fd_payload_last {}
    array set launch_fd13_utc_count {}
    array set launch_fd13_utc_first {}
    array set launch_fd13_utc_last {}
    array set launch_fd13_utc_browser_match {}
    array set launch_epoll_fds {}
    array set browser_utc_fd_by_hex {}
    array set browser_utc_context_by_hex {}
    set browser_utc_payload_count 0
    set browser_utc_payload_fds {}
    set browser_utc_first_context "missing"
    set browser_utc_last_context "missing"
    set child_fd13_utc_count 0
    set renderer_fd13_utc_count 0
    set nonrenderer_fd13_utc_count 0
    set timezone_monitor_payload_count 0
    set etc_utc_payload_count 0

    foreach raw_line [split [read_text_file $runlog] "\n"] {
        set line [string trimright $raw_line "\r"]
        set ts "missing"
        if {[regexp {^\[([0-9]+)\]} $line -> got_ts]} {
            set ts $got_ts
        }

        if {[regexp {chrome-unix-ipc-payload: ([^ ]+) pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) fd=([0-9]+) ret=([-0-9]+) total=([0-9]+).* cmsg=([0-9]+).* roles=0x([0-9a-fA-F]+).* type=([^ ]+) initial_client_fd=([^ ]+) utility=([^ ]+) sandbox=([^ ]+).* ascii="([^"]*)"} $line -> op pid tgid name fd ret total cmsg roles_hex ptype _pfd _putility _psandbox ascii]} {
            scan $roles_hex "%x" roles
            set hex "missing"
            if {[regexp { hex=([0-9a-fA-F]+)} $line -> got_hex]} {
                set hex $got_hex
            }
            if {[string first "device.mojom.TimeZoneMonitor" $ascii] >= 0} {
                incr timezone_monitor_payload_count
            }
            if {[string first "Etc/UTC" $ascii] >= 0} {
                incr etc_utc_payload_count
            }
            if {$op eq "sendmsg-enter" &&
                ($roles & 0x80) != 0 &&
                $ret eq "52" &&
                [string first "UTC" $ascii] >= 0} {
                incr browser_utc_payload_count
                set browser_utc_payload_fds [chromium_unique_append $browser_utc_payload_fds $fd]
                set utc_context "ts=$ts,pid=$pid,tgid=$tgid,name=$name,fd=$fd,ret=$ret,total=$total,roles=[chromium_role_bits_text $roles_hex],ascii=[chromium_short_value $ascii 80],hex=[chromium_short_value $hex 96]"
                if {$browser_utc_first_context eq "missing"} {
                    set browser_utc_first_context $utc_context
                }
                set browser_utc_last_context $utc_context
                if {$hex ne "missing"} {
                    set browser_utc_fd_by_hex($hex) $fd
                    set browser_utc_context_by_hex($hex) $utc_context
                }
            }
            if {$op eq "recvmsg-done" && $pid eq $tgid &&
                ($roles & 0x40) != 0 && $ptype ne "-" && $cmsg > 0} {
                incr launch_count
                set id $launch_count
                lappend launch_ids $id
                set active_launch($pid) $id
                if {![info exists type_count($ptype)]} {
                    set type_count($ptype) 0
                }
                incr type_count($ptype)
                set launch_zygote($id) $pid
                set launch_sockfd($id) $fd
                set launch_type($id) $ptype
                set launch_child($id) "missing"
                set launch_cmsg($id) $cmsg
                set launch_bytes($id) $ret
                set launch_child_ping($id) 0
                set launch_child_iot_payloads($id) 0
                set launch_child_iot_recv($id) 0
                set launch_child_iot_send($id) 0
                set launch_child_iot_bytes_in($id) 0
                set launch_child_iot_bytes_out($id) 0
                set launch_child_iot_interfaces($id) {}
                set launch_first_iot_ts($id) "missing"
                set launch_last_iot_ts($id) "missing"
                set launch_exit_status($id) "missing"
                set launch_exit_roles($id) "missing"
                set launch_clone_ts($id) "missing"
                set launch_exit_ts($id) "missing"
                set launch_epoll_fds($id) {}
                foreach tracked_fd {13 14 15} {
                    set launch_fd_event_count($id,$tracked_fd) 0
                    set launch_fd_recv_count($id,$tracked_fd) 0
                    set launch_fd_send_count($id,$tracked_fd) 0
                    set launch_fd_scm_recv_count($id,$tracked_fd) 0
                    set launch_fd_bytes_in($id,$tracked_fd) 0
                    set launch_fd_bytes_out($id,$tracked_fd) 0
                    set launch_fd_first_ts($id,$tracked_fd) "missing"
                    set launch_fd_last_ts($id,$tracked_fd) "missing"
                    set launch_fd_last_state($id,$tracked_fd) "missing"
                    set launch_fd_payload_count($id,$tracked_fd) 0
                    set launch_fd_payload_first($id,$tracked_fd) "missing"
                    set launch_fd_payload_last($id,$tracked_fd) "missing"
                }
                set launch_fd13_utc_count($id) 0
                set launch_fd13_utc_first($id) "missing"
                set launch_fd13_utc_last($id) "missing"
                set launch_fd13_utc_browser_match($id) "missing"
            }

            if {$op eq "sendmsg-enter" &&
                [string first "CHILD_PING" $ascii] >= 0 &&
                [info exists child_to_launch($tgid)]} {
                set launch_child_ping($child_to_launch($tgid)) 1
            }

            if {[info exists child_to_launch($tgid)] &&
                [lsearch -exact {13 14 15} $fd] >= 0} {
                set id $child_to_launch($tgid)
                set payload_context "op=$op,ret=$ret,total=$total,cmsg=$cmsg,ascii=[chromium_short_value $ascii 80],hex=[chromium_short_value $hex 96]"
                incr launch_fd_payload_count($id,$fd)
                if {$launch_fd_payload_first($id,$fd) eq "missing"} {
                    set launch_fd_payload_first($id,$fd) $payload_context
                }
                set launch_fd_payload_last($id,$fd) $payload_context
                if {$fd eq "13" &&
                    $op eq "recvmsg-done" &&
                    $ret eq "52" &&
                    [string first "UTC" $ascii] >= 0} {
                    incr launch_fd13_utc_count($id)
                    incr child_fd13_utc_count
                    if {$launch_type($id) eq "renderer"} {
                        incr renderer_fd13_utc_count
                    } else {
                        incr nonrenderer_fd13_utc_count
                    }
                    set match "missing"
                    if {[info exists browser_utc_fd_by_hex($hex)]} {
                        set match "browser_fd=$browser_utc_fd_by_hex($hex),[chromium_short_value $browser_utc_context_by_hex($hex) 180]"
                    }
                    set launch_fd13_utc_browser_match($id) $match
                    set utc_context "ts=$ts,child=$tgid,match=$match,ascii=[chromium_short_value $ascii 80],hex=[chromium_short_value $hex 96]"
                    if {$launch_fd13_utc_first($id) eq "missing"} {
                        set launch_fd13_utc_first($id) $utc_context
                    }
                    set launch_fd13_utc_last($id) $utc_context
                }
            }

            foreach iface [regexp -all -inline {[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*\.mojom\.[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*} $ascii] {
                if {[info exists browser_milestone_count($iface)]} {
                    incr browser_milestone_count($iface)
                    if {$browser_milestone_first_ts($iface) eq "missing"} {
                        set browser_milestone_first_ts($iface) $ts
                        set browser_milestone_first_context($iface) "tgid=$tgid,pid=$pid,name=$name,fd=$fd,op=$op,roles=[chromium_role_bits_text $roles_hex]"
                    }
                }
                if {[info exists child_to_launch($tgid)] &&
                    $name eq "Chrome_ChildIOT"} {
                    set id $child_to_launch($tgid)
                    set launch_child_iot_interfaces($id) [chromium_unique_append $launch_child_iot_interfaces($id) $iface]
                }
            }

            if {[info exists child_to_launch($tgid)] &&
                $name eq "Chrome_ChildIOT"} {
                set id $child_to_launch($tgid)
                incr launch_child_iot_payloads($id)
                if {$launch_first_iot_ts($id) eq "missing"} {
                    set launch_first_iot_ts($id) $ts
                }
                set launch_last_iot_ts($id) $ts
                if {$op eq "recvmsg-done"} {
                    incr launch_child_iot_recv($id)
                    if {[string is integer -strict $ret] && $ret > 0} {
                        set launch_child_iot_bytes_in($id) [expr {$launch_child_iot_bytes_in($id) + $ret}]
                    }
                } elseif {$op eq "sendmsg-enter"} {
                    incr launch_child_iot_send($id)
                    if {[string is integer -strict $ret] && $ret > 0} {
                        set launch_child_iot_bytes_out($id) [expr {$launch_child_iot_bytes_out($id) + $ret}]
                    }
                }
            }
            continue
        }

        set ipc_match 0
        if {[regexp {chrome-unix-ipc: ([^ ]+) pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) fd=([0-9]+)} $line -> op pid tgid name fd]} {
            set ipc_match 1
        } elseif {[regexp {chrome-unix-ipc: ([^ ]+) pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) sockfd=([0-9]+)} $line -> op pid tgid name fd]} {
            set ipc_match 1
        }
        if {$ipc_match && [info exists child_to_launch($tgid)] &&
            [lsearch -exact {13 14 15} $fd] >= 0} {
            set id $child_to_launch($tgid)
            incr launch_fd_event_count($id,$fd)
            if {$launch_fd_first_ts($id,$fd) eq "missing"} {
                set launch_fd_first_ts($id,$fd) $ts
            }
            set launch_fd_last_ts($id,$fd) $ts

            set ret "missing"
            if {[regexp { ret=([-0-9]+)} $line -> got_ret]} {
                set ret $got_ret
            }
            if {$op eq "recvmsg-done"} {
                incr launch_fd_recv_count($id,$fd)
                if {[string is integer -strict $ret] && $ret > 0} {
                    set launch_fd_bytes_in($id,$fd) [expr {$launch_fd_bytes_in($id,$fd) + $ret}]
                }
            } elseif {$op eq "sendmsg-enter"} {
                incr launch_fd_send_count($id,$fd)
                set bytes 0
                if {[regexp { bytes=([0-9]+)} $line -> got_bytes]} {
                    set bytes $got_bytes
                } elseif {[string is integer -strict $ret] && $ret > 0} {
                    set bytes $ret
                }
                set launch_fd_bytes_out($id,$fd) [expr {$launch_fd_bytes_out($id,$fd) + $bytes}]
            } elseif {$op eq "scm-recv"} {
                incr launch_fd_scm_recv_count($id,$fd)
            }

            if {[regexp {sk_shutdown=([^ ]+).* sk_err=([^ ]+).* sk_tx=([^ ]+).* sk_marks=([^ ]+).* peer_shutdown=([^ ]+).* peer_err=([^ ]+).* peer_tx=([^ ]+).* peer_marks=([^ ]+).* ready=([^ ]+)} $line -> sk_shutdown sk_err sk_tx sk_marks peer_shutdown peer_err peer_tx peer_marks ready]} {
                set launch_fd_last_state($id,$fd) "op=$op,ret=$ret,sk_shutdown=$sk_shutdown,sk_err=$sk_err,sk_tx=$sk_tx,sk_marks=$sk_marks,peer_shutdown=$peer_shutdown,peer_err=$peer_err,peer_tx=$peer_tx,peer_marks=$peer_marks,ready=$ready"
            }
            continue
        }

        if {[regexp {chrome-epoll: ctl .* tgid=([0-9]+).* fd=([0-9]+).* events=0x([0-9a-fA-F]+).* ret=([-0-9]+)} $line -> tgid fd events ret] &&
            [info exists child_to_launch($tgid)] &&
            [lsearch -exact {13 14 15} $fd] >= 0} {
            set id $child_to_launch($tgid)
            set launch_epoll_fds($id) [chromium_unique_append $launch_epoll_fds($id) "fd=$fd/events=0x$events/ret=$ret"]
            continue
        }

        if {[regexp {chrome-lifecycle: clone parent_pid=([0-9]+) parent_tgid=([0-9]+).* child_pid=([0-9]+) child_tgid=([0-9]+)} $line -> parent _parent_tgid child _child_tgid]} {
            if {[info exists active_launch($parent)]} {
                set id $active_launch($parent)
                if {$launch_child($id) eq "missing"} {
                    set launch_child($id) $child
                    set child_to_launch($child) $id
                    set launch_clone_ts($id) $ts
                }
            }
            continue
        }

        if {[regexp {chrome-lifecycle: exit pid=([0-9]+) tgid=([0-9]+).* status=([-0-9]+).* killed_signo=([-0-9]+).* roles=0x([0-9a-fA-F]+)} $line -> pid tgid status killed roles_hex]} {
            if {[info exists child_to_launch($tgid)] && $pid eq $tgid} {
                set id $child_to_launch($tgid)
                set launch_exit_status($id) "$status:$killed"
                set launch_exit_roles($id) [chromium_role_bits_text $roles_hex]
                set launch_exit_ts($id) $ts
            }
        }
    }

    set type_counts {}
    foreach type [lsort [array names type_count]] {
        lappend type_counts "$type:$type_count($type)"
    }
    if {[llength $type_counts] == 0} {
        set type_counts "none"
    } else {
        set type_counts [join $type_counts ,]
    }

    set present_linux_milestones {}
    set missing_linux_milestones {}
    set linux_milestone_counts {}
    foreach iface $browser_milestones {
        lappend linux_milestone_counts "$iface:$browser_milestone_count($iface)"
        if {$browser_milestone_count($iface) > 0} {
            set present_linux_milestones [chromium_unique_append $present_linux_milestones $iface]
        } else {
            set missing_linux_milestones [chromium_unique_append $missing_linux_milestones $iface]
        }
    }
    set partial_frame_present {}
    foreach iface $partial_frame_milestones {
        if {$browser_milestone_count($iface) > 0} {
            set partial_frame_present [chromium_unique_append $partial_frame_present $iface]
        }
    }
    set control_present {}
    foreach iface $control_milestones {
        if {$browser_milestone_count($iface) > 0} {
            set control_present [chromium_unique_append $control_present $iface]
        }
    }
    set present_text [join $present_linux_milestones |]
    if {$present_text eq ""} {
        set present_text "none"
    }
    set missing_text [join $missing_linux_milestones |]
    if {$missing_text eq ""} {
        set missing_text "none"
    }
    set partial_text [join $partial_frame_present |]
    if {$partial_text eq ""} {
        set partial_text "none"
    }
    set control_text [join $control_present |]
    if {$control_text eq ""} {
        set control_text "none"
    }

    set milestone_firsts {}
    foreach iface [concat $browser_milestones $partial_frame_milestones $control_milestones] {
        if {$browser_milestone_count($iface) > 0} {
            lappend milestone_firsts "$iface@$browser_milestone_first_ts($iface)"
        }
    }
    if {[llength $milestone_firsts] == 0} {
        set milestone_firsts "none"
    } else {
        set milestone_firsts [join $milestone_firsts ,]
    }

    set renderer_launch_count 0
    set renderer_with_child 0
    set renderer_child_iot_count 0
    set renderer_child_iot_with_config 0
    set renderer_no_connection_children 0
    set renderer_no_connection_after_restart 0
    set renderer_sampled_as_renderer 0
    set renderer_sampled_any 0
    set renderer_contexts {}

    foreach id $launch_ids {
        if {$launch_type($id) ne "renderer"} {
            continue
        }
        incr renderer_launch_count
        set child $launch_child($id)
        set no_connection 0
        set after_restart 0
        if {$child ne "missing"} {
            incr renderer_with_child
            if {[info exists no_connection_pid($child)]} {
                set no_connection 1
                incr renderer_no_connection_children
                if {[info exists no_connection_after_restart($child)] &&
                    $no_connection_after_restart($child)} {
                    set after_restart 1
                    incr renderer_no_connection_after_restart
                }
            }
        }
        if {$launch_child_iot_payloads($id) > 0} {
            incr renderer_child_iot_count
        }

        set child_roles "missing"
        set child_role_detail "missing"
        if {$child ne "missing" && [info exists proc_pid_roles($child)]} {
            set child_roles [join [lsort $proc_pid_roles($child)] |]
            set detail_parts {}
            foreach role [lsort $proc_pid_roles($child)] {
                set key "$child,$role"
                lappend detail_parts "$role:$proc_pid_role_count($key):$proc_pid_role_first($key)-$proc_pid_role_last($key)"
                if {$role eq "renderer"} {
                    incr renderer_sampled_as_renderer
                }
            }
            set child_role_detail [join $detail_parts |]
            incr renderer_sampled_any
        }

        set iface_text [join [lsort $launch_child_iot_interfaces($id)] |]
        if {$iface_text eq ""} {
            set iface_text "none"
        }
        if {[lsearch -exact $launch_child_iot_interfaces($id) "chrome.mojom.RendererConfiguration"] >= 0} {
            incr renderer_child_iot_with_config
        }

        if {[llength $renderer_contexts] < 8} {
            set fd_parts {}
            foreach tracked_fd {13 14 15} {
                lappend fd_parts "fd$tracked_fd:e=$launch_fd_event_count($id,$tracked_fd):recv=$launch_fd_recv_count($id,$tracked_fd):send=$launch_fd_send_count($id,$tracked_fd):scm_recv=$launch_fd_scm_recv_count($id,$tracked_fd):in=$launch_fd_bytes_in($id,$tracked_fd):out=$launch_fd_bytes_out($id,$tracked_fd):first=$launch_fd_first_ts($id,$tracked_fd):last=$launch_fd_last_ts($id,$tracked_fd):state=[chromium_short_value $launch_fd_last_state($id,$tracked_fd) 180]"
            }
            set fd_text [join $fd_parts |]
            set epoll_text [join $launch_epoll_fds($id) |]
            if {$epoll_text eq ""} {
                set epoll_text "none"
            }
            set fd13_payload "count=$launch_fd_payload_count($id,13),first=[chromium_short_value $launch_fd_payload_first($id,13) 160],last=[chromium_short_value $launch_fd_payload_last($id,13) 160]"
            set fd13_utc "count=$launch_fd13_utc_count($id),match=[chromium_short_value $launch_fd13_utc_browser_match($id) 240],first=[chromium_short_value $launch_fd13_utc_first($id) 160],last=[chromium_short_value $launch_fd13_utc_last($id) 160]"
            set clone_to_exit_ms "missing"
            if {[string is wideinteger -strict $launch_clone_ts($id)] &&
                [string is wideinteger -strict $launch_exit_ts($id)] &&
                $launch_exit_ts($id) >= $launch_clone_ts($id)} {
                set clone_to_exit_ms [expr {($launch_exit_ts($id) - $launch_clone_ts($id)) / 1000000}]
            }
            lappend renderer_contexts "id=$id,child=$child,no_connection=$no_connection,no_connection_after_network_restart=$after_restart,child_ping=$launch_child_ping($id),iot_payloads=$launch_child_iot_payloads($id),iot_recv=$launch_child_iot_recv($id),iot_send=$launch_child_iot_send($id),iot_bytes_in=$launch_child_iot_bytes_in($id),iot_bytes_out=$launch_child_iot_bytes_out($id),iot_first_ts=$launch_first_iot_ts($id),iot_last_ts=$launch_last_iot_ts($id),iot_interfaces=[chromium_short_value $iface_text 180],sampled_roles=$child_roles,sample_detail=$child_role_detail,fd_activity=[chromium_short_value $fd_text 760],fd13_payload=[evidence_quote $fd13_payload],fd13_utc=[evidence_quote $fd13_utc],epoll_fds=[chromium_short_value $epoll_text 180],clone_ts=$launch_clone_ts($id),exit=$launch_exit_status($id),exit_ts=$launch_exit_ts($id),clone_to_exit_ms=$clone_to_exit_ms,exit_roles=$launch_exit_roles($id)"
        }
    }

    set host_sequence_text [join $host_sequence |]
    if {$host_sequence_text eq ""} {
        set host_sequence_text "none"
    }

    set browser_utc_fds_text [join $browser_utc_payload_fds ,]
    if {$browser_utc_fds_text eq ""} {
        set browser_utc_fds_text "none"
    }

    return "available=1 launch_count=$launch_count type_counts=$type_counts renderer_launch_count=$renderer_launch_count renderer_with_child=$renderer_with_child renderer_child_iot_count=$renderer_child_iot_count renderer_child_iot_with_config=$renderer_child_iot_with_config renderer_no_connection_children=$renderer_no_connection_children renderer_no_connection_after_network_restart=$renderer_no_connection_after_restart renderer_sampled_any_role=$renderer_sampled_any renderer_sampled_as_renderer=$renderer_sampled_as_renderer process_evidence_present=$process_evidence_present process_renderer_samples=$renderer_sample_count process_renderer_pid_count=$renderer_pid_sample_count no_connection_count=[llength $no_connection_pids] network_restart_count=$network_restart_count host_sequence=[evidence_quote $host_sequence_text] linux_milestone_counts=[join $linux_milestone_counts ,] present_linux_milestones=$present_text missing_linux_milestones=$missing_text partial_frame_milestones=$partial_text control_milestones=$control_text milestone_firsts=$milestone_firsts browser_utc_payload_count=$browser_utc_payload_count browser_utc_payload_fds=$browser_utc_fds_text browser_utc_first=[evidence_quote [chromium_short_value $browser_utc_first_context 220]] browser_utc_last=[evidence_quote [chromium_short_value $browser_utc_last_context 220]] child_fd13_utc_count=$child_fd13_utc_count renderer_fd13_utc_count=$renderer_fd13_utc_count nonrenderer_fd13_utc_count=$nonrenderer_fd13_utc_count timezone_monitor_payload_count=$timezone_monitor_payload_count etc_utc_payload_count=$etc_utc_payload_count contexts=[evidence_quote [join $renderer_contexts {;}]]"
}

proc chromium_renderer_semantic_role_gap_summary {} {
    global runlog wayland_chromium_log chromium_process_evidence_log
    global chromium_egl_trace_log

    if {![file exists $runlog]} {
        return "available=0 reason=runlog-missing"
    }

    array set no_connection_pid {}
    if {[file exists $wayland_chromium_log]} {
        foreach raw_line [split [read_text_file $wayland_chromium_log] "\n"] {
            set line [string trimright $raw_line "\r"]
            if {[regexp {^\[([0-9]+):[0-9]+:.*Terminating current process after 15 seconds with no connection} $line -> pid]} {
                set no_connection_pid($pid) 1
            }
        }
    }

    set process_evidence_present [expr {[file exists $chromium_process_evidence_log] ? 1 : 0}]
    array set proc_pid_roles {}
    array set proc_pid_role_count {}
    array set proc_pid_role_first {}
    array set proc_pid_role_last {}
    array set proc_pid_role_source {}
    array set proc_pid_type_arg {}
    array set proc_cmdline_renderer_candidate_pid {}
    set process_renderer_samples 0
    set process_renderer_pid_count 0
    set process_cmdline_renderer_candidate_seen 0
    if {$process_evidence_present} {
        array set renderer_sample_seen {}
        array set renderer_pid_seen {}
        foreach raw_line [split [read_text_file $chromium_process_evidence_log] "\n"] {
            set line [string trimright $raw_line "\r"]
            if {![regexp {kde_chromium_process_evidence process phase=([^ ]+) pid=([0-9]+) ppid=[-0-9]+ comm="[^"]*" role="([^"]*)"} $line -> phase pid role]} {
                continue
            }

            set sample_index [chromium_process_phase_index $phase]
            set existing_roles {}
            if {[info exists proc_pid_roles($pid)]} {
                set existing_roles $proc_pid_roles($pid)
            }
            set proc_pid_roles($pid) [chromium_unique_append $existing_roles $role]
            set role_key "$pid,$role"
            if {![info exists proc_pid_role_count($role_key)]} {
                set proc_pid_role_count($role_key) 0
            }
            incr proc_pid_role_count($role_key)
            if {$sample_index >= 0} {
                if {![info exists proc_pid_role_first($role_key)] ||
                    $sample_index < $proc_pid_role_first($role_key)} {
                    set proc_pid_role_first($role_key) $sample_index
                }
                if {![info exists proc_pid_role_last($role_key)] ||
                    $sample_index > $proc_pid_role_last($role_key)} {
                    set proc_pid_role_last($role_key) $sample_index
                }
                if {$role eq "renderer"} {
                    set renderer_sample_seen($sample_index) 1
                    set renderer_pid_seen($pid) 1
                }
            }
            if {[regexp { role_source="([^"]*)" type_arg="([^"]*)"} $line -> role_source type_arg]} {
                set proc_pid_role_source($pid) $role_source
                set proc_pid_type_arg($pid) $type_arg
                if {$type_arg eq "renderer" || $role eq "renderer"} {
                    set process_cmdline_renderer_candidate_seen 1
                    set proc_cmdline_renderer_candidate_pid($pid) 1
                }
            } elseif {$role eq "renderer"} {
                set process_cmdline_renderer_candidate_seen 1
                set proc_cmdline_renderer_candidate_pid($pid) 1
            }
        }
        set process_renderer_samples [llength [array names renderer_sample_seen]]
        set process_renderer_pid_count [llength [array names renderer_pid_seen]]
    }

    set full_iovec_present [expr {[file exists $chromium_egl_trace_log] ? 1 : 0}]
    set full_iovec_mojom_events 0
    set full_iovec_browser_mojom_events 0
    set full_iovec_fd115_complete_count 0
    set full_iovec_fd115_complete_fds {}
    set full_iovec_gpu_channel_fds {}
    set full_iovec_contexts {}
    set full_iovec_milestones {
        content.mojom.RenderMessageFilter
        blink.mojom.LocalFrameHost
        blink.mojom.LocalMainFrameHost
        gpu.mojom.GpuChannel
        font_service.mojom.FontService
    }
    set full_iovec_fd115_family {
        content.mojom.RenderMessageFilter
        blink.mojom.LocalFrameHost
        blink.mojom.LocalMainFrameHost
    }
    array set full_tracked {}
    array set full_milestone_count {}
    array set full_milestone_first {}
    foreach iface $full_iovec_milestones {
        set full_tracked($iface) 1
        set full_milestone_count($iface) 0
        set full_milestone_first($iface) "missing"
    }
    array set trace_pid_role {}
    array set full_fd_interfaces {}
    array set full_fd_timeline {}
    array set full_fd_event_count {}
    array set full_fd_first_line {}
    array set full_fd_last_line {}
    set full_browser_fds {}

    if {$full_iovec_present} {
        set trace_text [read_text_file $chromium_egl_trace_log]
        foreach raw_line [split $trace_text "\n"] {
            set line [string trimright $raw_line "\r"]
            if {[regexp {chromium_egl_trace phase=process pid=([0-9]+).* role=([^ \t]+)} $line -> pid role]} {
                set trace_pid_role($pid) $role
            }
        }

        set trace_line_index 0
        foreach raw_line [split $trace_text "\n"] {
            incr trace_line_index
            set line [string trimright $raw_line "\r"]
            if {![regexp {chromium_egl_trace phase=ipc_(sendmsg|recvmsg) pid=([0-9]+) fd=([0-9]+).* ret=([-0-9]+).* mojom_count=([0-9]+) mojom="([^"]*)"} $line -> op pid fd ret mojom_count mojom]} {
                continue
            }
            if {$mojom_count <= 0 || $mojom eq ""} {
                continue
            }
            incr full_iovec_mojom_events

            set role "unknown"
            if {[info exists trace_pid_role($pid)]} {
                set role $trace_pid_role($pid)
            }
            if {$role ne "browser"} {
                continue
            }
            incr full_iovec_browser_mojom_events
            set full_browser_fds [chromium_unique_append $full_browser_fds $fd]
            if {![info exists full_fd_event_count($fd)]} {
                set full_fd_event_count($fd) 0
                set full_fd_interfaces($fd) {}
                set full_fd_timeline($fd) {}
                set full_fd_first_line($fd) $trace_line_index
                set full_fd_last_line($fd) $trace_line_index
            }
            incr full_fd_event_count($fd)
            set full_fd_last_line($fd) $trace_line_index

            foreach iface [split $mojom {|}] {
                if {$iface eq ""} {
                    continue
                }
                set full_fd_interfaces($fd) [chromium_unique_append $full_fd_interfaces($fd) $iface]
                if {![info exists full_tracked($iface)]} {
                    continue
                }
                incr full_milestone_count($iface)
                if {$full_milestone_first($iface) eq "missing"} {
                    set full_milestone_first($iface) "fd=$fd,line=$trace_line_index,op=$op,ret=$ret"
                }
                set full_fd_timeline($fd) [chromium_unique_append $full_fd_timeline($fd) "$iface@$trace_line_index"]
                if {$iface eq "gpu.mojom.GpuChannel"} {
                    set full_iovec_gpu_channel_fds [chromium_unique_append $full_iovec_gpu_channel_fds $fd]
                }
            }
        }

        foreach fd [lsort -integer $full_browser_fds] {
            set has_fd115_family 1
            foreach iface $full_iovec_fd115_family {
                if {[lsearch -exact $full_fd_interfaces($fd) $iface] < 0} {
                    set has_fd115_family 0
                }
            }
            if {$has_fd115_family} {
                incr full_iovec_fd115_complete_count
                set full_iovec_fd115_complete_fds [chromium_unique_append $full_iovec_fd115_complete_fds $fd]
            }
            set timeline [join $full_fd_timeline($fd) >]
            if {$timeline eq ""} {
                continue
            }
            if {[llength $full_iovec_contexts] < 8} {
                lappend full_iovec_contexts "fd=$fd,events=$full_fd_event_count($fd),first_line=$full_fd_first_line($fd),last_line=$full_fd_last_line($fd),timeline=[chromium_short_value $timeline 240]"
            }
        }
    }

    set launch_ids {}
    set launch_count 0
    array set active_launch {}
    array set child_to_launch {}
    array set launch_type {}
    array set launch_child {}
    array set launch_clone_ts {}
    array set launch_exit_ts {}
    array set launch_exit_status {}
    array set launch_child_ping {}
    array set launch_child_iot_payloads {}
    array set launch_child_iot_recv {}
    array set launch_child_iot_send {}
    array set launch_child_iot_bytes_in {}
    array set launch_child_iot_bytes_out {}
    array set launch_child_iot_interfaces {}
    array set launch_iot_first_ts {}
    array set launch_iot_last_ts {}

    foreach raw_line [split [read_text_file $runlog] "\n"] {
        set line [string trimright $raw_line "\r"]
        set ts "missing"
        if {[regexp {^\[([0-9]+)\]} $line -> got_ts]} {
            set ts $got_ts
        }

        if {[regexp {chrome-unix-ipc-payload: ([^ ]+) pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) fd=([0-9]+) ret=([-0-9]+) total=([0-9]+).* cmsg=([0-9]+).* roles=0x([0-9a-fA-F]+).* type=([^ ]+) initial_client_fd=([^ ]+) utility=([^ ]+) sandbox=([^ ]+).* ascii="([^"]*)"} $line -> op pid tgid name fd ret total cmsg roles_hex ptype _pfd _putility _psandbox ascii]} {
            scan $roles_hex "%x" roles
            if {$op eq "recvmsg-done" && $pid eq $tgid &&
                ($roles & 0x40) != 0 && $ptype ne "-" && $cmsg > 0} {
                incr launch_count
                set id $launch_count
                lappend launch_ids $id
                set active_launch($pid) $id
                set launch_type($id) $ptype
                set launch_child($id) "missing"
                set launch_clone_ts($id) "missing"
                set launch_exit_ts($id) "missing"
                set launch_exit_status($id) "missing"
                set launch_child_ping($id) 0
                set launch_child_iot_payloads($id) 0
                set launch_child_iot_recv($id) 0
                set launch_child_iot_send($id) 0
                set launch_child_iot_bytes_in($id) 0
                set launch_child_iot_bytes_out($id) 0
                set launch_child_iot_interfaces($id) {}
                set launch_iot_first_ts($id) "missing"
                set launch_iot_last_ts($id) "missing"
            }

            if {$op eq "sendmsg-enter" &&
                [string first "CHILD_PING" $ascii] >= 0 &&
                [info exists child_to_launch($tgid)]} {
                set launch_child_ping($child_to_launch($tgid)) 1
            }

            if {[info exists child_to_launch($tgid)] && $name eq "Chrome_ChildIOT"} {
                set id $child_to_launch($tgid)
                incr launch_child_iot_payloads($id)
                if {$launch_iot_first_ts($id) eq "missing"} {
                    set launch_iot_first_ts($id) $ts
                }
                set launch_iot_last_ts($id) $ts
                if {$op eq "recvmsg-done"} {
                    incr launch_child_iot_recv($id)
                    if {[string is integer -strict $ret] && $ret > 0} {
                        set launch_child_iot_bytes_in($id) [expr {$launch_child_iot_bytes_in($id) + $ret}]
                    }
                } elseif {$op eq "sendmsg-enter"} {
                    incr launch_child_iot_send($id)
                    if {[string is integer -strict $ret] && $ret > 0} {
                        set launch_child_iot_bytes_out($id) [expr {$launch_child_iot_bytes_out($id) + $ret}]
                    }
                }
                foreach iface [regexp -all -inline {[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*\.mojom\.[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*} $ascii] {
                    set launch_child_iot_interfaces($id) [chromium_unique_append $launch_child_iot_interfaces($id) $iface]
                }
            }
            continue
        }

        if {[regexp {chrome-lifecycle: clone parent_pid=([0-9]+) parent_tgid=([0-9]+).* child_pid=([0-9]+) child_tgid=([0-9]+)} $line -> parent _parent_tgid child _child_tgid]} {
            if {[info exists active_launch($parent)]} {
                set id $active_launch($parent)
                if {$launch_child($id) eq "missing"} {
                    set launch_child($id) $child
                    set child_to_launch($child) $id
                    set launch_clone_ts($id) $ts
                }
            }
            continue
        }

        if {[regexp {chrome-lifecycle: exit pid=([0-9]+) tgid=([0-9]+).* status=([-0-9]+).* killed_signo=([-0-9]+)} $line -> pid tgid status killed]} {
            if {[info exists child_to_launch($tgid)] && $pid eq $tgid} {
                set id $child_to_launch($tgid)
                set launch_exit_status($id) "$status:$killed"
                set launch_exit_ts($id) $ts
            }
        }
    }

    set renderer_launch_count 0
    set semantic_renderer_candidate_count 0
    set live_config_renderer_candidate_count 0
    set semantic_role_gap_count 0
    set live_config_role_gap_count 0
    set sampled_as_renderer_count 0
    set sampled_as_zygote_count 0
    set no_connection_renderer_candidates 0
    set renderer_contexts {}

    foreach id $launch_ids {
        if {$launch_type($id) ne "renderer"} {
            continue
        }
        incr renderer_launch_count
        set child $launch_child($id)
        if {$child eq "missing"} {
            continue
        }
        incr semantic_renderer_candidate_count

        set has_config [expr {[lsearch -exact $launch_child_iot_interfaces($id) "chrome.mojom.RendererConfiguration"] >= 0}]
        set no_connection [expr {[info exists no_connection_pid($child)] ? 1 : 0}]
        set live_config [expr {!$no_connection &&
                               $launch_exit_status($id) eq "missing" &&
                               $has_config &&
                               $launch_child_iot_payloads($id) > 0}]
        if {$live_config} {
            incr live_config_renderer_candidate_count
        }
        if {$no_connection} {
            incr no_connection_renderer_candidates
        }

        set child_roles "missing"
        set child_role_detail "missing"
        set sampled_renderer 0
        set sampled_zygote 0
        if {[info exists proc_pid_roles($child)]} {
            set child_roles [join [lsort $proc_pid_roles($child)] |]
            set detail_parts {}
            foreach role [lsort $proc_pid_roles($child)] {
                set role_key "$child,$role"
                set first "missing"
                set last "missing"
                if {[info exists proc_pid_role_first($role_key)]} {
                    set first $proc_pid_role_first($role_key)
                }
                if {[info exists proc_pid_role_last($role_key)]} {
                    set last $proc_pid_role_last($role_key)
                }
                lappend detail_parts "$role:$proc_pid_role_count($role_key):$first-$last"
                if {$role eq "renderer"} {
                    set sampled_renderer 1
                }
                if {$role eq "zygote"} {
                    set sampled_zygote 1
                }
            }
            set child_role_detail [join $detail_parts |]
        }
        if {$sampled_renderer} {
            incr sampled_as_renderer_count
        } else {
            incr semantic_role_gap_count
            if {$live_config} {
                incr live_config_role_gap_count
            }
        }
        if {$sampled_zygote} {
            incr sampled_as_zygote_count
        }

        set role_source "missing"
        if {[info exists proc_pid_role_source($child)]} {
            set role_source $proc_pid_role_source($child)
        }
        set type_arg "missing"
        if {[info exists proc_pid_type_arg($child)]} {
            set type_arg $proc_pid_type_arg($child)
        }
        set iface_text [join [lsort $launch_child_iot_interfaces($id)] |]
        if {$iface_text eq ""} {
            set iface_text "none"
        } else {
            set iface_text [chromium_short_value $iface_text 220]
        }
        if {[llength $renderer_contexts] < 8} {
            lappend renderer_contexts "id=$id,child=$child,semantic_candidate=1,live_config_candidate=$live_config,no_connection=$no_connection,exit=$launch_exit_status($id),child_ping=$launch_child_ping($id),iot_payloads=$launch_child_iot_payloads($id),iot_recv=$launch_child_iot_recv($id),iot_send=$launch_child_iot_send($id),iot_bytes_in=$launch_child_iot_bytes_in($id),iot_bytes_out=$launch_child_iot_bytes_out($id),iot_first_ts=$launch_iot_first_ts($id),iot_last_ts=$launch_iot_last_ts($id),iot_interfaces=$iface_text,sampled_roles=$child_roles,sample_detail=$child_role_detail,role_source=$role_source,type_arg=$type_arg,clone_ts=$launch_clone_ts($id),exit_ts=$launch_exit_ts($id)"
        }
    }

    set cmdline_candidate_pid_count [llength [array names proc_cmdline_renderer_candidate_pid]]
    set full_counts {}
    foreach iface $full_iovec_milestones {
        lappend full_counts "$iface:$full_milestone_count($iface)"
    }
    set full_firsts {}
    foreach iface $full_iovec_milestones {
        if {$full_milestone_first($iface) ne "missing"} {
            lappend full_firsts "$iface@$full_milestone_first($iface)"
        }
    }
    if {[llength $full_firsts] == 0} {
        set full_firsts "none"
    } else {
        set full_firsts [chromium_short_value [join $full_firsts ,] 520]
    }
    set fd115_text [join [lsort -integer $full_iovec_fd115_complete_fds] ,]
    if {$fd115_text eq ""} {
        set fd115_text "none"
    }
    set gpu_fd_text [join [lsort -integer $full_iovec_gpu_channel_fds] ,]
    if {$gpu_fd_text eq ""} {
        set gpu_fd_text "none"
    }

    return "available=1 process_evidence_present=$process_evidence_present full_iovec_present=$full_iovec_present renderer_launch_count=$renderer_launch_count semantic_renderer_candidate_count=$semantic_renderer_candidate_count live_config_renderer_candidate_count=$live_config_renderer_candidate_count no_connection_renderer_candidates=$no_connection_renderer_candidates semantic_role_gap_count=$semantic_role_gap_count live_config_role_gap_count=$live_config_role_gap_count sampled_as_renderer_count=$sampled_as_renderer_count sampled_as_zygote_count=$sampled_as_zygote_count process_renderer_samples=$process_renderer_samples process_renderer_pid_count=$process_renderer_pid_count process_cmdline_renderer_candidate_seen=$process_cmdline_renderer_candidate_seen process_cmdline_renderer_candidate_pid_count=$cmdline_candidate_pid_count full_iovec_mojom_events=$full_iovec_mojom_events full_iovec_browser_mojom_events=$full_iovec_browser_mojom_events full_iovec_fd115_complete_count=$full_iovec_fd115_complete_count full_iovec_fd115_complete_fds=$fd115_text full_iovec_gpu_channel_fds=$gpu_fd_text full_iovec_milestone_counts=[join $full_counts ,] full_iovec_firsts=[evidence_quote $full_firsts] full_iovec_contexts=[evidence_quote [join $full_iovec_contexts {;}]] contexts=[evidence_quote [join $renderer_contexts {;}]]"
}

proc chromium_renderer_child_local_bootstrap_summary {} {
    global runlog wayland_chromium_log chromium_egl_trace_log chromium_process_evidence_log

    if {![file exists $runlog]} {
        return "available=0 reason=runlog-missing"
    }

    array set no_connection_pid {}
    if {[file exists $wayland_chromium_log]} {
        foreach raw_line [split [read_text_file $wayland_chromium_log] "\n"] {
            set line [string trimright $raw_line "\r"]
            if {[regexp {^\[([0-9]+):[0-9]+:.*Terminating current process after 15 seconds with no connection} $line -> pid]} {
                set no_connection_pid($pid) 1
            }
        }
    }

    set launch_ids {}
    set launch_count 0
    array set active_launch {}
    array set child_to_launch {}
    array set launch_type {}
    array set launch_child {}
    array set launch_renderer_client_id {}
    array set launch_gpu_client_id {}
    array set launch_identity_source {}
    array set launch_child_ping {}
    array set launch_exit_status {}
    array set launch_iot_payloads {}
    array set launch_iot_bytes_in {}
    array set launch_iot_interfaces {}
    array set run_fd_sequence {}
    array set run_fd_recv_count {}
    array set run_fd_send_count {}
    array set run_fd_bytes_in {}
    array set run_fd_bytes_out {}
    array set run_fd_last_state {}
    array set run_fd_last_ready {}
    array set run_fd_last_peer_tx {}
    array set run_fd_owner_tid {}
    array set run_fd_comm {}
    array set run_fd_sk {}
    array set run_fd_peer {}
    array set run_fd_sk_type {}
    array set run_fd_last_event_index {}
    array set run_socket_endpoint_keys {}
    array set run_socketpair_desc {}
    array set run_scm_pass_by_sk {}
    array set run_scm_install_desc {}
    array set run_fd_epoll_add_count {}
    array set run_fd_epoll_epfd {}
    array set run_fd_epoll_events {}
    array set run_fd_epoll_event_count {}
    array set run_epoll_owner_tgid {}
    array set run_epoll_wait_count {}
    array set run_epoll_wait_ready_count {}
    array set run_epoll_wait_last {}
    array set run_epoll_wait_history {}
    array set run_epoll_event_history {}
    array set run_thread_fd_history {}
    set pending_launch_payloads {}

    set run_line_index 0
    foreach raw_line [split [read_text_file $runlog] "\n"] {
        incr run_line_index
        set line [string trimright $raw_line "\r"]
        if {[regexp {chrome-unix-ipc-payload: ([^ ]+) pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) fd=([0-9]+) ret=([-0-9]+) total=([0-9]+).* cmsg=([0-9]+).* roles=0x([0-9a-fA-F]+).* type=([^ ]+) initial_client_fd=([^ ]+) utility=([^ ]+) sandbox=([^ ]+).* ascii="([^"]*)"} $line -> op pid tgid name fd ret total cmsg roles_hex ptype _pfd _putility _psandbox ascii]} {
            scan $roles_hex "%x" roles
            set payload_renderer_client_id "missing"
            if {[regexp { renderer_client_id=([^ ]+)} $line -> got_renderer_client_id] &&
                $got_renderer_client_id ne "-"} {
                set payload_renderer_client_id $got_renderer_client_id
            }
            set payload_gpu_client_id "missing"
            if {[regexp { gpu_client_id=([^ ]+)} $line -> got_gpu_client_id] &&
                $got_gpu_client_id ne "-"} {
                set payload_gpu_client_id $got_gpu_client_id
            }
            if {$op eq "sendmsg-enter" && $ptype ne "-" && $cmsg > 0 &&
                ($payload_renderer_client_id ne "missing" ||
                 $payload_gpu_client_id ne "missing")} {
                lappend pending_launch_payloads [list $ptype $ret $payload_renderer_client_id $payload_gpu_client_id]
            }
            if {$op eq "recvmsg-done" && $pid eq $tgid &&
                ($roles & 0x40) != 0 && $ptype ne "-" && $cmsg > 0} {
                incr launch_count
                set id $launch_count
                lappend launch_ids $id
                set active_launch($pid) $id
                set launch_type($id) $ptype
                set launch_child($id) "missing"
                set launch_renderer_client_id($id) $payload_renderer_client_id
                set launch_gpu_client_id($id) $payload_gpu_client_id
                set launch_identity_source($id) "recv"
                set pending_match -1
                for {set i 0} {$i < [llength $pending_launch_payloads]} {incr i} {
                    lassign [lindex $pending_launch_payloads $i] pending_type pending_ret pending_renderer_client_id pending_gpu_client_id
                    if {$pending_type eq $ptype && $pending_ret eq $ret} {
                        if {$launch_renderer_client_id($id) eq "missing" &&
                            $pending_renderer_client_id ne "missing"} {
                            set launch_renderer_client_id($id) $pending_renderer_client_id
                            set launch_identity_source($id) "send"
                        }
                        if {$launch_gpu_client_id($id) eq "missing" &&
                            $pending_gpu_client_id ne "missing"} {
                            set launch_gpu_client_id($id) $pending_gpu_client_id
                            set launch_identity_source($id) "send"
                        }
                        set pending_match $i
                        break
                    }
                }
                if {$pending_match >= 0} {
                    set pending_launch_payloads [lreplace $pending_launch_payloads $pending_match $pending_match]
                }
                set launch_child_ping($id) 0
                set launch_exit_status($id) "missing"
                set launch_iot_payloads($id) 0
                set launch_iot_bytes_in($id) 0
                set launch_iot_interfaces($id) {}
            }

            if {$op eq "sendmsg-enter" &&
                [string first "CHILD_PING" $ascii] >= 0 &&
                [info exists child_to_launch($tgid)]} {
                set launch_child_ping($child_to_launch($tgid)) 1
            }

            if {[info exists child_to_launch($tgid)] &&
                $name eq "Chrome_ChildIOT"} {
                set id $child_to_launch($tgid)
                incr launch_iot_payloads($id)
                if {$op eq "recvmsg-done" &&
                    [string is integer -strict $ret] && $ret > 0} {
                    set launch_iot_bytes_in($id) [expr {$launch_iot_bytes_in($id) + $ret}]
                }
                foreach iface [regexp -all -inline {[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*\.mojom\.[A-Za-z0-9_]+(?:\.[A-Za-z0-9_]+)*} $ascii] {
                    set launch_iot_interfaces($id) [chromium_unique_append $launch_iot_interfaces($id) $iface]
                }
            }

            set run_key "$tgid,$fd"
            if {[string is integer -strict $ret]} {
                if {$op eq "recvmsg-done" && $ret > 0} {
                    incr run_fd_recv_count($run_key)
                    set run_fd_bytes_in($run_key) [expr {[info exists run_fd_bytes_in($run_key)] ? $run_fd_bytes_in($run_key) + $ret : $ret}]
                    lappend run_fd_sequence($run_key) "r${ret}c${cmsg}"
                    lappend run_thread_fd_history($tgid,$pid,$fd) "$run_line_index:r:$ret:$cmsg"
                    set run_fd_owner_tid($run_key) $pid
                    set run_fd_comm($run_key) $name
                    set run_fd_last_event_index($run_key) $run_line_index
                } elseif {$op eq "sendmsg-enter" && $ret > 0} {
                    incr run_fd_send_count($run_key)
                    set run_fd_bytes_out($run_key) [expr {[info exists run_fd_bytes_out($run_key)] ? $run_fd_bytes_out($run_key) + $ret : $ret}]
                    lappend run_fd_sequence($run_key) "s${ret}c${cmsg}"
                    lappend run_thread_fd_history($tgid,$pid,$fd) "$run_line_index:s:$ret:$cmsg"
                    set run_fd_owner_tid($run_key) $pid
                    set run_fd_comm($run_key) $name
                    set run_fd_last_event_index($run_key) $run_line_index
                }
            }
            continue
        }

        if {[regexp {chrome-unix-ipc: (recvmsg-done|sendmsg-exit) pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) fd=([0-9]+) ret=([-0-9]+).* cmsg=([0-9]+).* sk=([^ ]+) peer=([^ ]+) sk_type=([^ ]+).* sk_shutdown=([^ ]+) sk_err=([^ ]+).* peer_shutdown=([^ ]+) peer_err=([^ ]+).* peer_tx=([^ ]+) peer_marks=([^ ]+).* ready=([-0-9]+)} $line -> state_op pid tgid name fd ret cmsg sk peer sk_type sk_shutdown sk_err peer_shutdown peer_err peer_tx peer_marks ready]} {
            set run_key "$tgid,$fd"
            set run_fd_last_state($run_key) "$state_op:ret$ret,cmsg$cmsg,ready$ready,sk$sk,peer$peer,skerr$sk_err,peererr$peer_err,sksd$sk_shutdown,peersd$peer_shutdown,peer_tx$peer_tx,peer_marks$peer_marks"
            set run_fd_last_ready($run_key) $ready
            set run_fd_last_peer_tx($run_key) $peer_tx
            set run_fd_owner_tid($run_key) $pid
            set run_fd_comm($run_key) $name
            set run_fd_sk($run_key) $sk
            set run_fd_peer($run_key) $peer
            set run_fd_sk_type($run_key) $sk_type
            if {![info exists run_socket_endpoint_keys($sk)]} {
                set run_socket_endpoint_keys($sk) {}
            }
            set run_socket_endpoint_keys($sk) [chromium_unique_append $run_socket_endpoint_keys($sk) $run_key]
            continue
        }

        if {[regexp {chrome-unix-ipc: socketpair pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) fd0=([0-9]+) fd1=([0-9]+) type=([-0-9]+) protocol=([-0-9]+) flags=0x([0-9a-fA-F]+) cloexec=([0-9]+).* fd0_is_unix=([0-9]+) fd0_sk=([^ ]+) fd0_peer=([^ ]+) fd0_ino=([^ ]+) fd0_peer_ino=([^ ]+) fd0_file_refs=([^ ]+) fd0_peer_file=([^ ]+) fd0_peer_file_refs=([^ ]+) fd0_type=([^ ]+).* fd1_is_unix=([0-9]+) fd1_sk=([^ ]+) fd1_peer=([^ ]+) fd1_ino=([^ ]+) fd1_peer_ino=([^ ]+) fd1_file_refs=([^ ]+) fd1_peer_file=([^ ]+) fd1_peer_file_refs=([^ ]+) fd1_type=([^ ]+)} $line -> pid tgid name fd0 fd1 sp_type sp_protocol sp_flags sp_cloexec fd0_is_unix fd0_sk fd0_peer fd0_ino fd0_peer_ino fd0_refs fd0_peer_file fd0_peer_refs fd0_type fd1_is_unix fd1_sk fd1_peer fd1_ino fd1_peer_ino fd1_refs fd1_peer_file fd1_peer_refs fd1_type]} {
            foreach endpoint [list \
                                  [list $fd0 $fd0_is_unix $fd0_sk $fd0_peer $fd0_ino $fd0_peer_ino $fd0_refs $fd0_peer_file $fd0_peer_refs $fd0_type] \
                                  [list $fd1 $fd1_is_unix $fd1_sk $fd1_peer $fd1_ino $fd1_peer_ino $fd1_refs $fd1_peer_file $fd1_peer_refs $fd1_type]] {
                lassign $endpoint endpoint_fd endpoint_is_unix endpoint_sk endpoint_peer endpoint_ino endpoint_peer_ino endpoint_refs endpoint_peer_file endpoint_peer_refs endpoint_type
                if {$endpoint_is_unix ne "1"} {
                    continue
                }
                set run_key "$tgid,$endpoint_fd"
                set run_fd_owner_tid($run_key) $pid
                set run_fd_comm($run_key) $name
                set run_fd_sk($run_key) $endpoint_sk
                set run_fd_peer($run_key) $endpoint_peer
                set run_fd_sk_type($run_key) $endpoint_type
                set run_fd_last_event_index($run_key) $run_line_index
                set socketpair_desc "socketpair:creator=$tgid/$pid/$name,fd=$endpoint_fd,type=$sp_type,protocol=$sp_protocol,flags=0x$sp_flags,cloexec=$sp_cloexec,sk$endpoint_sk,peer$endpoint_peer,ino$endpoint_ino,peer_ino$endpoint_peer_ino,refs$endpoint_refs,peer_file$endpoint_peer_file,peer_refs$endpoint_peer_refs"
                set run_socketpair_desc($run_key) $socketpair_desc
                if {![info exists run_fd_last_state($run_key)]} {
                    set run_fd_last_state($run_key) $socketpair_desc
                }
                if {![info exists run_socket_endpoint_keys($endpoint_sk)]} {
                    set run_socket_endpoint_keys($endpoint_sk) {}
                }
                set run_socket_endpoint_keys($endpoint_sk) [chromium_unique_append $run_socket_endpoint_keys($endpoint_sk) $run_key]
            }
            continue
        }

        if {[regexp {chrome-unix-ipc: scm-send pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) pass_fd=([-0-9]+) path=([^ ]+) file=([^ ]+) f_flags=0x([0-9a-fA-F]+) index=([0-9]+) pass_is_unix=1 pass_sk=([^ ]+) pass_peer=([^ ]+) pass_ino=([^ ]+) pass_peer_ino=([^ ]+) pass_file_refs=([^ ]+) pass_peer_file=([^ ]+) pass_peer_file_refs=([^ ]+) pass_type=([^ ]+)} $line -> pid tgid name pass_fd path file fflags index pass_sk pass_peer pass_ino pass_peer_ino pass_refs pass_peer_file pass_peer_refs pass_type]} {
            set pass_desc "$tgid/$pid/$name/pass_fd$pass_fd,index$index,path$path,file$file,flags0x$fflags,sk$pass_sk,peer$pass_peer,ino$pass_ino,peer_ino$pass_peer_ino,refs$pass_refs,peer_file$pass_peer_file,peer_refs$pass_peer_refs,type$pass_type"
            if {![info exists run_scm_pass_by_sk($pass_sk)]} {
                set run_scm_pass_by_sk($pass_sk) {}
            }
            set run_scm_pass_by_sk($pass_sk) [chromium_unique_append $run_scm_pass_by_sk($pass_sk) $pass_desc]
            continue
        }

        if {[regexp {chrome-unix-ipc: scm-recv pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) sockfd=([0-9]+) newfd=([-0-9]+) path=([^ ]+) file=([^ ]+) f_flags=0x([0-9a-fA-F]+) index=([0-9]+) cloexec=([0-9]+) peek=([0-9]+) install_is_unix=1 install_sk=([^ ]+) install_peer=([^ ]+) install_ino=([^ ]+) install_peer_ino=([^ ]+) install_file_refs=([^ ]+) install_peer_file=([^ ]+) install_peer_file_refs=([^ ]+) install_type=([^ ]+)} $line -> pid tgid name sockfd newfd path file fflags index cloexec peek install_sk install_peer install_ino install_peer_ino install_refs install_peer_file install_peer_refs install_type]} {
            if {[string is integer -strict $newfd] && $newfd >= 0} {
                set run_key "$tgid,$newfd"
                set run_fd_owner_tid($run_key) $pid
                set run_fd_comm($run_key) $name
                set run_fd_sk($run_key) $install_sk
                set run_fd_peer($run_key) $install_peer
                set run_fd_sk_type($run_key) $install_type
                set run_fd_last_event_index($run_key) $run_line_index
                set install_desc "scm-recv:sockfd$sockfd,index$index,cloexec$cloexec,peek$peek,path$path,file$file,flags0x$fflags,sk$install_sk,peer$install_peer,ino$install_ino,peer_ino$install_peer_ino,refs$install_refs,peer_file$install_peer_file,peer_refs$install_peer_refs"
                set run_scm_install_desc($run_key) $install_desc
                if {![info exists run_fd_last_state($run_key)]} {
                    set run_fd_last_state($run_key) $install_desc
                }
                if {![info exists run_socket_endpoint_keys($install_sk)]} {
                    set run_socket_endpoint_keys($install_sk) {}
                }
                set run_socket_endpoint_keys($install_sk) [chromium_unique_append $run_socket_endpoint_keys($install_sk) $run_key]
            }
            continue
        }

        if {[regexp {chrome-epoll: ctl seq=[0-9]+ pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) epfd=([0-9]+) op=([0-9]+) fd=([0-9]+) events=([^ ]+).* ret=([-0-9]+)} $line -> pid tgid name epfd op fd events ret]} {
            set run_epoll_owner_tgid($pid,$epfd) $tgid
            if {$op eq "1" && $ret eq "0"} {
                set run_key "$tgid,$fd"
                incr run_fd_epoll_add_count($run_key)
                set run_fd_epoll_epfd($run_key) $epfd
                set run_fd_epoll_events($run_key) $events
                set run_fd_owner_tid($run_key) $pid
            }
            continue
        }

        if {[regexp {chrome-epoll: wait seq=[0-9]+ pid=([0-9]+) tgid=([0-9]+) name=([^ ]+) epfd=([0-9]+) timeout=([-0-9]+) maxevents=([0-9]+) nkev=([0-9]+) nout=([0-9]+) mask=([^ ]+)} $line -> pid tgid name epfd timeout _maxevents nkev nout mask]} {
            set wait_key "$tgid,$epfd"
            set wait_tid_key "$tgid,$pid,$epfd"
            incr run_epoll_wait_count($wait_key)
            if {[string is integer -strict $nout] && $nout > 0} {
                incr run_epoll_wait_ready_count($wait_key)
            }
            set run_epoll_wait_last($wait_key) "tid$pid,timeout$timeout,nkev$nkev,nout$nout,mask$mask"
            lappend run_epoll_wait_history($wait_tid_key) "$run_line_index:$nout:$mask:$timeout"
            continue
        }

        if {[regexp {chrome-epoll: event seq=[0-9]+ pid=([0-9]+) epfd=([0-9]+) fd=([0-9]+) events=([^ ]+)} $line -> pid epfd fd events]} {
            if {[info exists run_epoll_owner_tgid($pid,$epfd)]} {
                set event_tgid $run_epoll_owner_tgid($pid,$epfd)
                set run_key "$event_tgid,$fd"
                set event_tid_key "$event_tgid,$pid,$epfd"
                incr run_fd_epoll_event_count($run_key)
                lappend run_epoll_event_history($event_tid_key) "$run_line_index:$fd:$events"
            }
            continue
        }

        if {[regexp {chrome-lifecycle: clone parent_pid=([0-9]+) parent_tgid=([0-9]+).* child_pid=([0-9]+) child_tgid=([0-9]+)} $line -> parent _parent_tgid child _child_tgid]} {
            if {[info exists active_launch($parent)]} {
                set id $active_launch($parent)
                if {$launch_child($id) eq "missing"} {
                    set launch_child($id) $child
                    set child_to_launch($child) $id
                }
            }
            continue
        }

        if {[regexp {chrome-lifecycle: exit pid=([0-9]+) tgid=([0-9]+).* status=([-0-9]+).* killed_signo=([-0-9]+)} $line -> pid tgid status killed]} {
            if {[info exists child_to_launch($tgid)] && $pid eq $tgid} {
                set launch_exit_status($child_to_launch($tgid)) "$status:$killed"
            }
        }
    }

    set trace_present [expr {[file exists $chromium_egl_trace_log] ? 1 : 0}]
    array set trace_role {}
    array set trace_type_arg {}
    array set trace_renderer_client_id {}
    array set trace_gpu_client_id {}
    array set trace_top_chrome_webui {}
    array set fd_sequence {}
    array set fd_event_count {}
    array set fd_recvmsg_count {}
    array set fd_send_count {}
    array set fd_scm_fd_total {}
    array set fd_first_scm_desc {}
    array set fd_first_scm_fds {}
    array set fd_socketpairs {}
    array set fd_closes {}

    if {$trace_present} {
        foreach raw_line [split [read_text_file $chromium_egl_trace_log] "\n"] {
            set line [string trimright $raw_line "\r"]
            if {[regexp {chromium_egl_trace phase=process pid=([0-9]+).* role=([^ \t]+).* argv="([^"]*)"} $line -> pid role argv]} {
                if {[info exists child_to_launch($pid)]} {
                    set trace_role($pid) $role
                    set type_arg "missing"
                    if {[regexp -- {--type=([^\\ \t"]+)} $argv -> got_type]} {
                        set type_arg $got_type
                    }
                    set trace_type_arg($pid) $type_arg
                    set renderer_client_id "missing"
                    if {[regexp -- {--renderer-client-id=([0-9]+)} $argv -> got_renderer_client_id]} {
                        set renderer_client_id $got_renderer_client_id
                    }
                    set gpu_client_id "missing"
                    if {[regexp -- {--gpu-client-id=([0-9]+)} $argv -> got_gpu_client_id]} {
                        set gpu_client_id $got_gpu_client_id
                    }
                    set trace_renderer_client_id($pid) $renderer_client_id
                    set trace_gpu_client_id($pid) $gpu_client_id
                    set trace_top_chrome_webui($pid) [expr {[string first "--top-chrome-webui" $argv] >= 0 ? 1 : 0}]
                }
                continue
            }

            if {[regexp {chromium_egl_trace phase=socketpair pid=([0-9]+).* fd0=([-0-9]+) fd1=([-0-9]+)} $line -> pid fd0 fd1]} {
                if {[info exists child_to_launch($pid)]} {
                    lappend fd_socketpairs($pid) "$fd0/$fd1"
                }
                continue
            }

            if {[regexp {chromium_egl_trace phase=ipc_close pid=([0-9]+) fd=([0-9]+) ret=([-0-9]+)} $line -> pid fd ret]} {
                if {[info exists child_to_launch($pid)]} {
                    lappend fd_closes($pid) "$fd:$ret"
                }
                continue
            }

            if {[regexp {chromium_egl_trace phase=ipc_send pid=([0-9]+) fd=([0-9]+) requested=([0-9]+) ret=([-0-9]+)} $line -> pid fd requested ret]} {
                if {![info exists child_to_launch($pid)]} {
                    continue
                }
                set key "$pid,$fd"
                lappend fd_sequence($key) "send$requested"
                incr fd_event_count($key)
                incr fd_send_count($key)
                continue
            }

            if {[regexp {chromium_egl_trace phase=ipc_recvmsg pid=([0-9]+) fd=([0-9]+).* ret=([-0-9]+).* scm_rights_fds=([0-9]+)} $line -> pid fd ret scm_fds]} {
                if {![info exists child_to_launch($pid)]} {
                    continue
                }
                set key "$pid,$fd"
                lappend fd_sequence($key) "recv${ret}_scm${scm_fds}"
                incr fd_event_count($key)
                incr fd_recvmsg_count($key)
                set fd_scm_fd_total($key) [expr {[info exists fd_scm_fd_total($key)] ? $fd_scm_fd_total($key) + $scm_fds : $scm_fds}]
                if {$scm_fds > 0 && ![info exists fd_first_scm_desc($key)]} {
                    set scm_desc "scm_fds=$scm_fds"
                    set got_fds {}
                    if {[regexp {scm_rights_fds=[0-9]+(.*)} $line -> raw_scm]} {
                        foreach match [regexp -all -inline {[0-9]+:} $raw_scm] {
                            if {[regexp {^([0-9]+):} $match -> got_fd] &&
                                $got_fd ne "0" &&
                                [lsearch -exact $got_fds $got_fd] < 0} {
                                lappend got_fds $got_fd
                            }
                        }
                        if {[llength $got_fds] > 0} {
                            set scm_desc "scm_fds=$scm_fds,newfds=[join $got_fds ,]"
                        }
                    }
                    set fd_first_scm_desc($key) $scm_desc
                    set fd_first_scm_fds($key) $got_fds
                }
                continue
            }
        }
    }

    array set thread_comm {}
    array set thread_last_state {}
    array set thread_state_sample_count {}
    array set thread_running_sample_count {}
    array set thread_sleeping_sample_count {}
    array set thread_wchan_last {}
    array set thread_last_syscall {}
    array set thread_epoll_sample_count {}
    array set thread_epoll_last {}
    set process_evidence_present [expr {[file exists $chromium_process_evidence_log] ? 1 : 0}]
    if {$process_evidence_present} {
        foreach raw_line [split [read_text_file $chromium_process_evidence_log] "\n"] {
            set line [string trimright $raw_line "\r"]
            if {[regexp {kde_chromium_process_evidence wait phase=([^ ]+) pid=([0-9]+) role="[^"]*" kind="thread-comm" rel="task/([0-9]+)/comm".* text="([^"]*)"} $line -> phase tgid tid comm]} {
                set thread_comm($tgid,$tid) $comm
                continue
            }

            if {[regexp {kde_chromium_process_evidence wait phase=([^ ]+) pid=([0-9]+) role="[^"]*" kind="thread-status" rel="task/([0-9]+)/status".* text="([^"]*)"} $line -> phase tgid tid status_text]} {
                set state_text "missing"
                if {[regexp {State:\\x09([^\\]+)} $status_text -> found_state]} {
                    set state_text [string map [list " " _ "\t" _] $found_state]
                }
                set thread_last_state($tgid,$tid) "$phase:$state_text"
                incr thread_state_sample_count($tgid,$tid)
                if {[string match "R*" $state_text]} {
                    incr thread_running_sample_count($tgid,$tid)
                } elseif {[string match "S*" $state_text] ||
                          [string match "D*" $state_text]} {
                    incr thread_sleeping_sample_count($tgid,$tid)
                }
                continue
            }

            if {[regexp {kde_chromium_process_evidence wait phase=([^ ]+) pid=([0-9]+) role="[^"]*" kind="thread-wchan" rel="task/([0-9]+)/wchan".* text="([^"]*)"} $line -> phase tgid tid wchan_text]} {
                set thread_wchan_last($tgid,$tid) "$phase:$wchan_text"
                continue
            }

            if {[regexp {kde_chromium_process_evidence wait phase=([^ ]+) pid=([0-9]+) role="[^"]*" kind="thread-syscall" rel="task/([0-9]+)/syscall".* text="([^"]*)"} $line -> phase tgid tid syscall_text]} {
                set compact_syscall [string map [list " " _ "\t" _] $syscall_text]
                set thread_last_syscall($tgid,$tid) "$phase:$compact_syscall"
                if {[regexp {^232 0x([0-9a-fA-F]+)} $syscall_text -> epfd_hex]} {
                    scan $epfd_hex "%x" epfd
                    incr thread_epoll_sample_count($tgid,$tid,$epfd)
                    set thread_epoll_last($tgid,$tid,$epfd) "$phase:syscall232_epfd$epfd"
                }
                continue
            }
        }
    }

    set common_expected {send80 recv312_scm3 send104 recv64_scm0 send88 recv64_scm0}
    set renderer_candidate_count 0
    set candidate_with_trace_count 0
    set common_prefix_count 0
    set stopped_after_prefix_count 0
    set second_burst_count 0
    set late_scm_handoff_count 0
    set live_config_prefix_stop_count 0
    set no_connection_prefix_stop_count 0
    set prefix_stop_side_channel_recv_count 0
    set prefix_stop_epoll_sleep_count 0
    set prefix_stop_bootstrap_peer_mapped_count 0
    set prefix_stop_bootstrap_peer_quiet_count 0
    set prefix_stop_bootstrap_peer_owner_epoll_after_stop_count 0
    set prefix_stop_bootstrap_peer_owner_ready_after_stop_count 0
    set prefix_stop_bootstrap_peer_owner_ipc_after_stop_count 0
    set prefix_stop_bootstrap_peer_owner_other_fd_ipc_after_stop_count 0
    set live_config_prefix_stop_type_arg_not_renderer_count 0
    set live_config_prefix_stop_renderer_client_missing_count 0
    set live_config_prefix_stop_gpu_client_missing_count 0
    set live_config_prefix_stop_launch_identity_trace_gap_count 0
    set live_config_prefix_stop_launch_renderer_id_present_trace_missing_count 0
    set live_config_prefix_stop_launch_gpu_id_present_trace_missing_count 0
    set prefix_stop_side_channel_peer_mapped_count 0
    set prefix_stop_side_channel_peer_missing_count 0
    set contexts {}

    foreach id $launch_ids {
        if {$launch_type($id) ne "renderer"} {
            continue
        }
        incr renderer_candidate_count
        set child $launch_child($id)
        if {$child eq "missing"} {
            continue
        }

        set best_key "missing"
        set best_match -1
        set best_sequence {}
        foreach key [array names fd_sequence "$child,*"] {
            set sequence $fd_sequence($key)
            set matched 0
            foreach event $sequence {
                if {$matched < [llength $common_expected] &&
                    $event eq [lindex $common_expected $matched]} {
                    incr matched
                }
            }
            if {$matched > $best_match ||
                ($matched == $best_match && [llength $sequence] > [llength $best_sequence])} {
                set best_match $matched
                set best_key $key
                set best_sequence $sequence
            }
        }
        if {$best_key eq "missing"} {
            continue
        }
        incr candidate_with_trace_count

        set fd [lindex [split $best_key ,] 1]
        set common_prefix [expr {$best_match == [llength $common_expected]}]
        set stopped_after_prefix [expr {$common_prefix && [llength $best_sequence] == [llength $common_expected]}]
        set send104_count 0
        set send88_count 0
        set has_late_scm 0
        foreach event $best_sequence {
            if {$event eq "send104"} {
                incr send104_count
            } elseif {$event eq "send88"} {
                incr send88_count
            } elseif {$event eq "recv200_scm2"} {
                set has_late_scm 1
            }
        }
        set second_burst [expr {$common_prefix && $send104_count >= 2 && $send88_count >= 2}]
        if {$common_prefix} {
            incr common_prefix_count
        }
        if {$stopped_after_prefix} {
            incr stopped_after_prefix_count
        }
        if {$second_burst} {
            incr second_burst_count
        }
        if {$has_late_scm} {
            incr late_scm_handoff_count
        }

        set no_connection [expr {[info exists no_connection_pid($child)] ? 1 : 0}]
        set has_config [expr {[lsearch -exact $launch_iot_interfaces($id) "chrome.mojom.RendererConfiguration"] >= 0}]
        set live_config [expr {!$no_connection &&
                               $launch_exit_status($id) eq "missing" &&
                               $has_config &&
                               $launch_iot_payloads($id) > 0}]
        if {$stopped_after_prefix && $live_config} {
            incr live_config_prefix_stop_count
        }
        if {$stopped_after_prefix && $no_connection} {
            incr no_connection_prefix_stop_count
        }

        set first_scm_fds {}
        if {[info exists fd_first_scm_fds($best_key)]} {
            set first_scm_fds $fd_first_scm_fds($best_key)
        }
        set first_scm_fds_text "none"
        if {[llength $first_scm_fds] > 0} {
            set first_scm_fds_text [join $first_scm_fds ,]
        }

        set tracked_fds [list $fd]
        foreach scm_fd $first_scm_fds {
            set scm_run_key "$child,$scm_fd"
            if {[lsearch -exact $tracked_fds $scm_fd] < 0 &&
                ([info exists run_fd_recv_count($scm_run_key)] ||
                 [info exists run_fd_send_count($scm_run_key)] ||
                 [info exists run_fd_last_state($scm_run_key)])} {
                lappend tracked_fds $scm_fd
            }
        }
        set fdwait_parts {}
        set side_channel_recv_fd_count 0
        set side_channel_all_ready_zero 1
        set epoll_sleep_sample_seen 0
        set bootstrap_peer_mapped 0
        set bootstrap_peer_after_stop_seen 0
        set bootstrap_peer_owner_epoll_after_stop_seen 0
        set bootstrap_peer_owner_ready_after_stop_seen 0
        set bootstrap_peer_owner_ipc_after_stop_seen 0
        set bootstrap_peer_owner_other_fd_ipc_after_stop_seen 0
        set side_channel_peer_mapped 0
        set side_channel_peer_missing 0
        foreach tracked_fd $tracked_fds {
            set run_key "$child,$tracked_fd"
            set recv_count [expr {[info exists run_fd_recv_count($run_key)] ? $run_fd_recv_count($run_key) : 0}]
            set send_count [expr {[info exists run_fd_send_count($run_key)] ? $run_fd_send_count($run_key) : 0}]
            set bytes_in [expr {[info exists run_fd_bytes_in($run_key)] ? $run_fd_bytes_in($run_key) : 0}]
            set bytes_out [expr {[info exists run_fd_bytes_out($run_key)] ? $run_fd_bytes_out($run_key) : 0}]
            set fd_seq "none"
            if {[info exists run_fd_sequence($run_key)]} {
                set fd_seq [join $run_fd_sequence($run_key) >]
            }
            set owner_tid "missing"
            if {[info exists run_fd_owner_tid($run_key)]} {
                set owner_tid $run_fd_owner_tid($run_key)
            }
            set owner_comm "missing"
            if {$owner_tid ne "missing" && [info exists thread_comm($child,$owner_tid)]} {
                set owner_comm $thread_comm($child,$owner_tid)
            }
            set owner_syscall "missing"
            if {$owner_tid ne "missing" && [info exists thread_last_syscall($child,$owner_tid)]} {
                set owner_syscall $thread_last_syscall($child,$owner_tid)
            }
            set epoll_add [expr {[info exists run_fd_epoll_add_count($run_key)] ? $run_fd_epoll_add_count($run_key) : 0}]
            set epfd "missing"
            if {[info exists run_fd_epoll_epfd($run_key)]} {
                set epfd $run_fd_epoll_epfd($run_key)
            }
            set epoll_events "missing"
            if {[info exists run_fd_epoll_events($run_key)]} {
                set epoll_events $run_fd_epoll_events($run_key)
            }
            set epoll_event_count [expr {[info exists run_fd_epoll_event_count($run_key)] ? $run_fd_epoll_event_count($run_key) : 0}]
            set epoll_wait_count 0
            set epoll_wait_ready_count 0
            set epoll_wait_last "missing"
            set epoll_samples 0
            set epoll_sample_last "missing"
            if {$epfd ne "missing"} {
                set wait_key "$child,$epfd"
                set epoll_wait_count [expr {[info exists run_epoll_wait_count($wait_key)] ? $run_epoll_wait_count($wait_key) : 0}]
                set epoll_wait_ready_count [expr {[info exists run_epoll_wait_ready_count($wait_key)] ? $run_epoll_wait_ready_count($wait_key) : 0}]
                if {[info exists run_epoll_wait_last($wait_key)]} {
                    set epoll_wait_last $run_epoll_wait_last($wait_key)
                }
                if {$owner_tid ne "missing" &&
                    [info exists thread_epoll_sample_count($child,$owner_tid,$epfd)]} {
                    set epoll_samples $thread_epoll_sample_count($child,$owner_tid,$epfd)
                    set epoll_sample_last $thread_epoll_last($child,$owner_tid,$epfd)
                    set epoll_sleep_sample_seen 1
                }
            }
            set last_state "missing"
            if {[info exists run_fd_last_state($run_key)]} {
                set last_state $run_fd_last_state($run_key)
            }
            set source_parts {}
            if {[info exists run_socketpair_desc($run_key)]} {
                lappend source_parts "socketpair=[chromium_short_value $run_socketpair_desc($run_key) 140]"
            }
            if {[info exists run_scm_install_desc($run_key)]} {
                lappend source_parts "scm_install=[chromium_short_value $run_scm_install_desc($run_key) 140]"
            }
            if {[info exists run_fd_sk($run_key)]} {
                set run_sk $run_fd_sk($run_key)
                if {[info exists run_scm_pass_by_sk($run_sk)]} {
                    lappend source_parts "scm_pass=[chromium_short_value [join $run_scm_pass_by_sk($run_sk) +] 180]"
                }
            }
            set source_desc "sources=none"
            if {[llength $source_parts] > 0} {
                set source_desc "sources=[join $source_parts +]"
            }
            if {$tracked_fd ne $fd && $recv_count > 0} {
                incr side_channel_recv_fd_count
                if {![info exists run_fd_last_ready($run_key)] ||
                    $run_fd_last_ready($run_key) ne "0"} {
                    set side_channel_all_ready_zero 0
                }
            }

            set peer_desc "peer=missing"
            set peer_mapped 0
            set peer_after_stop 0
            set peer_owner_epoll_after_stop 0
            set peer_owner_ready_after_stop 0
            set peer_owner_ipc_after_stop 0
            set peer_owner_other_fd_ipc_after_stop 0
            if {[info exists run_fd_peer($run_key)] &&
                [info exists run_socket_endpoint_keys($run_fd_peer($run_key))]} {
                set peer_parts {}
                foreach peer_key [lsort -dictionary $run_socket_endpoint_keys($run_fd_peer($run_key))] {
                    if {$peer_key eq $run_key} {
                        continue
                    }
                    if {![info exists run_fd_sk($peer_key)] ||
                        $run_fd_sk($peer_key) ne $run_fd_peer($run_key)} {
                        continue
                    }
                    if {[info exists run_fd_sk_type($run_key)] &&
                        [info exists run_fd_sk_type($peer_key)] &&
                        $run_fd_sk_type($peer_key) ne $run_fd_sk_type($run_key)} {
                        continue
                    }
                    set peer_mapped 1
                    set peer_tgid [lindex [split $peer_key ,] 0]
                    set peer_fd [lindex [split $peer_key ,] 1]
                    set peer_tid "missing"
                    if {[info exists run_fd_owner_tid($peer_key)]} {
                        set peer_tid $run_fd_owner_tid($peer_key)
                    }
                    set peer_comm "missing"
                    if {[info exists run_fd_comm($peer_key)]} {
                        set peer_comm $run_fd_comm($peer_key)
                    }
                    set peer_seq "none"
                    if {[info exists run_fd_sequence($peer_key)]} {
                        set peer_seq [join $run_fd_sequence($peer_key) >]
                    }
                    set peer_last_state "missing"
                    if {[info exists run_fd_last_state($peer_key)]} {
                        set peer_last_state $run_fd_last_state($peer_key)
                    }
                    set peer_last_index "missing"
                    if {[info exists run_fd_last_event_index($peer_key)]} {
                        set peer_last_index $run_fd_last_event_index($peer_key)
                    }
                    set stop_index "missing"
                    if {[info exists run_fd_last_event_index($run_key)]} {
                        set stop_index $run_fd_last_event_index($run_key)
                    }
                    set after_stop 0
                    if {$peer_last_index ne "missing" &&
                        $stop_index ne "missing" &&
                        $peer_last_index > $stop_index} {
                        set after_stop 1
                        set peer_after_stop 1
                    }
                    set peer_epfd "missing"
                    if {[info exists run_fd_epoll_epfd($peer_key)]} {
                        set peer_epfd $run_fd_epoll_epfd($peer_key)
                    }
                    set peer_owner_syscall "missing"
                    if {$peer_tid ne "missing" && [info exists thread_last_syscall($peer_tgid,$peer_tid)]} {
                        set peer_owner_syscall $thread_last_syscall($peer_tgid,$peer_tid)
                    }
                    set peer_owner_state "missing"
                    if {$peer_tid ne "missing" && [info exists thread_last_state($peer_tgid,$peer_tid)]} {
                        set peer_owner_state $thread_last_state($peer_tgid,$peer_tid)
                    }
                    set peer_owner_state_samples 0
                    if {$peer_tid ne "missing" && [info exists thread_state_sample_count($peer_tgid,$peer_tid)]} {
                        set peer_owner_state_samples $thread_state_sample_count($peer_tgid,$peer_tid)
                    }
                    set peer_owner_running_samples 0
                    if {$peer_tid ne "missing" && [info exists thread_running_sample_count($peer_tgid,$peer_tid)]} {
                        set peer_owner_running_samples $thread_running_sample_count($peer_tgid,$peer_tid)
                    }
                    set peer_owner_sleeping_samples 0
                    if {$peer_tid ne "missing" && [info exists thread_sleeping_sample_count($peer_tgid,$peer_tid)]} {
                        set peer_owner_sleeping_samples $thread_sleeping_sample_count($peer_tgid,$peer_tid)
                    }
                    set peer_owner_wchan "missing"
                    if {$peer_tid ne "missing" && [info exists thread_wchan_last($peer_tgid,$peer_tid)]} {
                        set peer_owner_wchan $thread_wchan_last($peer_tgid,$peer_tid)
                    }
                    set peer_epoll_wait_after_stop_count 0
                    set peer_epoll_ready_after_stop_count 0
                    set peer_epoll_event_after_stop_count 0
                    set peer_epoll_event_fds_after_stop {}
                    set peer_epoll_last_after_stop "missing"
                    set peer_epoll_last_after_stop_index -1
                    set peer_owner_ipc_after_stop_count 0
                    set peer_owner_ipc_other_fd_after_stop_count 0
                    set peer_owner_ipc_after_stop_fds {}
                    set peer_owner_ipc_after_stop_last "missing"
                    set peer_owner_ipc_after_stop_last_index -1
                    array unset peer_owner_ipc_by_fd
                    array set peer_owner_ipc_by_fd {}
                    if {$peer_epfd ne "missing" &&
                        $peer_tid ne "missing" &&
                        $stop_index ne "missing"} {
                        set peer_wait_tid_key "$peer_tgid,$peer_tid,$peer_epfd"
                        if {[info exists run_epoll_wait_history($peer_wait_tid_key)]} {
                            foreach wait_entry $run_epoll_wait_history($peer_wait_tid_key) {
                                set wait_fields [split $wait_entry :]
                                set wait_index [lindex $wait_fields 0]
                                set wait_nout [lindex $wait_fields 1]
                                if {![string is integer -strict $wait_index] ||
                                    $wait_index <= $stop_index} {
                                    continue
                                }
                                incr peer_epoll_wait_after_stop_count
                                if {[string is integer -strict $wait_nout] && $wait_nout > 0} {
                                    incr peer_epoll_ready_after_stop_count
                                }
                                if {$wait_index > $peer_epoll_last_after_stop_index} {
                                    set peer_epoll_last_after_stop_index $wait_index
                                    set peer_epoll_last_after_stop "wait:$wait_entry"
                                }
                            }
                        }
                        set peer_event_tid_key "$peer_tgid,$peer_tid,$peer_epfd"
                        if {[info exists run_epoll_event_history($peer_event_tid_key)]} {
                            foreach event_entry $run_epoll_event_history($peer_event_tid_key) {
                                set event_fields [split $event_entry :]
                                set event_index [lindex $event_fields 0]
                                set event_fd [lindex $event_fields 1]
                                if {![string is integer -strict $event_index] ||
                                    $event_index <= $stop_index} {
                                    continue
                                }
                                incr peer_epoll_event_after_stop_count
                                set peer_epoll_event_fds_after_stop [chromium_unique_append $peer_epoll_event_fds_after_stop $event_fd]
                                if {$event_index > $peer_epoll_last_after_stop_index} {
                                    set peer_epoll_last_after_stop_index $event_index
                                    set peer_epoll_last_after_stop "event:$event_entry"
                                }
                            }
                        }
                    }
                    if {$peer_tid ne "missing" && $stop_index ne "missing"} {
                        foreach history_key [array names run_thread_fd_history "$peer_tgid,$peer_tid,*"] {
                            set history_fd [lindex [split $history_key ,] 2]
                            foreach history_entry $run_thread_fd_history($history_key) {
                                set history_fields [split $history_entry :]
                                set history_index [lindex $history_fields 0]
                                if {![string is integer -strict $history_index] ||
                                    $history_index <= $stop_index} {
                                    continue
                                }
                                set history_op [lindex $history_fields 1]
                                set history_ret [lindex $history_fields 2]
                                set history_cmsg [lindex $history_fields 3]
                                incr peer_owner_ipc_after_stop_count
                                if {$history_fd ne $peer_fd} {
                                    incr peer_owner_ipc_other_fd_after_stop_count
                                }
                                set peer_owner_ipc_after_stop_fds [chromium_unique_append $peer_owner_ipc_after_stop_fds $history_fd]
                                lappend peer_owner_ipc_by_fd($history_fd) "$history_index:${history_op}${history_ret}c${history_cmsg}"
                                if {$history_index > $peer_owner_ipc_after_stop_last_index} {
                                    set peer_owner_ipc_after_stop_last_index $history_index
                                    set peer_owner_ipc_after_stop_last "fd$history_fd:$history_entry"
                                }
                            }
                        }
                    }
                    set this_peer_owner_epoll_after_stop 0
                    set this_peer_owner_ready_after_stop 0
                    if {$peer_epoll_wait_after_stop_count > 0 ||
                        $peer_epoll_event_after_stop_count > 0} {
                        set this_peer_owner_epoll_after_stop 1
                        set peer_owner_epoll_after_stop 1
                    }
                    if {$peer_epoll_ready_after_stop_count > 0 ||
                        $peer_epoll_event_after_stop_count > 0} {
                        set this_peer_owner_ready_after_stop 1
                        set peer_owner_ready_after_stop 1
                    }
                    set this_peer_owner_ipc_after_stop 0
                    set this_peer_owner_other_fd_ipc_after_stop 0
                    if {$peer_owner_ipc_after_stop_count > 0} {
                        set this_peer_owner_ipc_after_stop 1
                        set peer_owner_ipc_after_stop 1
                    }
                    if {$peer_owner_ipc_other_fd_after_stop_count > 0} {
                        set this_peer_owner_other_fd_ipc_after_stop 1
                        set peer_owner_other_fd_ipc_after_stop 1
                    }
                    set peer_epoll_event_fds_text "none"
                    if {[llength $peer_epoll_event_fds_after_stop] > 0} {
                        set peer_epoll_event_fds_text [chromium_short_value [join $peer_epoll_event_fds_after_stop ,] 80]
                    }
                    set peer_owner_ipc_fds_text "none"
                    if {[llength $peer_owner_ipc_after_stop_fds] > 0} {
                        set peer_owner_ipc_fds_text [chromium_short_value [join [lsort -integer $peer_owner_ipc_after_stop_fds] ,] 80]
                    }
                    set peer_owner_ipc_by_fd_text "none"
                    set peer_owner_ipc_fd_parts {}
                    foreach history_fd [lsort -integer [array names peer_owner_ipc_by_fd]] {
                        lappend peer_owner_ipc_fd_parts "fd$history_fd:[chromium_short_value [join $peer_owner_ipc_by_fd($history_fd) >] 140]"
                    }
                    if {[llength $peer_owner_ipc_fd_parts] > 0} {
                        set peer_owner_ipc_by_fd_text [chromium_short_value [join $peer_owner_ipc_fd_parts +] 360]
                    }
                    set peer_source_parts {}
                    if {[info exists run_socketpair_desc($peer_key)]} {
                        lappend peer_source_parts "socketpair=[chromium_short_value $run_socketpair_desc($peer_key) 120]"
                    }
                    if {[info exists run_scm_install_desc($peer_key)]} {
                        lappend peer_source_parts "scm_install=[chromium_short_value $run_scm_install_desc($peer_key) 120]"
                    }
                    if {[info exists run_fd_sk($peer_key)]} {
                        set peer_sk $run_fd_sk($peer_key)
                        if {[info exists run_scm_pass_by_sk($peer_sk)]} {
                            lappend peer_source_parts "scm_pass=[chromium_short_value [join $run_scm_pass_by_sk($peer_sk) +] 140]"
                        }
                    }
                    set peer_source_desc "sources=none"
                    if {[llength $peer_source_parts] > 0} {
                        set peer_source_desc "sources=[join $peer_source_parts +]"
                    }
                    lappend peer_parts "$peer_tgid/$peer_tid/$peer_comm/fd$peer_fd,peer_epfd=$peer_epfd,peer_owner_state=[chromium_short_value $peer_owner_state 64],peer_owner_state_samples=$peer_owner_state_samples,peer_owner_running_samples=$peer_owner_running_samples,peer_owner_sleeping_samples=$peer_owner_sleeping_samples,peer_owner_wchan=[chromium_short_value $peer_owner_wchan 64],peer_owner_syscall=[chromium_short_value $peer_owner_syscall 96],seq=[chromium_short_value $peer_seq 80],last_index=$peer_last_index,after_stop=$after_stop,owner_epoll_after_stop=$this_peer_owner_epoll_after_stop,owner_ready_after_stop=$this_peer_owner_ready_after_stop,owner_ipc_after_stop=$this_peer_owner_ipc_after_stop,owner_other_fd_ipc_after_stop=$this_peer_owner_other_fd_ipc_after_stop,peer_epoll_waits_after_stop=$peer_epoll_wait_after_stop_count,peer_epoll_ready_after_stop=$peer_epoll_ready_after_stop_count,peer_epoll_events_after_stop=$peer_epoll_event_after_stop_count,peer_epoll_event_fds_after_stop=$peer_epoll_event_fds_text,peer_epoll_last_after_stop=$peer_epoll_last_after_stop,peer_owner_ipc_after_stop=$peer_owner_ipc_after_stop_count,peer_owner_other_fd_ipc_after_stop=$peer_owner_ipc_other_fd_after_stop_count,peer_owner_ipc_fds_after_stop=$peer_owner_ipc_fds_text,peer_owner_ipc_last_after_stop=$peer_owner_ipc_after_stop_last,peer_owner_ipc_by_fd_after_stop=$peer_owner_ipc_by_fd_text,$peer_source_desc,last_state=[chromium_short_value $peer_last_state 120]"
                }
                if {[llength $peer_parts] > 0} {
                    set peer_desc "peer=[join $peer_parts +]"
                }
            }
            if {$tracked_fd eq $fd} {
                set bootstrap_peer_mapped $peer_mapped
                set bootstrap_peer_after_stop_seen $peer_after_stop
                set bootstrap_peer_owner_epoll_after_stop_seen $peer_owner_epoll_after_stop
                set bootstrap_peer_owner_ready_after_stop_seen $peer_owner_ready_after_stop
                set bootstrap_peer_owner_ipc_after_stop_seen $peer_owner_ipc_after_stop
                set bootstrap_peer_owner_other_fd_ipc_after_stop_seen $peer_owner_other_fd_ipc_after_stop
            } elseif {$recv_count > 0} {
                if {$peer_mapped} {
                    set side_channel_peer_mapped 1
                } else {
                    set side_channel_peer_missing 1
                }
            }
            lappend fdwait_parts "fd$tracked_fd:owner=$owner_tid/$owner_comm,recv=$recv_count,send=$send_count,in=$bytes_in,out=$bytes_out,seq=[chromium_short_value $fd_seq 80],epoll_add=$epoll_add,epfd=$epfd,epoll_events=$epoll_events,epoll_event_count=$epoll_event_count,epoll_waits=$epoll_wait_count,epoll_ready_waits=$epoll_wait_ready_count,epoll_wait_last=$epoll_wait_last,epoll_syscall_samples=$epoll_samples,epoll_syscall_last=$epoll_sample_last,owner_syscall=[chromium_short_value $owner_syscall 96],$source_desc,last_state=[chromium_short_value $last_state 160],$peer_desc"
        }
        if {$side_channel_recv_fd_count == 0} {
            set side_channel_all_ready_zero 0
        }
        if {$stopped_after_prefix && $live_config && $side_channel_recv_fd_count > 0} {
            incr prefix_stop_side_channel_recv_count
        }
        if {$stopped_after_prefix && $live_config && $epoll_sleep_sample_seen} {
            incr prefix_stop_epoll_sleep_count
        }
        if {$stopped_after_prefix && $live_config && $bootstrap_peer_mapped} {
            incr prefix_stop_bootstrap_peer_mapped_count
            if {!$bootstrap_peer_after_stop_seen} {
                incr prefix_stop_bootstrap_peer_quiet_count
            }
        }
        if {$stopped_after_prefix && $live_config && $bootstrap_peer_owner_epoll_after_stop_seen} {
            incr prefix_stop_bootstrap_peer_owner_epoll_after_stop_count
        }
        if {$stopped_after_prefix && $live_config && $bootstrap_peer_owner_ready_after_stop_seen} {
            incr prefix_stop_bootstrap_peer_owner_ready_after_stop_count
        }
        if {$stopped_after_prefix && $live_config && $bootstrap_peer_owner_ipc_after_stop_seen} {
            incr prefix_stop_bootstrap_peer_owner_ipc_after_stop_count
        }
        if {$stopped_after_prefix && $live_config && $bootstrap_peer_owner_other_fd_ipc_after_stop_seen} {
            incr prefix_stop_bootstrap_peer_owner_other_fd_ipc_after_stop_count
        }
        if {$stopped_after_prefix && $live_config && $side_channel_peer_mapped} {
            incr prefix_stop_side_channel_peer_mapped_count
        }
        if {$stopped_after_prefix && $live_config && $side_channel_peer_missing} {
            incr prefix_stop_side_channel_peer_missing_count
        }
        set fdwait_text "none"
        if {[llength $fdwait_parts] > 0} {
            set fdwait_text [join $fdwait_parts |]
        }

        set trace_role_text "missing"
        if {[info exists trace_role($child)]} {
            set trace_role_text $trace_role($child)
        }
        set trace_type_text "missing"
        if {[info exists trace_type_arg($child)]} {
            set trace_type_text $trace_type_arg($child)
        }
        set trace_renderer_client_text "missing"
        if {[info exists trace_renderer_client_id($child)]} {
            set trace_renderer_client_text $trace_renderer_client_id($child)
        }
        set trace_gpu_client_text "missing"
        if {[info exists trace_gpu_client_id($child)]} {
            set trace_gpu_client_text $trace_gpu_client_id($child)
        }
        set trace_top_chrome_webui_text "missing"
        if {[info exists trace_top_chrome_webui($child)]} {
            set trace_top_chrome_webui_text $trace_top_chrome_webui($child)
        }
        set launch_renderer_client_text "missing"
        if {[info exists launch_renderer_client_id($id)]} {
            set launch_renderer_client_text $launch_renderer_client_id($id)
        }
        set launch_gpu_client_text "missing"
        if {[info exists launch_gpu_client_id($id)]} {
            set launch_gpu_client_text $launch_gpu_client_id($id)
        }
        set launch_identity_source_text "missing"
        if {[info exists launch_identity_source($id)]} {
            set launch_identity_source_text $launch_identity_source($id)
        }
        if {$stopped_after_prefix && $live_config} {
            if {$trace_type_text ne "renderer"} {
                incr live_config_prefix_stop_type_arg_not_renderer_count
            }
            if {$trace_renderer_client_text eq "missing"} {
                incr live_config_prefix_stop_renderer_client_missing_count
            }
            if {$trace_gpu_client_text eq "missing"} {
                incr live_config_prefix_stop_gpu_client_missing_count
            }
            if {$launch_type($id) eq "renderer" &&
                ($launch_renderer_client_text ne "missing" ||
                 $launch_gpu_client_text ne "missing") &&
                ($trace_type_text ne "renderer" ||
                 $trace_renderer_client_text eq "missing" ||
                 $trace_gpu_client_text eq "missing")} {
                incr live_config_prefix_stop_launch_identity_trace_gap_count
            }
            if {$launch_renderer_client_text ne "missing" &&
                $trace_renderer_client_text eq "missing"} {
                incr live_config_prefix_stop_launch_renderer_id_present_trace_missing_count
            }
            if {$launch_gpu_client_text ne "missing" &&
                $trace_gpu_client_text eq "missing"} {
                incr live_config_prefix_stop_launch_gpu_id_present_trace_missing_count
            }
        }
        set scm_desc "missing"
        if {[info exists fd_first_scm_desc($best_key)]} {
            set scm_desc $fd_first_scm_desc($best_key)
        }
        set socketpairs "none"
        if {[info exists fd_socketpairs($child)]} {
            set socketpairs [join $fd_socketpairs($child) |]
        }
        set closes "none"
        if {[info exists fd_closes($child)]} {
            set closes [join $fd_closes($child) |]
        }
        set iface_text [join [lsort $launch_iot_interfaces($id)] |]
        if {$iface_text eq ""} {
            set iface_text "none"
        } else {
            set iface_text [chromium_short_value $iface_text 180]
        }
        if {[llength $contexts] < 8} {
            lappend contexts "id=$id,child=$child,bootstrap_fd=$fd,launch_renderer_client_id=$launch_renderer_client_text,launch_gpu_client_id=$launch_gpu_client_text,launch_identity_source=$launch_identity_source_text,trace_role=$trace_role_text,trace_type_arg=$trace_type_text,trace_renderer_client_id=$trace_renderer_client_text,trace_gpu_client_id=$trace_gpu_client_text,trace_top_chrome_webui=$trace_top_chrome_webui_text,no_connection=$no_connection,exit=$launch_exit_status($id),child_ping=$launch_child_ping($id),iot_payloads=$launch_iot_payloads($id),iot_bytes_in=$launch_iot_bytes_in($id),iot_has_renderer_config=$has_config,live_config_candidate=$live_config,common_prefix=$common_prefix,prefix_match=$best_match,prefix_len=[llength $common_expected],stopped_after_prefix=$stopped_after_prefix,second_burst_seen=$second_burst,late_scm_handoff_seen=$has_late_scm,local_ipc_events=[llength $best_sequence],first_scm=[chromium_short_value $scm_desc 120],first_scm_fds=$first_scm_fds_text,side_channel_recv_fd_count=$side_channel_recv_fd_count,side_channel_all_ready_zero=$side_channel_all_ready_zero,epoll_sleep_sample_seen=$epoll_sleep_sample_seen,bootstrap_peer_mapped=$bootstrap_peer_mapped,bootstrap_peer_after_stop_seen=$bootstrap_peer_after_stop_seen,bootstrap_peer_owner_epoll_after_stop_seen=$bootstrap_peer_owner_epoll_after_stop_seen,bootstrap_peer_owner_ready_after_stop_seen=$bootstrap_peer_owner_ready_after_stop_seen,bootstrap_peer_owner_ipc_after_stop_seen=$bootstrap_peer_owner_ipc_after_stop_seen,bootstrap_peer_owner_other_fd_ipc_after_stop_seen=$bootstrap_peer_owner_other_fd_ipc_after_stop_seen,side_channel_peer_mapped=$side_channel_peer_mapped,side_channel_peer_missing=$side_channel_peer_missing,fdwait=[chromium_short_value $fdwait_text 1800],socketpairs=[chromium_short_value $socketpairs 120],closes=[chromium_short_value $closes 120],sequence=[chromium_short_value [join $best_sequence >] 240],iot_interfaces=$iface_text"
        }
    }

    return "available=1 trace_present=$trace_present process_evidence_present=$process_evidence_present renderer_candidate_count=$renderer_candidate_count candidate_with_trace_count=$candidate_with_trace_count common_prefix_count=$common_prefix_count stopped_after_prefix_count=$stopped_after_prefix_count second_burst_count=$second_burst_count late_scm_handoff_count=$late_scm_handoff_count live_config_prefix_stop_count=$live_config_prefix_stop_count no_connection_prefix_stop_count=$no_connection_prefix_stop_count prefix_stop_side_channel_recv_count=$prefix_stop_side_channel_recv_count prefix_stop_epoll_sleep_count=$prefix_stop_epoll_sleep_count prefix_stop_bootstrap_peer_mapped_count=$prefix_stop_bootstrap_peer_mapped_count prefix_stop_bootstrap_peer_quiet_count=$prefix_stop_bootstrap_peer_quiet_count prefix_stop_bootstrap_peer_owner_epoll_after_stop_count=$prefix_stop_bootstrap_peer_owner_epoll_after_stop_count prefix_stop_bootstrap_peer_owner_ready_after_stop_count=$prefix_stop_bootstrap_peer_owner_ready_after_stop_count prefix_stop_bootstrap_peer_owner_ipc_after_stop_count=$prefix_stop_bootstrap_peer_owner_ipc_after_stop_count prefix_stop_bootstrap_peer_owner_other_fd_ipc_after_stop_count=$prefix_stop_bootstrap_peer_owner_other_fd_ipc_after_stop_count live_config_prefix_stop_type_arg_not_renderer_count=$live_config_prefix_stop_type_arg_not_renderer_count live_config_prefix_stop_renderer_client_missing_count=$live_config_prefix_stop_renderer_client_missing_count live_config_prefix_stop_gpu_client_missing_count=$live_config_prefix_stop_gpu_client_missing_count live_config_prefix_stop_launch_identity_trace_gap_count=$live_config_prefix_stop_launch_identity_trace_gap_count live_config_prefix_stop_launch_renderer_id_present_trace_missing_count=$live_config_prefix_stop_launch_renderer_id_present_trace_missing_count live_config_prefix_stop_launch_gpu_id_present_trace_missing_count=$live_config_prefix_stop_launch_gpu_id_present_trace_missing_count prefix_stop_side_channel_peer_mapped_count=$prefix_stop_side_channel_peer_mapped_count prefix_stop_side_channel_peer_missing_count=$prefix_stop_side_channel_peer_missing_count linux_reference=common_prefix_then_second_burst_and_recv200_scm2 contexts=[evidence_quote [join $contexts {;}]]"
}

proc chromium_no_connection_child_summary {} {
    global wayland_chromium_log runlog

    if {![file exists $wayland_chromium_log]} {
        return "available=0 reason=launcher-log-missing"
    }

    set no_connection_pids {}
    set network_restart_count 0
    set first_no_connection ""
    set last_no_connection ""
    foreach raw_line [split [read_text_file $wayland_chromium_log] "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {^\[([0-9]+):[0-9]+:.*Terminating current process after 15 seconds with no connection} $line -> pid]} {
            set no_connection_pids [chromium_unique_append $no_connection_pids $pid]
            if {$first_no_connection eq ""} {
                set first_no_connection $line
            }
            set last_no_connection $line
        }
        if {[regexp {Network service crashed.*restarting service} $line]} {
            incr network_restart_count
        }
    }

    if {[llength $no_connection_pids] == 0} {
        return "available=1 no_connection_count=0 network_restart_count=$network_restart_count first_no_connection=\"\" last_no_connection=\"\" contexts=\"\""
    }
    if {![file exists $runlog]} {
        return "available=1 no_connection_count=[llength $no_connection_pids] no_connection_pids=[join $no_connection_pids ,] network_restart_count=$network_restart_count runlog_present=0 first_no_connection=[evidence_quote $first_no_connection] last_no_connection=[evidence_quote $last_no_connection]"
    }

    array set wanted {}
    array set roles_hex {}
    array set role_source {}
    array set pid_seq {}
    array set type_arg {}
    array set utility_subtype {}
    array set service_sandbox {}
    array set initial_client_fd {}
    array set shared_files {}
    array set render_node {}
    array set metrics_shmem {}
    array set field_trial {}
    array set trace_uuid {}
    array set exec_line {}
    array set exit_status {}
    array set exit_line {}
    array set reap_status {}
    array set reap_line {}
    array set ipc_count {}
    array set ipc_recv_count {}
    array set ipc_send_count {}
    array set ipc_scm_count {}
    array set ipc_cred_count {}
    array set ipc_bytes_in {}
    array set ipc_bytes_out {}
    array set epoll_ctl_count {}
    array set epoll_wait_count {}
    array set epoll_ready_count {}
    array set first_ipc {}
    array set last_ipc {}
    array set first_epoll {}
    array set last_epoll {}
    array set syscall_tail_recorded {}
    array set syscall_tail_families {}
    array set syscall_tail_last {}
    array set syscall_tail_fd_last {}
    array set scm_recv_fds {}
    array set scm_recv_last {}
    array set fdtable_clone {}
    array set fdtable_initial_candidate {}
    array set payload_count {}
    array set payload_roles_hex {}
    array set payload_type {}
    array set payload_initial_client_fd {}
    array set payload_utility {}
    array set payload_sandbox {}
    array set payload_first {}
    array set payload_last {}

    foreach pid $no_connection_pids {
        set wanted($pid) 1
        set roles_hex($pid) "missing"
        set role_source($pid) "missing"
        set pid_seq($pid) "missing"
        set type_arg($pid) "missing"
        set utility_subtype($pid) "missing"
        set service_sandbox($pid) "missing"
        set initial_client_fd($pid) "missing"
        set shared_files($pid) "missing"
        set render_node($pid) "missing"
        set metrics_shmem($pid) "missing"
        set field_trial($pid) "missing"
        set trace_uuid($pid) "missing"
        set exec_line($pid) ""
        set exit_status($pid) "missing"
        set exit_line($pid) ""
        set reap_status($pid) "missing"
        set reap_line($pid) ""
        set ipc_count($pid) 0
        set ipc_recv_count($pid) 0
        set ipc_send_count($pid) 0
        set ipc_scm_count($pid) 0
        set ipc_cred_count($pid) 0
        set ipc_bytes_in($pid) 0
        set ipc_bytes_out($pid) 0
        set epoll_ctl_count($pid) 0
        set epoll_wait_count($pid) 0
        set epoll_ready_count($pid) 0
        set first_ipc($pid) ""
        set last_ipc($pid) ""
        set first_epoll($pid) ""
        set last_epoll($pid) ""
        set syscall_tail_recorded($pid) "missing"
        set syscall_tail_families($pid) "missing"
        set syscall_tail_last($pid) "missing"
        set syscall_tail_fd_last($pid) "missing"
        set scm_recv_fds($pid) ""
        set scm_recv_last($pid) ""
        set fdtable_clone($pid) "missing"
        set fdtable_initial_candidate($pid) "missing"
        set payload_count($pid) 0
        set payload_roles_hex($pid) "missing"
        set payload_type($pid) "missing"
        set payload_initial_client_fd($pid) "missing"
        set payload_utility($pid) "missing"
        set payload_sandbox($pid) "missing"
        set payload_first($pid) ""
        set payload_last($pid) ""
    }

    foreach raw_line [split [read_text_file $runlog] "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {chrome-unix-ipc-payload: .* pid=([0-9]+) tgid=([0-9]+).* fd=([0-9]+).* sample_len=([0-9]+) full_len=([0-9]+).* roles=0x([0-9a-fA-F]+) type=([^ ]+) initial_client_fd=([^ ]+) utility=([^ ]+) sandbox=([^ ]+).* ascii="([^"]*)"} $line -> pid tgid fd sample_len full_len proles ptype pfd putility psandbox pascii]} {
            if {[info exists wanted($tgid)]} {
                incr payload_count($tgid)
                set payload_roles_hex($tgid) $proles
                if {$roles_hex($tgid) eq "missing"} {
                    set roles_hex($tgid) $proles
                    set role_source($tgid) "payload"
                }
                if {$payload_first($tgid) eq ""} {
                    set payload_first($tgid) [chromium_short_value $line 220]
                }
                set payload_last($tgid) [chromium_short_value $line 220]
                if {$ptype ne "-"} {
                    set payload_type($tgid) $ptype
                }
                if {$pfd ne "-"} {
                    set payload_initial_client_fd($tgid) $pfd
                }
                if {$putility ne "-"} {
                    set payload_utility($tgid) $putility
                }
                if {$psandbox ne "-"} {
                    set payload_sandbox($tgid) $psandbox
                }
            }
            continue
        }
        if {[regexp {chrome-syscall-tail-fd .*pid=([0-9]+) tgid=([0-9]+).*} $line -> pid tgid]} {
            if {[info exists wanted($tgid)]} {
                set syscall_tail_fd_last($tgid) [chromium_short_value $line 220]
            }
            continue
        }
        if {[regexp {chrome-fd-trace: fdtable pid=([0-9]+) tgid=([0-9]+).* tag=clone-child-prewake-lite .*total=([0-9]+)} $line -> pid tgid total]} {
            if {[info exists wanted($tgid)]} {
                set fdtable_clone($tgid) "total=$total"
            }
            continue
        }
        if {[regexp {chrome-fd-trace: fdtable-entry pid=([0-9]+) tag=clone-child-prewake-lite fd=([0-9]+) cloexec=([0-9]+).* kind=([0-9]+).* f_flags=0x([0-9a-fA-F]+).* path=([^ ]+) target=(.*)} $line -> pid fd cloexec kind fflags path target]} {
            if {[info exists wanted($pid)]} {
                set entry "fd=$fd,cloexec=$cloexec,kind=$kind,flags=0x$fflags,path=$path,target=[chromium_short_value $target 80]"
                if {$fdtable_initial_candidate($pid) eq "missing"} {
                    set fdtable_initial_candidate($pid) $entry
                } elseif {[regexp {socket|pipe|custom|/dev/dri|/tmp/\.org\.chromium|wayland|mojo} $path] ||
                          [regexp {socket|pipe|custom|/dev/dri|/tmp/\.org\.chromium|wayland|mojo} $target]} {
                    set fdtable_initial_candidate($pid) $entry
                }
            }
            continue
        }
        if {[regexp {chrome-syscall-tail-summary: reason=exit pid=([0-9]+) tgid=([0-9]+).* recorded=([0-9]+)} $line -> pid tgid recorded]} {
            if {[info exists wanted($tgid)] && $pid eq $tgid} {
                set syscall_tail_recorded($tgid) $recorded
            }
            continue
        }
        if {[regexp {chrome-syscall-tail-families: reason=exit pid=([0-9]+) tgid=([0-9]+) (.*)} $line -> pid tgid families]} {
            if {[info exists wanted($tgid)] && $pid eq $tgid} {
                set syscall_tail_families($tgid) [chromium_short_value $families 220]
            }
            continue
        }
        if {[regexp {chrome-syscall-tail: reason=exit .* pid=([0-9]+) tgid=([0-9]+).*} $line -> pid tgid]} {
            if {[info exists wanted($tgid)] && $pid eq $tgid} {
                set syscall_tail_last($tgid) [chromium_short_value $line 220]
            }
            continue
        }
        if {[regexp {chrome-lifecycle: exec pid=([0-9]+).* pid_seq=([0-9]+).* chrome_roles=0x([0-9a-fA-F]+)} $line -> pid seq roles]} {
            if {[info exists wanted($pid)]} {
                set pid_seq($pid) $seq
                set roles_hex($pid) $roles
                set role_source($pid) "lifecycle-exec"
                set exec_line($pid) $line
            }
            continue
        }
        if {[regexp {chrome-lifecycle: exec-argv pid=([0-9]+) argv\[[0-9]+\]='([^']*)'} $line -> pid argv]} {
            if {![info exists wanted($pid)]} {
                continue
            }
            if {[string first "--type=" $argv] == 0} {
                set type_arg($pid) [string range $argv 7 end]
            } elseif {[string first "--utility-sub-type=" $argv] == 0} {
                set utility_subtype($pid) [string range $argv 19 end]
            } elseif {[string first "--service-sandbox-type=" $argv] == 0} {
                set service_sandbox($pid) [string range $argv 23 end]
            } elseif {[string first "--initial-client-fd=" $argv] == 0} {
                set initial_client_fd($pid) [string range $argv 20 end]
            } elseif {[string first "--shared-files=" $argv] == 0} {
                set shared_files($pid) [chromium_short_value [string range $argv 15 end] 120]
            } elseif {[string first "--render-node-override=" $argv] == 0} {
                set render_node($pid) [string range $argv 23 end]
            } elseif {[string first "--metrics-shmem-handle=" $argv] == 0} {
                set metrics_shmem($pid) [chromium_short_value [string range $argv 23 end] 80]
            } elseif {[string first "--field-trial-handle=" $argv] == 0} {
                set field_trial($pid) [chromium_short_value [string range $argv 21 end] 80]
            } elseif {[string first "--trace-process-track-uuid=" $argv] == 0} {
                set trace_uuid($pid) [string range $argv 27 end]
            }
            continue
        }
        if {[regexp {chrome-lifecycle: exit pid=([0-9]+) tgid=([0-9]+).* status=([-0-9]+).* killed_signo=([-0-9]+).* roles=0x([0-9a-fA-F]+)} $line -> pid tgid status killed roles]} {
            if {[info exists wanted($tgid)] && $pid eq $tgid} {
                set exit_status($tgid) "$status:$killed"
                set roles_hex($tgid) $roles
                set role_source($tgid) "lifecycle-exit"
                set exit_line($tgid) $line
            }
            continue
        }
        if {[regexp {reaping .* pid=([0-9]+) tgid=([0-9]+).* wait_status=([-0-9]+).* killed_signo=([-0-9]+).* roles=0x([0-9a-fA-F]+)} $line -> pid tgid status killed roles]} {
            if {[info exists wanted($tgid)] && $pid eq $tgid} {
                set reap_status($tgid) "$status:$killed"
                set roles_hex($tgid) $roles
                set role_source($tgid) "lifecycle-reap"
                set reap_line($tgid) $line
            }
            continue
        }
        if {[regexp {chrome-unix-ipc: ([^ ]+) pid=([0-9]+) tgid=([0-9]+).* ret=([-0-9]+)} $line -> op pid tgid ret]} {
            if {![info exists wanted($tgid)]} {
                continue
            }
            incr ipc_count($tgid)
            if {$first_ipc($tgid) eq ""} {
                set first_ipc($tgid) $line
            }
            set last_ipc($tgid) $line
            if {[string match "recvmsg*" $op] || $op eq "recvmmsg-done"} {
                incr ipc_recv_count($tgid)
                if {$ret > 0} {
                    incr ipc_bytes_in($tgid) $ret
                }
            } elseif {[string match "sendmsg*" $op]} {
                incr ipc_send_count($tgid)
                if {$ret > 0} {
                    incr ipc_bytes_out($tgid) $ret
                }
            }
            if {[regexp { cmsg=([1-9][0-9]*)} $line] ||
                [regexp { scm_count=([1-9][0-9]*)} $line]} {
                incr ipc_scm_count($tgid)
            }
            if {[regexp {has_cred=1|scm-emit-cred|scm-recv-cred} $line]} {
                incr ipc_cred_count($tgid)
            }
            continue
        }
        if {[regexp {chrome-unix-ipc: (scm-[^ ]+) pid=([0-9]+) tgid=([0-9]+)} $line -> op pid tgid]} {
            set owner ""
            if {[info exists wanted($tgid)]} {
                set owner $tgid
            } elseif {$op eq "scm-emit-cred" &&
                      [regexp { cred_pid=([0-9]+)} $line -> cred_pid] &&
                      [info exists wanted($cred_pid)]} {
                set owner $cred_pid
            }
            if {$owner eq ""} {
                continue
            }
            incr ipc_count($owner)
            incr ipc_scm_count($owner)
            if {$op eq "scm-emit-cred" || $op eq "scm-recv-cred"} {
                incr ipc_cred_count($owner)
            }
            if {$op eq "scm-recv" &&
                [regexp { newfd=([-0-9]+)} $line -> newfd]} {
                if {$scm_recv_fds($owner) eq ""} {
                    set scm_recv_fds($owner) $newfd
                } elseif {[llength [split $scm_recv_fds($owner) ,]] < 12 &&
                          [lsearch -exact [split $scm_recv_fds($owner) ,] $newfd] < 0} {
                    append scm_recv_fds($owner) ",$newfd"
                }
                set scm_recv_last($owner) [chromium_short_value $line 220]
            }
            if {$first_ipc($owner) eq ""} {
                set first_ipc($owner) $line
            }
            set last_ipc($owner) $line
            continue
        }
        if {[regexp {chrome-epoll: (ctl|wait) .* pid=([0-9]+) tgid=([0-9]+).* nout=([0-9]+)} $line -> op pid tgid nout]} {
            if {![info exists wanted($tgid)]} {
                continue
            }
            if {$op eq "ctl"} {
                incr epoll_ctl_count($tgid)
            } else {
                incr epoll_wait_count($tgid)
                if {$nout > 0} {
                    incr epoll_ready_count($tgid)
                }
            }
            if {$first_epoll($tgid) eq ""} {
                set first_epoll($tgid) $line
            }
            set last_epoll($tgid) $line
        } elseif {[regexp {chrome-epoll: ctl .* pid=([0-9]+) tgid=([0-9]+)} $line -> pid tgid]} {
            if {![info exists wanted($tgid)]} {
                continue
            }
            incr epoll_ctl_count($tgid)
            if {$first_epoll($tgid) eq ""} {
                set first_epoll($tgid) $line
            }
            set last_epoll($tgid) $line
        }
    }

    set contexts {}
    foreach pid $no_connection_pids {
        set role_text [chromium_role_bits_text $roles_hex($pid)]
        set scm_fds $scm_recv_fds($pid)
        if {$scm_fds eq ""} {
            set scm_fds "missing"
        }
        lappend contexts "pid=$pid,roles=0x$roles_hex($pid),role_source=$role_source($pid),role_text=$role_text,type=$type_arg($pid),utility=$utility_subtype($pid),sandbox=$service_sandbox($pid),initial_client_fd=$initial_client_fd($pid),payload_count=$payload_count($pid),payload_roles=0x$payload_roles_hex($pid),payload_type=$payload_type($pid),payload_initial_client_fd=$payload_initial_client_fd($pid),payload_utility=$payload_utility($pid),payload_sandbox=$payload_sandbox($pid),payload_first=[evidence_quote $payload_first($pid)],payload_last=[evidence_quote $payload_last($pid)],shared_files=$shared_files($pid),render_node=$render_node($pid),metrics=$metrics_shmem($pid),field_trial=$field_trial($pid),trace_uuid=$trace_uuid($pid),fdtable_clone=$fdtable_clone($pid),fdtable_initial_candidate=[evidence_quote $fdtable_initial_candidate($pid)],scm_recv_fds=$scm_fds,scm_recv_last=[evidence_quote $scm_recv_last($pid)],ipc=$ipc_count($pid),ipc_recv=$ipc_recv_count($pid),ipc_send=$ipc_send_count($pid),ipc_scm=$ipc_scm_count($pid),ipc_cred=$ipc_cred_count($pid),ipc_bytes_in=$ipc_bytes_in($pid),ipc_bytes_out=$ipc_bytes_out($pid),epoll_ctl=$epoll_ctl_count($pid),epoll_wait=$epoll_wait_count($pid),epoll_ready=$epoll_ready_count($pid),exit=$exit_status($pid),reap=$reap_status($pid),tail_recorded=$syscall_tail_recorded($pid),tail_families=[evidence_quote $syscall_tail_families($pid)],tail_last=[evidence_quote $syscall_tail_last($pid)],tail_fd_last=[evidence_quote $syscall_tail_fd_last($pid)],first_ipc=[evidence_quote $first_ipc($pid)],last_ipc=[evidence_quote $last_ipc($pid)],first_epoll=[evidence_quote $first_epoll($pid)],last_epoll=[evidence_quote $last_epoll($pid)]"
    }

    return "available=1 no_connection_count=[llength $no_connection_pids] no_connection_pids=[join $no_connection_pids ,] network_restart_count=$network_restart_count runlog_present=1 first_no_connection=[evidence_quote $first_no_connection] last_no_connection=[evidence_quote $last_no_connection] contexts=[evidence_quote [join $contexts {;}]]"
}

proc chromium_process_evidence_summary {} {
    global chromium_process_evidence_log

    if {![file exists $chromium_process_evidence_log]} {
        return "available=0"
    }

    set text [read_text_file $chromium_process_evidence_log]
    set launched_pid "missing"
    set launched_reparented 0
    set browser_seen 0
    set renderer_seen 0
    set gpu_seen 0
    set zygote_seen 0
    set crashpad_seen 0
    set render_fd_seen 0
    set browser_render_fd_seen 0
    set card_fd_seen 0
    set drm_fd_seen 0
    set sample_max -1
    set launched_first_sample "missing"
    set launched_last_sample "missing"
    set launched_reparent_first_sample "missing"
    set browser_render_fd_first_sample "missing"
    set render_fd_first_sample "missing"
    set launched_ppids {}
    array set role_pid_seen {}
    array set role_counts {}
    array set role_first_sample {}
    array set role_last_sample {}
    array set role_source_counts {}
    array set zygote_pid_seen {}
    array set renderer_candidate_pid_seen {}
    set renderer_candidate_seen 0
    set unknown_chrome_seen 0
    set cmdline_truncated_seen 0
    set first_unknown_chrome ""
    set first_cmdline_truncated ""

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        set phase ""
        set sample_index -1

        if {[regexp {kde_chromium_process_evidence (process|fd) phase=([^ ]+)} $line -> _ phase]} {
            if {[regexp {^(sample|burst)-([0-9]+)$} $phase -> phase_kind sample_text]} {
                scan $sample_text "%d" sample_index
                if {$sample_index > $sample_max} {
                    set sample_max $sample_index
                }
            } elseif {$phase eq "after"} {
                set sample_index 0
            }
        }

        if {[regexp {kde_chromium_process_evidence launch launched_pid=([0-9]+)} $line -> pid]} {
            set launched_pid $pid
        }
        if {[regexp {kde_chromium_process_evidence process phase=[^ ]+ pid=([0-9]+) ppid=([-0-9]+) comm="([^"]*)" role="([^"]*)"} $line -> pid ppid comm role]} {
            set key "$role,$pid"
            if {![info exists role_pid_seen($key)]} {
                set role_pid_seen($key) 1
                if {![info exists role_counts($role)]} {
                    set role_counts($role) 0
                }
                incr role_counts($role)
            }
            if {$sample_index >= 0} {
                if {![info exists role_first_sample($role)] || $sample_index < $role_first_sample($role)} {
                    set role_first_sample($role) $sample_index
                }
                if {![info exists role_last_sample($role)] || $sample_index > $role_last_sample($role)} {
                    set role_last_sample($role) $sample_index
                }
            }
            if {$role eq "browser"} {
                set browser_seen 1
            } elseif {$role eq "renderer"} {
                set renderer_seen 1
            } elseif {$role eq "gpu-process"} {
                set gpu_seen 1
            } elseif {$role eq "zygote"} {
                set zygote_seen 1
                if {![info exists zygote_pid_seen($pid)]} {
                    set zygote_pid_seen($pid) 1
                }
            }
            if {$role eq "crashpad" || [string match -nocase *crashpad* $comm]} {
                set crashpad_seen 1
            }
            if {[regexp { role_source="([^"]*)" type_arg="([^"]*)" argv0="([^"]*)" cmdline_bytes=([0-9]+) cmdline_truncated=([0-9]+)} $line -> role_source type_arg argv0 _cmdline_bytes cmdline_truncated]} {
                if {![info exists role_source_counts($role_source)]} {
                    set role_source_counts($role_source) 0
                }
                incr role_source_counts($role_source)
                if {$type_arg eq "renderer" || $role eq "renderer"} {
                    set renderer_candidate_seen 1
                    set renderer_candidate_pid_seen($pid) 1
                }
                if {$role eq "unknown" &&
                    ($comm eq "chrome" || $argv0 eq "chrome" ||
                     $argv0 eq "exe")} {
                    set unknown_chrome_seen 1
                    if {$first_unknown_chrome eq ""} {
                        set first_unknown_chrome $line
                    }
                }
                if {$cmdline_truncated ne "0"} {
                    set cmdline_truncated_seen 1
                    if {$first_cmdline_truncated eq ""} {
                        set first_cmdline_truncated $line
                    }
                }
            } elseif {$role eq "renderer"} {
                set renderer_candidate_seen 1
                set renderer_candidate_pid_seen($pid) 1
            }
            if {$launched_pid ne "missing" && $pid eq $launched_pid} {
                if {[lsearch -exact $launched_ppids $ppid] < 0} {
                    lappend launched_ppids $ppid
                }
                if {$sample_index >= 0} {
                    if {$launched_first_sample eq "missing" || $sample_index < $launched_first_sample} {
                        set launched_first_sample $sample_index
                    }
                    if {$launched_last_sample eq "missing" || $sample_index > $launched_last_sample} {
                        set launched_last_sample $sample_index
                    }
                }
                if {$ppid eq "1"} {
                    set launched_reparented 1
                    if {$sample_index >= 0 && ($launched_reparent_first_sample eq "missing" || $sample_index < $launched_reparent_first_sample)} {
                        set launched_reparent_first_sample $sample_index
                    }
                }
            }
        }
        if {[regexp {kde_chromium_process_evidence fd phase=[^ ]+ pid=([0-9]+) role="([^"]*)" fd="([^"]*)" target="([^"]*)"} $line -> pid role fd target]} {
            if {[string match */dev/dri/* $target] || [string match *renderD* $target] || [string match *drm* $target]} {
                set drm_fd_seen 1
            }
            if {[string match *renderD* $target]} {
                set render_fd_seen 1
                if {$sample_index >= 0 && ($render_fd_first_sample eq "missing" || $sample_index < $render_fd_first_sample)} {
                    set render_fd_first_sample $sample_index
                }
                if {$role eq "browser"} {
                    set browser_render_fd_seen 1
                    if {$sample_index >= 0 && ($browser_render_fd_first_sample eq "missing" || $sample_index < $browser_render_fd_first_sample)} {
                        set browser_render_fd_first_sample $sample_index
                    }
                }
            }
            if {[string match */dev/dri/card* $target] || [string match *card* $target]} {
                set card_fd_seen 1
            }
        }
    }

    set role_parts {}
    foreach role [lsort [array names role_counts]] {
        lappend role_parts "$role:$role_counts($role)"
    }
    if {[llength $role_parts] == 0} {
        set role_counts_text "none"
    } else {
        set role_counts_text [join $role_parts ","]
    }
    set role_source_parts {}
    foreach role_source [lsort [array names role_source_counts]] {
        lappend role_source_parts "$role_source:$role_source_counts($role_source)"
    }
    if {[llength $role_source_parts] == 0} {
        set role_source_counts_text "missing"
    } else {
        set role_source_counts_text [join $role_source_parts ","]
    }
    if {[llength $launched_ppids] == 0} {
        set launched_ppids_text "none"
    } else {
        set launched_ppids_text [join $launched_ppids ","]
    }
    set renderer_candidate_pid_count [llength [array names renderer_candidate_pid_seen]]

    foreach role {browser renderer gpu-process zygote unknown} {
        if {![info exists role_first_sample($role)]} {
            set role_first_sample($role) "missing"
        }
        if {![info exists role_last_sample($role)]} {
            set role_last_sample($role) "missing"
        }
    }

    return "available=1 launched_pid=$launched_pid launched_ppids=$launched_ppids_text launched_reparented=$launched_reparented launched_first_sample=$launched_first_sample launched_last_sample=$launched_last_sample launched_reparent_first_sample=$launched_reparent_first_sample sample_max=$sample_max browser_seen=$browser_seen browser_first_sample=$role_first_sample(browser) browser_last_sample=$role_last_sample(browser) renderer_seen=$renderer_seen renderer_first_sample=$role_first_sample(renderer) renderer_last_sample=$role_last_sample(renderer) renderer_candidate_seen=$renderer_candidate_seen renderer_candidate_pid_count=$renderer_candidate_pid_count gpu_seen=$gpu_seen gpu_first_sample=$role_first_sample(gpu-process) gpu_last_sample=$role_last_sample(gpu-process) zygote_seen=$zygote_seen zygote_first_sample=$role_first_sample(zygote) zygote_last_sample=$role_last_sample(zygote) crashpad_seen=$crashpad_seen unknown_first_sample=$role_first_sample(unknown) unknown_last_sample=$role_last_sample(unknown) unknown_chrome_seen=$unknown_chrome_seen cmdline_truncated_seen=$cmdline_truncated_seen drm_fd_seen=$drm_fd_seen render_fd_seen=$render_fd_seen render_fd_first_sample=$render_fd_first_sample browser_render_fd_seen=$browser_render_fd_seen browser_render_fd_first_sample=$browser_render_fd_first_sample card_fd_seen=$card_fd_seen role_counts=$role_counts_text role_source_counts=$role_source_counts_text first_unknown_chrome=[evidence_quote $first_unknown_chrome] first_cmdline_truncated=[evidence_quote $first_cmdline_truncated]"
}

proc chromium_process_policy_summary {} {
    global chromium_process_evidence_log

    if {![file exists $chromium_process_evidence_log]} {
        return "available=0"
    }

    set text [read_text_file $chromium_process_evidence_log]
    set simdutf_count 0
    set browser_simdutf_count 0
    set gpu_simdutf_count 0
    set renderer_simdutf_count 0
    set zygote_simdutf_count 0
    set use_gl_count 0
    set use_angle_count 0
    set gpu_use_gl_count 0
    set gpu_use_angle_count 0
    set egl_platform_count 0
    set browser_egl_platform_count 0
    set gpu_egl_platform_count 0
    set first_simdutf ""
    set last_simdutf ""
    set first_use_gl ""
    set last_use_gl ""
    set first_use_angle ""
    set last_use_angle ""

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {kde_chromium_process_evidence env phase=[^ ]+ pid=([0-9]+) role="([^"]*)" entry="SIMDUTF_FORCE_IMPLEMENTATION=([^"]*)"} $line -> _pid role value]} {
            incr simdutf_count
            if {$role eq "browser"} {
                incr browser_simdutf_count
            } elseif {$role eq "gpu-process"} {
                incr gpu_simdutf_count
            } elseif {$role eq "renderer"} {
                incr renderer_simdutf_count
            } elseif {$role eq "zygote"} {
                incr zygote_simdutf_count
            }
            set rendered "role=$role value=$value"
            if {$first_simdutf eq ""} {
                set first_simdutf $rendered
            }
            set last_simdutf $rendered
        }
        if {[regexp {kde_chromium_process_evidence env phase=[^ ]+ pid=([0-9]+) role="([^"]*)" entry="EGL_PLATFORM=([^"]*)"} $line -> _pid role _value]} {
            incr egl_platform_count
            if {$role eq "browser"} {
                incr browser_egl_platform_count
            } elseif {$role eq "gpu-process"} {
                incr gpu_egl_platform_count
            }
        }
        if {[regexp {kde_chromium_process_evidence process phase=[^ ]+ pid=([0-9]+) ppid=[-0-9]+ comm="[^"]*" role="([^"]*)" cmd="([^"]*)"} $line -> _pid role cmd]} {
            if {[regexp {(^| )--use-gl=([^ ]+)} $cmd -> _ value]} {
                incr use_gl_count
                if {$role eq "gpu-process"} {
                    incr gpu_use_gl_count
                }
                set rendered "role=$role value=$value"
                if {$first_use_gl eq ""} {
                    set first_use_gl $rendered
                }
                set last_use_gl $rendered
            }
            if {[regexp {(^| )--use-angle=([^ ]+)} $cmd -> _ value]} {
                incr use_angle_count
                if {$role eq "gpu-process"} {
                    incr gpu_use_angle_count
                }
                set rendered "role=$role value=$value"
                if {$first_use_angle eq ""} {
                    set first_use_angle $rendered
                }
                set last_use_angle $rendered
            }
        }
    }

    return "available=1 simdutf_count=$simdutf_count browser_simdutf_count=$browser_simdutf_count gpu_simdutf_count=$gpu_simdutf_count renderer_simdutf_count=$renderer_simdutf_count zygote_simdutf_count=$zygote_simdutf_count egl_platform_count=$egl_platform_count browser_egl_platform_count=$browser_egl_platform_count gpu_egl_platform_count=$gpu_egl_platform_count use_gl_count=$use_gl_count use_angle_count=$use_angle_count gpu_use_gl_count=$gpu_use_gl_count gpu_use_angle_count=$gpu_use_angle_count first_simdutf=[evidence_quote $first_simdutf] last_simdutf=[evidence_quote $last_simdutf] first_use_gl=[evidence_quote $first_use_gl] last_use_gl=[evidence_quote $last_use_gl] first_use_angle=[evidence_quote $first_use_angle] last_use_angle=[evidence_quote $last_use_angle]"
}

proc chromium_process_phase_index {phase} {
    if {[regexp {^(sample|burst)-([0-9]+)$} $phase -> _kind sample_text]} {
        scan $sample_text "%d" sample_index
        return $sample_index
    }
    if {$phase eq "after"} {
        return 0
    }
    return -1
}

proc chromium_unique_append {items value} {
    if {$value ne "" && [lsearch -exact $items $value] < 0} {
        lappend items $value
    }
    return $items
}

proc chromium_short_value {value max_len} {
    if {[string length $value] <= $max_len} {
        return $value
    }
    return "[string range $value 0 [expr {$max_len - 4}]]..."
}

proc chromium_base64_decode_bytes {text status_var} {
    upvar 1 $status_var status
    set alphabet "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    set clean [regsub -all {[ \t\r\n]} $text ""]
    set bytes {}
    set status "ok"

    if {$clean eq ""} {
        return $bytes
    }
    if {[string length $clean] % 4 != 0} {
        set status "invalid-length"
        return {}
    }

    for {set i 0} {$i < [string length $clean]} {incr i 4} {
        set chars [string range $clean $i [expr {$i + 3}]]
        set vals {}
        set pad 0
        for {set j 0} {$j < 4} {incr j} {
            set ch [string index $chars $j]
            if {$ch eq "="} {
                incr pad
                lappend vals 0
                continue
            }
            if {$pad > 0} {
                set status "data-after-padding"
                return {}
            }
            set val [string first $ch $alphabet]
            if {$val < 0} {
                set status "invalid-character"
                return {}
            }
            lappend vals $val
        }
        if {$pad > 2 || ($pad > 0 && $i + 4 != [string length $clean])} {
            set status "invalid-padding"
            return {}
        }

        set v0 [lindex $vals 0]
        set v1 [lindex $vals 1]
        set v2 [lindex $vals 2]
        set v3 [lindex $vals 3]
        lappend bytes [expr {(($v0 << 2) | ($v1 >> 4)) & 0xff}]
        if {$pad < 2} {
            lappend bytes [expr {((($v1 & 0xf) << 4) | ($v2 >> 2)) & 0xff}]
        }
        if {$pad < 1} {
            lappend bytes [expr {((($v2 & 0x3) << 6) | $v3) & 0xff}]
        }
    }

    return $bytes
}

proc chromium_bytes_hex_head {bytes max_bytes} {
    set parts {}
    set count 0
    foreach byte $bytes {
        if {$count >= $max_bytes} {
            break
        }
        lappend parts [format "%02x" $byte]
        incr count
    }
    return [join $parts ""]
}

proc chromium_bytes_u32le_head {bytes max_words} {
    set words {}
    set limit [expr {[llength $bytes] / 4}]
    if {$limit > $max_words} {
        set limit $max_words
    }
    for {set i 0} {$i < $limit} {incr i} {
        set o [expr {$i * 4}]
        set value [expr {([lindex $bytes $o] |
                          ([lindex $bytes [expr {$o + 1}]] << 8) |
                          ([lindex $bytes [expr {$o + 2}]] << 16) |
                          ([lindex $bytes [expr {$o + 3}]] << 24)) &
                         0xffffffff}]
        lappend words [format "0x%08x" $value]
    }
    if {[llength $words] == 0} {
        return "none"
    }
    return [join $words ","]
}

proc chromium_bytes_fnv32 {bytes} {
    set hash 2166136261
    foreach byte $bytes {
        set hash [expr {(($hash ^ $byte) * 16777619) & 0xffffffff}]
    }
    return [format "0x%08x" $hash]
}

proc chromium_gpu_preferences_decode_summary {value} {
    if {$value eq "" || $value eq "missing"} {
        return "present=0"
    }

    set bytes [chromium_base64_decode_bytes $value decode_status]
    if {$decode_status ne "ok"} {
        return "present=1 b64_len=[string length $value] decode_status=$decode_status"
    }

    return "present=1 b64_len=[string length $value] decoded_len=[llength $bytes] decoded_fnv32=[chromium_bytes_fnv32 $bytes] decoded_hex_head=[chromium_bytes_hex_head $bytes 32] decoded_u32le_head=[chromium_bytes_u32le_head $bytes 12]"
}

proc chromium_gpu_error_pid_context_summary {} {
    global wayland_chromium_log chromium_process_evidence_log

    if {![file exists $wayland_chromium_log]} {
        return "available=0 reason=launcher-log-missing"
    }

    set gl_error_pids {}
    set gpu_exit_pids {}
    set all_error_pids {}
    set gl_error_first ""
    set gpu_exit_first ""
    foreach raw_line [split [read_text_file $wayland_chromium_log] "\n"] {
        set line [string trim $raw_line]
        if {[regexp {^\[([0-9]+):[0-9]+:.*Requested GL implementation \(gl=([^,]+),angle=([^)]+)\) not found} $line -> pid requested_gl requested_angle]} {
            set gl_error_pids [chromium_unique_append $gl_error_pids $pid]
            set all_error_pids [chromium_unique_append $all_error_pids $pid]
            if {$gl_error_first eq ""} {
                set gl_error_first "pid=$pid gl=$requested_gl angle=$requested_angle"
            }
        }
        if {[regexp {^\[([0-9]+):[0-9]+:.*Exiting GPU process} $line -> pid]} {
            set gpu_exit_pids [chromium_unique_append $gpu_exit_pids $pid]
            set all_error_pids [chromium_unique_append $all_error_pids $pid]
            if {$gpu_exit_first eq ""} {
                set gpu_exit_first "pid=$pid"
            }
        }
    }

    if {[llength $all_error_pids] == 0} {
        return "available=1 gl_error_pids=none gpu_exit_pids=none sampled_error_pid_count=0"
    }
    if {![file exists $chromium_process_evidence_log]} {
        return "available=1 gl_error_pids=[join $gl_error_pids ,] gpu_exit_pids=[join $gpu_exit_pids ,] process_evidence=0"
    }

    array set seen {}
    array set role {}
    array set first_phase {}
    array set last_phase {}
    array set first_sample {}
    array set last_sample {}
    array set use_gl {}
    array set use_angle {}
    array set render_node {}
    array set gpu_preferences {}
    array set gpu_preferences_count {}
    array set cmdline_truncated {}
    array set env_seen {}
    array set egl_platform {}
    array set gallium_driver {}
    array set mesa_driver {}
    array set ozone_platform {}
    array set wayland_display {}
    array set display {}
    array set ld_preload {}
    array set render_fd_seen {}
    array set card_fd_seen {}
    array set maps_libegl {}
    array set maps_libgles {}
    array set maps_libgbm {}
    array set maps_libdrm {}
    array set maps_dri {}

    foreach pid $all_error_pids {
        set seen($pid) 0
        set role($pid) "missing"
        set first_phase($pid) "missing"
        set last_phase($pid) "missing"
        set first_sample($pid) "missing"
        set last_sample($pid) "missing"
        set use_gl($pid) "missing"
        set use_angle($pid) "missing"
        set render_node($pid) "missing"
        set gpu_preferences($pid) "missing"
        set gpu_preferences_count($pid) 0
        set cmdline_truncated($pid) "missing"
        set env_seen($pid) 0
        set egl_platform($pid) "missing"
        set gallium_driver($pid) "missing"
        set mesa_driver($pid) "missing"
        set ozone_platform($pid) "missing"
        set wayland_display($pid) "missing"
        set display($pid) "missing"
        set ld_preload($pid) "absent"
        set render_fd_seen($pid) 0
        set card_fd_seen($pid) 0
        set maps_libegl($pid) 0
        set maps_libgles($pid) 0
        set maps_libgbm($pid) 0
        set maps_libdrm($pid) 0
        set maps_dri($pid) 0
    }

    foreach raw_line [split [read_text_file $chromium_process_evidence_log] "\n"] {
        set line [string trimright $raw_line "\r"]

        if {[regexp {kde_chromium_process_evidence process phase=([^ ]+) pid=([0-9]+) ppid=[-0-9]+ comm="[^"]*" role="([^"]*)" cmd="(.*)" argv="} $line -> phase pid found_role cmd]} {
            if {[lsearch -exact $all_error_pids $pid] < 0} {
                continue
            }
            set seen($pid) 1
            set role($pid) $found_role
            set sample_index [chromium_process_phase_index $phase]
            if {$first_phase($pid) eq "missing" ||
                ($sample_index >= 0 && ($first_sample($pid) eq "missing" ||
                                        $sample_index < $first_sample($pid)))} {
                set first_phase($pid) $phase
                if {$sample_index >= 0} {
                    set first_sample($pid) $sample_index
                }
            }
            if {$last_phase($pid) eq "missing" ||
                ($sample_index >= 0 && ($last_sample($pid) eq "missing" ||
                                        $sample_index > $last_sample($pid)))} {
                set last_phase($pid) $phase
                if {$sample_index >= 0} {
                    set last_sample($pid) $sample_index
                }
            }
            if {[regexp {(^| )--use-gl=([^ ]+)} $cmd -> _ value]} {
                set use_gl($pid) $value
            }
            if {[regexp {(^| )--use-angle=([^ ]+)} $cmd -> _ value]} {
                set use_angle($pid) $value
            }
            if {[regexp {(^| )--render-node-override=([^ ]+)} $cmd -> _ value]} {
                set render_node($pid) $value
            }
            if {[regexp {(^| )--gpu-preferences=([^ ]+)} $cmd -> _ value]} {
                set gpu_preferences($pid) $value
                incr gpu_preferences_count($pid)
            }
            if {[regexp {cmdline_truncated=([0-9]+)} $line -> value]} {
                set cmdline_truncated($pid) $value
            }
            continue
        }

        if {[regexp {kde_chromium_process_evidence env phase=[^ ]+ pid=([0-9]+) role="[^"]*" entry="([^"]*)"} $line -> pid entry]} {
            if {[lsearch -exact $all_error_pids $pid] < 0} {
                continue
            }
            set env_seen($pid) 1
            if {[regexp {^([^=]+)=(.*)$} $entry -> name value]} {
                switch -- $name {
                    EGL_PLATFORM { set egl_platform($pid) $value }
                    GALLIUM_DRIVER { set gallium_driver($pid) $value }
                    MESA_LOADER_DRIVER_OVERRIDE { set mesa_driver($pid) $value }
                    OZONE_PLATFORM { set ozone_platform($pid) $value }
                    WAYLAND_DISPLAY { set wayland_display($pid) $value }
                    DISPLAY { set display($pid) $value }
                    LD_PRELOAD { set ld_preload($pid) $value }
                }
            }
            continue
        }

        if {[regexp {kde_chromium_process_evidence fd phase=[^ ]+ pid=([0-9]+) role="[^"]*" fd="[^"]*" target="([^"]*)"} $line -> pid target]} {
            if {[lsearch -exact $all_error_pids $pid] < 0} {
                continue
            }
            if {[string first "/dev/dri/renderD" $target] >= 0} {
                set render_fd_seen($pid) 1
            }
            if {[string first "/dev/dri/card" $target] >= 0} {
                set card_fd_seen($pid) 1
            }
            continue
        }

        if {[regexp {kde_chromium_process_evidence maps phase=[^ ]+ pid=([0-9]+) role="[^"]*" line="([^"]*)"} $line -> pid map_line]} {
            if {[lsearch -exact $all_error_pids $pid] < 0} {
                continue
            }
            if {[string first "libEGL" $map_line] >= 0} {
                set maps_libegl($pid) 1
            }
            if {[string first "libGLES" $map_line] >= 0} {
                set maps_libgles($pid) 1
            }
            if {[string first "libgbm" $map_line] >= 0} {
                set maps_libgbm($pid) 1
            }
            if {[string first "libdrm" $map_line] >= 0} {
                set maps_libdrm($pid) 1
            }
            if {[string first "/dri/" $map_line] >= 0 || [string first "/gbm/" $map_line] >= 0} {
                set maps_dri($pid) 1
            }
        }
    }

    set sampled_error_pid_count 0
    foreach pid $all_error_pids {
        if {$seen($pid)} {
            incr sampled_error_pid_count
        }
    }

    set first_pid [lindex $all_error_pids 0]
    set first_gpu_preferences_b64_len 0
    set first_gpu_preferences_decoded_len 0
    set first_gpu_preferences_fnv32 "missing"
    set first_gpu_preferences_value "missing"
    set first_gpu_preferences_decode "present=0"
    if {$gpu_preferences($first_pid) ne "missing"} {
        set first_gpu_preferences_b64_len [string length $gpu_preferences($first_pid)]
        set first_gpu_preferences_value [chromium_short_value $gpu_preferences($first_pid) 180]
        set first_gpu_preferences_decode [chromium_gpu_preferences_decode_summary $gpu_preferences($first_pid)]
        if {[regexp {(^| )decoded_len=([0-9]+)($| )} $first_gpu_preferences_decode -> _ value]} {
            set first_gpu_preferences_decoded_len $value
        }
        if {[regexp {(^| )decoded_fnv32=([^ ]+)($| )} $first_gpu_preferences_decode -> _ value]} {
            set first_gpu_preferences_fnv32 $value
        }
    }

    set context_parts {}
    foreach pid $all_error_pids {
        set gp_b64_len 0
        set gp_decoded_len 0
        set gp_decoded_fnv32 "missing"
        if {$gpu_preferences($pid) ne "missing"} {
            set gp_b64_len [string length $gpu_preferences($pid)]
            set gp_summary [chromium_gpu_preferences_decode_summary $gpu_preferences($pid)]
            if {[regexp {(^| )decoded_len=([0-9]+)($| )} $gp_summary -> _ value]} {
                set gp_decoded_len $value
            }
            if {[regexp {(^| )decoded_fnv32=([^ ]+)($| )} $gp_summary -> _ value]} {
                set gp_decoded_fnv32 $value
            }
        }
        lappend context_parts "pid=$pid,seen=$seen($pid),role=$role($pid),first=$first_phase($pid),last=$last_phase($pid),use_gl=$use_gl($pid),use_angle=$use_angle($pid),gpu_preferences_b64_len=$gp_b64_len,gpu_preferences_decoded_len=$gp_decoded_len,gpu_preferences_fnv32=$gp_decoded_fnv32,egl_platform=$egl_platform($pid),ld_preload=$ld_preload($pid),render_fd=$render_fd_seen($pid)"
    }

    return "available=1 gl_error_pids=[join $gl_error_pids ,] gpu_exit_pids=[join $gpu_exit_pids ,] all_error_pids=[join $all_error_pids ,] sampled_error_pid_count=$sampled_error_pid_count pid_contexts=[evidence_quote [join $context_parts {;}]] first_error_pid=$first_pid first_gl_error=[evidence_quote $gl_error_first] first_gpu_exit=[evidence_quote $gpu_exit_first] first_role=[evidence_quote $role($first_pid)] first_phase=$first_phase($first_pid) last_phase=$last_phase($first_pid) first_sample=$first_sample($first_pid) last_sample=$last_sample($first_pid) use_gl=[evidence_quote $use_gl($first_pid)] use_angle=[evidence_quote $use_angle($first_pid)] render_node=[evidence_quote $render_node($first_pid)] gpu_preferences_count=$gpu_preferences_count($first_pid) gpu_preferences_b64_len=$first_gpu_preferences_b64_len gpu_preferences_decoded_len=$first_gpu_preferences_decoded_len gpu_preferences_fnv32=$first_gpu_preferences_fnv32 gpu_preferences_decode=[evidence_quote $first_gpu_preferences_decode] gpu_preferences=[evidence_quote $first_gpu_preferences_value] cmdline_truncated=$cmdline_truncated($first_pid) env_seen=$env_seen($first_pid) egl_platform=[evidence_quote $egl_platform($first_pid)] gallium=[evidence_quote $gallium_driver($first_pid)] mesa_driver=[evidence_quote $mesa_driver($first_pid)] ozone=[evidence_quote $ozone_platform($first_pid)] wayland_display=[evidence_quote $wayland_display($first_pid)] display=[evidence_quote $display($first_pid)] ld_preload=[evidence_quote $ld_preload($first_pid)] render_fd_seen=$render_fd_seen($first_pid) card_fd_seen=$card_fd_seen($first_pid) maps_libegl=$maps_libegl($first_pid) maps_libgles=$maps_libgles($first_pid) maps_libgbm=$maps_libgbm($first_pid) maps_libdrm=$maps_libdrm($first_pid) maps_dri=$maps_dri($first_pid)"
}

proc chromium_process_fast_census_summary {} {
    global wayland_chromium_log chromium_process_evidence_log

    if {![file exists $chromium_process_evidence_log]} {
        return "available=0 reason=process-evidence-missing"
    }

    set gl_error_pids {}
    set gpu_exit_pids {}
    set vaapi_error_pids {}
    set gpu_warning_pids {}
    set all_error_pids {}
    if {[file exists $wayland_chromium_log]} {
        foreach raw_line [split [read_text_file $wayland_chromium_log] "\n"] {
            set line [string trim $raw_line]
            if {[regexp {^\[([0-9]+):[0-9]+:.*Requested GL implementation \(gl=([^,]+),angle=([^)]+)\) not found} $line -> pid _gl _angle]} {
                set gl_error_pids [chromium_unique_append $gl_error_pids $pid]
                set all_error_pids [chromium_unique_append $all_error_pids $pid]
            }
            if {[regexp {^\[([0-9]+):[0-9]+:.*Exiting GPU process} $line -> pid]} {
                set gpu_exit_pids [chromium_unique_append $gpu_exit_pids $pid]
                set all_error_pids [chromium_unique_append $all_error_pids $pid]
            }
            if {[regexp {^\[([0-9]+):[0-9]+:.*vaInitialize failed} $line -> pid]} {
                set vaapi_error_pids [chromium_unique_append $vaapi_error_pids $pid]
                set all_error_pids [chromium_unique_append $all_error_pids $pid]
            }
            if {[regexp {^\[([0-9]+):[0-9]+:.*process gpu-process} $line -> pid]} {
                set gpu_warning_pids [chromium_unique_append $gpu_warning_pids $pid]
                set all_error_pids [chromium_unique_append $all_error_pids $pid]
            }
        }
    }

    array set error_seen {}
    array set error_role {}
    array set error_ppid {}
    array set error_first_phase {}
    array set error_last_phase {}
    array set error_first_sample {}
    array set error_last_sample {}
    array set error_use_gl {}
    array set error_use_angle {}
    array set error_gpu_preferences_b64_len {}
    array set error_gpu_preferences {}
    array set error_disable_gpu_early_init {}
    array set error_cmdline_truncated {}
    foreach pid $all_error_pids {
        set error_seen($pid) 0
        set error_role($pid) "missing"
        set error_ppid($pid) "missing"
        set error_first_phase($pid) "missing"
        set error_last_phase($pid) "missing"
        set error_first_sample($pid) "missing"
        set error_last_sample($pid) "missing"
        set error_use_gl($pid) "missing"
        set error_use_angle($pid) "missing"
        set error_gpu_preferences_b64_len($pid) 0
        set error_gpu_preferences($pid) "missing"
        set error_disable_gpu_early_init($pid) "missing"
        set error_cmdline_truncated($pid) "missing"
    }

    set fast_line_count 0
    set fast_sample_max -1
    array set role_pid_seen {}
    array set role_pid_count {}
    foreach role {browser gpu-process renderer zygote utility crashpad unknown} {
        set role_pid_count($role) 0
    }

    foreach raw_line [split [read_text_file $chromium_process_evidence_log] "\n"] {
        set line [string trimright $raw_line "\r"]
        if {![regexp {kde_chromium_process_evidence fast phase=([^ ]+) pid=([0-9]+) ppid=([-0-9]+) comm="([^"]*)" role="([^"]*)".* type_arg="([^"]*)".* argv0="([^"]*)".* use_gl="([^"]*)".* use_angle="([^"]*)".* gpu_preferences_b64_len=([0-9]+) disable_gpu_early_init=([0-9]+) cmdline_bytes=([0-9]+) cmdline_truncated=([0-9]+)} $line -> phase pid ppid _comm role _type_arg _argv0 use_gl use_angle gpu_pref_len disable_gpu_early_init _cmd_bytes cmdline_truncated]} {
            continue
        }

        incr fast_line_count
        set sample_index -1
        if {[regexp {^fast-([0-9]+)$} $phase -> sample_text]} {
            scan $sample_text "%d" sample_index
            if {$sample_index > $fast_sample_max} {
                set fast_sample_max $sample_index
            }
        }

        set role_key "$role,$pid"
        if {![info exists role_pid_seen($role_key)]} {
            set role_pid_seen($role_key) 1
            if {![info exists role_pid_count($role)]} {
                set role_pid_count($role) 0
            }
            incr role_pid_count($role)
        }

        if {[lsearch -exact $all_error_pids $pid] >= 0} {
            set error_seen($pid) 1
            set error_role($pid) $role
            set error_ppid($pid) $ppid
            if {$error_first_phase($pid) eq "missing" ||
                ($sample_index >= 0 && ($error_first_sample($pid) eq "missing" ||
                                        $sample_index < $error_first_sample($pid)))} {
                set error_first_phase($pid) $phase
                if {$sample_index >= 0} {
                    set error_first_sample($pid) $sample_index
                }
            }
            if {$error_last_phase($pid) eq "missing" ||
                ($sample_index >= 0 && ($error_last_sample($pid) eq "missing" ||
                                        $sample_index > $error_last_sample($pid)))} {
                set error_last_phase($pid) $phase
                if {$sample_index >= 0} {
                    set error_last_sample($pid) $sample_index
                }
            }
            set error_use_gl($pid) $use_gl
            set error_use_angle($pid) $use_angle
            set error_gpu_preferences_b64_len($pid) $gpu_pref_len
            if {[regexp { gpu_preferences="([^"]*)"} $line -> gpu_pref_value] &&
                $gpu_pref_value ne ""} {
                set error_gpu_preferences($pid) $gpu_pref_value
            }
            set error_disable_gpu_early_init($pid) $disable_gpu_early_init
            set error_cmdline_truncated($pid) $cmdline_truncated
        }
    }

    set error_seen_count 0
    set error_contexts {}
    foreach pid $all_error_pids {
        if {$error_seen($pid)} {
            incr error_seen_count
        }
        set gp_decoded_len 0
        set gp_decoded_fnv32 "missing"
        if {$error_gpu_preferences($pid) ne "missing"} {
            set gp_summary [chromium_gpu_preferences_decode_summary $error_gpu_preferences($pid)]
            if {[regexp {(^| )decoded_len=([0-9]+)($| )} $gp_summary -> _ value]} {
                set gp_decoded_len $value
            }
            if {[regexp {(^| )decoded_fnv32=([^ ]+)($| )} $gp_summary -> _ value]} {
                set gp_decoded_fnv32 $value
            }
        }
        lappend error_contexts "pid=$pid,seen=$error_seen($pid),role=$error_role($pid),ppid=$error_ppid($pid),first=$error_first_phase($pid),last=$error_last_phase($pid),use_gl=$error_use_gl($pid),use_angle=$error_use_angle($pid),gpu_preferences_b64_len=$error_gpu_preferences_b64_len($pid),gpu_preferences_decoded_len=$gp_decoded_len,gpu_preferences_fnv32=$gp_decoded_fnv32,disable_gpu_early_init=$error_disable_gpu_early_init($pid),cmdline_truncated=$error_cmdline_truncated($pid)"
    }

    set first_pid [lindex $all_error_pids 0]
    if {$first_pid eq ""} {
        set first_pid "none"
        set first_seen 0
        set first_role "missing"
        set first_first_phase "missing"
        set first_last_phase "missing"
        set first_use_gl "missing"
        set first_use_angle "missing"
    } else {
        set first_seen $error_seen($first_pid)
        set first_role $error_role($first_pid)
        set first_first_phase $error_first_phase($first_pid)
        set first_last_phase $error_last_phase($first_pid)
        set first_use_gl $error_use_gl($first_pid)
        set first_use_angle $error_use_angle($first_pid)
    }
    set first_gpu_preferences_decode "present=0"
    set first_gpu_preferences_b64_len 0
    set first_gpu_preferences_decoded_len 0
    set first_gpu_preferences_fnv32 "missing"
    set first_gpu_preferences_value "missing"
    if {$first_pid ne "none" && $error_gpu_preferences($first_pid) ne "missing"} {
        set first_gpu_preferences_b64_len [string length $error_gpu_preferences($first_pid)]
        set first_gpu_preferences_decode [chromium_gpu_preferences_decode_summary $error_gpu_preferences($first_pid)]
        set first_gpu_preferences_value [chromium_short_value $error_gpu_preferences($first_pid) 180]
        if {[regexp {(^| )decoded_len=([0-9]+)($| )} $first_gpu_preferences_decode -> _ value]} {
            set first_gpu_preferences_decoded_len $value
        }
        if {[regexp {(^| )decoded_fnv32=([^ ]+)($| )} $first_gpu_preferences_decode -> _ value]} {
            set first_gpu_preferences_fnv32 $value
        }
    }

    set error_pids_text "none"
    set gl_error_text "none"
    set gpu_exit_text "none"
    set vaapi_error_text "none"
    set gpu_warning_text "none"
    if {[llength $all_error_pids]} {
        set error_pids_text [join $all_error_pids ,]
    }
    if {[llength $gl_error_pids]} {
        set gl_error_text [join $gl_error_pids ,]
    }
    if {[llength $gpu_exit_pids]} {
        set gpu_exit_text [join $gpu_exit_pids ,]
    }
    if {[llength $vaapi_error_pids]} {
        set vaapi_error_text [join $vaapi_error_pids ,]
    }
    if {[llength $gpu_warning_pids]} {
        set gpu_warning_text [join $gpu_warning_pids ,]
    }

    return "available=1 fast_line_count=$fast_line_count fast_sample_max=$fast_sample_max browser_pids=$role_pid_count(browser) gpu_process_pids=$role_pid_count(gpu-process) renderer_pids=$role_pid_count(renderer) zygote_pids=$role_pid_count(zygote) utility_pids=$role_pid_count(utility) crashpad_pids=$role_pid_count(crashpad) unknown_pids=$role_pid_count(unknown) error_pids=$error_pids_text gl_error_pids=$gl_error_text gpu_exit_pids=$gpu_exit_text vaapi_error_pids=$vaapi_error_text gpu_warning_pids=$gpu_warning_text error_seen_count=$error_seen_count error_contexts=[evidence_quote [join $error_contexts {;}]] first_error_pid=$first_pid first_error_seen=$first_seen first_error_role=[evidence_quote $first_role] first_error_first=$first_first_phase first_error_last=$first_last_phase first_error_use_gl=[evidence_quote $first_use_gl] first_error_use_angle=[evidence_quote $first_use_angle] first_error_gpu_preferences_b64_len=$first_gpu_preferences_b64_len first_error_gpu_preferences_decoded_len=$first_gpu_preferences_decoded_len first_error_gpu_preferences_fnv32=$first_gpu_preferences_fnv32 first_error_gpu_preferences_decode=[evidence_quote $first_gpu_preferences_decode] first_error_gpu_preferences=[evidence_quote $first_gpu_preferences_value]"
}

proc chromium_process_role_lifecycle_summary {} {
    global chromium_process_evidence_log

    if {![file exists $chromium_process_evidence_log]} {
        return "available=0"
    }

    set text [read_text_file $chromium_process_evidence_log]
    set sample_max -1
    set process_line_count 0
    array set role_pid_seen {}
    array set role_sample_seen {}
    array set role_pid_sample_seen {}
    array set role_first_sample {}
    array set role_last_sample {}
    array set role_sample_count {}
    array set role_pid_count {}
    array set role_pid_first_sample {}
    array set role_pid_last_sample {}
    array set role_pid_sample_count {}

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {![regexp {kde_chromium_process_evidence process phase=([^ ]+) pid=([0-9]+) ppid=[-0-9]+ comm="[^"]*" role="([^"]*)"} $line -> phase pid role]} {
            continue
        }

        set sample_index -1
        if {[regexp {^(sample|burst)-([0-9]+)$} $phase -> _kind sample_text]} {
            scan $sample_text "%d" sample_index
        } elseif {$phase eq "after"} {
            set sample_index 0
        }
        if {$sample_index < 0} {
            continue
        }

        incr process_line_count
        if {$sample_index > $sample_max} {
            set sample_max $sample_index
        }
        if {![info exists role_first_sample($role)] ||
            $sample_index < $role_first_sample($role)} {
            set role_first_sample($role) $sample_index
        }
        if {![info exists role_last_sample($role)] ||
            $sample_index > $role_last_sample($role)} {
            set role_last_sample($role) $sample_index
        }

        set role_pid_key "$role,$pid"
        if {![info exists role_pid_seen($role_pid_key)]} {
            set role_pid_seen($role_pid_key) 1
            if {![info exists role_pid_count($role)]} {
                set role_pid_count($role) 0
            }
            incr role_pid_count($role)
        }

        set role_sample_key "$role,$sample_index"
        if {![info exists role_sample_seen($role_sample_key)]} {
            set role_sample_seen($role_sample_key) 1
            if {![info exists role_sample_count($role)]} {
                set role_sample_count($role) 0
            }
            incr role_sample_count($role)
        }

        set role_pid_sample_key "$role,$pid,$sample_index"
        if {![info exists role_pid_sample_seen($role_pid_sample_key)]} {
            set role_pid_sample_seen($role_pid_sample_key) 1
            if {![info exists role_pid_sample_count($role_pid_key)]} {
                set role_pid_sample_count($role_pid_key) 0
            }
            incr role_pid_sample_count($role_pid_key)
        }
        if {![info exists role_pid_first_sample($role_pid_key)] ||
            $sample_index < $role_pid_first_sample($role_pid_key)} {
            set role_pid_first_sample($role_pid_key) $sample_index
        }
        if {![info exists role_pid_last_sample($role_pid_key)] ||
            $sample_index > $role_pid_last_sample($role_pid_key)} {
            set role_pid_last_sample($role_pid_key) $sample_index
        }
    }

    set role_parts {}
    foreach role [lsort [array names role_sample_count]] {
        set pid_count 0
        if {[info exists role_pid_count($role)]} {
            set pid_count $role_pid_count($role)
        }
        lappend role_parts "$role:samples=$role_sample_count($role):pids=$pid_count:first=$role_first_sample($role):last=$role_last_sample($role)"
    }
    if {[llength $role_parts] == 0} {
        set role_samples_text "none"
    } else {
        set role_samples_text [join $role_parts ","]
    }

    set pid_parts {}
    foreach key [lsort [array names role_pid_sample_count]] {
        lassign [split $key ","] role pid
        lappend pid_parts "$role/$pid:samples=$role_pid_sample_count($key):first=$role_pid_first_sample($key):last=$role_pid_last_sample($key)"
    }
    if {[llength $pid_parts] == 0} {
        set pid_samples_text "none"
    } else {
        set pid_samples_text [join $pid_parts ","]
    }

    foreach role {browser renderer gpu-process zygote utility unknown} {
        if {![info exists role_sample_count($role)]} {
            set role_sample_count($role) 0
        }
        if {![info exists role_pid_count($role)]} {
            set role_pid_count($role) 0
        }
        if {![info exists role_first_sample($role)]} {
            set role_first_sample($role) "missing"
        }
        if {![info exists role_last_sample($role)]} {
            set role_last_sample($role) "missing"
        }
    }

    return "available=1 sample_max=$sample_max process_line_count=$process_line_count browser_samples=$role_sample_count(browser) browser_pids=$role_pid_count(browser) browser_first=$role_first_sample(browser) browser_last=$role_last_sample(browser) renderer_samples=$role_sample_count(renderer) renderer_pids=$role_pid_count(renderer) renderer_first=$role_first_sample(renderer) renderer_last=$role_last_sample(renderer) gpu_samples=$role_sample_count(gpu-process) gpu_pids=$role_pid_count(gpu-process) gpu_first=$role_first_sample(gpu-process) gpu_last=$role_last_sample(gpu-process) zygote_samples=$role_sample_count(zygote) zygote_pids=$role_pid_count(zygote) utility_samples=$role_sample_count(utility) utility_pids=$role_pid_count(utility) unknown_samples=$role_sample_count(unknown) unknown_pids=$role_pid_count(unknown) role_samples=$role_samples_text pid_samples=$pid_samples_text"
}

proc guest_artifact_real_file {path} {
    if {![file exists $path]} {
        return 0
    }
    set text [read_text_file $path]
    return [expr {![regexp {^missing guest_path=} $text]}]
}

proc dump_optional_guest_artifact {guest_path host_path} {
    global tmpimg

    set tmp "$host_path.debugfs.[pid]"
    catch { file delete -force $tmp }
    set dumped [expr {![catch {
        exec sh -c "debugfs -R 'dump $guest_path $tmp' '$tmpimg' >/dev/null 2>&1"
    }]}]
    if {$dumped && [file exists $tmp]} {
        file rename -force $tmp $host_path
        return 1
    }
    catch { file delete -force $tmp }
    set fh [open $host_path w]
    puts $fh "missing guest_path=$guest_path"
    close $fh
    return 0
}

proc check_qtquick_accel_policy {} {
    global qtquick_accel_policy_log
    global kde_session_plasma_log kde_session_kwin_log runlog
    global plasmashell_crash_capture_log chromium_launch_probe_log
    global desktop_interaction_log

    set paths [list \
        $kde_session_plasma_log \
        $kde_session_kwin_log \
        $runlog \
        $plasmashell_crash_capture_log \
        $chromium_launch_probe_log \
        $desktop_interaction_log]
    set violations {}
    set proofs {}

    foreach path $paths {
        if {![file exists $path]} {
            continue
        }
        set text [read_text_file $path]
        foreach raw_line [split $text "\n"] {
            set line [string trimright $raw_line "\r"]
            if {$line eq ""} {
                continue
            }
            if {[regexp -nocase {fallback to QtQuick software backend|QT_QUICK_BACKEND=software|QSG_RHI_BACKEND=software|LIBGL_ALWAYS_SOFTWARE=(1|true|yes|on)|OpenGL renderer string:[^\r\n]*(llvmpipe|softpipe|swrast|kms_swrast)|\b(llvmpipe|softpipe|swrast|kms_swrast)\b} $line]} {
                lappend violations "$path:[evidence_quote $line]"
            }
            if {$path eq $kde_session_plasma_log &&
                [regexp -nocase {Failed to initialize EGL display|failed to create dri2 screen} $line]} {
                lappend violations "$path:[evidence_quote $line]"
            }
            if {[regexp {kde-plasma-session-child: graphics } $line] ||
                [regexp {OpenGL renderer string:[^\r\n]*virgl} $line] ||
                [regexp {qt\.scenegraph\.(general|renderloop)} $line]} {
                lappend proofs "$path:[evidence_quote $line]"
            }
        }
    }

    set fh [open $qtquick_accel_policy_log w]
    if {[llength $violations] > 0} {
        puts $fh "status=FAIL reason=software-fallback-or-renderer"
        foreach violation $violations {
            puts $fh "violation=$violation"
        }
    } else {
        puts $fh "status=PASS reason=no-qtquick-software-or-software-renderer-marker"
    }
    foreach proof $proofs {
        puts $fh "proof=$proof"
    }
    close $fh

    if {[llength $violations] > 0} {
        return [lindex $violations 0]
    }
    return ""
}

proc dump_guest_core_artifacts {} {
    global tmpimg outdir

    set listing ""
    catch { set listing [exec sh -c "debugfs -R 'ls -p /' '$tmpimg' 2>/dev/null || true"] }
    foreach line [split $listing "\n"] {
        if {[regexp {/[0-9]+/[0-7]+/[0-9]+/[0-9]+/(core\.[0-9]+)(/|$)} $line -> core_name]} {
            dump_optional_guest_artifact "/$core_name" "$outdir/$core_name"
        }
    }
}

proc dump_guest_kcrash_metadata_artifacts {} {
    global tmpimg outdir

    set metadata_dir "/dev/shm/kde-cache/kcrash-metadata"
    set listing ""
    catch { set listing [exec sh -c "debugfs -R 'ls -p $metadata_dir' '$tmpimg' 2>/dev/null || true"] }
    foreach line [split $listing "\n"] {
        if {[regexp {/[0-9]+/[0-7]+/[0-9]+/[0-9]+/([^/]+\.ini)(/|$)} $line -> metadata_name]} {
            dump_optional_guest_artifact "$metadata_dir/$metadata_name" "$outdir/kcrash-metadata-$metadata_name"
        }
    }
}

proc read_guest_artifact_text {guest_path text_var} {
    global tmpimg outdir
    upvar 1 $text_var text

    set tmp "$outdir/.debugfs-read-[pid]-[clock milliseconds]"
    catch { file delete -force $tmp }
    set text ""
    if {[catch {
        exec sh -c "debugfs -R 'dump $guest_path $tmp' '$tmpimg' >/dev/null 2>&1"
    }]} {
        catch { file delete -force $tmp }
        return 0
    }
    if {![file exists $tmp]} {
        return 0
    }
    set fh [open $tmp r]
    set text [read $fh]
    close $fh
    catch { file delete -force $tmp }
    return 1
}

proc wait_for_kde_preflight_runner_status {phase timeout_seconds} {
    global timeout guest_kde_preflight_runner_status

    set old_timeout $timeout
    set deadline [expr {[clock milliseconds] + ($timeout_seconds * 1000)}]
    set last_status ""
    while {[clock milliseconds] < $deadline} {
        set status_text ""
        if {[read_guest_artifact_text $guest_kde_preflight_runner_status status_text]} {
            set last_status [string trim $status_text]
            if {[regexp {status=FAIL reason=([^ \t\r\n]+)} $status_text -> reason]} {
                set timeout $old_timeout
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-preflight-$reason"
            }
            if {$phase eq "kwin" &&
                [regexp {status=(kwin-pass|qtqml-running|PASS)} $status_text]} {
                set timeout $old_timeout
                return $last_status
            }
            if {$phase eq "qtqml" && [regexp {status=PASS} $status_text]} {
                set timeout $old_timeout
                return $last_status
            }
        }

        set timeout 1
        expect {
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|kde-exception-fatal-summary|pid [0-9]+ [^:\r\n]+: exception [0-9]+} {
                set timeout $old_timeout
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-preflight-crash"
            }
            -re {.+[\r\n]+} {}
            timeout {}
            eof {
                set timeout $old_timeout
                finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-preflight-eof"
            }
        }
    }
    set timeout $old_timeout
    puts "KDE-PLASMA-DESKTOP-SMOKE-WARN kde-preflight-runner-timeout phase=$phase last_status=[evidence_quote $last_status]"
    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-preflight-$phase-timeout"
}

proc wait_for_chromium_video_egl_gbm_artifacts {timeout_seconds} {
    global timeout guest_host_egl_gbm_status guest_host_egl_gbm_log

    set old_timeout $timeout
    set deadline [expr {[clock milliseconds] + ($timeout_seconds * 1000)}]
    set last_status ""
    set last_result ""
    while {[clock milliseconds] < $deadline} {
        set status_text ""
        if {[read_guest_artifact_text $guest_host_egl_gbm_status status_text]} {
            set last_status [string trim $status_text]
            if {[regexp {status=DONE} $status_text]} {
                set log_text ""
                if {[read_guest_artifact_text $guest_host_egl_gbm_log log_text]} {
                    foreach raw_line [split $log_text "\n"] {
                        set line [string trimright $raw_line "\r"]
                        if {[regexp {host-egl-gbm-gl-smoke: phase=result status=} $line]} {
                            set last_result $line
                        }
                    }
                    if {[regexp {host-egl-gbm-gl-smoke: phase=result status=PASS} $last_result]} {
                        set timeout $old_timeout
                        return [list $last_status $last_result]
                    }
                }
            }
        }

        set timeout 1
        expect {
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|kde-exception-fatal-summary|pid [0-9]+ [^:\r\n]+: exception [0-9]+} {
                set timeout $old_timeout
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-egl-gbm-artifact-crash"
            }
            -re {.+[\r\n]+} {}
            timeout {}
            eof {
                set timeout $old_timeout
                finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-egl-gbm-artifact-eof"
            }
        }
    }
    set timeout $old_timeout
    puts "KDE-PLASMA-DESKTOP-SMOKE-WARN chromium-video-egl-gbm-artifact-timeout status=[evidence_quote $last_status] result=[evidence_quote $last_result]"
    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-egl-gbm-artifact-timeout"
}

proc capture_fbstat_stats {} {
    global timeout guest_fbstat_log

    set old_timeout $timeout
    set timeout 30
    set marker "KFBSTATDONE[pid]"
    set marker_re [format {(^|[\r\n])%s[\r\n]} $marker]
    send "fbstat > $guest_fbstat_log; echo $marker\r"
    expect {
        -re $marker_re {
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            set timeout $old_timeout
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL fbstat-capture-crash"
        }
        timeout {
            puts "KDE-PLASMA-DESKTOP-SMOKE-WARN fbstat-capture-timeout"
        }
        eof {
            set timeout $old_timeout
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL fbstat-capture-eof"
        }
    }
    set timeout $old_timeout
}

proc kwin_loader_ifunc_log_has_pass {} {
    global guest_kwin_loader_ifunc_log kwin_loader_ifunc_log

    if {![dump_optional_guest_artifact $guest_kwin_loader_ifunc_log $kwin_loader_ifunc_log]} {
        return 0
    }
    set log_text [read_text_file $kwin_loader_ifunc_log]
    return [regexp {KDE_DLOPEN_PROBE_KWIN_HELP_RESULT status=PASS} $log_text]
}

proc chromium_egl_trace_guest_paths {} {
    global tmpimg

    set paths {}
    if {[catch {
        exec sh -c "debugfs -R 'ls -p /' '$tmpimg' 2>/dev/null"
    } listing]} {
        return $paths
    }
    foreach raw_line [split $listing "\n"] {
        set fields [split $raw_line "/"]
        if {[llength $fields] < 6} {
            continue
        }
        set name [lindex $fields 5]
        if {[string match "chromium-egl-trace*.log" $name]} {
            lappend paths "/$name"
        }
    }
    return [lsort -unique $paths]
}

proc dump_chromium_egl_trace_artifacts {} {
    global chromium_egl_trace_log tmpimg

    catch { file delete -force $chromium_egl_trace_log }
    set paths [chromium_egl_trace_guest_paths]
    set dumped 0
    foreach guest_path $paths {
        set base [file tail $guest_path]
        set tmp "$chromium_egl_trace_log.$base.debugfs.[pid]"
        catch { file delete -force $tmp }
        if {![catch {
            exec sh -c "debugfs -R 'dump $guest_path $tmp' '$tmpimg' >/dev/null 2>&1"
        }] && [file exists $tmp]} {
            set in [open $tmp r]
            set text [read $in]
            close $in
            set out [open $chromium_egl_trace_log a]
            puts $out "chromium_egl_trace phase=host_dump guest_path=$guest_path"
            puts -nonewline $out $text
            if {$text ne "" && [string index $text end] ne "\n"} {
                puts $out ""
            }
            close $out
            incr dumped
        }
        catch { file delete -force $tmp }
    }
    if {$dumped > 0} {
        return 1
    }

    set fh [open $chromium_egl_trace_log w]
    puts $fh "missing guest_path=/chromium-egl-trace*.log"
    close $fh
    return 0
}

proc debugfs_path_exists {path} {
    global tmpimg

    return [expr {![catch {
        exec sh -c "debugfs -R 'stat $path' '$tmpimg' 2>&1 | grep -q '^Inode:'"
    }]}]
}

proc shell_quote {text} {
    return "'[string map [list ' '\\''] $text]'"
}

proc evidence_quote {text} {
    return "\"[string map [list \\ \\\\ \" \\\" \n \\n \r \\r \t \\t] $text]\""
}

proc append_host_log_line {path line} {
    set fh [open $path a]
    puts $fh $line
    close $fh
}

proc marker_re {marker} {
    return [format {(^|\r|\n)%s(\r|\n)} $marker]
}

proc async_marker_re {marker} {
    return [format {(^|[^A-Za-z0-9_])%s($|\r|\n|[^A-Za-z0-9_])} $marker]
}

proc fuzzy_async_marker_re {marker} {
    set pattern {(^|[^A-Za-z0-9_])}
    foreach ch [split $marker ""] {
        append pattern $ch {(.|\r|\n){0,240}}
    }
    append pattern {($|\r|\n|[^A-Za-z0-9_])}
    return $pattern
}

proc chromium_video_sample_present {path} {
    if {![file exists $path]} {
        return 0
    }
    if {[file size $path] <= 3072000} {
        return 0
    }
    set fh [open $path rb]
    set prefix [read $fh 64]
    close $fh
    return [regexp {^P6[ \t\r\n]+1280[ \t\r\n]+800[ \t\r\n]+255[ \t\r\n]} $prefix]
}

proc chromium_video_frame_im_stats {path stats_var} {
    upvar 1 $stats_var stats

    array set stats {
        im_status unavailable
        mean unavailable
        stddev unavailable
        extrema unavailable
        black_class unavailable
    }
    if {[auto_execok convert] eq ""} {
        return
    }

    set qpath [shell_quote $path]
    if {[catch {
        exec sh -c "convert $qpath -format '%\[fx:mean\]\t%\[fx:standard_deviation\]\t%\[fx:minima\]\t%\[fx:maxima\]' info: 2>&1; status=\$?; printf '\n__status=%s\n' \"\$status\""
    } out]} {
        set stats(im_status) "convert-failed"
        return
    }
    set status "1"
    regexp {__status=([0-9]+)} $out -> status
    regsub {\n__status=[0-9]+\n?$} $out "" body
    if {$status ne "0"} {
        set stats(im_status) "convert-failed"
        return
    }

    if {![regexp {^[ \t\r\n]*([^ \t\r\n]+)[ \t\r\n]+([^ \t\r\n]+)[ \t\r\n]+([^ \t\r\n]+)[ \t\r\n]+([^ \t\r\n]+)} $body -> mean stddev min max]} {
        set stats(im_status) "convert-failed"
        return
    }
    set stats(im_status) "ok"
    set stats(mean) $mean
    set stats(stddev) $stddev
    set stats(extrema) "min=$min,max=$max"
    if {[catch {expr {double($max) <= 0.0}} is_black]} {
        set stats(black_class) "unavailable"
    } elseif {$is_black} {
        set stats(black_class) "black"
    } else {
        set stats(black_class) "nonblack"
    }
}

proc chromium_video_frame_ae_delta {previous_path path} {
    if {$previous_path eq ""} {
        return [list "no-previous-present" "unavailable"]
    }
    if {[auto_execok compare] eq ""} {
        return [list "unavailable" "unavailable"]
    }

    set qprevious [shell_quote $previous_path]
    set qpath [shell_quote $path]
    if {[catch {
        exec sh -c "compare -metric AE $qprevious $qpath null: 2>&1; status=\$?; printf '\n__status=%s\n' \"\$status\""
    } out]} {
        return [list "compare-failed" "unavailable"]
    }
    set status "2"
    regexp {__status=([0-9]+)} $out -> status
    regsub {\n__status=[0-9]+\n?$} $out "" body
    if {$status ne "0" && $status ne "1"} {
        return [list "compare-failed" "unavailable"]
    }
    if {![regexp {[-+]?([0-9]+\.?[0-9]*|\.[0-9]+)([eE][-+]?[0-9]+)?} $body delta]} {
        return [list "compare-failed" "unavailable"]
    }
    return [list "ok" $delta]
}

proc chromium_video_file_sha256 {path} {
    if {![file exists $path] || [file size $path] <= 0} {
        return "missing"
    }
    if {[auto_execok sha256sum] eq ""} {
        return "unavailable"
    }
    if {[catch {exec sha256sum $path} out]} {
        return "unavailable"
    }
    if {[regexp {^([0-9a-fA-F]+)} $out -> hash]} {
        return [string tolower $hash]
    }
    return "unavailable"
}

proc chromium_video_frame_hash_summary {} {
    global outdir chromium_video_sample_count

    set present_count 0
    set hash_count 0
    set first_hash "missing"
    set last_hash "missing"
    set hashes {}

    for {set i 0} {$i < $chromium_video_sample_count} {incr i} {
        set host_path [format "%s/chromium-video-%02d.ppm" $outdir $i]
        if {![chromium_video_sample_present $host_path]} {
            continue
        }
        incr present_count
        set hash [chromium_video_file_sha256 $host_path]
        if {$hash eq "missing" || $hash eq "unavailable"} {
            continue
        }
        incr hash_count
        if {$first_hash eq "missing"} {
            set first_hash $hash
        }
        set last_hash $hash
        lappend hashes $hash
    }

    set unique_hashes [lsort -unique $hashes]
    set sample_hashes [lrange $unique_hashes 0 4]
    return "available=1 present_count=$present_count hash_count=$hash_count unique_hash_count=[llength $unique_hashes] first_hash=$first_hash last_hash=$last_hash sample_hashes=[join $sample_hashes ,]"
}

proc chromium_video_scanout_sample_current_summary {} {
    global chromium_video_capture_log chromium_video_sample_count

    if {![file exists $chromium_video_capture_log]} {
        return "available=0"
    }

    set text [read_text_file $chromium_video_capture_log]
    set sample_count 0
    set before_count 0
    set after_count 0
    set nonblack_count 0
    set changed_count 0
    set post_nonblack_changed_count 0
    set first_nonblack_index -1
    set first_hash "missing"
    set last_hash "missing"
    set first_before_hash "missing"
    set last_before_hash "missing"
    set first_avg_rgb "missing"
    set last_avg_rgb "missing"
    set first_center "missing"
    set last_center "missing"
    set previous_hash "missing"
    set previous_nonblack 0
    set pending_stage "unknown"
    set pending_frame -1
    set hashes {}
    set before_hashes {}

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {kde_chromium_video_capture frame=([0-9]+) sample_current_(before|after)} $line -> frame stage]} {
            set pending_frame $frame
            set pending_stage $stage
            continue
        }
        if {![regexp {^fb_sample_current .* nonblack=([0-9]+) .*avg_rgb=([0-9]+,[0-9]+,[0-9]+) hash=(0x[0-9a-fA-F]+) center=(0x[0-9a-fA-F]+)} $line -> nonblack avg_rgb hash center]} {
            continue
        }

        set hash [string tolower $hash]
        set center [string tolower $center]
        set sample_index $sample_count
        incr sample_count
        lappend hashes $hash
        if {$first_hash eq "missing"} {
            set first_hash $hash
            set first_avg_rgb $avg_rgb
            set first_center $center
        }
        set last_hash $hash
        set last_avg_rgb $avg_rgb
        set last_center $center

        if {$pending_stage eq "before"} {
            incr before_count
            lappend before_hashes $hash
            if {$first_before_hash eq "missing"} {
                set first_before_hash $hash
            }
            set last_before_hash $hash
        } elseif {$pending_stage eq "after"} {
            incr after_count
        }

        set current_nonblack [expr {$nonblack > 0 ? 1 : 0}]
        if {$current_nonblack} {
            incr nonblack_count
            if {$first_nonblack_index < 0} {
                set first_nonblack_index $sample_index
            }
        }
        if {$previous_hash ne "missing" && $hash ne $previous_hash} {
            incr changed_count
            if {$previous_nonblack || $current_nonblack} {
                incr post_nonblack_changed_count
            }
        }
        set previous_hash $hash
        set previous_nonblack $current_nonblack
        set pending_stage "unknown"
        set pending_frame -1
    }

    set unique_hashes [lsort -unique $hashes]
    set unique_before_hashes [lsort -unique $before_hashes]
    set sample_hashes [lrange $unique_hashes 0 4]
    set expected_count [expr {$chromium_video_sample_count * 2}]
    set status "PASS"
    if {$sample_count < $expected_count ||
        $before_count < $chromium_video_sample_count ||
        $after_count < $chromium_video_sample_count} {
        set status "FAIL"
    }
    return "available=1 status=$status expected_count=$expected_count sample_count=$sample_count before_count=$before_count after_count=$after_count unique_hash_count=[llength $unique_hashes] before_unique_hash_count=[llength $unique_before_hashes] first_hash=$first_hash last_hash=$last_hash first_before_hash=$first_before_hash last_before_hash=$last_before_hash nonblack_count=$nonblack_count first_nonblack_index=$first_nonblack_index changed_count=$changed_count post_nonblack_changed_count=$post_nonblack_changed_count first_avg_rgb=$first_avg_rgb last_avg_rgb=$last_avg_rgb first_center=$first_center last_center=$last_center sample_hashes=[join $sample_hashes ,]"
}

proc write_chromium_video_frame_stats {} {
    global outdir chromium_video_sample_count chromium_video_frame_stats

    set fh [open $chromium_video_frame_stats w]
    puts $fh "index\thost_filename\tpresent\tbytes\tsha256\tim_status\tmean\tstddev\textrema\tblack_class\tprev_ae_status\tprev_ae_delta"
    set previous_present_path ""
    for {set i 0} {$i < $chromium_video_sample_count} {incr i} {
        set host_path [format "%s/chromium-video-%02d.ppm" $outdir $i]
        set host_filename [file tail $host_path]
        set present [chromium_video_sample_present $host_path]
        set bytes 0
        if {[file exists $host_path]} {
            set bytes [file size $host_path]
        }

        array set stats {
            im_status unavailable
            mean unavailable
            stddev unavailable
            extrema unavailable
            black_class unavailable
        }
        set ae_status "unavailable"
        set ae_delta "unavailable"
        set sha256 [chromium_video_file_sha256 $host_path]
        if {$present} {
            chromium_video_frame_im_stats $host_path stats
            lassign [chromium_video_frame_ae_delta $previous_present_path $host_path] ae_status ae_delta
            set previous_present_path $host_path
        } else {
            set ae_status "missing"
        }

        puts $fh "$i\t$host_filename\t$present\t$bytes\t$sha256\t$stats(im_status)\t$stats(mean)\t$stats(stddev)\t$stats(extrema)\t$stats(black_class)\t$ae_status\t$ae_delta"
    }
    close $fh
}

proc chromium_video_present_sample_count {} {
    global outdir chromium_video_sample_count

    set present_count 0
    for {set i 0} {$i < $chromium_video_sample_count} {incr i} {
        set host_path [format "%s/chromium-video-%02d.ppm" $outdir $i]
        if {[chromium_video_sample_present $host_path]} {
            incr present_count
        }
    }
    return $present_count
}

proc chromium_video_motion_min_ae_delta {} {
    return 10000.0
}

proc chromium_video_motion_summary {nonblack_var changed_var post_nonblack_changed_var first_nonblack_var} {
    global outdir chromium_video_sample_count
    upvar 1 $nonblack_var nonblack_count
    upvar 1 $changed_var changed_count
    upvar 1 $post_nonblack_changed_var post_nonblack_changed_count
    upvar 1 $first_nonblack_var first_nonblack_index

    set motion_min_ae_delta [chromium_video_motion_min_ae_delta]
    set nonblack_count 0
    set changed_count 0
    set post_nonblack_changed_count 0
    set first_nonblack_index -1
    set previous_present_path ""
    set previous_nonblack 0
    set have_convert [expr {[auto_execok convert] ne ""}]
    set have_compare [expr {[auto_execok compare] ne ""}]
    if {!$have_convert} {
        set nonblack_count "unavailable"
        set post_nonblack_changed_count "unavailable"
        set first_nonblack_index "unavailable"
    }
    if {!$have_compare} {
        set changed_count "unavailable"
        set post_nonblack_changed_count "unavailable"
    }

    for {set i 0} {$i < $chromium_video_sample_count} {incr i} {
        set host_path [format "%s/chromium-video-%02d.ppm" $outdir $i]
        if {![chromium_video_sample_present $host_path]} {
            set previous_nonblack 0
            continue
        }

        set current_nonblack 0
        if {$have_convert} {
            array set stats {
                im_status unavailable
                mean unavailable
                stddev unavailable
                extrema unavailable
                black_class unavailable
            }
            chromium_video_frame_im_stats $host_path stats
            if {$stats(black_class) eq "unavailable"} {
                set nonblack_count "unavailable"
                set post_nonblack_changed_count "unavailable"
                set first_nonblack_index "unavailable"
                set have_convert 0
            }
            if {$stats(black_class) eq "nonblack"} {
                set current_nonblack 1
                incr nonblack_count
                if {$first_nonblack_index eq "-1"} {
                    set first_nonblack_index $i
                }
            }
        }

        if {$have_compare && $previous_present_path ne ""} {
            lassign [chromium_video_frame_ae_delta $previous_present_path $host_path] ae_status ae_delta
            if {$ae_status ne "ok"} {
                set changed_count "unavailable"
                set post_nonblack_changed_count "unavailable"
                set have_compare 0
            } elseif {![catch {expr {double($ae_delta) >= $motion_min_ae_delta}} changed] && $changed} {
                incr changed_count
                if {$have_convert && $previous_nonblack && $current_nonblack} {
                    incr post_nonblack_changed_count
                }
            }
        }

        set previous_present_path $host_path
        set previous_nonblack $current_nonblack
    }
}

proc chromium_video_runlog_after_launch {} {
    global runlog

    if {![file exists $runlog]} {
        return ""
    }

    set text [read_text_file $runlog]
    set pos [string first "KCVBEGIN" $text]
    if {$pos < 0} {
        set pos [string first "KDE_CHROMIUM_VIDEO_LAUNCH_BEGIN" $text]
    }
    if {$pos < 0} {
        return $text
    }
    return [string range $text $pos end]
}

proc chromium_video_launch_started {} {
    global runlog

    if {![file exists $runlog]} {
        return 0
    }

    set text [read_text_file $runlog]
    return [expr {[string first "KCVBEGIN" $text] >= 0 ||
                  [string first "KDE_CHROMIUM_VIDEO_LAUNCH_BEGIN" $text] >= 0}]
}

proc xwayland_kde_wrapper_summary {} {
    global runlog

    if {![file exists $runlog]} {
        return "available=0"
    }

    set text [read_text_file $runlog]
    set seen_policy 0
    set seen_argv 0
    set egl_platform "missing"
    set gallium_driver "missing"
    set mesa_override "missing"
    set glamor "missing"
    set effective_glamor "missing"
    set loader_debug "missing"
    set enable_glx "missing"
    set final_argc "missing"
    set final_glamor "missing"
    set plus_extension_glx "missing"
    set minus_extension_glx "missing"

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {Xwayland KDE wrapper: EGL_PLATFORM=([^ ]+) GALLIUM_DRIVER=([^ ]+) MESA_LOADER_DRIVER_OVERRIDE=([^ ]+) glamor=([^ ]+) effective_glamor=([^ ]+) loader_debug=([^ ]+) enable_glx=([^ ]+)} $line -> found_egl found_gallium found_mesa found_glamor found_effective found_loader found_enable]} {
            set seen_policy 1
            set egl_platform $found_egl
            set gallium_driver $found_gallium
            set mesa_override $found_mesa
            set glamor $found_glamor
            set effective_glamor $found_effective
            set loader_debug $found_loader
            set enable_glx $found_enable
        }
        if {[regexp {Xwayland KDE wrapper: final argv argc=([0-9]+) glamor=([^ ]+) .* \+extension_GLX=([^ ]+) -extension_GLX=([^ ]+)} $line -> found_argc found_final_glamor found_plus found_minus]} {
            set seen_argv 1
            set final_argc $found_argc
            set final_glamor $found_final_glamor
            set plus_extension_glx $found_plus
            set minus_extension_glx $found_minus
        }
    }

    return "available=1 policy_seen=$seen_policy argv_seen=$seen_argv egl_platform=[evidence_quote $egl_platform] gallium_driver=[evidence_quote $gallium_driver] mesa_loader_driver_override=[evidence_quote $mesa_override] glamor=[evidence_quote $glamor] effective_glamor=[evidence_quote $effective_glamor] loader_debug=[evidence_quote $loader_debug] enable_glx=[evidence_quote $enable_glx] final_argc=$final_argc final_glamor=[evidence_quote $final_glamor] plus_extension_GLX=[evidence_quote $plus_extension_glx] minus_extension_GLX=[evidence_quote $minus_extension_glx]"
}

proc chromium_video_drm_execbuffer_time_summary {} {
    set text [chromium_video_runlog_after_launch]
    if {$text eq ""} {
        return "available=0"
    }

    set count 0
    set chrome_count 0
    set xwayland_count 0
    set total_us_sum 0
    set total_us_max 0
    set cmd_copy_us_sum 0
    set bo_resolve_us_sum 0
    set submit_us_sum 0
    set trace_log_us_sum 0
    set trace_log_us_max 0
    set first_line ""
    set last_line ""

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {![regexp {chrome-drm-detail: execbuffer-time .* proc=([^ ]+) .* total_us=([0-9]+) .* cmd_copy_us=([0-9]+) bo_resolve_us=([0-9]+) submit_us=([0-9]+) .* trace_log_us=([0-9]+)} $line -> proc_name total_us cmd_copy_us bo_resolve_us submit_us trace_log_us]} {
            continue
        }
        incr count
        if {$proc_name eq "chrome"} {
            incr chrome_count
        } elseif {$proc_name eq "Xwayland.real"} {
            incr xwayland_count
        }
        incr total_us_sum $total_us
        incr cmd_copy_us_sum $cmd_copy_us
        incr bo_resolve_us_sum $bo_resolve_us
        incr submit_us_sum $submit_us
        incr trace_log_us_sum $trace_log_us
        if {$total_us > $total_us_max} {
            set total_us_max $total_us
        }
        if {$trace_log_us > $trace_log_us_max} {
            set trace_log_us_max $trace_log_us
        }
        if {$first_line eq ""} {
            set first_line $line
        }
        set last_line $line
    }

    set total_us_avg "missing"
    set submit_us_avg "missing"
    set trace_log_us_avg "missing"
    if {$count > 0} {
        set total_us_avg [format "%.3f" [expr {$total_us_sum / double($count)}]]
        set submit_us_avg [format "%.3f" [expr {$submit_us_sum / double($count)}]]
        set trace_log_us_avg [format "%.3f" [expr {$trace_log_us_sum / double($count)}]]
    }

    return "available=1 count=$count chrome_count=$chrome_count xwayland_count=$xwayland_count total_us_sum=$total_us_sum total_us_avg=$total_us_avg total_us_max=$total_us_max cmd_copy_us_sum=$cmd_copy_us_sum bo_resolve_us_sum=$bo_resolve_us_sum submit_us_sum=$submit_us_sum submit_us_avg=$submit_us_avg trace_log_us_sum=$trace_log_us_sum trace_log_us_avg=$trace_log_us_avg trace_log_us_max=$trace_log_us_max first_line=[evidence_quote $first_line] last_line=[evidence_quote $last_line]"
}

proc chromium_video_runlog_crash_signature {match_var} {
    upvar 1 $match_var match

    set match ""
    set text [chromium_video_runlog_after_launch]
    foreach line [split $text "\n"] {
        set trimmed [string trim $line]
        if {$trimmed eq ""} {
            continue
        }
        if {[regexp -nocase {(^|[^[:alnum:]_])(chrome|chromium|wayland-chromium):[^\r\n]*(breakpoint trap|trace/breakpoint trap|segmentation fault|bus error|illegal instruction)} $trimmed] ||
            [regexp -nocase {(^|[^[:alnum:]_])(chrome|chromium|wayland-chromium)[^\r\n]*(SIGTRAP|SIGSEGV|SIGABRT|SIGBUS|SIGILL|signal[ =:]+(5|6|7|11))} $trimmed] ||
            [regexp -nocase {(^|[^[:alnum:]_])(chrome|chromium|wayland-chromium)[^\r\n]*(FATAL|CHECK failed|Received signal)} $trimmed] ||
            [regexp -nocase {coredump:[^\r\n]*(chrome|chromium|wayland-chromium)} $trimmed] ||
            [regexp -nocase {(^|[^[:alnum:]_])(chrome|chromium|wayland-chromium)[^\r\n]*(crashed|crash dump)} $trimmed]} {
            set match $trimmed
            return 1
        }
    }
    return 0
}

proc chromium_video_launcher_crash_signature {match_var} {
    global wayland_chromium_log
    upvar 1 $match_var match

    set match ""
    if {![file exists $wayland_chromium_log]} {
        return 0
    }
    set text [read_text_file $wayland_chromium_log]
    foreach raw_line [split $text "\n"] {
        set line [string trim $raw_line]
        if {$line eq ""} {
            continue
        }
        if {[regexp -nocase {Received signal|SEGV_MAPERR|SIG(SEGV|TRAP|ABRT|BUS|ILL)|trace/breakpoint trap|breakpoint trap|segmentation fault|illegal instruction|bus error|FATAL|CHECK failed|crashed|crash dump} $line]} {
            set match $line
            return 1
        }
    }
    return 0
}

proc chromium_video_launcher_loader_signature {match_var} {
    global wayland_chromium_log
    upvar 1 $match_var match

    set match ""
    if {![file exists $wayland_chromium_log]} {
        return 0
    }
    set text [read_text_file $wayland_chromium_log]
    foreach raw_line [split $text "\n"] {
        set line [string trim $raw_line]
        if {$line eq ""} {
            continue
        }
        if {[regexp -nocase {Inconsistency detected by ld\.so|elf_machine_rela_relative|ld\.so:.*Assertion} $line]} {
            set match $line
            return 1
        }
    }
    return 0
}

proc chromium_video_rela_preprobe_summary {} {
    global chromium_video_rela_preprobe chromium_video_rela_preprobe_log
    global chromium_video_rela_preprobe_status

    if {$chromium_video_rela_preprobe ne "1"} {
        return "enabled=0 status=SKIP reason=disabled"
    }
    if {![file exists $chromium_video_rela_preprobe_status]} {
        return "enabled=1 status=missing reason=status-missing"
    }

    set status_line [string trim [read_text_file $chromium_video_rela_preprobe_status]]
    set log_present [expr {[guest_artifact_real_file $chromium_video_rela_preprobe_log] ? 1 : 0}]
    set chain_result ""
    set result_line ""
    if {$log_present} {
        set text [read_text_file $chromium_video_rela_preprobe_log]
        foreach raw_line [split $text "\n"] {
            set line [string trim $raw_line]
            if {[string match "CHROME_RELA_PROBE_CHAIN_RESULT*" $line]} {
                set chain_result $line
            }
            if {[string match "kde_chromium_rela_preprobe result*" $line]} {
                set result_line $line
            }
        }
    }

    set pass [expr {[regexp {(^|[ \t])status=DONE([ \t]|$)} $status_line] &&
                    [regexp {(^|[ \t])result=PASS([ \t]|$)} $status_line]}]
    set result [expr {$pass ? "PASS" : "FAIL"}]
    return "enabled=1 status=$result status_line=[evidence_quote $status_line] log_present=$log_present chain_result=[evidence_quote $chain_result] result_line=[evidence_quote $result_line]"
}

proc chromium_video_int3_summary {} {
    set text [chromium_video_runlog_after_launch]
    if {$text eq ""} {
        return "available=0"
    }

    set trap_count 0
    set pid "missing"
    set rip "missing"
    set ip_addr "missing"
    set ip_file_off "missing"
    set ip_ino "missing"
    set ip_size "missing"
    set ip_name "missing"
    set ip_path "missing"
    set code_line ""
    array set stack_file_off {}

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {pid ([0-9]+) chrome: breakpoint trap rip=(0x[0-9a-fA-F]+)} $line -> line_pid line_rip]} {
            incr trap_count
            if {$pid eq "missing"} {
                set pid $line_pid
                set rip $line_rip
            }
        }
        if {$ip_file_off eq "missing" &&
            [regexp {int3-ip: addr=(0x[0-9a-fA-F]+).*file_off=(0x[0-9a-fA-F]+).*ino=([0-9]+) size=([-0-9]+).*name=([^ \t\r]+)} $line -> line_addr line_file_off line_ino line_size line_name]} {
            set ip_addr $line_addr
            set ip_file_off $line_file_off
            set ip_ino $line_ino
            set ip_size $line_size
            set ip_name $line_name
            if {[regexp {path=([^ \t\r]+)} $line -> line_path]} {
                set ip_path $line_path
            }
        }
        if {$code_line eq "" && [regexp {user-int3-code @} $line]} {
            set code_line [string trim $line]
        }
        if {[regexp {int3-stack\[([0-9]+)\]: addr=(0x[0-9a-fA-F]+).*file_off=(0x[0-9a-fA-F]+)} $line -> idx _addr file_off]} {
            set stack_file_off($idx) $file_off
        }
    }

    set stack3 "missing"
    set stack5 "missing"
    if {[info exists stack_file_off(3)]} {
        set stack3 $stack_file_off(3)
    }
    if {[info exists stack_file_off(5)]} {
        set stack5 $stack_file_off(5)
    }
    return "available=1 trap_count=$trap_count pid=$pid rip=$rip ip_addr=$ip_addr ip_file_off=$ip_file_off ip_ino=$ip_ino ip_size=$ip_size ip_name=$ip_name ip_path=$ip_path stack3_file_off=$stack3 stack5_file_off=$stack5 code_line=[evidence_quote $code_line]"
}

proc chromium_video_syscall_tail_summary {} {
    set text [chromium_video_runlog_after_launch]
    if {$text eq ""} {
        return "available=0"
    }

    set summary_line ""
    set families_line ""
    set tail_count 0
    set fd_count 0
    set last_tail_line ""
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[string first "chrome-syscall-tail-summary:" $line] >= 0} {
            set summary_line [string trim $line]
        } elseif {[string first "chrome-syscall-tail-families:" $line] >= 0} {
            set families_line [string trim $line]
        } elseif {[string first "chrome-syscall-tail:" $line] >= 0} {
            incr tail_count
            set last_tail_line [string trim $line]
        } elseif {[string first "chrome-syscall-tail-fd" $line] >= 0} {
            incr fd_count
        }
    }

    if {$summary_line eq "" && $families_line eq "" && $tail_count == 0} {
        return "available=0"
    }
    return "available=1 tail_count=$tail_count fd_count=$fd_count summary=[evidence_quote $summary_line] families=[evidence_quote $families_line] last=[evidence_quote $last_tail_line]"
}

proc chromium_video_int3_context_summary {} {
    global chromium_process_evidence_log

    set text [chromium_video_runlog_after_launch]
    if {$text eq ""} {
        return "available=0"
    }

    set trap_pid "missing"
    set trap_pos [string first "breakpoint trap" $text]
    set sampler_done_after_trap 0
    set final_sync_after_trap 0
    if {$trap_pos >= 0} {
        set sampler_done_after_trap [expr {[string first "status=DONE" $text $trap_pos] >= 0}]
        set final_sync_after_trap [expr {[string first "KCVSYNCDONE" $text $trap_pos] >= 0}]
    }
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {pid ([0-9]+) chrome: breakpoint trap rip=} $line -> pid]} {
            set trap_pid $pid
            break
        }
    }

    if {$trap_pid eq "missing" || ![file exists $chromium_process_evidence_log]} {
        return "available=1 trap_pid=$trap_pid trap_pos=$trap_pos sampler_done_after_trap=$sampler_done_after_trap final_sync_after_trap=$final_sync_after_trap process_evidence=0"
    }

    set evidence [read_text_file $chromium_process_evidence_log]
    set sample_max -1
    set trap_first_sample "missing"
    set trap_last_sample "missing"
    set trap_sample_count 0
    set trap_roles {}
    set trap_cmd ""
    set trap_simdutf "missing"
    set trap_egl_platform "missing"
    set trap_use_gl "missing"
    set trap_use_angle "missing"
    set gpu_role_seen 0

    foreach raw_line [split $evidence "\n"] {
        set line [string trimright $raw_line "\r"]
        set phase ""
        set sample_index -1
        if {[regexp {kde_chromium_process_evidence (process|env|fd) phase=([^ ]+)} $line -> _ phase]} {
            if {[regexp {^(sample|burst)-([0-9]+)$} $phase -> _kind sample_text]} {
                scan $sample_text "%d" sample_index
                if {$sample_index > $sample_max} {
                    set sample_max $sample_index
                }
            } elseif {$phase eq "after"} {
                set sample_index 0
                if {$sample_index > $sample_max} {
                    set sample_max $sample_index
                }
            }
        }

        if {[regexp {kde_chromium_process_evidence process phase=[^ ]+ pid=([0-9]+) ppid=[-0-9]+ comm="[^"]*" role="([^"]*)"} $line -> pid role]} {
            if {$role eq "gpu-process"} {
                set gpu_role_seen 1
            }
            if {$pid eq $trap_pid} {
                incr trap_sample_count
                if {[lsearch -exact $trap_roles $role] < 0} {
                    lappend trap_roles $role
                }
                if {$sample_index >= 0} {
                    if {$trap_first_sample eq "missing" || $sample_index < $trap_first_sample} {
                        set trap_first_sample $sample_index
                    }
                    if {$trap_last_sample eq "missing" || $sample_index > $trap_last_sample} {
                        set trap_last_sample $sample_index
                    }
                }
                if {[regexp { cmd="([^"]*)"} $line -> cmd]} {
                    set trap_cmd $cmd
                    if {[regexp {(^| )--use-gl=([^ ]+)} $cmd -> _ value]} {
                        set trap_use_gl $value
                    }
                    if {[regexp {(^| )--use-angle=([^ ]+)} $cmd -> _ value]} {
                        set trap_use_angle $value
                    }
                }
            }
        }
        if {[regexp {kde_chromium_process_evidence env phase=[^ ]+ pid=([0-9]+) role="[^"]*" entry="SIMDUTF_FORCE_IMPLEMENTATION=([^"]*)"} $line -> pid value] &&
            $pid eq $trap_pid} {
            set trap_simdutf $value
        }
        if {[regexp {kde_chromium_process_evidence env phase=[^ ]+ pid=([0-9]+) role="[^"]*" entry="EGL_PLATFORM=([^"]*)"} $line -> pid value] &&
            $pid eq $trap_pid} {
            set trap_egl_platform $value
        }
    }

    set sampled_at_tail [expr {$trap_last_sample ne "missing" && $sample_max >= 0 && $trap_last_sample == $sample_max}]
    if {[llength $trap_roles] == 0} {
        set trap_roles_text "missing"
    } else {
        set trap_roles_text [join [lsort -unique $trap_roles] ","]
    }

    return "available=1 trap_pid=$trap_pid trap_pos=$trap_pos sampler_done_after_trap=$sampler_done_after_trap final_sync_after_trap=$final_sync_after_trap process_evidence=1 trap_roles=$trap_roles_text trap_first_sample=$trap_first_sample trap_last_sample=$trap_last_sample sample_max=$sample_max trap_sample_count=$trap_sample_count trap_sampled_at_tail=$sampled_at_tail gpu_role_seen=$gpu_role_seen trap_simdutf=[evidence_quote $trap_simdutf] trap_egl_platform=[evidence_quote $trap_egl_platform] trap_use_gl=[evidence_quote $trap_use_gl] trap_use_angle=[evidence_quote $trap_use_angle] trap_cmd=[evidence_quote $trap_cmd]"
}

proc chromium_video_fault_summary {} {
    set text [chromium_video_runlog_after_launch]
    if {$text eq ""} {
        return "available=0"
    }

    set fault_count 0
    set first_tsc "missing"
    set pid "missing"
    set comm "missing"
    set cr2 "missing"
    set err "missing"
    set rip "missing"
    set signal "missing"
    set handler "missing"
    set sigacts "missing"
    set regs_line ""
    set stack_line ""
    set user_mem_line ""
    set rax "missing"
    set rbx "missing"
    set rcx "missing"
    set rdx "missing"
    set rdi "missing"
    set rsi "missing"
    set rbp "missing"
    set rsp "missing"
    set stack0 "missing"
    set stack1 "missing"
    set mem_addr "missing"
    set mem0 "missing"
    set ip_addr "missing"
    set ip_file_off "missing"
    set ip_name "missing"
    set ip_path "missing"
    set ret_addr "missing"
    set ret_file_off "missing"
    set ret_name "missing"
    set ret_path "missing"
    set kde_exception_summary_seen 0
    set lowptr_base "missing"
    set lowptr_cr2 "missing"
    set lowptr_slot_count 0
    set lowptr_null_qword_count 0
    set seen_fault_keys {}
    array set lowptr_slot_addr {
        80 missing
        88 missing
        90 missing
        98 missing
    }
    array set lowptr_slot_qword {
        80 missing
        88 missing
        90 missing
        98 missing
    }

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {\[([0-9]+)\].*kde-exception-fatal-summary: pid=([0-9]+) name=([^ ]+) cr2=(0x[0-9a-fA-F]+) err=(0x[0-9a-fA-F]+) rip=(0x[0-9a-fA-F]+) rsp=(0x[0-9a-fA-F]+) rbp=(0x[0-9a-fA-F]+)} $line -> tsc line_pid line_comm line_cr2 line_err line_rip line_rsp line_rbp]} {
            set kde_exception_summary_seen 1
            set fault_key "$line_pid:$line_cr2:$line_rip"
            if {[lsearch -exact $seen_fault_keys $fault_key] < 0} {
                lappend seen_fault_keys $fault_key
                incr fault_count
            }
            if {$pid eq "missing"} {
                set first_tsc $tsc
                set pid $line_pid
                set comm $line_comm
                set cr2 $line_cr2
                set err $line_err
                set rip $line_rip
                set rsp $line_rsp
                set rbp $line_rbp
            }
            continue
        }
        if {[regexp {\[([0-9]+)\] pid ([0-9]+) ([^:]+): fatal page fault cr2=(0x[0-9a-fA-F]+) err=(0x[0-9a-fA-F]+) rip=(0x[0-9a-fA-F]+) \(([^)]*)\)} $line -> tsc line_pid line_comm line_cr2 line_err line_rip detail]} {
            set fault_key "$line_pid:$line_cr2:$line_rip"
            if {[lsearch -exact $seen_fault_keys $fault_key] < 0} {
                lappend seen_fault_keys $fault_key
                incr fault_count
            }
            if {$pid eq "missing"} {
                set first_tsc $tsc
                set pid $line_pid
                set comm $line_comm
                set cr2 $line_cr2
                set err $line_err
                set rip $line_rip
                if {[regexp {(SIG[A-Z0-9]+)} $detail -> value]} {
                    set signal $value
                }
                if {[regexp {handler=(0x[0-9a-fA-F]+)} $detail -> value]} {
                    set handler $value
                }
                if {[regexp {sigacts=(0x[0-9a-fA-F]+)} $detail -> value]} {
                    set sigacts $value
                }
            }
            continue
        }
        if {[regexp {\[([0-9]+)\] pid ([0-9]+) ([^:]+): fatal page fault} $line -> tsc line_pid line_comm]} {
            set pid_seen 0
            foreach fault_key $seen_fault_keys {
                if {[string match "$line_pid:*" $fault_key]} {
                    set pid_seen 1
                    break
                }
            }
            if {$pid_seen} {
                continue
            }
            set fault_key "$line_pid:unknown:unknown"
            if {[lsearch -exact $seen_fault_keys $fault_key] < 0} {
                lappend seen_fault_keys $fault_key
                incr fault_count
            }
            if {$pid eq "missing"} {
                set first_tsc $tsc
                set pid $line_pid
                set comm $line_comm
            }
            continue
        }
        if {$fault_count > 0 &&
            [regexp {fatal-lowptr-object-slots: base=rdi=(0x[0-9a-fA-F]+) cr2=(0x[0-9a-fA-F]+)} $line -> value_base value_cr2]} {
            set lowptr_base $value_base
            set lowptr_cr2 $value_cr2
            continue
        }
        if {$fault_count > 0 &&
            [regexp {fatal-rdi\+0x([0-9a-fA-F]+): addr=(0x[0-9a-fA-F]+) qword=(0x[0-9a-fA-F]+)} $line -> slot addr qword]} {
            set slot [string tolower $slot]
            if {[info exists lowptr_slot_qword($slot)] &&
                $lowptr_slot_qword($slot) eq "missing"} {
                incr lowptr_slot_count
                if {$qword eq "0x0"} {
                    incr lowptr_null_qword_count
                }
            }
            set lowptr_slot_addr($slot) $addr
            set lowptr_slot_qword($slot) $qword
            continue
        }
        if {$fault_count > 0 && $ip_file_off eq "missing" &&
            [regexp {exception-ip: addr=(0x[0-9a-fA-F]+).*file_off=(0x[0-9a-fA-F]+).*name=([^ \t\r]+)} $line -> line_addr line_file_off line_name]} {
            set ip_addr $line_addr
            set ip_file_off $line_file_off
            set ip_name $line_name
            if {[regexp {path=([^ \t\r]+)} $line -> line_path]} {
                set ip_path $line_path
            }
            continue
        }
        if {$fault_count > 0 && $ret_file_off eq "missing" &&
            [regexp {fatal-ret: addr=(0x[0-9a-fA-F]+).*file_off=(0x[0-9a-fA-F]+).*name=([^ \t\r]+)} $line -> line_addr line_file_off line_name]} {
            set ret_addr $line_addr
            set ret_file_off $line_file_off
            set ret_name $line_name
            if {[regexp {path=([^ \t\r]+)} $line -> line_path]} {
                set ret_path $line_path
            }
            continue
        }
        if {$fault_count > 0 && $regs_line eq "" &&
            [regexp {regs: rax=(0x[0-9a-fA-F]+) rbx=(0x[0-9a-fA-F]+) rcx=(0x[0-9a-fA-F]+) rdx=(0x[0-9a-fA-F]+)} $line -> rax_value rbx_value rcx_value rdx_value]} {
            set regs_line [string trim $line]
            set rax $rax_value
            set rbx $rbx_value
            set rcx $rcx_value
            set rdx $rdx_value
            continue
        }
        if {$fault_count > 0 &&
            [regexp {rdi=(0x[0-9a-fA-F]+) rsi=(0x[0-9a-fA-F]+) rbp=(0x[0-9a-fA-F]+) rsp=(0x[0-9a-fA-F]+)} $line -> rdi_value rsi_value rbp_value rsp_value]} {
            set rdi $rdi_value
            set rsi $rsi_value
            set rbp $rbp_value
            set rsp $rsp_value
            continue
        }
        if {$fault_count > 0 && $stack_line eq "" &&
            [regexp {user stack @rsp: ([^ \t\r]+) ([^ \t\r]+)} $line -> stack0_value stack1_value]} {
            set stack_line [string trim $line]
            set stack0 $stack0_value
            set stack1 $stack1_value
            continue
        }
        if {$fault_count > 0 && $user_mem_line eq "" &&
            [regexp {user mem [^ ]+ @(0x[0-9a-fA-F]+): ([^ \t\r]+)} $line -> mem_addr_value mem0_value]} {
            set user_mem_line [string trim $line]
            set mem_addr $mem_addr_value
            set mem0 $mem0_value
            continue
        }
    }

    return "available=1 fault_count=$fault_count first_tsc=$first_tsc pid=$pid comm=$comm cr2=$cr2 err=$err rip=$rip signal=$signal handler=$handler sigacts=$sigacts kde_exception_summary_seen=$kde_exception_summary_seen ip_addr=$ip_addr ip_file_off=$ip_file_off ip_name=$ip_name ip_path=$ip_path ret_addr=$ret_addr ret_file_off=$ret_file_off ret_name=$ret_name ret_path=$ret_path rax=$rax rbx=$rbx rcx=$rcx rdx=$rdx rdi=$rdi rsi=$rsi rbp=$rbp rsp=$rsp stack0=$stack0 stack1=$stack1 mem_addr=$mem_addr mem0=$mem0 lowptr_base=$lowptr_base lowptr_cr2=$lowptr_cr2 lowptr_slot_count=$lowptr_slot_count lowptr_null_qword_count=$lowptr_null_qword_count lowptr_rdi80_addr=$lowptr_slot_addr(80) lowptr_rdi80_qword=$lowptr_slot_qword(80) lowptr_rdi88_addr=$lowptr_slot_addr(88) lowptr_rdi88_qword=$lowptr_slot_qword(88) lowptr_rdi88_is_null=[expr {$lowptr_slot_qword(88) eq "0x0" ? 1 : 0}] lowptr_rdi90_addr=$lowptr_slot_addr(90) lowptr_rdi90_qword=$lowptr_slot_qword(90) lowptr_rdi98_addr=$lowptr_slot_addr(98) lowptr_rdi98_qword=$lowptr_slot_qword(98) regs_line=[evidence_quote $regs_line] stack_line=[evidence_quote $stack_line] user_mem_line=[evidence_quote $user_mem_line]"
}

proc chromium_video_fault_context_summary {} {
    global chromium_process_evidence_log

    set text [chromium_video_runlog_after_launch]
    if {$text eq ""} {
        return "available=0"
    }

    set fault_pid "missing"
    set fault_pos -1
    foreach marker {"fatal page fault" "kde-exception-fatal-summary"} {
        set marker_pos [string first $marker $text]
        if {$marker_pos >= 0 && ($fault_pos < 0 || $marker_pos < $fault_pos)} {
            set fault_pos $marker_pos
        }
    }
    set sampler_wait_markers_before_fault 0
    set sampler_done_after_fault 0
    set final_sync_after_fault 0
    if {$fault_pos >= 0} {
        set sampler_wait_markers_before_fault [regexp -all {KCVSWAIT} [string range $text 0 $fault_pos]]
        set sampler_done_after_fault [expr {[string first "status=DONE" $text $fault_pos] >= 0}]
        set final_sync_after_fault [expr {[string first "KCVSYNCDONE" $text $fault_pos] >= 0}]
    }
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {kde-exception-fatal-summary: pid=([0-9]+)} $line -> pid] ||
            [regexp {pid ([0-9]+) [^:]+: fatal page fault cr2=} $line -> pid] ||
            [regexp {pid ([0-9]+) [^:]+: fatal page fault} $line -> pid]} {
            set fault_pid $pid
            break
        }
    }

    if {$fault_pid eq "missing" || ![file exists $chromium_process_evidence_log]} {
        return "available=1 fault_pid=$fault_pid fault_pos=$fault_pos sampler_wait_markers_before_fault=$sampler_wait_markers_before_fault sampler_done_after_fault=$sampler_done_after_fault final_sync_after_fault=$final_sync_after_fault process_evidence=0"
    }
    if {![guest_artifact_real_file $chromium_process_evidence_log]} {
        return "available=1 fault_pid=$fault_pid fault_pos=$fault_pos sampler_wait_markers_before_fault=$sampler_wait_markers_before_fault sampler_done_after_fault=$sampler_done_after_fault final_sync_after_fault=$final_sync_after_fault process_evidence=0 process_evidence_missing_guest_path=1"
    }

    set evidence [read_text_file $chromium_process_evidence_log]
    set sample_max -1
    set fault_first_sample "missing"
    set fault_last_sample "missing"
    set fault_sample_count 0
    set fault_roles {}
    set fault_ppids {}
    set fault_reparented 0
    set fault_reparent_first_sample "missing"
    set fault_cmd ""
    set fault_simdutf "missing"
    set fault_egl_platform "missing"
    set fault_use_gl "missing"
    set fault_use_angle "missing"
    set gpu_role_seen 0
    set renderer_role_seen 0
    set zygote_role_seen 0
    set fault_drm_fd_seen 0
    set fault_render_fd_seen 0
    set any_drm_fd_seen 0
    set any_render_fd_seen 0
    set last_map_line ""

    foreach raw_line [split $evidence "\n"] {
        set line [string trimright $raw_line "\r"]
        set phase ""
        set sample_index -1
        if {[regexp {kde_chromium_process_evidence (process|env|fd|maps) phase=([^ ]+)} $line -> _ phase]} {
            if {[regexp {^(sample|burst)-([0-9]+)$} $phase -> _kind sample_text]} {
                scan $sample_text "%d" sample_index
                if {$sample_index > $sample_max} {
                    set sample_max $sample_index
                }
            } elseif {$phase eq "after"} {
                set sample_index 0
                if {$sample_index > $sample_max} {
                    set sample_max $sample_index
                }
            }
        }

        if {[regexp {kde_chromium_process_evidence process phase=[^ ]+ pid=([0-9]+) ppid=([-0-9]+) comm="[^"]*" role="([^"]*)"} $line -> pid ppid role]} {
            if {$role eq "gpu-process"} {
                set gpu_role_seen 1
            } elseif {$role eq "renderer"} {
                set renderer_role_seen 1
            } elseif {$role eq "zygote"} {
                set zygote_role_seen 1
            }
            if {$pid eq $fault_pid} {
                incr fault_sample_count
                if {[lsearch -exact $fault_roles $role] < 0} {
                    lappend fault_roles $role
                }
                if {[lsearch -exact $fault_ppids $ppid] < 0} {
                    lappend fault_ppids $ppid
                }
                if {$sample_index >= 0} {
                    if {$fault_first_sample eq "missing" || $sample_index < $fault_first_sample} {
                        set fault_first_sample $sample_index
                    }
                    if {$fault_last_sample eq "missing" || $sample_index > $fault_last_sample} {
                        set fault_last_sample $sample_index
                    }
                }
                if {$ppid eq "1"} {
                    set fault_reparented 1
                    if {$sample_index >= 0 &&
                        ($fault_reparent_first_sample eq "missing" ||
                         $sample_index < $fault_reparent_first_sample)} {
                        set fault_reparent_first_sample $sample_index
                    }
                }
                if {[regexp { cmd="([^"]*)"} $line -> cmd]} {
                    set fault_cmd $cmd
                    if {[regexp {(^| )--use-gl=([^ ]+)} $cmd -> _ value]} {
                        set fault_use_gl $value
                    }
                    if {[regexp {(^| )--use-angle=([^ ]+)} $cmd -> _ value]} {
                        set fault_use_angle $value
                    }
                }
            }
        }
        if {[regexp {kde_chromium_process_evidence env phase=[^ ]+ pid=([0-9]+) role="[^"]*" entry="SIMDUTF_FORCE_IMPLEMENTATION=([^"]*)"} $line -> pid value] &&
            $pid eq $fault_pid} {
            set fault_simdutf $value
        }
        if {[regexp {kde_chromium_process_evidence env phase=[^ ]+ pid=([0-9]+) role="[^"]*" entry="EGL_PLATFORM=([^"]*)"} $line -> pid value] &&
            $pid eq $fault_pid} {
            set fault_egl_platform $value
        }
        if {[regexp {kde_chromium_process_evidence fd phase=[^ ]+ pid=([0-9]+) role="[^"]*" fd="[^"]*" target="([^"]*)"} $line -> pid target]} {
            if {[string match */dev/dri/* $target] || [string match *renderD* $target] || [string match *drm* $target]} {
                set any_drm_fd_seen 1
                if {$pid eq $fault_pid} {
                    set fault_drm_fd_seen 1
                }
            }
            if {[string match *renderD* $target]} {
                set any_render_fd_seen 1
                if {$pid eq $fault_pid} {
                    set fault_render_fd_seen 1
                }
            }
        }
        if {[regexp {kde_chromium_process_evidence maps phase=[^ ]+ pid=([0-9]+) role="[^"]*" line="([^"]*)"} $line -> pid map_line] &&
            $pid eq $fault_pid} {
            set last_map_line $map_line
        }
    }

    set fault_sampled_at_tail [expr {$fault_last_sample ne "missing" && $sample_max >= 0 && $fault_last_sample == $sample_max}]
    if {[llength $fault_roles] == 0} {
        set fault_roles_text "missing"
    } else {
        set fault_roles_text [join [lsort -unique $fault_roles] ","]
    }
    if {[llength $fault_ppids] == 0} {
        set fault_ppids_text "missing"
    } else {
        set fault_ppids_text [join $fault_ppids ","]
    }

    return "available=1 fault_pid=$fault_pid fault_pos=$fault_pos sampler_wait_markers_before_fault=$sampler_wait_markers_before_fault sampler_done_after_fault=$sampler_done_after_fault final_sync_after_fault=$final_sync_after_fault process_evidence=1 fault_roles=$fault_roles_text fault_ppids=$fault_ppids_text fault_reparented=$fault_reparented fault_reparent_first_sample=$fault_reparent_first_sample fault_first_sample=$fault_first_sample fault_last_sample=$fault_last_sample sample_max=$sample_max fault_sample_count=$fault_sample_count fault_sampled_at_tail=$fault_sampled_at_tail gpu_role_seen=$gpu_role_seen renderer_role_seen=$renderer_role_seen zygote_role_seen=$zygote_role_seen fault_drm_fd_seen=$fault_drm_fd_seen fault_render_fd_seen=$fault_render_fd_seen any_drm_fd_seen=$any_drm_fd_seen any_render_fd_seen=$any_render_fd_seen fault_simdutf=[evidence_quote $fault_simdutf] fault_egl_platform=[evidence_quote $fault_egl_platform] fault_use_gl=[evidence_quote $fault_use_gl] fault_use_angle=[evidence_quote $fault_use_angle] last_map_line=[evidence_quote $last_map_line] fault_cmd=[evidence_quote $fault_cmd]"
}

proc kwin_alloc_trace_summary {} {
    global kwin_alloc_trace_log

    if {![file exists $kwin_alloc_trace_log]} {
        return "available=0"
    }

    set text [read_text_file $kwin_alloc_trace_log]
    set begin_count 0
    set summary_count 0
    set effects_calls "missing"
    set effects_real_missing "missing"
    set alloc_failures "missing"
    set mmap_failures "missing"
    set brk_failures "missing"
    set pcre2_slot_samples "missing"
    set pcre2_slot_changes "missing"
    set pcre2_slot_poison_samples "missing"
    set pthread_prio_protect_invalid_ceiling "missing"
    set pthread_prio_protect_bad_lock_return "missing"
    set last_summary ""
    set last_effects_summary ""

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {kwin-alloc-trace: phase=begin } $line]} {
            incr begin_count
        }
        if {[regexp {kwin-alloc-trace: phase=summary status=DONE} $line]} {
            incr summary_count
            set last_summary $line
        }
        if {[regexp {kwin-alloc-trace: phase=effects_check_input_window_stacking_summary} $line]} {
            set last_effects_summary $line
        }
        if {[regexp {effects_check_input_window_stacking_summary calls=([0-9]+)} $line -> value]} {
            set effects_calls $value
        }
        if {[regexp {real_missing_total=([0-9]+)} $line -> value]} {
            set effects_real_missing $value
        }
        foreach field {
            alloc_failures mmap_failures brk_failures pcre2_slot_samples
            pcre2_slot_changes pcre2_slot_poison_samples
            pthread_prio_protect_invalid_ceiling
            pthread_prio_protect_bad_lock_return
        } {
            set field_re [format {%s=([0-9]+)} $field]
            if {[regexp $field_re $line -> value]} {
                set $field $value
            }
        }
    }

    return "available=1 begin_count=$begin_count summary_count=$summary_count effects_calls=$effects_calls effects_real_missing=$effects_real_missing alloc_failures=$alloc_failures mmap_failures=$mmap_failures brk_failures=$brk_failures pcre2_slot_samples=$pcre2_slot_samples pcre2_slot_changes=$pcre2_slot_changes pcre2_slot_poison_samples=$pcre2_slot_poison_samples pthread_prio_protect_invalid_ceiling=$pthread_prio_protect_invalid_ceiling pthread_prio_protect_bad_lock_return=$pthread_prio_protect_bad_lock_return last_summary=[evidence_quote $last_summary] last_effects_summary=[evidence_quote $last_effects_summary]"
}

proc chromium_video_launcher_wayland_failure {match_var} {
    global wayland_chromium_log
    upvar 1 $match_var match

    set match ""
    if {![file exists $wayland_chromium_log]} {
        return 0
    }

    set text [read_text_file $wayland_chromium_log]
    foreach line [split $text "\n"] {
        set trimmed [string trim $line]
        if {$trimmed eq ""} {
            continue
        }
        if {[regexp -nocase {Failed to connect to Wayland display|Failed to initialize Wayland platform|The platform failed to initialize} $trimmed]} {
            set match $trimmed
            return 1
        }
    }
    return 0
}

proc chromium_video_launch_evidence_status {status_var} {
    global chromium_process_evidence_log
    upvar 1 $status_var status

    set status "missing"
    if {![file exists $chromium_process_evidence_log]} {
        return 0
    }

    set text [read_text_file $chromium_process_evidence_log]
    foreach line [split $text "\n"] {
        if {[regexp {kde_chromium_process_evidence end status=(PASS|FAIL)} $line -> found_status]} {
            set status $found_status
        }
    }
    return [expr {$status ne "missing"}]
}

proc chromium_video_perf_log_result {kind_var line_var metrics_var} {
    global wayland_chromium_log
    upvar 1 $kind_var kind
    upvar 1 $line_var result_line
    upvar 1 $metrics_var metrics_line

    set kind "missing"
    set result_line ""
    set metrics_line ""
    if {![file exists $wayland_chromium_log]} {
        return
    }
    set text [read_text_file $wayland_chromium_log]
    foreach line [split $text "\n"] {
        if {[regexp {PERF-VIDEO metrics ([^"]+)} $line -> metrics]} {
            set metrics_line $metrics
        }
        if {[regexp {PERF-VIDEO RESULT ([a-z]+) ([^"]+)} $line -> result rest]} {
            set kind $result
            set result_line "$result $rest"
        }
    }
}

proc chromium_video_perf_result_failure_reason {result_line} {
    set label "fail"

    if {[regexp {^fail[ \t]+([^ \t\r\n]+)} $result_line -> found]} {
        set label $found
    }
    regsub -all {[^A-Za-z0-9_.-]+} $label {-} label
    if {$label eq ""} {
        set label "fail"
    }
    return "perf-result-$label"
}

proc chromium_video_perf_log_summary {start_var startup_var play_var playing_var tick_var result_var} {
    global wayland_chromium_log
    upvar 1 $start_var start_line
    upvar 1 $startup_var startup_line
    upvar 1 $play_var play_line
    upvar 1 $playing_var playing_line
    upvar 1 $tick_var tick_line
    upvar 1 $result_var result_line

    set start_line ""
    set startup_line ""
    set play_line ""
    set playing_line ""
    set tick_line ""
    set result_line ""
    if {![file exists $wayland_chromium_log]} {
        return
    }
    set text [read_text_file $wayland_chromium_log]
    foreach line [split $text "\n"] {
        if {[regexp {PERF-VIDEO start } $line]} {
            set start_line [string trim $line]
        }
        if {[regexp {PERF-VIDEO startup } $line]} {
            set startup_line [string trim $line]
        }
        if {[regexp {PERF-VIDEO play-(resolved|rejected) } $line]} {
            set play_line [string trim $line]
        }
        if {[regexp {PERF-VIDEO event:playing} $line]} {
            set playing_line [string trim $line]
        }
        if {[regexp {PERF-VIDEO tick } $line]} {
            set tick_line [string trim $line]
        }
        if {[regexp {PERF-VIDEO RESULT } $line]} {
            set result_line [string trim $line]
        }
    }
}

proc chromium_video_perf_media_summary {} {
    global wayland_chromium_log

    if {![file exists $wayland_chromium_log]} {
        return "available=0"
    }

    set text [read_text_file $wayland_chromium_log]
    set perf_count 0
    set playing_count 0
    set tick_count 0
    set result_count 0
    set result_fail_count 0
    set result_pass_count 0
    set postfail_tick_count 0
    set postfail_observe_count 0
    set rvfc_summary_count 0
    set last_rvfc_count "missing"
    set last_rvfc_span_ms "missing"
    set last_rvfc_avg_gap_ms "missing"
    set last_rvfc_max_gap_ms "missing"
    set last_rvfc_last_media "missing"
    set last_rvfc_media_span "missing"
    set last_rvfc_meta_presented "missing"
    set last_time "missing"
    set last_duration "missing"
    set last_ready "missing"
    set last_presented "missing"
    set last_decoded "missing"
    set last_dropped "missing"
    set last_err "missing"
    set last_current_src "missing"

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {![regexp {PERF-VIDEO } $line]} {
            continue
        }
        incr perf_count
        if {[regexp {PERF-VIDEO event:playing} $line]} {
            incr playing_count
        }
        if {[regexp {PERF-VIDEO tick } $line]} {
            incr tick_count
        }
        if {[regexp {PERF-VIDEO postfail-tick } $line]} {
            incr postfail_tick_count
        }
        if {[regexp {PERF-VIDEO postfail-observe } $line]} {
            incr postfail_observe_count
        }
        if {[regexp {PERF-VIDEO rvfc-summary} $line]} {
            incr rvfc_summary_count
            foreach {name var_name} {
                count last_rvfc_count
                spanMs last_rvfc_span_ms
                avgGapMs last_rvfc_avg_gap_ms
                maxGapMs last_rvfc_max_gap_ms
                lastMedia last_rvfc_last_media
                mediaSpan last_rvfc_media_span
                lastMetaPresentedFrames last_rvfc_meta_presented
            } {
                set field_pattern [format {%s=([^ \t\r\n"]+)} $name]
                if {[regexp $field_pattern $line -> value]} {
                    set $var_name $value
                }
            }
        }
        foreach {name var_name} {
            rvfcCount last_rvfc_count
            rvfcSpanMs last_rvfc_span_ms
            rvfcAvgGapMs last_rvfc_avg_gap_ms
            rvfcMaxGapMs last_rvfc_max_gap_ms
            rvfcLastMedia last_rvfc_last_media
            rvfcMediaSpan last_rvfc_media_span
            rvfcMetaPresentedFrames last_rvfc_meta_presented
        } {
            set field_pattern [format {%s=([^ \t\r\n"]+)} $name]
            if {[regexp $field_pattern $line -> value]} {
                set $var_name $value
            }
        }
        if {[regexp {PERF-VIDEO RESULT ([a-z]+)} $line -> result_kind]} {
            incr result_count
            if {$result_kind eq "fail"} {
                incr result_fail_count
            } elseif {$result_kind eq "pass"} {
                incr result_pass_count
            }
        }
        foreach {name var_name} {
            time last_time
            duration last_duration
            ready last_ready
            presented last_presented
            decoded last_decoded
            dropped last_dropped
            err last_err
        } {
            set field_pattern [format {%s=([^ \t\r\n"]+)} $name]
            if {[regexp $field_pattern $line -> value]} {
                set $var_name $value
            }
        }
        if {[regexp {currentSrc=([^ \t\r\n"]+)} $line -> value]} {
            set last_current_src $value
        }
    }

    return "available=1 perf_count=$perf_count playing_count=$playing_count tick_count=$tick_count postfail_tick_count=$postfail_tick_count postfail_observe_count=$postfail_observe_count rvfc_summary_count=$rvfc_summary_count last_rvfc_count=$last_rvfc_count last_rvfc_span_ms=$last_rvfc_span_ms last_rvfc_avg_gap_ms=$last_rvfc_avg_gap_ms last_rvfc_max_gap_ms=$last_rvfc_max_gap_ms last_rvfc_last_media=$last_rvfc_last_media last_rvfc_media_span=$last_rvfc_media_span last_rvfc_meta_presented=$last_rvfc_meta_presented result_count=$result_count result_fail_count=$result_fail_count result_pass_count=$result_pass_count last_time=$last_time last_duration=$last_duration last_ready=$last_ready last_presented=$last_presented last_decoded=$last_decoded last_dropped=$last_dropped last_err=$last_err last_currentSrc=[evidence_quote $last_current_src]"
}

proc chromium_video_capture_log_summary {} {
    global chromium_video_capture_log

    if {![file exists $chromium_video_capture_log]} {
        return "available=0"
    }

    set text [read_text_file $chromium_video_capture_log]
    set begin_count 0
    set end_count 0
    set fb_ppm_count 0
    set sample_current_before_count 0
    set sample_current_after_count 0
    set fb_sample_current_count 0
    set uptime_before_count 0
    set uptime_after_count 0
    set done_count 0
    set first_fb_line ""
    set last_fb_line ""
    set wc_count 0
    set wc_min_bytes "missing"
    set wc_max_bytes "missing"

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {kde_chromium_video_capture frame=[0-9]+ begin} $line]} {
            incr begin_count
        }
        if {[regexp {kde_chromium_video_capture frame=[0-9]+ end} $line]} {
            incr end_count
        }
        if {[regexp {kde_chromium_video_capture frame=[0-9]+ uptime_before} $line]} {
            incr uptime_before_count
        }
        if {[regexp {kde_chromium_video_capture frame=[0-9]+ uptime_after} $line]} {
            incr uptime_after_count
        }
        if {[regexp {kde_chromium_video_capture frame=[0-9]+ sample_current_before} $line]} {
            incr sample_current_before_count
        }
        if {[regexp {kde_chromium_video_capture frame=[0-9]+ sample_current_after} $line]} {
            incr sample_current_after_count
        }
        if {[regexp {kde_chromium_video_capture done} $line]} {
            incr done_count
        }
        if {[regexp {^fb_sample_current } $line]} {
            incr fb_sample_current_count
        }
        if {[regexp {^fb_ppm_current } $line]} {
            incr fb_ppm_count
            if {$first_fb_line eq ""} {
                set first_fb_line $line
            }
            set last_fb_line $line
        }
        if {[regexp {^[ \t]*[0-9]+[ \t]+[0-9]+[ \t]+([0-9]+)[ \t]+/chromium-video-[0-9]+\.ppm} $line -> bytes]} {
            incr wc_count
            if {$wc_min_bytes eq "missing" || $bytes < $wc_min_bytes} {
                set wc_min_bytes $bytes
            }
            if {$wc_max_bytes eq "missing" || $bytes > $wc_max_bytes} {
                set wc_max_bytes $bytes
            }
        }
    }

    return "available=1 begin_count=$begin_count end_count=$end_count uptime_before_count=$uptime_before_count uptime_after_count=$uptime_after_count sample_current_before_count=$sample_current_before_count sample_current_after_count=$sample_current_after_count fb_sample_current_count=$fb_sample_current_count fb_ppm_count=$fb_ppm_count wc_count=$wc_count wc_min_bytes=$wc_min_bytes wc_max_bytes=$wc_max_bytes done_count=$done_count first_fb_line=[evidence_quote $first_fb_line] last_fb_line=[evidence_quote $last_fb_line]"
}

proc chromium_video_capture_timing_summary {} {
    global chromium_video_capture_log

    if {![file exists $chromium_video_capture_log]} {
        return "available=0"
    }

    set text [read_text_file $chromium_video_capture_log]
    array set before {}
    array set after {}
    set pending_kind ""
    set pending_frame -1
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {kde_chromium_video_capture frame=([0-9]+) uptime_before} $line -> frame]} {
            set pending_kind "before"
            scan $frame "%d" pending_frame
            continue
        }
        if {[regexp {kde_chromium_video_capture frame=([0-9]+) uptime_after} $line -> frame]} {
            set pending_kind "after"
            scan $frame "%d" pending_frame
            continue
        }
        if {$pending_kind ne "" &&
            [regexp {^[ \t]*([0-9]+(?:\.[0-9]+)?)[ \t]+[0-9]+(?:\.[0-9]+)?[ \t]*$} $line -> uptime]} {
            if {$pending_kind eq "before"} {
                set before($pending_frame) $uptime
            } else {
                set after($pending_frame) $uptime
            }
            set pending_kind ""
            set pending_frame -1
        }
    }

    set count 0
    set total_ms 0.0
    set min_ms "missing"
    set max_ms "missing"
    set first_before "missing"
    set last_after "missing"
    foreach frame [lsort -integer [array names before]] {
        if {![info exists after($frame)]} {
            continue
        }
        set duration_ms [expr {($after($frame) - $before($frame)) * 1000.0}]
        incr count
        set total_ms [expr {$total_ms + $duration_ms}]
        if {$min_ms eq "missing" || $duration_ms < $min_ms} {
            set min_ms $duration_ms
        }
        if {$max_ms eq "missing" || $duration_ms > $max_ms} {
            set max_ms $duration_ms
        }
        if {$first_before eq "missing" || $before($frame) < $first_before} {
            set first_before $before($frame)
        }
        if {$last_after eq "missing" || $after($frame) > $last_after} {
            set last_after $after($frame)
        }
    }

    set avg_ms "missing"
    set span_ms "missing"
    if {$count > 0} {
        set avg_ms [format "%.3f" [expr {$total_ms / $count}]]
        set total_ms [format "%.3f" $total_ms]
        set min_ms [format "%.3f" $min_ms]
        set max_ms [format "%.3f" $max_ms]
        set span_ms [format "%.3f" [expr {($last_after - $first_before) * 1000.0}]]
    }

    return "available=1 paired_count=$count total_ms=$total_ms avg_ms=$avg_ms min_ms=$min_ms max_ms=$max_ms first_before=$first_before last_after=$last_after span_ms=$span_ms"
}

proc chromium_video_scanout_read_summary {} {
    set text [chromium_video_runlog_after_launch]
    if {$text eq ""} {
        return "available=0"
    }

    set kms_count 0
    set virtio_sample_count 0
    set virtio_end_count 0
    set first_tsc "missing"
    set last_tsc "missing"
    set last_rect "missing"
    set transfer_count 0
    set transfer_fail_count 0
    set sample_nonblack_count 0
    set sample_changed_count 0
    set present_sample_count 0
    set present_sample_nonblack_count 0
    set present_sample_changed_count 0
    set present_sample_transfer_fail_count 0
    set first_sample_hash "missing"
    set last_sample_hash "missing"
    set first_present_sample_hash "missing"
    set last_present_sample_hash "missing"
    set previous_sample_hash "missing"
    set previous_present_sample_hash "missing"
    array set fbs {}
    array set bos {}
    array set resources {}
    array set sample_hashes {}
    array set present_sample_hashes {}
    array set present_sample_resources {}

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {^\[([0-9]+)\].*FB: scanout-read used current KMS fb=([0-9]+) bo=([0-9]+) resource=([0-9]+).* transfer=([0-9]+) transfer_ret=(-?[0-9]+) rect=([0-9]+,[0-9]+ [0-9]+x[0-9]+)(?: sample_hash=(0x[0-9a-fA-F]+) sample_nonblack=([0-9]+) sample_center=(0x[0-9a-fA-F]+))?} $line -> tsc fb bo resource transfer transfer_ret rect sample_hash sample_nonblack sample_center]} {
            incr kms_count
            if {$first_tsc eq "missing"} {
                set first_tsc $tsc
            }
            set last_tsc $tsc
            set last_rect $rect
            set fbs($fb) 1
            set bos($bo) 1
            set resources($resource) 1
            if {$transfer != 0} {
                incr transfer_count
            }
            if {$transfer_ret != 0} {
                incr transfer_fail_count
            }
            if {$sample_hash ne ""} {
                set sample_hash [string tolower $sample_hash]
                set sample_hashes($sample_hash) 1
                if {$first_sample_hash eq "missing"} {
                    set first_sample_hash $sample_hash
                }
                set last_sample_hash $sample_hash
                if {$previous_sample_hash ne "missing" && $sample_hash ne $previous_sample_hash} {
                    incr sample_changed_count
                }
                set previous_sample_hash $sample_hash
            }
            if {$sample_nonblack ne "" && $sample_nonblack > 0} {
                incr sample_nonblack_count
            }
        } elseif {[regexp {^\[([0-9]+)\].*FB: scanout-read used current KMS fb=([0-9]+) bo=([0-9]+) resource=([0-9]+) rect=([0-9]+,[0-9]+ [0-9]+x[0-9]+)} $line -> tsc fb bo resource rect]} {
            incr kms_count
            if {$first_tsc eq "missing"} {
                set first_tsc $tsc
            }
            set last_tsc $tsc
            set last_rect $rect
            set fbs($fb) 1
            set bos($bo) 1
            set resources($resource) 1
        }
        if {[regexp {virtio_gpu: scanout-read resource=} $line]} {
            incr virtio_sample_count
        }
        if {[regexp {virtio_gpu: scanout-read\[[0-9]+\] end ret=} $line]} {
            incr virtio_end_count
        }
        if {[regexp {FB: virgl resource-scanout sample resource=([0-9]+) bo=([0-9]+) owner=([0-9]+):-?[0-9]+(?: resource_owner=[0-9]+:-?[0-9]+)? src=[0-9]+,[0-9]+ [0-9]+x[0-9]+ sample_hash=(0x[0-9a-fA-F]+) sample_nonblack=([0-9]+) sample_center=(0x[0-9a-fA-F]+)(?: sample_transfer_fail=([0-9]+))?} $line -> present_resource present_bo present_owner present_hash present_nonblack present_center present_transfer_fail]} {
            incr present_sample_count
            set present_hash [string tolower $present_hash]
            set present_sample_hashes($present_hash) 1
            set present_sample_resources($present_resource) 1
            if {$first_present_sample_hash eq "missing"} {
                set first_present_sample_hash $present_hash
            }
            set last_present_sample_hash $present_hash
            if {$previous_present_sample_hash ne "missing" && $present_hash ne $previous_present_sample_hash} {
                incr present_sample_changed_count
            }
            set previous_present_sample_hash $present_hash
            if {$present_nonblack > 0} {
                incr present_sample_nonblack_count
            }
            if {$present_transfer_fail ne "" && $present_transfer_fail > 0} {
                incr present_sample_transfer_fail_count
            }
        }
    }

    set tsc_span "missing"
    if {$first_tsc ne "missing" && $last_tsc ne "missing"} {
        set tsc_span [expr {$last_tsc - $first_tsc}]
    }
    set fb_list [join [lsort -integer [array names fbs]] ","]
    set bo_list [join [lsort -integer [array names bos]] ","]
    set resource_list [join [lsort -integer [array names resources]] ","]
    set sample_hash_list [join [lrange [lsort [array names sample_hashes]] 0 4] ","]
    set present_sample_hash_list [join [lrange [lsort [array names present_sample_hashes]] 0 4] ","]
    set present_resource_list [join [lsort -integer [array names present_sample_resources]] ","]
    return "available=1 kms_count=$kms_count distinct_fb_count=[array size fbs] distinct_bo_count=[array size bos] distinct_resource_count=[array size resources] first_tsc=$first_tsc last_tsc=$last_tsc tsc_span=$tsc_span last_rect=[evidence_quote $last_rect] fbs=$fb_list bos=$bo_list resources=$resource_list transfer_count=$transfer_count transfer_fail_count=$transfer_fail_count kms_sample_unique_hash_count=[array size sample_hashes] kms_sample_nonblack_count=$sample_nonblack_count kms_sample_changed_count=$sample_changed_count first_kms_sample_hash=$first_sample_hash last_kms_sample_hash=$last_sample_hash kms_sample_hashes=$sample_hash_list present_sample_count=$present_sample_count present_sample_unique_hash_count=[array size present_sample_hashes] present_sample_nonblack_count=$present_sample_nonblack_count present_sample_changed_count=$present_sample_changed_count present_sample_transfer_fail_count=$present_sample_transfer_fail_count first_present_sample_hash=$first_present_sample_hash last_present_sample_hash=$last_present_sample_hash present_sample_hashes=$present_sample_hash_list present_sample_resources=$present_resource_list virtio_sample_count=$virtio_sample_count virtio_end_count=$virtio_end_count"
}

proc chromium_video_chrome_log_metrics {perf_count_var perf_first_var perf_last_var
                                        gpu_init_error_count_var
                                        gpu_config_error_count_var
                                        gpu_exit_error_count_var
                                        gpu_error_pids_var gpu_error_first_var
                                        gpu_error_last_var
                                        gl_request_error_count_var
                                        gl_request_none_count_var
                                        gl_request_error_first_var
                                        gl_request_error_last_var} {
    global wayland_chromium_log
    upvar 1 $perf_count_var perf_count
    upvar 1 $perf_first_var perf_first
    upvar 1 $perf_last_var perf_last
    upvar 1 $gpu_init_error_count_var gpu_init_error_count
    upvar 1 $gpu_config_error_count_var gpu_config_error_count
    upvar 1 $gpu_exit_error_count_var gpu_exit_error_count
    upvar 1 $gpu_error_pids_var gpu_error_pids
    upvar 1 $gpu_error_first_var gpu_error_first
    upvar 1 $gpu_error_last_var gpu_error_last
    upvar 1 $gl_request_error_count_var gl_request_error_count
    upvar 1 $gl_request_none_count_var gl_request_none_count
    upvar 1 $gl_request_error_first_var gl_request_error_first
    upvar 1 $gl_request_error_last_var gl_request_error_last

    set perf_count 0
    set perf_first ""
    set perf_last ""
    set gpu_init_error_count 0
    set gpu_config_error_count 0
    set gpu_exit_error_count 0
    set gpu_error_pids {}
    set gpu_error_first ""
    set gpu_error_last ""
    set gl_request_error_count 0
    set gl_request_none_count 0
    set gl_request_error_first ""
    set gl_request_error_last ""
    if {![file exists $wayland_chromium_log]} {
        return
    }

    set text [read_text_file $wayland_chromium_log]
    foreach line [split $text "\n"] {
        set trimmed [string trim $line]
        if {$trimmed eq ""} {
            continue
        }
        if {[regexp {PERF-VIDEO } $trimmed]} {
            incr perf_count
            if {$perf_first eq ""} {
                set perf_first $trimmed
            }
            set perf_last $trimmed
        }
        if {[regexp {Requested GL implementation \(gl=([^,]+),angle=([^)]+)\) not found} $trimmed -> requested_gl requested_angle]} {
            incr gl_request_error_count
            if {$requested_gl eq "none" && $requested_angle eq "none"} {
                incr gl_request_none_count
            }
            if {$gl_request_error_first eq ""} {
                set gl_request_error_first $trimmed
            }
            set gl_request_error_last $trimmed
        }

        set gpu_error_kind ""
        if {[regexp {eglCreateContext ES [0-9.]+ failed|CollectGraphicsInfo failed|Could not create surface for info collection} $trimmed]} {
            incr gpu_init_error_count
            set gpu_error_kind "init"
        }
        if {[regexp {No suitable EGL configs} $trimmed]} {
            incr gpu_config_error_count
            set gpu_error_kind "config"
        }
        if {[regexp {Exiting GPU process} $trimmed]} {
            incr gpu_exit_error_count
            set gpu_error_kind "exit"
        }
        if {$gpu_error_kind ne ""} {
            if {$gpu_error_first eq ""} {
                set gpu_error_first $trimmed
            }
            set gpu_error_last $trimmed
            if {[regexp {^\[([0-9]+):[0-9]+:} $trimmed -> pid] &&
                [lsearch -exact $gpu_error_pids $pid] < 0} {
                lappend gpu_error_pids $pid
            }
        }
    }
}

proc write_chromium_video_post_evidence {} {
    global chromium_video_post_evidence_log chromium_video_result_wait_seconds
    global chromium_video_wait_for_playback_seconds
    global wayland_chromium_log chromium_launch_probe_log
    global chromium_video_capture_log chromium_video_capture_status
    global chromium_video_sample_count chromium_video_startup_ms
    global chromium_video_sampler_ms chromium_video_sampler_interval_ms
    global chromium_video_sampler_burst_ms chromium_video_sampler_burst_interval_ms
    global chromium_video_fast_census_ms chromium_video_fast_census_interval_ms
    global host_egl_gbm_log host_egl_gbm_status
    global host_egl_gbm_available
    global chromium_launch_only
    global chromium_video_egl_gbm_preprobe chromium_video_egl_gbm_require_config
    global chromium_video_egl_gbm_attempts
    global chromium_video_rela_preprobe
    global chromium_video_egl_platform chromium_video_extra_flags
    global chromium_video_simdutf_force_implementation
    global chromium_egl_trace chromium_egl_trace_proc chromium_egl_trace_callsite
    global chromium_egl_trace_wayland chromium_egl_trace_gtk
    global chromium_egl_trace_dlsym_wrap
    global chromium_mesa_egl_context_trace
    global chromium_mesa_extension_override
    global chromium_egl_trace_log
    global chromium_auto_gl_flags
    global chromium_process_full_maps
    global chromium_video_url chromium_video_proof_mode
    global chromium_video_final_sync_status
    global chromium_video_post_strict kde_preflight_enabled
    global chromium_video_sampler_log chromium_video_sampler_status
    global guest_role_probe_log role_probe_log

    set crash_match ""
    set result_kind ""
    set result_line ""
    set metrics_line ""
    set perf_start_line ""
    set perf_startup_line ""
    set perf_play_line ""
    set perf_playing_line ""
    set perf_tick_line ""
    set perf_result_line ""
    set perf_media_summary ""
    set perf_console_count 0
    set perf_console_first ""
    set perf_console_last ""
    set gpu_init_error_count 0
    set gpu_config_error_count 0
    set gpu_exit_error_count 0
    set gpu_error_pids {}
    set gpu_error_first ""
    set gpu_error_last ""
    set gl_request_error_count 0
    set gl_request_none_count 0
    set gl_request_error_first ""
    set gl_request_error_last ""
    set egl_chromium_offscreen_ready "missing"
    set egl_chromium_offscreen_reason "shape-missing"
    set egl_chromium_pbuffer_es3_count "missing"
    set egl_chromium_pbuffer_es2_count "missing"
    set egl_chromium_native_window_pbuffer_es3_count "missing"
    set egl_chromium_native_window_pbuffer_es2_count "missing"
    set egl_chromium_window_es3_count "missing"
    set egl_chromium_window_es2_count "missing"
    set egl_chromium_surfaceless_es3_count "missing"
    set egl_chromium_surfaceless_es2_count "missing"
    set egl_chromium_config_lines {}
    set egl_chromium_attempt_pbuffer_es3 "missing"
    set egl_chromium_attempt_pbuffer_es2 "missing"
    set egl_chromium_attempt_native_window_pbuffer_es3 "missing"
    set egl_chromium_attempt_native_window_pbuffer_es2 "missing"
    set egl_chromium_attempt_window_gbm_es3 "missing"
    set egl_chromium_attempt_window_gbm_es2 "missing"
    set egl_chromium_attempt_window_surfaceless_es3 "missing"
    set egl_chromium_attempt_window_surfaceless_es2 "missing"
    set egl_chromium_attempt_surfaceless_es3 "missing"
    set egl_chromium_attempt_surfaceless_es2 "missing"
    set egl_chromium_attempt_lines {}
    set launcher_wayland_failure ""
    set launch_evidence_status "missing"
    set wayland_debug_summary [chromium_wayland_debug_summary]
    set wayland_surface_delivery_matrix ""
    set egl_trace_summary [chromium_egl_trace_summary]
    set mesa_egl_context_trace_summary [chromium_mesa_egl_context_trace_summary]
    set kernel_lifecycle_summary [chromium_kernel_lifecycle_summary]
    set no_connection_child_summary [chromium_no_connection_child_summary]
    set fast_census_summary [chromium_process_fast_census_summary]
    set egl_trace_entrypoint_seen [expr {[regexp {(^| )choose=[1-9][0-9]*($| )} $egl_trace_summary] ||
                                         [regexp {(^| )create_context=[1-9][0-9]*($| )} $egl_trace_summary] ||
                                         [regexp {(^| )create_pbuffer=[1-9][0-9]*($| )} $egl_trace_summary] ||
                                         [regexp {(^| )create_window=[1-9][0-9]*($| )} $egl_trace_summary]}]
    set egl_trace_activity_seen [expr {$egl_trace_entrypoint_seen ||
                                       [regexp {(^| )process=[1-9][0-9]*($| )} $egl_trace_summary] ||
                                       [regexp {(^| )open=[1-9][0-9]*($| )} $egl_trace_summary] ||
                                       [regexp {(^| )openat=[1-9][0-9]*($| )} $egl_trace_summary] ||
                                       [regexp {(^| )ioctl=[1-9][0-9]*($| )} $egl_trace_summary] ||
                                       [regexp {(^| )execve=[1-9][0-9]*($| )} $egl_trace_summary] ||
                                       [regexp {(^| )socketpair=[1-9][0-9]*($| )} $egl_trace_summary] ||
                                       [regexp {(^| )ipc=[1-9][0-9]*($| )} $egl_trace_summary]}]
    set int3_summary [chromium_video_int3_summary]
    set int3_context_summary [chromium_video_int3_context_summary]
    set syscall_tail_summary [chromium_video_syscall_tail_summary]
    set fault_summary [chromium_video_fault_summary]
    set fault_context_summary [chromium_video_fault_context_summary]
    set launcher_crash_match ""
    set launcher_crash_seen [chromium_video_launcher_crash_signature launcher_crash_match]
    set launcher_loader_match ""
    set launcher_loader_seen [chromium_video_launcher_loader_signature launcher_loader_match]
    set rela_preprobe_summary [chromium_video_rela_preprobe_summary]
    set rela_preprobe_pass [regexp {(^| )status=PASS($| )} $rela_preprobe_summary]
    set kwin_trace_summary [kwin_alloc_trace_summary]
    set capture_log_summary [chromium_video_capture_log_summary]
    set capture_timing_summary [chromium_video_capture_timing_summary]
    set scanout_read_summary [chromium_video_scanout_read_summary]
    set scanout_sample_current_summary [chromium_video_scanout_sample_current_summary]
    set frame_hash_summary [chromium_video_frame_hash_summary]
    set drm_execbuffer_time_summary [chromium_video_drm_execbuffer_time_summary]
    set sampler_result_line [chromium_video_sampler_result_line]
    set fast_census_result_line [chromium_video_fast_census_result_line]
    set capture_status_line "missing"
    set egl_gbm_status_line "missing"
    set sampler_status_line "missing"
    set capture_result_pass 0
    set capture_present_count [chromium_video_present_sample_count]
    chromium_video_motion_summary capture_nonblack_count capture_changed_count \
        capture_post_nonblack_changed_count capture_first_nonblack_index
    set launch_evidence_seen [chromium_video_launch_evidence_status launch_evidence_status]
    if {[file exists $chromium_video_capture_status]} {
        set capture_status_line [string trim [read_text_file $chromium_video_capture_status]]
        if {[regexp {(^|[ \t])result=PASS([ \t]|$)} $capture_status_line]} {
            set capture_result_pass 1
        }
    }
    if {!$capture_result_pass && [guest_artifact_real_file $chromium_video_capture_log] &&
        [regexp {kde_chromium_video_capture result status=PASS} [read_text_file $chromium_video_capture_log]]} {
        set capture_result_pass 1
    }
    if {$chromium_launch_only eq "1"} {
        if {![guest_artifact_real_file $chromium_video_capture_log]} {
            set capture_log_summary "status=SKIP reason=launch-only"
            set capture_timing_summary "status=SKIP reason=launch-only"
        }
        if {![guest_artifact_real_file $chromium_video_capture_status]} {
            set capture_status_line "status=SKIP reason=launch-only"
        }
    }
    if {[guest_artifact_real_file $host_egl_gbm_status]} {
        set egl_gbm_status_line [string trim [read_text_file $host_egl_gbm_status]]
    }
    if {[guest_artifact_real_file $chromium_video_sampler_status]} {
        set sampler_status_line [string trim [read_text_file $chromium_video_sampler_status]]
    }
    set sampler_result_pass [regexp {status=PASS} $sampler_result_line]
    set sampler_result_skip [expr {$chromium_video_sample_count == 0 &&
                                   [regexp {(^|[ \t])result=SKIP([ \t]|$)} $sampler_status_line]}]
    set fast_census_required [expr {$chromium_video_fast_census_ms > 0}]
    set fast_census_result_pass [regexp {status=PASS} $fast_census_result_line]
    set fast_census_summary_seen [regexp {(^| )fast_line_count=[1-9][0-9]*($| )} $fast_census_summary]
    set sampler_or_fast_census_pass [expr {$sampler_result_pass ||
                                           (!$fast_census_required &&
                                            $sampler_result_skip) ||
                                           ($fast_census_required &&
                                            ($fast_census_result_pass ||
                                             $fast_census_summary_seen))}]
    set sampler_completion_seen [expr {[regexp {(^|[ \t])status=DONE([ \t]|$)} $sampler_status_line] ||
                                       $sampler_or_fast_census_pass}]
    chromium_video_perf_log_result result_kind result_line metrics_line
    chromium_video_perf_log_summary perf_start_line perf_startup_line \
        perf_play_line perf_playing_line perf_tick_line perf_result_line
    set perf_media_summary [chromium_video_perf_media_summary]
    set wayland_surface_delivery_matrix [chromium_wayland_surface_delivery_matrix \
        $wayland_debug_summary $perf_media_summary $frame_hash_summary \
        $scanout_read_summary]
    chromium_video_chrome_log_metrics perf_console_count perf_console_first \
        perf_console_last gpu_init_error_count gpu_config_error_count \
        gpu_exit_error_count gpu_error_pids gpu_error_first gpu_error_last \
        gl_request_error_count gl_request_none_count \
        gl_request_error_first gl_request_error_last
    set egl_gbm_smoke_result [host_egl_gbm_smoke_result_line]
    host_egl_gbm_chromium_config_metrics \
        egl_chromium_offscreen_ready egl_chromium_offscreen_reason \
        egl_chromium_pbuffer_es3_count egl_chromium_pbuffer_es2_count \
        egl_chromium_native_window_pbuffer_es3_count \
        egl_chromium_native_window_pbuffer_es2_count \
        egl_chromium_window_es3_count egl_chromium_window_es2_count \
        egl_chromium_surfaceless_es3_count egl_chromium_surfaceless_es2_count \
        egl_chromium_config_lines
    host_egl_gbm_chromium_attempt_metrics \
        egl_chromium_attempt_pbuffer_es3 \
        egl_chromium_attempt_pbuffer_es2 \
        egl_chromium_attempt_native_window_pbuffer_es3 \
        egl_chromium_attempt_native_window_pbuffer_es2 \
        egl_chromium_attempt_window_gbm_es3 \
        egl_chromium_attempt_window_gbm_es2 \
        egl_chromium_attempt_window_surfaceless_es3 \
        egl_chromium_attempt_window_surfaceless_es2 \
        egl_chromium_attempt_surfaceless_es3 \
        egl_chromium_attempt_surfaceless_es2 \
        egl_chromium_attempt_lines
    set egl_chromium_context_ready 0
    set egl_chromium_context_ready_reason "attempts-missing"
    if {[llength $egl_chromium_attempt_lines] > 0} {
        set egl_chromium_context_ready_reason "no-usable-context"
        if {$egl_chromium_attempt_pbuffer_es3 eq "PASS/ok" ||
            $egl_chromium_attempt_pbuffer_es2 eq "PASS/ok" ||
            $egl_chromium_attempt_native_window_pbuffer_es3 eq "PASS/ok" ||
            $egl_chromium_attempt_native_window_pbuffer_es2 eq "PASS/ok"} {
            set egl_chromium_context_ready 1
            set egl_chromium_context_ready_reason "pbuffer-pass"
        } elseif {$egl_chromium_attempt_window_gbm_es3 eq "PASS/ok" ||
                  $egl_chromium_attempt_window_gbm_es2 eq "PASS/ok" ||
                  $egl_chromium_attempt_window_surfaceless_es3 eq "PASS/ok" ||
                  $egl_chromium_attempt_window_surfaceless_es2 eq "PASS/ok" ||
                  $egl_chromium_attempt_surfaceless_es3 eq "PASS/ok" ||
                  $egl_chromium_attempt_surfaceless_es2 eq "PASS/ok"} {
            set egl_chromium_context_ready 1
            set egl_chromium_context_ready_reason "window-or-surfaceless-pass"
        }
    }

    set status "PASS"
    set reason "perf-result-not-required"
    if {![chromium_video_launch_started]} {
        set status "FAIL"
        set reason "not-launched"
    } elseif {$chromium_video_egl_gbm_preprobe eq "1" && $host_egl_gbm_available && ![guest_artifact_real_file $host_egl_gbm_status]} {
        set status "FAIL"
        set reason "egl-gbm-status-missing"
    } elseif {$chromium_video_egl_gbm_preprobe eq "1" && $host_egl_gbm_available && ![regexp {(^|[ \t])status=DONE([ \t]|$)} $egl_gbm_status_line]} {
        set status "FAIL"
        set reason "egl-gbm-status-incomplete"
    } elseif {$chromium_video_egl_gbm_preprobe eq "1" && $host_egl_gbm_available && ![guest_artifact_real_file $host_egl_gbm_log]} {
        set status "FAIL"
        set reason "egl-gbm-log-missing"
    } elseif {$chromium_video_egl_gbm_preprobe eq "1" && $host_egl_gbm_available && ![regexp {host-egl-gbm-gl-smoke: phase=result status=PASS} $egl_gbm_smoke_result]} {
        set status "FAIL"
        set reason "egl-gbm-result-missing"
    } elseif {$chromium_video_rela_preprobe eq "1" && !$rela_preprobe_pass} {
        set status "FAIL"
        set reason "rela-preprobe-fail"
    } elseif {!$launch_evidence_seen || $launch_evidence_status ne "PASS"} {
        set status "FAIL"
        set reason "launch-evidence-$launch_evidence_status"
    } elseif {[chromium_video_runlog_crash_signature crash_match]} {
        set status "FAIL"
        set reason "chrome-crash-regression"
    } elseif {$launcher_crash_seen} {
        set status "FAIL"
        set reason "chrome-crash-regression"
    } elseif {$launcher_loader_seen} {
        set status "FAIL"
        set reason "launcher-loader-regression"
    } elseif {[chromium_video_launcher_wayland_failure launcher_wayland_failure]} {
        set status "FAIL"
        set reason "launcher-wayland-platform-fail"
    } elseif {$chromium_egl_trace eq "1" && ![guest_artifact_real_file $chromium_egl_trace_log]} {
        set status "FAIL"
        set reason "chromium-egl-trace-missing"
    } elseif {![guest_artifact_real_file $chromium_video_sampler_status] &&
              !$sampler_completion_seen} {
        set status "FAIL"
        set reason "sampler-status-missing"
    } elseif {!$sampler_completion_seen} {
        set status "FAIL"
        set reason "sampler-status-incomplete"
    } elseif {![guest_artifact_real_file $chromium_video_sampler_log]} {
        set status "FAIL"
        set reason "sampler-log-missing"
    } elseif {!$sampler_or_fast_census_pass} {
        set status "FAIL"
        set reason "sampler-result-missing"
    } elseif {$fast_census_required && $fast_census_result_line eq "" &&
              !$fast_census_summary_seen} {
        set status "FAIL"
        set reason "fast-census-result-missing"
    } elseif {$fast_census_required && !$fast_census_result_pass &&
              !$fast_census_summary_seen} {
        set status "FAIL"
        set reason "fast-census-result-not-pass"
    } elseif {$chromium_launch_only eq "1" && $chromium_video_final_sync_status ne "done"} {
        set status "FAIL"
        set reason "final-sync-$chromium_video_final_sync_status"
    } elseif {$chromium_launch_only eq "1"} {
        set reason "launch-only"
    } elseif {$chromium_video_proof_mode eq "local-video" && $perf_start_line eq ""} {
        set status "FAIL"
        set reason "perf-start-missing"
    } elseif {$result_kind eq "fail"} {
        set status "FAIL"
        set reason [chromium_video_perf_result_failure_reason $result_line]
    } elseif {$chromium_video_sample_count == 0} {
        set reason "capture-skipped"
    } elseif {![regexp {(^|[ \t])status=DONE([ \t]|$)} $capture_status_line]} {
        set status "FAIL"
        set reason "capture-status-missing"
    } elseif {!$capture_result_pass} {
        set status "FAIL"
        set reason "capture-result-missing"
    } elseif {![regexp {(^|[ \t])status=PASS([ \t]|$)} $scanout_sample_current_summary]} {
        set status "FAIL"
        set reason "scanout-sample-current-missing"
    } elseif {$capture_present_count <= 0} {
        set status "FAIL"
        set reason "capture-empty"
    } elseif {$capture_present_count < $chromium_video_sample_count} {
        set status "FAIL"
        set reason "capture-incomplete"
    } elseif {$capture_nonblack_count ne "unavailable" && $capture_nonblack_count <= 0} {
        set status "FAIL"
        set reason "capture-black"
    } elseif {$chromium_video_wait_for_playback_seconds > 0 &&
              $perf_playing_line eq "" && $perf_tick_line eq "" &&
              $perf_result_line eq ""} {
        set status "FAIL"
        set reason "perf-playback-missing"
    } elseif {$capture_post_nonblack_changed_count ne "unavailable" && $capture_post_nonblack_changed_count <= 0} {
        set status "FAIL"
        set reason "capture-static"
    } elseif {$chromium_egl_trace eq "1" && !$egl_trace_activity_seen} {
        set status "FAIL"
        set reason "chromium-egl-trace-no-activity"
    } elseif {$chromium_video_final_sync_status ne "done"} {
        set status "FAIL"
        set reason "final-sync-$chromium_video_final_sync_status"
    } elseif {$result_kind eq "pass"} {
        set reason "perf-result-pass"
    } elseif {$chromium_video_result_wait_seconds > 0} {
        set status "FAIL"
        set reason "perf-result-missing"
    }

    set fh [open $chromium_video_post_evidence_log w]
    puts $fh "chromium_video_post_evidence phase=post_capture host_side=1"
    puts $fh "chromium_video_post_evidence post_strict=$chromium_video_post_strict kde_preflight_enabled=$kde_preflight_enabled"
    puts $fh "chromium_video_post_evidence startup_ms=$chromium_video_startup_ms"
    puts $fh "chromium_video_post_evidence result_wait_seconds=$chromium_video_result_wait_seconds"
    puts $fh "chromium_video_post_evidence wait_for_playback_seconds=$chromium_video_wait_for_playback_seconds"
    puts $fh "chromium_video_post_evidence sampler_ms=$chromium_video_sampler_ms"
    puts $fh "chromium_video_post_evidence sampler_interval_ms=$chromium_video_sampler_interval_ms"
    puts $fh "chromium_video_post_evidence sampler_burst_ms=$chromium_video_sampler_burst_ms"
    puts $fh "chromium_video_post_evidence sampler_burst_interval_ms=$chromium_video_sampler_burst_interval_ms"
    puts $fh "chromium_video_post_evidence fast_census_ms=$chromium_video_fast_census_ms"
    puts $fh "chromium_video_post_evidence fast_census_interval_ms=$chromium_video_fast_census_interval_ms"
    puts $fh "chromium_video_post_evidence chromium_process_full_maps=$chromium_process_full_maps"
    puts $fh "chromium_video_post_evidence launch_only=$chromium_launch_only"
    puts $fh "chromium_video_post_evidence chromium_video_url=[evidence_quote $chromium_video_url]"
    puts $fh "chromium_video_post_evidence chromium_video_proof_mode=[evidence_quote $chromium_video_proof_mode]"
    puts $fh "chromium_video_post_evidence egl_gbm_preprobe=$chromium_video_egl_gbm_preprobe"
    puts $fh "chromium_video_post_evidence egl_gbm_require_config=$chromium_video_egl_gbm_require_config"
    puts $fh "chromium_video_post_evidence egl_gbm_chromium_attempts=$chromium_video_egl_gbm_attempts"
    puts $fh "chromium_video_post_evidence rela_preprobe=$chromium_video_rela_preprobe"
    puts $fh "chromium_video_post_evidence chromium_egl_platform=$chromium_video_egl_platform"
    puts $fh "chromium_video_post_evidence chromium_auto_gl_flags=$chromium_auto_gl_flags"
