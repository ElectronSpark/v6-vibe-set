        set konsole_child_run_to_first_setup_ms \
            [summary_value $konsole_child_trace_summary "child_run_to_first_setup_ms" "missing"]
        set konsole_child_setup_total_calls \
            [summary_value $konsole_child_trace_summary "child_setup_total_calls" "missing"]
        set konsole_child_setup_buckets \
            [summary_value $konsole_child_trace_summary "child_setup_buckets" "missing"]
        set konsole_child_setup_slow_count \
            [summary_value $konsole_child_trace_summary "child_setup_slow_count" "missing"]
        set konsole_child_setup_max_bucket \
            [summary_value $konsole_child_trace_summary "child_setup_max_bucket" "missing"]
        set konsole_child_setup_max_bucket_ms \
            [summary_value $konsole_child_trace_summary "child_setup_max_bucket_ms" "missing"]
        set konsole_child_run_to_exec_begin_ms \
            [summary_value $konsole_child_trace_summary "child_run_to_exec_begin_ms" "missing"]
        set konsole_last_setup_to_exec_begin_ms \
            [summary_value $konsole_child_trace_summary "last_setup_to_exec_begin_ms" "missing"]
        set konsole_exec_begin_to_done_ms \
            [summary_value $konsole_child_trace_summary "exec_begin_to_done_ms" "missing"]
        set konsole_exec_done_to_wrapper_start_ms \
            [summary_value $konsole_child_trace_summary "exec_done_to_wrapper_start_ms" "missing"]
        set konsole_child_poll_detail_count \
            [summary_value $konsole_child_trace_summary "child_poll_detail_count" "0"]
        set konsole_child_poll_eintr_elapsed_ms \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_elapsed_ms" "missing"]
        set konsole_child_poll_eintr_kq_tmo \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_kq_tmo" "missing"]
        set konsole_child_poll_eintr_nevents \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_nevents" "missing"]
        set konsole_child_poll_eintr_kqueue_eintr \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_kqueue_eintr" "missing"]
        set konsole_child_poll_eintr_signal_check_eintr \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_signal_check_eintr" "missing"]
        set konsole_child_poll_eintr_pending \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_pending" "missing"]
        set konsole_child_poll_eintr_blocked \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_blocked" "missing"]
        set konsole_child_poll_eintr_shared_pending \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_shared_pending" "missing"]
        set konsole_child_poll_eintr_first_unblocked \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_first_unblocked" "missing"]
        set konsole_child_poll_eintr_last_signal \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_last_signal" "missing"]
        set konsole_child_poll_eintr_last_signal_source \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_last_signal_source" "missing"]
        set konsole_child_poll_eintr_last_signal_code \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_last_signal_code" "missing"]
        set konsole_child_poll_eintr_last_signal_pid \
            [summary_value $konsole_child_trace_summary "child_poll_eintr_last_signal_pid" "missing"]
        set konsole_child_poll_first_fd \
            [summary_value $konsole_child_trace_summary "child_poll_first_fd" "missing"]
        set konsole_child_poll_first_fd_events \
            [summary_value $konsole_child_trace_summary "child_poll_first_fd_events" "missing"]
        set konsole_child_poll_first_fd_revents \
            [summary_value $konsole_child_trace_summary "child_poll_first_fd_revents" "missing"]
        set konsole_child_poll_first_fd_kind \
            [summary_value $konsole_child_trace_summary "child_poll_first_fd_kind" "missing"]
        set konsole_child_poll_first_fd_notify_backed \
            [summary_value $konsole_child_trace_summary "child_poll_first_fd_notify_backed" "missing"]
        set konsole_child_poll_first_fd_requires_rescan \
            [summary_value $konsole_child_trace_summary "child_poll_first_fd_requires_rescan" "missing"]
        set konsole_child_poll_first_fd_target \
            [summary_value $konsole_child_trace_summary "child_poll_first_fd_target" "missing"]
        set konsole_child_poll_ready_fd \
            [summary_value $konsole_child_trace_summary "child_poll_ready_fd" "missing"]
        set konsole_child_poll_ready_fd_revents \
            [summary_value $konsole_child_trace_summary "child_poll_ready_fd_revents" "missing"]
        set konsole_child_poll_ready_fd_target \
            [summary_value $konsole_child_trace_summary "child_poll_ready_fd_target" "missing"]
        set konsole_child_launch_branch_hint \
            [summary_value $konsole_child_trace_summary "branch_hint" "missing"]
    }
    foreach raw_line [split $log_text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {$line eq ""} {
            continue
        }
        set payload $line
        if {[regexp {^kde_interaction_helper wayland-debug-ms=[0-9]+ line=(.*)$} $line -> stripped]} {
            set payload $stripped
        }
        if {[regexp {^elapsed_ms[ \t]+([0-9]+)} $payload -> value]} {
            set kprofile_elapsed_ms $value
        } elseif {[regexp {^kprofile_timeout_ms[ \t]+([0-9]+)} $payload -> value]} {
            set kprofile_timeout_ms $value
        } elseif {[regexp {^kprofile_timeout_hit[ \t]+([0-9]+)} $payload -> value]} {
            set kprofile_timeout_hit $value
        } elseif {[regexp {^cpu_busy_ms[ \t]+([0-9]+)} $payload -> value]} {
            set kprofile_cpu_busy_ms $value
        }
        if {[regexp {^kprofile-userpc-summary: ([^\r\n]*)} $payload -> userpc_summary]} {
            set kprofile_userpc_available "1"
            set kprofile_userpc_stored [summary_value $userpc_summary "stored" $kprofile_userpc_stored]
            set kprofile_userpc_total_seen [summary_value $userpc_summary "total_seen" $kprofile_userpc_total_seen]
            set kprofile_userpc_printed [summary_value $userpc_summary "printed" $kprofile_userpc_printed]
            set kprofile_userpc_dropped [summary_value $userpc_summary "dropped" $kprofile_userpc_dropped]
            set kprofile_userpc_overwritten [summary_value $userpc_summary "overwritten" $kprofile_userpc_overwritten]
            set kprofile_userpc_first_seq [summary_value $userpc_summary "first_seq" $kprofile_userpc_first_seq]
            set kprofile_userpc_last_seq [summary_value $userpc_summary "last_seq" $kprofile_userpc_last_seq]
            desktop_interaction_log_line "phase=direct-launch-summary action=kprofile-userpc status=PASS summary=[evidence_quote $userpc_summary]"
        }
        if {[regexp {^kprofile_hover[^\r\n]*phase=result[^\r\n]*status=([^ \t]+)[^\r\n]*} $payload hover_line hover_status]} {
            if {$hover_status eq "PASS"} {
                set kprofile_hover_included 1
            }
            if {$hover_status eq "SKIP" &&
                [regexp {reason=visual-hover-executed-by-host-qemu-monitor} $hover_line]} {
                set kprofile_hover_visual_only 1
            }
            if {[regexp {label=([^ \t]+)} $hover_line -> value]} {
                set kprofile_hover_label $value
            }
            if {[regexp {x=([0-9]+)} $hover_line -> value]} {
                set kprofile_hover_x $value
            }
            if {[regexp {y=([0-9]+)} $hover_line -> value]} {
                set kprofile_hover_y $value
            }
            if {[regexp {rc=([-0-9]+)} $hover_line -> value]} {
                set kprofile_hover_rc $value
            }
            if {[regexp {included_in_process_group=([0-9]+)} $hover_line -> value]} {
                set kprofile_hover_process_group $value
            }
        }
        if {[regexp {^kprofile_app_launch[^\r\n]*phase=result[^\r\n]*status=PASS[^\r\n]*} $payload]} {
            set kprofile_app_launch_included 1
        }
    }
    if {$kprofile_enabled} {
        if {$kprofile_timeout_hit eq "missing"} {
            desktop_interaction_log_line "phase=direct-launch action=kde-app-launch-probe status=FAIL reason=missing-kprofile-output kprofile_enabled=$kprofile_enabled $launch_fields status_path=$status_path log_path=$log_path host_log=$host_log_path host_status=$host_status_path"
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-app-launch-latency-kprofile-missing"
        }
        if {$kprofile_timeout_hit != 0} {
            desktop_interaction_log_line "phase=direct-launch action=kde-app-launch-probe status=FAIL reason=kprofile-timeout-hit kprofile_timeout_hit=$kprofile_timeout_hit kprofile_timeout_ms=$kprofile_timeout_ms $launch_fields status_path=$status_path log_path=$log_path host_log=$host_log_path host_status=$host_status_path"
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-app-launch-latency-kprofile-timeout"
        }
        if {!$kprofile_app_launch_included} {
            desktop_interaction_log_line "phase=direct-launch action=kde-app-launch-probe status=FAIL reason=missing-kprofile-app-launch-marker kprofile_enabled=$kprofile_enabled $launch_fields status_path=$status_path log_path=$log_path host_log=$host_log_path host_status=$host_status_path"
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-app-launch-latency-kprofile-app-marker"
        }
        if {$kprofile_hover_requested &&
            !$kprofile_hover_included &&
            !$kprofile_hover_visual_only} {
            desktop_interaction_log_line "phase=direct-launch action=kde-app-launch-probe status=FAIL reason=missing-kprofile-hover-marker kprofile_hover_requested=$kprofile_hover_requested $launch_fields status_path=$status_path log_path=$log_path host_log=$host_log_path host_status=$host_status_path"
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-app-launch-latency-kprofile-hover-marker"
        }
    }
    if {$host_log_path ne "" && [regexp {kde_interaction_helper wayland-debug-ms=} $log_text]} {
        set rc [catch {
            exec python3 "$root/scripts/gpu/wayland-debug-gap-summary.py" \
                --top 20 --min-gap-ms 50 $host_log_path
        } summary_text]
        set fh [open $wayland_debug_summary_log w]
        puts -nonewline $fh $summary_text
        if {$summary_text ne "" && [string index $summary_text end] ne "\n"} {
            puts $fh ""
        }
        close $fh
        if {$rc == 0} {
            foreach raw_line [split $summary_text "\n"] {
                set line [string trimright $raw_line "\r"]
                if {$line ne ""} {
                    desktop_interaction_log_line "phase=wayland-debug-summary action=kde-app-launch-probe status=PASS summary=[evidence_quote $line]"
                }
            }
        } else {
            desktop_interaction_log_line "phase=wayland-debug-summary action=kde-app-launch-probe status=FAIL rc=$rc summary_log=$wayland_debug_summary_log summary=[evidence_quote $summary_text]"
        }
    }
    foreach raw_line [split $phase_parse_text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {kde_app_launch_probe launch app=konsole[^\r\n]*} $line match] ||
            [regexp {kde_app_launch_probe marker phase=konsole-ready status=found[^\r\n]*} $line match] ||
            [regexp {kde_app_launch_probe konsole_phase_detail[^\r\n]*} $line match] ||
            [regexp {kde_app_launch_probe konsole_snapshot[^\r\n]*} $line match] ||
            [regexp {kde_app_launch_probe konsole_phase[^\r\n]*} $line match] ||
            [regexp {xv6-konsole-shell phase=[^\r\n]*} $line match] ||
            [regexp {xv6-konsole-shell-ready[^\r\n]*} $line match] ||
            [regexp {kprofile_hover[^\r\n]*} $line match] ||
            [regexp {kprofile_app_launch[^\r\n]*} $line match] ||
            [regexp {kprofile_config[^\r\n]*} $line match]} {
            desktop_interaction_log_line "phase=direct-launch-detail action=kde-app-launch-probe detail=[evidence_quote [string map {"\t" " " "\r" "" "\n" " "} $match]]"
        }
    }
    foreach raw_line [split $log_text "\n"] {
        set line [string trimright $raw_line "\r"]
        set payload $line
        if {[regexp {^kde_interaction_helper wayland-debug-ms=[0-9]+ line=(.*)$} $line -> stripped]} {
            set payload $stripped
        }
        if {[regexp {^(kprofile_hover|kprofile_app_launch|kprofile_config)[^\r\n]*} $payload match]} {
            desktop_interaction_log_line "phase=direct-launch-detail action=kde-app-launch-probe detail=[evidence_quote [string map {"\t" " " "\r" "" "\n" " "} $match]]"
        }
        if {[regexp {^kprofile-userpc[^:\r\n]*: [^\r\n]*} $payload match]} {
            desktop_interaction_log_line "phase=direct-launch-detail action=kprofile-userpc detail=[evidence_quote [string map {"\t" " " "\r" "" "\n" " "} $match]]"
        }
        if {[regexp {konsole-wayland-event-trace: [^\r\n]*} $payload match]} {
            desktop_interaction_log_line "phase=direct-launch-detail action=konsole-wayland-event-trace detail=[evidence_quote [string map {"\t" " " "\r" "" "\n" " "} $match]]"
        }
        if {[regexp {konsole-qt-event-trace: [^\r\n]*} $payload match]} {
            desktop_interaction_log_line "phase=direct-launch-detail action=konsole-qt-event-trace detail=[evidence_quote [string map {"\t" " " "\r" "" "\n" " "} $match]]"
        }
        if {[regexp {konsole-qt-cpp-trace: [^\r\n]*} $payload match]} {
            desktop_interaction_log_line "phase=direct-launch-detail action=konsole-qt-cpp-trace detail=[evidence_quote [string map {"\t" " " "\r" "" "\n" " "} $match]]"
        }
        if {[regexp {konsole-loader-trace: [^\r\n]*} $payload match]} {
            desktop_interaction_log_line "phase=direct-launch-detail action=konsole-loader-trace detail=[evidence_quote [string map {"\t" " " "\r" "" "\n" " "} $match]]"
        }
    }
    if {[file exists $runlog]} {
        foreach raw_line [split [read_text_file $runlog] "\n"] {
            set line [string trimright $raw_line "\r"]
            if {[regexp {konsole-child-launch:[^\r\n]*} $line match] ||
                [regexp {konsole-child-poll-detail:[^\r\n]*} $line match] ||
                [regexp {konsole-child-poll-fd:[^\r\n]*} $line match]} {
                desktop_interaction_log_line "phase=direct-launch-detail action=konsole-child-launch-trace detail=[evidence_quote [string map {"\t" " " "\r" "" "\n" " "} $match]]"
            }
        }
    }
    if {$host_log_path ne ""} {
        desktop_interaction_log_line "phase=direct-launch-summary action=kprofile-userpc-phase-attribution status=start $launch_fields host_log=$host_log_path phase_log=$phase_host_path"
        set phase_attribution_rc [catch {
            exec python3 "$root/scripts/gpu/kprofile-userpc-phase-attribution.py" \
                $host_log_path $phase_host_path
        } phase_attribution_text]
        if {$phase_attribution_rc == 0} {
            foreach raw_line [split $phase_attribution_text "\n"] {
                set line [string trimright $raw_line "\r"]
                if {$line ne ""} {
                    desktop_interaction_log_line $line
                }
            }
            desktop_interaction_log_line "phase=direct-launch-summary action=kprofile-userpc-phase-attribution status=PASS $launch_fields host_log=$host_log_path phase_log=$phase_host_path"
        } else {
            desktop_interaction_log_line "phase=direct-launch-summary action=kprofile-userpc-phase-attribution status=FAIL reason=helper-error rc=$phase_attribution_rc $launch_fields host_log=$host_log_path phase_log=$phase_host_path error=[evidence_quote $phase_attribution_text]"
        }
    }
    desktop_interaction_log_line "phase=direct-launch action=kprofile-userpc status=PASS $launch_fields kprofile_userpc=$kprofile_userpc kprofile_vfs_enoent_attr=$kprofile_vfs_enoent_attr kprofile_userpc_period=$kprofile_userpc_period kprofile_userpc_limit=$kprofile_userpc_limit kprofile_userpc_available=$kprofile_userpc_available kprofile_userpc_stored=$kprofile_userpc_stored kprofile_userpc_total_seen=$kprofile_userpc_total_seen kprofile_userpc_printed=$kprofile_userpc_printed kprofile_userpc_dropped=$kprofile_userpc_dropped kprofile_userpc_overwritten=$kprofile_userpc_overwritten kprofile_userpc_first_seq=$kprofile_userpc_first_seq kprofile_userpc_last_seq=$kprofile_userpc_last_seq"
    desktop_interaction_log_line "phase=direct-launch action=kde-app-launch-probe status=PASS elapsed_ms=$elapsed_ms helper_elapsed_ms=$helper_elapsed_ms probe_rc=$probe_rc konsole_only=$konsole_only konsole_variant=$konsole_variant konsole_wait_ms=$konsole_wait_ms konsole_sample_ms=$konsole_sample_ms konsole_launch_start_ms=$konsole_launch_start_ms konsole_launch_call_ms=$konsole_launch_call_ms konsole_marker_found_since_launch_ms=$konsole_marker_found_since_launch_ms konsole_wrapper_start_since_launch_ms=$konsole_wrapper_start_since_launch_ms konsole_wrapper_marker_found_since_wrapper_ms=$konsole_wrapper_marker_found_since_wrapper_ms konsole_wrapper_open_delta_ms=$konsole_wrapper_open_delta_ms konsole_wrapper_marker_write_delta_ms=$konsole_wrapper_marker_write_delta_ms konsole_wrapper_written_delta_ms=$konsole_wrapper_written_delta_ms konsole_wrapper_before_exec_delta_ms=$konsole_wrapper_before_exec_delta_ms konsole_pty_ptmx_since_launch_ms=$konsole_pty_ptmx_since_launch_ms konsole_pty_pts_since_launch_ms=$konsole_pty_pts_since_launch_ms konsole_pts_to_wrapper_ms=$konsole_pts_to_wrapper_ms konsole_child_trace_available=$konsole_child_trace_available konsole_child_trace_count=$konsole_child_trace_count konsole_child_pid=$konsole_child_pid konsole_pts_to_clone_begin_ms=$konsole_pts_to_clone_begin_ms konsole_parent_last_wait_role=$konsole_parent_last_wait_role konsole_parent_last_wait_age_ms=$konsole_parent_last_wait_age_ms konsole_parent_last_wait_ms=$konsole_parent_last_wait_ms konsole_parent_last_wait_ret=$konsole_parent_last_wait_ret konsole_clone_done_to_child_run_ms=$konsole_clone_done_to_child_run_ms konsole_child_woken_to_run_ms=$konsole_child_woken_to_run_ms konsole_child_run_to_first_setup_ms=$konsole_child_run_to_first_setup_ms konsole_child_setup_total_calls=$konsole_child_setup_total_calls konsole_child_setup_buckets=$konsole_child_setup_buckets konsole_child_setup_slow_count=$konsole_child_setup_slow_count konsole_child_setup_max_bucket=$konsole_child_s