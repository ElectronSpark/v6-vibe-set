    $chromium_video_sampler_burst_interval_ms < 20} {
    set chromium_video_sampler_burst_interval_ms 100
}
if {$chromium_video_sampler_burst_interval_ms > 1000} {
    set chromium_video_sampler_burst_interval_ms 1000
}
