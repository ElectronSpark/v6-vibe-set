set desktop_interaction_work_y1 799

proc env_bool {name default} {
    if {![info exists ::env($name)]} {
        return $default
    }
    set value [string tolower $::env($name)]
    if {$value eq "1" || $value eq "true" || $value eq "yes" ||
        $value eq "on"} {
        return 1
    }
    if {$value eq "0" || $value eq "false" || $value eq "no" ||
        $value eq "off" || $value eq ""} {
        return 0
    }
    return $default
}

proc kde_interaction_diagnostic_input_enabled {} {
    if {[env_bool KDE_SMOKE_INTERACTION_DIAGNOSTIC_INPUT 0]} {
        return 1
    }
    if {[env_bool KDE_SMOKE_INTERACTION_ALLOW_QEMU_MONITOR_INPUT 0]} {
        return 1
    }
    return 0
}

proc kde_interaction_input_source {} {
    set input_source "guest"
    if {[info exists ::env(KDE_SMOKE_INTERACTION_INPUT_SOURCE)]} {
        set requested [string tolower $::env(KDE_SMOKE_INTERACTION_INPUT_SOURCE)]
        if {$requested eq "qemu-monitor" || $requested eq "monitor"} {
            if {[kde_interaction_diagnostic_input_enabled]} {
                set input_source "qemu-monitor"
            }
        } elseif {$requested eq "guest" || $requested eq "mouseinject"} {
            set input_source "guest"
        }
    }
    return $input_source
}

proc clamp_abs16_coord {value} {
    if {![string is integer -strict $value]} {
        return 0
    }
    if {$value < 0} {
        return 0
    }
    if {$value > 65535} {
        return 65535
    }
    return $value
}

