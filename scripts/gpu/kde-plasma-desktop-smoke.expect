    }
    if {$gpu_error_last ne ""} {
        puts $fh "chromium_video_post_evidence gpu_error_last=$gpu_error_last"
    }
    puts $fh "chromium_video_post_evidence gl_request_error_count=$gl_request_error_count gl_request_none_count=$gl_request_none_count"
