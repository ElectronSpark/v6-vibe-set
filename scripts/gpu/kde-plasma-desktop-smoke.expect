    set konsole_qt_cpp_trace_branch_hint \
        [summary_value $konsole_qt_cpp_trace_summary "branch_hint" "missing"]
    if {$konsole_qt_cpp_trace_available} {
        desktop_interaction_log_line "phase=direct-launch-summary action=konsole-qt-cpp-trace status=PASS $launch_fields summary=[evidence_quote $konsole_qt_cpp_trace_summary]"
    }
    if {[regexp {konsole_wait_ms=([0-9]+)} $log_text -> kw]} {
        set konsole_wait_ms $kw
    }
    if {[regexp {KDE_APP_LAUNCH_PROBE_KONSOLE_ONLY=([0-9]+)} $log_text -> ko]} {
        set konsole_only $ko
    } elseif {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*konsole_only=([-0-9]+)} $phase_parse_text -> ko]} {
        set konsole_only $ko
    }
    if {[regexp {KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT=([^ \t\r\n]+)} $log_text -> kv]} {
        set konsole_variant $kv
    } elseif {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*konsole_variant=([^ \t\r\n]+)} $phase_parse_text -> kv]} {
        set konsole_variant $kv
    } elseif {[regexp {kde_app_launch_probe[^\r\n]*konsole_variant=([^ \t\r\n]+)} $log_text -> kv]} {
        set konsole_variant $kv
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*konsole_launch_start_ms=([-0-9]+)} $phase_parse_text -> kls]} {
        set konsole_launch_start_ms $kls
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*marker_found_since_launch_ms=([-0-9]+)} $phase_parse_text -> kmfl]} {
        set konsole_marker_found_since_launch_ms $kmfl
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*launch_call_ms=([-0-9]+)} $phase_parse_text -> klc]} {
        set konsole_launch_call_ms $klc
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*wrapper_start_since_launch_ms=([-0-9]+)} $phase_parse_text -> ksl]} {
        set konsole_wrapper_start_since_launch_ms $ksl
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*wrapper_marker_found_since_wrapper_ms=([-0-9]+)} $phase_parse_text -> kmw]} {
        set konsole_wrapper_marker_found_since_wrapper_ms $kmw
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*wrapper_open_delta_ms=([-0-9]+)} $phase_parse_text -> kod]} {
        set konsole_wrapper_open_delta_ms $kod
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*wrapper_marker_write_delta_ms=([-0-9]+)} $phase_parse_text -> kmwd]} {
        set konsole_wrapper_marker_write_delta_ms $kmwd
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*wrapper_written_delta_ms=([-0-9]+)} $phase_parse_text -> kwwd]} {
        set konsole_wrapper_written_delta_ms $kwwd
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*wrapper_before_exec_delta_ms=([-0-9]+)} $phase_parse_text -> kbe]} {
        set konsole_wrapper_before_exec_delta_ms $kbe
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*pty_ptmx_since_launch_ms=([-0-9]+)} $phase_parse_text -> kptmx]} {
        set konsole_pty_ptmx_since_launch_ms $kptmx
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*pty_pts_since_launch_ms=([-0-9]+)} $phase_parse_text -> kpts]} {
        set konsole_pty_pts_since_launch_ms $kpts
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*bash_start_since_launch_ms=([-0-9]+)} $phase_parse_text -> kbs]} {
        set konsole_bash_start_since_launch_ms $kbs
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*bash_start_since_wrapper_ms=([-0-9]+)} $phase_parse_text -> kbw]} {
        set konsole_bash_start_since_wrapper_ms $kbw
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*bash_prompt_since_launch_ms=([-0-9]+)} $phase_parse_text -> kbpl]} {
        set konsole_bash_prompt_since_launch_ms $kbpl
    } elseif {[regexp {bash_prompt_since_launch_ms=([-0-9]+)} $log_text -> kbpl]} {
        set konsole_bash_prompt_since_launch_ms $kbpl
    }
    if {[regexp {kde_app_launch_probe konsole_phase[^\r\n]*bash_prompt_since_wrapper_ms=([-0-9]+)} $phase_parse_text -> kbpw]} {
        set konsole_bash_prompt_since_wrapper_ms $kbpw
    } elseif {[regexp {bash_prompt_since_wrapper_ms=([-0-9]+)} $log_text -> kbpw]} {
        set konsole_bash_prompt_since_wrapper_ms $kbpw
    }
    if {[string is integer -strict $konsole_wrapper_start_since_launch_ms] &&
        [string is integer -strict $konsole_pty_pts_since_launch_ms] &&
        $konsole_wrapper_start_since_launch_ms >= 0 &&
        $konsole_pty_pts_since_launch_ms >= 0} {
        set konsole_pts_to_wrapper_ms [expr {$konsole_wrapper_start_since_launch_ms - $konsole_pty_pts_since_launch_ms}]
    }
    if {[string is integer -strict $konsole_bash_start_since_wrapper_ms] &&
        $konsole_bash_start_since_wrapper_ms >= 0} {
        set konsole_wrapper_to_bash_comm_ms $konsole_bash_start_since_wrapper_ms
    }
    if {[string is integer -strict $konsole_bash_prompt_since_wrapper_ms] &&
        $konsole_bash_prompt_since_wrapper_ms >= 0} {
        set konsole_wrapper_to_bash_prompt_ms $konsole_bash_prompt_since_wrapper_ms
    }
    if {[regexp {KDE_APP_LAUNCH_PROBE_KONSOLE_WAIT_SAMPLE_MS=([0-9]+)} $log_text -> ksm]} {
        set konsole_sample_ms $ksm
    } elseif {[regexp {marker phase=konsole-ready status=waiting} $phase_parse_text]} {
        set konsole_sample_ms "logged"
    }
    if {[file exists $runlog]} {
        set run_text [read_text_file $runlog]
        set konsole_child_trace_summary \
            [konsole_child_launch_trace_summary $run_text $phase_parse_text]
        set konsole_child_trace_available \
            [summary_value $konsole_child_trace_summary "available" "0"]
        set konsole_child_trace_count \
            [summary_value $konsole_child_trace_summary "trace_count" "0"]
        set konsole_child_pid \
            [summary_value $konsole_child_trace_summary "child_pid" "missing"]
        set konsole_pts_to_clone_begin_ms \
            [summary_value $konsole_child_trace_summary "pts_to_clone_begin_ms" "missing"]
        set konsole_parent_last_wait_role \
