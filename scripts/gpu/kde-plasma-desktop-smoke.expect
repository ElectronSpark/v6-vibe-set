    }
    if {![string is integer -strict $swap_only_skipped_draw_frames]} {
        return "$label_prefix-skipped-draw-invalid"
    }
    if {$swap_only_skipped_draw_frames != $frames - 1} {
        return "$label_prefix-skipped-draw-mismatch"
    }
    foreach {value label} [list \
        $plain_swap_issue_total plain-swap-issue-total \
        $plain_swap_avg plain-swap-avg \
        $plain_swap_max plain-swap-max] {
        if {$value eq ""} {
