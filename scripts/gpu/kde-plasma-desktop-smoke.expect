    x11_glx_swap_trace_scan_log $log_text $trace_child_pid glx_swap_trace_capable glx_swap_trace_result glx_swap_trace_status glx_swap_xcb_trace_capable glx_swap_syscall_trace_capable glx_swap_buffers_calls glx_swap_buffers_msc_oml_calls glx_swap_total_ms glx_swap_max_ms glx_swap_nested_pixmap_calls glx_swap_nested_pixmap_checked_calls glx_swap_nested_pixmap_total_ms glx_swap_nested_wait_special_calls glx_swap_nested_poll_special_calls glx_swap_nested_wait_special_total_ms glx_swap_nested_poll_special_total_ms glx_swap_nested_complete_events glx_swap_nested_xcb_flush_calls glx_swap_nested_xcb_flush_total_ms glx_swap_nested_xcb_request_check_calls glx_swap_nested_xcb_request_check_total_ms glx_swap_nested_xcb_wait_reply_calls glx_swap_nested_xcb_wait_reply_total_ms glx_swap_nested_xcb_poll_reply_calls glx_swap_nested_xcb_poll_reply_total_ms glx_swap_nested_xcb_wait_event_calls glx_swap_nested_xcb_wait_event_total_ms glx_swap_nested_xcb_poll_event_calls glx_swap_nested_xcb_poll_event_total_ms glx_swap_accounted_present_ms glx_swap_above_present_ms glx_swap_accounted_xcb_ms glx_swap_above_xcb_ms glx_swap_syscall_total_ms glx_swap_syscall_nested_x11_ms glx_swap_syscall_above_x11_ms glx_swap_syscall_ioctl_calls glx_swap_syscall_ioctl_total_ms glx_swap_syscall_ioctl_max_ms glx_swap_syscall_poll_ppoll_calls glx_swap_syscall_poll_ppoll_total_ms glx_swap_syscall_poll_ppoll_max_ms glx_swap_syscall_select_pselect_calls glx_swap_syscall_select_pselect_total_ms glx_swap_syscall_select_pselect_max_ms glx_swap_syscall_read_recv_calls glx_swap_syscall_read_recv_total_ms glx_swap_syscall_read_recv_max_ms glx_swap_syscall_write_send_calls glx_swap_syscall_write_send_total_ms glx_swap_syscall_write_send_max_ms glx_swap_missing_symbols glx_swap_recursion_skips
