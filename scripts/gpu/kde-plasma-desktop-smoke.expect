ed_ms konsole_qt_cpp_trace_max_ready_to_notify_internal2_ms=$konsole_qt_cpp_trace_max_ready_to_notify_internal2_ms konsole_qt_cpp_trace_max_ready_to_qsocketnotifier_event_ms=$konsole_qt_cpp_trace_max_ready_to_qsocketnotifier_event_ms konsole_qt_cpp_trace_max_ready_to_qwayland_handle_sync_ms=$konsole_qt_cpp_trace_max_ready_to_qwayland_handle_sync_ms konsole_qt_cpp_trace_max_ready_to_qwayland_request_sync_ms=$konsole_qt_cpp_trace_max_ready_to_qwayland_request_sync_ms konsole_qt_cpp_trace_max_ready_to_qwayland_blocking_read_ms=$konsole_qt_cpp_trace_max_ready_to_qwayland_blocking_read_ms konsole_qt_cpp_trace_max_ready_to_qwayland_flush_requests_ms=$konsole_qt_cpp_trace_max_ready_to_qwayland_flush_requests_ms konsole_qt_cpp_trace_max_public_wl_elapsed_ms=$konsole_qt_cpp_trace_max_public_wl_elapsed_ms konsole_qt_cpp_trace_max_public_wl_ready_to_call_ms=$konsole_qt_cpp_trace_max_public_wl_ready_to_call_ms konsole_qt_cpp_trace_max_wl_fd_syscall_elapsed_ms=$konsole_qt_cpp_trace_max_wl_fd_syscall_elapsed_ms konsole_qt_cpp_trace_max_wl_fd_syscall_ready_to_call_ms=$konsole_qt_cpp_trace_max_wl_fd_syscall_ready_to_call_ms konsole_qt_cpp_trace_max_process_events_ms=$konsole_qt_cpp_trace_max_process_events_ms konsole_qt_cpp_trace_max_send_wse_ms=$konsole_qt_cpp_trace_max_send_wse_ms konsole_qt_cpp_trace_max_flush_wse_ms=$konsole_qt_cpp_trace_max_flush_wse_ms konsole_qt_cpp_trace_max_qsocketnotifier_event_ms=$konsole_qt_cpp_trace_max_qsocketnotifier_event_ms konsole_qt_cpp_trace_max_qwayland_handle_sync_ms=$konsole_qt_cpp_trace_max_qwayland_handle_sync_ms konsole_qt_cpp_trace_max_qwayland_request_sync_ms=$konsole_qt_cpp_trace_max_qwayland_request_sync_ms konsole_qt_cpp_trace_max_qwayland_blocking_read_ms=$konsole_qt_cpp_trace_max_qwayland_blocking_read_ms konsole_qt_cpp_trace_max_qwayland_flush_requests_ms=$konsole_qt_cpp_trace_max_qwayland_flush_requests_ms konsole_qt_cpp_trace_output_dropped=$konsole_qt_cpp_trace_output_dropped konsole_qt_cpp_trace_branch_hint=$konsole_qt_cpp_trace_branch_hint konsole_bash_start_since_launch_ms=$konsole_bash_start_since_launch_ms konsole_bash_start_since_wrapper_ms=$konsole_bash_start_since_wrapper_ms konsole_wrapper_to_bash_comm_ms=$konsole_wrapper_to_bash_comm_ms konsole_bash_prompt_since_launch_ms=$konsole_bash_prompt_since_launch_ms konsole_bash_prompt_since_wrapper_ms=$konsole_bash_prompt_since_wrapper_ms konsole_wrapper_to_bash_prompt_ms=$konsole_wrapper_to_bash_prompt_ms kprofile_enabled=$kprofile_enabled kprofile_hover_included=$kprofile_hover_included kprofile_hover_visual_only=$kprofile_hover_visual_only kprofile_hover_process_group=$kprofile_hover_process_group kprofile_hover_label=$kprofile_hover_label kprofile_hover_x=$kprofile_hover_x kprofile_hover_y=$kprofile_hover_y kprofile_hover_rc=$kprofile_hover_rc kprofile_app_launch_included=$kprofile_app_launch_included kprofile_vfs_enoent_attr=$kprofile_vfs_enoent_attr kprofile_timeout_hit=$kprofile_timeout_hit kprofile_timeout_ms=$kprofile_timeout_ms kprofile_elapsed_ms=$kprofile_elapsed_ms kprofile_cpu_busy_ms=$kprofile_cpu_busy_ms status_path=$status_path log_path=$log_path artifact_raw_log=$artifact_raw_log host_log=$host_log_path host_status=$host_status_path phase_log=$phase_host_path"
    desktop_interaction_log_line "phase=direct-launch-summary action=kde-app-launch-probe-metadata status=PASS $launch_fields helper_label=$helper_label elapsed_ms=$elapsed_ms helper_elapsed_ms=$helper_elapsed_ms probe_rc=$probe_rc status_path=$status_path log_path=$log_path artifact_raw_log=$artifact_raw_log host_log=$host_log_path host_status=$host_status_path phase_log=$phase_host_path [desktop_interaction_guest_input_policy_fields]"
    set manifest_done_fh [open $direct_launch_raw_manifest a]
    puts $manifest_done_fh "launch_end=1"
    close $manifest_done_fh
    puts "KDE-PLASMA-DESKTOP-SMOKE-INFO interaction phase=direct-launch action=kde-app-launch-probe status=PASS elapsed_ms=$elapsed_ms $launch_fields"
}

proc measure_direct_app_launch_repeats {repeat_count repeat_delay_ms} {
    global direct_launch_raw_manifest

    if {$repeat_count > 1} {
        set manifest_fh [open $direct_launch_raw_manifest w]
        puts $manifest_fh "repeat_count=$repeat_count"
        puts $manifest_fh "repeat_delay_ms=$repeat_delay_ms"
        puts $manifest_fh "artifact_path_base=manifest-directory"
        close $manifest_fh
        desktop_interaction_log_line "phase=direct-launch-repeats action=kde-app-launch-probe status=start repeat_count=$repeat_count repeat_delay_ms=$repeat_delay_ms"
    }

    for {set launch_index 1} {$launch_index <= $repeat_count} {incr launch_index} {
        measure_direct_app_launch_latency \
            $launch_index $repeat_count $repeat_delay_ms
        if {$repeat_count > 1 && $launch_index < $repeat_count &&
            $repeat_delay_ms > 0} {
            after $repeat_delay_ms
        }
    }

    if {$repeat_count > 1} {
        desktop_interaction_log_line "phase=direct-launch-repeats action=kde-app-launch-probe status=PASS repeat_count=$repeat_count repeat_delay_ms=$repeat_delay_ms"
    }
}

proc measure_wayland_activation_pty_probe {} {
    set start_ms [clock milliseconds]
    desktop_interaction_log_line "phase=activation-pty action=kde-wayland-activation-pty-probe status=start start_ms=$start_ms"
    set result [run_desktop_interaction_helper_command activation-pty kde-wayland-activation-pty-probe "" 45000]
    set status_path [lindex $result 0]
    set log_path [lindex $result 1]
    set status_text [lindex $result 2]
    set log_text [lindex $result 3]
    set helper_elapsed_ms [lindex $result 4]
    set host_log_path [lindex $result 5]
    set host_status_path [lindex $result 6]
    set probe_rc "missing"
    if {[regexp {probe_rc=([-0-9]+)} $status_text -> parsed_probe_rc]} {
        set probe_rc $parsed_probe_rc
    }
    if {$probe_rc eq "missing" || $probe_rc != 0} {
        desktop_interaction_log_line "phase=activation-pty action=kde-wayland-activation-pty-probe status=FAIL reason=probe-rc probe_rc=$probe_rc status_path=$status_path log_path=$log_path host_log=$host_log_path host_status=$host_status_path log=[evidence_quote $log_text]"
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-activation-pty-probe-rc"
    }
    if {![regexp {kde_wayland_activation_pty_probe phase=result status=PASS[^\r\n]*} $log_text result_line]} {
        desktop_interaction_log_line "phase=activation-pty action=kde-wayland-activation-pty-probe status=FAIL reason=missing-pass status_path=$status_path log_path=$log_path host_log=$host_log_path host_status=$host_status_path log=[evidence_quote $log_text]"
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-activation-pty-probe-missing-pass"
    }

    set total_ms "missing"
    set configure_ms "missing"
    set frame_done_ms "missing"
    set buffer_release_ms "missing"
    set pty_open_ms "missing"
    set qdbus_socket_events "missing"
    set qdbus_eventfd_events "missing"
    set qdbus_read_bytes "missing"
    set qdbus_prepty_ms "missing"
    foreach {key var_name} {
        total_ms total_ms
        configure_ms configure_ms
        frame_done_ms frame_done_ms
        buffer_release_ms buffer_release_ms
        pty_open_ms pty_open_ms
        qdbus_socket_events qdbus_socket_events
        qdbus_eventfd_events qdbus_eventfd_events
        qdbus_read_bytes qdbus_read_bytes
        qdbus_prepty_ms qdbus_prepty_ms
    } {
        if {[regexp [format {%s=([-0-9]+)} $key] $result_line -> value]} {
            set $var_name $value
        }
    }
    foreach {field value} [list \
        total_ms $total_ms \
        configure_ms $configure_ms \
        pty_open_ms $pty_open_ms \
        qdbus_socket_events $qdbus_socket_events \
        qdbus_eventfd_events $qdbus_eventfd_events \
        qdbus_read_bytes $qdbus_read_bytes \
        qdbus_prepty_ms $qdbus_prepty_ms] {
        if {![string is integer -strict $value] || $value <= 0} {
            desktop_interaction_log_line "phase=activation-pty action=kde-wayland-activation-pty-probe status=FAIL reason=weak-field field=$field value=$value result=[evidence_quote $result_line] status_path=$status_path log_path=$log_path host_log=$host_log_path host_status=$host_status_path log=[evidence_quote $log_text]"
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-activation-pty-probe-weak-$field"
        }
    }
    set have_frame_or_release 0
    foreach value [list $frame_done_ms $buffer_release_ms] {
        if {[string is integer -strict $value] && $value > 0} {
            set have_frame_or_release 1
        }
    }
    if {!$have_frame_or_release} {
        desktop_interaction_log_line "phase=activation-pty action=kde-wayland-activation-pty-probe status=FAIL reason=missing-frame-or-release frame_done_ms=$frame_done_ms buffer_release_ms=$buffer_release_ms result=[evidence_quote $result_line] status_path=$status_path log_path=$log_path host_log=$host_log_path host_status=$host_status_path log=[evidence_quote $log_text]"
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-activation-pty-probe-missing-frame"
    }
    foreach raw_line [split $log_text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {kde_wayland_activation_pty_probe phase=(registry-roundtrip|globals|empty-commit|toplevel-configure|xdg-configure|configure-wait|buffer-commit|frame-wait|qdbus-prepty|pty-open|qdbus-sidecar-summary|result)[^\r\n]*} $line match]} {
            desktop_interaction_log_line "phase=activation-pty-detail action=kde-wayland-activation-pty-probe detail=[evidence_quote [string map {"\t" " " "\r" "" "\n" " "} $match]]"
        }
    }
    desktop_interaction_log_line "phase=activation-pty action=kde-wayland-activation-pty-probe status=PASS elapsed_ms=[expr {[clock milliseconds] - $start_ms}] helper_elapsed_ms=$helper_elapsed_ms probe_rc=$probe_rc total_ms=$total_ms configure_ms=$configure_ms frame_done_ms=$frame_done_ms buffer_release_ms=$buffer_release_ms pty_open_ms=$pty_open_ms qdbus_socket_events=$qdbus_socket_events qdbus_eventfd_events=$qdbus_eventfd_events qdbus_read_bytes=$qdbus_read_bytes qdbus_prepty_ms=$qdbus_prepty_ms status_path=$status_path log_path=$log_path host_log=$host_log_path host_status=$host_status_path"
    puts "KDE-PLASMA-DESKTOP-SMOKE-INFO interaction phase=activation-pty action=kde-wayland-activation-pty-probe status=PASS elapsed_ms=[expr {[clock milliseconds] - $start_ms}]"
}

proc run_desktop_interaction_latency_reducer {} {
    global guest_before_ppm guest_after_ppm
    global guest_taskbar_settled_before_hover_ppm
    global guest_direct_launch_before_ppm guest_direct_launch_after_ppm
    global host_taskbar_settled_before_hover_png host_direct_launch_after_png
    global kde_interaction_input_source kde_interaction_cursor_owner
    global kde_interaction_diagnostic_input
    global kde_interaction_monitor_path

    set hover_timeout_ms [env_int_range KDE_SMOKE_INTERACTION_HOVER_TIMEOUT_MS 2500 100 30000]
    set tray_timeout_ms [env_int_range KDE_SMOKE_INTERACTION_TRAY_TIMEOUT_MS 5000 100 30000]
    set menu_timeout_ms [env_int_range KDE_SMOKE_INTERACTION_MENU_TIMEOUT_MS $tray_timeout_ms 100 30000]
    set interval_ms [env_int_range KDE_SMOKE_INTERACTION_SAMPLE_INTERVAL_MS 100 20 5000]
    set tray_x [env_int_range KDE_SMOKE_INTERACTION_TRAY_X 60000 0 65535]
    set tray_y [env_int_range KDE_SMOKE_INTERACTION_TRAY_Y 64400 0 65535]
    set launcher_x [env_int_range KDE_SMOKE_INTERACTION_LAUNCHER_X 1200 0 65535]
    set launcher_y [env_int_range KDE_SMOKE_INTERACTION_LAUNCHER_Y 64200 0 65535]
    set close_x [env_int_range KDE_SMOKE_INTERACTION_CLOSE_X $tray_x 0 65535]
    set close_y [env_int_range KDE_SMOKE_INTERACTION_CLOSE_Y $tray_y 0 65535]
    set visible_min_nonblack [env_int_range KDE_SMOKE_INTERACTION_VISIBLE_MIN_NONBLACK 1 1 1000000]
    set visible_attempts [env_int_range KDE_SMOKE_INTERACTION_VISIBLE_ATTEMPTS 120 1 600]
    set visible_interval_ms [env_int_range KDE_SMOKE_INTERACTION_VISIBLE_INTERVAL_MS 500 50 5000]
    set taskbar_settle_wait_ms [env_int_range KDE_SMOKE_TASKBAR_SETTLE_WAIT_MS 3000 0 30000]
    set taskbar_settle_attempts [env_int_range KDE_SMOKE_TASKBAR_SETTLE_ATTEMPTS 30 1 120]
    set taskbar_settle_interval_ms [env_int_range KDE_SMOKE_TASKBAR_SETTLE_INTERVAL_MS 500 50 5000]
    set taskbar_settle_stable_samples [env_int_range KDE_SMOKE_TASKBAR_SETTLE_STABLE_SAMPLES 3 2 10]
    set direct_launch_capture_settle_ms [env_int_range KDE_SMOKE_DIRECT_LAUNCH_CAPTURE_SETTLE_MS 5000 0 30000]
    set direct_launch_repeats [expr {[info exists ::env(KDE_SMOKE_DIRECT_LAUNCH_REPEATS)] ? $::env(KDE_SMOKE_DIRECT_LAUNCH_REPEATS) : "1"}]
    if {![string is integer -strict $direct_launch_repeats] ||
        $direct_launch_repeats < 1} {
        set direct_launch_repeats 1
    }
    if {$direct_launch_repeats > 3} {
        set direct_launch_repeats 3
    }
    set direct_launch_repeat_delay_ms [env_int_range KDE_SMOKE_DIRECT_LAUNCH_REPEAT_DELAY_MS 1500 0 600000]
    set profiled_hover_enabled [expr {[desktop_interaction_kprofile_enabled] && [env_bool KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER 0]}]
    set profiled_hover_label "taskbar-left-icons"
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_LABEL)] &&
        [regexp {^[A-Za-z0-9_.-]+$} $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_LABEL)]} {
        set profiled_hover_label $::env(KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_LABEL)
    }
    set profiled_hover_x [env_int_range KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_X 11000 0 65535]
    set profiled_hover_y [env_int_range KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_Y 64200 0 65535]
    set kprofile_userpc [env_bool KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC 0]
    set kprofile_vfs_enoent_attr [env_bool KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR 0]
    set kprofile_userpc_period [env_int_range KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD "missing" 1 2147483647]
    set kprofile_userpc_limit [env_int_range KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT "missing" 0 2147483647]
    set legacy_sweep_default [expr {$profiled_hover_enabled ? 0 : 1}]
    set legacy_sweep_enabled \
        [env_bool KDE_SMOKE_INTERACTION_LEGACY_SWEEP $legacy_sweep_default]
    set direct_launch_only [env_bool KDE_SMOKE_INTERACTION_DIRECT_LAUNCH_ONLY 0]
    set activation_pty_enabled [env_bool KDE_SMOKE_INTERACTION_ACTIVATION_PTY_PROBE 0]
    set activation_pty_first [expr {$activation_pty_enabled && [env_bool KDE_SMOKE_INTERACTION_ACTIVATION_PTY_FIRST 0]}]
    set input_source $kde_interaction_input_source
    set qemu_gtk_cursor_mode "default"
    set qemu_gtk_show_cursor "default"
    if {[info exists ::env(QEMU_GTK_CURSOR_MODE)]} {
        set qemu_gtk_cursor_mode $::env(QEMU_GTK_CURSOR_MODE)
    }
    if {[info exists ::env(QEMU_GTK_SHOW_CURSOR)]} {
        set qemu_gtk_show_cursor $::env(QEMU_GTK_SHOW_CURSOR)
    }

    desktop_interaction_log_line "phase=meta reducer=desktop-interaction-latency hover_timeout_ms=$hover_timeout_ms tray_timeout_ms=$tray_timeout_ms menu_timeout_ms=$menu_timeout_ms interval_ms=$interval_ms tray_x=$tray_x tray_y=$tray_y launcher_x=$launcher_x launcher_y=$launcher_y close_x=$close_x close_y=$close_y visible_min_nonblack=$visible_min_nonblack visible_attempts=$visible_attempts visible_interval_ms=$visible_interval_ms taskbar_settle_wait_ms=$taskbar_settle_wait_ms taskbar_settle_attempts=$taskbar_settle_attempts taskbar_settle_interval_ms=$taskbar_settle_interval_ms taskbar_settle_stable_samples=$taskbar_settle_stable_samples profiled_hover_enabled=$profiled_hover_enabled profiled_hover_label=$profiled_hover_label profiled_hover_x=$profiled_hover_x profiled_hover_y=$profiled_hover_y kprofile_userpc=$kprofile_userpc kprofile_vfs_enoent_attr=$kprofile_vfs_enoent_attr kprofile_userpc_period=$kprofile_userpc_period kprofile_userpc_limit=$kprofile_userpc_limit legacy_sweep_enabled=$legacy_sweep_enabled direct_launch_only=$direct_launch_only direct_launch_capture_settle_ms=$direct_launch_capture_settle_ms direct_launch_repeats=$direct_launch_repeats direct_launch_repeat_delay_ms=$direct_launch_repeat_delay_ms active_sample=[desktop_interaction_active_sample_enabled] activation_pty_enabled=$activation_pty_enabled activation_pty_first=$activation_pty_first input_source=$input_source diagnostic_input=$kde_interaction_diagnostic_input cursor_owner=$kde_interaction_cursor_owner qemu_gtk_cursor_mode=$qemu_gtk_cursor_mode qemu_gtk_show_cursor=$qemu_gtk_show_cursor [desktop_interaction_guest_input_policy_fields]"
    if {$activation_pty_first} {
        measure_wayland_activation_pty_probe
        if {[env_bool KDE_SMOKE_INTERACTION_ACTIVATION_PTY_ONLY 0]} {
            finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=desktop-interaction-latency activation-pty-only"
        }
    }
    measure_first_visible_frame "desktop-interaction-visible" $visible_min_nonblack $visible_attempts $visible_interval_ms
    wait_for_taskbar_settled_before_hover $visible_min_nonblack \
        $taskbar_settle_attempts $taskbar_settle_interval_ms \
        $taskbar_settle_wait_ms $taskbar_settle_stable_samples
    enforce_desktop_interaction_guest_input_policy "after-taskbar-settle"
    if {[env_bool KDE_SMOKE_HOVERPROBE 0]} {
        run_hoverprobe_instrument $profiled_hover_x $profiled_hover_y
        if {[env_bool KDE_SMOKE_HOVERPROBE_ONLY 0]} {
            finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=desktop-interaction-latency hoverprobe-only"
        }
    }
    capture_fb $guest_taskbar_settled_before_hover_ppm \
        "taskbar-settled-before-hover"
    host_screenshot "taskbar-settled-before-hover" \
        $host_taskbar_settled_before_hover_png
    capture_fb $guest_before_ppm "desktop-interaction-before"
    if {$direct_launch_only} {
        desktop_interaction_log_line "phase=direct-launch-only action=preconditions-complete reason=direct_launch_only status=PASS direct_launch_repeats=$direct_launch_repeats direct_launch_repeat_delay_ms=$direct_launch_repeat_delay_ms [desktop_interaction_guest_input_policy_fields]"
        capture_fb $guest_direct_launch_before_ppm "direct-launch-before"
        measure_direct_app_launch_repeats \
            $direct_launch_repeats $direct_launch_repeat_delay_ms
        if {$direct_launch_capture_settle_ms > 0} {
            after $direct_launch_capture_settle_ms
        }
        capture_fb $guest_direct_launch_after_ppm "direct-launch-after"
        host_screenshot "direct-launch-after" $host_direct_launch_after_png
        finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=desktop-interaction-latency direct-launch-only"
    }
    if {$profiled_hover_enabled} {
        measure_profiled_visual_hover $profiled_hover_label \
            $profiled_hover_x $profiled_hover_y $hover_timeout_ms $interval_ms
    } else {
        desktop_interaction_log_line "phase=profiled-hover action=$profiled_hover_label status=SKIP reason=disabled x=$profiled_hover_x y=$profiled_hover_y"
    }

    if {$legacy_sweep_enabled} {
        set hover_points {
            chromium 3000 3300
            dolphin 8900 3300
            kwrite 14850 3300
            konsole 20800 3300
        }
        foreach {name x y} $hover_points {
            measure_visual_action hover $name $x $y "move $x $y" $hover_timeout_ms $interval_ms
        }

        set panel_hover_points [list \
            launcher $launcher_x $launcher_y \
            terminal 3100 $launcher_y \
            settings 5000 $launcher_y \
            dolphin 7100 $launcher_y \
            konsole 9000 $launcher_y \
            chromium 11000 $launcher_y \
        ]
        foreach {name x y} $panel_hover_points {
            measure_visual_action panel-hover $name $x $y "move $x $y" $hover_timeout_ms $interval_ms
        }

        measure_visual_action start-menu open $launcher_x $launcher_y "click $launcher_x $launcher_y" $menu_timeout_ms $interval_ms
        after 500
        measure_visual_action start-menu close $launcher_x $launcher_y "key esc" $menu_timeout_ms $interval_ms

        measure_visual_action tray open $tray_x $tray_y "click $tray_x $tray_y" $tray_timeout_ms $interval_ms
        after 500
        measure_visual_action tray close $close_x $close_y "key esc" $tray_timeout_ms $interval_ms
    } else {
        desktop_interaction_log_line "phase=legacy-interaction-sweep status=SKIP reason=profiled-hover-focused-run profiled_hover_enabled=$profiled_hover_enabled"
    }

    capture_fb $guest_after_ppm "desktop-interaction-after"
    if {$activation_pty_enabled && !$activation_pty_first} {
        measure_wayland_activation_pty_probe
    }
    capture_fb $guest_direct_launch_before_ppm "direct-launch-before"
    measure_direct_app_launch_repeats \
        $direct_launch_repeats $direct_launch_repeat_delay_ms
    if {$direct_launch_capture_settle_ms > 0} {
        after $direct_launch_capture_settle_ms
    }
    capture_fb $guest_direct_launch_after_ppm "direct-launch-after"
    host_screenshot "direct-launch-after" $host_direct_launch_after_png
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=desktop-interaction-latency"
}

proc click_abs {x y done_label fail_label} {
    global kde_interaction_monitor_path

    set target [bound_guest_pointer_target $x $y]
    set fields [guest_pointer_target_fields $target guest]
    set x [lindex $target 2]
    set y [lindex $target 3]
    run_interaction_command $fail_label "/bin/mouseinject $x $y 0; /bin/mouseinject $x $y 1; /bin/mouseinject $x $y 0"
    set host_cursor_sync_ms [sync_host_cursor_to_guest $x $y]
    desktop_interaction_log_line "phase=legacy-click action=$fail_label status=PASS $fields host_cursor_sync_ms=$host_cursor_sync_ms [desktop_interaction_guest_input_policy_fields]"
    puts "KDE-PLASMA-DESKTOP-SMOKE-INFO click label=$done_label status=PASS x=$x y=$y input_source=guest bounded_x=$x bounded_y=$y"
}

proc double_click_abs {x y done_prefix fail_label} {
    global timeout
    global kde_interaction_monitor_path

    set target [bound_guest_pointer_target $x $y]
    set fields [guest_pointer_target_fields $target guest]
    set x [lindex $target 2]
    set y [lindex $target 3]
    set old_timeout $timeout
    sync_prompt
    set timeout 20
    set done_label "${done_prefix}_DONE"
    send "/bin/mouseinject dblclick $x $y 250000; echo $done_label\r"
    expect {
        -re $done_label {
            set timeout $old_timeout
        }
        -re {mouseinject: (open|write) [^\r\n]*failed} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $fail_label-click-failed"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $fail_label-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $fail_label-click-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $fail_label-click-eof" }
    }
    set timeout $old_timeout
    optional_prompt
    set host_cursor_sync_ms [sync_host_cursor_to_guest $x $y]
    desktop_interaction_log_line "phase=legacy-double-click action=$fail_label status=PASS $fields host_cursor_sync_ms=$host_cursor_sync_ms [desktop_interaction_guest_input_policy_fields]"
    sleep 5
}

proc click_desktop_app_icons {} {
    global chromium_available

    # Seeded KDE desktop icons in a 1280x800 guest. Coordinates are xv6
    # absolute mouse coordinates, not pixels. The current desktop:/ KIO
    # activation path is tracked as a gap; these clicks still prove pointer
    # targeting and selection on each KDE launcher.
    if {$chromium_available} {
        run_guest_check [chromium_guest_artifact_clear_command] "kde-chromium-artifact-clear" 10
    }
    click_abs 3000 3300 "KDE_DESKTOP_CHROMIUM_DONE" "desktop-chromium"
    click_abs 8900 3300 "KDE_DESKTOP_DOLPHIN_DONE" "desktop-dolphin"
    click_abs 14850 3300 "KDE_DESKTOP_KWRITE_DONE" "desktop-kwrite"
    click_abs 20800 3300 "KDE_DESKTOP_KONSOLE_DONE" "desktop-konsole"
}

proc try_clicked_desktop_process_probe {} {
    global timeout chromium_available

    set old_timeout $timeout
    sync_prompt
    set timeout 45
    set args "--require-apps --require-audio"
    if {$chromium_available} {
        append args " --require-chromium"
    }
    send [format {KDE_PROCESS_PROBE_TRACE=1 /bin/kde-process-probe %s; echo kde-clicked-apps-process-probe_STATUS:$?} $args]
    send "\r"
    expect {
        -re {kde_process_probe[^\r\n]*status=PASS} {
            set timeout $old_timeout
            optional_prompt
            return 1
        }
        -re {kde_process_probe[^\r\n]*status=WAIT} {
            puts "KDE-PLASMA-DESKTOP-SMOKE-WARN desktop-click-activation-did-not-launch-apps"
            set timeout $old_timeout
            optional_prompt
            return 0
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-clicked-apps-process-probe-crash"
        }
        timeout {
            puts "KDE-PLASMA-DESKTOP-SMOKE-WARN desktop-click-activation-process-probe-timeout"
            set timeout $old_timeout
            optional_prompt
            return 0
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-clicked-apps-process-probe-eof" }
    }
    set timeout $old_timeout
    optional_prompt
    return 0
}

proc run_direct_app_launch_probe {} {
    global chromium_available

    if {$chromium_available} {
        run_guest_check "[chromium_guest_artifact_clear_command]; /bin/kde-app-launch-probe --require-chromium" "kde-app-launch-probe" 120
    } else {
        run_guest_check "/bin/kde-app-launch-probe" "kde-app-launch-probe" 90
    }
}

if {[kde_smoke_reducer] eq "chromium-video"} {
    chromium_video_select_url
    stage_chromium_video_clear_script
    stage_chromium_video_launch_script
    stage_chromium_video_sampler_script
    stage_chromium_video_sampler_status_script
    stage_chromium_video_capture_script
    stage_chromium_video_capture_status_script
    stage_chromium_video_egl_gbm_script
    stage_chromium_video_rela_preprobe_script
}

if {[kde_smoke_reducer] eq "chromium-video" ||
    [kde_smoke_reducer] eq "kde-wayland-registry" ||
    [kde_smoke_reducer] eq "kde-wayland-liveness" ||
    [kde_smoke_reducer] eq "kde-wayland-client-liveness"} {
    stage_session_liveness_script
}
if {[kde_smoke_reducer] eq "kde-wayland-client-liveness"} {
    stage_wayland_client_liveness_script
}
if {[kde_smoke_reducer] eq "chromium-video" ||
    [kde_smoke_reducer] eq "kde-wayland-registry" ||
    [kde_smoke_reducer] eq "kde-wayland-liveness" ||
    [kde_smoke_reducer] eq "kde-wayland-client-liveness"} {
    stage_wayland_registry_probe_script
}

if {[kde_smoke_reducer] eq "desktop-interaction" ||
    [kde_smoke_reducer] eq "desktop-interaction-latency" ||
    [kde_smoke_reducer] eq "desktop-color-wakeup"} {
    stage_desktop_interaction_helper_script
    if {$kde_interaction_host_cursor_sync} {
        stage_host_cursor_sync_script
    }
}

stage_kwin_loader_ifunc_script
stage_qtqml_ifunc_script
if {$kde_preflight_enabled &&
    ([kde_smoke_reducer] eq "" ||
     [kde_smoke_reducer] eq "chromium-video" ||
     [kde_smoke_reducer] eq "kde-wayland-registry" ||
     [kde_smoke_reducer] eq "kde-wayland-liveness" ||
     [kde_smoke_reducer] eq "kde-wayland-client-liveness")} {
    stage_kde_preflight_runner_script
} elseif {!$kde_preflight_enabled} {
    puts "KDE-PLASMA-DESKTOP-SMOKE-WARN kde-preflight-runner-stage-skipped preflight=disabled"
}

log_file -a $runlog
file delete -force $qemu_owned_pidfile
set env(QEMU_RUN_TOKEN) $qemu_owned_token
set env(QEMU_PIDFILE) $qemu_owned_pidfile
spawn timeout --foreground $qemu_timeout setsid bash scripts/launch/run-qemu.sh x86_64 $kernel $tmpimg
set qemu_pid [exp_pid]

expect {
    -re {FB: registered /dev/fb0 \(virtio-gpu direct 1280x800x32} {}
    -re {PANIC|fatal page fault|spin_lock reentry} {
        finish_after_crash 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL early-crash"
    }
    timeout { finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL no-fb0" }
    eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL early-eof" }
}

expect {
    -re {xv6-desktop-session: selected desktop=kde} {}
    -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|exec failed|not found|status=127} {
        finish_after_crash 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL launch-crash"
    }
    timeout { finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL no-desktop-dispatch" }
    eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL dispatch-eof" }
}

expect {
    -re {kde-session: starting KDE Plasma desktop} {}
    -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|exec failed|not found|status=127} {
        finish_after_crash 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL session-crash"
    }
    timeout { finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL no-kde-session" }
    eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL session-eof" }
}

if {[kde_smoke_reducer] eq "pre-kwin-libinput"} {
    wait_for_pre_kwin_libinput_probe_only
}

if {[kde_smoke_reducer] eq "x11-egl"} {
    wait_for_kde_session_ready
    set x11_egl_session_result [wait_for_x11_egl_session_probe_terminal]
    set x11_egl_session_status [lindex $x11_egl_session_result 0]
    set x11_egl_session_exit_status [lindex $x11_egl_session_result 1]
    if {$x11_egl_session_status eq "PASS" && $x11_egl_session_exit_status eq "0"} {
        finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=x11-egl session_probe=PASS"
    }
    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-session-probe-$x11_egl_session_status exit_status=$x11_egl_session_exit_status"
}

if {[kde_smoke_reducer] eq "x11-dri3"} {
    wait_for_kde_session_ready
    run_kde_x11_dri3_probe
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=x11-dri3"
}

if {[kde_smoke_reducer] eq "x11-glx-fps"} {
    wait_for_kde_session_ready
    run_kde_x11_glx_fps_session_probe
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=x11-glx-fps session_probe=PASS"
}

if {[kde_smoke_reducer] eq "x11-present-fps"} {
    wait_for_kde_session_ready
    run_kde_x11_present_fps_session_probe
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=x11-present-fps session_probe=PASS"
}

if {[kde_smoke_reducer] eq "sparse-mmap-mprotect"} {
    set sparse_gb [expr {[info exists env(KDE_SMOKE_SPARSE_MMAP_GB)] ? $env(KDE_SMOKE_SPARSE_MMAP_GB) : "16"}]
    if {![string is integer -strict $sparse_gb] || $sparse_gb <= 0} {
        set sparse_gb 16
    }
    if {$sparse_gb > 2048} {
        set sparse_gb 2048
    }
    optional_prompt
    run_guest_check "/bin/kde-thread-group-stop-probe --sparse-mmap-mprotect $sparse_gb" "kde-sparse-mmap-mprotect-probe" 120
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=sparse-mmap-mprotect gb=$sparse_gb"
}

if {[kde_smoke_reducer] eq "desktop-color-wakeup"} {
    set initial_delay_ms [expr {[info exists env(KDE_SMOKE_DESKTOP_COLOR_INITIAL_DELAY_MS)] ? $env(KDE_SMOKE_DESKTOP_COLOR_INITIAL_DELAY_MS) : "1500"}]
    set after_click_delay_ms [expr {[info exists env(KDE_SMOKE_DESKTOP_COLOR_AFTER_CLICK_DELAY_MS)] ? $env(KDE_SMOKE_DESKTOP_COLOR_AFTER_CLICK_DELAY_MS) : "2000"}]
    if {![string is integer -strict $initial_delay_ms] || $initial_delay_ms < 0} {
        set initial_delay_ms 1500
    }
    if {$initial_delay_ms > 30000} {
        set initial_delay_ms 30000
    }
    if {![string is integer -strict $after_click_delay_ms] || $after_click_delay_ms < 0} {
        set after_click_delay_ms 2000
    }
    if {$after_click_delay_ms > 30000} {
        set after_click_delay_ms 30000
    }

    wait_for_kde_session_ready
    if {![env_bool KDE_SMOKE_DESKTOP_COLOR_SKIP_VISIBLE_WAIT 0]} {
        wait_for_nonblack_frame "desktop-color-visible" 1000 30 500
    }
    after $initial_delay_ms
    capture_fb $guest_before_ppm "desktop-color-before-click"
    run_desktop_interaction_action "desktop-color-wakeup-click" "click 32768 32768"
    puts "KDE-PLASMA-DESKTOP-SMOKE-INFO click label=KDE_DESKTOP_COLOR_WAKEUP_CLICK_DONE status=PASS x=32768 y=32768"
    after $after_click_delay_ms
    capture_fb $guest_after_ppm "desktop-color-after-click"
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=desktop-color-wakeup initial_delay_ms=$initial_delay_ms after_click_delay_ms=$after_click_delay_ms"
}

if {[kde_smoke_reducer] eq "kwin-screenshot"} {
    set settle_ms [expr {[info exists env(KDE_SMOKE_KWIN_SCREENSHOT_SETTLE_MS)] ? $env(KDE_SMOKE_KWIN_SCREENSHOT_SETTLE_MS) : "8000"}]
    if {![string is integer -strict $settle_ms] || $settle_ms < 0} {
        set settle_ms 8000
    }
    if {$settle_ms > 30000} {
        set settle_ms 30000
    }

    wait_for_kde_session_ready
    after $settle_ms
    host_screenshot "kwin-screenshot" $host_final_png
    if {[run_kwin_screenshot_probe]} {
        finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=kwin-screenshot settle_ms=$settle_ms"
    }
    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kwin-screenshot-probe-low-color settle_ms=$settle_ms"
}

if {[kde_smoke_reducer] eq "kde-ready"} {
    wait_for_kde_session_ready
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=kde-ready"
}

if {[kde_smoke_reducer] eq "kde-wayland-registry"} {
    wait_for_kde_session_ready
    run_kwin_loader_ifunc_check
    run_qtqml_ifunc_startup_check
    run_session_liveness_probe "kde-wayland-registry-liveness"
    run_wayland_registry_probe "kde-wayland-registry-probe"
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=kde-wayland-registry"
}

if {[kde_smoke_reducer] eq "kde-wayland-liveness"} {
    wait_for_kde_session_ready
    run_kwin_loader_ifunc_check
    run_qtqml_ifunc_startup_check
    run_session_liveness_probe "kde-wayland-liveness-roundtrip"
    run_wayland_registry_probe "kde-wayland-liveness-registry"
    run_wayland_seat_probe
    sleep 5
    run_session_liveness_probe "kde-wayland-liveness-late-roundtrip"
    run_wayland_registry_probe "kde-wayland-liveness-late-registry"
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=kde-wayland-liveness"
}

if {[kde_smoke_reducer] eq "kde-wayland-client-liveness"} {
    wait_for_kde_session_ready
    run_kwin_loader_ifunc_check
    run_qtqml_ifunc_startup_check
    run_kde_wayland_client_liveness_reducer
}

if {[kde_smoke_reducer] eq "desktop-interaction-latency"} {
    wait_for_kde_session_ready
    run_desktop_interaction_latency_reducer
}

if {[kde_smoke_reducer] eq "chromium-video"} {
    wait_for_kde_session_ready
    run_kwin_loader_ifunc_check
    run_qtqml_ifunc_startup_check
    run_chromium_video_reducer
}

if {![legacy_serial_validation_enabled] && [guest_smoke_agent_enabled]} {
    wait_for_kde_session_ready
    if {[kde_smoke_reducer] eq ""} {
        run_kwin_loader_ifunc_check
        run_qtqml_ifunc_startup_check
    }
    sleep 10
    host_screenshot "startup" $host_startup_png
    wait_for_guest_smoke_agent
    capture_fb $guest_final_ppm "final-agent"
} else {
    if {![guest_smoke_agent_enabled] && ![legacy_serial_validation_enabled]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-WARN guest-agent-disabled-using-legacy-serial-validation"
    }
    optional_prompt
    wait_for_kde_session_ready
    sleep 45
    optional_prompt
    wait_for_roles "no-kwin" 0 0 90 1
    wait_for_roles "no-plasmashell" 1 0 180 1
    sleep 15
    capture_fb $guest_before_ppm "post-startup"
    host_screenshot "startup" $host_startup_png
    run_guest_check "KDE_PROCESS_PROBE_TRACE=1 /bin/kde-process-probe --require-audio" "kde-audio-process-probe" 20
    capture_fb $guest_before_ppm "input-before-desktop-icons"
    host_screenshot "input-before" $host_input_before_png
    click_desktop_app_icons
    sleep 35
    capture_fb $guest_after_ppm "input-after-desktop-icons"
    host_screenshot "input-after" $host_input_after_png
    set clicked_apps_launched [try_clicked_desktop_process_probe]
    if {!$clicked_apps_launched} {
        run_direct_app_launch_probe
    }
    run_optional_direct_app_launch_probe
    run_kde_x11_egl_probe
    sleep 10
    run_guest_check "KDE_PROCESS_PROBE_TRACE=1 /bin/kde-process-probe --require-apps --require-audio" "kde-apps-process-probe" 20
    run_probe_suite
    run_late_kde_guardrails
    capture_fb $guest_final_ppm "final-legacy"
}
finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE"
