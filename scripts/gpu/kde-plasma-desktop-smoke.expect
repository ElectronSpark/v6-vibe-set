    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD=\$KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT=\$KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT\""
    puts $fh {      echo "kprofile_config enabled=$KDE_APP_LAUNCH_PROBE_KPROFILE userpc=$KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC vfs_enoent_attr=$KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR timeout_ms=$KDE_APP_LAUNCH_PROBE_KPROFILE_TIMEOUT_MS"}
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_SEMANTIC_CAPTURE=\$KDE_APP_LAUNCH_PROBE_SEMANTIC_CAPTURE\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_WAYLAND_DEBUG=\$KDE_APP_LAUNCH_PROBE_WAYLAND_DEBUG\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_WAYLAND_EVENT_TRACE=\$KDE_APP_LAUNCH_PROBE_KONSOLE_WAYLAND_EVENT_TRACE\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE=\$KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_QT_BRIDGE_TRACE=\$KDE_APP_LAUNCH_PROBE_KONSOLE_QT_BRIDGE_TRACE\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_MIN_MS=\$KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_MIN_MS\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_LIMIT=\$KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_LIMIT\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE=\$KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_MIN_MS=\$KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_MIN_MS\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_LIMIT=\$KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_LIMIT\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_KONSOLE_LOADER_TRACE=\$KDE_APP_LAUNCH_PROBE_KONSOLE_LOADER_TRACE\""
    puts $fh "      echo \"KONSOLE_LOADER_TRACE_LIMIT=\$KONSOLE_LOADER_TRACE_LIMIT\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB=\$KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_QTMM_STUB=\$KDE_APP_LAUNCH_PROBE_QTMM_STUB\""
    puts $fh "      echo \"KDE_APP_LAUNCH_PROBE_QT_MINIMAL_IMAGEFORMATS=\$KDE_APP_LAUNCH_PROBE_QT_MINIMAL_IMAGEFORMATS\""
    puts $fh {      echo "KDE_SMOKE_DIRECT_LAUNCH_INDEX=$KDE_SMOKE_DIRECT_LAUNCH_INDEX"}
    puts $fh {      echo "KDE_SMOKE_DIRECT_LAUNCH_TEMPERATURE=$KDE_SMOKE_DIRECT_LAUNCH_TEMPERATURE"}
    puts $fh {      echo "KDE_SMOKE_DIRECT_LAUNCH_REPEAT_COUNT=$KDE_SMOKE_DIRECT_LAUNCH_REPEAT_COUNT"}
    puts $fh {      echo "KDE_SMOKE_DIRECT_LAUNCH_REPEAT_DELAY_MS=$KDE_SMOKE_DIRECT_LAUNCH_REPEAT_DELAY_MS"}
    puts $fh "      export KDE_APP_LAUNCH_PROBE_INTERLAUNCH_DELAY_MS KDE_APP_LAUNCH_PROBE_KONSOLE_WAIT_SAMPLE_MS KDE_APP_LAUNCH_PROBE_KONSOLE_ONLY KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT KDE_APP_LAUNCH_PROBE_KONSOLE_SNAPSHOT_MS"
    puts $fh "      export KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_LABEL KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_X KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_Y KDE_APP_LAUNCH_PROBE_KPROFILE_TIMEOUT_MS"
    puts $fh "      export KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT"
    puts $fh "      export KDE_APP_LAUNCH_PROBE_KONSOLE_WAYLAND_EVENT_TRACE KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE KDE_APP_LAUNCH_PROBE_KONSOLE_QT_BRIDGE_TRACE KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_MIN_MS KDE_APP_LAUNCH_PROBE_KONSOLE_QT_EVENT_TRACE_LIMIT"
    puts $fh "      export KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_MIN_MS KDE_APP_LAUNCH_PROBE_KONSOLE_QT_CPP_TRACE_LIMIT"
    puts $fh "      export KDE_APP_LAUNCH_PROBE_KONSOLE_LOADER_TRACE KONSOLE_LOADER_TRACE_LIMIT"
    puts $fh "      export KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB"
    puts $fh "      export KDE_APP_LAUNCH_PROBE_QTMM_STUB"
    puts $fh "      export KDE_APP_LAUNCH_PROBE_QT_MINIMAL_IMAGEFORMATS"
    puts $fh {      export KDE_SMOKE_DIRECT_LAUNCH_INDEX KDE_SMOKE_DIRECT_LAUNCH_TEMPERATURE KDE_SMOKE_DIRECT_LAUNCH_REPEAT_COUNT KDE_SMOKE_DIRECT_LAUNCH_REPEAT_DELAY_MS}
    puts $fh {      qtmm_full_maps_log="/kde-interaction-${kind}-${serial}-${label}.konsole-full-maps.log"}
    puts $fh {      qtmm_final_call_log="/kde-interaction-${kind}-${serial}-${label}.qtmm-final-call-log.txt"}
    puts $fh {      /bin/rm -f "$qtmm_full_maps_log" "$qtmm_final_call_log"}
    puts $fh {      export KDE_INTERACTION_DIRECT_LAUNCH_FULL_MAPS_LOG="$qtmm_full_maps_log"}
    puts $fh {      export KDE_INTERACTION_DIRECT_LAUNCH_QTMM_FINAL_CALL_LOG="$qtmm_final_call_log"}
    puts $fh {      echo "KDE_INTERACTION_DIRECT_LAUNCH_FULL_MAPS_LOG=$KDE_INTERACTION_DIRECT_LAUNCH_FULL_MAPS_LOG"}
    puts $fh {      echo "KDE_INTERACTION_DIRECT_LAUNCH_QTMM_FINAL_CALL_LOG=$KDE_INTERACTION_DIRECT_LAUNCH_QTMM_FINAL_CALL_LOG"}
    puts $fh {      /bin/rm -f /xv6-konsole-phase.log}
    puts $fh {      semantic_pids=""}
    puts $fh {      semantic_logs=""}
    puts $fh {      semantic_pairs=""}
    puts $fh {      if [ "$KDE_APP_LAUNCH_PROBE_SEMANTIC_CAPTURE" = 1 ]; then}
    puts $fh {        export XDG_RUNTIME_DIR=/dev/shm/xdg-runtime-root}
    puts $fh {        export DBUS_SYSTEM_BUS_ADDRESS=unix:abstract=xv6_system_bus}
    puts $fh {        export DBUS_SESSION_BUS_ADDRESS=unix:abstract=xv6_session_bus}
    puts $fh {        export LD_LIBRARY_PATH=/opt/xv6-kde-abi-libs:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu:/usr/lib:/lib}
    puts $fh {        if command -v gdbus >/dev/null 2>&1; then}
    puts $fh {          if gdbus call --session --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus --method org.freedesktop.DBus.ListNames >/dev/null 2>&1; then}
    puts $fh {            echo "kde_interaction_helper semantic-preflight status=PASS method=dbus-list-names"}
    puts $fh {          else}
    puts $fh {            echo "kde_interaction_helper semantic-preflight status=FAIL method=dbus-list-names"}
    puts $fh {          fi}
    puts $fh {        else}
    puts $fh {          echo "kde_interaction_helper semantic-preflight status=missing-gdbus"}
    puts $fh {        fi}
    puts $fh {        for dest in org.kde.klauncher5 org.kde.KWin org.kde.ActivityManager org.freedesktop.DBus; do}
    puts $fh {          safe_dest="${dest//[^A-Za-z0-9_.-]/_}"}
    puts $fh {          mon_log="/kde-interaction-${kind}-${serial}-${label}.dbus-${safe_dest}.log"}
    puts $fh {          rm -f "$mon_log"}
    puts $fh {          if command -v gdbus >/dev/null 2>&1; then}
    puts $fh {            (gdbus monitor --session --dest "$dest" >"$mon_log" 2>&1) &}
    puts $fh {            mon_pid=$!}
    puts $fh {            semantic_pids="$semantic_pids $mon_pid"}
    puts $fh {            semantic_logs="$semantic_logs $mon_log"}
    puts $fh {            semantic_pairs="$semantic_pairs $safe_dest:$mon_log"}
    puts $fh {            echo "kde_interaction_helper semantic-monitor dest=$dest pid=$mon_pid log=$mon_log"}
    puts $fh {          else}
    puts $fh {            echo "kde_interaction_helper semantic-monitor dest=$dest status=missing-gdbus"}
    puts $fh {          fi}
    puts $fh {        done}
    puts $fh {        sleep 1}
    puts $fh {        for pair in $semantic_pairs; do}
    puts $fh {          safe_dest="${pair%%:*}"}
    puts $fh {          mon_log="${pair#*:}"}
    puts $fh {          first_line=""}
    puts $fh {          if [ -r "$mon_log" ]; then}
    puts $fh {            IFS= read -r first_line < "$mon_log" || true}
    puts $fh {          fi}
    puts $fh {          if [ "${first_line#Monitoring signals}" != "$first_line" ]; then}
    puts $fh {            echo "kde_interaction_helper semantic-monitor-ready dest=$safe_dest status=PASS log=$mon_log"}
    puts $fh {          elif [ -s "$mon_log" ]; then}
    puts $fh {            echo "kde_interaction_helper semantic-monitor-ready dest=$safe_dest status=ERROR log=$mon_log"}
    puts $fh {          else}
    puts $fh {            echo "kde_interaction_helper semantic-monitor-ready dest=$safe_dest status=EMPTY log=$mon_log"}
    puts $fh {          fi}
    puts $fh {        done}
    puts $fh {      fi}
    puts $fh {      kprofile_scenario="/dev/shm/kde-app-launch-kprofile-${serial}-${label}.sh"}
    puts $fh {      probe_args=(--konsole-variant "$KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT")}
    puts $fh {      probe_mode=full}
    puts $fh {      probe_apps=konsole,terminal,dolphin,kate,kwrite}
    puts $fh {      if [ "${KDE_APP_LAUNCH_PROBE_KONSOLE_ONLY:-0}" = 1 ]; then}
    puts $fh {        probe_args+=(--konsole-only)}
    puts $fh {        probe_mode=konsole-only}
    puts $fh {        probe_apps=konsole}
    puts $fh {      fi}
    puts $fh {      cat >"$kprofile_scenario" <<'KPROFILE_SCENARIO'}
    puts $fh {#!/bin/bash}
    puts $fh {clamp_abs16_coord() {
  local value="${1:-0}"
  case "$value" in ''|*[!0-9]*) value=0 ;; esac
  if [ "$value" -lt 0 ]; then
    value=0
  elif [ "$value" -gt 65535 ]; then
    value=65535
  fi
  echo "$value"
}
bound_mouse_target() {
  local requested_x="${1:-0}"
  local requested_y="${2:-0}"
  local x y sample screen_w screen_h bounds_source max_x max_y pixel_x pixel_y
  x="$(clamp_abs16_coord "$requested_x")"
  y="$(clamp_abs16_coord "$requested_y")"
  screen_w=1280
  screen_h=800
  bounds_source=default-1280x800
  sample="$(fbstat sample-current 0 0 1280 800 2>/dev/null || true)"
  if [[ "$sample" =~ screen=([0-9]+)x([0-9]+) ]]; then
    screen_w="${BASH_REMATCH[1]}"
    screen_h="${BASH_REMATCH[2]}"
    bounds_source=fbstat-current
  fi
  case "$screen_w" in ''|*[!0-9]*) screen_w=1280 ;; esac
  case "$screen_h" in ''|*[!0-9]*) screen_h=800 ;; esac
  if [ "$screen_w" -le 0 ]; then screen_w=1280; fi
  if [ "$screen_h" -le 0 ]; then screen_h=800; fi
  max_x=$((screen_w - 1))
  max_y=$((screen_h - 1))
  if [ "$max_x" -le 0 ]; then
    pixel_x=0
    BOUND_MOUSE_X=0
  else
    pixel_x=$(((x * max_x + 32767) / 65535))
    if [ "$pixel_x" -lt 0 ]; then pixel_x=0; fi
    if [ "$pixel_x" -gt "$max_x" ]; then pixel_x="$max_x"; fi
    BOUND_MOUSE_X=$(((pixel_x * 65535 + max_x / 2) / max_x))
  fi
  if [ "$max_y" -le 0 ]; then
    pixel_y=0
    BOUND_MOUSE_Y=0
  else
    pixel_y=$(((y * max_y + 32767) / 65535))
    if [ "$pixel_y" -lt 0 ]; then pixel_y=0; fi
    if [ "$pixel_y" -gt "$max_y" ]; then pixel_y="$max_y"; fi
    BOUND_MOUSE_Y=$(((pixel_y * 65535 + max_y / 2) / max_y))
  fi
  BOUND_MOUSE_FIELDS="input_source=guest requested_x=$requested_x requested_y=$requested_y bounded_x=$BOUND_MOUSE_X bounded_y=$BOUND_MOUSE_Y bounded_guest_pixel_x=$pixel_x bounded_guest_pixel_y=$pixel_y bounds_source=$bounds_source framebuffer=${screen_w}x${screen_h} workarea=0,0-${max_x},${max_y} coordinate_space=guest-mouseinject-absolute16 input_policy=guest-only pointer_injection=guest-mouseinject host_cursor_sync_enabled=0 host_cursor_sync=disabled qemu_monitor_input=0 monitor_path=disabled"
}}
    puts $fh {pgrp_of_pid() {
  local stat rest
  stat="$(cat "/proc/$1/stat" 2>/dev/null)" || return 1
  rest="${stat##*) }"
  set -- $rest
  [ -n "${3:-}" ] || return 1
  printf '%s\n' "$3"
}
dump_direct_launch_full_maps() {
  local out own_pgrp d pid pid_pgrp comm cmdline include needle count
  out="${KDE_INTERACTION_DIRECT_LAUNCH_FULL_MAPS_LOG:-/tmp/xv6-konsole-full-maps.log}"
  own_pgrp="$(pgrp_of_pid "$$" 2>/dev/null || true)"
  {
    echo "kde_direct_launch_full_maps phase=post-launch-pre-teardown status=begin launch_index=${KDE_SMOKE_DIRECT_LAUNCH_INDEX:-1} launch_temperature=${KDE_SMOKE_DIRECT_LAUNCH_TEMPERATURE:-cold} pgroup=$own_pgrp"
    for d in /proc/[0-9]*; do
      [ -d "$d" ] || continue
      pid="${d#/proc/}"
      pid_pgrp="$(pgrp_of_pid "$pid" 2>/dev/null || true)"
      comm="$(cat "$d/comm" 2>/dev/null || true)"
      cmdline="$(tr '\0' ' ' <"$d/cmdline" 2>/dev/null || true)"
      include=0
      if [ -n "$own_pgrp" ] && [ "$pid_pgrp" = "$own_pgrp" ]; then
        include=1
      fi
      case "$comm $cmdline" in
        *konsole*|*kde-konsole-shell-wrapper*) include=1 ;;
      esac
      [ "$include" = 1 ] || continue
      echo "kde_direct_launch_full_maps process pid=$pid pgroup=$pid_pgrp comm=\"$comm\" cmd=\"$cmdline\" status_begin"
      cat "$d/status" 2>&1 || true
      echo "kde_direct_launch_full_maps process pid=$pid maps_begin"
      cat "$d/maps" 2>&1 || true
      echo "kde_direct_launch_full_maps process pid=$pid maps_end"
    done
  } >"$out"
  for needle in libQt5Multimedia.so.5 qt5multimedia-shim libpulse.so.0 libpulsecommon pulse; do
    count="$(grep -c "$needle" "$out" 2>/dev/null || true)"
    echo "kde_direct_launch_full_maps summary needle=$needle count=$count" >>"$out"
  done
  echo "kde_direct_launch_full_maps phase=post-launch-pre-teardown status=end pgroup=$own_pgrp" >>"$out"
  echo "kde_direct_launch_full_maps artifact=$out status=DONE pgroup=$own_pgrp"
}}
    puts $fh {probe_args=(--konsole-variant "${KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT:-baseline}")}
    puts $fh {probe_mode=full}
    puts $fh {probe_apps=konsole,terminal,dolphin,kate,kwrite}
    puts $fh {if [ "${KDE_APP_LAUNCH_PROBE_KONSOLE_ONLY:-0}" = 1 ]; then}
    puts $fh {  probe_args+=(--konsole-only)}
    puts $fh {  probe_mode=konsole-only}
    puts $fh {  probe_apps=konsole}
    puts $fh {fi}
    puts $fh {launch_fields="launch_index=${KDE_SMOKE_DIRECT_LAUNCH_INDEX:-1} launch_temperature=${KDE_SMOKE_DIRECT_LAUNCH_TEMPERATURE:-cold} repeat_count=${KDE_SMOKE_DIRECT_LAUNCH_REPEAT_COUNT:-1} repeat_delay_ms=${KDE_SMOKE_DIRECT_LAUNCH_REPEAT_DELAY_MS:-1500}"}
    puts $fh {hover_label="${KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_LABEL:-taskbar-left-icons}"}
    puts $fh {hover_x="${KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_X:-11000}"}
    puts $fh {hover_y="${KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER_Y:-64200}"}
    puts $fh {case "$hover_x" in ''|*[!0-9]*) hover_x=0 ;; esac}
    puts $fh {case "$hover_y" in ''|*[!0-9]*) hover_y=0 ;; esac}
    puts $fh {if [ "$hover_x" -lt 0 ]; then hover_x=0; elif [ "$hover_x" -gt 65535 ]; then hover_x=65535; fi}
    puts $fh {if [ "$hover_y" -lt 0 ]; then hover_y=0; elif [ "$hover_y" -gt 65535 ]; then hover_y=65535; fi}
    puts $fh {bound_mouse_target "$hover_x" "$hover_y"}
    puts $fh {hover_x="$BOUND_MOUSE_X"}
    puts $fh {hover_y="$BOUND_MOUSE_Y"}
    puts $fh {hover_target="taskbar-left-icons"}
    puts $fh {case "$hover_label" in}
    puts $fh {  desktop*) hover_target="desktop-chromium-icon" ;;}
    puts $fh {esac}
    puts $fh {hover_position_fields="label=$hover_label x=$hover_x y=$hover_y $BOUND_MOUSE_FIELDS target=$hover_target"}
    puts $fh {if [ "${KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER:-0}" = 1 ]; then}
    puts $fh {  /bin/mouseinject "$hover_x" "$hover_y" 0}
    puts $fh {  hover_rc=$?}
    puts $fh {  hover_status=PASS}
    puts $fh {  if [ "$hover_rc" -ne 0 ]; then hover_status=FAIL; fi}
    puts $fh {  echo "kprofile_hover phase=result status=$hover_status rc=$hover_rc $hover_position_fields included_in_process_group=1 coverage=guest_input pointer_hover=1 command=/bin/mouseinject $hover_x $hover_y 0"}
    puts $fh {else}
    puts $fh {  echo "kprofile_hover phase=result status=SKIP rc=0 $hover_position_fields reason=disabled included_in_process_group=0 coverage=none pointer_hover=0"}
    puts $fh {fi}
    puts $fh {echo "kprofile_app_launch phase=start status=RUNNING coverage=app_launch direct_launch=1 $launch_fields mode=$probe_mode apps=$probe_apps konsole_variant=${KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT:-baseline} chromium=optional vfs_enoent_attr=${KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR:-0} newstuff_stub=${KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB:-0} qtmm_stub=${KDE_APP_LAUNCH_PROBE_QTMM_STUB:-0}"}
    puts $fh {/bin/kde-app-launch-probe "${probe_args[@]}"}
    puts $fh {app_rc=$?}
    puts $fh {app_status=PASS}
    puts $fh {if [ "$app_rc" -ne 0 ]; then}
    puts $fh {  app_status=FAIL}
    puts $fh {fi}
    puts $fh {echo "kprofile_app_launch phase=result status=$app_status rc=$app_rc coverage=app_launch direct_launch=1 $launch_fields mode=$probe_mode apps=$probe_apps konsole_variant=${KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT:-baseline} chromium=optional vfs_enoent_attr=${KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR:-0} newstuff_stub=${KDE_APP_LAUNCH_PROBE_NEWSTUFF_STUB:-0} qtmm_stub=${KDE_APP_LAUNCH_PROBE_QTMM_STUB:-0}"}
    puts $fh {dump_direct_launch_full_maps}
    puts $fh {exit "$app_rc"}
    puts $fh {KPROFILE_SCENARIO}
    puts $fh {      if [ "$KDE_APP_LAUNCH_PROBE_WAYLAND_DEBUG" = 1 ]; then}
    puts $fh {        export WAYLAND_DEBUG=client}
    puts $fh {      fi}
    puts $fh {      kprofile_args=(--timeout-ms "$KDE_APP_LAUNCH_PROBE_KPROFILE_TIMEOUT_MS")}
    puts $fh {      if [ "$KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC" = 1 ]; then}
    puts $fh {        kprofile_args+=(--userpc)}
    puts $fh {        if [ -n "$KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD" ]; then}
    puts $fh {          kprofile_args+=(--userpc-period "$KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD")}
    puts $fh {        fi}
    puts $fh {        if [ -n "$KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT" ]; then}
    puts $fh {          kprofile_args+=(--userpc-limit "$KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT")}
    puts $fh {        fi}
    puts $fh {      fi}
    puts $fh {      if [ "$KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR" = 1 ]; then}
    puts $fh {        kprofile_args+=(--vfs-enoent-attr)}
    puts $fh {      fi}
    puts $fh {      if [ "$KDE_APP_LAUNCH_PROBE_WAYLAND_DEBUG" = 1 ]; then}
    puts $fh {        if [ "$KDE_APP_LAUNCH_PROBE_KPROFILE" = 1 ]; then}
    puts $fh {          /bin/kprofile "${kprofile_args[@]}" /bin/bash "$kprofile_scenario" 2>&1 | while IFS= read -r line || [ -n "$line" ]; do}
    puts $fh {            printf 'kde_interaction_helper wayland-debug-ms=%s line=%s\n' "$(now_ms)" "$line"}
    puts $fh {          done}
    puts $fh {          probe_rc=${PIPESTATUS[0]}}
    puts $fh {        else}
    puts $fh {          /bin/kde-app-launch-probe "${probe_args[@]}" 2>&1 | while IFS= read -r line || [ -n "$line" ]; do}
    puts $fh {            printf 'kde_interaction_helper wayland-debug-ms=%s line=%s\n' "$(now_ms)" "$line"}
    puts $fh {          done}
    puts $fh {          probe_rc=${PIPESTATUS[0]}}
    puts $fh {        fi}
    puts $fh {      elif [ "$KDE_APP_LAUNCH_PROBE_KPROFILE" = 1 ]; then}
    puts $fh {        /bin/kprofile "${kprofile_args[@]}" /bin/bash "$kprofile_scenario"}
    puts $fh {        probe_rc=$?}
    puts $fh "      else"
    puts $fh {        /bin/kde-app-launch-probe "${probe_args[@]}"}
    puts $fh {        probe_rc=$?}
    puts $fh "      fi"
    puts $fh {      qtmm_call_src="/tmp/xv6-qtmm-shim-calls.log"}
    puts $fh {      qtmm_call_status=ABSENT}
    puts $fh {      if [ -s "$qtmm_call_src" ]; then}
    puts $fh {        qtmm_call_status=HIT}
    puts $fh {      elif [ -e "$qtmm_call_src" ]; then}
    puts $fh {        qtmm_call_status=EMPTY}
    puts $fh {      fi}
    puts $fh "      {"
    puts $fh {        echo "kde_direct_launch_qtmm_call_log phase=post-kprofile status=$qtmm_call_status source=$qtmm_call_src qtmm_stub=$KDE_APP_LAUNCH_PROBE_QTMM_STUB launch_index=$KDE_SMOKE_DIRECT_LAUNCH_INDEX launch_temperature=$KDE_SMOKE_DIRECT_LAUNCH_TEMPERATURE"}
    puts $fh {        if [ -e "$qtmm_call_src" ]; then}
    puts $fh {          cat "$qtmm_call_src" 2>&1 || true}
    puts $fh {        fi}
    puts $fh {        echo "kde_direct_launch_qtmm_call_log phase=post-kprofile status=end source=$qtmm_call_src"}
    puts $fh "      } >\"\$qtmm_final_call_log\""
    puts $fh {      echo "kde_interaction_helper qtmm_final_call_log phase=post-kprofile status=$qtmm_call_status artifact=$qtmm_final_call_log source=$qtmm_call_src qtmm_stub=$KDE_APP_LAUNCH_PROBE_QTMM_STUB"}
    puts $fh {      if [ -n "$semantic_pids" ]; then}
    puts $fh {        for pid in $semantic_pids; do}
    puts $fh {          kill "$pid" 2>/dev/null || true}
    puts $fh {        done}
    puts $fh {        sleep 1}
    puts $fh {        for pid in $semantic_pids; do}
    puts $fh {          wait "$pid" 2>/dev/null || true}
    puts $fh {        done}
    puts $fh {        for mon_log in $semantic_logs; do}
    puts $fh {          echo "kde_interaction_helper semantic-log path=$mon_log begin"}
    puts $fh {          sed -n '1,240p' "$mon_log" 2>/dev/null || true}
    puts $fh {          echo "kde_interaction_helper semantic-log path=$mon_log end"}
    puts $fh {        done}
    puts $fh {      fi}
    puts $fh {      echo "kde_interaction_helper direct-launch probe_rc=$probe_rc"}
    puts $fh "      ;;"
    puts $fh "    activation-pty)"
    puts $fh {      export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/dev/shm/xdg-runtime-root}"}
    puts $fh {      export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"}
    puts $fh {      export DBUS_SYSTEM_BUS_ADDRESS="${DBUS_SYSTEM_BUS_ADDRESS:-unix:abstract=xv6_system_bus}"}
    puts $fh {      export DBUS_SESSION_BUS_ADDRESS="${DBUS_SESSION_BUS_ADDRESS:-unix:abstract=xv6_session_bus}"}
    puts $fh {      export KDE_WAYLAND_ACTIVATION_PTY_REQUIRE_FRAME="${KDE_WAYLAND_ACTIVATION_PTY_REQUIRE_FRAME:-1}"}
    puts $fh {      export KDE_WAYLAND_ACTIVATION_PTY_REQUIRE_QDBUS="${KDE_WAYLAND_ACTIVATION_PTY_REQUIRE_QDBUS:-1}"}
    puts $fh {      export LD_LIBRARY_PATH=/opt/xv6-kde-abi-libs:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu:/usr/lib:/lib}
    puts $fh {      echo "kde_interaction_helper activation-pty env XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR WAYLAND_DISPLAY=$WAYLAND_DISPLAY DBUS_SESSION_BUS_ADDRESS=$DBUS_SESSION_BUS_ADDRESS REQUIRE_FRAME=$KDE_WAYLAND_ACTIVATION_PTY_REQUIRE_FRAME REQUIRE_QDBUS=$KDE_WAYLAND_ACTIVATION_PTY_REQUIRE_QDBUS"}
    puts $fh {      /bin/kde-wayland-activation-pty-probe "$@"}
    puts $fh {      probe_rc=$?}
    puts $fh {      echo "kde_interaction_helper activation-pty probe_rc=$probe_rc"}
    puts $fh "      ;;"
    puts $fh "    fbstat)"
    puts $fh "      fbstat"
    puts $fh "      ;;"
    puts $fh "    hoverprobe)"
    puts $fh "      /bin/hoverprobe \"\$@\""
    puts $fh "      probe_rc=\$?"
    puts $fh "      ;;"
    puts $fh "    *)"
    puts $fh "      echo \"kde-interaction-helper: unknown kind=\$kind\""
    puts $fh "      ;;"
    puts $fh "  esac"
    puts $fh "} >\"\$log\" 2>&1"
    puts $fh {result=PASS}
    puts $fh {case "${probe_rc:-0}" in}
    puts $fh {  0) result=PASS ;;}
    puts $fh {  *) result=FAIL ;;}
    puts $fh {esac}
    puts $fh "printf 'status=DONE kind=%s label=%s result=%s probe_rc=%s\\n' \"\$kind\" \"\$label\" \"\$result\" \"\${probe_rc:-0}\" >|\"\$tmp\""
    puts $fh "sync"
    puts $fh "mv \"\$tmp\" \"\$status\""
    puts $fh "sync"
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_desktop_interaction_script' 'write $host_script $guest_desktop_interaction_script' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_kwin_loader_ifunc_script {} {
    global tmpimg outdir guest_kwin_loader_ifunc_script guest_kwin_loader_ifunc_log

    set host_script "$outdir/kde-kwin-loader-ifunc.sh.host"
    set empty_log "$outdir/kde-kwin-loader-ifunc.empty"
    set fh [open $host_script w]
    puts $fh "#!/bin/bash"
    puts $fh "echo __KWIN_LOADER_IFUNC_BEGIN__"
    puts $fh "KDE_DLOPEN_PROBE_KWIN_HELP_QUIET=1 /bin/kde-dlopen-probe --kwin-help-check >$guest_kwin_loader_ifunc_log"
    puts $fh "cat $guest_kwin_loader_ifunc_log"
    puts $fh "echo __KWIN_LOADER_IFUNC_DONE__"
    puts $fh "sync"
    close $fh
    set fh [open $empty_log w]
    puts $fh "placeholder"
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_kwin_loader_ifunc_script' 'write $host_script $guest_kwin_loader_ifunc_script' 'rm $guest_kwin_loader_ifunc_log' 'write $empty_log $guest_kwin_loader_ifunc_log' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_qtqml_ifunc_script {} {
    global tmpimg outdir guest_qtqml_ifunc_script guest_qtqml_ifunc_log
    global guest_qtqml_ifunc_status

    set host_script "$outdir/kde-qtqml-ifunc-startup.sh.host"
    set empty_log "$outdir/kde-qtqml-ifunc-startup.empty"
    set fh [open $host_script w]
    puts $fh "#!/bin/sh"
    puts $fh "echo __KDE_QTQML_IFUNC_BEGIN__"
    puts $fh "echo status=running source=kde-qtqml-ifunc-startup-probe >$guest_qtqml_ifunc_status"
    puts $fh "sync"
    puts $fh "export LD_LIBRARY_PATH=/opt/xv6-kde-abi-libs:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu:/usr/lib:/lib"
    puts $fh "export LD_PRELOAD=/opt/xv6-kde-abi-libs/libxv6-ifunc-memcpy.so:/usr/lib/x86_64-linux-gnu/libKF5Codecs.so.5:/usr/lib/x86_64-linux-gnu/libpcre2-16.so.0"
    puts $fh "/bin/kde-qtqml-ifunc-startup-probe >$guest_qtqml_ifunc_log"
    puts $fh "cat $guest_qtqml_ifunc_log"
    puts $fh "echo status=DONE source=kde-qtqml-ifunc-startup-probe >$guest_qtqml_ifunc_status"
    puts $fh "cat $guest_qtqml_ifunc_status"
    puts $fh "echo __KDE_QTQML_IFUNC_DONE__"
    puts $fh "sync"
    close $fh
    set fh [open $empty_log w]
    puts $fh "placeholder"
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_qtqml_ifunc_script' 'write $host_script $guest_qtqml_ifunc_script' 'rm $guest_qtqml_ifunc_log' 'write $empty_log $guest_qtqml_ifunc_log' 'rm $guest_qtqml_ifunc_status' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_session_liveness_script {} {
    global tmpimg outdir guest_session_liveness_script guest_session_liveness_log

    set host_script "$outdir/kde-session-liveness.sh.host"
    set fh [open $host_script w]
    puts $fh "#!/bin/bash"
    puts $fh "set +e"
    puts $fh "log=$guest_session_liveness_log"
    puts $fh {label="${1:-session-liveness}"}
    puts $fh {: >"$log"}
    puts $fh {exec >>"$log" 2>&1}
    puts $fh "dump_diag() {"
    puts $fh {    echo "session_liveness_before_chromium diagnostics begin reason=$1"}
    puts $fh {    echo 'session_liveness_before_chromium sockets begin'}
    puts $fh {    ls /dev/shm/xdg-runtime-root /dev/shm/xdg-runtime-root/wayland-* /tmp/.X11-unix /tmp/.X11-unix/* 2>&1 || true}
    puts $fh {    echo 'session_liveness_before_chromium sockets end'}
    puts $fh {    for log_file in /kde-session-kwin.log /kde-session-plasma-child.log /kde-plasmashell-crash-capture.log /kde-audio-status.log /kde-network-status-sni.log /kspr.log /kspr.status /kspr-ready.log; do}
    puts $fh {        echo "session_liveness_before_chromium guest_log=$log_file begin"}
    puts $fh {        sed -n '1,260p' "$log_file" 2>&1 || true}
    puts $fh {        echo "session_liveness_before_chromium guest_log=$log_file end"}
    puts $fh {    done}
    puts $fh {    for d in /proc/[0-9]*; do}
    puts $fh {        p=${d#/proc/}}
    puts $fh {        cmdline=$(tr '\0' ' ' <"$d/cmdline" 2>/dev/null)}
    puts $fh {        comm=$(cat "$d/comm" 2>/dev/null)}
    puts $fh {        case "$cmdline $comm" in}
    puts $fh {            *kwin_wayland*|*plasmashell*|*kde-plasma-session-child*|*Xwayland*|*kded5*|*kactivitymanagerd*)}
    puts $fh {                echo "session_liveness_before_chromium proc pid=$p comm=$comm cmd=$cmdline"}
    puts $fh {                for f in status stat wchan syscall stack; do}
    puts $fh {                    echo "session_liveness_before_chromium proc pid=$p file=$f begin"}
    puts $fh {                    cat "$d/$f" 2>&1 || true}
    puts $fh {                    echo "session_liveness_before_chromium proc pid=$p file=$f end"}
    puts $fh {                done}
    puts $fh {                echo "session_liveness_before_chromium proc pid=$p fd begin"}
    puts $fh {                for fd in "$d"/fd/*; do}
    puts $fh {                    [ -e "$fd" ] || continue}
    puts $fh {                    printf 'fd=%s target=' "${fd##*/}"}
    puts $fh {                    readlink "$fd" 2>&1 || true}
    puts $fh {                done}
    puts $fh {                echo "session_liveness_before_chromium proc pid=$p fd end"}
    puts $fh {                echo "session_liveness_before_chromium proc pid=$p maps begin"}
    puts $fh {                sed -n '1,160p' "$d/maps" 2>&1 || true}
    puts $fh {                echo "session_liveness_before_chromium proc pid=$p maps end"}
    puts $fh {                ;;}
    puts $fh {        esac}
    puts $fh {    done}
    puts $fh {    echo "session_liveness_before_chromium diagnostics end reason=$1"}
    puts $fh "}"
    puts $fh {echo "session_liveness_before_chromium phase=$label begin"}
    puts $fh {echo "session_liveness_before_chromium uptime=$(cat /proc/uptime 2>/dev/null)"}
    puts $fh {echo 'session_liveness_before_chromium sockets begin'}
    puts $fh {ls /dev/shm/xdg-runtime-root /dev/shm/xdg-runtime-root/wayland-* /tmp/.X11-unix /tmp/.X11-unix/* 2>&1 || true}
    puts $fh {echo 'session_liveness_before_chromium sockets end'}
    puts $fh {echo 'session_liveness_before_chromium roles begin'}
    puts $fh {/bin/kde-process-probe --require-xwayland}
    puts $fh {roles_rc=$?}
    puts $fh {echo "session_liveness_before_chromium roles end rc=$roles_rc"}
    puts $fh {if [ "$roles_rc" -ne 0 ]; then}
    puts $fh {    dump_diag "roles-$roles_rc"}
    puts $fh {    echo "session_liveness_before_chromium result=FAIL rc=$roles_rc"}
    puts $fh {    echo "session_liveness_before_chromium phase=$label end"}
    puts $fh {    sync}
    puts $fh {    exit "$roles_rc"}
    puts $fh {fi}
    puts $fh {echo 'session_liveness_before_chromium roundtrip begin'}
    puts $fh {/bin/kde-wayland-seat-probe --roundtrip-only}
    puts $fh {roundtrip_rc=$?}
    puts $fh {echo "session_liveness_before_chromium roundtrip end rc=$roundtrip_rc"}
    puts $fh {if [ "$roundtrip_rc" -ne 0 ]; then}
    puts $fh {    dump_diag "roundtrip-$roundtrip_rc"}
    puts $fh {    echo "session_liveness_before_chromium result=FAIL rc=$roundtrip_rc"}
    puts $fh {    echo "session_liveness_before_chromium phase=$label end"}
    puts $fh {    sync}
    puts $fh {    exit "$roundtrip_rc"}
    puts $fh {fi}
    puts $fh {echo 'session_liveness_before_chromium result=PASS rc=0'}
    puts $fh {echo "session_liveness_before_chromium phase=$label end"}
    puts $fh {sync}
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_session_liveness_script' 'write $host_script $guest_session_liveness_script' 'rm $guest_session_liveness_log' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_wayland_client_liveness_script {} {
    global tmpimg outdir guest_wayland_client_liveness_script
    global guest_host_wlegl_smoke_log

    set host_script "$outdir/kde-wayland-client-liveness.sh.host"
    set fh [open $host_script w]
    puts $fh "#!/bin/sh"
    puts $fh "log=$guest_host_wlegl_smoke_log"
    puts $fh {case "${1:-}" in}
    puts $fh {  clear)}
    puts $fh {    rm -f "$log" /tmp/host-wlegl-smoke.pid /tmp/host-wlegl-smoke-exit /tmp/host-wlegl-smoke-toggle}
    puts $fh {    ;;}
    puts $fh {  launch)}
    puts $fh {    /bin/host-wlegl-smoke &}
    puts $fh {    ;;}
    puts $fh {  status)}
    puts $fh {    grep -E 'host-wlegl-smoke: (ready frame=|egl ready|wl_display_connect failed|missing globals|configure dispatch failed|wl_egl_window_create failed|egl[A-Za-z0-9]+ failed)' "$log" 2>/dev/null || true}
    puts $fh {    ;;}
    puts $fh {  stop)}
    puts $fh {    echo 1 > /tmp/host-wlegl-smoke-exit}
    puts $fh {    sync}
    puts $fh {    ;;}
    puts $fh {  *)}
    puts $fh {    echo "usage: $0 {clear|launch|status|stop}" >&2}
    puts $fh {    exit 2}
    puts $fh {    ;;}
    puts $fh {esac}
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_wayland_client_liveness_script' 'write $host_script $guest_wayland_client_liveness_script' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_wayland_registry_probe_script {} {
    global tmpimg outdir guest_wayland_registry_probe_script
    global guest_wayland_registry_probe_log

    set host_script "$outdir/kde-wayland-registry-probe.sh.host"
    set fh [open $host_script w]
    puts $fh "#!/bin/sh"
    puts $fh "log=$guest_wayland_registry_probe_log"
    puts $fh {label="${1:-registry-probe}"}
    puts $fh {rm -f "$log"}
    puts $fh {echo "kde_wayland_registry_probe_script label=$label begin" >"$log"}
    puts $fh {exec >>"$log" 2>&1}
    puts $fh {/bin/kde-wayland-registry-probe}
    puts $fh {rc=$?}
    puts $fh {echo "kde_wayland_registry_probe_script label=$label end rc=$rc"}
    puts $fh {sync}
    puts $fh {exit "$rc"}
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_wayland_registry_probe_script' 'write $host_script $guest_wayland_registry_probe_script' 'rm $guest_wayland_registry_probe_log' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_kde_preflight_runner_script {} {
    global tmpimg outdir
    global guest_kde_preflight_runner_script guest_kde_preflight_runner_log
    global guest_kde_preflight_runner_status guest_kde_preflight_ready_log
    global guest_kwin_loader_ifunc_script guest_kwin_loader_ifunc_log
    global guest_qtqml_ifunc_script guest_qtqml_ifunc_log guest_qtqml_ifunc_status

    set host_source "$outdir/kde-preflight-runner.c.host"
    set host_runner "$outdir/kde-preflight-runner.host"
    set host_startup "$outdir/kde-preflight-startup.host"
    set host_startup_orig "$outdir/kde-preflight-startup.orig"
    set host_startup_final "$outdir/kde-preflight-startup.final"
    set runner_source [string map [list \
        @RUNNER_LOG@ $guest_kde_preflight_runner_log \
        @RUNNER_STATUS@ $guest_kde_preflight_runner_status \
        @READY_LOG@ $guest_kde_preflight_ready_log \
        @KWIN_SCRIPT@ $guest_kwin_loader_ifunc_script \
        @KWIN_LOG@ $guest_kwin_loader_ifunc_log \
        @QTQML_SCRIPT@ $guest_qtqml_ifunc_script \
        @QTQML_LOG@ $guest_qtqml_ifunc_log \
        @QTQML_STATUS@ $guest_qtqml_ifunc_status] {
#include <errno.h>
#include <fcntl.h>
#include <stdarg.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <unistd.h>

#define RUNNER_LOG "@RUNNER_LOG@"
#define RUNNER_STATUS "@RUNNER_STATUS@"
#define READY_LOG "@READY_LOG@"
#define KWIN_SCRIPT "@KWIN_SCRIPT@"
#define KWIN_LOG "@KWIN_LOG@"
#define QTQML_SCRIPT "@QTQML_SCRIPT@"
#define QTQML_LOG "@QTQML_LOG@"
#define QTQML_STATUS "@QTQML_STATUS@"

static void append_log(const char *fmt, ...)
{
    FILE *f = fopen(RUNNER_LOG, "a");
    va_list ap;

    if (f == NULL) {
        return;
    }
    va_start(ap, fmt);
    vfprintf(f, fmt, ap);
    va_end(ap);
    fputc('\n', f);
    fclose(f);
}

static void write_status(const char *fmt, ...)
{
    FILE *f = fopen(RUNNER_STATUS, "w");
    va_list ap;

    if (f == NULL) {
        return;
    }
    va_start(ap, fmt);
    vfprintf(f, fmt, ap);
    va_end(ap);
    fputc('\n', f);
    fclose(f);
    sync();
}

static int file_contains(const char *path, const char *needle)
{
    char buf[1024];
    FILE *f = fopen(path, "r");

    if (f == NULL) {
        return 0;
    }
    while (fgets(buf, sizeof(buf), f) != NULL) {
        if (strstr(buf, needle) != NULL) {
            fclose(f);
            return 1;
        }
    }
    fclose(f);
    return 0;
}

static void append_file_to_log(const char *path)
{
    char buf[1024];
    FILE *in = fopen(path, "r");
    FILE *out;

    if (in == NULL) {
        append_log("kde_smoke_preflight_runner phase=file path=%s status=missing", path);
        return;
    }
    out = fopen(RUNNER_LOG, "a");
    if (out == NULL) {
        fclose(in);
        return;
    }
    fprintf(out, "kde_smoke_preflight_runner phase=file path=%s begin\n", path);
    while (fgets(buf, sizeof(buf), in) != NULL) {
        fputs(buf, out);
    }
    fprintf(out, "kde_smoke_preflight_runner phase=file path=%s end\n", path);
    fclose(out);
    fclose(in);
}

static int run_child(char *const argv[], const char *log_path, int append)
{
    pid_t pid = fork();
    int status;

    if (pid == 0) {
        if (log_path != NULL) {
            int flags = O_WRONLY | O_CREAT | (append ? O_APPEND : O_TRUNC);
            int fd = open(log_path, flags, 0666);
            if (fd >= 0) {
                dup2(fd, STDOUT_FILENO);
                dup2(fd, STDERR_FILENO);
                if (fd > STDERR_FILENO) {
                    close(fd);
                }
            }
        }
        execv(argv[0], argv);
        _exit(127);
    }
    if (pid < 0) {
        return -errno;
    }
    while (waitpid(pid, &status, 0) < 0) {
        if (errno != EINTR) {
            return -errno;
        }
    }
    if (WIFEXITED(status)) {
        return WEXITSTATUS(status);
    }
    if (WIFSIGNALED(status)) {
        return 128 + WTERMSIG(status);
    }
    return -1;
}

int main(void)
{
    int ready = 0;

    append_log("kde_smoke_preflight_runner phase=start");
    write_status("status=waiting source=kde-smoke-preflight-runner");
    for (int i = 1; i <= 240; i++) {
        char *const probe_argv[] = {
            "/bin/kde-process-probe",
            NULL
        };
        int rc = run_child(probe_argv, READY_LOG, 0);

        append_log("kde_smoke_preflight_runner phase=ready-probe iteration=%d exit_status=%d", i, rc);
        append_file_to_log(READY_LOG);
        if (file_contains(READY_LOG, "status=PASS")) {
            write_status("status=ready source=kde-smoke-preflight-runner iteration=%d", i);
            append_log("kde_smoke_preflight_runner phase=ready iteration=%d", i);
            ready = 1;
            break;
        }
        sleep(1);
    }
    if (!ready) {
        write_status("status=FAIL reason=ready-timeout source=kde-smoke-preflight-runner");
        append_log("kde_smoke_preflight_runner phase=done status=FAIL reason=ready-timeout");
        return 0;
    }

    write_status("status=kwin-running source=kde-smoke-preflight-runner");
    append_log("kde_smoke_preflight_runner phase=kwin");
    {
        char *const kwin_argv[] = {"/bin/sh", KWIN_SCRIPT, NULL};
        int rc = run_child(kwin_argv, RUNNER_LOG, 1);
        append_log("kde_smoke_preflight_runner phase=kwin exit_status=%d", rc);
    }
    if (!file_contains(KWIN_LOG, "KDE_DLOPEN_PROBE_KWIN_HELP_RESULT status=PASS")) {
        write_status("status=FAIL reason=kwin-missing-help source=kde-smoke-preflight-runner");
        append_log("kde_smoke_preflight_runner phase=done status=FAIL reason=kwin-missing-help");
        return 0;
    }
    write_status("status=kwin-pass source=kde-smoke-preflight-runner");
    sync();

    write_status("status=qtqml-running source=kde-smoke-preflight-runner");
    append_log("kde_smoke_preflight_runner phase=qtqml");
    {
        char *const qtqml_argv[] = {"/bin/sh", QTQML_SCRIPT, NULL};
        int rc = run_child(qtqml_argv, RUNNER_LOG, 1);
        append_log("kde_smoke_preflight_runner phase=qtqml exit_status=%d", rc);
    }
    if (file_contains(QTQML_LOG, "__KDE_QTQML_IFUNC_PASS__") &&
        file_contains(QTQML_LOG, "KDE_QTQML_IFUNC_STARTUP_PROBE_MAP status=PASS") &&
        file_contains(QTQML_LOG, "KDE_QTQML_IFUNC_STARTUP_PROBE_RESULT status=PASS") &&
        file_contains(QTQML_LOG, "KDE_QTQML_IFUNC_STARTUP_PROBE_SYMBOL status=PASS name=memmove") &&
        file_contains(QTQML_STATUS, "status=DONE source=kde-qtqml-ifunc-startup-probe")) {
        write_status("status=PASS source=kde-smoke-preflight-runner");
        append_log("kde_smoke_preflight_runner phase=done status=PASS");
    } else {
        write_status("status=FAIL reason=qtqml-missing-pass source=kde-smoke-preflight-runner");
        append_log("kde_smoke_preflight_runner phase=done status=FAIL reason=qtqml-missing-pass");
    }
    sync();
    return 0;
}
}]

    set fh [open $host_source w]
    puts -nonewline $fh $runner_source
    close $fh
    exec cc -x c -O2 -Wall -Wextra -o $host_runner $host_source

    file delete -force $host_startup_orig $host_startup $host_startup_final
    if {[catch {
        exec sh -c "debugfs -R 'dump /etc/startup $host_startup_orig' '$tmpimg' >/dev/null 2>&1"
    } err]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL preflight-startup-dump-failed $err"
        exit 8
    }
    set in [open $host_startup_orig r]
    set startup_text [read $in]
    close $in
    if {![regexp {(^|\n)[^\n]*XV6_DESKTOP_DEFAULT=kde[^\n]*/bin/xv6-desktop-session} $startup_text]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL preflight-startup-not-kde\n$startup_text"
        exit 8
    }
    if {[regexp {(^|\n)[^\n]*LD_BIND_NOW=1[^\n]*XV6_DESKTOP_DEFAULT=kde[^\n]*/bin/xv6-desktop-session} $startup_text]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL preflight-startup-has-ld-bind-now\n$startup_text"
        exit 8
    }
    regsub -all {(^|\n)/bin/sh /kspr\.sh(\n|$)} $startup_text "\n" startup_text
    regsub -all {(^|\n)/bin/sh /kspr(\n|$)} $startup_text "\n" startup_text
    if {![regexp {(^|\n)/kspr(\n|$)} $startup_text]} {
        if {$startup_text ne "" && [string index $startup_text end] ne "\n"} {
            append startup_text "\n"
        }
        append startup_text "$guest_kde_preflight_runner_script\n"
    }
    set fh [open $host_startup w]
    puts -nonewline $fh $startup_text
    close $fh

    if {[catch {
        exec sh -c "printf '%s\n' 'rm $guest_kde_preflight_runner_script' 'write $host_runner $guest_kde_preflight_runner_script' 'rm $guest_kde_preflight_runner_log' 'rm $guest_kde_preflight_runner_status' 'rm $guest_kde_preflight_ready_log' 'rm /etc/startup' 'write $host_startup /etc/startup' | debugfs -w '$tmpimg' >/dev/null 2>&1"
    } err]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL preflight-startup-write-failed $err"
        exit 8
    }
    if {[catch {
        exec sh -c "debugfs -R 'dump /etc/startup $host_startup_final' '$tmpimg' >/dev/null 2>&1"
    } err]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL preflight-startup-final-dump-failed $err"
        exit 8
    }
    set in [open $host_startup_final r]
    set final_startup_text [read $in]
    close $in
    if {[regexp {(^|\n)[^\n]*LD_BIND_NOW=1[^\n]*XV6_DESKTOP_DEFAULT=kde[^\n]*/bin/xv6-desktop-session} $final_startup_text]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL preflight-startup-final-has-ld-bind-now\n$final_startup_text"
        exit 8
    }
}

proc stage_chromium_video_launch_script {} {
    global tmpimg outdir build chromium_video_url chromium_video_proof_mode
    global chromium_video_multiprocess chromium_video_disable_audio_output
    global chromium_video_egl_platform
    global chromium_video_extra_flags chromium_video_simdutf_force_implementation
    global chromium_mesa_extension_override
    global chromium_egl_trace chromium_egl_trace_proc chromium_egl_trace_callsite
    global chromium_egl_trace_wayland chromium_egl_trace_gtk
    global chromium_egl_trace_dlsym_wrap
    global chromium_mesa_egl_context_trace
    global chromium_wayland_debug
    global chromium_auto_gl_flags
    global chromium_bundled_gl
    global chromium_process_full_maps
    global chromium_video_kprofile chromium_video_kprofile_seconds
    global guest_chromium_launch_probe_log
    global guest_chromium_video_launch_script

    set host_script "$outdir/kde-chromium-video-launch.sh.host"
    set fh [open $host_script w]
    puts $fh "#!/bin/bash"
    puts $fh "echo KDE_CHROMIUM_VIDEO_LAUNCH_BEGIN"
    puts $fh "rm -f $guest_chromium_launch_probe_log"
    set env_prefix ""
    # Forward both arms explicitly so launch-log/argv evidence cannot confuse
    # an unset control with a stale environment.  Defaults remain OFF.
    append env_prefix "WAYLAND_CHROMIUM_MULTIPROCESS=$chromium_video_multiprocess "
    append env_prefix "WAYLAND_CHROMIUM_DISABLE_AUDIO_OUTPUT=$chromium_video_disable_audio_output "
    if {$chromium_video_egl_platform ne ""} {
        append env_prefix "EGL_PLATFORM=[shell_quote $chromium_video_egl_platform] "
    }
    if {$chromium_egl_trace eq "1"} {
        append env_prefix "WAYLAND_CHROMIUM_EGL_TRACE=1 "
    }
    if {$chromium_egl_trace_proc eq "1"} {
        append env_prefix "CHROMIUM_EGL_TRACE_PROC=1 "
    }
    if {$chromium_egl_trace_callsite eq "1"} {
        append env_prefix "CHROMIUM_EGL_TRACE_CALLSITE=1 "
    }
    if {$chromium_egl_trace_wayland eq "1"} {
        append env_prefix "CHROMIUM_EGL_TRACE_WAYLAND=1 "
    }
    if {$chromium_egl_trace_gtk eq "1"} {
        append env_prefix "CHROMIUM_EGL_TRACE_GTK=1 "
    }
    if {$chromium_egl_trace_dlsym_wrap eq "1"} {
        append env_prefix "CHROMIUM_EGL_TRACE_DLSYM_WRAP=1 "
    }
    if {$chromium_mesa_egl_context_trace eq "1"} {
        append env_prefix "XV6_MESA_EGL_CONTEXT_TRACE=1 "
    }
    if {$chromium_mesa_extension_override ne ""} {
        append env_prefix "MESA_EXTENSION_OVERRIDE=[shell_quote $chromium_mesa_extension_override] "
    }
    if {$chromium_wayland_debug eq "1"} {
        append env_prefix "WAYLAND_CHROMIUM_WAYLAND_DEBUG=1 "
    }
    if {$chromium_bundled_gl eq "1"} {
        append env_prefix "WAYLAND_CHROMIUM_BUNDLED_GL=1 "
    }
    append env_prefix "WAYLAND_CHROMIUM_AUTO_GL_FLAGS=$chromium_auto_gl_flags "
    append env_prefix "KDE_CHROMIUM_EVIDENCE_FULL_MAPS=$chromium_process_full_maps "
    if {$chromium_video_extra_flags ne ""} {
        append env_prefix "WAYLAND_CHROMIUM_EXTRA_FLAGS=[shell_quote $chromium_video_extra_flags] "
    }
    if {$chromium_video_simdutf_force_implementation ne ""} {
        append env_prefix "WAYLAND_CHROMIUM_SIMDUTF_FORCE_IMPLEMENTATION=[shell_quote $chromium_video_simdutf_force_implementation] "
    }
    set quoted_url [shell_quote $chromium_video_url]
    if {$chromium_video_kprofile eq "1"} {
        set host_kprofile "$build/sysroot/bin/kprofile"
        if {![file exists $host_kprofile]} {
            puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL missing-kprofile-binary path=$host_kprofile"
            exit 8
        }
        exec sh -c "printf '%s\n' 'rm /bin/kprofile' 'write $host_kprofile /bin/kprofile' 'set_inode_field /bin/kprofile mode 0100755' | debugfs -w '$tmpimg' >/dev/null 2>&1"
        set kprofile_ms [expr {$chromium_video_kprofile_seconds * 1000}]
        set kprofile_script {export HOME=/root USER=root LOGNAME=root SHELL=/bin/bash; export XDG_RUNTIME_DIR=/dev/shm/xdg-runtime-root XDG_CACHE_HOME=/dev/shm/kde-cache XDG_CONFIG_HOME=/dev/shm/kde-config XDG_DATA_HOME=/dev/shm/kde-data XDG_STATE_HOME=/dev/shm/kde-state; export XDG_DATA_DIRS=/usr/share:/share XDG_CONFIG_DIRS=/etc/xdg; export XDG_CURRENT_DESKTOP=KDE XDG_SESSION_DESKTOP=KDE XDG_SESSION_TYPE=wayland XDG_SESSION_ID=1 XDG_SEAT=seat0 XDG_VTNR=1 WAYLAND_DISPLAY=wayland-0 DISPLAY=:0 KDE_FULL_SESSION=true KDE_SESSION_VERSION=5 QT_QPA_PLATFORM=wayland EGL_PLATFORM=wayland QT_WAYLAND_CLIENT_BUFFER_INTEGRATION=wayland-egl QSG_RHI_BACKEND=opengl LIBGL_ALWAYS_SOFTWARE=0; export DBUS_SYSTEM_BUS_ADDRESS=unix:abstract=xv6_system_bus DBUS_SESSION_BUS_ADDRESS=unix:abstract=xv6_session_bus; export PATH=/usr/local/bin:/usr/bin:/bin LIBGL_DRIVERS_PATH=/lib/dri:/usr/lib/x86_64-linux-gnu/dri GBM_BACKENDS_PATH=/lib/gbm:/usr/lib/x86_64-linux-gnu/gbm MESA_LOADER_DRIVER_OVERRIDE=virtio_gpu GALLIUM_DRIVER=virgl; exec /bin/wayland-chromium "$0"}
        puts $fh "${env_prefix}KDE_CHROMIUM_VIDEO_KPROFILE=1 /bin/kprofile --timeout-ms $kprofile_ms /bin/bash -c [shell_quote $kprofile_script] $quoted_url >$guest_chromium_launch_probe_log 2>&1"
    } elseif {$chromium_video_proof_mode eq "local-video"} {
        puts $fh "${env_prefix}KDE_APP_LAUNCH_PROBE_STDERR_TO_STDOUT=1 /bin/kde-app-launch-probe --chromium-only --require-chromium --chromium-local-video --chromium-url $quoted_url >$guest_chromium_launch_probe_log"
    } else {
        puts $fh "${env_prefix}KDE_APP_LAUNCH_PROBE_STDERR_TO_STDOUT=1 KDE_CHROMIUM_URL=$quoted_url /bin/kde-app-launch-probe --chromium-only --require-chromium >$guest_chromium_launch_probe_log"
    }
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_chromium_video_launch_script' 'write $host_script $guest_chromium_video_launch_script' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_chromium_video_clear_script {} {
    global tmpimg outdir guest_chromium_video_clear_script
    global guest_wayland_chromium_log guest_wayland_chromium_compat_log
    global guest_chrome_debug_log guest_chrome_debug_compat_log
    global guest_chromium_egl_trace_log
    global guest_chromium_process_evidence_log guest_chromium_launch_probe_log
    global guest_chromium_video_capture_log guest_chromium_video_capture_status
    global guest_host_egl_gbm_log guest_host_egl_gbm_status
    global guest_chromium_video_sampler_log guest_chromium_video_sampler_status
    global guest_chromium_video_rela_preprobe_log
    global guest_chromium_video_rela_preprobe_status

    set host_script "$outdir/kde-chromium-video-clear.sh.host"
    set fh [open $host_script w]
    puts $fh "#!/bin/bash"
    puts $fh "rm -f $guest_wayland_chromium_log $guest_wayland_chromium_compat_log"
    puts $fh "rm -f $guest_chrome_debug_log $guest_chrome_debug_compat_log"
    puts $fh "rm -f $guest_chromium_egl_trace_log /chromium-egl-trace.*.log"
    puts $fh "rm -f $guest_chromium_process_evidence_log $guest_chromium_launch_probe_log"
    puts $fh "rm -f $guest_chromium_video_sampler_log $guest_chromium_video_sampler_status"
    puts $fh "rm -f $guest_chromium_video_capture_log $guest_chromium_video_capture_status"
    puts $fh "rm -f $guest_chromium_video_rela_preprobe_log $guest_chromium_video_rela_preprobe_status"
    puts $fh "rm -f $guest_host_egl_gbm_log $guest_host_egl_gbm_status"
    puts $fh "rm -f /chromium-video-*.ppm"
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_chromium_video_clear_script' 'write $host_script $guest_chromium_video_clear_script' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_chromium_video_sampler_script {} {
    global tmpimg outdir guest_chromium_video_sampler_script
    global guest_chromium_video_sampler_log guest_chromium_video_sampler_status
    global chromium_video_sample_count
    global chromium_video_sampler_ms chromium_video_sampler_interval_ms
    global chromium_video_sampler_burst_ms chromium_video_sampler_burst_interval_ms
    global chromium_video_fast_census_ms chromium_video_fast_census_interval_ms
    global chromium_video_wait_census_ms chromium_video_wait_census_interval_ms
    global chromium_process_full_maps

    set host_script "$outdir/kde-chromium-video-sampler.sh.host"
    set fh [open $host_script w]
    puts $fh "#!/bin/bash"
    puts $fh "set +e"
    puts $fh "status_tmp=$guest_chromium_video_sampler_status.tmp.\$\$"
    puts $fh "write_status() { printf '%s\\n' \"\$*\" >\"\$status_tmp\" && sync && mv \"\$status_tmp\" $guest_chromium_video_sampler_status && sync; }"
    puts $fh "write_status status=running phase=start"
    puts $fh "write_status status=running phase=sync-before-probe"
    puts $fh "fast_pid="
    puts $fh "wait_pid="
    puts $fh ": >$guest_chromium_video_sampler_log"
    if {$chromium_video_fast_census_ms > 0} {
        puts $fh "write_status status=running phase=fast-census fast_census_ms=$chromium_video_fast_census_ms fast_census_interval_ms=$chromium_video_fast_census_interval_ms"
        puts $fh "KDE_APP_LAUNCH_PROBE_STDERR_TO_STDOUT=1 KDE_CHROMIUM_EVIDENCE_FULL_MAPS=$chromium_process_full_maps /bin/kde-app-launch-probe --chromium-fast-census-only --fast-census-ms $chromium_video_fast_census_ms --fast-census-interval-ms $chromium_video_fast_census_interval_ms >>$guest_chromium_video_sampler_log 2>&1 &"
        puts $fh "fast_pid=\$!"
    } else {
        puts $fh "echo kde_app_launch_probe chromium_fast_census_only=0 samples=0 duration_ms=0 interval_ms=$chromium_video_fast_census_interval_ms status=SKIP reason=disabled >>$guest_chromium_video_sampler_log"
    }
    if {$chromium_video_wait_census_ms > 0} {
        puts $fh "write_status status=running phase=wait-census wait_census_ms=$chromium_video_wait_census_ms wait_census_interval_ms=$chromium_video_wait_census_interval_ms"
        puts $fh "KDE_APP_LAUNCH_PROBE_STDERR_TO_STDOUT=1 KDE_CHROMIUM_EVIDENCE_FULL_MAPS=$chromium_process_full_maps /bin/kde-app-launch-probe --chromium-wait-census-only --wait-census-ms $chromium_video_wait_census_ms --wait-census-interval-ms $chromium_video_wait_census_interval_ms >>$guest_chromium_video_sampler_log 2>&1 &"
        puts $fh "wait_pid=\$!"
    } else {
        puts $fh "echo kde_app_launch_probe chromium_wait_census_only=0 samples=0 duration_ms=0 interval_ms=$chromium_video_wait_census_interval_ms status=SKIP reason=disabled >>$guest_chromium_video_sampler_log"
    }
    if {$chromium_video_sample_count == 0} {
        puts $fh "echo kde_app_launch_probe chromium_sample_only=0 samples=0 duration_ms=0 status=SKIP reason=zero-samples >>$guest_chromium_video_sampler_log"
        if {$chromium_video_fast_census_ms > 0} {
            puts $fh "wait \"\$fast_pid\" || true"
        }
        if {$chromium_video_wait_census_ms > 0} {
            puts $fh "wait \"\$wait_pid\" || true"
        }
        puts $fh "fast_pass=\$(grep 'kde_app_launch_probe chromium_fast_census_only=.*status=PASS' $guest_chromium_video_sampler_log 2>/dev/null)"
        puts $fh "wait_pass=\$(grep 'kde_app_launch_probe chromium_wait_census_only=.*status=PASS' $guest_chromium_video_sampler_log 2>/dev/null)"
        puts $fh {if [ -n "$fast_pass" ]; then}
        puts $fh "  write_status status=DONE result=PASS reason=fast-census source=kde-app-launch-probe-log samples=0 fast_census_ms=$chromium_video_fast_census_ms fast_census_interval_ms=$chromium_video_fast_census_interval_ms"
        puts $fh {elif [ -n "$wait_pass" ]; then}
        puts $fh "  write_status status=DONE result=PASS reason=wait-census source=kde-app-launch-probe-log samples=0 fast_census_ms=$chromium_video_fast_census_ms fast_census_interval_ms=$chromium_video_fast_census_interval_ms"
        puts $fh "elif test $chromium_video_fast_census_ms -eq 0 && test $chromium_video_wait_census_ms -eq 0; then"
        puts $fh "  write_status status=DONE result=SKIP reason=zero-samples samples=0 source=harness"
        puts $fh "else"
        puts $fh "  write_status status=DONE result=UNKNOWN reason=zero-samples-census-missing samples=0 source=harness fast_census_ms=$chromium_video_fast_census_ms fast_census_interval_ms=$chromium_video_fast_census_interval_ms"
        puts $fh "fi"
        puts $fh "cat $guest_chromium_video_sampler_status"
        puts $fh "exit 0"
    }
    puts $fh "write_status status=running phase=kde-app-launch-probe sample_ms=$chromium_video_sampler_ms interval_ms=$chromium_video_sampler_interval_ms burst_ms=$chromium_video_sampler_burst_ms burst_interval_ms=$chromium_video_sampler_burst_interval_ms fast_census_ms=$chromium_video_fast_census_ms fast_census_interval_ms=$chromium_video_fast_census_interval_ms"
    puts $fh "KDE_APP_LAUNCH_PROBE_STDERR_TO_STDOUT=1 KDE_CHROMIUM_EVIDENCE_FULL_MAPS=$chromium_process_full_maps /bin/kde-app-launch-probe --chromium-sample-only --sample-ms $chromium_video_sampler_ms --sample-interval-ms $chromium_video_sampler_interval_ms --burst-ms $chromium_video_sampler_burst_ms --burst-interval-ms $chromium_video_sampler_burst_interval_ms >>$guest_chromium_video_sampler_log 2>&1"
    puts $fh "sample_pass=\$(grep 'kde_app_launch_probe chromium_sample_only=1 .*status=PASS' $guest_chromium_video_sampler_log 2>/dev/null)"
    puts $fh {if [ -n "$sample_pass" ]; then}
    puts $fh "  write_status status=DONE result=PASS phase=probe-returned source=kde-app-launch-probe-log fast_census_ms=$chromium_video_fast_census_ms fast_census_interval_ms=$chromium_video_fast_census_interval_ms"
    puts $fh "else"
    puts $fh "  write_status status=running phase=probe-returned source=kde-app-launch-probe-log-attempted fast_census_ms=$chromium_video_fast_census_ms fast_census_interval_ms=$chromium_video_fast_census_interval_ms"
    puts $fh "fi"
    if {$chromium_video_fast_census_ms > 0} {
        puts $fh "wait \"\$fast_pid\" || true"
    }
    if {$chromium_video_wait_census_ms > 0} {
        puts $fh "wait \"\$wait_pid\" || true"
    }
    puts $fh "sample_pass=\$(grep 'kde_app_launch_probe chromium_sample_only=1 .*status=PASS' $guest_chromium_video_sampler_log 2>/dev/null)"
    puts $fh {if [ -n "$sample_pass" ]; then}
    puts $fh "  write_status status=DONE result=PASS source=kde-app-launch-probe-log fast_census_ms=$chromium_video_fast_census_ms fast_census_interval_ms=$chromium_video_fast_census_interval_ms"
    puts $fh "else"
    puts $fh "  write_status status=DONE result=UNKNOWN source=kde-app-launch-probe-log-attempted fast_census_ms=$chromium_video_fast_census_ms fast_census_interval_ms=$chromium_video_fast_census_interval_ms"
    puts $fh "fi"
    puts $fh "cat $guest_chromium_video_sampler_status"
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_chromium_video_sampler_script' 'write $host_script $guest_chromium_video_sampler_script' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_chromium_video_sampler_status_script {} {
    global tmpimg outdir guest_chromium_video_sampler_status_script
    global guest_chromium_video_sampler_status guest_chromium_video_sampler_log

    set host_script "$outdir/kde-chromium-video-sampler-status.sh.host"
    set fh [open $host_script w]
    puts $fh "#!/bin/bash"
    puts $fh "cat $guest_chromium_video_sampler_status 2>/dev/null || true"
    puts $fh "grep 'kde_app_launch_probe chromium_sample_only=1 .*status=PASS' $guest_chromium_video_sampler_log 2>/dev/null || true"
    puts $fh "grep 'kde_app_launch_probe chromium_fast_census_only=.*status=PASS' $guest_chromium_video_sampler_log 2>/dev/null || true"
    puts $fh "grep 'kde_app_launch_probe chromium_wait_census_only=.*status=PASS' $guest_chromium_video_sampler_log 2>/dev/null || true"
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_chromium_video_sampler_status_script' 'write $host_script $guest_chromium_video_sampler_status_script' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_chromium_video_capture_script {} {
    global tmpimg outdir chromium_video_sample_count
    global chromium_video_sample_interval_ms
    global guest_chromium_video_capture_script
    global guest_chromium_video_capture_log
    global guest_chromium_video_capture_status

    set sleep_seconds [expr {($chromium_video_sample_interval_ms + 999) / 1000}]
    if {$sleep_seconds < 1} {
        set sleep_seconds 1
    }

    set host_script "$outdir/kde-chromium-video-capture.sh.host"
    set fh [open $host_script w]
    puts $fh "#!/bin/bash"
    puts $fh "status_tmp=$guest_chromium_video_capture_status.tmp.\$\$"
    puts $fh "write_status() { printf '%s\\n' \"\$*\" >\"\$status_tmp\" && sync && mv \"\$status_tmp\" $guest_chromium_video_capture_status && sync; }"
    puts $fh {capture_uptime() { printf '%s 0.00\n' "${EPOCHREALTIME:-${SECONDS}.000000}"; }}
    puts $fh "write_status status=running phase=start samples=$chromium_video_sample_count"
    puts $fh "echo kde_chromium_video_capture start samples=$chromium_video_sample_count interval_ms=$chromium_video_sample_interval_ms >$guest_chromium_video_capture_log"
    puts $fh "echo kde_chromium_video_capture start_uptime >>$guest_chromium_video_capture_log"
    puts $fh "write_status status=running phase=start op=capture-uptime samples=$chromium_video_sample_count"
    puts $fh "capture_uptime >>$guest_chromium_video_capture_log"
    puts $fh "write_status status=running phase=start op=capture-uptime-done samples=$chromium_video_sample_count"
    for {set i 0} {$i < $chromium_video_sample_count} {incr i} {
        set guest_path [format "/chromium-video-%02d.ppm" $i]
        set frame [format "%02d" $i]
        puts $fh "write_status status=running phase=frame frame=$frame op=begin path=$guest_path samples=$chromium_video_sample_count"
        puts $fh [format "echo kde_chromium_video_capture frame=%02d begin path=%s >>%s" $i $guest_path $guest_chromium_video_capture_log]
        puts $fh [format "echo kde_chromium_video_capture frame=%02d uptime_before >>%s" $i $guest_chromium_video_capture_log]
        puts $fh "write_status status=running phase=frame frame=$frame op=capture-uptime-before path=$guest_path samples=$chromium_video_sample_count"
        puts $fh "capture_uptime >>$guest_chromium_video_capture_log"
        puts $fh "write_status status=running phase=frame frame=$frame op=rm-ppm path=$guest_path samples=$chromium_video_sample_count"
        puts $fh "rm -f $guest_path"
        puts $fh [format "echo kde_chromium_video_capture frame=%02d sample_current_before >>%s" $i $guest_chromium_video_capture_log]
        puts $fh "write_status status=running phase=frame frame=$frame op=fbstat-sample-current-before path=$guest_path samples=$chromium_video_sample_count"
        puts $fh "fbstat sample-current 0 0 1280 800 >>$guest_chromium_video_capture_log"
        puts $fh "write_status status=running phase=frame frame=$frame op=fbstat-ppm-current path=$guest_path samples=$chromium_video_sample_count"
        puts $fh "fbstat ppm-current $guest_path 0 0 1280 800 >>$guest_chromium_video_capture_log"
        puts $fh [format "echo kde_chromium_video_capture frame=%02d sample_current_after >>%s" $i $guest_chromium_video_capture_log]
        puts $fh "write_status status=running phase=frame frame=$frame op=fbstat-sample-current-after path=$guest_path samples=$chromium_video_sample_count"
        puts $fh "fbstat sample-current 0 0 1280 800 >>$guest_chromium_video_capture_log"
        puts $fh "write_status status=running phase=frame frame=$frame op=wc-ppm path=$guest_path samples=$chromium_video_sample_count"
        puts $fh "wc $guest_path >>$guest_chromium_video_capture_log"
        puts $fh "write_status status=running phase=frame frame=$frame op=sync path=$guest_path samples=$chromium_video_sample_count"
        puts $fh "sync"
        puts $fh [format "echo kde_chromium_video_capture frame=%02d uptime_after >>%s" $i $guest_chromium_video_capture_log]
        puts $fh "write_status status=running phase=frame frame=$frame op=capture-uptime-after path=$guest_path samples=$chromium_video_sample_count"
        puts $fh "capture_uptime >>$guest_chromium_video_capture_log"
        puts $fh [format "echo kde_chromium_video_capture frame=%02d end path=%s >>%s" $i $guest_path $guest_chromium_video_capture_log]
        puts $fh "write_status status=running phase=frame frame=$frame op=end path=$guest_path samples=$chromium_video_sample_count"
        if {$i + 1 < $chromium_video_sample_count} {
            puts $fh "write_status status=running phase=frame frame=$frame op=sleep seconds=$sleep_seconds path=$guest_path samples=$chromium_video_sample_count"
            puts $fh "sleep $sleep_seconds"
        }
    }
    puts $fh "echo kde_chromium_video_capture done samples=$chromium_video_sample_count >>$guest_chromium_video_capture_log"
    puts $fh "echo kde_chromium_video_capture result status=PASS samples=$chromium_video_sample_count >>$guest_chromium_video_capture_log"
    puts $fh "write_status status=DONE result=PASS samples=$chromium_video_sample_count"
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_chromium_video_capture_script' 'write $host_script $guest_chromium_video_capture_script' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_chromium_video_capture_status_script {} {
    global tmpimg outdir guest_chromium_video_capture_status_script
    global guest_chromium_video_capture_status guest_chromium_video_capture_log

    set host_script "$outdir/kde-chromium-video-capture-status.sh.host"
    set fh [open $host_script w]
    puts $fh "#!/bin/bash"
    puts $fh "cat $guest_chromium_video_capture_status 2>/dev/null || true"
    puts $fh "grep 'kde_chromium_video_capture done' $guest_chromium_video_capture_log 2>/dev/null || true"
    puts $fh "grep 'kde_chromium_video_capture result status=PASS' $guest_chromium_video_capture_log 2>/dev/null || true"
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_chromium_video_capture_status_script' 'write $host_script $guest_chromium_video_capture_status_script' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_chromium_video_egl_gbm_script {} {
    global tmpimg outdir guest_chromium_video_egl_gbm_script
    global guest_host_egl_gbm_log guest_host_egl_gbm_status
    global chromium_video_egl_gbm_require_config chromium_video_egl_gbm_attempts

    set host_script "$outdir/kde-chromium-video-egl-gbm.sh.host"
    set fh [open $host_script w]
    puts $fh "#!/bin/bash"
    puts $fh "rm -f $guest_host_egl_gbm_log $guest_host_egl_gbm_status"
    puts $fh "status_tmp=$guest_host_egl_gbm_status.tmp.\$\$"
    puts $fh "write_status() { printf '%s\\n' \"\$*\" >\"\$status_tmp\" && sync && mv \"\$status_tmp\" $guest_host_egl_gbm_status && sync; }"
    puts $fh "write_status status=running"
    puts $fh "export XDG_RUNTIME_DIR=/dev/shm/xdg-runtime-root"
    puts $fh "export WAYLAND_DISPLAY=wayland-0"
    puts $fh "export DISPLAY=:0"
    puts $fh "export OZONE_PLATFORM=wayland"
    puts $fh "export EGL_PLATFORM=gbm"
    puts $fh "export GALLIUM_DRIVER=virgl"
    puts $fh "export MESA_LOADER_DRIVER_OVERRIDE=virtio_gpu"
    puts $fh "export LIBGL_DRIVERS_PATH=/lib/dri:/usr/lib/x86_64-linux-gnu/dri"
    puts $fh "export GBM_BACKENDS_PATH=/lib/gbm:/usr/lib/x86_64-linux-gnu/gbm"
    puts $fh "export HOST_EGL_GBM_SMOKE_API=gles3"
    puts $fh "export HOST_EGL_GBM_SMOKE_REQUIRE_CONFIG=$chromium_video_egl_gbm_require_config"
    puts $fh "export HOST_EGL_GBM_SMOKE_CHROMIUM_ATTEMPTS=$chromium_video_egl_gbm_attempts"
    puts $fh "unset HOST_EGL_GBM_SMOKE_STDIO"
    puts $fh "rm -f /tmp/host-gui-host-egl-gbm-gl-smoke.log"
    set egl_gbm_cmd "/bin/host-egl-gbm-gl-smoke --api=gles3"
    if {$chromium_video_egl_gbm_require_config eq "1"} {
        append egl_gbm_cmd " --require-config"
    }
    if {$chromium_video_egl_gbm_attempts eq "1"} {
        append egl_gbm_cmd " --chromium-attempts"
    }
    puts $fh "$egl_gbm_cmd"
    puts $fh "cat /tmp/host-gui-host-egl-gbm-gl-smoke.log >$guest_host_egl_gbm_log"
    puts $fh "write_status status=DONE source=host-egl-gbm-gl-smoke-log-copy-attempted"
    puts $fh "cat $guest_host_egl_gbm_status"
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_chromium_video_egl_gbm_script' 'write $host_script $guest_chromium_video_egl_gbm_script' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc stage_chromium_video_rela_preprobe_script {} {
    global tmpimg outdir guest_chromium_video_rela_preprobe_script
    global guest_chromium_video_rela_preprobe_log
    global guest_chromium_video_rela_preprobe_status

    set host_script "$outdir/kde-chromium-video-rela-preprobe.sh.host"
    set fh [open $host_script w]
    puts $fh "#!/bin/bash"
    puts $fh "rm -f $guest_chromium_video_rela_preprobe_log $guest_chromium_video_rela_preprobe_status"
    puts $fh "status_tmp=$guest_chromium_video_rela_preprobe_status.tmp.\$\$"
    puts $fh "write_status() { printf '%s\\n' \"\$*\" >\"\$status_tmp\" && sync && mv \"\$status_tmp\" $guest_chromium_video_rela_preprobe_status && sync; }"
    puts $fh "write_status status=running"
    puts $fh "echo kde_chromium_rela_preprobe begin >$guest_chromium_video_rela_preprobe_log"
    puts $fh {if [ ! -x /bin/chrome-rela-probe ]; then}
    puts $fh "  echo kde_chromium_rela_preprobe missing /bin/chrome-rela-probe >>$guest_chromium_video_rela_preprobe_log"
    puts $fh "  write_status status=FAIL reason=probe-missing"
    puts $fh "  cat $guest_chromium_video_rela_preprobe_status"
    puts $fh "  exit 0"
    puts $fh "fi"
    puts $fh "/bin/chrome-rela-probe --chrome-chain >>$guest_chromium_video_rela_preprobe_log 2>&1"
    puts $fh "chain_pass=\$(grep 'CHROME_RELA_PROBE_CHAIN_PASS' $guest_chromium_video_rela_preprobe_log 2>/dev/null || true)"
    puts $fh "probe_fail=\$(grep 'CHROME_RELA_PROBE_FAIL' $guest_chromium_video_rela_preprobe_log 2>/dev/null || true)"
    puts $fh "status_fail=\$(grep 'status=FAIL' $guest_chromium_video_rela_preprobe_log 2>/dev/null || true)"
    puts $fh {if [ -n "$chain_pass" ] && [ -z "$probe_fail" ] && [ -z "$status_fail" ]; then}
    puts $fh "  echo kde_chromium_rela_preprobe result status=PASS >>$guest_chromium_video_rela_preprobe_log"
    puts $fh "  write_status status=DONE result=PASS source=chrome-rela-probe-chain"
    puts $fh "else"
    puts $fh "  echo kde_chromium_rela_preprobe result status=FAIL >>$guest_chromium_video_rela_preprobe_log"
    puts $fh "  write_status status=DONE result=FAIL source=chrome-rela-probe-chain"
    puts $fh "fi"
    puts $fh "cat $guest_chromium_video_rela_preprobe_status"
    puts $fh "grep 'CHROME_RELA_PROBE_CHAIN_RESULT' $guest_chromium_video_rela_preprobe_log 2>/dev/null || true"
    puts $fh "grep 'kde_chromium_rela_preprobe result' $guest_chromium_video_rela_preprobe_log 2>/dev/null || true"
    close $fh

    exec sh -c "printf '%s\n' 'rm $guest_chromium_video_rela_preprobe_script' 'write $host_script $guest_chromium_video_rela_preprobe_script' | debugfs -w '$tmpimg' >/dev/null 2>&1"
}

proc x11_egl_refresh_host_artifact_log {} {
    global tmpimg guest_host_x11_egl_log host_x11_egl_log

    set tmp "$host_x11_egl_log.debugfs.[pid]"
    catch { file delete -force $tmp }
    set dumped [expr {![catch {
        exec sh -c "debugfs -R 'dump $guest_host_x11_egl_log $tmp' '$tmpimg' >/dev/null 2>&1"
    }]}]
    if {$dumped && [file exists $tmp] && [file size $tmp] > 0} {
        file rename -force $tmp $host_x11_egl_log
        return 1
    }
    catch { file delete -force $tmp }
    return [expr {[file exists $host_x11_egl_log] && [file size $host_x11_egl_log] > 0}]
}

proc read_x11_egl_host_artifact_log {text_var} {
    global host_x11_egl_log
    upvar 1 $text_var text

    if {![x11_egl_refresh_host_artifact_log]} {
        return 0
    }
    set text [read_text_file $host_x11_egl_log]
    return [expr {$text ne ""}]
}

proc read_x11_present_trace_host_artifact_log {text_var} {
    global tmpimg guest_host_x11_present_trace_log host_x11_present_trace_log
    upvar 1 $text_var text

    set tmp "$host_x11_present_trace_log.debugfs.[pid]"
    catch { file delete -force $tmp }
    set dumped [expr {![catch {
        exec sh -c "debugfs -R 'dump $guest_host_x11_present_trace_log $tmp' '$tmpimg' >/dev/null 2>&1"
    }]}]
    if {$dumped && [file exists $tmp] && [file size $tmp] > 0} {
        file rename -force $tmp $host_x11_present_trace_log
    } else {
        catch { file delete -force $tmp }
    }
    if {![file exists $host_x11_present_trace_log] ||
        [file size $host_x11_present_trace_log] == 0} {
        return 0
    }
    set text [read_text_file $host_x11_present_trace_log]
    return [expr {$text ne ""}]
}

proc x11_egl_session_log_complete {label text} {
    if {$label eq "x11-glx-fps-session-probe"} {
        if {![regexp {host-x11-egl-smoke: phase=session_probe status=(PASS|FAIL|TIMEOUT)[^\r\n]*probe_mode=glx-fps} $text]} {
            return 0
        }
        if {![regexp {host-x11-egl-smoke: phase=glx_fps_result status=(PASS|FAIL)} $text] &&
            ![regexp {host-x11-egl-smoke: phase=glx_fps_timing status=PASS result_status=PASS[^\r\n]*frames=[0-9]+} $text] &&
            ![regexp {host-x11-egl-smoke: phase=glx-fps status=(PASS|FAIL|TIMEOUT)} $text]} {
            return 0
        }
        if {[regexp {(^|\n)probe_glx_present_trace=1(\r?\n|$)} $text] &&
            ![regexp {host-x11-present-trace: phase=present_trace_result status=} $text] &&
            ![regexp {host-x11-egl-smoke: phase=glx_present_trace[^\r\n]*status=FAIL} $text]} {
            return 0
        }
        if {[regexp {host-x11-present-trace: phase=present_trace status=BEGIN[^\r\n]*glx_swap_ioctl_trace=1} $text] &&
            ![regexp {host-x11-present-trace: phase=glx_swap_ioctl_trace_result status=} $text] &&
            ![regexp {host-x11-egl-smoke: phase=glx_present_trace[^\r\n]*status=FAIL} $text]} {
            return 0
        }
        return 1
    }
    if {$label eq "x11-present-fps-session-probe"} {
        return [expr {[regexp {host-x11-egl-smoke: phase=session_probe status=(PASS|FAIL|TIMEOUT)[^\r\n]*probe_mode=present-fps} $text] &&
                      ([regexp {host-x11-dri3-present-smoke: phase=present_fps_result status=(PASS|FAIL)} $text] ||
                       [regexp {host-x11-egl-smoke: phase=present-fps status=(PASS|FAIL|TIMEOUT)} $text])}]
    }
    return 1
}

proc drain_after_crash_match {seconds} {
    global timeout

    set old_timeout $timeout
    set deadline [expr {[clock milliseconds] + ($seconds * 1000)}]
    set timeout 1
    while {[clock milliseconds] < $deadline} {
        expect {
            -re {.+[\r\n]+} {
            }
            timeout {
            }
            eof {
                set timeout $old_timeout
                return
            }
        }
    }
    set timeout $old_timeout
}

proc drain_serial_available {} {
    global timeout

    set old_timeout $timeout
    set timeout 0
    while {1} {
        expect {
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                set timeout $old_timeout
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL serial-drain-crash"
            }
            -re {pid [0-9]+ [^:\r\n]+: exception [0-9]+} {
                set timeout $old_timeout
                finish_after_user_exception 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL serial-drain-exception"
            }
            -re {.+[\r\n]+} {
            }
            timeout {
                set timeout $old_timeout
                return
            }
            eof {
                set timeout $old_timeout
                finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL serial-drain-eof"
            }
        }
    }
}

proc finish_after_user_exception {code label} {
    puts "KDE-PLASMA-DESKTOP-SMOKE-WARN user-exception-drain-before-finish label=[evidence_quote $label]"
    drain_after_crash_match 5
    finish $code $label
}

proc tolerate_optional_pactl_ready_crash {phase line} {
    global kde_tolerate_optional_pactl_ready_crash

    if {!$kde_tolerate_optional_pactl_ready_crash} {
        return 0
    }

    puts "KDE-PLASMA-DESKTOP-SMOKE-WARN optional-pactl-ready-crash-ignored phase=$phase line=[evidence_quote $line]"
    return 1
}

proc finish_after_crash {code label} {
    puts "KDE-PLASMA-DESKTOP-SMOKE-WARN crash-drain-before-finish label=[evidence_quote $label]"
    drain_after_crash_match 5
    finish $code $label
}

proc finish {code label} {
    global qemu_pid runlog tmpimg ppm png guest_before_ppm guest_after_ppm
    global guest_final_ppm guest_taskbar_settled_before_hover_ppm
    global guest_profiled_hover_after_ppm guest_direct_launch_before_ppm
    global guest_direct_launch_after_ppm
    global guest_agent_log guest_agent_status agent_log agent_status
    global before_ppm after_ppm final_ppm before_png after_png final_png
    global taskbar_settled_before_hover_ppm profiled_hover_after_ppm
    global taskbar_settled_before_hover_png profiled_hover_after_png
    global profiled_hover_diff_png profiled_hover_diff_txt
    global direct_launch_before_ppm direct_launch_after_ppm
    global direct_launch_before_png direct_launch_after_png
    global direct_launch_diff_png direct_launch_diff_txt
    global diff_png input_diff_min outdir color_metrics
    global qemu_trace qemu_trace_summary
    global host_final_png
    global host_taskbar_settled_before_hover_png
    global host_profiled_hover_after_png host_direct_launch_after_png
    global host_profiled_hover_diff_png host_profiled_hover_diff_txt
    global guest_host_x11_egl_log host_x11_egl_log x11_egl_artifact_prefix
    global guest_host_x11_present_trace_log host_x11_present_trace_log
    global guest_fbstat_log fbstat_log
    global guest_host_egl_gbm_log host_egl_gbm_log
    global guest_host_egl_gbm_status host_egl_gbm_status
    global guest_host_wlegl_smoke_log host_wlegl_smoke_log
    global guest_wayland_chromium_log guest_wayland_chromium_compat_log
    global guest_chrome_debug_log guest_chrome_debug_compat_log
    global guest_kwin_alloc_trace_log guest_kwin_ioctl_trace_log guest_kwin_loader_ifunc_log
    global guest_qtqml_ifunc_log guest_qtqml_ifunc_status
    global guest_kde_preflight_runner_log guest_kde_preflight_runner_status
    global guest_kde_preflight_ready_log
    global guest_session_liveness_log session_liveness_log
    global guest_wayland_registry_probe_log wayland_registry_probe_log
    global guest_chromium_egl_trace_log
    global guest_chromium_process_evidence_log guest_chromium_launch_probe_log
    global guest_chromium_video_capture_log guest_chromium_video_capture_status
    global guest_chromium_video_sampler_log guest_chromium_video_sampler_status
    global guest_chromium_video_rela_preprobe_log
    global guest_chromium_video_rela_preprobe_status
    global wayland_chromium_log chrome_debug_log kwin_alloc_trace_log kwin_ioctl_trace_log
    global guest_kde_session_kwin_log guest_kde_session_plasma_log
    global guest_plasmashell_crash_capture_log plasmashell_crash_capture_log
    global guest_kde_audio_status_log guest_kde_network_sni_log
    global guest_pre_kwin_libinput_log
    global kde_session_kwin_log kde_session_plasma_log kde_audio_status_log
    global kde_network_sni_log
    global pre_kwin_libinput_log
    global kwin_loader_ifunc_log qtqml_ifunc_log qtqml_ifunc_status
    global kde_preflight_runner_log kde_preflight_runner_status
    global kde_preflight_ready_log
    global chromium_process_evidence_log
    global chromium_egl_trace_log chromium_egl_trace
    global chromium_launch_probe_log
    global chromium_video_post_evidence_log chromium_video_capture_log
    global chromium_video_capture_status
    global chromium_video_sampler_log chromium_video_sampler_status
    global chromium_video_rela_preprobe_log
    global chromium_video_rela_preprobe_status
    global chromium_video_sample_count kde_smoke_reducer outdir
    global chromium_video_post_strict
    global guest_role_probe_log role_probe_log
    global guest_konsole_phase_log konsole_phase_log

    set label [chromium_video_result_label $label]
    write_final_status $code $label "finish-entry"
    host_screenshot "final" $host_final_png
    optional_monitor_screendump
    cleanup_owned_qemu
    catch { wait }

    if {[file exists $ppm]} {
        catch { exec convert $ppm $png }
    }
    catch { exec sh -c "debugfs -R 'dump $guest_before_ppm $before_ppm' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_after_ppm $after_ppm' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_final_ppm $final_ppm' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_taskbar_settled_before_hover_ppm $taskbar_settled_before_hover_ppm' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_profiled_hover_after_ppm $profiled_hover_after_ppm' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_direct_launch_before_ppm $direct_launch_before_ppm' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_direct_launch_after_ppm $direct_launch_after_ppm' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_agent_log $agent_log' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_agent_status $agent_status' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_host_x11_egl_log $host_x11_egl_log' '$tmpimg' >/dev/null 2>&1" }
    dump_optional_guest_artifact $guest_host_x11_present_trace_log $host_x11_present_trace_log
    dump_optional_guest_artifact $guest_fbstat_log $fbstat_log
    dump_optional_guest_artifact $guest_host_egl_gbm_log $host_egl_gbm_log
    dump_optional_guest_artifact $guest_host_egl_gbm_status $host_egl_gbm_status
    dump_optional_guest_artifact $guest_host_wlegl_smoke_log $host_wlegl_smoke_log
    dump_optional_guest_artifact $guest_wayland_chromium_log $wayland_chromium_log
    if {![guest_artifact_real_file $wayland_chromium_log]} {
        dump_optional_guest_artifact $guest_wayland_chromium_compat_log $wayland_chromium_log
    }
    dump_optional_guest_artifact $guest_chrome_debug_log $chrome_debug_log
    if {![guest_artifact_real_file $chrome_debug_log]} {
        dump_optional_guest_artifact $guest_chrome_debug_compat_log $chrome_debug_log
    }
    dump_optional_guest_artifact $guest_kwin_alloc_trace_log $kwin_alloc_trace_log
    dump_optional_guest_artifact $guest_kwin_ioctl_trace_log $kwin_ioctl_trace_log
    dump_optional_guest_artifact $guest_kde_session_kwin_log $kde_session_kwin_log
    dump_optional_guest_artifact $guest_kde_session_plasma_log $kde_session_plasma_log
    dump_optional_guest_artifact $guest_plasmashell_crash_capture_log $plasmashell_crash_capture_log
    dump_optional_guest_artifact $guest_kde_audio_status_log $kde_audio_status_log
    dump_optional_guest_artifact $guest_kde_network_sni_log $kde_network_sni_log
    dump_optional_guest_artifact $guest_pre_kwin_libinput_log $pre_kwin_libinput_log
    dump_optional_guest_artifact $guest_kwin_loader_ifunc_log $kwin_loader_ifunc_log
    dump_optional_guest_artifact $guest_qtqml_ifunc_log $qtqml_ifunc_log
    dump_optional_guest_artifact $guest_qtqml_ifunc_status $qtqml_ifunc_status
    dump_optional_guest_artifact $guest_kde_preflight_runner_log $kde_preflight_runner_log
    dump_optional_guest_artifact $guest_kde_preflight_runner_status $kde_preflight_runner_status
    dump_optional_guest_artifact $guest_kde_preflight_ready_log $kde_preflight_ready_log
    dump_optional_guest_artifact $guest_session_liveness_log $session_liveness_log
    dump_optional_guest_artifact $guest_wayland_registry_probe_log $wayland_registry_probe_log
    dump_guest_core_artifacts
    dump_guest_kcrash_metadata_artifacts
    dump_optional_guest_artifact $guest_chromium_process_evidence_log $chromium_process_evidence_log
    dump_optional_guest_artifact $guest_chromium_launch_probe_log $chromium_launch_probe_log
    if {![file exists $role_probe_log] || [file size $role_probe_log] == 0} {
        dump_optional_guest_artifact $guest_role_probe_log $role_probe_log
    }
    dump_optional_guest_artifact $guest_konsole_phase_log $konsole_phase_log
    if {$kde_smoke_reducer eq "chromium-video"} {
        if {$chromium_egl_trace eq "1"} {
            dump_chromium_egl_trace_artifacts
        }
        dump_optional_guest_artifact $guest_chromium_video_sampler_log $chromium_video_sampler_log
        dump_optional_guest_artifact $guest_chromium_video_sampler_status $chromium_video_sampler_status
        dump_optional_guest_artifact $guest_chromium_video_capture_log $chromium_video_capture_log
        dump_optional_guest_artifact $guest_chromium_video_capture_status $chromium_video_capture_status
        dump_optional_guest_artifact $guest_chromium_video_rela_preprobe_log $chromium_video_rela_preprobe_log
        dump_optional_guest_artifact $guest_chromium_video_rela_preprobe_status $chromium_video_rela_preprobe_status
        for {set i 0} {$i < $chromium_video_sample_count} {incr i} {
            set guest_chromium_video_ppm [format "/chromium-video-%02d.ppm" $i]
            set host_chromium_video_ppm [format "%s/chromium-video-%02d.ppm" $outdir $i]
            dump_optional_guest_artifact $guest_chromium_video_ppm $host_chromium_video_ppm
        }
        write_chromium_video_frame_stats
        set chromium_video_post_status [write_chromium_video_post_evidence]
    }
    set qtquick_accel_violation [check_qtquick_accel_policy]
    if {$qtquick_accel_violation ne "" &&
        ![regexp -nocase {panic|fatal|crash|eof} $label]} {
        set code 8
        set label "KDE-PLASMA-DESKTOP-SMOKE-FAIL qtquick-accelerated-path-policy"
    }
    if {$x11_egl_artifact_prefix ne ""} {
        set dumped_text ""
        if {[file exists $host_x11_egl_log]} {
            set dumped_text [read_text_file $host_x11_egl_log]
        }
        if {[string first $x11_egl_artifact_prefix $dumped_text] != 0} {
            write_x11_egl_artifact_log $dumped_text
        }
    }
    if {[file exists $before_ppm]} {
        catch { exec convert $before_ppm $before_png }
    }
    if {[file exists $after_ppm]} {
        catch { exec convert $after_ppm $after_png }
    }
    if {[file exists $final_ppm]} {
        catch { exec convert $final_ppm $final_png }
    }
    if {[file exists $taskbar_settled_before_hover_ppm]} {
        catch { exec convert $taskbar_settled_before_hover_ppm $taskbar_settled_before_hover_png }
    }
    if {[file exists $profiled_hover_after_ppm]} {
        catch { exec convert $profiled_hover_after_ppm $profiled_hover_after_png }
    }
    if {[file exists $taskbar_settled_before_hover_ppm] &&
        [file exists $profiled_hover_after_ppm]} {
        set hover_diff_pixels_text 0
        set hover_diff_out [exec sh -c "compare -metric AE '$taskbar_settled_before_hover_ppm' '$profiled_hover_after_ppm' '$profiled_hover_diff_png' 2>&1 || true"]
        regexp {([0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?)} $hover_diff_out -> hover_diff_pixels_text
        set hover_diff_pixels [expr {int(ceil(double($hover_diff_pixels_text)))}]
        exec sh -c "printf '%s\n' '$hover_diff_pixels' > '$profiled_hover_diff_txt'"
        desktop_interaction_log_line "phase=profiled-hover-capture action=hover-diff status=PASS diff_pixels=$hover_diff_pixels before=$taskbar_settled_before_hover_ppm after=$profiled_hover_after_ppm diff=$profiled_hover_diff_png"
    } elseif {$kde_smoke_reducer eq "desktop-interaction-latency"} {
        desktop_interaction_log_line "phase=profiled-hover-capture action=hover-diff status=missing before_exists=[file exists $taskbar_settled_before_hover_ppm] after_exists=[file exists $profiled_hover_after_ppm]"
    }
    if {[file exists $host_taskbar_settled_before_hover_png] &&
        [file exists $host_profiled_hover_after_png]} {
        set host_hover_diff_pixels_text 0
        set host_hover_diff_out [exec sh -c "compare -metric AE '$host_taskbar_settled_before_hover_png' '$host_profiled_hover_after_png' '$host_profiled_hover_diff_png' 2>&1 || true"]
        regexp {([0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?)} $host_hover_diff_out -> host_hover_diff_pixels_text
        set host_hover_diff_pixels [expr {int(ceil(double($host_hover_diff_pixels_text)))}]
        exec sh -c "printf '%s\n' '$host_hover_diff_pixels' > '$host_profiled_hover_diff_txt'"
        desktop_interaction_log_line "phase=profiled-hover-capture action=host-hover-diff status=PASS diff_pixels=$host_hover_diff_pixels before=$host_taskbar_settled_before_hover_png after=$host_profiled_hover_after_png diff=$host_profiled_hover_diff_png"
    } elseif {$kde_smoke_reducer eq "desktop-interaction-latency"} {
        desktop_interaction_log_line "phase=profiled-hover-capture action=host-hover-diff status=missing before_exists=[file exists $host_taskbar_settled_before_hover_png] after_exists=[file exists $host_profiled_hover_after_png]"
    }
    if {[file exists $direct_launch_before_ppm]} {
        catch { exec convert $direct_launch_before_ppm $direct_launch_before_png }
    }
    if {[file exists $direct_launch_after_ppm]} {
        catch { exec convert $direct_launch_after_ppm $direct_launch_after_png }
    }
    if {[file exists $direct_launch_before_ppm] && [file exists $direct_launch_after_ppm]} {
        set direct_diff_pixels_text 0
        set direct_diff_out [exec sh -c "compare -metric AE '$direct_launch_before_ppm' '$direct_launch_after_ppm' '$direct_launch_diff_png' 2>&1 || true"]
        regexp {([0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?)} $direct_diff_out -> direct_diff_pixels_text
        set direct_diff_pixels [expr {int(ceil(double($direct_diff_pixels_text)))}]
        exec sh -c "printf '%s\n' '$direct_diff_pixels' > '$direct_launch_diff_txt'"
        desktop_interaction_log_line "phase=direct-launch-capture action=app-window-diff status=PASS diff_pixels=$direct_diff_pixels before=$direct_launch_before_ppm after=$direct_launch_after_ppm diff=$direct_launch_diff_png"
    } elseif {$kde_smoke_reducer eq "desktop-interaction-latency"} {
        desktop_interaction_log_line "phase=direct-launch-capture action=app-window-diff status=missing before_exists=[file exists $direct_launch_before_ppm] after_exists=[file exists $direct_launch_after_ppm]"
    }
    set color_diff_pixels "missing"
    if {$code == 0 && ![fb_visual_enabled]} {
        set code 0
    } elseif {$code == 0 && [file exists $before_ppm] && [file exists $after_ppm]} {
        set diff_pixels_text 0
        set diff_out [exec sh -c "compare -metric AE '$before_ppm' '$after_ppm' '$diff_png' 2>&1 || true"]
        regexp {([0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?)} $diff_out -> diff_pixels_text
        set diff_pixels [expr {int(ceil(double($diff_pixels_text)))}]
        set color_diff_pixels $diff_pixels
        exec sh -c "printf '%s\n' '$diff_pixels' > '$outdir/kde-plasma-input-diff.txt'"
        if {$diff_pixels < $input_diff_min} {
            if {[fb_visual_required]} {
                set code 8
                set label "KDE-PLASMA-DESKTOP-SMOKE-FAIL input-no-visible-change diff_pixels=$diff_pixels min=$input_diff_min"
            } else {
                note_visual_warning "input-readback-no-visible-change diff_pixels=$diff_pixels min=$input_diff_min"
            }
        }
    } elseif {$code == 0} {
        if {[fb_visual_required]} {
            set code 8
            set label "KDE-PLASMA-DESKTOP-SMOKE-FAIL input-capture-missing"
        } else {
            note_visual_warning "input-capture-missing"
        }
    }
    if {[file exists $before_ppm] || [file exists $after_ppm]} {
        write_color_metrics $color_diff_pixels
    }
    if {$code == 0} {
        set startup_regression "$outdir/kde-plasma-startup-regression.txt"
        catch { exec sh -c "grep -En 'automatically choosing Wayland because WAYLAND_DISPLAY is set|KWin startup attempt=[0-9]+ failed|KWin startup failed after retries' '$runlog' > '$startup_regression' || true" }
        if {[file exists $startup_regression] && [file size $startup_regression] > 0} {
            set code 8
            set label "KDE-PLASMA-DESKTOP-SMOKE-FAIL startup-retry-regression"
        }
    }
    if {$code == 0} {
        set kwin_crash_regression "$outdir/kde-plasma-kwin-crash-regression.txt"
        catch { exec sh -c "grep -En 'kwin_wayland: exception|coredump: .*kwin_wayland' '$runlog' > '$kwin_crash_regression' || true" }
        if {[file exists $kwin_crash_regression] && [file size $kwin_crash_regression] > 0} {
            set code 8
            set label "KDE-PLASMA-DESKTOP-SMOKE-FAIL kwin-crash-regression"
        }
    }
    if {$code == 0} {
        set service_regression "$outdir/kde-plasma-service-regression.txt"
        catch { exec sh -c "grep -En 'KApplicationTrader: mimeType \"x-scheme-handler/file\" not found|QString::arg: 2 argument\\(s\\) missing in Terminal|Parse error in tiles configuration for monitor|Program to run not set|Could not find .*, starting .*/bin/sh|Could not start program .*/bin/sh|Process operation timed out' '$runlog' > '$service_regression' || true" }
        if {[file exists $service_regression] && [file size $service_regression] > 0} {
            set code 8
            set label "KDE-PLASMA-DESKTOP-SMOKE-FAIL service-metadata-regression"
        }
    }
    if {$code == 0 && $kde_smoke_reducer eq "chromium-video" &&
        $chromium_video_post_strict} {
        if {$chromium_video_post_status eq "chrome-crash-regression"} {
            set code 8
            set label "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-chrome-crash-regression"
        } elseif {$chromium_video_post_status ne "perf-result-not-required" &&
                  $chromium_video_post_status ne "launch-only" &&
                  $chromium_video_post_status ne "perf-result-pass"} {
            set code 8
            set label "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-$chromium_video_post_status"
        }
    } elseif {$code == 0 && $kde_smoke_reducer eq "chromium-video" &&
              !$chromium_video_post_strict} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-WARN chromium-video-post-evidence-artifact-only status=$chromium_video_post_status"
    }
    catch { exec sh -c "{
        printf '%s\n' 'xv6 KDE virtio-gpu trace counts'
        for event in virtio_gpu_cmd_ctx_submit virtio_gpu_cmd_set_scanout virtio_gpu_cmd_res_flush virtio_gpu_fence_ctrl virtio_gpu_fence_resp virtio_gpu_cmd_res_create_3d virtio_gpu_cmd_res_xfer_toh_3d; do
            printf '%s %s\n' \"\$event\" \"\$(grep -c \"\$event\" '$qemu_trace' 2>/dev/null || true)\"
        done
    } > '$qemu_trace_summary'" }

    set label [chromium_video_result_label $label]
    write_final_status $code $label "final"
    puts "\n$label log=$runlog ppm=$ppm png=$png before_png=$before_png after_png=$after_png taskbar_settled_before_hover_png=$taskbar_settled_before_hover_png profiled_hover_after_png=$profiled_hover_after_png profiled_hover_diff_png=$profiled_hover_diff_png host_taskbar_settled_before_hover_png=$host_taskbar_settled_before_hover_png host_profiled_hover_after_png=$host_profiled_hover_after_png host_profiled_hover_diff_png=$host_profiled_hover_diff_png host_direct_launch_after_png=$host_direct_launch_after_png direct_launch_before_png=$direct_launch_before_png direct_launch_after_png=$direct_launch_after_png direct_launch_diff_png=$direct_launch_diff_png"
    exit $code
}

proc cleanup_owned_qemu {} {
    global qemu_owned_pidfile qemu_owned_token root

    if {![file exists $qemu_owned_pidfile]} {
        return
    }
    set fh [open $qemu_owned_pidfile r]
    set owned_pid [string trim [read $fh]]
    close $fh
    if {![string is integer -strict $owned_pid] || $owned_pid <= 1 ||
        ![file exists "/proc/$owned_pid/stat"]} {
        return
    }
    set fh [open "/proc/$owned_pid/stat" r]
    set stat_fields [split [string trim [read $fh]]]
    close $fh
    if {[llength $stat_fields] < 22} {
        return
    }
    set start_ticks [lindex $stat_fields 21]
    if {![string is integer -strict $start_ticks] || $start_ticks <= 0} {
        return
    }
    if {[catch {
        exec "$root/scripts/launch/cleanup-owned-qemu.sh" \
            $owned_pid $start_ticks $qemu_owned_token
    } cleanup_out]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-WARN owned-qemu-cleanup=$cleanup_out"
    } else {
        puts $cleanup_out
    }
}

proc optional_prompt {} {
    global timeout
    set old_timeout $timeout
    set timeout 3
    expect {
        -re {root:/#} {}
        timeout {}
        eof {}
    }
    set timeout $old_timeout
}

proc sync_prompt_accept_marker {marker start_ms method stale_prompt_count seconds old_timeout} {
    global timeout prompt_sync_log

    set elapsed_ms [expr {[clock milliseconds] - $start_ms}]
    set line "KDE-PLASMA-DESKTOP-SMOKE-INFO prompt-sync status=PASS method=$method marker=$marker elapsed_ms=$elapsed_ms stale_prompts=$stale_prompt_count"
    puts $line
    append_host_log_line $prompt_sync_log $line
    set prompt_seen 0
    set drain_deadline [expr {[clock milliseconds] + ($seconds * 1000)}]
    set drain_start_ms [clock milliseconds]
    set drain_quiet_ticks 0
    set quiet_no_prompt 0
    while {[clock milliseconds] < $drain_deadline && !$prompt_seen} {
        set timeout 1
        expect {
            -re [async_marker_re $marker] {}
            -re [fuzzy_async_marker_re $marker] {}
            -re {root:/#} {
                set prompt_seen 1
            }
            -re {.+[\r\n]+} {}
            timeout {
                incr drain_quiet_ticks
                if {$drain_quiet_ticks >= 3} {
                    set quiet_no_prompt 1
                    break
                }
            }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL prompt-sync-eof" }
        }
    }
    if {!$prompt_seen && !$quiet_no_prompt} {
        set drain_elapsed_ms [expr {[clock milliseconds] - $drain_start_ms}]
        set line "KDE-PLASMA-DESKTOP-SMOKE-WARN prompt-sync-drain status=NO_PROMPT marker=$marker seconds=$seconds elapsed_ms=$drain_elapsed_ms quiet_ticks=$drain_quiet_ticks"
        puts $line
        append_host_log_line $prompt_sync_log $line
        set timeout $old_timeout
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL prompt-sync-drain-timeout"
    }
    set drain_elapsed_ms [expr {[clock milliseconds] - $drain_start_ms}]
    set drain_status [expr {$prompt_seen ? "PASS" : "PASS_QUIET_NO_PROMPT"}]
    set line "KDE-PLASMA-DESKTOP-SMOKE-INFO prompt-sync-drain status=$drain_status marker=$marker elapsed_ms=$drain_elapsed_ms quiet_ticks=$drain_quiet_ticks"
    append_host_log_line $prompt_sync_log $line
    set timeout $old_timeout
    return 1
}

proc sync_prompt {{seconds 20}} {
    global timeout sync_prompt_counter prompt_sync_log
    set old_timeout $timeout
    incr sync_prompt_counter
    set marker [format "KSP%04d" $sync_prompt_counter]
    set start_ms [clock milliseconds]
    set stale_prompt_count 0
    set timeout $seconds
    send "\025"
    send "echo $marker; echo $marker; echo $marker; echo $marker; echo $marker\r"
    expect {
        -re [async_marker_re $marker] {
            return [sync_prompt_accept_marker $marker $start_ms marker $stale_prompt_count $seconds $old_timeout]
        }
        -re [fuzzy_async_marker_re $marker] {
            return [sync_prompt_accept_marker $marker $start_ms fuzzy-marker $stale_prompt_count $seconds $old_timeout]
        }
        -re {root:/#} {
            set prompt_elapsed_ms [expr {[clock milliseconds] - $start_ms}]
            if {$prompt_elapsed_ms >= 100} {
                set timeout $old_timeout
                set line "KDE-PLASMA-DESKTOP-SMOKE-INFO prompt-sync status=PASS_PROMPT_FALLBACK marker=$marker elapsed_ms=$prompt_elapsed_ms seconds=$seconds stale_prompts=$stale_prompt_count"
                puts $line
                append_host_log_line $prompt_sync_log $line
                return 1
            } else {
                incr stale_prompt_count
            }
            exp_continue -continue_timer
        }
        timeout {
            set timeout $old_timeout
            set elapsed_ms [expr {[clock milliseconds] - $start_ms}]
            set line "KDE-PLASMA-DESKTOP-SMOKE-WARN prompt-sync status=TIMEOUT marker=$marker elapsed_ms=$elapsed_ms seconds=$seconds stale_prompts=$stale_prompt_count"
            puts $line
            append_host_log_line $prompt_sync_log $line
            send "\020"
            sleep 3
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL prompt-sync-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL prompt-sync-eof" }
    }
}

proc legacy_serial_validation_enabled {} {
    return [expr {[info exists ::env(KDE_SMOKE_LEGACY_SERIAL)] && $::env(KDE_SMOKE_LEGACY_SERIAL) ne "0"}]
}

proc guest_smoke_agent_enabled {} {
    global kde_smoke_agent

    return [expr {$kde_smoke_agent ne "0"}]
}

proc kde_smoke_reducer {} {
    if {[info exists ::env(KDE_SMOKE_REDUCER)]} {
        return $::env(KDE_SMOKE_REDUCER)
    }
    return ""
}

proc launch_guest_smoke_agent {} {
    global timeout chromium_available

    set old_timeout $timeout
    set timeout 20
    send "\025"
    sleep 1
    send "\r"
    expect {
        -re {root:/#} {}
        timeout {
            set timeout $old_timeout
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL agent-prompt-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL agent-prompt-eof" }
    }

    set args ""
    if {$chromium_available} {
        append args " --require-chromium"
    }
    set clear_chromium [chromium_guest_artifact_clear_command]
    send "rm -f /tmp/kde-smoke-agent.log /tmp/kde-smoke-agent.status /tmp/kde-smoke-agent.done /kde-plasma-before.ppm /kde-plasma-after.ppm; $clear_chromium; /bin/kde-smoke-agent$args & echo KDE_SMOKE_AGENT_LAUNCHED\r"
    expect {
        -re {KDE_SMOKE_AGENT_LAUNCHED} {
            set timeout $old_timeout
            return
        }
        -re {not found|cannot execute|exec failed|status=127} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL agent-launch"
        }
        timeout {
            set timeout $old_timeout
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL agent-launch-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL agent-launch-eof" }
    }
}

proc wait_for_guest_smoke_agent {} {
    global timeout

    set old_timeout $timeout
    set timeout 420
    expect {
        -re {KDE_SMOKE_AGENT_DONE status=PASS} {
            set timeout $old_timeout
            return
        }
        -re {KDE_SMOKE_AGENT_DONE status=FAIL} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL guest-agent-fail"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL guest-agent-crash"
        }
        timeout {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL guest-agent-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL guest-agent-eof" }
    }
}

proc kde_session_ready_role_probe_fallback {} {
    global timeout kde_tolerate_ready_user_exceptions

    set old_timeout $timeout
    set ready 0

    set timeout 8
    send "\025"
    sleep 1
    send "\r"
    expect {
        -re {root:/#} {}
        timeout {}
        eof {
            set timeout $old_timeout
            return 0
        }
    }

    set timeout 12
    send "KDE_PROCESS_PROBE_TRACE=1 /bin/kde-process-probe\r"
    expect {
        -re {kde_process_probe[^\r\n]*kwin=([0-9]+)[^\r\n]*plasmashell=([0-9]+)[^\r\n]*} {
            set kwin $expect_out(1,string)
            set plasma $expect_out(2,string)
            set ready [expr {$kwin != "0" && $plasma != "0"}]
        }
        -re {(kde-exception-fatal-summary: pid=[0-9]+ name=(pactl|/usr/bin/pactl)[^\r\n]*|pid [0-9]+ (pactl|/usr/bin/pactl): fatal page fault[^\r\n]*|coredump: generating[^\r\n]*(pactl|/usr/bin/pactl)[^\r\n]*|(pactl|/usr/bin/pactl)[^\r\n]*coredump: generating[^\r\n]*)} {
            if {[tolerate_optional_pactl_ready_crash "role-probe-fallback" $expect_out(0,string)]} {
                exp_continue
            }
            set timeout $old_timeout
            finish_after_crash 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-crash"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            set timeout $old_timeout
            finish_after_crash 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-crash"
        }
        -re {pid [0-9]+ (pactl|/usr/bin/pactl): exception [0-9]+[^\r\n]*} {
            if {[tolerate_optional_pactl_ready_crash "role-probe-fallback" $expect_out(0,string)]} {
                exp_continue
            }
            if {!$kde_tolerate_ready_user_exceptions} {
                set timeout $old_timeout
                finish_after_user_exception 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-crash"
            }
            set ready 0
        }
        -re {pid [0-9]+ [^:\r\n]+: exception [0-9]+} {
            if {!$kde_tolerate_ready_user_exceptions} {
                set timeout $old_timeout
                finish_after_user_exception 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-crash"
            }
            set ready 0
        }
        -re {exec failed|not found|cannot execute|status=127} {
            set ready 0
        }
        timeout {
            set ready 0
        }
        eof {
            set timeout $old_timeout
            return 0
        }
    }
    set timeout $old_timeout
    optional_prompt
    return $ready
}

proc wait_for_kde_session_ready {} {
    global timeout kde_tolerate_ready_user_exceptions
    set old_timeout $timeout
    set timeout 240
    expect {
        -re {kde-session: KWin and plasmashell are running} {
            set timeout $old_timeout
            return
        }
        -re {KWin startup failed after retries} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-startup-retry"
        }
        -re {KWin startup attempt=([0-9]+) failed, retrying} {
            puts "KDE-PLASMA-DESKTOP-SMOKE-INFO kde-session-startup-retry attempt=$expect_out(1,string)"
            exp_continue
        }
        -re {(kde-exception-fatal-summary: pid=[0-9]+ name=(pactl|/usr/bin/pactl)[^\r\n]*|pid [0-9]+ (pactl|/usr/bin/pactl): fatal page fault[^\r\n]*|coredump: generating[^\r\n]*(pactl|/usr/bin/pactl)[^\r\n]*|(pactl|/usr/bin/pactl)[^\r\n]*coredump: generating[^\r\n]*)} {
            if {[tolerate_optional_pactl_ready_crash "session-ready" $expect_out(0,string)]} {
                exp_continue
            }
            finish_after_crash 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-crash"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|exec failed|not found|status=127} {
            finish_after_crash 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-crash"
        }
        -re {pid [0-9]+ (pactl|/usr/bin/pactl): exception [0-9]+[^\r\n]*} {
            if {[tolerate_optional_pactl_ready_crash "session-ready" $expect_out(0,string)]} {
                exp_continue
            }
            if {!$kde_tolerate_ready_user_exceptions} {
                finish_after_user_exception 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-crash"
            }
            exp_continue
        }
        -re {pid [0-9]+ [^:\r\n]+: exception [0-9]+} {
            if {!$kde_tolerate_ready_user_exceptions} {
                finish_after_user_exception 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-crash"
            }
            exp_continue
        }
        timeout {
            if {[kde_session_ready_role_probe_fallback]} {
                set timeout $old_timeout
                return
            }
            set timeout $old_timeout
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-eof" }
    }
    set timeout $old_timeout
}

proc x11_egl_session_probe_wait_seconds {} {
    if {[info exists ::env(KDE_SMOKE_X11_EGL_SESSION_WAIT)] &&
        $::env(KDE_SMOKE_X11_EGL_SESSION_WAIT) ne ""} {
        if {[regexp {^[0-9]+$} $::env(KDE_SMOKE_X11_EGL_SESSION_WAIT)] &&
            $::env(KDE_SMOKE_X11_EGL_SESSION_WAIT) >= 1 &&
            $::env(KDE_SMOKE_X11_EGL_SESSION_WAIT) <= 300} {
            return $::env(KDE_SMOKE_X11_EGL_SESSION_WAIT)
        }
        puts "KDE-PLASMA-DESKTOP-SMOKE-WARN ignoring-invalid-x11-egl-session-wait=$::env(KDE_SMOKE_X11_EGL_SESSION_WAIT)"
    }
    return 120
}

proc x11_egl_session_probe_result_from_text {text status_var exit_status_var} {
    upvar 1 $status_var status
    upvar 1 $exit_status_var exit_status

    if {[regexp {kde-session: x11-egl-session-probe status=(PASS|FAIL|TIMEOUT) exit_status=([0-9]+)} $text -> found_status found_exit_status]} {
        set status $found_status
        set exit_status $found_exit_status
        return 1
    }
    if {[regexp {host-x11-egl-smoke: phase=session_probe status=(PASS|FAIL|TIMEOUT)[^\r\n]*exit_status=([0-9]+)} $text -> found_status found_exit_status]} {
        set status $found_status
        set exit_status $found_exit_status
        return 1
    }
    return 0
}

proc x11_egl_session_probe_result_from_artifact {status_var exit_status_var} {
    upvar 1 $status_var status
    upvar 1 $exit_status_var exit_status

    set text ""
    if {![read_x11_egl_host_artifact_log text]} {
        return 0
    }
    return [x11_egl_session_probe_result_from_text $text status exit_status]
}

proc x11_egl_session_probe_result_from_runlog {status_var exit_status_var} {
    global runlog
    upvar 1 $status_var status
    upvar 1 $exit_status_var exit_status

    if {![file exists $runlog]} {
        return 0
    }

    set fh [open $runlog r]
    set text [read $fh]
    close $fh
    return [x11_egl_session_probe_result_from_text $text status exit_status]
}

proc wait_for_x11_egl_session_probe_terminal {} {
    global timeout

    set wait_seconds [x11_egl_session_probe_wait_seconds]
    set old_timeout $timeout
    set status ""
    set exit_status ""

    if {[x11_egl_session_probe_result_from_artifact status exit_status]} {
        return [list $status $exit_status]
    }
    if {[x11_egl_session_probe_result_from_runlog status exit_status]} {
        return [list $status $exit_status]
    }

    set timeout $wait_seconds
    expect {
        -re {kde-session: x11-egl-session-probe status=(PASS|FAIL|TIMEOUT) exit_status=([0-9]+)} {
            set status [string trim $expect_out(1,string)]
            set exit_status [string trim $expect_out(2,string)]
            set timeout $old_timeout
            return [list $status $exit_status]
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            set timeout $old_timeout
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-session-probe-crash"
        }
        timeout {
            set timeout $old_timeout
            if {[x11_egl_session_probe_result_from_artifact status exit_status]} {
                return [list $status $exit_status]
            }
            if {[x11_egl_session_probe_result_from_runlog status exit_status]} {
                return [list $status $exit_status]
            }
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-session-probe-terminal-timeout"
        }
        eof {
            set timeout $old_timeout
            if {[x11_egl_session_probe_result_from_artifact status exit_status]} {
                return [list $status $exit_status]
            }
            if {[x11_egl_session_probe_result_from_runlog status exit_status]} {
                return [list $status $exit_status]
            }
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-session-probe-eof"
        }
    }
    set timeout $old_timeout
    optional_prompt
    return [list $status $exit_status]
}

proc run_guest_check {command label timeout_seconds} {
    global timeout
    set old_timeout $timeout
    sync_prompt
    set timeout $timeout_seconds
    send [format {%s; echo %s_STATUS:$?} $command $label]
    send "\r"
    expect {
        -re {kde_wayland_seat_probe timeout phase=(startup|connect|registry|roundtrip-[0-9]+|validate)} {
            set phase [string trim $expect_out(1,string)]
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-timeout-$phase"
        }
        -re {kde_wayland_seat_probe (connect failed|roundtrip-[0-9]+ failed|no wl_seat|no seat capabilities|no pointer capability|no keyboard capability|pointer capability without object|invalid pointer version)} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-output-fail"
        }
        -re {kde_[a-z0-9_]+_probe result=FAIL} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-output-fail"
        }
        -re {kde_[a-z0-9_]+_probe result=([1-9][0-9]*)} {
            set result [string trim $expect_out(1,string)]
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-result-$result"
        }
        -re {kde_[a-z0-9_]+_probe result=PASS} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_[a-z0-9_]+_probe result=0} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_libinput_probe[^\r\n]*event0=[0-9]+[^\r\n]*event1=[0-9]+} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_drm_probe done} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_app_launch_probe[^\r\n]*status=FAIL} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-output-fail"
        }
        -re {kde_process_probe[^\r\n]*status=WAIT} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-output-wait"
        }
        -re {kde_wayland_seat_probe[^\r\n]*caps=0x[0-9a-fA-F]+[^\r\n]*keyboard_events=[0-9]+} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_app_launch_probe[^\r\n]*status=PASS} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_process_probe[^\r\n]*status=PASS} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {status=PASS} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re [format {%s_STATUS:([0-9]+)} $label] {
            set status [string trim $expect_out(1,string)]
            set timeout $old_timeout
            optional_prompt
            if {$status ne "0"} {
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-status-$status"
            }
            return
        }
        timeout {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-status-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-status-eof" }
    }
    set timeout $old_timeout
    optional_prompt
}

proc run_kwin_loader_ifunc_check {} {
    global guest_kwin_loader_ifunc_log kwin_loader_ifunc_log
    global kde_preflight_enabled

    if {!$kde_preflight_enabled} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-WARN kwin-loader-ifunc-check-skipped preflight=disabled"
        return
    }

    wait_for_kde_preflight_runner_status "kwin" 180
    dump_optional_guest_artifact $guest_kwin_loader_ifunc_log $kwin_loader_ifunc_log
    if {![file exists $kwin_loader_ifunc_log]} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kwin-loader-ifunc-missing-log"
    }
    set log_text [read_text_file $kwin_loader_ifunc_log]
    if {![regexp {KDE_DLOPEN_PROBE_KWIN_HELP_RESULT status=PASS} $log_text]} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kwin-loader-ifunc-missing-help"
    }
}

proc run_qtqml_ifunc_startup_check {} {
    global guest_qtqml_ifunc_log guest_qtqml_ifunc_status
    global qtqml_ifunc_log qtqml_ifunc_status
    global kde_preflight_enabled

    if {!$kde_preflight_enabled} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-WARN qtqml-ifunc-startup-check-skipped preflight=disabled"
        return
    }

    wait_for_kde_preflight_runner_status "qtqml" 180
    dump_optional_guest_artifact $guest_qtqml_ifunc_log $qtqml_ifunc_log
    dump_optional_guest_artifact $guest_qtqml_ifunc_status $qtqml_ifunc_status

    set log_text ""
    set status_text ""
    if {[file exists $qtqml_ifunc_log]} {
        set log_text [read_text_file $qtqml_ifunc_log]
    }
    if {[file exists $qtqml_ifunc_status]} {
        set status_text [read_text_file $qtqml_ifunc_status]
    }
    set saw_map_pass 0
    set saw_result_pass 0
    set saw_memmove_pass 0
    set saw_probe_pass 0
    if {[regexp {KDE_QTQML_IFUNC_STARTUP_PROBE_MAP status=PASS} $log_text]} {
        set saw_map_pass 1
    }
    if {[regexp {KDE_QTQML_IFUNC_STARTUP_PROBE_RESULT status=PASS} $log_text]} {
        set saw_result_pass 1
    }
    if {[regexp {KDE_QTQML_IFUNC_STARTUP_PROBE_SYMBOL status=PASS name=memmove lib=[^\r\n]*libxv6-ifunc-memcpy\.so} $log_text]} {
        set saw_memmove_pass 1
    }
    if {[regexp {__KDE_QTQML_IFUNC_PASS__} $log_text]} {
        set saw_probe_pass 1
    }
    if {![regexp {status=DONE source=kde-qtqml-ifunc-startup-probe} $status_text]} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-qtqml-ifunc-startup-missing-status-done"
    }
    if {!$saw_probe_pass} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-qtqml-ifunc-startup-missing-probe-pass"
    }
    if {!$saw_map_pass} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-qtqml-ifunc-startup-missing-map-pass"
    }
    if {!$saw_result_pass} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-qtqml-ifunc-startup-missing-result-pass"
    }
    if {!$saw_memmove_pass} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-qtqml-ifunc-startup-missing-memmove-pass"
    }
}

proc run_kwin_screenshot_probe {} {
    global timeout

    set old_timeout $timeout
    sync_prompt
    set timeout 45
    set label "kde-kwin-screenshot-probe"
    send [format {/bin/kde-kwin-screenshot-probe; echo %s_STATUS:$?} $label]
    send "\r"
    expect {
        -re {kde_kwin_screenshot_probe result=PASS} {
            set timeout $old_timeout
            optional_prompt
            return 1
        }
        -re {kde_kwin_screenshot_probe result=FAIL} {
            set timeout $old_timeout
            note_visual_warning "kwin-screenshot-readback-black"
            optional_prompt
            return 0
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-kwin-screenshot-probe-crash"
        }
        timeout {
            set timeout $old_timeout
            note_visual_warning "kwin-screenshot-probe-timeout"
            optional_prompt
            return 0
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-kwin-screenshot-probe-eof" }
    }
    set timeout $old_timeout
    note_visual_warning "kwin-screenshot-probe-unmatched"
    optional_prompt
    return 0
}

proc run_wayland_seat_probe {} {
    for {set attempt 1} {$attempt <= 4} {incr attempt} {
        set label [format "kde-wayland-seat-probe-%d" $attempt]
        set old_timeout $::timeout
        sync_prompt
        set ::timeout 35
        send [format {/bin/kde-wayland-seat-probe; echo %s_STATUS:$?} $label]
        send "\r"
        expect {
            -re {kde_wayland_seat_probe[^\r\n]*caps=0x[0-9a-fA-F]+[^\r\n]*keyboard_events=[0-9]+} {
                set ::timeout $old_timeout
                optional_prompt
                return
            }
            -re {kde_wayland_seat_probe timeout phase=(startup|connect|registry|roundtrip-[0-9]+|validate)} {
                set phase [string trim $expect_out(1,string)]
                set ::timeout $old_timeout
                optional_prompt
                if {$attempt == 4} {
                    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-seat-probe-timeout-$phase"
                }
                sleep 5
            }
            -re {kde_wayland_seat_probe (connect failed|roundtrip-[0-9]+ failed|no wl_seat|no seat capabilities|no pointer capability|no keyboard capability|pointer capability without object|invalid pointer version)} {
                set ::timeout $old_timeout
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-seat-probe-output-fail"
            }
            -re [format {%s_STATUS:([1-9][0-9]*)} $label] {
                set status [string trim $expect_out(1,string)]
                set ::timeout $old_timeout
                if {$attempt == 4} {
                    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-seat-probe-status-$status"
                }
                optional_prompt
                sleep 5
            }
            timeout {
                set ::timeout $old_timeout
                if {$attempt == 4} {
                    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-seat-probe-status-timeout"
                }
                optional_prompt
                sleep 5
            }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-seat-probe-eof" }
        }
        set ::timeout $old_timeout
    }

    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-seat-probe-output-fail"
}

proc run_session_liveness_probe {label} {
    global timeout guest_session_liveness_log session_liveness_log
    global guest_session_liveness_script outdir

    set old_timeout $timeout
    sync_prompt
    set timeout 90
    send "/bin/bash $guest_session_liveness_script [shell_quote $label] < /dev/null; echo KSLC_STATUS:$?\r"
    expect {
        -re {KSLC_STATUS:([0-9]+)} {
            set status [string trim $expect_out(1,string)]
            set timeout $old_timeout
            optional_prompt
            dump_optional_guest_artifact $guest_session_liveness_log $session_liveness_log
            set safe_label $label
            regsub -all {[^A-Za-z0-9_.-]} $safe_label {_} safe_label
            catch { file copy -force $session_liveness_log "$outdir/kde-session-liveness-$safe_label.log" }
            set log_text ""
            if {[file exists $session_liveness_log]} {
                set log_text [read_text_file $session_liveness_log]
            }
            if {$status eq "0" &&
                [regexp {session_liveness_before_chromium result=PASS rc=0} $log_text]} {
                return
            }
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            set timeout $old_timeout
            dump_optional_guest_artifact $guest_session_liveness_log $session_liveness_log
            set safe_label $label
            regsub -all {[^A-Za-z0-9_.-]} $safe_label {_} safe_label
            catch { file copy -force $session_liveness_log "$outdir/kde-session-liveness-$safe_label.log" }
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-crash"
        }
        timeout {
            set timeout $old_timeout
            dump_optional_guest_artifact $guest_session_liveness_log $session_liveness_log
            set safe_label $label
            regsub -all {[^A-Za-z0-9_.-]} $safe_label {_} safe_label
            catch { file copy -force $session_liveness_log "$outdir/kde-session-liveness-$safe_label.log" }
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-timeout"
        }
        eof {
            set timeout $old_timeout
            dump_optional_guest_artifact $guest_session_liveness_log $session_liveness_log
            set safe_label $label
            regsub -all {[^A-Za-z0-9_.-]} $safe_label {_} safe_label
            catch { file copy -force $session_liveness_log "$outdir/kde-session-liveness-$safe_label.log" }
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-eof"
        }
    }
    set timeout $old_timeout
}

proc run_wayland_registry_probe {label} {
    global timeout guest_wayland_registry_probe_script
    global guest_wayland_registry_probe_log wayland_registry_probe_log

    set old_timeout $timeout
    sync_prompt
    set timeout 90
    send "/bin/bash $guest_wayland_registry_probe_script [shell_quote $label]; echo KWRP_STATUS:$?\r"
    expect {
        -re {KWRP_STATUS:([0-9]+)} {
            set status [string trim $expect_out(1,string)]
            set timeout $old_timeout
            optional_prompt
            dump_optional_guest_artifact $guest_wayland_registry_probe_log $wayland_registry_probe_log
            set log_text ""
            if {[file exists $wayland_registry_probe_log]} {
                set log_text [read_text_file $wayland_registry_probe_log]
            }
            if {$status eq "0" &&
                [regexp {kde_wayland_registry_probe result=PASS[^\n]*wl_shm=[1-9][0-9]*[^\n]*shm_bound=1[^\n]*shm_buffer=1} $log_text]} {
                return
            }
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            set timeout $old_timeout
            dump_optional_guest_artifact $guest_wayland_registry_probe_log $wayland_registry_probe_log
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-crash"
        }
        timeout {
            set timeout $old_timeout
            dump_optional_guest_artifact $guest_wayland_registry_probe_log $wayland_registry_probe_log
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-timeout"
        }
        eof {
            set timeout $old_timeout
            dump_optional_guest_artifact $guest_wayland_registry_probe_log $wayland_registry_probe_log
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-eof"
        }
    }
    set timeout $old_timeout
}

proc run_optional_chromium_probe {} {
    global timeout chromium_available
    if {!$chromium_available} {
        return
    }

    set old_timeout $timeout
    sync_prompt
    set timeout 90
    set label "kde-chromium-app-launch-probe"

    set clear_chromium [chromium_guest_artifact_clear_command]
    send "$clear_chromium; /bin/kde-app-launch-probe --require-chromium\r"
    expect {
        -re {kde_app_launch_probe[^\r\n]*chromium=1[^\r\n]*status=PASS} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_app_launch_probe[^\r\n]*status=FAIL} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-output-fail"
        }
        timeout {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-eof" }
    }
    set timeout $old_timeout
    optional_prompt
}

proc run_kde_wayland_client_liveness_reducer {} {
    global timeout host_wlegl_available guest_host_wlegl_smoke_log
    global host_wlegl_smoke_log wayland_client_liveness_delay_seconds
    global wayland_client_liveness_runtime_seconds
    global guest_wayland_client_liveness_script

    if {!$host_wlegl_available} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-host-wlegl-missing"
    }

    run_session_liveness_probe "kde-wayland-client-liveness-before"
    if {$wayland_client_liveness_delay_seconds > 0} {
        sleep $wayland_client_liveness_delay_seconds
        run_session_liveness_probe "kde-wayland-client-liveness-delayed-${wayland_client_liveness_delay_seconds}s"
    }

    set old_timeout $timeout
    sync_prompt
    set timeout 30
    set clear_marker "KWCLCLEAR"
    send "/bin/sh $guest_wayland_client_liveness_script clear; echo $clear_marker\r"
    expect {
        -re [async_marker_re $clear_marker] {
            set timeout $old_timeout
            optional_prompt
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|kde-exception-fatal-summary|pid [0-9]+ [^:\r\n]+: exception [0-9]+} {
            set timeout $old_timeout
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-clear-crash"
        }
        timeout {
            set timeout $old_timeout
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-clear-timeout"
        }
        eof {
            set timeout $old_timeout
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-clear-eof"
        }
    }

    sync_prompt
    set timeout 30
    set start_marker "KWCLSTART"
    send "/bin/sh $guest_wayland_client_liveness_script launch; echo $start_marker\r"
    expect {
        -re [async_marker_re $start_marker] {
            set timeout $old_timeout
            optional_prompt
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|kde-exception-fatal-summary|pid [0-9]+ [^:\r\n]+: exception [0-9]+} {
            set timeout $old_timeout
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-launch-crash"
        }
        timeout {
            set timeout $old_timeout
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-start-timeout"
        }
        eof {
            set timeout $old_timeout
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-start-eof"
        }
    }

    set ready 0
    set fail_line ""
    set deadline [expr {[clock seconds] + 60}]
    while {[clock seconds] < $deadline && !$ready} {
        set timeout 8
        set poll_marker "KWCLPOLL"
        send "/bin/sh $guest_wayland_client_liveness_script status; echo $poll_marker\r"
        expect {
            -re {host-wlegl-smoke: ready frame=[^\r\n]*} {
                set ready 1
                exp_continue
            }
            -re {host-wlegl-smoke: (wl_display_connect failed|missing globals|configure dispatch failed|wl_egl_window_create failed|egl[A-Za-z0-9]+ failed)[^\r\n]*} {
                set fail_line $expect_out(0,string)
                exp_continue
            }
            -re [marker_re $poll_marker] {
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|kde-exception-fatal-summary|pid [0-9]+ [^:\r\n]+: exception [0-9]+} {
                set timeout $old_timeout
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-ready-crash"
            }
            timeout {
            }
            eof {
                set timeout $old_timeout
                finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-ready-eof"
            }
        }
        if {$fail_line ne "" && !$ready} {
            set timeout $old_timeout
            dump_optional_guest_artifact $guest_host_wlegl_smoke_log $host_wlegl_smoke_log
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-client-fail"
        }
        if {!$ready} {
            sleep 1
        }
    }
    set timeout $old_timeout
    dump_optional_guest_artifact $guest_host_wlegl_smoke_log $host_wlegl_smoke_log
    if {!$ready} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-ready-timeout"
    }

    sleep $wayland_client_liveness_runtime_seconds
    run_session_liveness_probe "kde-wayland-client-liveness-post-launch"

    set old_timeout $timeout
    set timeout 30
    set stop_marker "KWCLSTOP"
    send "/bin/sh $guest_wayland_client_liveness_script stop; echo $stop_marker\r"
    expect {
        -re [async_marker_re $stop_marker] {
            set timeout $old_timeout
            optional_prompt
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|kde-exception-fatal-summary|pid [0-9]+ [^:\r\n]+: exception [0-9]+} {
            set timeout $old_timeout
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-stop-crash"
        }
        timeout {
            puts "KDE-PLASMA-DESKTOP-SMOKE-WARN kde-wayland-client-liveness-stop-timeout-continuing"
            set timeout $old_timeout
            optional_prompt
        }
        eof {
            set timeout $old_timeout
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-client-liveness-stop-eof"
        }
    }
    sleep 1
    dump_optional_guest_artifact $guest_host_wlegl_smoke_log $host_wlegl_smoke_log
    run_session_liveness_probe "kde-wayland-client-liveness-post-exit"
    finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=kde-wayland-client-liveness delay_seconds=$wayland_client_liveness_delay_seconds runtime_seconds=$wayland_client_liveness_runtime_seconds"
}

proc run_chromium_video_capture {{require_prompt 1}} {
    global timeout chromium_video_sample_count chromium_video_sample_interval_ms
    global guest_chromium_video_capture_script guest_chromium_video_capture_log
    global guest_chromium_video_capture_status_script

    set start_marker "KCVCAPSTART"
    set wait_marker "KCVCAPWAIT"
    set sleep_seconds [expr {($chromium_video_sample_interval_ms + 999) / 1000}]
    if {$sleep_seconds < 1} {
        set sleep_seconds 1
    }
    set old_timeout $timeout
    if {$require_prompt} {
        sync_prompt
    }
    if {$chromium_video_sample_count == 0} {
        set timeout 30
        send "/bin/bash $guest_chromium_video_capture_script < /dev/null; echo $wait_marker\r"
        expect {
            -re {status=DONE[^\r\n]*} {
                exp_continue
            }
            -re {kde_chromium_video_capture done[^\r\n]*} {
                exp_continue
            }
            -re [marker_re $wait_marker] {
                set timeout $old_timeout
                optional_prompt
                return
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                drain_crash_diagnostics 4
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-capture-skip-crash"
            }
            timeout {
                puts "KDE-PLASMA-DESKTOP-SMOKE-WARN chromium-video-capture-skip-marker-timeout-continuing"
                set timeout $old_timeout
                optional_prompt
                return
            }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-capture-skip-eof" }
        }
    }
    set timeout [expr {60 + ($chromium_video_sample_count * ($sleep_seconds + 10))}]
    if {$timeout > 240} {
        set timeout 240
    }
    set deadline [expr {[clock seconds] + $timeout}]
    send "echo $start_marker; echo $start_marker; echo $start_marker; /bin/bash $guest_chromium_video_capture_script < /dev/null >/dev/null 2>&1 &\r"
    expect {
        -re [async_marker_re $start_marker] {
            optional_prompt
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            drain_crash_diagnostics 4
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-capture-start-crash"
        }
        timeout {
            puts "KDE-PLASMA-DESKTOP-SMOKE-WARN chromium-video-capture-start-marker-timeout-continuing"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-capture-start-eof" }
    }
    while {[clock seconds] < $deadline} {
        set saw_done 0
        set timeout 8
        send "/bin/bash $guest_chromium_video_capture_status_script; echo $wait_marker\r"
        expect {
            -re {status=DONE[^\r\n]*} {
                set saw_done 1
                exp_continue
            }
            -re {kde_chromium_video_capture done[^\r\n]*} {
                set saw_done 1
                exp_continue
            }
            -re {status=running[^\r\n]*} {
                exp_continue
            }
            -re {No such file|not found|cannot execute} {
                exp_continue
            }
            -re [marker_re $wait_marker] {
            }
            -re {fbstat: [^\r\n]+} {
                puts "KDE-PLASMA-DESKTOP-SMOKE-WARN chromium-video-capture-fbstat-output"
                exp_continue
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                drain_crash_diagnostics 4
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-capture-crash"
            }
            timeout {
            }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-capture-eof" }
        }
        if {$saw_done} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        sleep 1
    }
    set timeout $old_timeout
    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-capture-status-timeout"
}

proc drain_crash_diagnostics {{seconds 4}} {
    global timeout

    set old_timeout $timeout
    set deadline [expr {[clock milliseconds] + ($seconds * 1000)}]
    while {[clock milliseconds] < $deadline} {
        set timeout 1
        expect {
            -re {[^\r\n]*[\r\n]} {
            }
            timeout {
            }
            eof {
                break
            }
        }
    }
    set timeout $old_timeout
}

proc wait_chromium_video_kprofile_done {} {
    global timeout chromium_video_kprofile chromium_video_kprofile_seconds
    global guest_chromium_launch_probe_log

    if {$chromium_video_kprofile ne "1"} {
        return
    }
    # kprofile prints its whole report only after the profiled child
    # exits (its --timeout-ms SIGTERM fires kprofile_seconds after
    # launch, plus TERM->KILL escalation).  Without this wait the
    # harness reaches sync/teardown first and the probe log stays
    # empty (observed 2026-07-04).  kprofile's final output line is
    # "exec_ms <n>"; poll for it with a short guest command (serial
    # line-length limit) until the kprofile window plus escalation
    # slack has passed.
    set old_timeout $timeout
    set wait_seconds [expr {$chromium_video_kprofile_seconds + 30}]
    if {$wait_seconds > 240} {
        set wait_seconds 240
    }
    set deadline [expr {[clock seconds] + $wait_seconds}]
    set marker "KCVPWAIT"
    while {[clock seconds] < $deadline} {
        set saw_done 0
        set timeout 8
        send "grep exec_ms $guest_chromium_launch_probe_log; echo $marker\r"
        expect {
            -re {exec_ms +[0-9]+} {
                set saw_done 1
                exp_continue
            }
            -re [marker_re $marker] {
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-kprofile-completion-crash"
            }
            timeout {
            }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-kprofile-completion-eof" }
        }
        if {$saw_done} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        sleep 2
    }
    set timeout $old_timeout
    puts "KDE-PLASMA-DESKTOP-SMOKE-WARN chromium-video-kprofile-wait-timeout"
    optional_prompt
}

proc wait_chromium_video_sampler_done {} {
    global timeout guest_chromium_video_sampler_status_script
    global guest_chromium_video_sampler_log chromium_video_fast_census_ms
    global chromium_video_sampler_ms chromium_video_sampler_burst_ms
    global chromium_video_wait_census_ms
    global chromium_video_sample_count guest_chromium_video_sampler_status

    set old_timeout $timeout
    set sampler_total_ms [expr {$chromium_video_sampler_ms + $chromium_video_sampler_burst_ms}]
    set census_total_ms $chromium_video_fast_census_ms
    if {$chromium_video_wait_census_ms > $census_total_ms} {
        set census_total_ms $chromium_video_wait_census_ms
    }
    set wait_seconds [expr {45 + (($sampler_total_ms + 999) / 1000)}]
    set census_wait_seconds [expr {45 + (($census_total_ms + 999) / 1000)}]
    if {$census_wait_seconds > $wait_seconds} {
        set wait_seconds $census_wait_seconds
    }
    if {$wait_seconds > 240} {
        set wait_seconds 240
    }
    set deadline [expr {[clock seconds] + $wait_seconds}]
    set marker "KCVSWAIT"
    while {[clock seconds] < $deadline} {
        set saw_done 0
        set saw_sampler_pass 0
        set timeout 8
        send "/bin/bash $guest_chromium_video_sampler_status_script; echo $marker\r"
        expect {
            -re {status=DONE[^\r\n]*} {
                set saw_done 1
                exp_continue
            }
            -re {kde_app_launch_probe chromium_sample_only=1 [^\r\n]*status=PASS[^\r\n]*} {
                set saw_sampler_pass 1
                exp_continue
            }
            -re {kde_app_launch_probe chromium_fast_census_only=[01] [^\r\n]*status=PASS[^\r\n]*} {
                exp_continue
            }
            -re {status=running[^\r\n]*} {
                exp_continue
            }
            -re {No such file|not found|cannot execute} {
                exp_continue
            }
            -re [marker_re $marker] {
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-sampler-completion-crash"
            }
            timeout {
            }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-sampler-completion-eof" }
        }
        if {$saw_done || $saw_sampler_pass} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        sleep 1
    }
    set timeout $old_timeout
    if {$chromium_video_sample_count == 0} {
        set skip_marker "KCVSSKIPDONE"
        set timeout 20
        send "printf '%s\\n' 'status=DONE result=SKIP reason=process-only-sampler-timeout samples=0' > $guest_chromium_video_sampler_status; sync; echo $skip_marker\r"
        expect {
            -re [marker_re $skip_marker] {
                set timeout $old_timeout
                optional_prompt
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-sampler-skip-crash"
            }
            timeout {
                set timeout $old_timeout
                optional_prompt
            }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-sampler-skip-eof" }
        }
        set timeout $old_timeout
        puts "KDE-PLASMA-DESKTOP-SMOKE-WARN chromium-video-sampler-process-only-timeout status=SKIP samples=0"
        return
    }
    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-sampler-completion-timeout"
}

proc run_chromium_video_egl_gbm_probe {} {
    global timeout host_egl_gbm_available guest_chromium_video_egl_gbm_script
    global chromium_video_egl_gbm_preprobe

    if {$chromium_video_egl_gbm_preprobe ne "1"} {
        return
    }

    if {!$host_egl_gbm_available} {
        return
    }

    set old_timeout $timeout
    sync_prompt
    set timeout 120
    set egl_gbm_done_marker "KCVEGLDONE"
    send "/bin/bash $guest_chromium_video_egl_gbm_script; echo $egl_gbm_done_marker\r"
    expect {
        -re [marker_re $egl_gbm_done_marker] {
            set timeout $old_timeout
            wait_for_chromium_video_egl_gbm_artifacts 30
            optional_prompt
            return
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|kde-exception-fatal-summary|pid [0-9]+ [^:\r\n]+: exception [0-9]+} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-egl-gbm-probe-crash"
        }
        timeout {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-egl-gbm-probe-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-egl-gbm-probe-eof" }
    }
}

proc run_chromium_video_rela_preprobe {} {
    global timeout chromium_video_rela_preprobe
    global guest_chromium_video_rela_preprobe_script

    if {$chromium_video_rela_preprobe ne "1"} {
        return
    }

    set old_timeout $timeout
    sync_prompt
    set timeout 180
    set rela_done_marker "KCVRELADONE"
    send "/bin/bash $guest_chromium_video_rela_preprobe_script; echo $rela_done_marker\r"
    expect {
        -re [marker_re $rela_done_marker] {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|kde-exception-fatal-summary|pid [0-9]+ [^:\r\n]+: exception [0-9]+} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-rela-preprobe-crash"
        }
        timeout {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-rela-preprobe-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-rela-preprobe-eof" }
    }
}

proc run_chromium_video_wait_for_playback {} {
    global timeout chromium_video_wait_for_playback_seconds
    global guest_wayland_chromium_log

    if {$chromium_video_wait_for_playback_seconds <= 0} {
        return 0
    }

    set old_timeout $timeout
    optional_prompt
    set timeout 2
    for {set i 0} {$i < $chromium_video_wait_for_playback_seconds} {incr i} {
        send "grep 'PERF-VIDEO' $guest_wayland_chromium_log 2>/dev/null\r"
        expect {
            -re {PERF-VIDEO (event:playing|tick|RESULT)[^\r\n]*} {
                set timeout $old_timeout
                optional_prompt
                return 1
            }
            -re {root:/#} {
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                drain_after_crash_match 3
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-playback-wait-crash"
            }
            timeout {
                # Keep polling; absence of playback is classified in post-evidence.
            }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-playback-wait-eof" }
        }
        sleep 1
    }
    set timeout $old_timeout
    optional_prompt
    return 0
}

proc run_chromium_video_reducer {} {
    global timeout chromium_available chromium_video_url
    global chromium_video_warmup_seconds chromium_video_sample_count
    global chromium_video_result_wait_seconds
    global chromium_video_proof_mode chromium_video_limitation
    global chromium_video_final_sync_status
    global chromium_launch_only
    global chromium_video_multiprocess chromium_video_disable_audio_output
    global pre_chromium_liveness_delay_seconds
    global guest_chromium_video_clear_script
    global guest_chromium_video_launch_script guest_chromium_video_sampler_script
    global guest_chromium_video_sampler_status_script
    global guest_chromium_video_capture_script
    global guest_chromium_video_sampler_status

    if {!$chromium_available} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-chromium-missing"
    }

    if {$chromium_video_url eq ""} {
        chromium_video_select_url
    }
    if {$chromium_video_proof_mode eq "launch-log-only" &&
        $chromium_launch_only ne "1"} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-no-local-video-asset"
    }
    set old_timeout $timeout
    wait_for_roles "chromium-video-session-invalid" 1 0 3 1

    sync_prompt
    set clear_done_marker "KCD"
    set timeout 60
    send "/bin/bash $guest_chromium_video_clear_script < /dev/null; echo $clear_done_marker; echo $clear_done_marker; echo $clear_done_marker\r"
    expect {
        -re [async_marker_re $clear_done_marker] {
            set timeout $old_timeout
            optional_prompt
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-clear-crash"
        }
        timeout {
            puts "KDE-PLASMA-DESKTOP-SMOKE-WARN chromium-video-clear-marker-timeout-resync"
            set timeout $old_timeout
            optional_prompt
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-clear-eof" }
    }
    set timeout $old_timeout
    run_chromium_video_egl_gbm_probe
    run_chromium_video_rela_preprobe
    run_session_liveness_probe "session-liveness-before-chromium"
    if {$pre_chromium_liveness_delay_seconds > 0} {
        sleep $pre_chromium_liveness_delay_seconds
        run_session_liveness_probe "session-liveness-before-chromium-delayed-${pre_chromium_liveness_delay_seconds}s"
    }
    run_wayland_registry_probe "wayland-registry-before-chromium"
    optional_prompt
    set timeout 30
    set launch_begin_marker "KCVBEGIN"
    send "echo $launch_begin_marker; echo $launch_begin_marker; echo $launch_begin_marker; echo $launch_begin_marker; echo $launch_begin_marker\r"
    expect {
        -re [async_marker_re $launch_begin_marker] {
            set timeout $old_timeout
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-marker-crash"
        }
        timeout {
            puts "KDE-PLASMA-DESKTOP-SMOKE-WARN chromium-video-marker-timeout-continuing"
            set timeout $old_timeout
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-marker-eof" }
    }
    optional_prompt
    set timeout 180
    set launch_started_marker "KCVLSTART"
    send "echo $launch_started_marker; echo $launch_started_marker; echo $launch_started_marker; echo $launch_started_marker; echo $launch_started_marker; /bin/bash $guest_chromium_video_launch_script < /dev/null &\r"
    expect {
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-launch-crash"
        }
        -re [async_marker_re $launch_started_marker] {
            set timeout $old_timeout
            optional_prompt
        }
        timeout {
            puts "KDE-PLASMA-DESKTOP-SMOKE-WARN chromium-video-launch-marker-timeout-continuing"
            set timeout $old_timeout
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-launch-eof" }
    }
    set timeout $old_timeout
    send "/bin/bash $guest_chromium_video_sampler_script < /dev/null &\r"
    sleep 1
    optional_prompt
    set timeout $old_timeout
    set timeout 20
    send "/bin/bash $guest_chromium_video_sampler_status_script; echo KCVSSTAT\r"
    expect {
        -re [marker_re "KCVSSTAT"] {
            set timeout $old_timeout
            optional_prompt
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-sampler-status-crash"
        }
        timeout {
            puts "KDE-PLASMA-DESKTOP-SMOKE-WARN chromium-video-sampler-status-marker-timeout"
            set timeout $old_timeout
            optional_prompt
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-sampler-status-eof" }
    }
    set timeout $old_timeout
    if {$chromium_launch_only ne "1"} {
        sleep $chromium_video_warmup_seconds
        run_chromium_video_wait_for_playback
        run_chromium_video_capture 0
        if {$chromium_video_result_wait_seconds > 0} {
            sleep $chromium_video_result_wait_seconds
        }
    }
    wait_chromium_video_sampler_done
    wait_chromium_video_kprofile_done
    capture_fbstat_stats
    set timeout 20
    set sync_done_marker "KCVSYNCDONE"
    set chromium_video_final_sync_status "running"
    send "sync; echo $sync_done_marker; echo $sync_done_marker; echo $sync_done_marker; echo $sync_done_marker; echo $sync_done_marker\r"
    expect {
        -re [async_marker_re $sync_done_marker] {
            set chromium_video_final_sync_status "done"
            set timeout $old_timeout
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-sync-crash"
        }
        timeout {
            set chromium_video_final_sync_status "timeout"
            set timeout $old_timeout
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL chromium-video-sync-eof" }
    }
    set timeout $old_timeout
    optional_prompt

    set label "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=chromium-video chromium_video=$chromium_video_proof_mode samples=$chromium_video_sample_count url=$chromium_video_url"
    if {$chromium_launch_only eq "1"} {
        append label " chromium_launch_only=1"
    }
    append label " chromium_multiprocess=$chromium_video_multiprocess"
    append label " chromium_disable_audio_output=$chromium_video_disable_audio_output"
    if {$chromium_video_limitation ne ""} {
        append label " limitation=$chromium_video_limitation"
    }
    finish 0 $label
}

proc run_optional_direct_app_launch_probe {} {
    if {![info exists ::env(KDE_SMOKE_DIRECT_APP_PROBE)] || $::env(KDE_SMOKE_DIRECT_APP_PROBE) eq "" || $::env(KDE_SMOKE_DIRECT_APP_PROBE) eq "0"} {
        return
    }

    run_guest_check "/bin/kde-app-launch-probe" "kde-app-launch-probe" 90
    run_optional_chromium_probe
}

proc x11_egl_setup_fallback_line {line} {
    return [regexp {host-x11-egl-smoke: (eglGetDisplay|eglInitialize|eglBindAPI|eglChooseConfig|eglCreateContext|eglCreateWindowSurface|eglMakeCurrent) status=FALLBACK [^\r\n]*fallback=glx} $line]
}

proc x11_egl_failure_label_from_line {line} {
    set line [string trim $line]
    if {[x11_egl_setup_fallback_line $line]} {
        return ""
    }
    if {[regexp {host-x11-egl-smoke: (egl|glx) ready [^\r\n]*gl_version=\(null\)} $line]} {
        return "x11-egl-null-gl-version"
    }
    if {[regexp {host-x11-egl-smoke: glx_choose_visual missing status=FAIL} $line]} {
        return "x11-egl-glx_choose_visual-missing-status-FAIL"
    }
    if {[regexp {host-x11-egl-smoke: phase=([A-Za-z0-9_]+) status=FAIL} $line -> phase]} {
        return "x11-egl-${phase}-status-FAIL"
    }
    if {[regexp {host-x11-egl-smoke: ([A-Za-z0-9_]+) ([A-Za-z0-9_]+)[^\r\n]*status=FAIL} $line -> phase reason]} {
        return "x11-egl-${phase}-${reason}-status-FAIL"
    }
    if {[regexp {host-x11-egl-smoke: ([A-Za-z0-9_]+) [^\r\n]*(failed|missing)} $line -> phase reason]} {
        return "x11-egl-${phase}-${reason}"
    }
    return ""
}

proc x11_egl_scan_launch_log {text start_var connect_var gl_var frame_var failure_var} {
    upvar 1 $start_var saw_start
    upvar 1 $connect_var saw_connect
    upvar 1 $gl_var saw_gl
    upvar 1 $frame_var saw_frame
    upvar 1 $failure_var failure_label

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-egl-smoke: start} $line]} {
            set saw_start 1
        }
        if {[regexp {host-x11-egl-smoke: connected display=} $line]} {
            set saw_connect 1
        }
        if {[regexp {host-x11-egl-smoke: (egl|glx) ready } $line]} {
            set saw_gl 1
        }
        if {[regexp {host-x11-egl-smoke: frame=[0-9]+ mode=launch} $line]} {
            set saw_frame 1
        }
        if {$failure_label eq ""} {
            set label [x11_egl_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
}

proc x11_egl_scan_exit_log {text input_var exit_var failure_var} {
    upvar 1 $input_var saw_input
    upvar 1 $exit_var saw_exit
    upvar 1 $failure_var failure_label

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-egl-smoke: input_ready} $line]} {
            set saw_input 1
        }
        if {[regexp {host-x11-egl-smoke: exited} $line]} {
            set saw_exit 1
        }
        if {$failure_label eq ""} {
            set label [x11_egl_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
}

proc x11_egl_failure_suffix {saw_start saw_connect saw_gl saw_frame} {
    return "start=$saw_start connect=$saw_connect gl=$saw_gl frame=$saw_frame"
}

proc x11_egl_glx_probe_failure_suffix {saw_start saw_connect saw_egl_init saw_glx_ext saw_glx_version saw_fbconfigs saw_visual saw_context saw_current saw_strings saw_draw saw_result exit_status} {
    return "start=$saw_start x11_connect=$saw_connect egl_initialize=$saw_egl_init glx_query_extension=$saw_glx_ext glx_query_version=$saw_glx_version glx_fbconfigs=$saw_fbconfigs glx_choose_visual=$saw_visual glx_create_context=$saw_context glx_make_current=$saw_current gl_strings=$saw_strings draw=$saw_draw result=$saw_result exit_status=$exit_status"
}

proc x11_glx_fps_failure_suffix {saw_start saw_connect saw_egl_init saw_glx_ext saw_glx_version saw_fbconfigs saw_visual saw_context saw_current saw_strings saw_fps_begin saw_fps_result fps_status fps_frames fps_elapsed fps_value variant requested_depth requested_sample_interval result_variant oml_available queue_depth sbc_issued sbc_completed max_pending oml_last_sbc gl_flush_total swap_msc_issue_total get_sync_before_total get_sync_after_total issue_state_sample_interval issue_state_sampled_ratio issue_state_first_sample_frame issue_state_last_sample_frame issue_state_first_sample_sbc issue_state_last_sample_sbc issue_state_samples post_issue_sbc_completed_count post_issue_sbc_lag_max post_issue_msc_delta_total post_issue_msc_delta_max swap_only_skipped_draw_frames swap_interval_requested swap_interval_set_api swap_interval_set_status swap_interval_before swap_interval_after plain_swap_issue_total plain_swap_avg plain_swap_max plain_oml_available plain_oml_samples plain_oml_sample_interval plain_oml_sampled_ratio plain_oml_first_sample_frame plain_oml_last_sample_frame plain_oml_get_sync_before_total plain_oml_get_sync_after_total plain_oml_before_first_sbc plain_oml_before_last_sbc plain_oml_after_first_sbc plain_oml_after_last_sbc plain_oml_post_swap_sbc_delta_total plain_oml_post_swap_sbc_delta_max plain_oml_post_swap_msc_delta_total plain_oml_post_swap_msc_delta_max plain_post_swap_xsync_total plain_post_swap_xsync_max exit_status} {
    return "start=$saw_start x11_connect=$saw_connect egl_initialize=$saw_egl_init glx_query_extension=$saw_glx_ext glx_query_version=$saw_glx_version glx_fbconfigs=$saw_fbconfigs glx_choose_visual=$saw_visual glx_create_context=$saw_context glx_make_current=$saw_current gl_strings=$saw_strings fps_begin=$saw_fps_begin fps_result=$saw_fps_result fps_status=$fps_status frames=$fps_frames elapsed_seconds=$fps_elapsed fps=$fps_value variant=$variant requested_depth=$requested_depth requested_sample_interval=$requested_sample_interval result_variant=$result_variant oml_available=$oml_available queue_depth=$queue_depth sbc_issued=$sbc_issued sbc_completed=$sbc_completed max_pending=$max_pending oml_last_sbc=$oml_last_sbc oml_gl_flush_total_ms=$gl_flush_total oml_swap_msc_issue_total_ms=$swap_msc_issue_total oml_get_sync_before_total_ms=$get_sync_before_total oml_get_sync_after_total_ms=$get_sync_after_total oml_issue_state_sample_interval=$issue_state_sample_interval oml_issue_state_sampled_ratio=$issue_state_sampled_ratio oml_issue_state_first_sample_frame=$issue_state_first_sample_frame oml_issue_state_last_sample_frame=$issue_state_last_sample_frame oml_issue_state_first_sample_sbc=$issue_state_first_sample_sbc oml_issue_state_last_sample_sbc=$issue_state_last_sample_sbc oml_issue_state_samples=$issue_state_samples oml_post_issue_sbc_completed_count=$post_issue_sbc_completed_count oml_post_issue_sbc_lag_max=$post_issue_sbc_lag_max oml_post_issue_msc_delta_total=$post_issue_msc_delta_total oml_post_issue_msc_delta_max=$post_issue_msc_delta_max swap_only_skipped_draw_frames=$swap_only_skipped_draw_frames swap_interval_requested=$swap_interval_requested swap_interval_set_api=$swap_interval_set_api swap_interval_set_status=$swap_interval_set_status swap_interval_before=$swap_interval_before swap_interval_after=$swap_interval_after plain_swap_issue_total_ms=$plain_swap_issue_total plain_swap_avg_ms=$plain_swap_avg plain_swap_max_ms=$plain_swap_max plain_oml_available=$plain_oml_available plain_oml_samples=$plain_oml_samples plain_oml_sample_interval=$plain_oml_sample_interval plain_oml_sampled_ratio=$plain_oml_sampled_ratio plain_oml_first_sample_frame=$plain_oml_first_sample_frame plain_oml_last_sample_frame=$plain_oml_last_sample_frame plain_oml_get_sync_before_total_ms=$plain_oml_get_sync_before_total plain_oml_get_sync_after_total_ms=$plain_oml_get_sync_after_total plain_oml_before_first_sbc=$plain_oml_before_first_sbc plain_oml_before_last_sbc=$plain_oml_before_last_sbc plain_oml_after_first_sbc=$plain_oml_after_first_sbc plain_oml_after_last_sbc=$plain_oml_after_last_sbc plain_oml_post_swap_sbc_delta_total=$plain_oml_post_swap_sbc_delta_total plain_oml_post_swap_sbc_delta_max=$plain_oml_post_swap_sbc_delta_max plain_oml_post_swap_msc_delta_total=$plain_oml_post_swap_msc_delta_total plain_oml_post_swap_msc_delta_max=$plain_oml_post_swap_msc_delta_max plain_post_swap_xsync_total_ms=$plain_post_swap_xsync_total plain_post_swap_xsync_max_ms=$plain_post_swap_xsync_max exit_status=$exit_status"
}

proc x11_glx_fps_oml_queue_failure_label {variant expected_variant expected_depth result_variant oml_available queue_depth sbc_issued sbc_completed max_pending label_prefix {gl_flush_total ""} {swap_msc_issue_total ""} {require_split_timing 0}} {
    if {$variant ne $expected_variant} {
        return ""
    }
    if {$expected_depth eq ""} {
        return "${label_prefix}-requested-depth-missing"
    }
    if {$result_variant eq ""} {
        return "${label_prefix}-result-variant-missing"
    }
    if {$result_variant ne $expected_variant} {
        return "${label_prefix}-result-variant-mismatch"
    }
    if {$oml_available eq ""} {
        return "${label_prefix}-available-missing"
    }
    if {$oml_available != 1} {
        return "${label_prefix}-available-mismatch"
    }
    if {$queue_depth eq ""} {
        return "${label_prefix}-queue-depth-missing"
    }
    if {$queue_depth != $expected_depth} {
        return "${label_prefix}-queue-depth-mismatch"
    }
    if {$sbc_issued eq ""} {
        return "${label_prefix}-sbc-issued-missing"
    }
    if {$sbc_completed eq ""} {
        return "${label_prefix}-sbc-completed-missing"
    }
    if {$sbc_issued <= 0 || $sbc_completed <= 0} {
        return "${label_prefix}-sbc-zero"
    }
    if {$sbc_issued != $sbc_completed} {
        return "${label_prefix}-sbc-mismatch"
    }
    if {$max_pending eq ""} {
        return "${label_prefix}-max-pending-missing"
    }
    if {$max_pending != $expected_depth} {
        return "${label_prefix}-max-pending-mismatch"
    }
    if {$require_split_timing} {
        if {$gl_flush_total eq ""} {
            return "${label_prefix}-gl-flush-total-missing"
        }
        if {![string is double -strict $gl_flush_total] || $gl_flush_total < 0} {
            return "${label_prefix}-gl-flush-total-invalid"
        }
        if {$swap_msc_issue_total eq ""} {
            return "${label_prefix}-swap-msc-issue-total-missing"
        }
        if {![string is double -strict $swap_msc_issue_total] || $swap_msc_issue_total < 0} {
            return "${label_prefix}-swap-msc-issue-total-invalid"
        }
    }
    return ""
}

proc x11_glx_fps_oml_queue3_failure_label {variant result_variant oml_available queue_depth sbc_issued sbc_completed max_pending} {
    return [x11_glx_fps_oml_queue_failure_label $variant "oml-queue3-swap-only" 3 $result_variant $oml_available $queue_depth $sbc_issued $sbc_completed $max_pending "x11-glx-fps-oml"]
}

proc x11_glx_fps_swap_interval0_failure_label {variant result_variant frames swap_only_skipped_draw_frames swap_interval_requested swap_interval_set_api swap_interval_set_status swap_interval_after plain_swap_issue_total plain_swap_avg plain_swap_max {expected_variant "swap-interval0-swap-only"} {label_prefix "x11-glx-fps-swap-interval0"}} {
    if {$variant ne $expected_variant} {
        return ""
    }
    if {$result_variant eq ""} {
        return "$label_prefix-result-variant-missing"
    }
    if {$result_variant ne $expected_variant} {
        return "$label_prefix-result-variant-mismatch"
    }
    if {$swap_interval_requested eq ""} {
        return "$label_prefix-requested-missing"
    }
    if {$swap_interval_requested != 0} {
        return "$label_prefix-requested-mismatch"
    }
    if {$swap_interval_set_status eq ""} {
        return "$label_prefix-status-missing"
    }
    if {$swap_interval_set_status ne "PASS"} {
        return "$label_prefix-status-mismatch"
    }
    if {$swap_interval_set_api eq ""} {
        return "$label_prefix-api-missing"
    }
    if {$swap_interval_set_api eq "none"} {
        return "$label_prefix-api-none"
    }
    if {$swap_interval_after eq ""} {
        return "$label_prefix-after-missing"
    }
    if {![string is integer -strict $swap_interval_after]} {
        return "$label_prefix-after-invalid"
    }
    if {$swap_interval_after != 0} {
        return "$label_prefix-after-mismatch"
    }
    if {$swap_only_skipped_draw_frames eq ""} {
        return "$label_prefix-skipped-draw-missing"
    }
    if {![string is integer -strict $swap_only_skipped_draw_frames]} {
        return "$label_prefix-skipped-draw-invalid"
    }
    if {$swap_only_skipped_draw_frames != $frames - 1} {
        return "$label_prefix-skipped-draw-mismatch"
    }
    foreach {value label} [list \
        $plain_swap_issue_total plain-swap-issue-total \
        $plain_swap_avg plain-swap-avg \
        $plain_swap_max plain-swap-max] {
        if {$value eq ""} {
            return "$label_prefix-$label-missing"
        }
        if {![string is double -strict $value] || $value < 0} {
            return "$label_prefix-$label-invalid"
        }
    }
    return ""
}

proc x11_glx_fps_plain_oml_failure_label {variant result_variant frames swap_only_skipped_draw_frames swap_interval_requested swap_interval_set_api swap_interval_set_status swap_interval_after plain_swap_issue_total plain_swap_avg plain_swap_max plain_oml_available plain_oml_samples plain_oml_get_sync_before_total plain_oml_get_sync_after_total plain_oml_before_first_sbc plain_oml_before_last_sbc plain_oml_after_first_sbc plain_oml_after_last_sbc plain_oml_post_swap_sbc_delta_total plain_oml_post_swap_sbc_delta_max plain_oml_post_swap_msc_delta_total plain_oml_post_swap_msc_delta_max plain_post_swap_xsync_total plain_post_swap_xsync_max} {
    set expected_variant "swap-interval0-oml-state-swap-only"
    set label_prefix "x11-glx-fps-swap-interval0-plain-oml"
    set label [x11_glx_fps_swap_interval0_failure_label $variant $result_variant $frames $swap_only_skipped_draw_frames $swap_interval_requested $swap_interval_set_api $swap_interval_set_status $swap_interval_after $plain_swap_issue_total $plain_swap_avg $plain_swap_max $expected_variant $label_prefix]
    if {$label ne ""} {
        return $label
    }
    if {$variant ne $expected_variant} {
        return ""
    }
    if {$plain_oml_available eq ""} {
        return "$label_prefix-available-missing"
    }
    if {$plain_oml_available != 1} {
        return "$label_prefix-available-mismatch"
    }
    if {$plain_oml_samples eq ""} {
        return "$label_prefix-samples-missing"
    }
    if {![string is integer -strict $plain_oml_samples]} {
        return "$label_prefix-samples-invalid"
    }
    if {$plain_oml_samples != $frames} {
        return "$label_prefix-samples-mismatch"
    }
    foreach {value label type} [list \
        $plain_oml_get_sync_before_total get-sync-before-total double \
        $plain_oml_get_sync_after_total get-sync-after-total double \
        $plain_oml_before_first_sbc before-first-sbc integer \
        $plain_oml_before_last_sbc before-last-sbc integer \
        $plain_oml_after_first_sbc after-first-sbc integer \
        $plain_oml_after_last_sbc after-last-sbc integer \
        $plain_oml_post_swap_sbc_delta_total post-swap-sbc-delta-total integer \
        $plain_oml_post_swap_sbc_delta_max post-swap-sbc-delta-max integer \
        $plain_oml_post_swap_msc_delta_total post-swap-msc-delta-total integer \
        $plain_oml_post_swap_msc_delta_max post-swap-msc-delta-max integer \
        $plain_post_swap_xsync_total post-swap-xsync-total double \
        $plain_post_swap_xsync_max post-swap-xsync-max double] {
        if {$value eq ""} {
            return "$label_prefix-$label-missing"
        }
        if {![string is $type -strict $value] || $value < 0} {
            return "$label_prefix-$label-invalid"
        }
    }
    return ""
}

proc x11_glx_fps_plain_oml_sampled_failure_label {variant requested_sample_interval result_variant frames swap_only_skipped_draw_frames swap_interval_requested swap_interval_set_api swap_interval_set_status swap_interval_after plain_swap_issue_total plain_swap_avg plain_swap_max plain_oml_available plain_oml_samples plain_oml_sample_interval plain_oml_sampled_ratio plain_oml_first_sample_frame plain_oml_last_sample_frame plain_oml_get_sync_before_total plain_oml_get_sync_after_total plain_oml_before_first_sbc plain_oml_before_last_sbc plain_oml_after_first_sbc plain_oml_after_last_sbc plain_oml_post_swap_sbc_delta_total plain_oml_post_swap_sbc_delta_max plain_oml_post_swap_msc_delta_total plain_oml_post_swap_msc_delta_max plain_post_swap_xsync_total plain_post_swap_xsync_max} {
    set expected_variant "swap-interval0-oml-state-sampled-swap-only"
    set label_prefix "x11-glx-fps-swap-interval0-plain-oml-sampled"
    set label [x11_glx_fps_swap_interval0_failure_label $variant $result_variant $frames $swap_only_skipped_draw_frames $swap_interval_requested $swap_interval_set_api $swap_interval_set_status $swap_interval_after $plain_swap_issue_total $plain_swap_avg $plain_swap_max $expected_variant $label_prefix]
    if {$label ne ""} {
        return $label
    }
    if {$variant ne $expected_variant} {
        return ""
    }
    if {$requested_sample_interval eq ""} {
        set requested_sample_interval 16
    }
    if {![string is integer -strict $requested_sample_interval] ||
        $requested_sample_interval < 1 || $requested_sample_interval > 64} {
        return "$label_prefix-requested-sample-interval-invalid"
    }
    if {$plain_oml_available eq ""} {
        return "$label_prefix-available-missing"
    }
    if {$plain_oml_available != 1} {
        return "$label_prefix-available-mismatch"
    }
    if {$plain_oml_sample_interval eq ""} {
        return "$label_prefix-sample-interval-missing"
    }
    if {![string is integer -strict $plain_oml_sample_interval] ||
        $plain_oml_sample_interval != $requested_sample_interval} {
        return "$label_prefix-sample-interval-mismatch"
    }
    if {$plain_oml_samples eq ""} {
        return "$label_prefix-samples-missing"
    }
    if {![string is integer -strict $plain_oml_samples]} {
        return "$label_prefix-samples-invalid"
    }
    set expected_samples [expr {($frames + $requested_sample_interval - 1) / $requested_sample_interval}]
    if {$plain_oml_samples != $expected_samples} {
        return "$label_prefix-samples-mismatch"
    }
    if {$plain_oml_sampled_ratio eq ""} {
        return "$label_prefix-sampled-ratio-missing"
    }
    if {![regexp {^([0-9]+)/([0-9]+)$} $plain_oml_sampled_ratio -> ratio_samples ratio_frames]} {
        return "$label_prefix-sampled-ratio-invalid"
    }
    if {$ratio_samples != $plain_oml_samples || $ratio_frames != $frames} {
        return "$label_prefix-sampled-ratio-mismatch"
    }
    if {$plain_oml_first_sample_frame eq "" ||
        $plain_oml_last_sample_frame eq ""} {
        return "$label_prefix-sample-frame-missing"
    }
    if {![string is integer -strict $plain_oml_first_sample_frame] ||
        ![string is integer -strict $plain_oml_last_sample_frame]} {
        return "$label_prefix-sample-frame-invalid"
    }
    set expected_last_sample_frame [expr {1 + ($plain_oml_samples - 1) * $requested_sample_interval}]
    if {$plain_oml_first_sample_frame != 1} {
        return "$label_prefix-first-sample-frame-mismatch"
    }
    if {$plain_oml_last_sample_frame != $expected_last_sample_frame} {
        return "$label_prefix-last-sample-frame-mismatch"
    }
    foreach {value label type} [list \
        $plain_oml_get_sync_before_total get-sync-before-total double \
        $plain_oml_get_sync_after_total get-sync-after-total double \
        $plain_oml_before_first_sbc before-first-sbc integer \
        $plain_oml_before_last_sbc before-last-sbc integer \
        $plain_oml_after_first_sbc after-first-sbc integer \
        $plain_oml_after_last_sbc after-last-sbc integer \
        $plain_oml_post_swap_sbc_delta_total post-swap-sbc-delta-total integer \
        $plain_oml_post_swap_sbc_delta_max post-swap-sbc-delta-max integer \
        $plain_oml_post_swap_msc_delta_total post-swap-msc-delta-total integer \
        $plain_oml_post_swap_msc_delta_max post-swap-msc-delta-max integer] {
        if {$value eq ""} {
            return "$label_prefix-$label-missing"
        }
        if {![string is $type -strict $value] || $value < 0} {
            return "$label_prefix-$label-invalid"
        }
    }
    if {$plain_post_swap_xsync_total eq ""} {
        return "$label_prefix-post-swap-xsync-total-missing"
    }
    if {![string is double -strict $plain_post_swap_xsync_total] ||
        $plain_post_swap_xsync_total != 0} {
        return "$label_prefix-post-swap-xsync-total-nonzero"
    }
    if {$plain_post_swap_xsync_max eq ""} {
        return "$label_prefix-post-swap-xsync-max-missing"
    }
    if {![string is double -strict $plain_post_swap_xsync_max] ||
        $plain_post_swap_xsync_max != 0} {
        return "$label_prefix-post-swap-xsync-max-nonzero"
    }
    return ""
}

proc x11_glx_fps_plain_oml_sampled_after_failure_label {variant requested_sample_interval result_variant frames swap_only_skipped_draw_frames swap_interval_requested swap_interval_set_api swap_interval_set_status swap_interval_after plain_swap_issue_total plain_swap_avg plain_swap_max plain_oml_available plain_oml_samples plain_oml_sample_interval plain_oml_sampled_ratio plain_oml_first_sample_frame plain_oml_last_sample_frame plain_oml_get_sync_before_total plain_oml_get_sync_after_total plain_oml_after_first_sbc plain_oml_after_last_sbc plain_oml_after_sbc_delta_total plain_oml_after_sbc_delta_max plain_oml_after_msc_delta_total plain_oml_after_msc_delta_max plain_post_swap_xsync_total plain_post_swap_xsync_max} {
    set expected_variant "swap-interval0-oml-state-sampled-after-swap-only"
    set label_prefix "x11-glx-fps-swap-interval0-plain-oml-sampled-after"
    set label [x11_glx_fps_swap_interval0_failure_label $variant $result_variant $frames $swap_only_skipped_draw_frames $swap_interval_requested $swap_interval_set_api $swap_interval_set_status $swap_interval_after $plain_swap_issue_total $plain_swap_avg $plain_swap_max $expected_variant $label_prefix]
    if {$label ne ""} {
        return $label
    }
    if {$variant ne $expected_variant} {
        return ""
    }
    if {$requested_sample_interval eq ""} {
        set requested_sample_interval 16
    }
    if {![string is integer -strict $requested_sample_interval] ||
        $requested_sample_interval < 1 || $requested_sample_interval > 64} {
        return "$label_prefix-requested-sample-interval-invalid"
    }
    if {$plain_oml_available eq ""} {
        return "$label_prefix-available-missing"
    }
    if {$plain_oml_available != 1} {
        return "$label_prefix-available-mismatch"
    }
    if {$plain_oml_sample_interval eq ""} {
        return "$label_prefix-sample-interval-missing"
    }
    if {![string is integer -strict $plain_oml_sample_interval] ||
        $plain_oml_sample_interval != $requested_sample_interval} {
        return "$label_prefix-sample-interval-mismatch"
    }
    if {$plain_oml_samples eq ""} {
        return "$label_prefix-samples-missing"
    }
    if {![string is integer -strict $plain_oml_samples]} {
        return "$label_prefix-samples-invalid"
    }
    set expected_samples [expr {($frames + $requested_sample_interval - 1) / $requested_sample_interval}]
    if {$plain_oml_samples != $expected_samples} {
        return "$label_prefix-samples-mismatch"
    }
    if {$plain_oml_sampled_ratio eq ""} {
        return "$label_prefix-sampled-ratio-missing"
    }
    if {![regexp {^([0-9]+)/([0-9]+)$} $plain_oml_sampled_ratio -> ratio_samples ratio_frames]} {
        return "$label_prefix-sampled-ratio-invalid"
    }
    if {$ratio_samples != $plain_oml_samples || $ratio_frames != $frames} {
        return "$label_prefix-sampled-ratio-mismatch"
    }
    if {$plain_oml_first_sample_frame eq "" ||
        $plain_oml_last_sample_frame eq ""} {
        return "$label_prefix-sample-frame-missing"
    }
    if {![string is integer -strict $plain_oml_first_sample_frame] ||
        ![string is integer -strict $plain_oml_last_sample_frame]} {
        return "$label_prefix-sample-frame-invalid"
    }
    set expected_last_sample_frame [expr {1 + ($plain_oml_samples - 1) * $requested_sample_interval}]
    if {$plain_oml_first_sample_frame != 1} {
        return "$label_prefix-first-sample-frame-mismatch"
    }
    if {$plain_oml_last_sample_frame != $expected_last_sample_frame} {
        return "$label_prefix-last-sample-frame-mismatch"
    }
    if {$plain_oml_get_sync_before_total eq ""} {
        return "$label_prefix-get-sync-before-total-missing"
    }
    if {![string is double -strict $plain_oml_get_sync_before_total] ||
        $plain_oml_get_sync_before_total != 0} {
        return "$label_prefix-get-sync-before-total-nonzero"
    }
    if {$plain_oml_get_sync_after_total eq ""} {
        return "$label_prefix-get-sync-after-total-missing"
    }
    if {![string is double -strict $plain_oml_get_sync_after_total] ||
        $plain_oml_get_sync_after_total < 0} {
        return "$label_prefix-get-sync-after-total-invalid"
    }
    foreach {value label} [list \
        $plain_oml_after_first_sbc after-first-sbc \
        $plain_oml_after_last_sbc after-last-sbc \
        $plain_oml_after_sbc_delta_total after-sbc-delta-total \
        $plain_oml_after_sbc_delta_max after-sbc-delta-max \
        $plain_oml_after_msc_delta_total after-msc-delta-total \
        $plain_oml_after_msc_delta_max after-msc-delta-max] {
        if {$value eq ""} {
            return "$label_prefix-$label-missing"
        }
        if {![string is integer -strict $value] || $value < 0} {
            return "$label_prefix-$label-invalid"
        }
    }
    if {$plain_oml_after_last_sbc < $plain_oml_after_first_sbc} {
        return "$label_prefix-after-sbc-regressed"
    }
    if {$plain_oml_after_sbc_delta_total < $plain_oml_after_sbc_delta_max ||
        $plain_oml_after_msc_delta_total < $plain_oml_after_msc_delta_max} {
        return "$label_prefix-after-delta-regressed"
    }
    if {$plain_post_swap_xsync_total eq ""} {
        return "$label_prefix-post-swap-xsync-total-missing"
    }
    if {![string is double -strict $plain_post_swap_xsync_total] ||
        $plain_post_swap_xsync_total != 0} {
        return "$label_prefix-post-swap-xsync-total-nonzero"
    }
    if {$plain_post_swap_xsync_max eq ""} {
        return "$label_prefix-post-swap-xsync-max-missing"
    }
    if {![string is double -strict $plain_post_swap_xsync_max] ||
        $plain_post_swap_xsync_max != 0} {
        return "$label_prefix-post-swap-xsync-max-nonzero"
    }
    return ""
}

proc x11_glx_fps_oml_flush_swap_failure_label {variant requested_depth result_variant oml_available queue_depth sbc_issued sbc_completed max_pending gl_flush_total swap_msc_issue_total} {
    return [x11_glx_fps_oml_queue_failure_label $variant "oml-queue-depth-flush-swap-timing" $requested_depth $result_variant $oml_available $queue_depth $sbc_issued $sbc_completed $max_pending "x11-glx-fps-oml-flush-swap" $gl_flush_total $swap_msc_issue_total 1]
}

proc x11_glx_fps_oml_issue_state_failure_label {variant requested_depth requested_sample_interval result_variant oml_available queue_depth sbc_issued sbc_completed max_pending oml_last_sbc gl_flush_total swap_msc_issue_total get_sync_before_total get_sync_after_total issue_state_sample_interval issue_state_sampled_ratio issue_state_first_sample_frame issue_state_last_sample_frame issue_state_first_sample_sbc issue_state_last_sample_sbc issue_state_samples post_issue_sbc_completed_count post_issue_sbc_lag_max post_issue_msc_delta_total post_issue_msc_delta_max} {
    set label [x11_glx_fps_oml_queue_failure_label $variant "oml-queue-depth-issue-state-timing" $requested_depth $result_variant $oml_available $queue_depth $sbc_issued $sbc_completed $max_pending "x11-glx-fps-oml-issue-state" $gl_flush_total $swap_msc_issue_total 1]
    if {$label ne ""} {
        return $label
    }
    if {$variant ne "oml-queue-depth-issue-state-timing"} {
        return ""
    }
    if {$requested_sample_interval eq ""} {
        set requested_sample_interval 1
    }
    if {![string is integer -strict $requested_sample_interval] ||
        $requested_sample_interval < 1 || $requested_sample_interval > 64} {
        return "x11-glx-fps-oml-issue-state-requested-sample-interval-invalid"
    }
    if {$get_sync_before_total eq ""} {
        return "x11-glx-fps-oml-issue-state-get-sync-before-total-missing"
    }
    if {![string is double -strict $get_sync_before_total] || $get_sync_before_total < 0} {
        return "x11-glx-fps-oml-issue-state-get-sync-before-total-invalid"
    }
    if {$get_sync_after_total eq ""} {
        return "x11-glx-fps-oml-issue-state-get-sync-after-total-missing"
    }
    if {![string is double -strict $get_sync_after_total] || $get_sync_after_total < 0} {
        return "x11-glx-fps-oml-issue-state-get-sync-after-total-invalid"
    }
    if {$issue_state_samples eq ""} {
        return "x11-glx-fps-oml-issue-state-samples-missing"
    }
    if {![string is integer -strict $issue_state_samples]} {
        return "x11-glx-fps-oml-issue-state-samples-invalid"
    }
    if {$requested_sample_interval == 1} {
        if {$issue_state_samples != $sbc_issued} {
            return "x11-glx-fps-oml-issue-state-samples-mismatch"
        }
    } else {
        set expected_samples [expr {($sbc_issued + $requested_sample_interval - 1) / $requested_sample_interval}]
        if {$issue_state_samples != $expected_samples} {
            return "x11-glx-fps-oml-issue-state-samples-mismatch"
        }
        if {$issue_state_sample_interval eq ""} {
            return "x11-glx-fps-oml-issue-state-sample-interval-missing"
        }
        if {![string is integer -strict $issue_state_sample_interval] ||
            $issue_state_sample_interval != $requested_sample_interval} {
            return "x11-glx-fps-oml-issue-state-sample-interval-mismatch"
        }
        if {$issue_state_sampled_ratio eq ""} {
            return "x11-glx-fps-oml-issue-state-sampled-ratio-missing"
        }
        if {![regexp {^([0-9]+)/([0-9]+)$} $issue_state_sampled_ratio -> ratio_samples ratio_issued]} {
            return "x11-glx-fps-oml-issue-state-sampled-ratio-invalid"
        }
        if {$ratio_samples != $issue_state_samples ||
            $ratio_issued != $sbc_issued} {
            return "x11-glx-fps-oml-issue-state-sampled-ratio-mismatch"
        }
        if {$issue_state_first_sample_frame eq "" ||
            $issue_state_last_sample_frame eq "" ||
            $issue_state_first_sample_sbc eq "" ||
            $issue_state_last_sample_sbc eq ""} {
            return "x11-glx-fps-oml-issue-state-sample-bounds-missing"
        }
        if {![string is integer -strict $issue_state_first_sample_frame] ||
            ![string is integer -strict $issue_state_last_sample_frame] ||
            ![string is integer -strict $issue_state_first_sample_sbc] ||
            ![string is integer -strict $issue_state_last_sample_sbc]} {
            return "x11-glx-fps-oml-issue-state-sample-bounds-invalid"
        }
        if {$issue_state_first_sample_frame <= 0 ||
            $issue_state_last_sample_frame <= 0 ||
            $issue_state_first_sample_sbc <= 0 ||
            $issue_state_last_sample_sbc <= 0} {
            return "x11-glx-fps-oml-issue-state-sample-bounds-zero"
        }
        if {$issue_state_first_sample_frame > $issue_state_last_sample_frame ||
            $issue_state_first_sample_sbc > $issue_state_last_sample_sbc} {
            return "x11-glx-fps-oml-issue-state-sample-bounds-order"
        }
        set expected_last_sample_frame [expr {1 + ($issue_state_samples - 1) * $requested_sample_interval}]
        if {$issue_state_first_sample_frame != 1} {
            return "x11-glx-fps-oml-issue-state-first-sample-frame-mismatch"
        }
        if {$issue_state_last_sample_frame != $expected_last_sample_frame} {
            return "x11-glx-fps-oml-issue-state-last-sample-frame-mismatch"
        }
        if {$issue_state_first_sample_sbc != 1} {
            return "x11-glx-fps-oml-issue-state-first-sample-sbc-mismatch"
        }
        if {$issue_state_last_sample_sbc != $expected_last_sample_frame} {
            return "x11-glx-fps-oml-issue-state-last-sample-sbc-mismatch"
        }
        if {$oml_last_sbc eq ""} {
            return "x11-glx-fps-oml-issue-state-last-sbc-missing"
        }
        if {![string is integer -strict $oml_last_sbc]} {
            return "x11-glx-fps-oml-issue-state-last-sbc-invalid"
        }
        if {$issue_state_last_sample_sbc > $oml_last_sbc} {
            return "x11-glx-fps-oml-issue-state-last-sample-sbc-after-last-sbc"
        }
    }
    if {$post_issue_sbc_completed_count eq ""} {
        return "x11-glx-fps-oml-issue-state-sbc-completed-count-missing"
    }
    if {![string is integer -strict $post_issue_sbc_completed_count]} {
        return "x11-glx-fps-oml-issue-state-sbc-completed-count-invalid"
    }
    if {$post_issue_sbc_lag_max eq ""} {
        return "x11-glx-fps-oml-issue-state-sbc-lag-max-missing"
    }
    if {![string is integer -strict $post_issue_sbc_lag_max]} {
        return "x11-glx-fps-oml-issue-state-sbc-lag-max-invalid"
    }
    if {$post_issue_msc_delta_total eq ""} {
        return "x11-glx-fps-oml-issue-state-msc-delta-total-missing"
    }
    if {![string is integer -strict $post_issue_msc_delta_total]} {
        return "x11-glx-fps-oml-issue-state-msc-delta-total-invalid"
    }
    if {$post_issue_msc_delta_max eq ""} {
        return "x11-glx-fps-oml-issue-state-msc-delta-max-missing"
    }
    if {![string is integer -strict $post_issue_msc_delta_max]} {
        return "x11-glx-fps-oml-issue-state-msc-delta-max-invalid"
    }
    return ""
}

proc x11_present_fps_failure_suffix {saw_start saw_connect saw_dri3 saw_present saw_select saw_fd saw_fps_begin saw_fps_result fps_status fps_frames fps_elapsed fps_value issued completed outstanding requested_variant requested_depth result_variant queue_depth max_outstanding exit_status} {
    return "start=$saw_start connect=$saw_connect dri3=$saw_dri3 present=$saw_present select=$saw_select fd=$saw_fd fps_begin=$saw_fps_begin fps_result=$saw_fps_result fps_status=$fps_status frames=$fps_frames elapsed_seconds=$fps_elapsed fps=$fps_value issued=$issued completed=$completed outstanding=$outstanding requested_variant=$requested_variant requested_depth=$requested_depth result_variant=$result_variant queue_depth=$queue_depth max_outstanding=$max_outstanding exit_status=$exit_status"
}

proc x11_present_fps_queue_failure_label {requested_variant requested_depth result_variant issued completed outstanding queue_depth max_outstanding} {
    if {$requested_variant ne "queue-unchecked"} {
        return ""
    }
    if {$result_variant eq ""} {
        return "x11-present-fps-queue-result-variant-missing"
    }
    if {$result_variant ne "queue-unchecked"} {
        return "x11-present-fps-queue-result-variant-mismatch"
    }
    if {$requested_depth eq ""} {
        return "x11-present-fps-queue-requested-depth-missing"
    }
    if {$queue_depth eq ""} {
        return "x11-present-fps-queue-depth-missing"
    }
    if {$queue_depth != $requested_depth} {
        return "x11-present-fps-queue-depth-mismatch"
    }
    if {$max_outstanding eq ""} {
        return "x11-present-fps-queue-max-outstanding-missing"
    }
    if {$max_outstanding != $requested_depth} {
        return "x11-present-fps-queue-max-outstanding-mismatch"
    }
    if {$issued eq ""} {
        return "x11-present-fps-queue-issued-missing"
    }
    if {$completed eq ""} {
        return "x11-present-fps-queue-completed-missing"
    }
    if {$issued <= 0 || $completed <= 0} {
        return "x11-present-fps-queue-issued-completed-zero"
    }
    if {$issued != $completed} {
        return "x11-present-fps-queue-issued-completed-mismatch"
    }
    if {$outstanding eq "" || $outstanding != 0} {
        return "x11-present-fps-queue-outstanding"
    }
    return ""
}

proc x11_glx_fps_failure_label_from_line {line} {
    if {[regexp {host-x11-egl-smoke: phase=glx_present_trace[^\r\n]*status=FAIL[^\r\n]*reason=([^ \r\n]+)} $line -> reason]} {
        return "x11-glx-fps-present-trace-$reason"
    }
    if {[regexp {host-x11-egl-smoke: phase=glx_fps_result status=FAIL[^\r\n]*reason=([^ \r\n]+)} $line -> reason]} {
        return "x11-glx-fps-result-FAIL-$reason"
    }
    if {[regexp {host-x11-egl-smoke: phase=glx_fps_oml_[A-Za-z0-9_]+[^\r\n]*status=FAIL[^\r\n]*reason=([^ \r\n]+)} $line -> reason]} {
        return "x11-glx-fps-oml-$reason"
    }
    if {[regexp {host-x11-egl-smoke: phase=glx_fps_plain_oml_[A-Za-z0-9_]+[^\r\n]*status=FAIL[^\r\n]*reason=([^ \r\n]+)} $line -> reason]} {
        return "x11-glx-fps-plain-oml-$reason"
    }
    if {[regexp {host-x11-egl-smoke: phase=glx_fps_variant[^\r\n]*status=FAIL[^\r\n]*reason=([^ \r\n]+)} $line -> reason]} {
        return "x11-glx-fps-variant-$reason"
    }
    set label [x11_egl_failure_label_from_line $line]
    if {$label ne ""} {
        regsub {^x11-egl-} $label {x11-glx-fps-} label
    }
    return $label
}

proc x11_glx_present_trace_scan_log {text enabled_var available_var child_pid_var begin_var result_var result_status_var pixmap_var pixmap_checked_var register_var present_registration_var wait_var poll_var nonpresent_var pixmap_ms_var wait_ms_var poll_ms_var complete_var decode_failures_var missing_symbols_var failure_var} {
    upvar 1 $enabled_var enabled
    upvar 1 $available_var available
    upvar 1 $child_pid_var child_pid
    upvar 1 $begin_var saw_begin
    upvar 1 $result_var saw_result
    upvar 1 $result_status_var result_status
    upvar 1 $pixmap_var pixmap_calls
    upvar 1 $pixmap_checked_var pixmap_checked_calls
    upvar 1 $register_var register_special_xge_calls
    upvar 1 $present_registration_var present_special_registrations
    upvar 1 $wait_var wait_special_calls
    upvar 1 $poll_var poll_special_calls
    upvar 1 $nonpresent_var nonpresent_special_events
    upvar 1 $pixmap_ms_var pixmap_total_ms
    upvar 1 $wait_ms_var wait_special_total_ms
    upvar 1 $poll_ms_var poll_special_total_ms
    upvar 1 $complete_var complete_events
    upvar 1 $decode_failures_var complete_decode_failures
    upvar 1 $missing_symbols_var missing_symbols
    upvar 1 $failure_var failure_label

    set expect_glx_fps_child_spawn 0
    set trace_pid_hint ""
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {^probe_glx_present_trace=([0-9]+)} $line -> found_enabled]} {
            set enabled $found_enabled
        }
        if {[regexp {^probe_glx_present_trace_available=([0-9]+)} $line -> found_available]} {
            set available $found_available
        }
        if {[regexp {host-x11-egl-smoke: diag launch mode=glx-fps[^\r\n]*child_ld_preload=([^ \r\n]+)} $line -> found_child_ld_preload] &&
            $found_child_ld_preload ne "(unset)"} {
            set expect_glx_fps_child_spawn 1
        }
        if {$expect_glx_fps_child_spawn &&
            [regexp {host-x11-egl-smoke-launcher: phase=child_spawn status=PASS pid=([0-9]+)} $line -> found_child_pid]} {
            set child_pid $found_child_pid
            set expect_glx_fps_child_spawn 0
        }
        if {[regexp {host-x11-present-trace: phase=present_trace (status=BEGIN|status=FAIL)[^\r\n]*pid=([0-9]+)} $line -> _ found_pid]} {
            if {$trace_pid_hint eq ""} {
                set trace_pid_hint $found_pid
            }
            if {$enabled eq ""} {
                set enabled 1
            }
            if {$available eq ""} {
                set available 1
            }
        }
        if {[regexp {host-x11-present-trace: phase=present_trace_result status=[^ \r\n]+[^\r\n]*pid=([0-9]+)} $line -> found_pid]} {
            if {$trace_pid_hint eq ""} {
                set trace_pid_hint $found_pid
            }
            if {$enabled eq ""} {
                set enabled 1
            }
            if {$available eq ""} {
                set available 1
            }
        }
        if {$failure_label eq ""} {
            set label [x11_glx_fps_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }

    if {$child_pid eq ""} {
        set child_pid $trace_pid_hint
    }
    if {$child_pid eq ""} {
        return
    }

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {$child_pid ne "" &&
            [regexp {host-x11-present-trace: phase=present_trace status=BEGIN[^\r\n]*pid=([0-9]+)} $line -> found_pid] &&
            $found_pid eq $child_pid} {
            set saw_begin 1
        }
        if {$child_pid ne "" &&
            [regexp {host-x11-present-trace: phase=present_trace_result status=([^ \r\n]+)[^\r\n]*pid=([0-9]+)} $line -> found_status found_pid] &&
            $found_pid eq $child_pid} {
            set saw_result 1
            if {$found_status ne "PASS"} {
                set result_status $found_status
            } elseif {$result_status eq ""} {
                set result_status $found_status
            }
            if {[regexp {pixmap_calls=([0-9]+)} $line -> found_pixmap_calls]} {
                set pixmap_calls $found_pixmap_calls
            }
            if {[regexp {pixmap_checked_calls=([0-9]+)} $line -> found_pixmap_checked_calls]} {
                set pixmap_checked_calls $found_pixmap_checked_calls
            }
            if {[regexp {register_special_xge_calls=([0-9]+)} $line -> found_register_special_xge_calls]} {
                set register_special_xge_calls $found_register_special_xge_calls
            }
            if {[regexp {present_special_registrations=([0-9]+)} $line -> found_present_special_registrations]} {
                set present_special_registrations $found_present_special_registrations
            }
            if {[regexp {wait_special_calls=([0-9]+)} $line -> found_wait_special_calls]} {
                set wait_special_calls $found_wait_special_calls
            }
            if {[regexp {poll_special_calls=([0-9]+)} $line -> found_poll_special_calls]} {
                set poll_special_calls $found_poll_special_calls
            }
            if {[regexp {nonpresent_special_events=([0-9]+)} $line -> found_nonpresent_special_events]} {
                set nonpresent_special_events $found_nonpresent_special_events
            }
            if {[regexp {pixmap_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_pixmap_total_ms _]} {
                set pixmap_total_ms $found_pixmap_total_ms
            }
            if {[regexp {wait_special_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_wait_special_total_ms _]} {
                set wait_special_total_ms $found_wait_special_total_ms
            }
            if {[regexp {poll_special_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_poll_special_total_ms _]} {
                set poll_special_total_ms $found_poll_special_total_ms
            }
            if {[regexp {complete_events=([0-9]+)} $line -> found_complete_events]} {
                set complete_events $found_complete_events
            }
            if {[regexp {complete_decode_failures=([0-9]+)} $line -> found_complete_decode_failures]} {
                set complete_decode_failures $found_complete_decode_failures
            }
            if {[regexp {missing_symbols=([0-9]+)} $line -> found_missing_symbols]} {
                set missing_symbols $found_missing_symbols
            }
        }
        if {!$saw_result &&
            [regexp {host-x11-present-trace: phase=present_trace_progress[^\r\n]*pid=([0-9]+)} $line -> found_pid] &&
            $found_pid eq $child_pid} {
            if {[regexp {pixmap_calls=([0-9]+)} $line -> found_pixmap_calls]} {
                set pixmap_calls $found_pixmap_calls
            }
            if {[regexp {pixmap_checked_calls=([0-9]+)} $line -> found_pixmap_checked_calls]} {
                set pixmap_checked_calls $found_pixmap_checked_calls
            }
            if {[regexp {register_special_xge_calls=([0-9]+)} $line -> found_register_special_xge_calls]} {
                set register_special_xge_calls $found_register_special_xge_calls
            }
            if {[regexp {present_special_registrations=([0-9]+)} $line -> found_present_special_registrations]} {
                set present_special_registrations $found_present_special_registrations
            }
            if {[regexp {wait_special_calls=([0-9]+)} $line -> found_wait_special_calls]} {
                set wait_special_calls $found_wait_special_calls
            }
            if {[regexp {poll_special_calls=([0-9]+)} $line -> found_poll_special_calls]} {
                set poll_special_calls $found_poll_special_calls
            }
            if {[regexp {complete_events=([0-9]+)} $line -> found_complete_events]} {
                set complete_events $found_complete_events
            }
            if {[regexp {complete_decode_failures=([0-9]+)} $line -> found_complete_decode_failures]} {
                set complete_decode_failures $found_complete_decode_failures
            }
            if {[regexp {missing_symbols=([0-9]+)} $line -> found_missing_symbols]} {
                set missing_symbols $found_missing_symbols
            }
        }
    }
}

proc x11_glx_present_trace_failure_label {enabled available child_pid saw_begin saw_result result_status pixmap_calls pixmap_checked_calls register_special_xge_calls present_special_registrations wait_special_calls poll_special_calls nonpresent_special_events pixmap_total_ms wait_special_total_ms poll_special_total_ms complete_events complete_decode_failures missing_symbols} {
    if {$enabled ne "1"} {
        return "x11-glx-fps-present-trace-not-enabled"
    }
    if {$available ne "1"} {
        return "x11-glx-fps-present-trace-unavailable"
    }
    if {$child_pid eq ""} {
        return "x11-glx-fps-present-trace-child-pid-missing"
    }
    if {!$saw_begin} {
        return "x11-glx-fps-present-trace-begin-missing"
    }
    if {!$saw_result} {
        return "x11-glx-fps-present-trace-result-missing"
    }
    if {$result_status ne "PASS"} {
        return "x11-glx-fps-present-trace-result-$result_status"
    }
    foreach value [list $pixmap_calls $pixmap_checked_calls $register_special_xge_calls $present_special_registrations $wait_special_calls $poll_special_calls $nonpresent_special_events $complete_events $complete_decode_failures $missing_symbols] {
        if {$value eq "" || ![string is integer -strict $value] || $value < 0} {
            return "x11-glx-fps-present-trace-counter-invalid"
        }
    }
    foreach value [list $pixmap_total_ms $wait_special_total_ms $poll_special_total_ms] {
        if {$value eq "" || ![string is double -strict $value] || $value < 0} {
            return "x11-glx-fps-present-trace-timing-invalid"
        }
    }
    if {$missing_symbols != 0} {
        return "x11-glx-fps-present-trace-missing-symbols"
    }
    if {$pixmap_calls + $pixmap_checked_calls <= 0} {
        return "x11-glx-fps-present-trace-pixmap-missing"
    }
    if {$register_special_xge_calls <= 0 || $present_special_registrations <= 0} {
        return "x11-glx-fps-present-trace-present-registration-missing"
    }
    if {$wait_special_calls + $poll_special_calls <= 0} {
        return "x11-glx-fps-present-trace-special-wait-missing"
    }
    if {$complete_events <= 0} {
        return "x11-glx-fps-present-trace-complete-missing"
    }
    return ""
}

proc x11_glx_swap_trace_scan_log {text child_pid capable_var result_var result_status_var xcb_capable_var syscall_capable_var buffers_var buffers_msc_oml_var total_ms_var max_ms_var nested_pixmap_var nested_pixmap_checked_var nested_pixmap_ms_var nested_wait_var nested_poll_var nested_wait_ms_var nested_poll_ms_var nested_complete_var nested_xcb_flush_var nested_xcb_flush_ms_var nested_xcb_request_check_var nested_xcb_request_check_ms_var nested_xcb_wait_reply_var nested_xcb_wait_reply_ms_var nested_xcb_poll_reply_var nested_xcb_poll_reply_ms_var nested_xcb_wait_event_var nested_xcb_wait_event_ms_var nested_xcb_poll_event_var nested_xcb_poll_event_ms_var accounted_ms_var above_ms_var accounted_xcb_ms_var above_xcb_ms_var syscall_total_ms_var syscall_nested_x11_ms_var syscall_above_x11_ms_var syscall_ioctl_calls_var syscall_ioctl_total_ms_var syscall_ioctl_max_ms_var syscall_poll_ppoll_calls_var syscall_poll_ppoll_total_ms_var syscall_poll_ppoll_max_ms_var syscall_select_pselect_calls_var syscall_select_pselect_total_ms_var syscall_select_pselect_max_ms_var syscall_read_recv_calls_var syscall_read_recv_total_ms_var syscall_read_recv_max_ms_var syscall_write_send_calls_var syscall_write_send_total_ms_var syscall_write_send_max_ms_var missing_symbols_var recursion_skips_var} {
    upvar 1 $capable_var glx_swap_trace_capable
    upvar 1 $result_var saw_result
    upvar 1 $result_status_var result_status
    upvar 1 $xcb_capable_var glx_swap_xcb_trace_capable
    upvar 1 $syscall_capable_var glx_swap_syscall_trace_capable
    upvar 1 $buffers_var glx_swap_buffers_calls
    upvar 1 $buffers_msc_oml_var glx_swap_buffers_msc_oml_calls
    upvar 1 $total_ms_var glx_swap_total_ms
    upvar 1 $max_ms_var glx_swap_max_ms
    upvar 1 $nested_pixmap_var glx_swap_nested_pixmap_calls
    upvar 1 $nested_pixmap_checked_var glx_swap_nested_pixmap_checked_calls
    upvar 1 $nested_pixmap_ms_var glx_swap_nested_pixmap_total_ms
    upvar 1 $nested_wait_var glx_swap_nested_wait_special_calls
    upvar 1 $nested_poll_var glx_swap_nested_poll_special_calls
    upvar 1 $nested_wait_ms_var glx_swap_nested_wait_special_total_ms
    upvar 1 $nested_poll_ms_var glx_swap_nested_poll_special_total_ms
    upvar 1 $nested_complete_var glx_swap_nested_complete_events
    upvar 1 $nested_xcb_flush_var glx_swap_nested_xcb_flush_calls
    upvar 1 $nested_xcb_flush_ms_var glx_swap_nested_xcb_flush_total_ms
    upvar 1 $nested_xcb_request_check_var glx_swap_nested_xcb_request_check_calls
    upvar 1 $nested_xcb_request_check_ms_var glx_swap_nested_xcb_request_check_total_ms
    upvar 1 $nested_xcb_wait_reply_var glx_swap_nested_xcb_wait_reply_calls
    upvar 1 $nested_xcb_wait_reply_ms_var glx_swap_nested_xcb_wait_reply_total_ms
    upvar 1 $nested_xcb_poll_reply_var glx_swap_nested_xcb_poll_reply_calls
    upvar 1 $nested_xcb_poll_reply_ms_var glx_swap_nested_xcb_poll_reply_total_ms
    upvar 1 $nested_xcb_wait_event_var glx_swap_nested_xcb_wait_event_calls
    upvar 1 $nested_xcb_wait_event_ms_var glx_swap_nested_xcb_wait_event_total_ms
    upvar 1 $nested_xcb_poll_event_var glx_swap_nested_xcb_poll_event_calls
    upvar 1 $nested_xcb_poll_event_ms_var glx_swap_nested_xcb_poll_event_total_ms
    upvar 1 $accounted_ms_var glx_swap_accounted_present_ms
    upvar 1 $above_ms_var glx_swap_above_present_ms
    upvar 1 $accounted_xcb_ms_var glx_swap_accounted_xcb_ms
    upvar 1 $above_xcb_ms_var glx_swap_above_xcb_ms
    upvar 1 $syscall_total_ms_var glx_swap_syscall_total_ms
    upvar 1 $syscall_nested_x11_ms_var glx_swap_syscall_nested_x11_ms
    upvar 1 $syscall_above_x11_ms_var glx_swap_syscall_above_x11_ms
    upvar 1 $syscall_ioctl_calls_var glx_swap_syscall_ioctl_calls
    upvar 1 $syscall_ioctl_total_ms_var glx_swap_syscall_ioctl_total_ms
    upvar 1 $syscall_ioctl_max_ms_var glx_swap_syscall_ioctl_max_ms
    upvar 1 $syscall_poll_ppoll_calls_var glx_swap_syscall_poll_ppoll_calls
    upvar 1 $syscall_poll_ppoll_total_ms_var glx_swap_syscall_poll_ppoll_total_ms
    upvar 1 $syscall_poll_ppoll_max_ms_var glx_swap_syscall_poll_ppoll_max_ms
    upvar 1 $syscall_select_pselect_calls_var glx_swap_syscall_select_pselect_calls
    upvar 1 $syscall_select_pselect_total_ms_var glx_swap_syscall_select_pselect_total_ms
    upvar 1 $syscall_select_pselect_max_ms_var glx_swap_syscall_select_pselect_max_ms
    upvar 1 $syscall_read_recv_calls_var glx_swap_syscall_read_recv_calls
    upvar 1 $syscall_read_recv_total_ms_var glx_swap_syscall_read_recv_total_ms
    upvar 1 $syscall_read_recv_max_ms_var glx_swap_syscall_read_recv_max_ms
    upvar 1 $syscall_write_send_calls_var glx_swap_syscall_write_send_calls
    upvar 1 $syscall_write_send_total_ms_var glx_swap_syscall_write_send_total_ms
    upvar 1 $syscall_write_send_max_ms_var glx_swap_syscall_write_send_max_ms
    upvar 1 $missing_symbols_var glx_swap_missing_symbols
    upvar 1 $recursion_skips_var glx_swap_recursion_skips

    if {$child_pid eq ""} {
        return
    }
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-present-trace: phase=present_trace status=BEGIN[^\r\n]*pid=([0-9]+)[^\r\n]*glx_swap_trace=1} $line -> found_pid] &&
            $found_pid eq $child_pid} {
            set glx_swap_trace_capable 1
            if {[regexp {glx_swap_xcb_trace=1} $line]} {
                set glx_swap_xcb_trace_capable 1
            }
            if {[regexp {glx_swap_syscall_trace=1} $line]} {
                set glx_swap_syscall_trace_capable 1
            }
        }
        if {![regexp {host-x11-present-trace: phase=glx_swap_trace_result status=([^ \r\n]+)[^\r\n]*pid=([0-9]+)} $line -> found_status found_pid] ||
            $found_pid ne $child_pid} {
            continue
        }
        set glx_swap_trace_capable 1
        set saw_result 1
        if {[regexp {glx_swap_syscall_trace=1} $line]} {
            set glx_swap_syscall_trace_capable 1
        }
        if {$found_status ne "PASS"} {
            set result_status $found_status
        } elseif {$result_status eq ""} {
            set result_status $found_status
        }
        if {[regexp {glx_swap_buffers_calls=([0-9]+)} $line -> found]} {
            set glx_swap_buffers_calls $found
        }
        if {[regexp {glx_swap_buffers_msc_oml_calls=([0-9]+)} $line -> found]} {
            set glx_swap_buffers_msc_oml_calls $found
        }
        if {[regexp {glx_swap_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_total_ms $found
        }
        if {[regexp {glx_swap_max_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_max_ms $found
        }
        if {[regexp {glx_swap_nested_pixmap_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_pixmap_calls $found
        }
        if {[regexp {glx_swap_nested_pixmap_checked_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_pixmap_checked_calls $found
        }
        if {[regexp {glx_swap_nested_pixmap_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_pixmap_total_ms $found
        }
        if {[regexp {glx_swap_nested_wait_special_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_wait_special_calls $found
        }
        if {[regexp {glx_swap_nested_poll_special_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_poll_special_calls $found
        }
        if {[regexp {glx_swap_nested_wait_special_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_wait_special_total_ms $found
        }
        if {[regexp {glx_swap_nested_poll_special_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_poll_special_total_ms $found
        }
        if {[regexp {glx_swap_nested_complete_events=([0-9]+)} $line -> found]} {
            set glx_swap_nested_complete_events $found
        }
        if {[regexp {glx_swap_nested_xcb_flush_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_xcb_flush_calls $found
        }
        if {[regexp {glx_swap_nested_xcb_flush_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_xcb_flush_total_ms $found
        }
        if {[regexp {glx_swap_nested_xcb_request_check_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_xcb_request_check_calls $found
        }
        if {[regexp {glx_swap_nested_xcb_request_check_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_xcb_request_check_total_ms $found
        }
        if {[regexp {glx_swap_nested_xcb_wait_reply_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_xcb_wait_reply_calls $found
        }
        if {[regexp {glx_swap_nested_xcb_wait_reply_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_xcb_wait_reply_total_ms $found
        }
        if {[regexp {glx_swap_nested_xcb_poll_reply_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_xcb_poll_reply_calls $found
        }
        if {[regexp {glx_swap_nested_xcb_poll_reply_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_xcb_poll_reply_total_ms $found
        }
        if {[regexp {glx_swap_nested_xcb_wait_event_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_xcb_wait_event_calls $found
        }
        if {[regexp {glx_swap_nested_xcb_wait_event_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_xcb_wait_event_total_ms $found
        }
        if {[regexp {glx_swap_nested_xcb_poll_event_calls=([0-9]+)} $line -> found]} {
            set glx_swap_nested_xcb_poll_event_calls $found
        }
        if {[regexp {glx_swap_nested_xcb_poll_event_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_nested_xcb_poll_event_total_ms $found
        }
        if {[regexp {glx_swap_accounted_present_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_accounted_present_ms $found
        }
        if {[regexp {glx_swap_above_present_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_above_present_ms $found
        }
        if {[regexp {glx_swap_accounted_xcb_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_accounted_xcb_ms $found
            set glx_swap_xcb_trace_capable 1
        }
        if {[regexp {glx_swap_above_xcb_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_above_xcb_ms $found
            set glx_swap_xcb_trace_capable 1
        }
        if {[regexp {glx_swap_syscall_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_syscall_total_ms $found
            set glx_swap_syscall_trace_capable 1
        }
        if {[regexp {glx_swap_syscall_nested_x11_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_syscall_nested_x11_ms $found
            set glx_swap_syscall_trace_capable 1
        }
        if {[regexp {glx_swap_syscall_above_x11_ms=([0-9]+(\.[0-9]+)?)} $line -> found _]} {
            set glx_swap_syscall_above_x11_ms $found
            set glx_swap_syscall_trace_capable 1
        }
        foreach family {ioctl poll_ppoll select_pselect read_recv write_send} {
            set prefix "glx_swap_syscall_${family}"
            if {[regexp [format {%s_calls=([0-9]+)} $prefix] $line -> found]} {
                set glx_swap_syscall_${family}_calls $found
                set glx_swap_syscall_trace_capable 1
            }
            if {[regexp [format {%s_total_ms=([0-9]+(\.[0-9]+)?)} $prefix] $line -> found _]} {
                set glx_swap_syscall_${family}_total_ms $found
                set glx_swap_syscall_trace_capable 1
            }
            if {[regexp [format {%s_max_ms=([0-9]+(\.[0-9]+)?)} $prefix] $line -> found _]} {
                set glx_swap_syscall_${family}_max_ms $found
                set glx_swap_syscall_trace_capable 1
            }
        }
        if {[regexp {glx_swap_missing_symbols=([0-9]+)} $line -> found]} {
            set glx_swap_missing_symbols $found
        }
        if {[regexp {glx_swap_recursion_skips=([0-9]+)} $line -> found]} {
            set glx_swap_recursion_skips $found
        }
    }
}

proc x11_glx_swap_trace_failure_label {child_pid saw_result result_status xcb_capable syscall_capable glx_swap_buffers_calls glx_swap_buffers_msc_oml_calls glx_swap_total_ms glx_swap_max_ms glx_swap_nested_pixmap_calls glx_swap_nested_pixmap_checked_calls glx_swap_nested_pixmap_total_ms glx_swap_nested_wait_special_calls glx_swap_nested_poll_special_calls glx_swap_nested_wait_special_total_ms glx_swap_nested_poll_special_total_ms glx_swap_nested_complete_events glx_swap_nested_xcb_flush_calls glx_swap_nested_xcb_flush_total_ms glx_swap_nested_xcb_request_check_calls glx_swap_nested_xcb_request_check_total_ms glx_swap_nested_xcb_wait_reply_calls glx_swap_nested_xcb_wait_reply_total_ms glx_swap_nested_xcb_poll_reply_calls glx_swap_nested_xcb_poll_reply_total_ms glx_swap_nested_xcb_wait_event_calls glx_swap_nested_xcb_wait_event_total_ms glx_swap_nested_xcb_poll_event_calls glx_swap_nested_xcb_poll_event_total_ms glx_swap_accounted_present_ms glx_swap_above_present_ms glx_swap_accounted_xcb_ms glx_swap_above_xcb_ms glx_swap_syscall_total_ms glx_swap_syscall_nested_x11_ms glx_swap_syscall_above_x11_ms glx_swap_syscall_ioctl_calls glx_swap_syscall_ioctl_total_ms glx_swap_syscall_ioctl_max_ms glx_swap_syscall_poll_ppoll_calls glx_swap_syscall_poll_ppoll_total_ms glx_swap_syscall_poll_ppoll_max_ms glx_swap_syscall_select_pselect_calls glx_swap_syscall_select_pselect_total_ms glx_swap_syscall_select_pselect_max_ms glx_swap_syscall_read_recv_calls glx_swap_syscall_read_recv_total_ms glx_swap_syscall_read_recv_max_ms glx_swap_syscall_write_send_calls glx_swap_syscall_write_send_total_ms glx_swap_syscall_write_send_max_ms glx_swap_missing_symbols glx_swap_recursion_skips} {
    if {$child_pid eq ""} {
        return "x11-glx-fps-glx-swap-trace-child-pid-missing"
    }
    if {!$saw_result} {
        return "x11-glx-fps-glx-swap-trace-result-missing"
    }
    if {$result_status ne "PASS"} {
        return "x11-glx-fps-glx-swap-trace-result-$result_status"
    }
    foreach value [list $glx_swap_buffers_calls $glx_swap_buffers_msc_oml_calls $glx_swap_nested_pixmap_calls $glx_swap_nested_pixmap_checked_calls $glx_swap_nested_wait_special_calls $glx_swap_nested_poll_special_calls $glx_swap_nested_complete_events $glx_swap_missing_symbols $glx_swap_recursion_skips] {
        if {$value eq "" || ![string is integer -strict $value] || $value < 0} {
            return "x11-glx-fps-glx-swap-trace-counter-invalid"
        }
    }
    foreach value [list $glx_swap_total_ms $glx_swap_max_ms $glx_swap_nested_pixmap_total_ms $glx_swap_nested_wait_special_total_ms $glx_swap_nested_poll_special_total_ms $glx_swap_accounted_present_ms $glx_swap_above_present_ms] {
        if {$value eq "" || ![string is double -strict $value] || $value < 0} {
            return "x11-glx-fps-glx-swap-trace-timing-invalid"
        }
    }
    if {$xcb_capable} {
        foreach value [list $glx_swap_nested_xcb_flush_calls $glx_swap_nested_xcb_request_check_calls $glx_swap_nested_xcb_wait_reply_calls $glx_swap_nested_xcb_poll_reply_calls $glx_swap_nested_xcb_wait_event_calls $glx_swap_nested_xcb_poll_event_calls] {
            if {$value eq "" || ![string is integer -strict $value] || $value < 0} {
                return "x11-glx-fps-glx-swap-trace-xcb-counter-invalid"
            }
        }
        foreach value [list $glx_swap_nested_xcb_flush_total_ms $glx_swap_nested_xcb_request_check_total_ms $glx_swap_nested_xcb_wait_reply_total_ms $glx_swap_nested_xcb_poll_reply_total_ms $glx_swap_nested_xcb_wait_event_total_ms $glx_swap_nested_xcb_poll_event_total_ms $glx_swap_accounted_xcb_ms $glx_swap_above_xcb_ms] {
            if {$value eq "" || ![string is double -strict $value] || $value < 0} {
                return "x11-glx-fps-glx-swap-trace-xcb-timing-invalid"
            }
        }
        if {$glx_swap_accounted_xcb_ms > $glx_swap_total_ms + 0.010} {
            return "x11-glx-fps-glx-swap-trace-xcb-accounting-exceeds-total"
        }
        if {$glx_swap_accounted_present_ms + $glx_swap_accounted_xcb_ms > $glx_swap_total_ms + 0.010} {
            return "x11-glx-fps-glx-swap-trace-combined-accounting-exceeds-total"
        }
    }
    if {$syscall_capable} {
        foreach value [list $glx_swap_syscall_ioctl_calls $glx_swap_syscall_poll_ppoll_calls $glx_swap_syscall_select_pselect_calls $glx_swap_syscall_read_recv_calls $glx_swap_syscall_write_send_calls] {
            if {$value eq "" || ![string is integer -strict $value] || $value < 0} {
                return "x11-glx-fps-glx-swap-trace-syscall-counter-invalid"
            }
        }
        foreach value [list $glx_swap_syscall_total_ms $glx_swap_syscall_nested_x11_ms $glx_swap_syscall_above_x11_ms $glx_swap_syscall_ioctl_total_ms $glx_swap_syscall_ioctl_max_ms $glx_swap_syscall_poll_ppoll_total_ms $glx_swap_syscall_poll_ppoll_max_ms $glx_swap_syscall_select_pselect_total_ms $glx_swap_syscall_select_pselect_max_ms $glx_swap_syscall_read_recv_total_ms $glx_swap_syscall_read_recv_max_ms $glx_swap_syscall_write_send_total_ms $glx_swap_syscall_write_send_max_ms] {
            if {$value eq "" || ![string is double -strict $value] || $value < 0} {
                return "x11-glx-fps-glx-swap-trace-syscall-timing-invalid"
            }
        }
        if {$glx_swap_syscall_nested_x11_ms > $glx_swap_syscall_total_ms + 0.010} {
            return "x11-glx-fps-glx-swap-trace-syscall-nested-exceeds-total"
        }
        if {$glx_swap_syscall_nested_x11_ms + $glx_swap_syscall_above_x11_ms > $glx_swap_syscall_total_ms + 0.010} {
            return "x11-glx-fps-glx-swap-trace-syscall-accounting-exceeds-total"
        }
    }
    if {$glx_swap_missing_symbols != 0} {
        return "x11-glx-fps-glx-swap-trace-missing-symbols"
    }
    if {$glx_swap_buffers_calls + $glx_swap_buffers_msc_oml_calls <= 0} {
        return "x11-glx-fps-glx-swap-trace-swap-missing"
    }
    return ""
}

proc x11_glx_swap_ioctl_trace_init {state_var} {
    upvar 1 $state_var state

    array set state {
        capable 0 result 0 status ""
        bucket_cap "" bucket_count "" bucket_drops "" top_count ""
        top_total_ms "" summary ""
    }
    for {set i 0} {$i < 5} {incr i} {
        foreach field {req name role calls total_ms max_ms nested_x11_ms above_x11_ms ret_ok ret_fail last_errno arg_read_attempts arg_read_ok arg_read_fail arg_read_fallback_ok last_arg_errno shape} {
            set state(top${i}_$field) ""
        }
    }
}

proc x11_glx_swap_ioctl_trace_scan_log {text child_pid state_var} {
    upvar 1 $state_var state

    if {$child_pid eq ""} {
        return
    }
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-present-trace: phase=present_trace status=BEGIN[^\r\n]*pid=([0-9]+)[^\r\n]*glx_swap_ioctl_trace=1} $line -> found_pid] &&
            $found_pid eq $child_pid} {
            set state(capable) 1
        }
        if {![regexp {host-x11-present-trace: phase=glx_swap_ioctl_trace_result status=([^ \r\n]+)[^\r\n]*pid=([0-9]+)} $line -> found_status found_pid] ||
            $found_pid ne $child_pid} {
            continue
        }
        set state(capable) 1
        set state(result) 1
        set state(status) $found_status
        foreach {key field} {
            ioctl_bucket_cap bucket_cap
            ioctl_bucket_count bucket_count
            ioctl_bucket_drops bucket_drops
            top_count top_count
        } {
            if {[regexp [format {%s=([0-9]+)} $key] $line -> found]} {
                set state($field) $found
            }
        }
        set top_total 0.0
        set summary ""
        for {set i 0} {$i < 5} {incr i} {
            foreach field {req name role shape} {
                if {[regexp [format {top%d_%s=([^ \r\n]+)} $i $field] $line -> found]} {
                    set state(top${i}_$field) $found
                }
            }
            foreach field {calls ret_ok ret_fail last_errno arg_read_attempts arg_read_ok arg_read_fail arg_read_fallback_ok last_arg_errno} {
                if {[regexp [format {top%d_%s=([0-9]+)} $i $field] $line -> found]} {
                    set state(top${i}_$field) $found
                }
            }
            foreach field {total_ms max_ms nested_x11_ms above_x11_ms} {
                if {[regexp [format {top%d_%s=([0-9]+(\.[0-9]+)?)} $i $field] $line -> found _]} {
                    set state(top${i}_$field) $found
                }
            }
            if {$state(top${i}_total_ms) ne ""} {
                set top_total [expr {$top_total + double($state(top${i}_total_ms))}]
            }
            if {$state(top${i}_name) ne ""} {
                if {$summary ne ""} {
                    append summary ","
                }
                append summary "$i:$state(top${i}_name):$state(top${i}_role):c=$state(top${i}_calls):t=$state(top${i}_total_ms):arg=$state(top${i}_arg_read_ok)/$state(top${i}_arg_read_attempts):fb=$state(top${i}_arg_read_fallback_ok):s=$state(top${i}_shape)"
            }
        }
        set state(top_total_ms) [format %.3f $top_total]
        set state(summary) $summary
    }
}

proc x11_glx_swap_ioctl_trace_failure_label {state_var syscall_ioctl_calls syscall_ioctl_total_ms} {
    upvar 1 $state_var state

    if {!$state(capable) && !$state(result)} {
        return ""
    }
    if {!$state(result)} {
        return "x11-glx-fps-glx-swap-ioctl-trace-result-missing"
    }
    if {$state(status) ne "PASS"} {
        return "x11-glx-fps-glx-swap-ioctl-trace-result-$state(status)"
    }
    foreach field {bucket_cap bucket_count bucket_drops top_count} {
        if {$state($field) eq "" || ![string is integer -strict $state($field)] || $state($field) < 0} {
            return "x11-glx-fps-glx-swap-ioctl-trace-counter-invalid"
        }
    }
    if {$state(bucket_cap) > 12 || $state(bucket_count) > $state(bucket_cap) ||
        $state(top_count) > 5 || $state(top_count) > $state(bucket_count)} {
        return "x11-glx-fps-glx-swap-ioctl-trace-cap-invalid"
    }
    if {$state(bucket_drops) != 0} {
        return "x11-glx-fps-glx-swap-ioctl-trace-bucket-drops"
    }
    if {$syscall_ioctl_calls ne "" &&
        [string is integer -strict $syscall_ioctl_calls] &&
        $syscall_ioctl_calls > 0 &&
        ($state(bucket_count) <= 0 || $state(top_count) <= 0)} {
        return "x11-glx-fps-glx-swap-ioctl-trace-buckets-empty"
    }
    if {$syscall_ioctl_total_ms ne "" &&
        [string is double -strict $syscall_ioctl_total_ms] &&
        $syscall_ioctl_total_ms > 0.010 &&
        ($state(top_total_ms) eq "" ||
         ![string is double -strict $state(top_total_ms)] ||
         $state(top_total_ms) <= 0.010)} {
        return "x11-glx-fps-glx-swap-ioctl-trace-top-total-empty"
    }
    for {set i 0} {$i < $state(top_count)} {incr i} {
        foreach field {req name role shape} {
            if {$state(top${i}_$field) eq ""} {
                return "x11-glx-fps-glx-swap-ioctl-trace-top-field-missing"
            }
        }
        if {![regexp {^0x[0-9a-fA-F]+$} $state(top${i}_req)]} {
            return "x11-glx-fps-glx-swap-ioctl-trace-top-req-invalid"
        }
        foreach field {calls ret_ok ret_fail last_errno arg_read_attempts arg_read_ok arg_read_fail arg_read_fallback_ok last_arg_errno} {
            if {$state(top${i}_$field) eq "" || ![string is integer -strict $state(top${i}_$field)] || $state(top${i}_$field) < 0} {
                return "x11-glx-fps-glx-swap-ioctl-trace-top-counter-invalid"
            }
        }
        foreach field {total_ms max_ms nested_x11_ms above_x11_ms} {
            if {$state(top${i}_$field) eq "" || ![string is double -strict $state(top${i}_$field)] || $state(top${i}_$field) < 0} {
                return "x11-glx-fps-glx-swap-ioctl-trace-top-timing-invalid"
            }
        }
        if {$state(top${i}_calls) <= 0} {
            return "x11-glx-fps-glx-swap-ioctl-trace-top-calls-empty"
        }
        if {$state(top${i}_ret_ok) + $state(top${i}_ret_fail) != $state(top${i}_calls)} {
            return "x11-glx-fps-glx-swap-ioctl-trace-top-ret-accounting-invalid"
        }
        if {$state(top${i}_arg_read_ok) + $state(top${i}_arg_read_fail) != $state(top${i}_arg_read_attempts)} {
            return "x11-glx-fps-glx-swap-ioctl-trace-top-arg-read-accounting-invalid"
        }
        if {$state(top${i}_arg_read_fallback_ok) > $state(top${i}_arg_read_ok)} {
            return "x11-glx-fps-glx-swap-ioctl-trace-top-arg-read-fallback-invalid"
        }
        if {$state(top${i}_max_ms) > $state(top${i}_total_ms) + 0.010} {
            return "x11-glx-fps-glx-swap-ioctl-trace-top-max-exceeds-total"
        }
        if {$state(top${i}_nested_x11_ms) + $state(top${i}_above_x11_ms) > $state(top${i}_total_ms) + 0.010} {
            return "x11-glx-fps-glx-swap-ioctl-trace-top-x11-accounting-invalid"
        }
    }
    if {$state(top_total_ms) ne "" &&
        $syscall_ioctl_total_ms ne "" &&
        [string is double -strict $syscall_ioctl_total_ms] &&
        $state(top_total_ms) > $syscall_ioctl_total_ms + (0.050 + $syscall_ioctl_total_ms * 0.01)} {
        return "x11-glx-fps-glx-swap-ioctl-trace-top-total-exceeds-ioctl-total"
    }
    return ""
}

proc metric_is_nonnegative_double {value} {
    return [expr {$value ne "" &&
                  [string is double -strict $value] &&
                  double($value) >= 0.0}]
}

proc metric_percent {part total} {
    if {![metric_is_nonnegative_double $part] ||
        ![metric_is_nonnegative_double $total] ||
        double($total) <= 0.0} {
        return "n/a"
    }
    return [format %.1f [expr {100.0 * double($part) / double($total)}]]
}

proc metric_value_or_na {value} {
    if {$value eq ""} {
        return "n/a"
    }
    return $value
}

proc x11_glx_write_bottleneck_summary {
    session_status exit_status fps_status fps_frames fps_elapsed fps_value
    result_variant plain_swap_avg plain_swap_max glx_swap_total_ms
    glx_swap_accounted_present_ms glx_swap_accounted_xcb_ms
    glx_swap_syscall_total_ms glx_swap_syscall_ioctl_total_ms
    glx_swap_syscall_poll_ppoll_total_ms glx_swap_syscall_read_recv_total_ms
    glx_swap_syscall_write_send_total_ms state_var
} {
    global host_x11_glx_bottleneck_summary_log
    upvar 1 $state_var state

    set bottleneck "unclassified"
    if {$state(top0_name) ne "" && [metric_is_nonnegative_double $state(top0_total_ms)]} {
        set bottleneck "$state(top0_name)/$state(top0_role)"
    } elseif {[metric_is_nonnegative_double $glx_swap_syscall_ioctl_total_ms]} {
        set bottleneck "ioctl"
    } elseif {[metric_is_nonnegative_double $glx_swap_syscall_total_ms]} {
        set bottleneck "syscall"
    } elseif {[metric_is_nonnegative_double $glx_swap_total_ms]} {
        set bottleneck "glx-swap"
    }

    set fh [open $host_x11_glx_bottleneck_summary_log w]
    puts $fh "x11_glx_bottleneck_summary status=INFO reducer=x11-glx-fps session_status=$session_status exit_status=$exit_status fps_status=$fps_status"
    puts $fh "x11_glx_bottleneck_summary fps frames=[metric_value_or_na $fps_frames] elapsed_seconds=[metric_value_or_na $fps_elapsed] fps=[metric_value_or_na $fps_value] variant=[metric_value_or_na $result_variant]"
    puts $fh "x11_glx_bottleneck_summary swap plain_avg_ms=[metric_value_or_na $plain_swap_avg] plain_max_ms=[metric_value_or_na $plain_swap_max] glx_swap_total_ms=[metric_value_or_na $glx_swap_total_ms]"
    puts $fh "x11_glx_bottleneck_summary attribution present_ms=[metric_value_or_na $glx_swap_accounted_present_ms] present_pct=[metric_percent $glx_swap_accounted_present_ms $glx_swap_total_ms] xcb_ms=[metric_value_or_na $glx_swap_accounted_xcb_ms] xcb_pct=[metric_percent $glx_swap_accounted_xcb_ms $glx_swap_total_ms] syscall_ms=[metric_value_or_na $glx_swap_syscall_total_ms] syscall_pct=[metric_percent $glx_swap_syscall_total_ms $glx_swap_total_ms]"
    puts $fh "x11_glx_bottleneck_summary syscall ioctl_ms=[metric_value_or_na $glx_swap_syscall_ioctl_total_ms] ioctl_pct_of_swap=[metric_percent $glx_swap_syscall_ioctl_total_ms $glx_swap_total_ms] poll_ppoll_ms=[metric_value_or_na $glx_swap_syscall_poll_ppoll_total_ms] poll_ppoll_pct_of_swap=[metric_percent $glx_swap_syscall_poll_ppoll_total_ms $glx_swap_total_ms] read_recv_ms=[metric_value_or_na $glx_swap_syscall_read_recv_total_ms] write_send_ms=[metric_value_or_na $glx_swap_syscall_write_send_total_ms]"
    puts $fh "x11_glx_bottleneck_summary top_ioctl name=[metric_value_or_na $state(top0_name)] role=[metric_value_or_na $state(top0_role)] calls=[metric_value_or_na $state(top0_calls)] total_ms=[metric_value_or_na $state(top0_total_ms)] pct_of_ioctl=[metric_percent $state(top0_total_ms) $glx_swap_syscall_ioctl_total_ms] pct_of_swap=[metric_percent $state(top0_total_ms) $glx_swap_total_ms] max_ms=[metric_value_or_na $state(top0_max_ms)] ret_ok=[metric_value_or_na $state(top0_ret_ok)] ret_fail=[metric_value_or_na $state(top0_ret_fail)] shape=[metric_value_or_na $state(top0_shape)]"
    puts $fh "x11_glx_bottleneck_summary bottleneck=$bottleneck evidence=host-gui-host-x11-egl-smoke.log,host-gui-host-x11-present-trace.log"
    close $fh
}

proc x11_present_fps_failure_label_from_line {line} {
    set line [string trim $line]
    if {[regexp {host-x11-dri3-present-smoke: phase=present_fps_result status=FAIL} $line]} {
        if {[regexp {reason=([^ \r\n]+)} $line -> reason]} {
            return "x11-present-fps-result-FAIL-$reason"
        }
        return "x11-present-fps-result-FAIL"
    }
    if {[regexp {host-x11-dri3-present-smoke: phase=([A-Za-z0-9_]+)[^\r\n]*status=FAIL} $line -> phase]} {
        return "x11-present-fps-${phase}-status-FAIL"
    }
    if {[regexp {host-x11-egl-smoke: phase=present_fps_variant[^\r\n]*status=FAIL[^\r\n]*reason=([^ \r\n]+)} $line -> reason]} {
        return "x11-present-fps-variant-$reason"
    }
    if {[regexp {host-x11-dri3-present-smoke: (connect|atom setup|event) (failed|eof)} $line -> phase reason]} {
        regsub -all { } $phase {_} phase
        return "x11-present-fps-${phase}-${reason}"
    }
    if {[regexp {No such file|cannot execute|not found} $line]} {
        return "x11-present-fps-exec-missing"
    }
    return ""
}

proc x11_egl_scan_glx_probe_log {text start_var connect_var egl_init_var glx_ext_var glx_version_var fbconfigs_var visual_var context_var current_var strings_var draw_var result_var failure_var} {
    upvar 1 $start_var saw_start
    upvar 1 $connect_var saw_connect
    upvar 1 $egl_init_var saw_egl_init
    upvar 1 $glx_ext_var saw_glx_ext
    upvar 1 $glx_version_var saw_glx_version
    upvar 1 $fbconfigs_var saw_fbconfigs
    upvar 1 $visual_var saw_visual
    upvar 1 $context_var saw_context
    upvar 1 $current_var saw_current
    upvar 1 $strings_var saw_strings
    upvar 1 $draw_var saw_draw
    upvar 1 $result_var saw_result
    upvar 1 $failure_var failure_label

    set in_glx_probe 0
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-egl-smoke: phase=start status=BEGIN mode=glx-probe} $line]} {
            set in_glx_probe 1
            set saw_start 1
        }
        if {!$in_glx_probe} {
            continue
        }
        if {[regexp {host-x11-egl-smoke: phase=x11_connect status=PASS} $line]} {
            set saw_connect 1
        }
        if {[regexp {host-x11-egl-smoke: phase=egl_initialize status=(PASS|FALLBACK)} $line]} {
            set saw_egl_init 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_query_extension status=PASS} $line]} {
            set saw_glx_ext 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_query_version status=PASS} $line]} {
            set saw_glx_version 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_fbconfigs status=PASS} $line]} {
            set saw_fbconfigs 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_choose_visual status=PASS} $line]} {
            set saw_visual 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_create_context status=PASS} $line]} {
            set saw_context 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_make_current status=PASS} $line]} {
            set saw_current 1
        }
        if {[regexp {host-x11-egl-smoke: phase=gl_strings status=PASS} $line]} {
            set saw_strings 1
        }
        if {[regexp {host-x11-egl-smoke: phase=draw status=PASS} $line]} {
            set saw_draw 1
        }
        if {[regexp {host-x11-egl-smoke: phase=result status=PASS} $line]} {
            set saw_result 1
        }
        if {$failure_label eq ""} {
            set label [x11_egl_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
}

proc x11_glx_fps_scan_log {text start_var connect_var egl_init_var glx_ext_var glx_version_var fbconfigs_var visual_var context_var current_var strings_var fps_begin_var fps_result_var fps_status_var fps_frames_var fps_elapsed_var fps_value_var variant_var requested_depth_var requested_sample_interval_var result_variant_var oml_available_var queue_depth_var sbc_issued_var sbc_completed_var max_pending_var oml_last_sbc_var gl_flush_total_var swap_msc_issue_total_var get_sync_before_total_var get_sync_after_total_var issue_state_sample_interval_var issue_state_sampled_ratio_var issue_state_first_sample_frame_var issue_state_last_sample_frame_var issue_state_first_sample_sbc_var issue_state_last_sample_sbc_var issue_state_samples_var post_issue_sbc_completed_count_var post_issue_sbc_lag_max_var post_issue_msc_delta_total_var post_issue_msc_delta_max_var swap_only_skipped_draw_frames_var swap_interval_requested_var swap_interval_set_api_var swap_interval_set_status_var swap_interval_before_var swap_interval_after_var plain_swap_issue_total_var plain_swap_avg_var plain_swap_max_var plain_oml_available_var plain_oml_samples_var plain_oml_sample_interval_var plain_oml_sampled_ratio_var plain_oml_first_sample_frame_var plain_oml_last_sample_frame_var plain_oml_get_sync_before_total_var plain_oml_get_sync_after_total_var plain_oml_before_first_sbc_var plain_oml_before_last_sbc_var plain_oml_after_first_sbc_var plain_oml_after_last_sbc_var plain_oml_post_swap_sbc_delta_total_var plain_oml_post_swap_sbc_delta_max_var plain_oml_post_swap_msc_delta_total_var plain_oml_post_swap_msc_delta_max_var plain_post_swap_xsync_total_var plain_post_swap_xsync_max_var failure_var} {
    upvar 1 $start_var saw_start
    upvar 1 $connect_var saw_connect
    upvar 1 $egl_init_var saw_egl_init
    upvar 1 $glx_ext_var saw_glx_ext
    upvar 1 $glx_version_var saw_glx_version
    upvar 1 $fbconfigs_var saw_fbconfigs
    upvar 1 $visual_var saw_visual
    upvar 1 $context_var saw_context
    upvar 1 $current_var saw_current
    upvar 1 $strings_var saw_strings
    upvar 1 $fps_begin_var saw_fps_begin
    upvar 1 $fps_result_var saw_fps_result
    upvar 1 $fps_status_var fps_status
    upvar 1 $fps_frames_var fps_frames
    upvar 1 $fps_elapsed_var fps_elapsed
    upvar 1 $fps_value_var fps_value
    upvar 1 $variant_var variant
    upvar 1 $requested_depth_var requested_depth
    upvar 1 $requested_sample_interval_var requested_sample_interval
    upvar 1 $result_variant_var result_variant
    upvar 1 $oml_available_var oml_available
    upvar 1 $queue_depth_var queue_depth
    upvar 1 $sbc_issued_var sbc_issued
    upvar 1 $sbc_completed_var sbc_completed
    upvar 1 $max_pending_var max_pending
    upvar 1 $oml_last_sbc_var oml_last_sbc
    upvar 1 $gl_flush_total_var gl_flush_total
    upvar 1 $swap_msc_issue_total_var swap_msc_issue_total
    upvar 1 $get_sync_before_total_var get_sync_before_total
    upvar 1 $get_sync_after_total_var get_sync_after_total
    upvar 1 $issue_state_sample_interval_var issue_state_sample_interval
    upvar 1 $issue_state_sampled_ratio_var issue_state_sampled_ratio
    upvar 1 $issue_state_first_sample_frame_var issue_state_first_sample_frame
    upvar 1 $issue_state_last_sample_frame_var issue_state_last_sample_frame
    upvar 1 $issue_state_first_sample_sbc_var issue_state_first_sample_sbc
    upvar 1 $issue_state_last_sample_sbc_var issue_state_last_sample_sbc
    upvar 1 $issue_state_samples_var issue_state_samples
    upvar 1 $post_issue_sbc_completed_count_var post_issue_sbc_completed_count
    upvar 1 $post_issue_sbc_lag_max_var post_issue_sbc_lag_max
    upvar 1 $post_issue_msc_delta_total_var post_issue_msc_delta_total
    upvar 1 $post_issue_msc_delta_max_var post_issue_msc_delta_max
    upvar 1 $swap_only_skipped_draw_frames_var swap_only_skipped_draw_frames
    upvar 1 $swap_interval_requested_var swap_interval_requested
    upvar 1 $swap_interval_set_api_var swap_interval_set_api
    upvar 1 $swap_interval_set_status_var swap_interval_set_status
    upvar 1 $swap_interval_before_var swap_interval_before
    upvar 1 $swap_interval_after_var swap_interval_after
    upvar 1 $plain_swap_issue_total_var plain_swap_issue_total
    upvar 1 $plain_swap_avg_var plain_swap_avg
    upvar 1 $plain_swap_max_var plain_swap_max
    upvar 1 $plain_oml_available_var plain_oml_available
    upvar 1 $plain_oml_samples_var plain_oml_samples
    upvar 1 $plain_oml_sample_interval_var plain_oml_sample_interval
    upvar 1 $plain_oml_sampled_ratio_var plain_oml_sampled_ratio
    upvar 1 $plain_oml_first_sample_frame_var plain_oml_first_sample_frame
    upvar 1 $plain_oml_last_sample_frame_var plain_oml_last_sample_frame
    upvar 1 $plain_oml_get_sync_before_total_var plain_oml_get_sync_before_total
    upvar 1 $plain_oml_get_sync_after_total_var plain_oml_get_sync_after_total
    upvar 1 $plain_oml_before_first_sbc_var plain_oml_before_first_sbc
    upvar 1 $plain_oml_before_last_sbc_var plain_oml_before_last_sbc
    upvar 1 $plain_oml_after_first_sbc_var plain_oml_after_first_sbc
    upvar 1 $plain_oml_after_last_sbc_var plain_oml_after_last_sbc
    upvar 1 $plain_oml_post_swap_sbc_delta_total_var plain_oml_post_swap_sbc_delta_total
    upvar 1 $plain_oml_post_swap_sbc_delta_max_var plain_oml_post_swap_sbc_delta_max
    upvar 1 $plain_oml_post_swap_msc_delta_total_var plain_oml_post_swap_msc_delta_total
    upvar 1 $plain_oml_post_swap_msc_delta_max_var plain_oml_post_swap_msc_delta_max
    upvar 1 plain_oml_after_sbc_delta_total plain_oml_after_sbc_delta_total
    upvar 1 plain_oml_after_sbc_delta_max plain_oml_after_sbc_delta_max
    upvar 1 plain_oml_after_msc_delta_total plain_oml_after_msc_delta_total
    upvar 1 plain_oml_after_msc_delta_max plain_oml_after_msc_delta_max
    upvar 1 $plain_post_swap_xsync_total_var plain_post_swap_xsync_total
    upvar 1 $plain_post_swap_xsync_max_var plain_post_swap_xsync_max
    upvar 1 $failure_var failure_label

    set in_glx_fps 0
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-egl-smoke: phase=start status=BEGIN mode=glx-fps} $line]} {
            set in_glx_fps 1
            set saw_start 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_fps status=BEGIN} $line] ||
            [regexp {host-x11-egl-smoke: phase=glx_fps_result status=(PASS|FAIL)} $line] ||
            [regexp {host-x11-egl-smoke: phase=glx_fps_timing status=PASS result_status=PASS} $line]} {
            set in_glx_fps 1
        }
        if {[regexp {^probe_glx_fps_variant=([^ \r\n]+)} $line -> found_variant]} {
            set variant $found_variant
        }
        if {[regexp {^probe_glx_fps_oml_queue_depth=([0-9]+)} $line -> found_requested_depth]} {
            set requested_depth $found_requested_depth
        }
        if {[regexp {^probe_glx_fps_oml_issue_state_sample_interval=([0-9]+)} $line -> found_requested_sample_interval]} {
            set requested_sample_interval $found_requested_sample_interval
        }
        if {!$in_glx_fps} {
            if {$failure_label eq ""} {
                set label [x11_glx_fps_failure_label_from_line $line]
                if {$label ne ""} {
                    set failure_label $label
                }
            }
            continue
        }
        if {[regexp {host-x11-egl-smoke: phase=x11_connect status=PASS} $line]} {
            set saw_connect 1
        }
        if {[regexp {host-x11-egl-smoke: phase=egl_initialize status=(PASS|FALLBACK)} $line]} {
            set saw_egl_init 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_query_extension status=PASS} $line]} {
            set saw_glx_ext 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_query_version status=PASS} $line]} {
            set saw_glx_version 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_fbconfigs status=PASS} $line]} {
            set saw_fbconfigs 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_choose_visual status=PASS} $line]} {
            set saw_visual 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_create_context status=PASS} $line]} {
            set saw_context 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_make_current status=PASS} $line]} {
            set saw_current 1
        }
        if {[regexp {host-x11-egl-smoke: phase=gl_strings status=PASS} $line]} {
            set saw_strings 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_fps status=BEGIN} $line]} {
            set saw_fps_begin 1
        }
        if {[regexp {host-x11-egl-smoke: phase=glx_fps_result status=(PASS|FAIL)[^\r\n]*renderer="[^"]*"[^\r\n]*vendor="[^"]*"[^\r\n]*gl_version="[^"]*"[^\r\n]*direct_available=[0-9]+[^\r\n]*direct=-?[0-9]+[^\r\n]*frames=([0-9]+)[^\r\n]*elapsed_seconds=([0-9]+(\.[0-9]+)?)[^\r\n]*fps=([0-9]+(\.[0-9]+)?)} $line -> found_status found_frames found_elapsed _ found_fps]} {
            set saw_fps_result 1
            set fps_status $found_status
            set fps_frames $found_frames
            set fps_elapsed $found_elapsed
            set fps_value $found_fps
            if {[regexp {variant=([^ \r\n]+)} $line -> found_variant]} {
                set result_variant $found_variant
            }
            if {[regexp {oml_available=([0-9]+)} $line -> found_oml_available]} {
                set oml_available $found_oml_available
            }
            if {[regexp {oml_queue_depth=([0-9]+)} $line -> found_queue_depth]} {
                set queue_depth $found_queue_depth
            }
            if {[regexp {oml_sbc_issued=([0-9]+)} $line -> found_sbc_issued]} {
                set sbc_issued $found_sbc_issued
            }
            if {[regexp {oml_sbc_completed=([0-9]+)} $line -> found_sbc_completed]} {
                set sbc_completed $found_sbc_completed
            }
            if {[regexp {oml_max_pending_sbc=([0-9]+)} $line -> found_max_pending]} {
                set max_pending $found_max_pending
            }
            if {[regexp {oml_last_sbc=(-?[0-9]+)} $line -> found_oml_last_sbc]} {
                set oml_last_sbc $found_oml_last_sbc
            }
            if {[regexp {oml_gl_flush_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_gl_flush_total _]} {
                set gl_flush_total $found_gl_flush_total
            }
            if {[regexp {oml_swap_msc_issue_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_swap_msc_issue_total _]} {
                set swap_msc_issue_total $found_swap_msc_issue_total
            }
            if {[regexp {oml_get_sync_before_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_get_sync_before_total _]} {
                set get_sync_before_total $found_get_sync_before_total
            }
            if {[regexp {oml_get_sync_after_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_get_sync_after_total _]} {
                set get_sync_after_total $found_get_sync_after_total
            }
            if {[regexp {oml_issue_state_sample_interval=([0-9]+)} $line -> found_issue_state_sample_interval]} {
                set issue_state_sample_interval $found_issue_state_sample_interval
            }
            if {[regexp {oml_issue_state_sampled_ratio=([0-9]+/[0-9]+)} $line -> found_issue_state_sampled_ratio]} {
                set issue_state_sampled_ratio $found_issue_state_sampled_ratio
            }
            if {[regexp {oml_issue_state_first_sample_frame=([0-9]+)} $line -> found_issue_state_first_sample_frame]} {
                set issue_state_first_sample_frame $found_issue_state_first_sample_frame
            }
            if {[regexp {oml_issue_state_last_sample_frame=([0-9]+)} $line -> found_issue_state_last_sample_frame]} {
                set issue_state_last_sample_frame $found_issue_state_last_sample_frame
            }
            if {[regexp {oml_issue_state_first_sample_sbc=(-?[0-9]+)} $line -> found_issue_state_first_sample_sbc]} {
                set issue_state_first_sample_sbc $found_issue_state_first_sample_sbc
            }
            if {[regexp {oml_issue_state_last_sample_sbc=(-?[0-9]+)} $line -> found_issue_state_last_sample_sbc]} {
                set issue_state_last_sample_sbc $found_issue_state_last_sample_sbc
            }
            if {[regexp {oml_issue_state_samples=([0-9]+)} $line -> found_issue_state_samples]} {
                set issue_state_samples $found_issue_state_samples
            }
            if {[regexp {oml_post_issue_sbc_completed_count=([0-9]+)} $line -> found_post_issue_sbc_completed_count]} {
                set post_issue_sbc_completed_count $found_post_issue_sbc_completed_count
            }
            if {[regexp {oml_post_issue_sbc_lag_max=(-?[0-9]+)} $line -> found_post_issue_sbc_lag_max]} {
                set post_issue_sbc_lag_max $found_post_issue_sbc_lag_max
            }
            if {[regexp {oml_post_issue_msc_delta_total=(-?[0-9]+)} $line -> found_post_issue_msc_delta_total]} {
                set post_issue_msc_delta_total $found_post_issue_msc_delta_total
            }
            if {[regexp {oml_post_issue_msc_delta_max=(-?[0-9]+)} $line -> found_post_issue_msc_delta_max]} {
                set post_issue_msc_delta_max $found_post_issue_msc_delta_max
            }
            if {[regexp {swap_only_skipped_draw_frames=([0-9]+)} $line -> found_swap_only_skipped_draw_frames]} {
                set swap_only_skipped_draw_frames $found_swap_only_skipped_draw_frames
            }
            if {[regexp {swap_interval_requested=([0-9]+)} $line -> found_swap_interval_requested]} {
                set swap_interval_requested $found_swap_interval_requested
            }
            if {[regexp {swap_interval_set_api=([^ \r\n]+)} $line -> found_swap_interval_set_api]} {
                set swap_interval_set_api $found_swap_interval_set_api
            }
            if {[regexp {swap_interval_set_status=([^ \r\n]+)} $line -> found_swap_interval_set_status]} {
                set swap_interval_set_status $found_swap_interval_set_status
            }
            if {[regexp {swap_interval_before=(-?[0-9]+)} $line -> found_swap_interval_before]} {
                set swap_interval_before $found_swap_interval_before
            }
            if {[regexp {swap_interval_after=(-?[0-9]+)} $line -> found_swap_interval_after]} {
                set swap_interval_after $found_swap_interval_after
            }
            if {[regexp {plain_swap_issue_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_swap_issue_total _]} {
                set plain_swap_issue_total $found_plain_swap_issue_total
            }
            if {[regexp {plain_swap_avg_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_swap_avg _]} {
                set plain_swap_avg $found_plain_swap_avg
            }
            if {[regexp {plain_swap_max_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_swap_max _]} {
                set plain_swap_max $found_plain_swap_max
            }
            if {[regexp {plain_oml_available=([0-9]+)} $line -> found_plain_oml_available]} {
                set plain_oml_available $found_plain_oml_available
            }
            if {[regexp {plain_oml_samples=([0-9]+)} $line -> found_plain_oml_samples]} {
                set plain_oml_samples $found_plain_oml_samples
            }
            if {[regexp {plain_oml_sample_interval=([0-9]+)} $line -> found_plain_oml_sample_interval]} {
                set plain_oml_sample_interval $found_plain_oml_sample_interval
            }
            if {[regexp {plain_oml_sampled_ratio=([0-9]+/[0-9]+)} $line -> found_plain_oml_sampled_ratio]} {
                set plain_oml_sampled_ratio $found_plain_oml_sampled_ratio
            }
            if {[regexp {plain_oml_first_sample_frame=([0-9]+)} $line -> found_plain_oml_first_sample_frame]} {
                set plain_oml_first_sample_frame $found_plain_oml_first_sample_frame
            }
            if {[regexp {plain_oml_last_sample_frame=([0-9]+)} $line -> found_plain_oml_last_sample_frame]} {
                set plain_oml_last_sample_frame $found_plain_oml_last_sample_frame
            }
            if {[regexp {plain_oml_get_sync_before_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_oml_get_sync_before_total _]} {
                set plain_oml_get_sync_before_total $found_plain_oml_get_sync_before_total
            }
            if {[regexp {plain_oml_get_sync_after_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_oml_get_sync_after_total _]} {
                set plain_oml_get_sync_after_total $found_plain_oml_get_sync_after_total
            }
            if {[regexp {plain_oml_before_first_sbc=(-?[0-9]+)} $line -> found_plain_oml_before_first_sbc]} {
                set plain_oml_before_first_sbc $found_plain_oml_before_first_sbc
            }
            if {[regexp {plain_oml_before_last_sbc=(-?[0-9]+)} $line -> found_plain_oml_before_last_sbc]} {
                set plain_oml_before_last_sbc $found_plain_oml_before_last_sbc
            }
            if {[regexp {plain_oml_after_first_sbc=(-?[0-9]+)} $line -> found_plain_oml_after_first_sbc]} {
                set plain_oml_after_first_sbc $found_plain_oml_after_first_sbc
            }
            if {[regexp {plain_oml_after_last_sbc=(-?[0-9]+)} $line -> found_plain_oml_after_last_sbc]} {
                set plain_oml_after_last_sbc $found_plain_oml_after_last_sbc
            }
            if {[regexp {plain_oml_post_swap_sbc_delta_total=(-?[0-9]+)} $line -> found_plain_oml_post_swap_sbc_delta_total]} {
                set plain_oml_post_swap_sbc_delta_total $found_plain_oml_post_swap_sbc_delta_total
            }
            if {[regexp {plain_oml_post_swap_sbc_delta_max=(-?[0-9]+)} $line -> found_plain_oml_post_swap_sbc_delta_max]} {
                set plain_oml_post_swap_sbc_delta_max $found_plain_oml_post_swap_sbc_delta_max
            }
            if {[regexp {plain_oml_post_swap_msc_delta_total=(-?[0-9]+)} $line -> found_plain_oml_post_swap_msc_delta_total]} {
                set plain_oml_post_swap_msc_delta_total $found_plain_oml_post_swap_msc_delta_total
            }
            if {[regexp {plain_oml_post_swap_msc_delta_max=(-?[0-9]+)} $line -> found_plain_oml_post_swap_msc_delta_max]} {
                set plain_oml_post_swap_msc_delta_max $found_plain_oml_post_swap_msc_delta_max
            }
            if {[regexp {plain_oml_after_sbc_delta_total=(-?[0-9]+)} $line -> found_plain_oml_after_sbc_delta_total]} {
                set plain_oml_after_sbc_delta_total $found_plain_oml_after_sbc_delta_total
            }
            if {[regexp {plain_oml_after_sbc_delta_max=(-?[0-9]+)} $line -> found_plain_oml_after_sbc_delta_max]} {
                set plain_oml_after_sbc_delta_max $found_plain_oml_after_sbc_delta_max
            }
            if {[regexp {plain_oml_after_msc_delta_total=(-?[0-9]+)} $line -> found_plain_oml_after_msc_delta_total]} {
                set plain_oml_after_msc_delta_total $found_plain_oml_after_msc_delta_total
            }
            if {[regexp {plain_oml_after_msc_delta_max=(-?[0-9]+)} $line -> found_plain_oml_after_msc_delta_max]} {
                set plain_oml_after_msc_delta_max $found_plain_oml_after_msc_delta_max
            }
            if {[regexp {plain_post_swap_xsync_total_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_post_swap_xsync_total _]} {
                set plain_post_swap_xsync_total $found_plain_post_swap_xsync_total
            }
            if {[regexp {plain_post_swap_xsync_max_ms=([0-9]+(\.[0-9]+)?)} $line -> found_plain_post_swap_xsync_max _]} {
                set plain_post_swap_xsync_max $found_plain_post_swap_xsync_max
            }
        }
        if {!$saw_fps_result &&
            [regexp {host-x11-egl-smoke: phase=glx_fps_timing status=PASS result_status=PASS[^\r\n]*frames=([1-9][0-9]*)} $line -> found_frames]} {
            set saw_fps_result 1
            set fps_status "PASS"
            set fps_frames $found_frames
            foreach {match key value} [regexp -all -inline {([^ =\r\n]+)=([^ \r\n]+)} $line] {
                switch -- $key {
                    variant { set result_variant $value }
                    oml_available { set oml_available $value }
                    oml_queue_depth { set queue_depth $value }
                    oml_sbc_issued { set sbc_issued $value }
                    oml_sbc_completed { set sbc_completed $value }
                    oml_max_pending_sbc { set max_pending $value }
                    oml_last_sbc { set oml_last_sbc $value }
                    oml_gl_flush_total_ms { set gl_flush_total $value }
                    oml_swap_msc_issue_total_ms { set swap_msc_issue_total $value }
                    oml_get_sync_before_total_ms { set get_sync_before_total $value }
                    oml_get_sync_after_total_ms { set get_sync_after_total $value }
                    oml_issue_state_sample_interval { set issue_state_sample_interval $value }
                    oml_issue_state_sampled_ratio { set issue_state_sampled_ratio $value }
                    oml_issue_state_first_sample_frame { set issue_state_first_sample_frame $value }
                    oml_issue_state_last_sample_frame { set issue_state_last_sample_frame $value }
                    oml_issue_state_first_sample_sbc { set issue_state_first_sample_sbc $value }
                    oml_issue_state_last_sample_sbc { set issue_state_last_sample_sbc $value }
                    oml_issue_state_samples { set issue_state_samples $value }
                    oml_post_issue_sbc_completed_count { set post_issue_sbc_completed_count $value }
                    oml_post_issue_sbc_lag_max { set post_issue_sbc_lag_max $value }
                    oml_post_issue_msc_delta_total { set post_issue_msc_delta_total $value }
                    oml_post_issue_msc_delta_max { set post_issue_msc_delta_max $value }
                    swap_only_skipped_draw_frames { set swap_only_skipped_draw_frames $value }
                    swap_interval_requested { set swap_interval_requested $value }
                    swap_interval_set_api { set swap_interval_set_api $value }
                    swap_interval_set_status { set swap_interval_set_status $value }
                    swap_interval_before { set swap_interval_before $value }
                    swap_interval_after { set swap_interval_after $value }
                    plain_swap_issue_total_ms { set plain_swap_issue_total $value }
                    plain_swap_avg_ms { set plain_swap_avg $value }
                    plain_swap_max_ms { set plain_swap_max $value }
                    plain_oml_available { set plain_oml_available $value }
                    plain_oml_samples { set plain_oml_samples $value }
                    plain_oml_sample_interval { set plain_oml_sample_interval $value }
                    plain_oml_sampled_ratio { set plain_oml_sampled_ratio $value }
                    plain_oml_first_sample_frame { set plain_oml_first_sample_frame $value }
                    plain_oml_last_sample_frame { set plain_oml_last_sample_frame $value }
                    plain_oml_get_sync_before_total_ms { set plain_oml_get_sync_before_total $value }
                    plain_oml_get_sync_after_total_ms { set plain_oml_get_sync_after_total $value }
                    plain_oml_before_first_sbc { set plain_oml_before_first_sbc $value }
                    plain_oml_before_last_sbc { set plain_oml_before_last_sbc $value }
                    plain_oml_after_first_sbc { set plain_oml_after_first_sbc $value }
                    plain_oml_after_last_sbc { set plain_oml_after_last_sbc $value }
                    plain_oml_post_swap_sbc_delta_total { set plain_oml_post_swap_sbc_delta_total $value }
                    plain_oml_post_swap_sbc_delta_max { set plain_oml_post_swap_sbc_delta_max $value }
                    plain_oml_post_swap_msc_delta_total { set plain_oml_post_swap_msc_delta_total $value }
                    plain_oml_post_swap_msc_delta_max { set plain_oml_post_swap_msc_delta_max $value }
                    plain_oml_after_sbc_delta_total { set plain_oml_after_sbc_delta_total $value }
                    plain_oml_after_sbc_delta_max { set plain_oml_after_sbc_delta_max $value }
                    plain_oml_after_msc_delta_total { set plain_oml_after_msc_delta_total $value }
                    plain_oml_after_msc_delta_max { set plain_oml_after_msc_delta_max $value }
                    plain_post_swap_xsync_total_ms { set plain_post_swap_xsync_total $value }
                    plain_post_swap_xsync_max_ms { set plain_post_swap_xsync_max $value }
                }
            }
        }
        if {$failure_label eq ""} {
            set label [x11_glx_fps_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }

    if {$saw_fps_result && $fps_status eq "PASS"} {
        set saw_start 1
        set saw_connect 1
        set saw_egl_init 1
        set saw_glx_ext 1
        set saw_glx_version 1
        set saw_fbconfigs 1
        set saw_visual 1
        set saw_context 1
        set saw_current 1
        set saw_strings 1
        set saw_fps_begin 1
    }
}

proc x11_present_fps_scan_log {text start_var connect_var dri3_var present_var select_var fd_var fps_begin_var fps_result_var fps_status_var fps_frames_var fps_elapsed_var fps_value_var issued_var completed_var outstanding_var requested_variant_var requested_depth_var result_variant_var queue_depth_var max_outstanding_var failure_var} {
    upvar 1 $start_var saw_start
    upvar 1 $connect_var saw_connect
    upvar 1 $dri3_var saw_dri3
    upvar 1 $present_var saw_present
    upvar 1 $select_var saw_select
    upvar 1 $fd_var saw_fd
    upvar 1 $fps_begin_var saw_fps_begin
    upvar 1 $fps_result_var saw_fps_result
    upvar 1 $fps_status_var fps_status
    upvar 1 $fps_frames_var fps_frames
    upvar 1 $fps_elapsed_var fps_elapsed
    upvar 1 $fps_value_var fps_value
    upvar 1 $issued_var issued
    upvar 1 $completed_var completed
    upvar 1 $outstanding_var outstanding
    upvar 1 $requested_variant_var requested_variant
    upvar 1 $requested_depth_var requested_depth
    upvar 1 $result_variant_var result_variant
    upvar 1 $queue_depth_var queue_depth
    upvar 1 $max_outstanding_var max_outstanding
    upvar 1 $failure_var failure_label

    set in_present_fps 0
    set saw_dri3_ext 0
    set saw_dri3_version 0
    set saw_present_ext 0
    set saw_present_version 0
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-dri3-present-smoke: phase=start status=BEGIN mode=present-fps} $line]} {
            set in_present_fps 1
            set saw_start 1
        }
        if {!$in_present_fps} {
            if {[regexp {^probe_present_fps_variant=([^ \r\n]+)} $line -> found_variant]} {
                set requested_variant $found_variant
            }
            if {[regexp {^probe_present_fps_queue_depth=([0-9]+)} $line -> found_requested_depth]} {
                set requested_depth $found_requested_depth
            }
            if {$failure_label eq ""} {
                set label [x11_present_fps_failure_label_from_line $line]
                if {$label ne ""} {
                    set failure_label $label
                }
            }
            continue
        }
        if {[regexp {host-x11-dri3-present-smoke: connected root=} $line]} {
            set saw_connect 1
        }
        if {[regexp {host-x11-dri3-present-smoke: extension name=DRI3 present=1} $line]} {
            set saw_dri3_ext 1
        }
        if {[regexp {host-x11-dri3-present-smoke: dri3_version major=} $line]} {
            set saw_dri3_version 1
        }
        if {[regexp {host-x11-dri3-present-smoke: extension name=Present present=1} $line]} {
            set saw_present_ext 1
        }
        if {[regexp {host-x11-dri3-present-smoke: present_version major=} $line]} {
            set saw_present_version 1
        }
        if {[regexp {host-x11-dri3-present-smoke: present_select_input status=PASS} $line]} {
            set saw_select 1
        }
        if {[regexp {host-x11-dri3-present-smoke: dri3_open_fd status=PASS} $line]} {
            set saw_fd 1
        }
        if {[regexp {host-x11-dri3-present-smoke: phase=present_fps status=BEGIN} $line]} {
            set saw_fps_begin 1
        }
        if {[regexp {host-x11-dri3-present-smoke: phase=present_fps_result status=(PASS|FAIL)[^\r\n]*present_only=1[^\r\n]*gl_context=0[^\r\n]*gl_draw_total_ms=0[^\r\n]*gl_swap_total_ms=0[^\r\n]*frames=([0-9]+)[^\r\n]*elapsed_seconds=([0-9]+(\.[0-9]+)?)[^\r\n]*fps=([0-9]+(\.[0-9]+)?)[^\r\n]* issued=([0-9]+) completed=([0-9]+) outstanding=([0-9]+)( |$)} $line -> found_status found_frames found_elapsed _ found_fps _ found_issued found_completed found_outstanding _]} {
            set saw_fps_result 1
            set fps_status $found_status
            set fps_frames $found_frames
            set fps_elapsed $found_elapsed
            set fps_value $found_fps
            set issued $found_issued
            set completed $found_completed
            set outstanding $found_outstanding
            if {[regexp {variant=([^ \r\n]+)} $line -> found_variant]} {
                set result_variant $found_variant
            }
            if {[regexp {queue_depth=([0-9]+)} $line -> found_queue_depth]} {
                set queue_depth $found_queue_depth
            }
            if {[regexp {max_outstanding=([0-9]+)} $line -> found_max_outstanding]} {
                set max_outstanding $found_max_outstanding
            }
        }
        if {$failure_label eq ""} {
            set label [x11_present_fps_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
    set saw_dri3 [expr {$saw_dri3_ext && $saw_dri3_version}]
    set saw_present [expr {$saw_present_ext && $saw_present_version}]
}

proc x11_egl_glx_probe_prelaunch_marker {log_path} {
    global timeout x11_egl_artifact_prefix

    set marker "GLXPRE[pid]"
    set pass_line "host-x11-egl-smoke: phase=prelaunch_prompt_sync status=PASS mode=best-effort marker=$marker\n"

    set x11_egl_artifact_prefix $pass_line
    write_x11_egl_artifact_log ""

    set old_timeout $timeout
    send "\025"
    sleep 1
    send "\r"
    sleep 3
    optional_prompt
    set timeout $old_timeout
}

proc x11_egl_glx_probe_launch_diag {log_path reason interrupt initial_text} {
    global timeout x11_egl_artifact_prefix

    set diag "host-x11-egl-smoke: phase=launch_status_wait status=FAIL reason=$reason\n"
    append diag $initial_text
    if {$interrupt} {
        set old_timeout $timeout
        set timeout 10
        send "\003"
        sleep 1
        send "echo GLXDIAGREADY\r"
        expect {
            -re {(^|[\r\n])GLXDIAGREADY[\r\n]} {
                append diag $expect_out(buffer)
                foreach cmd [list "ls -l $log_path" "cat $log_path" "ps"] marker {GLXDIAGLS GLXDIAGCAT GLXDIAGPS} {
                    set marker_re [format {(^|[\r\n])%s[\r\n]} $marker]
                    send "$cmd; echo $marker\r"
                    expect {
                        -re $marker_re {
                            append diag $expect_out(buffer)
                        }
                        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                            append diag $expect_out(buffer)
                            break
                        }
                        timeout {
                            catch { append diag $expect_out(buffer) }
                            append diag "\nhost-x11-egl-smoke: phase=launch_status_wait_diag status=FAIL cmd={$cmd} reason=timeout\n"
                            break
                        }
                        eof {
                            catch { append diag $expect_out(buffer) }
                            append diag "\nhost-x11-egl-smoke: phase=launch_status_wait_diag status=FAIL cmd={$cmd} reason=eof\n"
                            break
                        }
                    }
                }
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                append diag $expect_out(buffer)
            }
            timeout {
                catch { append diag $expect_out(buffer) }
                append diag "\nhost-x11-egl-smoke: phase=launch_status_wait_diag status=FAIL reason=timeout\n"
            }
            eof {
                catch { append diag $expect_out(buffer) }
                append diag "\nhost-x11-egl-smoke: phase=launch_status_wait_diag status=FAIL reason=eof\n"
            }
        }
        set timeout $old_timeout
    }
    if {![regexp {\n$} $diag]} {
        append diag "\n"
    }
    append x11_egl_artifact_prefix $diag
    write_x11_egl_artifact_log ""
}

proc x11_egl_glx_probe_xopen_preflight {log_path {skip_diag 0}} {
    global timeout x11_egl_artifact_prefix

    set old_timeout $timeout
    set selected_display ""

    set log_redirect ">> $log_path"
    set preflight_steps [list \
        [list begin "printf '%s\\n' 'host-x11-egl-smoke: phase=x11_preflight status=BEGIN' $log_redirect"] \
        [list preflight_env "{ printf '%s\\n' 'host-x11-egl-smoke: diag preflight_env'; env | grep '^DISPLAY=' || printf '%s\\n' 'DISPLAY=(unset)'; env | grep '^XDG_RUNTIME_DIR=' || printf '%s\\n' 'XDG_RUNTIME_DIR=(unset)'; } $log_redirect"] \
        [list preflight_x11_unix "{ printf '%s\\n' 'host-x11-egl-smoke: diag preflight_x11_unix'; ls -ld /tmp/.X11-unix /tmp/.X11-unix/* || true; } $log_redirect"] \
        [list preflight_ps "{ printf '%s\\n' 'host-x11-egl-smoke: diag preflight_ps'; ps || true; } $log_redirect"] \
        [list preflight_kde_process_probe "{ printf '%s\\n' 'host-x11-egl-smoke: diag preflight_kde_process_probe'; /bin/kde-process-probe || true; } $log_redirect"] \
        [list pass "printf '%s\\n' 'host-x11-egl-smoke: phase=x11_preflight_diag status=PASS' $log_redirect"] \
    ]

    if {!$skip_diag} {
        foreach step_info $preflight_steps {
            set step [lindex $step_info 0]
            set cmd [lindex $step_info 1]
            set diag_marker "X11PREFLIGHTDIAG[pid]_$step"
            set marker_re [format {(^|[\r\n])%s:([0-9]+)[\r\n]} $diag_marker]

            set timeout 30
            send "$cmd; echo $diag_marker:\$?\r"
            expect {
                -re $marker_re {}
                -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                    set timeout $old_timeout
                    finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-crash"
                }
                timeout {
                    append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight status=FAIL reason=diag-timeout step=$step\n"
                    catch { append x11_egl_artifact_prefix $expect_out(buffer) }
                    write_x11_egl_artifact_log ""
                    set timeout $old_timeout
                    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-failed reason=diag-timeout step=$step"
                }
                eof {
                    set timeout $old_timeout
                    finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-eof"
                }
            }
        }
    } else {
        append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight status=BEGIN\n"
        append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight_diag status=SKIP reason=fps-candidate-only\n"
        write_x11_egl_artifact_log ""
    }

    foreach display {:0 :1} {
        set candidate_marker "X11PREFLIGHTCAND[pid][string map {: _} $display]"
        set marker_re [format {%s:([0-9]+)} $candidate_marker]
        set timeout 45
        append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight_candidate status=BEGIN display=$display\n"
        write_x11_egl_artifact_log ""
        send "DISPLAY=$display HOST_X11_EGL_SMOKE_MODE=x11-connect /bin/host-x11-egl-smoke --x11-connect-only; echo $candidate_marker:\$?\r"
        expect {
            -re $marker_re {
                set status [string trim $expect_out(1,string)]
                if {$status eq "0"} {
                    append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight_candidate status=PASS display=$display exit_status=$status\n"
                    append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight status=PASS selected_display=$display\n"
                    write_x11_egl_artifact_log ""
                    set selected_display $display
                    break
                } else {
                    append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight_candidate status=FAIL display=$display exit_status=$status\n"
                    write_x11_egl_artifact_log ""
                }
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                set timeout $old_timeout
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-crash display=$display"
            }
            timeout {
                append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight_candidate status=FAIL display=$display reason=timeout\n"
                write_x11_egl_artifact_log ""
                send "\003"
                sleep 1
                optional_prompt
            }
            eof {
                set timeout $old_timeout
                finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-eof display=$display"
            }
        }
    }

    set timeout $old_timeout
    if {$selected_display ne ""} {
        return $selected_display
    }

    set fail_marker "X11PREFLIGHTFAIL[pid]"
    set marker_re [format {%s:([0-9]+)} $fail_marker]
    set timeout 10
    append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight status=FAIL reason=no-display-candidate label=x11-egl-XOpenDisplay-preflight-failed displays=:0,:1\n"
    write_x11_egl_artifact_log ""
    send "echo $fail_marker:0\r"
    expect {
        -re $marker_re {}
        timeout {
            append x11_egl_artifact_prefix "host-x11-egl-smoke: phase=x11_preflight status=FAIL reason=final-log-timeout label=x11-egl-XOpenDisplay-preflight-failed\n"
            write_x11_egl_artifact_log ""
        }
        eof {
            set timeout $old_timeout
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-eof"
        }
    }
    set timeout $old_timeout
    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-XOpenDisplay-preflight-failed displays=:0,:1"
}

proc read_x11_egl_session_log {label} {
    global timeout guest_host_x11_egl_log guest_host_x11_present_trace_log
    global x11_egl_last_log_source x11_egl_last_log_bytes

    set artifact_text ""
    if {[read_x11_egl_host_artifact_log artifact_text]} {
        set present_trace_text ""
        set combined_text $artifact_text
        if {[read_x11_present_trace_host_artifact_log present_trace_text]} {
            append combined_text "\n" $present_trace_text
        }
        if {[x11_egl_session_log_complete $label $combined_text]} {
            set x11_egl_last_log_source "host-artifact"
            set x11_egl_last_log_bytes [string length $combined_text]
            return $combined_text
        }
    }

    sync_prompt 60
    set old_timeout $timeout
    set timeout 60
    set done_marker "__KDE_X11_EGL_SESSION_LOG_DONE__[pid]"
    set log_text ""
    send "cat $guest_host_x11_egl_log; cat $guest_host_x11_present_trace_log 2>/dev/null; echo $done_marker\r"
    while {1} {
        expect {
            -re [format {(^|[\r\n])%s[\r\n]} $done_marker] {
                append log_text $expect_out(buffer)
                set timeout $old_timeout
                optional_prompt
                set x11_egl_last_log_source "guest-cat"
                set x11_egl_last_log_bytes [string length $log_text]
                return $log_text
            }
            -re {host-x11-egl-smoke: [^\r\n]+} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: [^\r\n]+} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-present-trace: [^\r\n]+} {
                append log_text $expect_out(buffer)
            }
            -re {cat: [^\r\n]+} {
                append log_text $expect_out(buffer)
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                append log_text $expect_out(buffer)
                set timeout $old_timeout
                write_x11_egl_artifact_log $log_text
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-log-crash"
            }
            timeout {
                set timeout $old_timeout
                write_x11_egl_artifact_log $log_text
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-log-timeout"
            }
            eof {
                set timeout $old_timeout
                write_x11_egl_artifact_log $log_text
                finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-log-eof"
            }
        }
    }
}

proc run_kde_x11_glx_fps_session_probe {} {
    global x11_egl_available host_x11_egl_png qemu_append
    global guest_host_x11_egl_log x11_egl_last_log_source x11_egl_last_log_bytes

    if {!$x11_egl_available} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-glx-fps-missing"
    }

    set session_result [wait_for_x11_egl_session_probe_terminal]
    set session_status [lindex $session_result 0]
    set exit_status [lindex $session_result 1]
    set log_text [read_x11_egl_session_log "x11-glx-fps-session-probe"]
    write_x11_egl_artifact_log $log_text

