    set oml_failure_label [x11_glx_fps_oml_flush_swap_failure_label $variant $requested_depth $result_variant $oml_available $queue_depth $sbc_issued $sbc_completed $max_pending $gl_flush_total $swap_msc_issue_total]
    if {$oml_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $oml_failure_label $suffix"
    }
    set oml_failure_label [x11_glx_fps_oml_issue_state_failure_label $variant $requested_depth $requested_sample_interval $result_variant $oml_available $queue_depth $sbc_issued $sbc_completed $max_pending $oml_last_sbc $gl_flush_total $swap_msc_issue_total $get_sync_before_total $get_sync_after_total $issue_state_sample_interval $issue_state_sampled_ratio $issue_state_first_sample_frame $issue_state_last_sample_frame $issue_state_first_sample_sbc $issue_state_last_sample_sbc $issue_state_samples $post_issue_sbc_completed_count $post_issue_sbc_lag_max $post_issue_msc_delta_total $post_issue_msc_delta_max]
    if {$oml_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $oml_failure_label $suffix"
    }
}

proc run_kde_x11_present_fps_session_probe {} {
    global x11_dri3_available host_x11_dri3_png

    if {!$x11_dri3_available} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-missing"
    }

    set session_result [wait_for_x11_egl_session_probe_terminal]
    set session_status [lindex $session_result 0]
    set exit_status [lindex $session_result 1]
    set log_text [read_x11_egl_session_log "x11-present-fps-session-probe"]
    write_x11_egl_artifact_log $log_text

    set saw_start 0
    set saw_connect 0
    set saw_dri3 0
    set saw_present 0
    set saw_select 0
    set saw_fd 0
    set saw_fps_begin 0
    set saw_fps_result 0
    set fps_status ""
    set fps_frames ""
    set fps_elapsed ""
    set fps_value ""
    set issued ""
    set completed ""
    set outstanding ""
    set requested_variant ""
    set requested_depth ""
    set result_variant ""
    set queue_depth ""
    set max_outstanding ""
    set failure_label ""
    x11_present_fps_scan_log $log_text saw_start saw_connect saw_dri3 saw_present saw_select saw_fd saw_fps_begin saw_fps_result fps_status fps_frames fps_elapsed fps_value issued completed outstanding requested_variant requested_depth result_variant queue_depth max_outstanding failure_label
    set suffix [x11_present_fps_failure_suffix $saw_start $saw_connect $saw_dri3 $saw_present $saw_select $saw_fd $saw_fps_begin $saw_fps_result $fps_status $fps_frames $fps_elapsed $fps_value $issued $completed $outstanding $requested_variant $requested_depth $result_variant $queue_depth $max_outstanding $exit_status]
    host_screenshot "x11-dri3" $host_x11_dri3_png

    if {$failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $failure_label $suffix"
    }
    if {$session_status ne "PASS"} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-session-probe-$session_status exit_status=$exit_status $suffix"
    }
    if {$exit_status ne "0"} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-status-$exit_status $suffix"
    }
    if {!($saw_start && $saw_connect && $saw_dri3 && $saw_present && $saw_select && $saw_fd && $saw_fps_begin && $saw_fps_result)} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-incomplete $suffix"
    }
    if {$fps_status ne "PASS"} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-result-$fps_status $suffix"
    }
    if {$fps_frames eq "" || $completed eq "" || $fps_frames <= 0 || $completed <= 0} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-no-frames $suffix"
    }
    if {$outstanding eq "" || $outstanding != 0} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-present-fps-outstanding $suffix"
    }
    set queue_failure_label [x11_present_fps_queue_failure_label $requested_variant $requested_depth $result_variant $issued $completed $outstanding $queue_depth $max_outstanding]
    if {$queue_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $queue_failure_label $suffix"
    }
}

proc run_kde_x11_egl_glx_probe_only {} {
    global timeout host_x11_egl_png guest_host_x11_egl_log

    set old_timeout $timeout
    set log_path $guest_host_x11_egl_log
    set exit_status ""
    set preflight_display ""

    x11_egl_glx_probe_prelaunch_marker $log_path
    set timeout 120

    send "rm -f $log_path\r"
    sleep 2
    optional_prompt

    set preflight_display [x11_egl_glx_probe_xopen_preflight $log_path]

    send "DISPLAY=$preflight_display HOST_X11_EGL_SMOKE_MODE=glx-probe /bin/host-x11-egl-smoke --glx-probe-only; echo GLX:\$?\r"
    expect {
        -re {GLX:([0-9]+)} {
            set exit_status [string trim $expect_out(1,string)]
        }
        -re {exec .*failed|not found|cannot execute} {
            x11_egl_glx_probe_launch_diag $log_path "exec_failed" 0 $expect_out(buffer)
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-launch"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            x11_egl_glx_probe_launch_diag $log_path "crash" 0 $expect_out(buffer)
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-crash"
        }
        timeout {
            set launch_buffer ""
            catch { set launch_buffer $expect_out(buffer) }
            x11_egl_glx_probe_launch_diag $log_path "timeout" 1 $launch_buffer
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-timeout"
        }
        eof {
            set launch_buffer ""
            catch { set launch_buffer $expect_out(buffer) }
            x11_egl_glx_probe_launch_diag $log_path "eof" 0 $launch_buffer
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-eof"
        }
    }
    optional_prompt

    send "cat $log_path; echo __KDE_X11_EGL_GLX_PROBE_LOG_DONE__\r"
    set saw_done 0
    set log_text ""
    while {!$saw_done} {
        expect {
            -re {(^|[\r\n])__KDE_X11_EGL_GLX_PROBE_LOG_DONE__[\r\n]} {
                append log_text $expect_out(buffer)
                set saw_done 1
            }
            -re {host-x11-egl-smoke: [^\r\n]+} {
                append log_text $expect_out(buffer)
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                append log_text $expect_out(buffer)
                write_x11_egl_artifact_log $log_text
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-log-crash"
            }
            timeout {
                write_x11_egl_artifact_log $log_text
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-log-timeout"
            }
            eof {
                write_x11_egl_artifact_log $log_text
                finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-log-eof"
            }
        }
    }
    write_x11_egl_artifact_log $log_text

    set saw_start 0
    set saw_connect 0
    set saw_egl_init 0
    set saw_glx_ext 0
    set saw_glx_version 0
    set saw_fbconfigs 0
    set saw_visual 0
    set saw_context 0
    set saw_current 0
    set saw_strings 0
    set saw_draw 0
    set saw_result 0
    set failure_label ""
    x11_egl_scan_glx_probe_log $log_text saw_start saw_connect saw_egl_init saw_glx_ext saw_glx_version saw_fbconfigs saw_visual saw_context saw_current saw_strings saw_draw saw_result failure_label
    set suffix [x11_egl_glx_probe_failure_suffix $saw_start $saw_connect $saw_egl_init $saw_glx_ext $saw_glx_version $saw_fbconfigs $saw_visual $saw_context $saw_current $saw_strings $saw_draw $saw_result $exit_status]
    set timeout $old_timeout
    optional_prompt
    host_screenshot "x11-egl" $host_x11_egl_png
    if {$failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $failure_label $suffix"
    }
    if {$exit_status ne "0"} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-status-$exit_status $suffix"
    }
    if {!($saw_start && $saw_connect && $saw_egl_init && $saw_glx_ext && $saw_glx_version && $saw_fbconfigs && $saw_visual && $saw_context && $saw_current && $saw_strings && $saw_draw && $saw_result)} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-glx-probe-incomplete $suffix"
    }
}

proc run_kde_x11_egl_probe {} {
    global timeout x11_egl_available host_x11_egl_png guest_host_x11_egl_log

    set reducer [expr {[kde_smoke_reducer] eq "x11-egl"}]
    if {[info exists ::env(KDE_SMOKE_X11_EGL)] && $::env(KDE_SMOKE_X11_EGL) eq "0"} {
        if {$reducer} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-disabled"
        }
        return
    }
    if {!$x11_egl_available} {
        if {$reducer} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-missing"
        }
        note_visual_warning "x11-egl-smoke-missing"
        return
    }
    if {$reducer} {
        run_kde_x11_egl_glx_probe_only
        return
    }

    set old_timeout $timeout
    sync_prompt
    set timeout 90
    set log_path $guest_host_x11_egl_log

    send "rm -f $log_path; /bin/host-x11-egl-smoke & echo KDE_X11_EGL_LAUNCHED\r"
    expect {
        -re {KDE_X11_EGL_LAUNCHED} {}
        -re {exec .*failed|not found|cannot execute} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-launch"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-launch-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-launch-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-launch-eof" }
    }
    optional_prompt
    sleep 6

    send "cat $log_path; echo __KDE_X11_EGL_LOG_DONE__\r"
    set saw_start 0
    set saw_connect 0
    set saw_gl 0
    set saw_frame 0
    set saw_done 0
    set failure_label ""
    set log_text ""
    while {!$saw_done} {
        expect {
            -re {host-x11-egl-smoke: start} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-egl-smoke: connected display=} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-egl-smoke: (egl|glx) ready } {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-egl-smoke: frame=[0-9]+ mode=launch} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-egl-smoke: [^\r\n]*(failed|missing|status=FAIL)} {
                append log_text $expect_out(buffer)
            }
            -re {(^|[\r\n])__KDE_X11_EGL_LOG_DONE__[\r\n]} {
                append log_text $expect_out(buffer)
                set saw_done 1
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-log-crash"
            }
            timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-log-timeout" }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-log-eof" }
        }
    }
    write_x11_egl_artifact_log $log_text
    x11_egl_scan_launch_log $log_text saw_start saw_connect saw_gl saw_frame failure_label
    if {$failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $failure_label [x11_egl_failure_suffix $saw_start $saw_connect $saw_gl $saw_frame]"
    }
    if {!($saw_start && $saw_connect && $saw_gl && $saw_frame)} {
        optional_prompt
        set timeout 10
        send "ls -l $log_path /bin/host-x11-egl-smoke /opt/host-gui/host-x11-egl-smoke/bin/host-x11-egl-smoke /opt/host-gui/host-x11-egl-smoke/lib/ld-linux-x86-64.so.2; ps; echo KDE_X11_EGL_DIAG_DONE\r"
        expect {
            -re {KDE_X11_EGL_DIAG_DONE} {}
            timeout {}
            eof {}
        }
        set timeout $old_timeout
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-incomplete [x11_egl_failure_suffix $saw_start $saw_connect $saw_gl $saw_frame]"
    }
    optional_prompt
    host_screenshot "x11-egl" $host_x11_egl_png

    send "/bin/mouseinject 32768 32768 0; /bin/mouseinject 32768 32768 1; /bin/mouseinject 32768 32768 0; /bin/keyinject text xv6; /bin/keyinject key esc; echo KDE_X11_EGL_INPUT_DONE\r"
    expect {
        -re {KDE_X11_EGL_INPUT_DONE} {}
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-input-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-input-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-input-eof" }
    }
    optional_prompt
    sleep 3

    send "cat $log_path; echo __KDE_X11_EGL_EXIT_LOG_DONE__\r"
    set saw_input 0
    set saw_exit 0
    set saw_exit_done 0
    set exit_failure_label ""
    set exit_log_text ""
    while {!$saw_exit_done} {
        expect {
            -re {host-x11-egl-smoke: input_ready} {
                append exit_log_text $expect_out(buffer)
            }
            -re {host-x11-egl-smoke: exited} {
                append exit_log_text $expect_out(buffer)
            }
            -re {host-x11-egl-smoke: [^\r\n]*(failed|missing|status=FAIL)} {
                append exit_log_text $expect_out(buffer)
            }
            -re {(^|[\r\n])__KDE_X11_EGL_EXIT_LOG_DONE__[\r\n]} {
                append exit_log_text $expect_out(buffer)
                set saw_exit_done 1
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-exit-crash"
            }
            timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-exit-log-timeout" }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-exit-log-eof" }
        }
    }
    write_x11_egl_artifact_log $exit_log_text
    x11_egl_scan_exit_log $exit_log_text saw_input saw_exit exit_failure_label
    if {$exit_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-exit-$exit_failure_label"
    }
    set timeout $old_timeout
    optional_prompt
    if {!($saw_input && $saw_exit)} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-no-input-exit input=$saw_input exit=$saw_exit"
    }
}

proc x11_dri3_failure_label_from_line {line} {
    set line [string trim $line]
    if {[regexp {host-x11-dri3-present-smoke: ([A-Za-z0-9_]+)[^\r\n]*status=FAIL} $line -> phase]} {
        return "x11-dri3-${phase}-status-FAIL"
    }
    if {[regexp {host-x11-dri3-present-smoke: (connect|atom setup|event) (failed|eof)} $line -> phase reason]} {
        regsub -all { } $phase {_} phase
        return "x11-dri3-${phase}-${reason}"
    }
    if {[regexp {No such file|cannot execute|not found} $line]} {
        return "x11-dri3-exec-missing"
    }
    return ""
}

proc x11_dri3_scan_launch_log {text start_var connect_var dri3_var present_var map_var configure_var fd_var launch_present_var complete_var failure_var} {
    upvar 1 $start_var saw_start
    upvar 1 $connect_var saw_connect
    upvar 1 $dri3_var saw_dri3
    upvar 1 $present_var saw_present
    upvar 1 $map_var saw_map
    upvar 1 $configure_var saw_configure
    upvar 1 $fd_var saw_fd
    upvar 1 $launch_present_var saw_launch_present
    upvar 1 $complete_var saw_complete
    upvar 1 $failure_var failure_label

    set saw_dri3_ext 0
    set saw_dri3_version 0
    set saw_present_ext 0
    set saw_present_version 0
    set saw_present_select 0
    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-dri3-present-smoke: start} $line]} {
            set saw_start 1
        }
        if {[regexp {host-x11-dri3-present-smoke: connected root=} $line]} {
            set saw_connect 1
        }
        if {[regexp {host-x11-dri3-present-smoke: extension name=DRI3 present=1} $line]} {
            set saw_dri3_ext 1
        }
        if {[regexp {host-x11-dri3-present-smoke: dri3_version major=} $line]} {
            set saw_dri3_version 1
        }
        if {[regexp {host-x11-dri3-present-smoke: extension name=Present present=1} $line]} {
            set saw_present_ext 1
        }
        if {[regexp {host-x11-dri3-present-smoke: present_version major=} $line]} {
            set saw_present_version 1
        }
        if {[regexp {host-x11-dri3-present-smoke: present_select_input status=PASS} $line]} {
            set saw_present_select 1
        }
        if {[regexp {host-x11-dri3-present-smoke: map_notify} $line]} {
            set saw_map 1
        }
        if {[regexp {host-x11-dri3-present-smoke: configure_notify} $line]} {
            set saw_configure 1
        }
        if {[regexp {host-x11-dri3-present-smoke: dri3_open_fd status=PASS} $line]} {
            set saw_fd 1
        }
        if {[regexp {host-x11-dri3-present-smoke: present_pixmap mode=launch serial=} $line]} {
            set saw_launch_present 1
        }
        if {$saw_launch_present && [regexp {host-x11-dri3-present-smoke: present_complete serial=} $line]} {
            set saw_complete 1
        }
        if {$failure_label eq ""} {
            set label [x11_dri3_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
    set saw_dri3 [expr {$saw_dri3_ext && $saw_dri3_version}]
    set saw_present [expr {$saw_present_ext && $saw_present_version && $saw_present_select}]
}

proc x11_dri3_scan_input_log {text input_var present_var complete_var failure_var} {
    upvar 1 $input_var saw_input
    upvar 1 $present_var saw_input_present
    upvar 1 $complete_var saw_input_complete
    upvar 1 $failure_var failure_label

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-dri3-present-smoke: input_ready} $line]} {
            set saw_input 1
        }
        if {[regexp {host-x11-dri3-present-smoke: present_pixmap mode=input serial=} $line]} {
            set saw_input_present 1
        }
        if {$saw_input_present && [regexp {host-x11-dri3-present-smoke: present_complete serial=} $line]} {
            set saw_input_complete 1
        }
        if {$failure_label eq ""} {
            set label [x11_dri3_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
}

proc x11_dri3_scan_exit_log {text sent_var received_var exit_var failure_var} {
    upvar 1 $sent_var saw_sent
    upvar 1 $received_var saw_received
    upvar 1 $exit_var saw_exit
    upvar 1 $failure_var failure_label

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-dri3-present-smoke: wm_delete_sent} $line]} {
            set saw_sent 1
        }
        if {[regexp {host-x11-dri3-present-smoke: wm_delete_received} $line]} {
            set saw_received 1
        }
        if {[regexp {host-x11-dri3-present-smoke: exited} $line]} {
            set saw_exit 1
        }
        if {$failure_label eq ""} {
            set label [x11_dri3_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
}

proc x11_dri3_launch_suffix {saw_start saw_connect saw_dri3 saw_present saw_map saw_configure saw_fd saw_launch_present saw_complete} {
    return "start=$saw_start connect=$saw_connect dri3=$saw_dri3 present=$saw_present map=$saw_map configure=$saw_configure fd=$saw_fd launch_present=$saw_launch_present complete=$saw_complete"
}

proc run_kde_x11_dri3_probe {} {
    global timeout x11_dri3_available host_x11_dri3_png

    if {!$x11_dri3_available} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-missing"
    }

    set old_timeout $timeout
    sync_prompt
    set timeout 90
    set log_path "/tmp/host-gui-host-x11-dri3-present-smoke.log"

    send "rm -f $log_path; /bin/host-x11-dri3-present-smoke & echo KDE_X11_DRI3_LAUNCHED\r"
    expect {
        -re {KDE_X11_DRI3_LAUNCHED} {}
        -re {exec .*failed|not found|cannot execute} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-launch"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-launch-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-launch-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-launch-eof" }
    }
    optional_prompt
    sleep 8

    send "cat $log_path; echo __KDE_X11_DRI3_LOG_DONE__\r"
    set saw_start 0
    set saw_connect 0
    set saw_dri3 0
    set saw_present 0
    set saw_map 0
    set saw_configure 0
    set saw_fd 0
    set saw_launch_present 0
    set saw_complete 0
    set saw_done 0
    set failure_label ""
    set log_text ""
    while {!$saw_done} {
        expect {
            -re {host-x11-dri3-present-smoke: start} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: connected root=} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: extension name=(DRI3|Present) present=} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: (dri3_version|present_version) major=} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: (present_select_input|dri3_open_fd) status=PASS} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: (map_notify|configure_notify)} {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: present_(pixmap|complete) } {
                append log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: [^\r\n]*(failed|status=FAIL|event eof)} {
                append log_text $expect_out(buffer)
            }
            -re {(^|[\r\n])__KDE_X11_DRI3_LOG_DONE__[\r\n]} {
                append log_text $expect_out(buffer)
                set saw_done 1
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-log-crash"
            }
            timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-log-timeout" }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-log-eof" }
        }
    }
    x11_dri3_scan_launch_log $log_text saw_start saw_connect saw_dri3 saw_present saw_map saw_configure saw_fd saw_launch_present saw_complete failure_label
    if {$failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $failure_label [x11_dri3_launch_suffix $saw_start $saw_connect $saw_dri3 $saw_present $saw_map $saw_configure $saw_fd $saw_launch_present $saw_complete]"
    }
    if {!($saw_start && $saw_connect && $saw_dri3 && $saw_present && $saw_map && $saw_configure && $saw_fd && $saw_launch_present && $saw_complete)} {
        set timeout $old_timeout
        optional_prompt
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-incomplete [x11_dri3_launch_suffix $saw_start $saw_connect $saw_dri3 $saw_present $saw_map $saw_configure $saw_fd $saw_launch_present $saw_complete]"
    }
    optional_prompt
    host_screenshot "x11-dri3" $host_x11_dri3_png

    send "/bin/mouseinject 32768 32768 0; /bin/mouseinject 32768 32768 1; /bin/mouseinject 32768 32768 0; /bin/keyinject text xv6; echo KDE_X11_DRI3_INPUT_DONE\r"
    expect {
        -re {KDE_X11_DRI3_INPUT_DONE} {}
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-eof" }
    }
    optional_prompt
    sleep 3

    send "cat $log_path; echo __KDE_X11_DRI3_INPUT_LOG_DONE__\r"
    set saw_input 0
    set saw_input_present 0
    set saw_input_complete 0
    set saw_input_done 0
    set input_failure_label ""
    set input_log_text ""
    while {!$saw_input_done} {
        expect {
            -re {host-x11-dri3-present-smoke: input_ready} {
                append input_log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: present_(pixmap|complete) } {
                append input_log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: [^\r\n]*(failed|status=FAIL|event eof)} {
                append input_log_text $expect_out(buffer)
            }
            -re {(^|[\r\n])__KDE_X11_DRI3_INPUT_LOG_DONE__[\r\n]} {
                append input_log_text $expect_out(buffer)
                set saw_input_done 1
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-log-crash"
            }
            timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-log-timeout" }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-log-eof" }
        }
    }
    x11_dri3_scan_input_log $input_log_text saw_input saw_input_present saw_input_complete input_failure_label
    if {$input_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-input-$input_failure_label"
    }
    if {!($saw_input && $saw_input_present && $saw_input_complete)} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-no-input input=$saw_input present=$saw_input_present complete=$saw_input_complete"
    }

    send "/bin/keyinject key esc; echo KDE_X11_DRI3_ESC_DONE\r"
    expect {
        -re {KDE_X11_DRI3_ESC_DONE} {}
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-esc-crash"
        }
        timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-esc-timeout" }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-esc-eof" }
    }
    optional_prompt
    sleep 3

    send "cat $log_path; echo __KDE_X11_DRI3_EXIT_LOG_DONE__\r"
    set saw_sent 0
    set saw_received 0
    set saw_exit 0
    set saw_exit_done 0
    set exit_failure_label ""
    set exit_log_text ""
    while {!$saw_exit_done} {
        expect {
            -re {host-x11-dri3-present-smoke: wm_delete_sent} {
                append exit_log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: wm_delete_received} {
                append exit_log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: exited} {
                append exit_log_text $expect_out(buffer)
            }
            -re {host-x11-dri3-present-smoke: [^\r\n]*(failed|status=FAIL|event eof)} {
                append exit_log_text $expect_out(buffer)
            }
            -re {(^|[\r\n])__KDE_X11_DRI3_EXIT_LOG_DONE__[\r\n]} {
                append exit_log_text $expect_out(buffer)
                set saw_exit_done 1
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-exit-crash"
            }
            timeout { finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-exit-log-timeout" }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-exit-log-eof" }
        }
    }
    x11_dri3_scan_exit_log $exit_log_text saw_sent saw_received saw_exit exit_failure_label
    if {$exit_failure_label ne ""} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-exit-$exit_failure_label"
    }
    set timeout $old_timeout
    optional_prompt
    if {!($saw_sent && $saw_received && $saw_exit)} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-dri3-no-exit sent=$saw_sent received=$saw_received exit=$saw_exit"
    }
}

proc run_probe_suite {} {
    run_guest_check "/bin/kde-libinput-probe" "kde-libinput-probe" 20
    run_guest_check "/bin/kde-dlopen-probe" "kde-dlopen-probe" 30
    run_kwin_loader_ifunc_check
    run_qtqml_ifunc_startup_check
    run_guest_check "/bin/kde-unix-socket-probe" "kde-unix-socket-probe" 20
    run_guest_check "/bin/kde-drm-probe" "kde-drm-probe" 30
    run_guest_check "/bin/kde-proc-mountinfo-probe" "kde-proc-mountinfo-probe" 30
    run_guest_check "/bin/kde-config-atomic-probe" "kde-config-atomic-probe" 30
    run_guest_check "/bin/kde-pulse-cookie-probe" "kde-pulse-cookie-probe" 30
    run_guest_check "/bin/kde-proc-comm-probe" "kde-proc-comm-probe" 20
    run_guest_check "/bin/kde-pty-shell-probe" "kde-pty-shell-probe" 30
}

proc wait_for_pre_kwin_libinput_probe_only {} {
    global timeout

    set old_timeout $timeout
    set timeout 45
    expect {
        -re {kde-session: pre-kwin-libinput-probe-only status=PASS rc=0} {
            set timeout $old_timeout
            finish 0 "KDE-PLASMA-DESKTOP-SMOKE-DONE reducer=pre-kwin-libinput"
        }
        -re {kde-session: pre-kwin-libinput-probe-only status=FAIL rc=([0-9]+)} {
            set rc [string trim $expect_out(1,string)]
            set timeout $old_timeout
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL pre-kwin-libinput rc=$rc"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            set timeout $old_timeout
            finish_after_crash 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL pre-kwin-libinput-crash"
        }
        timeout {
            set timeout $old_timeout
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL pre-kwin-libinput-timeout"
        }
        eof {
            set timeout $old_timeout
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL pre-kwin-libinput-eof"
        }
    }
    set timeout $old_timeout
}

proc run_late_kde_guardrails {} {
    run_wayland_seat_probe
    run_guest_check "/bin/kde-trash-stat-probe" "kde-trash-stat-probe" 20
    run_guest_check "/bin/kde-kwriteconfig-probe" "kde-kwriteconfig-probe" 60
    run_kwin_screenshot_probe
}

proc role_probe_once {required_label require_plasma require_xwayland} {
    global timeout role_probe_log
    set old_timeout $timeout
    sync_prompt
    set timeout 8
    set args ""
    if {$require_xwayland} {
        append args " --require-xwayland"
    }
    if {!$require_plasma} {
        send "KDE_PROCESS_PROBE_TRACE=1 /bin/kde-process-probe$args\r"
        expect {
            -re {kde_process_probe[^\r\n]*kwin=([0-9]+)[^\r\n]*plasmashell=([0-9]+)[^\r\n]*xwayland=([0-9]+)[^\r\n]*} {
                set kwin $expect_out(1,string)
                set xwayland $expect_out(3,string)
                set timeout $old_timeout
                optional_prompt
                if {$kwin == "0"} {
                    return 0
                }
                if {$require_xwayland && $xwayland == "0"} {
                    return 0
                }
                return 1
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|pid [0-9]+ [^:\r\n]+: exception [0-9]+} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL crash"
            }
            timeout {
                set timeout $old_timeout
                return 0
            }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL role-probe-eof" }
        }
        set timeout $old_timeout
        optional_prompt
        return 0
    }
    send "KDE_PROCESS_PROBE_TRACE=1 /bin/kde-process-probe$args\r"
    expect {
        -re {(kde_process_probe[^\r\n]*kwin=([0-9]+)[^\r\n]*plasmashell=([0-9]+)[^\r\n]*xwayland=([0-9]+)[^\r\n]*status=(PASS|FAIL)[^\r\n]*)} {
            set line $expect_out(1,string)
            append_host_log_line $role_probe_log $line
            set kwin $expect_out(2,string)
            set plasma $expect_out(3,string)
            set xwayland $expect_out(4,string)
            set status $expect_out(5,string)
            set timeout $old_timeout
            optional_prompt
            return [expr {$status eq "PASS" && $kwin != "0" && $plasma != "0" &&
                          (!$require_xwayland || $xwayland != "0")}]
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL crash"
        }
        timeout {
            set timeout $old_timeout
            if {$require_plasma} {
                return 0
            }
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL role-probe-eof" }
    }
    set timeout $old_timeout
    optional_prompt
    return 0
}

proc wait_for_roles {required_label require_plasma require_xwayland attempts delay_seconds} {
    for {set i 0} {$i < $attempts} {incr i} {
        if {[role_probe_once $required_label $require_plasma $require_xwayland]} {
            return
        }
        sleep $delay_seconds
    }
    finish 7 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $required_label"
}

proc capture_fb {guest_path label} {
    if {![fb_visual_enabled]} {
        return
    }
    set result [run_desktop_interaction_helper_command capture $label $guest_path 20000]
    set status_path [lindex $result 0]
    set log_path [lindex $result 1]
    set log_text [lindex $result 3]
    if {[regexp {fbstat: [^\r\n]+} $log_text]} {
        desktop_interaction_log_line "phase=capture action=$label status=FAIL reason=fbstat path=$guest_path status_path=$status_path log_path=$log_path"
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-fbstat"
    }
    if {![regexp "fb_ppm_current path=$guest_path " $log_text]} {
        desktop_interaction_log_line "phase=capture action=$label status=FAIL reason=missing-ppm-line path=$guest_path status_path=$status_path log_path=$log_path log=[evidence_quote $log_text]"
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-capture-missing"
    }
    desktop_interaction_log_line "phase=capture action=$label status=PASS path=$guest_path status_path=$status_path log_path=$log_path"
}

proc wait_for_nonblack_frame {label min_nonblack attempts delay_ms} {
    global timeout fb_sample_counter
    if {![fb_visual_enabled]} {
        return
    }

    for {set i 0} {$i < $attempts} {incr i} {
        set old_timeout $timeout
        set timeout 20
        incr fb_sample_counter
        set marker_prefix "KFS"
        set marker_suffix [format "%04d" $fb_sample_counter]
        set marker "${marker_prefix}${marker_suffix}"
        set sample_nonblack -1
        sync_prompt
        send "\025"
        send "m=$marker_prefix;m=\${m}$marker_suffix;fbstat sample-current 0 0 1280 800;echo \$m\r"
        expect {
            -re {fb_sample_current[^\r\n]* nonblack=([0-9]+)[^\r\n]*(\r|\n)} {
                set sample_nonblack $expect_out(1,string)
                exp_continue
            }
            -re $marker {
                set timeout $old_timeout
            }
            -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
                finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-sample-crash"
            }
            -re {fbstat: [^\r\n]+} {
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-sample-fbstat"
            }
            timeout {
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-sample-timeout"
            }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-sample-eof" }
        }
        set timeout $old_timeout
        optional_prompt
        if {$sample_nonblack >= $min_nonblack} {
            puts "KDE-PLASMA-DESKTOP-SMOKE-INFO $label-sample-visible attempt=$i nonblack=$sample_nonblack min=$min_nonblack"
            return
        }
        after $delay_ms
    }

    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-sample-black attempts=$attempts min=$min_nonblack"
}

proc desktop_interaction_log_line {line} {
    global desktop_interaction_log

    set fh [open $desktop_interaction_log a]
    puts $fh $line
    close $fh
}

proc desktop_interaction_guest_input_policy_fields {} {
    return "input_policy=guest-only pointer_injection=guest-mouseinject host_cursor_sync_enabled=0 host_cursor_sync=disabled qemu_monitor_input=0 monitor_path=disabled"
}

proc enforce_desktop_interaction_guest_input_policy {action} {
    global kde_interaction_input_source kde_interaction_host_cursor_sync
    global kde_interaction_monitor_path kde_interaction_cursor_owner

    set requested_input_source $kde_interaction_input_source
    set requested_host_cursor_sync $kde_interaction_host_cursor_sync
    set requested_monitor_path $kde_interaction_monitor_path

    set kde_interaction_input_source "guest"
    set kde_interaction_host_cursor_sync 0
    set kde_interaction_monitor_path "disabled"
    set kde_interaction_cursor_owner "guest-forced-normal-interaction"

    desktop_interaction_log_line "phase=input-policy action=$action status=PASS requested_input_source=$requested_input_source requested_host_cursor_sync=$requested_host_cursor_sync requested_monitor_path=$requested_monitor_path [desktop_interaction_guest_input_policy_fields]"
}

proc persist_interaction_helper_log {kind serial safe_label log_text} {
    global outdir

    if {$kind ne "direct-launch" && $kind ne "activation-pty" && $kind ne "fbstat" && $kind ne "hoverprobe"} {
        return ""
    }

    set host_path "$outdir/kde-interaction-${kind}-${serial}-${safe_label}.log"
    set fh [open $host_path w]
    puts -nonewline $fh $log_text
    close $fh
    return $host_path
}

proc persist_interaction_helper_status {kind serial safe_label status_text} {
    global outdir

    if {$kind ne "direct-launch" && $kind ne "activation-pty" && $kind ne "fbstat" && $kind ne "hoverprobe"} {
        return ""
    }

    set host_path "$outdir/kde-interaction-${kind}-${serial}-${safe_label}.status"
    set fh [open $host_path w]
    puts $fh $status_text
    close $fh
    return $host_path
}

proc interaction_artifact_label {label} {
    return [regsub -all {[^A-Za-z0-9_.-]} $label {_}]
}

proc wait_for_interaction_status {status_path fail_label timeout_ms {log_path ""}} {
    global timeout outdir

    set old_timeout $timeout
    set deadline [expr {[clock milliseconds] + $timeout_ms}]
    set last_status ""
    while {[clock milliseconds] < $deadline} {
        set status_text ""
        if {[read_guest_artifact_text $status_path status_text]} {
            set last_status [string trim $status_text]
            if {[regexp {status=DONE} $status_text]} {
                set timeout $old_timeout
                return $last_status
            }
        }

        drain_serial_available
        after 50
    }

    set timeout $old_timeout
    set timeout_log_path ""
    set timeout_log_quote ""
    if {$log_path ne ""} {
        set timeout_log_text ""
        if {[read_guest_artifact_text $log_path timeout_log_text]} {
            set timeout_log_path "$outdir/kde-interaction-${fail_label}.timeout.log"
            set fh [open $timeout_log_path w]
            puts -nonewline $fh $timeout_log_text
            close $fh
            set timeout_log_quote [evidence_quote $timeout_log_text]
        }
    }
    desktop_interaction_log_line "phase=artifact action=$fail_label status=timeout status_path=$status_path log_path=$log_path host_timeout_log=$timeout_log_path last_status=[evidence_quote $last_status] partial_log=$timeout_log_quote"
    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $fail_label-artifact-timeout"
}

proc run_desktop_interaction_helper_command {kind label helper_args timeout_ms} {
    global interaction_action_counter timeout guest_desktop_interaction_script

    incr interaction_action_counter
    set serial [format "%04d" $interaction_action_counter]
    set safe_label [interaction_artifact_label $label]
    set status_path "/kde-interaction-${kind}-${serial}-${safe_label}.status"
    set log_path "/kde-interaction-${kind}-${serial}-${safe_label}.log"
    set old_timeout $timeout

    sync_prompt
    set timeout 1
    set helper_start_ms [clock milliseconds]
    send "\025"
    send "/bin/bash $guest_desktop_interaction_script $kind $serial $safe_label $helper_args\r"
    set status_text [wait_for_interaction_status $status_path "${kind}_${safe_label}" $timeout_ms $log_path]
    set helper_elapsed_ms [expr {[clock milliseconds] - $helper_start_ms}]
    set timeout $old_timeout

    set log_text ""
    if {![read_guest_artifact_text $log_path log_text]} {
        set log_text ""
    }
    set host_log_path [persist_interaction_helper_log \
                           $kind $serial $safe_label $log_text]
    set host_status_path [persist_interaction_helper_status \
                              $kind $serial $safe_label $status_text]
    optional_prompt
    return [list $status_path $log_path $status_text $log_text \
                $helper_elapsed_ms $host_log_path $host_status_path]
}

proc env_int_range {name default min max} {
    if {[info exists ::env($name)] &&
        [string is integer -strict $::env($name)] &&
        $::env($name) >= $min && $::env($name) <= $max} {
        return $::env($name)
    }
    return $default
}

proc fb_sample_timing_fields {log_text} {
    set fields "sample_open_ms=-1 sample_info_ms=-1 sample_alloc_ms=-1 sample_readback_ms=-1 sample_stats_ms=-1 sample_total_ms=-1"
    if {[regexp {fb_sample_current_timing[^\r\n]*open_ms=([0-9]+)[^\r\n]*info_ms=([0-9]+)[^\r\n]*alloc_ms=([0-9]+)[^\r\n]*readback_ms=([0-9]+)[^\r\n]*stats_ms=([0-9]+)[^\r\n]*total_ms=([0-9]+)} $log_text -> open_ms info_ms alloc_ms readback_ms stats_ms total_ms]} {
        set fields "sample_open_ms=$open_ms sample_info_ms=$info_ms sample_alloc_ms=$alloc_ms sample_readback_ms=$readback_ms sample_stats_ms=$stats_ms sample_total_ms=$total_ms"
    }
    return $fields
}

proc prefix_key_value_fields {prefix fields} {
    set result {}
    foreach field $fields {
        if {[regexp {^([^=]+)=(.*)$} $field -> key value]} {
            lappend result "${prefix}${key}=$value"
        }
    }
    return [join $result " "]
}

proc sample_current_once {label} {
    global interaction_sample_counter runlog

    incr interaction_sample_counter
    set hash "missing"
    set nonblack -1
    set nonzero -1
    set center "missing"
    set sample_line "missing"
    set sample_timing_fields "sample_open_ms=-1 sample_info_ms=-1 sample_alloc_ms=-1 sample_readback_ms=-1 sample_stats_ms=-1 sample_total_ms=-1"

    if {![desktop_interaction_active_sample_enabled]} {
        drain_serial_available
        if {![file exists $runlog]} {
            return [list $hash $nonblack $center $sample_line $nonblack $sample_timing_fields]
        }

        foreach raw_line [split [read_text_file $runlog] "\n"] {
            set line [string trimright $raw_line "\r"]
            if {[regexp {FB: virgl resource-scanout sample .* sample_hash=(0x[0-9a-fA-F]+) sample_nonblack=([0-9]+) sample_center=(0x[0-9a-fA-F]+)} $line -> h nb c]} {
                set hash [string tolower $h]
                set nonblack $nb
                set nonzero $nb
                set center [string tolower $c]
                set sample_line [string map {"\t" " " "\r" "" "\n" " "} $line]
            }
        }

        return [list $hash $nonblack $center $sample_line $nonzero $sample_timing_fields]
    }

    set result [run_desktop_interaction_helper_command sample $label "" 30000]
    set log_text [lindex $result 3]
    set helper_elapsed_ms [lindex $result 4]
    set sample_timing_fields [fb_sample_timing_fields $log_text]
    if {[regexp {(fb_sample_current[^\r\n]* nonzero=([0-9]+) nonblack=([0-9]+)[^\r\n]*hash=(0x[0-9a-fA-F]+)[^\r\n]*center=(0x[0-9a-fA-F]+)[^\r\n]*)} $log_text -> line nz nb h c]} {
        set sample_line [string map {"\t" " " "\r" "" "\n" " "} $line]
        set nonzero $nz
        set nonblack $nb
        set hash [string tolower $h]
        set center [string tolower $c]
    } elseif {[regexp {fbstat: [^\r\n]+} $log_text]} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-sample-fbstat"
    }

    if {$nonzero < 0} {
        set nonzero $nonblack
    }
    if {$sample_line eq "missing"} {
        desktop_interaction_log_line "phase=sample action=$label status=missing helper_elapsed_ms=$helper_elapsed_ms $sample_timing_fields"
    } else {
        desktop_interaction_log_line "phase=sample action=$label status=PASS hash=$hash nonzero=$nonzero nonblack=$nonblack center=$center helper_elapsed_ms=$helper_elapsed_ms $sample_timing_fields"
    }

    return [list $hash $nonblack $center $sample_line $nonzero $sample_timing_fields $helper_elapsed_ms]
}

proc desktop_interaction_bounds_fields {} {
    global desktop_interaction_bounds_source
    global desktop_interaction_screen_w desktop_interaction_screen_h
    global desktop_interaction_work_x0 desktop_interaction_work_y0
    global desktop_interaction_work_x1 desktop_interaction_work_y1

    return "bounds_source=$desktop_interaction_bounds_source framebuffer=${desktop_interaction_screen_w}x${desktop_interaction_screen_h} workarea=${desktop_interaction_work_x0},${desktop_interaction_work_y0}-${desktop_interaction_work_x1},${desktop_interaction_work_y1}"
}

proc set_desktop_interaction_bounds {source screen_w screen_h} {
    global desktop_interaction_bounds_source
    global desktop_interaction_screen_w desktop_interaction_screen_h
    global desktop_interaction_work_x0 desktop_interaction_work_y0
    global desktop_interaction_work_x1 desktop_interaction_work_y1

    if {![string is integer -strict $screen_w] ||
        ![string is integer -strict $screen_h] ||
        $screen_w <= 0 || $screen_h <= 0} {
        return 0
    }

    set desktop_interaction_bounds_source $source
    set desktop_interaction_screen_w $screen_w
    set desktop_interaction_screen_h $screen_h
    set desktop_interaction_work_x0 0
    set desktop_interaction_work_y0 0
    set desktop_interaction_work_x1 [expr {$screen_w - 1}]
    set desktop_interaction_work_y1 [expr {$screen_h - 1}]
    desktop_interaction_log_line "phase=geometry action=pointer-bounds status=PASS [desktop_interaction_bounds_fields]"
    return 1
}

proc update_desktop_interaction_bounds_from_sample {source sample} {
    set sample_line [lindex $sample 3]

    if {[regexp {screen=([0-9]+)x([0-9]+)} $sample_line -> screen_w screen_h]} {
        return [set_desktop_interaction_bounds $source $screen_w $screen_h]
    }
    desktop_interaction_log_line "phase=geometry action=pointer-bounds status=SKIP reason=missing-screen source=$source sample=[evidence_quote $sample_line] [desktop_interaction_bounds_fields]"
    return 0
}

proc guest_pixel_to_abs16 {pixel max_pixel} {
    if {![string is integer -strict $pixel] ||
        ![string is integer -strict $max_pixel] ||
        $max_pixel <= 0} {
        return 0
    }
    if {$pixel < 0} {
        set pixel 0
    }
    if {$pixel > $max_pixel} {
        set pixel $max_pixel
    }
    return [expr {int((double($pixel) / double($max_pixel)) * 65535.0 + 0.5)}]
}

proc bound_guest_pointer_target {x y} {
    global desktop_interaction_screen_w desktop_interaction_screen_h
    global desktop_interaction_work_x0 desktop_interaction_work_y0
    global desktop_interaction_work_x1 desktop_interaction_work_y1

    set requested_x $x
    set requested_y $y
    set clamped_x [clamp_abs16_coord $x]
    set clamped_y [clamp_abs16_coord $y]
    set max_x [expr {$desktop_interaction_screen_w - 1}]
    set max_y [expr {$desktop_interaction_screen_h - 1}]
    set pixel_x [abs16_to_guest_pixel $clamped_x $max_x]
    set pixel_y [abs16_to_guest_pixel $clamped_y $max_y]

    if {$pixel_x < $desktop_interaction_work_x0} {
        set pixel_x $desktop_interaction_work_x0
    }
    if {$pixel_x > $desktop_interaction_work_x1} {
        set pixel_x $desktop_interaction_work_x1
    }
    if {$pixel_y < $desktop_interaction_work_y0} {
        set pixel_y $desktop_interaction_work_y0
    }
    if {$pixel_y > $desktop_interaction_work_y1} {
        set pixel_y $desktop_interaction_work_y1
    }

    set bounded_x [guest_pixel_to_abs16 $pixel_x $max_x]
    set bounded_y [guest_pixel_to_abs16 $pixel_y $max_y]
    set changed [expr {$requested_x ne $bounded_x || $requested_y ne $bounded_y}]
    return [list $requested_x $requested_y $bounded_x $bounded_y \
                $pixel_x $pixel_y $changed]
}

proc guest_pointer_target_fields {target {input_source guest}} {
    set requested_x [lindex $target 0]
    set requested_y [lindex $target 1]
    set bounded_x [lindex $target 2]
    set bounded_y [lindex $target 3]
    set pixel_x [lindex $target 4]
    set pixel_y [lindex $target 5]
    set changed [lindex $target 6]
    set coordinate_space "guest-mouseinject-absolute16"
    if {$input_source eq "qemu-monitor"} {
        set coordinate_space "qemu-monitor-absolute16-diagnostic"
    }

    return "input_source=$input_source requested_x=$requested_x requested_y=$requested_y bounded_x=$bounded_x bounded_y=$bounded_y bounded_guest_pixel_x=$pixel_x bounded_guest_pixel_y=$pixel_y coordinate_changed=$changed coordinate_space=$coordinate_space [desktop_interaction_bounds_fields]"
}

proc run_interaction_command {label command {allow_timeout 0}} {
    global timeout interaction_action_counter

    set old_timeout $timeout
    set timeout 20
    incr interaction_action_counter
    set marker_prefix "KIA"
    set marker_suffix [format "%04d" $interaction_action_counter]
    set marker "${marker_prefix}${marker_suffix}"
    sync_prompt
    set start_ms [clock milliseconds]
    send "\025"
    send "$command;m=$marker_prefix;m=\${m}$marker_suffix;echo \$m;echo \$m;echo \$m;echo \$m;echo \$m\r"
    expect {
        -re $marker {
            set timeout $old_timeout
        }
        -re {root:/#} {
            if {[expr {[clock milliseconds] - $start_ms}] >= 20} {
                set timeout $old_timeout
            } else {
                exp_continue -continue_timer
            }
        }
        -re {mouseinject: (open|write) [^\r\n]*failed} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-action-failed"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-action-crash"
        }
        timeout {
            set timeout $old_timeout
            if {$allow_timeout} {
                desktop_interaction_log_line "phase=action action=$label status=timeout-ignored marker=$marker"
            } else {
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-action-timeout"
            }
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-action-eof" }
    }
    set timeout $old_timeout
    optional_prompt
}

proc interaction_helper_cursor_target {helper_args} {
    set mode [lindex $helper_args 0]

    if {$mode eq "move" || $mode eq "click"} {
        set x [clamp_abs16_coord [lindex $helper_args 1]]
        set y [clamp_abs16_coord [lindex $helper_args 2]]
        if {[string is integer -strict $x] &&
            [string is integer -strict $y]} {
            return [list 1 $x $y]
        }
    }
    return [list 0 0 0]
}

proc run_desktop_interaction_action {label helper_args} {
    global kde_interaction_input_source
    global kde_interaction_diagnostic_input
    global kde_interaction_monitor_path
    global kde_interaction_normal_reducer
    global kde_interaction_host_cursor_sync

    set mode [lindex $helper_args 0]
    set target_fields ""
    if {$mode eq "move" || $mode eq "click"} {
        set target [bound_guest_pointer_target [lindex $helper_args 1] \
                                             [lindex $helper_args 2]]
        set helper_args [lreplace $helper_args 1 2 \
            [lindex $target 2] [lindex $target 3]]
        set target_fields [guest_pointer_target_fields $target guest]
    }

    set input_source $kde_interaction_input_source
    if {$input_source eq "qemu-monitor" && !$kde_interaction_diagnostic_input} {
        desktop_interaction_log_line "phase=action action=$label status=INFO reason=monitor-input-requires-diagnostic-env requested_input_source=$input_source effective_input_source=guest diagnostic_input=$kde_interaction_diagnostic_input [desktop_interaction_guest_input_policy_fields]"
        set kde_interaction_input_source "guest"
        set kde_interaction_host_cursor_sync 0
        set kde_interaction_monitor_path "disabled"
        set input_source "guest"
    }
    if {$kde_interaction_normal_reducer} {
        if {$input_source ne "guest" ||
            $kde_interaction_host_cursor_sync ||
            $kde_interaction_monitor_path ne "disabled"} {
            desktop_interaction_log_line "phase=action action=$label status=INFO reason=guest-input-forced-for-normal-interaction requested_input_source=$input_source requested_host_cursor_sync=$kde_interaction_host_cursor_sync requested_monitor_path=$kde_interaction_monitor_path diagnostic_input=$kde_interaction_diagnostic_input [desktop_interaction_guest_input_policy_fields]"
        }
        set kde_interaction_input_source "guest"
        set kde_interaction_host_cursor_sync 0
        set kde_interaction_monitor_path "disabled"
        set input_source "guest"
    }
    if {$mode eq "move" || $mode eq "click"} {
        set target_fields [guest_pointer_target_fields $target $input_source]
    } elseif {$mode eq "key"} {
        set target_fields "input_source=$input_source coordinate_space=guest-keyinject [desktop_interaction_bounds_fields]"
    }
    if {!$kde_interaction_normal_reducer &&
        $kde_interaction_diagnostic_input &&
        $input_source eq "qemu-monitor"} {
        set start_ms [clock milliseconds]
        set injection_count 0
        set ok 1
        set host_cursor_sync_ms 0
        set kde_interaction_monitor_path "diagnostic"

        if {$mode eq "move"} {
            set x [lindex $helper_args 1]
            set y [lindex $helper_args 2]
            set ok [monitor_command "mouse_move $x $y"]
            set host_cursor_sync_ms [sync_host_cursor_to_guest $x $y]
            set injection_count 1
        } elseif {$mode eq "click"} {
            set x [lindex $helper_args 1]
            set y [lindex $helper_args 2]
            if {![monitor_command "mouse_move $x $y"]} {
                set ok 0
            }
            set host_cursor_sync_ms [sync_host_cursor_to_guest $x $y]
            incr injection_count
            after 80
            if {![monitor_command "mouse_button 1"]} {
                set ok 0
            }
            incr injection_count
            after 80
            if {![monitor_command "mouse_button 0"]} {
                set ok 0
            }
            incr injection_count
        } elseif {$mode eq "key"} {
            set key [lindex $helper_args 1]
            set ok [monitor_command "sendkey $key"]
            set injection_count 1
        } else {
            desktop_interaction_log_line "phase=action action=$label status=FAIL reason=unknown-monitor-input-mode input_source=$input_source mode=[evidence_quote $mode]"
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-action-unknown-monitor-input"
        }

        set elapsed_ms [expr {[clock milliseconds] - $start_ms}]
        set status [expr {$ok ? "PASS" : "FAIL"}]
        set host_cursor_sync_state \
            [expr {$kde_interaction_host_cursor_sync ? "diagnostic" : "disabled"}]
        desktop_interaction_log_line "phase=action action=$label status=$status $target_fields helper_elapsed_ms=$elapsed_ms input_injection_total_ms=$elapsed_ms input_injection_overhead_ms=0 input_injection_count=$injection_count diagnostic_input=$kde_interaction_diagnostic_input monitor_path=$kde_interaction_monitor_path qemu_monitor_input=diagnostic host_cursor_sync_enabled=$kde_interaction_host_cursor_sync host_cursor_sync=$host_cursor_sync_state host_cursor_sync_ms=$host_cursor_sync_ms input_injection=[evidence_quote $helper_args]"
        if {!$ok} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-action-monitor-input-failed"
        }
        return [list $elapsed_ms $elapsed_ms $injection_count 0]
    }

    set result [run_desktop_interaction_helper_command action $label $helper_args 20000]
    set status_path [lindex $result 0]
    set log_path [lindex $result 1]
    set log_text [lindex $result 3]
    set helper_elapsed_ms [lindex $result 4]
    set host_cursor_sync_ms 0
    set injection_lines {}
    set injection_total_ms 0
    set injection_fail 0
    foreach raw_line [split $log_text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {kde_interaction_helper phase=input-injection[^\r\n]*} $line match]} {
            lappend injection_lines [string map {"\t" " " "\r" "" "\n" " "} $match]
            if {[regexp {elapsed_ms=([0-9]+)} $match -> elapsed]} {
                set injection_total_ms [expr {$injection_total_ms + $elapsed}]
            }
            if {[regexp {status=FAIL} $match]} {
                set injection_fail 1
            }
        }
    }
    if {[regexp {mouseinject: (open|write) [^\r\n]*failed} $log_text]} {
        desktop_interaction_log_line "phase=action action=$label status=FAIL reason=mouseinject status_path=$status_path log_path=$log_path log=[evidence_quote $log_text]"
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-action-failed"
    }
    if {$injection_fail} {
        desktop_interaction_log_line "phase=action action=$label status=FAIL reason=input-injection status_path=$status_path log_path=$log_path log=[evidence_quote $log_text]"
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-action-injection-failed"
    }
    set cursor_target [interaction_helper_cursor_target $helper_args]
    if {[lindex $cursor_target 0]} {
        set host_cursor_sync_ms \
            [sync_host_cursor_to_guest [lindex $cursor_target 1] \
                                       [lindex $cursor_target 2]]
    }
    set injection_summary [join $injection_lines " | "]
    set input_injection_overhead_ms [expr {$helper_elapsed_ms - $injection_total_ms}]
    set host_cursor_sync_state \
        [expr {$kde_interaction_host_cursor_sync ? "diagnostic" : "disabled"}]
    desktop_interaction_log_line "phase=action action=$label status=PASS $target_fields helper_elapsed_ms=$helper_elapsed_ms input_injection_total_ms=$injection_total_ms input_injection_overhead_ms=$input_injection_overhead_ms input_injection_count=[llength $injection_lines] host_cursor_sync_enabled=$kde_interaction_host_cursor_sync host_cursor_sync=$host_cursor_sync_state host_cursor_sync_ms=$host_cursor_sync_ms qemu_monitor_input=0 monitor_path=$kde_interaction_monitor_path status_path=$status_path log_path=$log_path input_injection=[evidence_quote $injection_summary]"
    return [list $helper_elapsed_ms $injection_total_ms [llength $injection_lines] $input_injection_overhead_ms]
}

proc measure_first_visible_frame {label min_nonblack attempts delay_ms} {
    set start_ms [clock milliseconds]
    set first_nonzero_ms -1
    set first_visible_ms -1
    set last_hash "missing"
    set last_nonzero -1
    set last_nonblack -1
    set last_center "missing"
    set last_sample_line "missing"
    set samples 0

    if {![fb_visual_enabled]} {
        desktop_interaction_log_line "phase=startup action=$label status=skipped reason=fb-visual-disabled"
        return
    }

    for {set i 0} {$i < $attempts} {incr i} {
        incr samples
        set current [sample_current_once "${label}_${i}"]
        set last_hash [lindex $current 0]
        set last_nonblack [lindex $current 1]
        set last_center [lindex $current 2]
        set last_sample_line [string map {"\t" " " "\r" "" "\n" " "} [lindex $current 3]]
        set last_nonzero [lindex $current 4]

        if {$first_nonzero_ms < 0 && $last_nonzero > 0} {
            set first_nonzero_ms [expr {[clock milliseconds] - $start_ms}]
        }
        if {$last_nonblack >= $min_nonblack} {
            set first_visible_ms [expr {[clock milliseconds] - $start_ms}]
            desktop_interaction_log_line "phase=startup action=$label status=visible min_nonblack=$min_nonblack first_visible_ms=$first_visible_ms first_nonzero_ms=$first_nonzero_ms samples=$samples interval_ms=$delay_ms last_hash=$last_hash last_nonzero=$last_nonzero last_nonblack=$last_nonblack last_center=$last_center"
            puts "KDE-PLASMA-DESKTOP-SMOKE-INFO startup action=$label status=visible first_visible_ms=$first_visible_ms first_nonzero_ms=$first_nonzero_ms samples=$samples"
            return
        }
        after $delay_ms
    }

    set elapsed_ms [expr {[clock milliseconds] - $start_ms}]
    set fbstat_host_log ""
    set fbstat_guest_log ""
    set fbstat_elapsed_ms -1
    if {![catch {
        set fbstat_result [run_desktop_interaction_helper_command \
                               fbstat "${label}_timeout" "" 30000]
        set fbstat_guest_log [lindex $fbstat_result 1]
        set fbstat_elapsed_ms [lindex $fbstat_result 4]
        set fbstat_host_log [lindex $fbstat_result 5]
    } fbstat_err]} {
        desktop_interaction_log_line "phase=startup action=$label status=fbstat-timeout-snapshot guest_log=$fbstat_guest_log host_log=$fbstat_host_log elapsed_ms=$fbstat_elapsed_ms"
    } else {
        desktop_interaction_log_line "phase=startup action=$label status=fbstat-timeout-snapshot-fail error=[evidence_quote $fbstat_err]"
    }
    desktop_interaction_log_line "phase=startup action=$label status=timeout min_nonblack=$min_nonblack elapsed_ms=$elapsed_ms first_nonzero_ms=$first_nonzero_ms samples=$samples interval_ms=$delay_ms last_hash=$last_hash last_nonzero=$last_nonzero last_nonblack=$last_nonblack last_center=$last_center last_sample=[evidence_quote $last_sample_line]"
    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-visible-timeout attempts=$attempts min=$min_nonblack"
}

proc measure_visual_action {phase action_label x y helper_args timeout_ms interval_ms} {
    set before [sample_current_once "${phase}_${action_label}_before"]
    set before_hash [lindex $before 0]
    set before_nonblack [lindex $before 1]
    set before_center [lindex $before 2]
    set action_start_ms [clock milliseconds]
    set action_helper_elapsed_ms -1
    set input_injection_total_ms -1
    set input_injection_count -1
    set input_injection_overhead_ms -1

    set action_result [run_desktop_interaction_action "${phase}_${action_label}" $helper_args]
    set action_helper_elapsed_ms [lindex $action_result 0]
    set input_injection_total_ms [lindex $action_result 1]
    set input_injection_count [lindex $action_result 2]
    set input_injection_overhead_ms [lindex $action_result 3]

    set visual_start_ms [clock milliseconds]
    set action_elapsed_ms [expr {$visual_start_ms - $action_start_ms}]
    set first_changed_ms -1
    set first_changed_visual_ms -1
    set first_changed_sample_start_visual_ms -1
    set first_changed_sample_end_visual_ms -1
    set first_changed_sample_elapsed_ms -1
    set first_changed_sample_timing_fields "first_changed_sample_open_ms=-1 first_changed_sample_info_ms=-1 first_changed_sample_alloc_ms=-1 first_changed_sample_readback_ms=-1 first_changed_sample_stats_ms=-1 first_changed_sample_total_ms=-1"
    set first_hash "missing"
    set first_nonblack -1
    set first_center "missing"
    set last_hash "missing"
    set last_nonblack -1
    set last_center "missing"
    set last_sample_start_visual_ms -1
    set last_sample_end_visual_ms -1
    set last_sample_elapsed_ms -1
    set last_sample_timing_fields "last_sample_open_ms=-1 last_sample_info_ms=-1 last_sample_alloc_ms=-1 last_sample_readback_ms=-1 last_sample_stats_ms=-1 last_sample_total_ms=-1"
    set samples 0
    set deadline [expr {$visual_start_ms + $timeout_ms}]
    while {[clock milliseconds] <= $deadline} {
        after $interval_ms
        incr samples
        set sample_start_ms [clock milliseconds]
        set last_sample_start_visual_ms [expr {$sample_start_ms - $visual_start_ms}]
        set current [sample_current_once "${phase}_${action_label}_${samples}"]
        set sample_end_ms [clock milliseconds]
        set last_sample_end_visual_ms [expr {$sample_end_ms - $visual_start_ms}]
        set last_sample_elapsed_ms [expr {$sample_end_ms - $sample_start_ms}]
        set last_hash [lindex $current 0]
        set last_nonblack [lindex $current 1]
        set last_center [lindex $current 2]
        set last_sample_timing_fields [prefix_key_value_fields "last_" [lindex $current 5]]
        if {$before_hash ne "missing" && $last_hash ne "missing" &&
            $last_hash ne $before_hash} {
            set first_changed_ms [expr {$sample_end_ms - $action_start_ms}]
            set first_changed_visual_ms $last_sample_end_visual_ms
            set first_changed_sample_start_visual_ms $last_sample_start_visual_ms
            set first_changed_sample_end_visual_ms $last_sample_end_visual_ms
            set first_changed_sample_elapsed_ms $last_sample_elapsed_ms
            set first_changed_sample_timing_fields [prefix_key_value_fields "first_changed_" [lindex $current 5]]
            set first_hash $last_hash
            set first_nonblack $last_nonblack
            set first_center $last_center
            break
        }
    }

    set end_ms [expr {[clock milliseconds] - $action_start_ms}]
    set status [expr {$first_changed_ms >= 0 ? "changed" : "no-change"}]
    desktop_interaction_log_line "phase=$phase action=$action_label status=$status x=$x y=$y start_ms=$action_start_ms action_elapsed_ms=$action_elapsed_ms action_helper_elapsed_ms=$action_helper_elapsed_ms input_injection_total_ms=$input_injection_total_ms input_injection_overhead_ms=$input_injection_overhead_ms input_injection_count=$input_injection_count first_changed_ms=$first_changed_ms first_changed_visual_ms=$first_changed_visual_ms first_changed_sample_start_visual_ms=$first_changed_sample_start_visual_ms first_changed_sample_end_visual_ms=$first_changed_sample_end_visual_ms first_changed_sample_elapsed_ms=$first_changed_sample_elapsed_ms $first_changed_sample_timing_fields end_ms=$end_ms samples=$samples interval_ms=$interval_ms timeout_ms=$timeout_ms before_hash=$before_hash before_nonblack=$before_nonblack before_center=$before_center first_hash=$first_hash first_nonblack=$first_nonblack first_center=$first_center last_hash=$last_hash last_nonblack=$last_nonblack last_center=$last_center last_sample_start_visual_ms=$last_sample_start_visual_ms last_sample_end_visual_ms=$last_sample_end_visual_ms last_sample_elapsed_ms=$last_sample_elapsed_ms $last_sample_timing_fields"
    puts "KDE-PLASMA-DESKTOP-SMOKE-INFO interaction phase=$phase action=$action_label status=$status first_changed_ms=$first_changed_ms end_ms=$end_ms before_hash=$before_hash last_hash=$last_hash"
    return $status
}

proc abs16_to_guest_pixel {value max_pixel} {
    if {![string is integer -strict $value]} {
        return -1
    }
    if {$value < 0 || $value > 65535} {
        return -1
    }
    return [expr {int((double($value) / 65535.0) * $max_pixel + 0.5)}]
}

proc wait_for_taskbar_settled_before_hover {min_nonblack attempts interval_ms explicit_wait_ms stable_required} {
    set start_ms [clock milliseconds]
    desktop_interaction_log_line "phase=taskbar-settle action=before-hover status=start explicit_wait_ms=$explicit_wait_ms attempts=$attempts interval_ms=$interval_ms stable_required=$stable_required min_nonblack=$min_nonblack"
    if {$explicit_wait_ms > 0} {
        after $explicit_wait_ms
    }

    set last_hash "missing"
    set last_nonblack -1
    set last_center "missing"
    set stable_count 0
    set samples 0
    for {set i 0} {$i < $attempts} {incr i} {
        incr samples
        set current [sample_current_once "taskbar_settle_before_hover_$samples"]
        set hash [lindex $current 0]
        set nonblack [lindex $current 1]
        set center [lindex $current 2]
        if {$hash ne "missing" && $nonblack >= $min_nonblack} {
            if {$hash eq $last_hash} {
                incr stable_count
            } else {
                set stable_count 1
            }
        } else {
            set stable_count 0
        }
        set last_hash $hash
        set last_nonblack $nonblack
        set last_center $center
        if {$stable_count >= $stable_required} {
            set elapsed_ms [expr {[clock milliseconds] - $start_ms}]
            update_desktop_interaction_bounds_from_sample \
                "taskbar-settled-before-hover" $current
            desktop_interaction_log_line "phase=taskbar-settle action=before-hover status=PASS elapsed_ms=$elapsed_ms samples=$samples stable_count=$stable_count hash=$last_hash nonblack=$last_nonblack center=$last_center [desktop_interaction_bounds_fields]"
            puts "KDE-PLASMA-DESKTOP-SMOKE-INFO taskbar-settled-before-hover status=PASS elapsed_ms=$elapsed_ms samples=$samples hash=$last_hash"
            return
        }
        after $interval_ms
    }

    set elapsed_ms [expr {[clock milliseconds] - $start_ms}]
    desktop_interaction_log_line "phase=taskbar-settle action=before-hover status=FAIL reason=unstable elapsed_ms=$elapsed_ms samples=$samples stable_count=$stable_count last_hash=$last_hash last_nonblack=$last_nonblack last_center=$last_center"
    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL taskbar-settled-before-hover-timeout"
}

proc run_hoverprobe_instrument {icon_x icon_y} {
    # Keep the rest/dismiss point outside Kickoff's lower-left popup.  Screen
    # centre is inside its application grid at 1280x800 and can launch an app.
    set away_x [env_int_range KDE_SMOKE_HOVERPROBE_AWAY_X 60000 0 65535]
    set away_y [env_int_range KDE_SMOKE_HOVERPROBE_AWAY_Y 10000 0 65535]
    set iters [env_int_range KDE_SMOKE_HOVERPROBE_ITERS 6 1 32]
    set rw [env_int_range KDE_SMOKE_HOVERPROBE_RW 56 8 400]
    set rh [env_int_range KDE_SMOKE_HOVERPROBE_RH 40 8 400]
    set settle [env_int_range KDE_SMOKE_HOVERPROBE_SETTLE_MS 900 100 5000]
    set tmo [env_int_range KDE_SMOKE_HOVERPROBE_TIMEOUT_MS 2500 200 10000]
    set calib [env_int_range KDE_SMOKE_HOVERPROBE_CALIB 256 8 4096]
    set menu_px_x [env_int_range KDE_SMOKE_HOVERPROBE_MENU_PX_X 0 0 8192]
    set menu_px_y [env_int_range KDE_SMOKE_HOVERPROBE_MENU_PX_Y 0 0 8192]
    set menu_rw [env_int_range KDE_SMOKE_HOVERPROBE_MENU_RW 64 8 800]
    set menu_rh [env_int_range KDE_SMOKE_HOVERPROBE_MENU_RH 64 8 800]
    set menu_iters [env_int_range KDE_SMOKE_HOVERPROBE_MENU_ITERS $iters 1 32]
    set do_hover [env_int_range KDE_SMOKE_HOVERPROBE_DO_HOVER 1 0 1]
    set prewarm [env_int_range KDE_SMOKE_HOVERPROBE_PREWARM 0 0 1]
    set menu_protocol [env_int_range KDE_SMOKE_HOVERPROBE_MENU_PROTOCOL 0 0 1]
    set icon2_x [env_int_range KDE_SMOKE_HOVERPROBE_ICON2_X 0 0 65535]
    set icon2_y [env_int_range KDE_SMOKE_HOVERPROBE_ICON2_Y 0 0 65535]
    set helper_args [format "%d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d %d" \
                         $icon_x $icon_y $away_x $away_y $iters $rw $rh \
                         $settle $tmo $calib $menu_px_x $menu_px_y \
                         $menu_rw $menu_rh $menu_iters $do_hover $prewarm \
                         $menu_protocol $icon2_x $icon2_y]
    desktop_interaction_log_line "phase=hoverprobe action=instrument status=start icon_abs16=$icon_x,$icon_y away_abs16=$away_x,$away_y iters=$iters rect_wh=${rw}x${rh} settle_ms=$settle timeout_ms=$tmo [desktop_interaction_guest_input_policy_fields]"
    set result [run_desktop_interaction_helper_command \
                    hoverprobe "hoverprobe" $helper_args 480000]
    set log_text [lindex $result 3]
    set host_log_path [lindex $result 5]
    foreach raw_line [split $log_text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {^hoverprobe (summary|sampler_calibration|config|menu_config|tooltip_config|menu_prewarm|done|event=)} $line]} {
            desktop_interaction_log_line "phase=hoverprobe $line"
            puts "KDE-PLASMA-DESKTOP-SMOKE-INFO $line"
        }
    }
    global outdir
    dump_optional_guest_artifact "/kde-plasma-menu-open-proof.ppm" \
        "$outdir/kde-plasma-menu-open-proof.ppm"
    dump_optional_guest_artifact "/kde-plasma-tooltip-proof.ppm" \
        "$outdir/kde-plasma-tooltip-proof.ppm"
    desktop_interaction_log_line "phase=hoverprobe action=instrument status=PASS host_log=$host_log_path"
}

proc measure_profiled_visual_hover {action_label x y timeout_ms interval_ms} {
    global guest_profiled_hover_after_ppm
    global host_profiled_hover_after_png

    set target [bound_guest_pointer_target $x $y]
    set target_fields [guest_pointer_target_fields $target guest]
    set x [lindex $target 2]
    set y [lindex $target 3]
    set pixel_x [lindex $target 4]
    set pixel_y [lindex $target 5]
    set target_desc "taskbar-left-icons"
    if {[string match "desktop*" $action_label]} {
        set target_desc "desktop-chromium-icon"
    }
    if {$pixel_x < 0 || $pixel_y < 0} {
        desktop_interaction_log_line "phase=profiled-hover action=$action_label status=FAIL reason=invalid-target $target_fields target=$target_desc"
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL profiled-hover-invalid-target"
    }

    desktop_interaction_log_line "phase=profiled-hover action=$action_label status=start $target_fields target=$target_desc kprofile_process_group=1 coverage=guest-input [desktop_interaction_guest_input_policy_fields]"
    set hover_status [measure_visual_action profiled-hover $action_label $x $y "move $x $y" $timeout_ms $interval_ms]
    capture_fb $guest_profiled_hover_after_ppm "profiled-hover-after"
    host_screenshot "profiled-hover-after" $host_profiled_hover_after_png
    desktop_interaction_log_line "phase=profiled-hover-capture action=$action_label status=PASS hover_status=$hover_status guest_after=$guest_profiled_hover_after_ppm"
    if {$hover_status ne "changed" && [env_bool KDE_SMOKE_PROFILED_HOVER_REQUIRE_CHANGE 0]} {
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL profiled-hover-no-visible-change"
    }
}

proc direct_launch_helper_label {launch_index repeat_count launch_temperature} {
    if {$repeat_count <= 1} {
        return "kde-app-launch-probe"
    }
    return [format "kde-app-launch-probe-%02d-%s" \
                $launch_index $launch_temperature]
}

proc direct_launch_phase_host_path {launch_index repeat_count launch_temperature} {
    global outdir konsole_phase_log

    if {$repeat_count <= 1} {
        return $konsole_phase_log
    }
    return [format "%s/xv6-konsole-phase-%02d-%s.log" \
                $outdir $launch_index $launch_temperature]
}

proc measure_direct_app_launch_latency {{launch_index 1} {repeat_count 1} {repeat_delay_ms 1500}} {
    global guest_konsole_phase_log konsole_phase_log
    global root outdir wayland_debug_summary_log
    global runlog
    global direct_launch_raw_manifest
    global desktop_interaction_log
    global taskbar_settled_before_hover_ppm profiled_hover_after_ppm
    global profiled_hover_diff_png profiled_hover_diff_txt
    global direct_launch_before_ppm direct_launch_after_ppm
    global direct_launch_diff_png direct_launch_diff_txt
    global host_taskbar_settled_before_hover_png host_profiled_hover_after_png
    global host_direct_launch_after_png host_profiled_hover_diff_png
    global host_profiled_hover_diff_txt

    set launch_temperature [expr {$launch_index == 1 ? "cold" : "warm"}]
    set launch_fields "launch_index=$launch_index launch_temperature=$launch_temperature repeat_count=$repeat_count repeat_delay_ms=$repeat_delay_ms"
    set helper_label \
        [direct_launch_helper_label $launch_index $repeat_count $launch_temperature]
    set helper_args \
        [format "%d %s %d %d" $launch_index $launch_temperature $repeat_count $repeat_delay_ms]

    set start_ms [clock milliseconds]
    desktop_interaction_log_line "phase=direct-launch action=kde-app-launch-probe status=start start_ms=$start_ms $launch_fields helper_label=$helper_label [desktop_interaction_guest_input_policy_fields]"
    set result [run_desktop_interaction_helper_command \
                    direct-launch $helper_label $helper_args 120000]
    set status_path [lindex $result 0]
    set log_path [lindex $result 1]
    set log_text [lindex $result 3]
    set helper_elapsed_ms [lindex $result 4]
    set host_log_path [lindex $result 5]
    set host_status_path [lindex $result 6]
    set artifact_raw_log "missing"
    set artifact_status "missing"
    if {$host_log_path ne ""} {
        set artifact_raw_log [file tail $host_log_path]
    }
    if {$host_status_path ne ""} {
        set artifact_status [file tail $host_status_path]
    }
    set manifest_mode [expr {$repeat_count > 1 ? "a" : "w"}]
    set manifest_fh [open $direct_launch_raw_manifest $manifest_mode]
    if {$repeat_count > 1} {
        puts $manifest_fh ""
        puts $manifest_fh "launch_begin=1"
    }
    puts $manifest_fh $launch_fields
    puts $manifest_fh "helper_label=$helper_label"
    puts $manifest_fh "artifact_raw_log=$artifact_raw_log"
    puts $manifest_fh "artifact_status=$artifact_status"
    puts $manifest_fh "artifact_path_base=manifest-directory"
    if {$artifact_raw_log ne "missing"} {
        puts $manifest_fh "artifact_raw_log_path=./$artifact_raw_log"
    } else {
        puts $manifest_fh "artifact_raw_log_path=missing"
    }
    if {$artifact_status ne "missing"} {
        puts $manifest_fh "artifact_status_path=./$artifact_status"
    } else {
        puts $manifest_fh "artifact_status_path=missing"
    }
    puts $manifest_fh "live_host_log=$host_log_path"
    puts $manifest_fh "live_host_status=$host_status_path"
    puts $manifest_fh "guest_log=$log_path"
    puts $manifest_fh "guest_status=$status_path"
    puts $manifest_fh "interaction_log=$desktop_interaction_log"
    puts $manifest_fh "input_policy=guest-only"
    puts $manifest_fh "input_source=guest"
    puts $manifest_fh "pointer_injection=guest-mouseinject"
    puts $manifest_fh "host_cursor_sync_enabled=0"
    puts $manifest_fh "host_cursor_sync=disabled"
    puts $manifest_fh "qemu_monitor_input=0"
    puts $manifest_fh "monitor_path=disabled"
    puts $manifest_fh "taskbar_settled_before_hover_ppm=$taskbar_settled_before_hover_ppm"
    puts $manifest_fh "profiled_hover_after_ppm=$profiled_hover_after_ppm"
    puts $manifest_fh "profiled_hover_diff_png=$profiled_hover_diff_png"
    puts $manifest_fh "profiled_hover_diff_txt=$profiled_hover_diff_txt"
    puts $manifest_fh "host_taskbar_settled_before_hover_png=$host_taskbar_settled_before_hover_png"
    puts $manifest_fh "host_profiled_hover_after_png=$host_profiled_hover_after_png"
    puts $manifest_fh "host_profiled_hover_diff_png=$host_profiled_hover_diff_png"
    puts $manifest_fh "host_profiled_hover_diff_txt=$host_profiled_hover_diff_txt"
    puts $manifest_fh "host_direct_launch_after_png=$host_direct_launch_after_png"
    puts $manifest_fh "direct_launch_before_ppm=$direct_launch_before_ppm"
    puts $manifest_fh "direct_launch_after_ppm=$direct_launch_after_ppm"
    puts $manifest_fh "direct_launch_diff_png=$direct_launch_diff_png"
    puts $manifest_fh "direct_launch_diff_txt=$direct_launch_diff_txt"
    puts $manifest_fh "hover_kprofile_process_group=1"
    puts $manifest_fh "hover_coverage=guest-mouseinject"
    if {[info exists ::env(KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT)]} {
        puts $manifest_fh "requested_konsole_variant=$::env(KDE_APP_LAUNCH_PROBE_KONSOLE_VARIANT)"
    } else {
        puts $manifest_fh "requested_konsole_variant=baseline"
    }
    close $manifest_fh
    set probe_rc "missing"
    if {[regexp {probe_rc=([-0-9]+)} [lindex $result 2] -> parsed_probe_rc]} {
        set probe_rc $parsed_probe_rc
    }
    set phase_text ""
    set phase_parse_text $log_text
    set phase_host_path "missing"
    if {[read_guest_artifact_text $guest_konsole_phase_log phase_text] &&
        [regexp {kde_app_launch_probe konsole_phase} $phase_text]} {
        set phase_parse_text $phase_text
        set phase_host_path \
            [direct_launch_phase_host_path \
                 $launch_index $repeat_count $launch_temperature]
        set fh [open $phase_host_path w]
        puts -nonewline $fh $phase_text
        close $fh
    }
    set manifest_phase_fh [open $direct_launch_raw_manifest a]
    puts $manifest_phase_fh "phase_log=$phase_host_path"
    close $manifest_phase_fh

    set full_maps_guest_path "missing"
    set full_maps_host_path "missing"
    set qtmm_call_log_guest_path "missing"
    set qtmm_call_log_host_path "missing"
    if {$log_path ne "" && $log_path ne "missing"} {
        set guest_log_base $log_path
        regsub {\.log$} $guest_log_base "" guest_log_base
        set full_maps_guest_path "$guest_log_base.konsole-full-maps.log"
        set qtmm_call_log_guest_path "$guest_log_base.qtmm-final-call-log.txt"
    }
    if {$host_log_path ne "" && $host_log_path ne "missing"} {
        set host_log_base $host_log_path
        regsub {\.log$} $host_log_base "" host_log_base
        set full_maps_host_path "$host_log_base.konsole-full-maps.log"
        set qtmm_call_log_host_path "$host_log_base.qtmm-final-call-log.txt"
    }
    if {$full_maps_guest_path ne "missing" &&
        $full_maps_host_path ne "missing"} {
        dump_optional_guest_artifact $full_maps_guest_path $full_maps_host_path
    }
    if {$qtmm_call_log_guest_path ne "missing" &&
        $qtmm_call_log_host_path ne "missing"} {
        dump_optional_guest_artifact $qtmm_call_log_guest_path \
            $qtmm_call_log_host_path
    }
    set manifest_artifact_fh [open $direct_launch_raw_manifest a]
    puts $manifest_artifact_fh "konsole_full_maps_guest=$full_maps_guest_path"
    puts $manifest_artifact_fh "konsole_full_maps_host=$full_maps_host_path"
    puts $manifest_artifact_fh "qtmm_final_call_log_guest=$qtmm_call_log_guest_path"
    puts $manifest_artifact_fh "qtmm_final_call_log_host=$qtmm_call_log_host_path"
    close $manifest_artifact_fh
    set full_maps_artifact_status "missing"
    if {$full_maps_host_path ne "missing" &&
        [guest_artifact_real_file $full_maps_host_path]} {
        set full_maps_artifact_status "PASS"
    }
    set qtmm_call_artifact_status "missing"
    if {$qtmm_call_log_host_path ne "missing" &&
        [guest_artifact_real_file $qtmm_call_log_host_path]} {
        set qtmm_call_artifact_status "PASS"
    }
    desktop_interaction_log_line "phase=direct-launch-artifact action=konsole-full-maps status=$full_maps_artifact_status $launch_fields guest=$full_maps_guest_path host=$full_maps_host_path"
    desktop_interaction_log_line "phase=direct-launch-artifact action=qtmm-final-call-log status=$qtmm_call_artifact_status $launch_fields guest=$qtmm_call_log_guest_path host=$qtmm_call_log_host_path"
    if {[regexp {kde_app_launch_probe[^\r\n]*status=FAIL} $log_text]} {
        desktop_interaction_log_line "phase=direct-launch action=kde-app-launch-probe status=FAIL $launch_fields status_path=$status_path log_path=$log_path host_log=$host_log_path host_status=$host_status_path"
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-app-launch-latency-probe-output-fail"
    }
    if {$probe_rc ne "missing" && $probe_rc != 0} {
        desktop_interaction_log_line "phase=direct-launch action=kde-app-launch-probe status=FAIL reason=probe-rc probe_rc=$probe_rc $launch_fields status_path=$status_path log_path=$log_path host_log=$host_log_path host_status=$host_status_path log=[evidence_quote $log_text]"
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-app-launch-latency-probe-rc"
    }
    if {![regexp {kde_app_launch_probe[^\r\n]*status=PASS} $log_text]} {
        desktop_interaction_log_line "phase=direct-launch action=kde-app-launch-probe status=FAIL reason=missing-pass $launch_fields status_path=$status_path log_path=$log_path host_log=$host_log_path host_status=$host_status_path log=[evidence_quote $log_text]"
        finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-app-launch-latency-probe-missing-pass"
    }
    set elapsed_ms [expr {[clock milliseconds] - $start_ms}]
    set konsole_wait_ms "missing"
    set konsole_sample_ms "missing"
    set konsole_only "missing"
    set konsole_variant "baseline"
    set konsole_launch_start_ms "missing"
    set konsole_marker_found_since_launch_ms "missing"
    set konsole_launch_call_ms "missing"
    set konsole_wrapper_start_since_launch_ms "missing"
    set konsole_wrapper_marker_found_since_wrapper_ms "missing"
    set konsole_wrapper_open_delta_ms "missing"
    set konsole_wrapper_marker_write_delta_ms "missing"
    set konsole_wrapper_written_delta_ms "missing"
    set konsole_wrapper_before_exec_delta_ms "missing"
    set konsole_pty_ptmx_since_launch_ms "missing"
    set konsole_pty_pts_since_launch_ms "missing"
    set konsole_bash_start_since_launch_ms "missing"
    set konsole_bash_start_since_wrapper_ms "missing"
    set konsole_bash_prompt_since_launch_ms "missing"
    set konsole_bash_prompt_since_wrapper_ms "missing"
    set konsole_pts_to_wrapper_ms "missing"
    set konsole_wrapper_to_bash_comm_ms "missing"
    set konsole_wrapper_to_bash_prompt_ms "missing"
    set kprofile_enabled [desktop_interaction_kprofile_enabled]
    set kprofile_hover_requested [env_bool KDE_APP_LAUNCH_PROBE_KPROFILE_HOVER 0]
    set kprofile_userpc [env_bool KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC 0]
    set kprofile_vfs_enoent_attr [env_bool KDE_APP_LAUNCH_PROBE_KPROFILE_VFS_ENOENT_ATTR 0]
    set kprofile_userpc_period [env_int_range KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_PERIOD "missing" 1 2147483647]
    set kprofile_userpc_limit [env_int_range KDE_APP_LAUNCH_PROBE_KPROFILE_USERPC_LIMIT "missing" 0 2147483647]
    set kprofile_hover_included 0
    set kprofile_hover_label "missing"
    set kprofile_hover_x "missing"
    set kprofile_hover_y "missing"
    set kprofile_hover_rc "missing"
    set kprofile_hover_visual_only 0
    set kprofile_hover_process_group "missing"
    set kprofile_app_launch_included 0
    set kprofile_timeout_hit "missing"
    set kprofile_timeout_ms "missing"
    set kprofile_elapsed_ms "missing"
    set kprofile_cpu_busy_ms "missing"
    set kprofile_userpc_available "0"
    set kprofile_userpc_stored "missing"
    set kprofile_userpc_total_seen "missing"
    set kprofile_userpc_printed "missing"
    set kprofile_userpc_dropped "missing"
    set kprofile_userpc_overwritten "missing"
    set kprofile_userpc_first_seq "missing"
    set kprofile_userpc_last_seq "missing"
    set konsole_child_trace_summary "available=0"
    set konsole_qt_event_trace_fd3_ready_in_active_span "0"
    set konsole_qt_event_trace_fd3_ready_in_process_events "0"
    set konsole_qt_event_trace_fd3_ready_in_glib_iteration "0"
