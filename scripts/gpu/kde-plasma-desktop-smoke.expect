        return "x11-glx-fps-oml-issue-state-samples-invalid"
    }
    if {$requested_sample_interval == 1} {
        if {$issue_state_samples != $sbc_issued} {
            return "x11-glx-fps-oml-issue-state-samples-mismatch"
        }
    } else {
        set expected_samples [expr {($sbc_issued + $requested_sample_interval - 1) / $requested_sample_interval}]
        if {$issue_state_samples != $expected_samples} {
            return "x11-glx-fps-oml-issue-state-samples-mismatch"
