            return "x11-glx-fps-oml-issue-state-sampled-ratio-invalid"
        }
        if {$ratio_samples != $issue_state_samples ||
            $ratio_issued != $sbc_issued} {
            return "x11-glx-fps-oml-issue-state-sampled-ratio-mismatch"
        }
        if {$issue_state_first_sample_frame eq "" ||
            $issue_state_last_sample_frame eq "" ||
            $issue_state_first_sample_sbc eq "" ||
            $issue_state_last_sample_sbc eq ""} {
            return "x11-glx-fps-oml-issue-state-sample-bounds-missing"
        }
        if {![string is integer -strict $issue_state_first_sample_frame] ||
            ![string is integer -strict $issue_state_last_sample_frame] ||
            ![string is integer -strict $issue_state_first_sample_sbc] ||
            ![string is integer -strict $issue_state_last_sample_sbc]} {
            return "x11-glx-fps-oml-issue-state-sample-bounds-invalid"
        }
        if {$issue_state_first_sample_frame <= 0 ||
            $issue_state_last_sample_frame <= 0 ||
            $issue_state_first_sample_sbc <= 0 ||
            $issue_state_last_sample_sbc <= 0} {
            return "x11-glx-fps-oml-issue-state-sample-bounds-zero"
        }
        if {$issue_state_first_sample_frame > $issue_state_last_sample_frame ||
            $issue_state_first_sample_sbc > $issue_state_last_sample_sbc} {
            return "x11-glx-fps-oml-issue-state-sample-bounds-order"
        }
        set expected_last_sample_frame [expr {1 + ($issue_state_samples - 1) * $requested_sample_interval}]
