#!/usr/bin/env expect

set timeout 360
set root [exec sh -c "cd [file dirname [info script]]/../.. && pwd"]
set build "$root/build-x86_64"
set kernel "$build/kernel/build/kernel/xv6.bin"
set fsimg "$build/fs.img"
set outdir "$build/kde-plasma-desktop-smoke"
exec mkdir -p $outdir
set runlog "$outdir/run.log"
set monitor "$outdir/qemu-monitor.sock"
set tmpimg "$outdir/kde-plasma.fs.img"
set ppm "$outdir/kde-plasma.ppm"
set png "$outdir/kde-plasma.png"
set qemu_trace_events "$outdir/qemu-trace-events"
set qemu_trace "$outdir/kde-plasma-qemu.trace"
set qemu_trace_summary "$outdir/kde-plasma-qemu-trace-summary.txt"
set final_status "$outdir/kde-plasma-desktop-smoke.status"
set guest_before_ppm "/kde-plasma-before.ppm"
set guest_after_ppm "/kde-plasma-after.ppm"
set guest_final_ppm "/kde-plasma-final.ppm"
set guest_agent_log "/tmp/kde-smoke-agent.log"
set guest_agent_status "/tmp/kde-smoke-agent.status"
set guest_host_x11_egl_log "/host-gui-host-x11-egl-smoke.log"
set before_ppm "$outdir/kde-plasma-before.ppm"
set after_ppm "$outdir/kde-plasma-after.ppm"
set final_ppm "$outdir/kde-plasma-final.ppm"
set agent_log "$outdir/kde-smoke-agent.log"
set agent_status "$outdir/kde-smoke-agent.status"
set host_x11_egl_log "$outdir/host-gui-host-x11-egl-smoke.log"
set before_png "$outdir/kde-plasma-before.png"
set after_png "$outdir/kde-plasma-after.png"
set final_png "$outdir/kde-plasma-final.png"
set diff_png "$outdir/kde-plasma-input-diff.png"
set host_startup_png "$outdir/kde-plasma-host-startup.png"
set host_input_before_png "$outdir/kde-plasma-host-input-before.png"
set host_input_after_png "$outdir/kde-plasma-host-input-after.png"
set host_x11_egl_png "$outdir/kde-plasma-host-x11-egl.png"
set host_x11_dri3_png "$outdir/kde-plasma-host-x11-dri3.png"
set host_final_png "$outdir/kde-plasma-host-final.png"
set input_diff_min 10000
set visual_warnings ""
set x11_egl_artifact_prefix ""

proc assert_default_launch_contract {} {
    global root

    set dry [exec sh -c "cd '$root' && env -u QEMU_GPU -u QEMU_APPEND -u DISPLAY_MODE AUTO_BUILD=0 QEMU_DRY_RUN=1 ./scripts/launch/launch-gui.sh 2>&1"]
    if {![regexp {virtio-vga-gl} $dry]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL default-launch-no-virgl\n$dry"
        exit 8
    }
    if {![regexp {desktop=kde} $dry]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL default-launch-no-kde\n$dry"
        exit 8
    }
    if {[regexp {weston=1} $dry]} {
        puts "KDE-PLASMA-DESKTOP-SMOKE-FAIL default-launch-weston-cmdline\n$dry"
        exit 8
    }
}

assert_default_launch_contract

exec sh -c "rm -f '$runlog' '$monitor' '$tmpimg' '$ppm' '$png' '$ppm.nc.log' '$before_ppm' '$after_ppm' '$final_ppm' '$agent_log' '$agent_status' '$host_x11_egl_log' '$final_status' '$before_png' '$after_png' '$final_png' '$diff_png' '$host_startup_png' '$host_input_before_png' '$host_input_after_png' '$host_x11_egl_png' '$host_x11_dri3_png' '$host_final_png' '$outdir'/kde-plasma-host-*.log '$qemu_trace_events' '$qemu_trace' '$qemu_trace_summary' '$outdir/kde-plasma-input-diff.txt'"
exec sh -c "cat > '$qemu_trace_events' <<'EOF'\nvirtio_gpu_features\nvirtio_gpu_cmd_get_display_info\nvirtio_gpu_cmd_get_edid\nvirtio_gpu_cmd_set_scanout\nvirtio_gpu_cmd_set_scanout_blob\nvirtio_gpu_cmd_res_create_2d\nvirtio_gpu_cmd_res_create_3d\nvirtio_gpu_cmd_res_create_blob\nvirtio_gpu_cmd_res_unref\nvirtio_gpu_cmd_res_back_attach\nvirtio_gpu_cmd_res_back_detach\nvirtio_gpu_cmd_res_xfer_toh_2d\nvirtio_gpu_cmd_res_xfer_toh_3d\nvirtio_gpu_cmd_res_xfer_fromh_3d\nvirtio_gpu_cmd_res_flush\nvirtio_gpu_cmd_ctx_create\nvirtio_gpu_cmd_ctx_destroy\nvirtio_gpu_cmd_ctx_res_attach\nvirtio_gpu_cmd_ctx_res_detach\nvirtio_gpu_cmd_ctx_submit\nvirtio_gpu_update_cursor\nvirtio_gpu_fence_ctrl\nvirtio_gpu_fence_resp\nEOF"
exec cp $fsimg $tmpimg
set chromium_available [expr {![catch {exec sh -c "debugfs -R 'stat /bin/wayland-chromium' '$tmpimg' 2>&1 | grep -q '^Inode:'"}]}]
set x11_egl_available [expr {![catch {exec sh -c "debugfs -R 'stat /bin/host-x11-egl-smoke' '$tmpimg' 2>&1 | grep -q '^Inode:'"}]}]
set x11_dri3_available [expr {![catch {exec sh -c "debugfs -R 'stat /bin/host-x11-dri3-present-smoke' '$tmpimg' 2>&1 | grep -q '^Inode:'"}]}]
catch { exec sh -c "debugfs -w -R 'rm $guest_before_ppm' '$tmpimg' >/dev/null 2>&1" }
catch { exec sh -c "debugfs -w -R 'rm $guest_after_ppm' '$tmpimg' >/dev/null 2>&1" }
catch { exec sh -c "debugfs -w -R 'rm $guest_final_ppm' '$tmpimg' >/dev/null 2>&1" }

set env(DISPLAY_MODE) "gtk"
set env(USE_KVM) [expr {[info exists env(USE_KVM)] ? $env(USE_KVM) : "1"}]
set env(QEMU_GPU) [expr {[info exists env(QEMU_GPU)] ? $env(QEMU_GPU) : "virtio-vga-gl-primary"}]
set env(QEMU_INPUT) [expr {[info exists env(QEMU_INPUT)] ? $env(QEMU_INPUT) : "virtio"}]
set env(QEMU_NET) "0"
set env(QEMU_AUDIO) "none"
set env(QEMU_VIRTIO_GPU_XRES) "1280"
set env(QEMU_VIRTIO_GPU_YRES) "800"
set kde_smoke_reducer [expr {[info exists env(KDE_SMOKE_REDUCER)] ? $env(KDE_SMOKE_REDUCER) : ""}]
if {[info exists env(KDE_SMOKE_AGENT)]} {
    set kde_smoke_agent $env(KDE_SMOKE_AGENT)
} elseif {$kde_smoke_reducer eq "x11-egl" ||
          $kde_smoke_reducer eq "x11-dri3" ||
          $kde_smoke_reducer eq "x11-glx-fps" ||
          $kde_smoke_reducer eq "x11-present-fps"} {
    set kde_smoke_agent "0"
} else {
    set kde_smoke_agent "1"
}
set qemu_append "root=/dev/disk0 video=1280x800 netsurf=0 webkit=0"
append qemu_append " virtio_gpu_disable_pageflip_copy=0"
append qemu_append " virtio_gpu_pageflip_copy=1"
append qemu_append " virtio_gpu_present_minimal_drain=1"
append qemu_append " virtio_gpu_present_no_drain=0"
if {$kde_smoke_agent ne "0"} {
    append qemu_append " kde_smoke_agent=1"
}
if {$kde_smoke_reducer eq "x11-egl"} {
    append qemu_append " kde_x11_egl_session_probe=1"
}
if {$kde_smoke_reducer eq "x11-glx-fps"} {
    append qemu_append " kde_x11_egl_session_probe=glx-fps"
}
if {$kde_smoke_reducer eq "x11-present-fps"} {
    append qemu_append " kde_x11_egl_session_probe=present-fps"
}
if {$chromium_available} {
    append qemu_append " kde_smoke_require_chromium=1"
}
if {[info exists env(QEMU_APPEND_EXTRA)] && $env(QEMU_APPEND_EXTRA) ne ""} {
    append qemu_append " " $env(QEMU_APPEND_EXTRA)
}
set env(QEMU_APPEND) $qemu_append
set env(QEMU_EXTRA) "-monitor unix:$monitor,server,nowait -trace events=$qemu_trace_events,file=$qemu_trace"

proc screendump {} {
    global monitor ppm
    catch { exec sh -c "printf 'screendump $ppm\\n' | nc -U -w 4 -q 1 '$monitor' >>'$ppm.nc.log' 2>&1 || echo nc-failed >>'$ppm.nc.log'" }
}

proc optional_monitor_screendump {} {
    if {[info exists ::env(KDE_SMOKE_QEMU_SCREENDUMP)] && $::env(KDE_SMOKE_QEMU_SCREENDUMP) ne "0"} {
        screendump
    }
}

proc host_screenshot {name path} {
    global root outdir
    catch { exec sh -c "'$root/scripts/gpu/capture-host-screen.sh' '$path' > '$outdir/kde-plasma-host-$name.log' 2>&1 || true" }
}

proc fb_visual_enabled {} {
    return 1
}

proc fb_visual_required {} {
    return [expr {[info exists ::env(KDE_SMOKE_REQUIRE_FB_VISUAL)] && $::env(KDE_SMOKE_REQUIRE_FB_VISUAL) ne "0"}]
}

proc note_visual_warning {message} {
    global visual_warnings

    if {$visual_warnings eq ""} {
        set visual_warnings $message
    } else {
        append visual_warnings "; " $message
    }
    puts "KDE-PLASMA-DESKTOP-SMOKE-WARN $message"
}

proc write_final_status {code label stage} {
    global final_status kde_smoke_reducer

    set fh [open $final_status w]
    puts $fh "status_code=$code"
    puts $fh "label=$label"
    puts $fh "stage=$stage"
    puts $fh "reducer=$kde_smoke_reducer"
    puts $fh "timestamp=[clock seconds]"
    close $fh
}

proc write_x11_egl_artifact_log {text} {
    global host_x11_egl_log x11_egl_artifact_prefix

    set fh [open $host_x11_egl_log w]
    puts -nonewline $fh $x11_egl_artifact_prefix
    puts -nonewline $fh $text
    close $fh
}

proc read_text_file {path} {
    set fh [open $path r]
    set text [read $fh]
    close $fh
    return $text
}

proc x11_egl_refresh_host_artifact_log {} {
    global tmpimg guest_host_x11_egl_log host_x11_egl_log

    set tmp "$host_x11_egl_log.debugfs.[pid]"
    catch { file delete -force $tmp }
    set dumped [expr {![catch {
        exec sh -c "debugfs -R 'dump $guest_host_x11_egl_log $tmp' '$tmpimg' >/dev/null 2>&1"
    }]}]
    if {$dumped && [file exists $tmp] && [file size $tmp] > 0} {
        file rename -force $tmp $host_x11_egl_log
        return 1
    }
    catch { file delete -force $tmp }
    return [expr {[file exists $host_x11_egl_log] && [file size $host_x11_egl_log] > 0}]
}

proc read_x11_egl_host_artifact_log {text_var} {
    global host_x11_egl_log
    upvar 1 $text_var text

    if {![x11_egl_refresh_host_artifact_log]} {
        return 0
    }
    set text [read_text_file $host_x11_egl_log]
    return [expr {$text ne ""}]
}

proc x11_egl_session_log_complete {label text} {
    if {$label eq "x11-glx-fps-session-probe"} {
        if {![regexp {host-x11-egl-smoke: phase=session_probe status=(PASS|FAIL|TIMEOUT)[^\r\n]*probe_mode=glx-fps} $text]} {
            return 0
        }
        if {![regexp {host-x11-egl-smoke: phase=glx_fps_result status=(PASS|FAIL)} $text] &&
            ![regexp {host-x11-egl-smoke: phase=glx-fps status=(PASS|FAIL|TIMEOUT)} $text]} {
            return 0
        }
        if {[regexp {(^|\n)probe_glx_present_trace=1(\r?\n|$)} $text] &&
            ![regexp {host-x11-present-trace: phase=present_trace_result status=} $text] &&
            ![regexp {host-x11-egl-smoke: phase=glx_present_trace[^\r\n]*status=FAIL} $text]} {
            return 0
        }
        return 1
    }
    if {$label eq "x11-present-fps-session-probe"} {
        return [expr {[regexp {host-x11-egl-smoke: phase=session_probe status=(PASS|FAIL|TIMEOUT)[^\r\n]*probe_mode=present-fps} $text] &&
                      ([regexp {host-x11-dri3-present-smoke: phase=present_fps_result status=(PASS|FAIL)} $text] ||
                       [regexp {host-x11-egl-smoke: phase=present-fps status=(PASS|FAIL|TIMEOUT)} $text])}]
    }
    return 1
}

proc finish {code label} {
    global qemu_pid runlog tmpimg ppm png guest_before_ppm guest_after_ppm
    global guest_final_ppm
    global guest_agent_log guest_agent_status agent_log agent_status
    global before_ppm after_ppm final_ppm before_png after_png final_png
    global diff_png input_diff_min outdir
    global qemu_trace qemu_trace_summary
    global host_final_png
    global guest_host_x11_egl_log host_x11_egl_log x11_egl_artifact_prefix

    write_final_status $code $label "finish-entry"
    host_screenshot "final" $host_final_png
    optional_monitor_screendump
    catch { exec pkill -P $qemu_pid qemu-system-x86_64 }
    catch { exec kill $qemu_pid }
    sleep 1

    if {[file exists $ppm]} {
        catch { exec convert $ppm $png }
    }
    catch { exec sh -c "debugfs -R 'dump $guest_before_ppm $before_ppm' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_after_ppm $after_ppm' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_final_ppm $final_ppm' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_agent_log $agent_log' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_agent_status $agent_status' '$tmpimg' >/dev/null 2>&1" }
    catch { exec sh -c "debugfs -R 'dump $guest_host_x11_egl_log $host_x11_egl_log' '$tmpimg' >/dev/null 2>&1" }
    if {$x11_egl_artifact_prefix ne ""} {
        set dumped_text ""
        if {[file exists $host_x11_egl_log]} {
            set dumped_text [read_text_file $host_x11_egl_log]
        }
        if {[string first $x11_egl_artifact_prefix $dumped_text] != 0} {
            write_x11_egl_artifact_log $dumped_text
        }
    }
    if {[file exists $before_ppm]} {
        catch { exec convert $before_ppm $before_png }
    }
    if {[file exists $after_ppm]} {
        catch { exec convert $after_ppm $after_png }
    }
    if {[file exists $final_ppm]} {
        catch { exec convert $final_ppm $final_png }
    }
    if {$code == 0 && ![fb_visual_enabled]} {
        set code 0
    } elseif {$code == 0 && [file exists $before_ppm] && [file exists $after_ppm]} {
        set diff_pixels_text 0
        set diff_out [exec sh -c "compare -metric AE '$before_ppm' '$after_ppm' '$diff_png' 2>&1 || true"]
        regexp {([0-9]+(\.[0-9]+)?([eE][+-]?[0-9]+)?)} $diff_out -> diff_pixels_text
        set diff_pixels [expr {int(ceil(double($diff_pixels_text)))}]
        exec sh -c "printf '%s\n' '$diff_pixels' > '$outdir/kde-plasma-input-diff.txt'"
        if {$diff_pixels < $input_diff_min} {
            if {[fb_visual_required]} {
                set code 8
                set label "KDE-PLASMA-DESKTOP-SMOKE-FAIL input-no-visible-change diff_pixels=$diff_pixels min=$input_diff_min"
            } else {
                note_visual_warning "input-readback-no-visible-change diff_pixels=$diff_pixels min=$input_diff_min"
            }
        }
    } elseif {$code == 0} {
        if {[fb_visual_required]} {
            set code 8
            set label "KDE-PLASMA-DESKTOP-SMOKE-FAIL input-capture-missing"
        } else {
            note_visual_warning "input-capture-missing"
        }
    }
    if {$code == 0} {
        set startup_regression "$outdir/kde-plasma-startup-regression.txt"
        catch { exec sh -c "grep -En 'automatically choosing Wayland because WAYLAND_DISPLAY is set|KWin startup attempt=[0-9]+ failed|KWin startup failed after retries' '$runlog' > '$startup_regression' || true" }
        if {[file exists $startup_regression] && [file size $startup_regression] > 0} {
            set code 8
            set label "KDE-PLASMA-DESKTOP-SMOKE-FAIL startup-retry-regression"
        }
    }
    if {$code == 0} {
        set service_regression "$outdir/kde-plasma-service-regression.txt"
        catch { exec sh -c "grep -En 'KApplicationTrader: mimeType \"x-scheme-handler/file\" not found|QString::arg: 2 argument\\(s\\) missing in Terminal|Parse error in tiles configuration for monitor|Program to run not set|Could not find .*, starting .*/bin/sh|Could not start program .*/bin/sh|Process operation timed out' '$runlog' > '$service_regression' || true" }
        if {[file exists $service_regression] && [file size $service_regression] > 0} {
            set code 8
            set label "KDE-PLASMA-DESKTOP-SMOKE-FAIL service-metadata-regression"
        }
    }
    catch { exec sh -c "{
        printf '%s\n' 'xv6 KDE virtio-gpu trace counts'
        for event in virtio_gpu_cmd_ctx_submit virtio_gpu_cmd_set_scanout virtio_gpu_cmd_res_flush virtio_gpu_fence_ctrl virtio_gpu_fence_resp virtio_gpu_cmd_res_create_3d virtio_gpu_cmd_res_xfer_toh_3d; do
            printf '%s %s\n' \"\$event\" \"\$(grep -c \"\$event\" '$qemu_trace' 2>/dev/null || true)\"
        done
    } > '$qemu_trace_summary'" }

    write_final_status $code $label "final"
    puts "\n$label log=$runlog ppm=$ppm png=$png before_png=$before_png after_png=$after_png"
    exit $code
}

proc optional_prompt {} {
    global timeout
    set old_timeout $timeout
    set timeout 3
    expect {
        -re {root:/#} {}
        timeout {}
        eof {}
    }
    set timeout $old_timeout
}

proc sync_prompt {{seconds 20}} {
    global timeout
    set old_timeout $timeout
    set timeout $seconds
    send "\025"
    sleep 1
    send "\r"
    expect {
        -re {root:/#} {
            set timeout $old_timeout
            return 1
        }
        timeout {
            set timeout $old_timeout
            send "\020"
            sleep 3
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL prompt-sync-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL prompt-sync-eof" }
    }
}

proc legacy_serial_validation_enabled {} {
    return [expr {[info exists ::env(KDE_SMOKE_LEGACY_SERIAL)] && $::env(KDE_SMOKE_LEGACY_SERIAL) ne "0"}]
}

proc guest_smoke_agent_enabled {} {
    global kde_smoke_agent

    return [expr {$kde_smoke_agent ne "0"}]
}

proc kde_smoke_reducer {} {
    if {[info exists ::env(KDE_SMOKE_REDUCER)]} {
        return $::env(KDE_SMOKE_REDUCER)
    }
    return ""
}

proc launch_guest_smoke_agent {} {
    global timeout chromium_available

    set old_timeout $timeout
    set timeout 20
    send "\025"
    sleep 1
    send "\r"
    expect {
        -re {root:/#} {}
        timeout {
            set timeout $old_timeout
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL agent-prompt-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL agent-prompt-eof" }
    }

    set args ""
    if {$chromium_available} {
        append args " --require-chromium"
    }
    send "rm -f /tmp/kde-smoke-agent.log /tmp/kde-smoke-agent.status /tmp/kde-smoke-agent.done /kde-plasma-before.ppm /kde-plasma-after.ppm; /bin/kde-smoke-agent$args & echo KDE_SMOKE_AGENT_LAUNCHED\r"
    expect {
        -re {KDE_SMOKE_AGENT_LAUNCHED} {
            set timeout $old_timeout
            return
        }
        -re {not found|cannot execute|exec failed|status=127} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL agent-launch"
        }
        timeout {
            set timeout $old_timeout
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL agent-launch-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL agent-launch-eof" }
    }
}

proc wait_for_guest_smoke_agent {} {
    global timeout

    set old_timeout $timeout
    set timeout 420
    expect {
        -re {KDE_SMOKE_AGENT_DONE status=PASS} {
            set timeout $old_timeout
            return
        }
        -re {KDE_SMOKE_AGENT_DONE status=FAIL} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL guest-agent-fail"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL guest-agent-crash"
        }
        timeout {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL guest-agent-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL guest-agent-eof" }
    }
}

proc kde_session_ready_role_probe_fallback {} {
    global timeout

    set old_timeout $timeout
    set ready 0

    set timeout 8
    send "\025"
    sleep 1
    send "\r"
    expect {
        -re {root:/#} {}
        timeout {}
        eof {
            set timeout $old_timeout
            return 0
        }
    }

    set timeout 12
    send "KDE_PROCESS_PROBE_TRACE=1 /bin/kde-process-probe\r"
    expect {
        -re {kde_process_probe[^\r\n]*kwin=([0-9]+)[^\r\n]*plasmashell=([0-9]+)[^\r\n]*} {
            set kwin $expect_out(1,string)
            set plasma $expect_out(2,string)
            set ready [expr {$kwin != "0" && $plasma != "0"}]
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            set timeout $old_timeout
            finish 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-crash"
        }
        -re {exec failed|not found|cannot execute|status=127} {
            set ready 0
        }
        timeout {
            set ready 0
        }
        eof {
            set timeout $old_timeout
            return 0
        }
    }
    set timeout $old_timeout
    optional_prompt
    return $ready
}

proc wait_for_kde_session_ready {} {
    global timeout
    set old_timeout $timeout
    set timeout 240
    expect {
        -re {kde-session: KWin and plasmashell are running} {
            set timeout $old_timeout
            return
        }
        -re {KWin startup attempt=[0-9]+ failed|KWin startup failed after retries} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-startup-retry"
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating|exec failed|not found|status=127} {
            finish 3 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-crash"
        }
        timeout {
            if {[kde_session_ready_role_probe_fallback]} {
                set timeout $old_timeout
                return
            }
            set timeout $old_timeout
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-session-ready-eof" }
    }
    set timeout $old_timeout
}

proc x11_egl_session_probe_wait_seconds {} {
    if {[info exists ::env(KDE_SMOKE_X11_EGL_SESSION_WAIT)] &&
        $::env(KDE_SMOKE_X11_EGL_SESSION_WAIT) ne ""} {
        if {[regexp {^[0-9]+$} $::env(KDE_SMOKE_X11_EGL_SESSION_WAIT)] &&
            $::env(KDE_SMOKE_X11_EGL_SESSION_WAIT) >= 1 &&
            $::env(KDE_SMOKE_X11_EGL_SESSION_WAIT) <= 300} {
            return $::env(KDE_SMOKE_X11_EGL_SESSION_WAIT)
        }
        puts "KDE-PLASMA-DESKTOP-SMOKE-WARN ignoring-invalid-x11-egl-session-wait=$::env(KDE_SMOKE_X11_EGL_SESSION_WAIT)"
    }
    return 120
}

proc x11_egl_session_probe_result_from_text {text status_var exit_status_var} {
    upvar 1 $status_var status
    upvar 1 $exit_status_var exit_status

    if {[regexp {kde-session: x11-egl-session-probe status=(PASS|FAIL|TIMEOUT) exit_status=([0-9]+)} $text -> found_status found_exit_status]} {
        set status $found_status
        set exit_status $found_exit_status
        return 1
    }
    if {[regexp {host-x11-egl-smoke: phase=session_probe status=(PASS|FAIL|TIMEOUT)[^\r\n]*exit_status=([0-9]+)} $text -> found_status found_exit_status]} {
        set status $found_status
        set exit_status $found_exit_status
        return 1
    }
    return 0
}

proc x11_egl_session_probe_result_from_artifact {status_var exit_status_var} {
    upvar 1 $status_var status
    upvar 1 $exit_status_var exit_status

    set text ""
    if {![read_x11_egl_host_artifact_log text]} {
        return 0
    }
    return [x11_egl_session_probe_result_from_text $text status exit_status]
}

proc x11_egl_session_probe_result_from_runlog {status_var exit_status_var} {
    global runlog
    upvar 1 $status_var status
    upvar 1 $exit_status_var exit_status

    if {![file exists $runlog]} {
        return 0
    }

    set fh [open $runlog r]
    set text [read $fh]
    close $fh
    return [x11_egl_session_probe_result_from_text $text status exit_status]
}

proc wait_for_x11_egl_session_probe_terminal {} {
    global timeout

    set wait_seconds [x11_egl_session_probe_wait_seconds]
    set old_timeout $timeout
    set status ""
    set exit_status ""

    if {[x11_egl_session_probe_result_from_artifact status exit_status]} {
        return [list $status $exit_status]
    }
    if {[x11_egl_session_probe_result_from_runlog status exit_status]} {
        return [list $status $exit_status]
    }

    set timeout $wait_seconds
    expect {
        -re {kde-session: x11-egl-session-probe status=(PASS|FAIL|TIMEOUT) exit_status=([0-9]+)} {
            set status [string trim $expect_out(1,string)]
            set exit_status [string trim $expect_out(2,string)]
            set timeout $old_timeout
            return [list $status $exit_status]
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            set timeout $old_timeout
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-session-probe-crash"
        }
        timeout {
            set timeout $old_timeout
            if {[x11_egl_session_probe_result_from_artifact status exit_status]} {
                return [list $status $exit_status]
            }
            if {[x11_egl_session_probe_result_from_runlog status exit_status]} {
                return [list $status $exit_status]
            }
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-session-probe-terminal-timeout"
        }
        eof {
            set timeout $old_timeout
            if {[x11_egl_session_probe_result_from_artifact status exit_status]} {
                return [list $status $exit_status]
            }
            if {[x11_egl_session_probe_result_from_runlog status exit_status]} {
                return [list $status $exit_status]
            }
            finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL x11-egl-session-probe-eof"
        }
    }
    set timeout $old_timeout
    optional_prompt
    return [list $status $exit_status]
}

proc run_guest_check {command label timeout_seconds} {
    global timeout
    set old_timeout $timeout
    sync_prompt
    set timeout $timeout_seconds
    send [format {%s; echo %s_STATUS:$?} $command $label]
    send "\r"
    expect {
        -re {kde_wayland_seat_probe timeout phase=(startup|connect|registry|roundtrip-[0-9]+|validate)} {
            set phase [string trim $expect_out(1,string)]
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-timeout-$phase"
        }
        -re {kde_wayland_seat_probe (connect failed|roundtrip-[0-9]+ failed|no wl_seat|no seat capabilities|no pointer capability|no keyboard capability|pointer capability without object|invalid pointer version)} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-output-fail"
        }
        -re {kde_[a-z0-9_]+_probe result=FAIL} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-output-fail"
        }
        -re {kde_[a-z0-9_]+_probe result=([1-9][0-9]*)} {
            set result [string trim $expect_out(1,string)]
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-result-$result"
        }
        -re {kde_[a-z0-9_]+_probe result=PASS} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_[a-z0-9_]+_probe result=0} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_libinput_probe[^\r\n]*event0=[0-9]+[^\r\n]*event1=[0-9]+} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_drm_probe done} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_app_launch_probe[^\r\n]*status=FAIL} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-output-fail"
        }
        -re {kde_process_probe[^\r\n]*status=WAIT} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-output-wait"
        }
        -re {kde_wayland_seat_probe[^\r\n]*caps=0x[0-9a-fA-F]+[^\r\n]*keyboard_events=[0-9]+} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_app_launch_probe[^\r\n]*status=PASS} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_process_probe[^\r\n]*status=PASS} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {status=PASS} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re [format {%s_STATUS:([0-9]+)} $label] {
            set status [string trim $expect_out(1,string)]
            set timeout $old_timeout
            optional_prompt
            if {$status ne "0"} {
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-status-$status"
            }
            return
        }
        timeout {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-status-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-status-eof" }
    }
    set timeout $old_timeout
    optional_prompt
}

proc run_kwin_screenshot_probe {} {
    global timeout

    set old_timeout $timeout
    sync_prompt
    set timeout 45
    set label "kde-kwin-screenshot-probe"
    send [format {/bin/kde-kwin-screenshot-probe; echo %s_STATUS:$?} $label]
    send "\r"
    expect {
        -re {kde_kwin_screenshot_probe result=PASS} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_kwin_screenshot_probe result=FAIL} {
            set timeout $old_timeout
            note_visual_warning "kwin-screenshot-readback-black"
            optional_prompt
            return
        }
        -re {PANIC|fatal page fault|spin_lock reentry|segmentation fault|coredump: generating} {
            finish 4 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-kwin-screenshot-probe-crash"
        }
        timeout {
            set timeout $old_timeout
            note_visual_warning "kwin-screenshot-probe-timeout"
            optional_prompt
            return
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-kwin-screenshot-probe-eof" }
    }
    set timeout $old_timeout
    note_visual_warning "kwin-screenshot-probe-unmatched"
    optional_prompt
}

proc run_wayland_seat_probe {} {
    for {set attempt 1} {$attempt <= 4} {incr attempt} {
        set label [format "kde-wayland-seat-probe-%d" $attempt]
        set old_timeout $::timeout
        sync_prompt
        set ::timeout 35
        send [format {/bin/kde-wayland-seat-probe; echo %s_STATUS:$?} $label]
        send "\r"
        expect {
            -re {kde_wayland_seat_probe[^\r\n]*caps=0x[0-9a-fA-F]+[^\r\n]*keyboard_events=[0-9]+} {
                set ::timeout $old_timeout
                optional_prompt
                return
            }
            -re {kde_wayland_seat_probe timeout phase=(startup|connect|registry|roundtrip-[0-9]+|validate)} {
                set phase [string trim $expect_out(1,string)]
                set ::timeout $old_timeout
                optional_prompt
                if {$attempt == 4} {
                    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-seat-probe-timeout-$phase"
                }
                sleep 5
            }
            -re {kde_wayland_seat_probe (connect failed|roundtrip-[0-9]+ failed|no wl_seat|no seat capabilities|no pointer capability|no keyboard capability|pointer capability without object|invalid pointer version)} {
                set ::timeout $old_timeout
                finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-seat-probe-output-fail"
            }
            -re [format {%s_STATUS:([1-9][0-9]*)} $label] {
                set status [string trim $expect_out(1,string)]
                set ::timeout $old_timeout
                if {$attempt == 4} {
                    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-seat-probe-status-$status"
                }
                optional_prompt
                sleep 5
            }
            timeout {
                set ::timeout $old_timeout
                if {$attempt == 4} {
                    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-seat-probe-status-timeout"
                }
                optional_prompt
                sleep 5
            }
            eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-seat-probe-eof" }
        }
        set ::timeout $old_timeout
    }

    finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL kde-wayland-seat-probe-output-fail"
}

proc run_optional_chromium_probe {} {
    global timeout chromium_available
    if {!$chromium_available} {
        return
    }

    set old_timeout $timeout
    sync_prompt
    set timeout 90
    set label "kde-chromium-app-launch-probe"

    send "/bin/kde-app-launch-probe --require-chromium\r"
    expect {
        -re {kde_app_launch_probe[^\r\n]*chromium=1[^\r\n]*status=PASS} {
            set timeout $old_timeout
            optional_prompt
            return
        }
        -re {kde_app_launch_probe[^\r\n]*status=FAIL} {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-output-fail"
        }
        timeout {
            finish 8 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-timeout"
        }
        eof { finish 5 "KDE-PLASMA-DESKTOP-SMOKE-FAIL $label-eof" }
    }
    set timeout $old_timeout
    optional_prompt
}

proc run_optional_direct_app_launch_probe {} {
    if {![info exists ::env(KDE_SMOKE_DIRECT_APP_PROBE)] || $::env(KDE_SMOKE_DIRECT_APP_PROBE) eq "" || $::env(KDE_SMOKE_DIRECT_APP_PROBE) eq "0"} {
        return
    }

    run_guest_check "/bin/kde-app-launch-probe" "kde-app-launch-probe" 90
    run_optional_chromium_probe
}

proc x11_egl_setup_fallback_line {line} {
    return [regexp {host-x11-egl-smoke: (eglGetDisplay|eglInitialize|eglBindAPI|eglChooseConfig|eglCreateContext|eglCreateWindowSurface|eglMakeCurrent) status=FALLBACK [^\r\n]*fallback=glx} $line]
}

proc x11_egl_failure_label_from_line {line} {
    set line [string trim $line]
    if {[x11_egl_setup_fallback_line $line]} {
        return ""
    }
    if {[regexp {host-x11-egl-smoke: (egl|glx) ready [^\r\n]*gl_version=\(null\)} $line]} {
        return "x11-egl-null-gl-version"
    }
    if {[regexp {host-x11-egl-smoke: glx_choose_visual missing status=FAIL} $line]} {
        return "x11-egl-glx_choose_visual-missing-status-FAIL"
    }
    if {[regexp {host-x11-egl-smoke: phase=([A-Za-z0-9_]+) status=FAIL} $line -> phase]} {
        return "x11-egl-${phase}-status-FAIL"
    }
    if {[regexp {host-x11-egl-smoke: ([A-Za-z0-9_]+) ([A-Za-z0-9_]+)[^\r\n]*status=FAIL} $line -> phase reason]} {
        return "x11-egl-${phase}-${reason}-status-FAIL"
    }
    if {[regexp {host-x11-egl-smoke: ([A-Za-z0-9_]+) [^\r\n]*(failed|missing)} $line -> phase reason]} {
        return "x11-egl-${phase}-${reason}"
    }
    return ""
}

proc x11_egl_scan_launch_log {text start_var connect_var gl_var frame_var failure_var} {
    upvar 1 $start_var saw_start
    upvar 1 $connect_var saw_connect
    upvar 1 $gl_var saw_gl
    upvar 1 $frame_var saw_frame
    upvar 1 $failure_var failure_label

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-egl-smoke: start} $line]} {
            set saw_start 1
        }
        if {[regexp {host-x11-egl-smoke: connected display=} $line]} {
            set saw_connect 1
        }
        if {[regexp {host-x11-egl-smoke: (egl|glx) ready } $line]} {
            set saw_gl 1
        }
        if {[regexp {host-x11-egl-smoke: frame=[0-9]+ mode=launch} $line]} {
            set saw_frame 1
        }
        if {$failure_label eq ""} {
            set label [x11_egl_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
}

proc x11_egl_scan_exit_log {text input_var exit_var failure_var} {
    upvar 1 $input_var saw_input
    upvar 1 $exit_var saw_exit
    upvar 1 $failure_var failure_label

    foreach raw_line [split $text "\n"] {
        set line [string trimright $raw_line "\r"]
        if {[regexp {host-x11-egl-smoke: input_ready} $line]} {
            set saw_input 1
        }
        if {[regexp {host-x11-egl-smoke: exited} $line]} {
            set saw_exit 1
        }
        if {$failure_label eq ""} {
            set label [x11_egl_failure_label_from_line $line]
            if {$label ne ""} {
                set failure_label $label
            }
        }
    }
}

proc x11_egl_failure_suffix {saw_start saw_connect saw_gl saw_frame} {
    return "start=$saw_start connect=$saw_connect gl=$saw_gl frame=$saw_frame"
}

proc x11_egl_glx_probe_failure_suffix {saw_start saw_connect saw_egl_init saw_glx_ext saw_glx_version saw_fbconfigs saw_visual saw_context saw_current saw_strings saw_draw saw_result exit_status} {
    return "start=$saw_start x11_connect=$saw_connect egl_initialize=$saw_egl_init glx_query_extension=$saw_glx_ext glx_query_version=$saw_glx_version glx_fbconfigs=$saw_fbconfigs glx_choose_visual=$saw_visual glx_create_context=$saw_context glx_make_current=$saw_current gl_strings=$saw_strings draw=$saw_draw result=$saw_result exit_status=$exit_status"
}

proc x11_glx_fps_failure_suffix {saw_start saw_connect saw_egl_init saw_glx_ext saw_glx_version saw_fbconfigs saw_visual saw_context saw_current saw_strings saw_fps_begin saw_fps_result fps_status fps_frames fps_elapsed fps_value variant requested_depth requested_sample_interval result_variant oml_available queue_depth sbc_issued sbc_completed max_pending oml_last_sbc gl_flush_total swap_msc_issue_total get_sync_before_total get_sync_after_total issue_state_sample_interval issue_state_sampled_ratio issue_state_first_sample_frame issue_state_last_sample_frame issue_state_first_sample_sbc issue_state_last_sample_sbc issue_state_samples post_issue_sbc_completed_count post_issue_sbc_lag_max post_issue_msc_delta_total post_issue_msc_delta_max swap_only_skipped_draw_frames swap_interval_requested swap_interval_set_api swap_interval_set_status swap_interval_before swap_interval_after plain_swap_issue_total plain_swap_avg plain_swap_max plain_oml_available plain_oml_samples plain_oml_sample_interval plain_oml_sampled_ratio plain_oml_first_sample_frame plain_oml_last_sample_frame plain_oml_get_sync_before_total plain_oml_get_sync_after_total plain_oml_before_first_sbc plain_oml_before_last_sbc plain_oml_after_first_sbc plain_oml_after_last_sbc plain_oml_post_swap_sbc_delta_total plain_oml_post_swap_sbc_delta_max plain_oml_post_swap_msc_delta_total plain_oml_post_swap_msc_delta_max plain_post_swap_xsync_total plain_post_swap_xsync_max exit_status} {
    return "start=$saw_start x11_connect=$saw_connect egl_initialize=$saw_egl_init glx_query_extension=$saw_glx_ext glx_query_version=$saw_glx_version glx_fbconfigs=$saw_fbconfigs glx_choose_visual=$saw_visual glx_create_context=$saw_context glx_make_current=$saw_current gl_strings=$saw_strings fps_begin=$saw_fps_begin fps_result=$saw_fps_result fps_status=$fps_status frames=$fps_frames elapsed_seconds=$fps_elapsed fps=$fps_value variant=$variant requested_depth=$requested_depth requested_sample_interval=$requested_sample_interval result_variant=$result_variant oml_available=$oml_available queue_depth=$queue_depth sbc_issued=$sbc_issued sbc_completed=$sbc_completed max_pending=$max_pending oml_last_sbc=$oml_last_sbc oml_gl_flush_total_ms=$gl_flush_total oml_swap_msc_issue_total_ms=$swap_msc_issue_total oml_get_sync_before_total_ms=$get_sync_before_total oml_get_sync_after_total_ms=$get_sync_after_total oml_issue_state_sample_interval=$issue_state_sample_interval oml_issue_state_sampled_ratio=$issue_state_sampled_ratio oml_issue_state_first_sample_frame=$issue_state_first_sample_frame oml_issue_state_last_sample_frame=$issue_state_last_sample_frame oml_issue_state_first_sample_sbc=$issue_state_first_sample_sbc oml_issue_state_last_sample_sbc=$issue_state_last_sample_sbc oml_issue_state_samples=$issue_state_samples oml_post_issue_sbc_completed_count=$post_issue_sbc_completed_count oml_post_issue_sbc_lag_max=$post_issue_sbc_lag_max oml_post_issue_msc_delta_total=$post_issue_msc_delta_total oml_post_issue_msc_delta_max=$post_issue_msc_delta_max swap_only_skipped_draw_frames=$swap_only_skipped_draw_frames swap_interval_requested=$swap_interval_requested swap_interval_set_api=$swap_interval_set_api swap_interval_set_status=$swap_interval_set_status swap_interval_before=$swap_interval_before swap_interval_after=$swap_interval_after plain_swap_issue_total_ms=$plain_swap_issue_total plain_swap_avg_ms=$plain_swap_avg plain_swap_max_ms=$plain_swap_max plain_oml_available=$plain_oml_available plain_oml_samples=$plain_oml_samples plain_oml_sample_interval=$plain_oml_sample_interval plain_oml_sampled_ratio=$plain_oml_sampled_ratio plain_oml_first_sample_frame=$plain_oml_first_sample_frame plain_oml_last_sample_frame=$plain_oml_last_sample_frame plain_oml_get_sync_before_total_ms=$plain_oml_get_sync_before_total plain_oml_get_sync_after_total_ms=$plain_oml_get_sync_after_total plain_oml_before_first_sbc=$plain_oml_before_first_sbc plain_oml_before_last_sbc=$plain_oml_before_last_sbc plain_oml_after_first_sbc=$plain_oml_after_first_sbc plain_oml_after_last_sbc=$plain_oml_after_last_sbc plain_oml_post_swap_sbc_delta_total=$plain_oml_post_swap_sbc_delta_total plain_oml_post_swap_sbc_delta_max=$plain_oml_post_swap_sbc_delta_max plain_oml_post_swap_msc_delta_total=$plain_oml_post_swap_msc_delta_total plain_oml_post_swap_msc_delta_max=$plain_oml_post_swap_msc_delta_max plain_post_swap_xsync_total_ms=$plain_post_swap_xsync_total plain_post_swap_xsync_max_ms=$plain_post_swap_xsync_max exit_status=$exit_status"
}

proc x11_glx_fps_oml_queue_failure_label {variant expected_variant expected_depth result_variant oml_available queue_depth sbc_issued sbc_completed max_pending label_prefix {gl_flush_total ""} {swap_msc_issue_total ""} {require_split_timing 0}} {
    if {$variant ne $expected_variant} {
        return ""
    }
    if {$expected_depth eq ""} {
        return "${label_prefix}-requested-depth-missing"
    }
    if {$result_variant eq ""} {
        return "${label_prefix}-result-variant-missing"
    }
    if {$result_variant ne $expected_variant} {
        return "${label_prefix}-result-variant-mismatch"
    }
    if {$oml_available eq ""} {
        return "${label_prefix}-available-missing"
    }
    if {$oml_available != 1} {
        return "${label_prefix}-available-mismatch"
    }
    if {$queue_depth eq ""} {
        return "${label_prefix}-queue-depth-missing"
    }
    if {$queue_depth != $expected_depth} {
        return "${label_prefix}-queue-depth-mismatch"
    }
    if {$sbc_issued eq ""} {
        return "${label_prefix}-sbc-issued-missing"
    }
    if {$sbc_completed eq ""} {
        return "${label_prefix}-sbc-completed-missing"
    }
    if {$sbc_issued <= 0 || $sbc_completed <= 0} {
        return "${label_prefix}-sbc-zero"
    }
    if {$sbc_issued != $sbc_completed} {
        return "${label_prefix}-sbc-mismatch"
    }
    if {$max_pending eq ""} {
        return "${label_prefix}-max-pending-missing"
    }
    if {$max_pending != $expected_depth} {
        return "${label_prefix}-max-pending-mismatch"
    }
    if {$require_split_timing} {
        if {$gl_flush_total eq ""} {
            return "${label_prefix}-gl-flush-total-missing"
        }
        if {![string is double -strict $gl_flush_total] || $gl_flush_total < 0} {
            return "${label_prefix}-gl-flush-total-invalid"
        }
        if {$swap_msc_issue_total eq ""} {
            return "${label_prefix}-swap-msc-issue-total-missing"
        }
        if {![string is double -strict $swap_msc_issue_total] || $swap_msc_issue_total < 0} {
            return "${label_prefix}-swap-msc-issue-total-invalid"
        }
    }
    return ""
}

proc x11_glx_fps_oml_queue3_failure_label {variant result_variant oml_available queue_depth sbc_issued sbc_completed max_pending} {
    return [x11_glx_fps_oml_queue_failure_label $variant "oml-queue3-swap-only" 3 $result_variant $oml_available $queue_depth $sbc_issued $sbc_completed $max_pending "x11-glx-fps-oml"]
}

proc x11_glx_fps_swap_interval0_failure_label {variant result_variant frames swap_only_skipped_draw_frames swap_interval_requested swap_interval_set_api swap_interval_set_status swap_interval_after plain_swap_issue_total plain_swap_avg plain_swap_max {expected_variant "swap-interval0-swap-only"} {label_prefix "x11-glx-fps-swap-interval0"}} {
    if {$variant ne $expected_variant} {
        return ""
    }
    if {$result_variant eq ""} {
        return "$label_prefix-result-variant-missing"
    }
    if {$result_variant ne $expected_variant} {
        return "$label_prefix-result-variant-mismatch"
    }
    if {$swap_interval_requested eq ""} {
        return "$label_prefix-requested-missing"
    }
    if {$swap_interval_requested != 0} {
