#!/usr/bin/env expect

set timeout 230
set root [exec sh -c "cd [file dirname [info script]]/../.. && pwd"]
set build "$root/build-x86_64"
set kernel "$build/kernel/build/kernel/xv6.bin"
set fsimg "$build/fs.img"
set outdir "$build/host-gtk-smoke-proof"
exec mkdir -p $outdir
set runlog "$outdir/run.log"
set tmpimg "$outdir/host-gtk-smoke.fs.img"
set app_log "/tmp/host-gui-host-gtk-smoke.log"

array set guest {
    before /host-gtk-smoke-before.ppm
    launch /host-gtk-smoke-launch.ppm
    input /host-gtk-smoke-input.ppm
    exit /host-gtk-smoke-exit.ppm
}

proc host_ppm {phase} {
    global outdir
    return "$outdir/host-gtk-smoke-$phase.ppm"
}

proc host_png {phase} {
    global outdir
    return "$outdir/host-gtk-smoke-$phase.png"
}

exec sh -c "rm -f '$runlog' '$tmpimg' '$outdir'/host-gtk-smoke-*.ppm '$outdir'/host-gtk-smoke-*.png '$outdir'/diff-*.txt"
exec cp $fsimg $tmpimg
set startup_override "$outdir/startup-no-dbus"
exec sh -c "printf '%s\n' '# Temporary proof startup: skip host D-Bus helpers.' '/bin/weston-session' > '$startup_override'"
exec sh -c "printf '%s\n' 'rm /etc/startup' 'write $startup_override /etc/startup' | debugfs -w '$tmpimg' >/dev/null 2>&1"
foreach phase [array names guest] {
    catch { exec sh -c "debugfs -w -R 'rm $guest($phase)' '$tmpimg' >/dev/null 2>&1" }
}

set env(DISPLAY_MODE)          "gtk"
set env(USE_KVM)               "1"
set env(QEMU_GPU)              "virtio-vga-gl-primary"
set env(QEMU_INPUT)            "virtio"
set env(QEMU_NET)              "0"
set env(QEMU_ALLOW_WSL_SDL_GL) "1"
set env(QEMU_VIRTIO_GPU_XRES)  "1280"
set env(QEMU_VIRTIO_GPU_YRES)  "800"
set env(QEMU_APPEND) "root=/dev/disk0 weston=1 video=1280x800 netsurf=0 webkit=0"
set send_slow {1 .01}

proc fail {code label} {
    global qemu_pid runlog

    catch { exec pkill -P $qemu_pid qemu-system-x86_64 }
    puts "\n$label log=$runlog"
    exit $code
}

proc optional_prompt {} {
    global timeout

    set old_timeout $timeout
    set timeout 2
    expect {
        -re {root:/#} {}
        timeout {}
        eof {}
    }
    set timeout $old_timeout
}

proc capture_fb {phase marker label} {
    global guest

    send "fbstat ppm-current $guest($phase) 0 0 1280 800; sync; echo $marker\r"
    expect {
        -re "fb_ppm_current path=$guest($phase) screen=1280x800 scanout=1280x800" {}
        -re {fbstat: [^\r\n]+} { fail 20 "$label fbstat-error" }
        timeout { fail 20 "$label fbstat-timeout" }
        eof { fail 20 "$label fbstat-eof" }
    }
    expect {
        -re $marker {}
        timeout { fail 21 "$label marker-timeout" }
        eof { fail 21 "$label marker-eof" }
    }
    optional_prompt
}

proc extract_artifacts {} {
    global tmpimg guest outdir

    foreach phase {before launch input exit} {
        set ppm [host_ppm $phase]
        set png [host_png $phase]
        if {[catch { exec sh -c "debugfs -R 'dump $guest($phase) $ppm' '$tmpimg' >/dev/null 2>&1" } dump_out]} {
            puts "\nHOSTGTK-SMOKE-FAIL extract-$phase $dump_out"
            exit 30
        }
        if {[catch { exec convert $ppm $png } convert_out]} {
            puts "\nHOSTGTK-SMOKE-FAIL convert-$phase $convert_out"
            exit 31
        }
    }

    set launch_ae [exec sh -c "compare -metric AE '[host_ppm before]' '[host_ppm launch]' '$outdir/host-gtk-smoke-launch-diff.png' 2>&1 || true"]
    set input_ae [exec sh -c "compare -metric AE '[host_ppm launch]' '[host_ppm input]' '$outdir/host-gtk-smoke-input-diff.png' 2>&1 || true"]
    set exit_ae [exec sh -c "compare -metric AE '[host_ppm input]' '[host_ppm exit]' '$outdir/host-gtk-smoke-exit-diff.png' 2>&1 || true"]
    exec sh -c "printf '%s\\n' '$launch_ae' > '$outdir/diff-launch-ae.txt'; printf '%s\\n' '$input_ae' > '$outdir/diff-input-ae.txt'; printf '%s\\n' '$exit_ae' > '$outdir/diff-exit-ae.txt'"

    if {$launch_ae < 1000} {
        puts "\nHOSTGTK-SMOKE-FAIL launch-screenshot-unchanged changed_pixels=$launch_ae"
        exit 32
    }
    if {$input_ae < 100} {
        puts "\nHOSTGTK-SMOKE-FAIL input-screenshot-unchanged changed_pixels=$input_ae"
        exit 33
    }
    if {$exit_ae < 1000} {
        puts "\nHOSTGTK-SMOKE-FAIL exit-screenshot-unchanged changed_pixels=$exit_ae"
        exit 34
    }
    return [list $launch_ae $input_ae $exit_ae]
}

log_file -a $runlog
spawn timeout --foreground 220 bash scripts/launch/run-qemu.sh x86_64 $kernel $tmpimg
set qemu_pid [exp_pid]

expect {
    -re {weston-desktop-shell: loaded [0-9]+ desktop entries} {}
    -re {panic|fatal page fault|coredump: generating|virtio_gpu: async command} {
        fail 3 "HOSTGTK-SMOKE-FAIL crash-marker"
    }
    timeout { fail 4 "HOSTGTK-SMOKE-FAIL no-desktop" }
    eof { fail 5 "HOSTGTK-SMOKE-FAIL early-eof" }
}

sleep 2
send "\r"
expect {
    -re {root:/#} {}
    timeout { fail 6 "HOSTGTK-SMOKE-FAIL no-fresh-prompt" }
    eof { fail 6 "HOSTGTK-SMOKE-FAIL fresh-prompt-eof" }
}

capture_fb before "HOSTGTK_BASE_DONE" "HOSTGTK-SMOKE-FAIL before"

send "rm -f $app_log; /bin/host-gtk-smoke &\r"
expect {
    -re {root:/#} {}
    -re {exec .*failed|not found|cannot execute} { fail 7 "HOSTGTK-SMOKE-FAIL launch" }
    timeout { fail 7 "HOSTGTK-SMOKE-FAIL no-prompt-after-launch" }
    eof { fail 7 "HOSTGTK-SMOKE-FAIL launch-eof" }
}

sleep 5
send "cat $app_log; echo HOSTGTK_LOG_DONE\r"
set saw_start 0
set saw_ready 0
set saw_log_done 0
while {!($saw_start && $saw_ready && $saw_log_done)} {
    expect {
        -re {host-gtk-smoke: start} { set saw_start 1 }
        -re {host-gtk-smoke: ready} { set saw_ready 1 }
        -re {HOSTGTK_LOG_DONE} { set saw_log_done 1 }
        -re {gtk_init_check failed|No such file|cannot|failed} { fail 8 "HOSTGTK-SMOKE-FAIL app-log-error" }
        timeout {
            if {!$saw_start} { fail 8 "HOSTGTK-SMOKE-FAIL start-timeout" }
            if {!$saw_ready} { fail 9 "HOSTGTK-SMOKE-FAIL ready-timeout" }
            fail 10 "HOSTGTK-SMOKE-FAIL log-marker-timeout"
        }
        eof { fail 10 "HOSTGTK-SMOKE-FAIL log-eof" }
    }
}
optional_prompt

capture_fb launch "HOSTGTK_LAUNCH_FB_DONE" "HOSTGTK-SMOKE-FAIL launch"

send "mouseinject 32768 32768 0; mouseinject 32768 32768 1; mouseinject 32768 32768 0; echo HOSTGTK_FOCUS_DONE\r"
expect {
    -re {HOSTGTK_FOCUS_DONE} {}
    timeout { fail 11 "HOSTGTK-SMOKE-FAIL focus-timeout" }
    eof { fail 11 "HOSTGTK-SMOKE-FAIL focus-eof" }
}
optional_prompt

sleep 1
send "keyinject text \" xv6\"; echo HOSTGTK_KEYS_DONE\r"
expect {
    -re {HOSTGTK_KEYS_DONE} {}
    timeout { fail 12 "HOSTGTK-SMOKE-FAIL key-timeout" }
    eof { fail 12 "HOSTGTK-SMOKE-FAIL key-eof" }
}
optional_prompt

sleep 2
send "cat $app_log; echo HOSTGTK_INPUT_LOG_DONE\r"
expect {
    -re {host-gtk-smoke: changed text=.*xv6} {}
    timeout { fail 13 "HOSTGTK-SMOKE-FAIL input-log-timeout" }
    eof { fail 13 "HOSTGTK-SMOKE-FAIL input-log-eof" }
}
expect {
    -re {HOSTGTK_INPUT_LOG_DONE} {}
    timeout { fail 13 "HOSTGTK-SMOKE-FAIL input-log-marker-timeout" }
    eof { fail 13 "HOSTGTK-SMOKE-FAIL input-log-marker-eof" }
}
optional_prompt

capture_fb input "HOSTGTK_INPUT_FB_DONE" "HOSTGTK-SMOKE-FAIL input"

send "keyinject key esc; echo HOSTGTK_ESC_DONE\r"
expect {
    -re {HOSTGTK_ESC_DONE} {}
    timeout { fail 14 "HOSTGTK-SMOKE-FAIL esc-timeout" }
    eof { fail 14 "HOSTGTK-SMOKE-FAIL esc-eof" }
}
optional_prompt

sleep 3
send "ps; echo HOSTGTK_AFTER_ESC_PS_DONE\r"
set saw_after_esc_done 0
while {!$saw_after_esc_done} {
    expect {
        -re {host-gtk-smoke} {
            fail 15 "HOSTGTK-SMOKE-FAIL process-still-running-after-esc"
        }
        -re {HOSTGTK_AFTER_ESC_PS_DONE} {
            if {[regexp {host-gtk-smoke} $expect_out(buffer)]} {
                fail 15 "HOSTGTK-SMOKE-FAIL process-still-running-after-esc"
            }
            set saw_after_esc_done 1
        }
        timeout { fail 15 "HOSTGTK-SMOKE-FAIL after-esc-ps-timeout" }
        eof { fail 15 "HOSTGTK-SMOKE-FAIL after-esc-ps-eof" }
    }
}
optional_prompt

capture_fb exit "HOSTGTK_EXIT_FB_DONE" "HOSTGTK-SMOKE-FAIL exit"

catch { exec pkill -P $qemu_pid qemu-system-x86_64 }
sleep 1
set aes [extract_artifacts]
puts "\nHOSTGTK-SMOKE-PASS launch_changed_pixels=[lindex $aes 0] input_changed_pixels=[lindex $aes 1] exit_changed_pixels=[lindex $aes 2] launch_png=[host_png launch] input_png=[host_png input] exit_png=[host_png exit] log=$runlog"
exit 0
