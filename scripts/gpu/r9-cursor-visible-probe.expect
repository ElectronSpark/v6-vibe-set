#!/usr/bin/env expect

set timeout 300
match_max 2000000

set root [exec sh -c "cd [file dirname [info script]]/../.. && pwd"]
set build "$root/build-x86_64"
set kernel "$build/kernel/build/kernel/xv6.bin"
set fsimg "$build/fs.img"
set stamp [clock format [clock seconds] -gmt 1 -format "%Y%m%dT%H%M%SZ"]
set outdir "$build/r9-cursor-visible-probe-history/$stamp"
if {[info exists env(R9_CURSOR_VISIBLE_OUTDIR)] && $env(R9_CURSOR_VISIBLE_OUTDIR) ne ""} {
    set outdir $env(R9_CURSOR_VISIBLE_OUTDIR)
} elseif {[info exists env(R9_CURSOR_PROBE_OUTDIR)] && $env(R9_CURSOR_PROBE_OUTDIR) ne ""} {
    set outdir $env(R9_CURSOR_PROBE_OUTDIR)
}

file mkdir $outdir

set runlog "$outdir/run.log"
set socket_dir [expr {[info exists env(R9_CURSOR_VISIBLE_SOCKET_DIR)] && $env(R9_CURSOR_VISIBLE_SOCKET_DIR) ne "" ? $env(R9_CURSOR_VISIBLE_SOCKET_DIR) : "/tmp"}]
set socket_tag "xv6-r9v-[pid]-$stamp"
set monitor "$socket_dir/$socket_tag-m"
set qmp_monitor "$socket_dir/$socket_tag-q"
set tmpimg "$outdir/r9-kde-plasma.fs.img"
set guest_sh "$outdir/guest-r9-run.sh"
set guest_bash "$outdir/guest-r9-run-bash.sh"
set startup_orig "$outdir/startup.orig"
set startup_new "$outdir/startup.r9"
set startup_verify "$outdir/startup.injected"
set r9_run_verify "$outdir/r9-run.injected"
set debugfs_cmds "$outdir/debugfs-setup.commands"
set debugfs_log "$outdir/debugfs-setup.log"
set qemu_dry_run_log "$outdir/qemu-dry-run.txt"
set monitor_log "$outdir/qemu-monitor-command.log"
set qmp_log "$outdir/qemu-qmp-command.log"
set status_log "$outdir/r9-probe.status"
set output_log "$outdir/r9-probe-output.log"
set cmdline_log "$outdir/r9-cmdline.txt"
set process_log "$outdir/r9-process-probe.log"
set r9_lines "$outdir/r9-lines.txt"
set cursor_trace_log "$outdir/r9-cursor-trace.txt"
set visible_evidence_log "$outdir/r9-visible-evidence.txt"
set summary_log "$outdir/STATUS.txt"

proc env_bool {name default} {
    if {![info exists ::env($name)]} {
        return $default
    }
    set value [string tolower $::env($name)]
    if {$value eq "1" || $value eq "true" || $value eq "yes" ||
        $value eq "on"} {
        return 1
    }
    if {$value eq "0" || $value eq "false" || $value eq "no" ||
        $value eq "off" || $value eq ""} {
        return 0
    }
    return $default
}

proc env_int {name default} {
    if {![info exists ::env($name)] || $::env($name) eq ""} {
        return $default
    }
    if {[string is integer -strict $::env($name)] && $::env($name) > 0} {
        return $::env($name)
    }
    return $default
}

proc write_text_file {path text} {
    set fh [open $path w]
    puts -nonewline $fh $text
    close $fh
}

proc append_text_file {path text} {
    set fh [open $path a]
    puts -nonewline $fh $text
    close $fh
}

proc read_text_file {path} {
    set fh [open $path r]
    set text [read $fh]
    close $fh
    return $text
}

proc artifact_note {text} {
    global summary_log
    append_text_file $summary_log "$text\n"
}

proc setup_fail {code reason {detail ""}} {
    global outdir summary_log debugfs_cmds debugfs_log startup_new

    set detail [string map {\n { } \r { }} $detail]
    artifact_note "label=R9-CURSOR-VISIBLE-SETUP-FAIL"
    artifact_note "result=FAIL"
    artifact_note "reason=$reason"
    if {$detail ne ""} {
        artifact_note "detail=$detail"
    }
    artifact_note "outdir=$outdir"
    artifact_note "debugfs_commands=$debugfs_cmds"
    artifact_note "debugfs_log=$debugfs_log"
    artifact_note "startup=$startup_new"
    puts "\nR9-CURSOR-VISIBLE-SETUP-FAIL reason=$reason outdir=$outdir status=$summary_log"
    exit $code
}

proc debugfs_dump_file {image guest host} {
    catch { file delete -force $host }
    set rc [catch {
        exec debugfs -R "dump $guest $host" $image >/dev/null 2>@1
    } err]
    if {$rc != 0 || ![file exists $host]} {
        return [list 0 $err]
    }
    return [list 1 ""]
}

proc debugfs_read_guest {image guest host} {
    set result [debugfs_dump_file $image $guest $host]
    if {![lindex $result 0]} {
        return ""
    }
    if {![file exists $host]} {
        return ""
    }
    return [read_text_file $host]
}

proc guest_root_r9_files {image} {
    set listing ""
    catch { set listing [exec debugfs -R "ls -p /" $image 2>@1] }
    set files {}
    foreach line [split $listing "\n"] {
        if {[regexp {^/[^/]*/[^/]*/[^/]*/[^/]*/([^/]*)/} $line -> name] &&
            [string match "r9-*" $name]} {
            lappend files "/$name"
        }
    }
    return [lsort -unique $files]
}

proc generate_guest_scripts {} {
    global guest_sh guest_bash

    write_text_file $guest_sh "/bin/bash /r9-run-bash.sh\n"

    set fh [open $guest_bash w]
    puts $fh {#!/bin/bash}
    puts $fh {set +e}
    puts $fh {}
    puts $fh {STATUS=/r9-probe.status}
    puts $fh {STATUS_TMP=/r9-probe.status.tmp}
    puts $fh {OUTPUT=/r9-probe-output.log}
    puts $fh {PROCESS_LOG=/r9-process-probe.log}
    puts $fh {CMDLINE=/r9-cmdline.txt}
    puts $fh {export LD_LIBRARY_PATH=/opt/xv6-kde-abi-libs:/usr/lib/x86_64-linux-gnu:/lib/x86_64-linux-gnu:/usr/lib:/lib}
    puts $fh {}
    puts $fh "write_status() {"
    puts $fh {    echo "$*" > "$STATUS_TMP"}
    puts $fh {    /bin/mv "$STATUS_TMP" "$STATUS"}
    puts $fh {    /bin/sync}
    puts $fh "}"
    puts $fh {}
    puts $fh {/bin/rm -f "$STATUS" "$STATUS_TMP" "$OUTPUT" "$PROCESS_LOG" "$CMDLINE"}
    puts $fh {cat /proc/cmdline > "$CMDLINE" 2>/dev/null}
    puts $fh {write_status "phase=waiting armed=0 process_wait_seconds=0"}
    puts $fh {}
    puts $fh {ready=0}
    puts $fh {i=0}
    puts $fh {while [ "$i" -lt 120 ]; do}
    puts $fh {    /bin/kde-process-probe > "$PROCESS_LOG" 2>&1}
    puts $fh {    if /bin/grep 'status=PASS' "$PROCESS_LOG" >/dev/null 2>&1; then}
    puts $fh {        ready=1}
    puts $fh {        break}
    puts $fh {    fi}
    puts $fh {    /bin/sleep 1}
    puts $fh {    i=$((i + 1))}
    puts $fh {    write_status "phase=waiting armed=0 process_wait_seconds=$i"}
    puts $fh {done}
    puts $fh {}
    puts $fh {if [ "$ready" -ne 1 ]; then}
    puts $fh {    write_status "phase=process-timeout armed=0 exit_status=124 process_wait_seconds=$i"}
    puts $fh {    exit 124}
    puts $fh {fi}
    puts $fh {}
    puts $fh {/bin/kde-libinput-probe --r9-cursor-contract --width 1280 --height 800 --timeout-ms 20000 > "$OUTPUT" 2>&1 &}
    puts $fh {child=$!}
    puts $fh {/bin/sleep 2}
    puts $fh {if kill -0 "$child" >/dev/null 2>&1; then}
    puts $fh {    write_status "phase=armed armed=1 pid=$child process_wait_seconds=$i"}
    puts $fh {else}
    puts $fh {    wait "$child"}
    puts $fh {    rc=$?}
    puts $fh {    write_status "phase=done armed=0 pid=$child exit_status=$rc process_wait_seconds=$i reason=child-exited-before-arm"}
    puts $fh {    exit "$rc"}
    puts $fh {fi}
    puts $fh {}
    puts $fh {wait "$child"}
    puts $fh {rc=$?}
    puts $fh {if [ "$rc" -ne 0 ]; then}
    puts $fh {    write_status "phase=done armed=1 pid=$child exit_status=$rc process_wait_seconds=$i reason=coordinate-probe-failed"}
    puts $fh {    /bin/sync}
    puts $fh {    exit "$rc"}
    puts $fh {fi}
    puts $fh {}
    puts $fh {write_status "phase=cursor-visible armed=0 pid=$child coordinate_exit_status=$rc process_wait_seconds=$i"}
    puts $fh {cursor_rc=0}
    puts $fh {echo "r9_visible_mouseinject_begin points=0,0:32768,32768:65535,65535" >> "$OUTPUT"}
    puts $fh {echo "r9_visible_mouseinject_point label=origin x_abs=0 y_abs=0 expected_x=0 expected_y=0" >> "$OUTPUT"}
    puts $fh {/bin/mouseinject 0 0 0 >> "$OUTPUT" 2>&1 || cursor_rc=$?}
    puts $fh {/bin/sleep 1}
    puts $fh {echo "r9_visible_mouseinject_point label=center x_abs=32768 y_abs=32768 expected_x=640 expected_y=400" >> "$OUTPUT"}
    puts $fh {/bin/mouseinject 32768 32768 0 >> "$OUTPUT" 2>&1 || cursor_rc=$?}
    puts $fh {/bin/sleep 1}
    puts $fh {echo "r9_visible_mouseinject_point label=bottom_right x_abs=65535 y_abs=65535 expected_x=1279 expected_y=799" >> "$OUTPUT"}
    puts $fh {/bin/mouseinject 65535 65535 0 >> "$OUTPUT" 2>&1 || cursor_rc=$?}
    puts $fh {/bin/sleep 1}
    puts $fh {echo "r9_visible_mouseinject_end rc=$cursor_rc" >> "$OUTPUT"}
    puts $fh {if [ "$cursor_rc" -ne 0 ]; then}
    puts $fh {    write_status "phase=done armed=1 pid=$child exit_status=$cursor_rc coordinate_exit_status=$rc process_wait_seconds=$i reason=mouseinject-visible-cursor-failed"}
    puts $fh {    /bin/sync}
    puts $fh {    exit "$cursor_rc"}
    puts $fh {fi}
    puts $fh {write_status "phase=done armed=1 pid=$child exit_status=0 coordinate_exit_status=$rc visible_cursor=1 process_wait_seconds=$i"}
    puts $fh {/bin/sync}
    puts $fh {exit 0}
    close $fh
}

proc inject_guest_setup {} {
    global tmpimg guest_sh guest_bash startup_orig startup_new startup_verify
    global r9_run_verify debugfs_cmds debugfs_log

    artifact_note "phase=setup-read-startup"

    set startup_text ""
    set dump [debugfs_dump_file $tmpimg "/etc/startup" $startup_orig]
    if {[lindex $dump 0]} {
        set startup_text [read_text_file $startup_orig]
    }
    set filtered {}
    foreach line [split $startup_text "\n"] {
        if {[string trim $line] eq "/bin/sh /r9-run.sh"} {
            continue
        }
        lappend filtered $line
    }
    set startup_text [join $filtered "\n"]
    set startup_text [string trimright $startup_text "\n"]
    if {$startup_text ne ""} {
        append startup_text "\n"
    }
    append startup_text "/bin/sh /r9-run.sh\n"
    if {[string length $startup_text] >= 1023} {
        error "/etc/startup would exceed init's 1023-byte read limit after R9 append"
    }
    write_text_file $startup_new $startup_text

    set fh [open $debugfs_cmds w]
    foreach path [guest_root_r9_files $tmpimg] {
        puts $fh "rm $path"
    }
    puts $fh "rm /etc/startup"
    puts $fh "write $guest_sh /r9-run.sh"
    puts $fh "write $guest_bash /r9-run-bash.sh"
    puts $fh "write $startup_new /etc/startup"
    puts $fh "stat /r9-run.sh"
    puts $fh "stat /r9-run-bash.sh"
    puts $fh "stat /etc/startup"
    close $fh

    set setup_timeout [env_int R9_CURSOR_SETUP_TIMEOUT_SECONDS 45]
    artifact_note "phase=debugfs-inject"
    artifact_note "debugfs_timeout_seconds=$setup_timeout"
    set log_fh [open $debugfs_log w]
    set rc [catch {
        exec timeout $setup_timeout debugfs -w -f $debugfs_cmds $tmpimg >@ $log_fh 2>@ $log_fh
    } err]
    close $log_fh
    if {$rc != 0} {
        setup_fail 11 "debugfs-inject-failed" $err
    }

    artifact_note "phase=verify-injection"
    if {![lindex [debugfs_dump_file $tmpimg "/r9-run.sh" $r9_run_verify] 0]} {
        setup_fail 12 "missing-r9-run-after-inject"
    }
    if {![lindex [debugfs_dump_file $tmpimg "/etc/startup" $startup_verify] 0]} {
        setup_fail 12 "missing-startup-after-inject"
    }
    set injected_run [read_text_file $r9_run_verify]
    set injected_startup [read_text_file $startup_verify]
    if {$injected_run ne [read_text_file $guest_sh]} {
        setup_fail 12 "r9-run-content-mismatch"
    }
    if {![regexp {(?m)^/bin/sh /r9-run\.sh$} $injected_startup]} {
        setup_fail 12 "startup-missing-r9-entry"
    }
    artifact_note "phase=setup-complete"
}

proc configure_qemu_env {} {
    global monitor qmp_monitor

    set ::env(DISPLAY_MODE) "gtk"
    if {![info exists ::env(USE_KVM)]} {
        set ::env(USE_KVM) "1"
    }
    if {![info exists ::env(QEMU_GPU)]} {
        set ::env(QEMU_GPU) "virtio-vga-gl-primary"
    }
    set ::env(QEMU_INPUT) "virtio"
    set ::env(QEMU_NET) "0"
    set ::env(QEMU_AUDIO) "none"
    if {![info exists ::env(QEMU_GTK_CURSOR_MODE)] ||
        $::env(QEMU_GTK_CURSOR_MODE) eq ""} {
        set ::env(QEMU_GTK_CURSOR_MODE) "guest"
    }
    if {$::env(QEMU_GTK_CURSOR_MODE) ne "guest"} {
        setup_fail 14 "requires-guest-cursor-mode" \
            "QEMU_GTK_CURSOR_MODE=$::env(QEMU_GTK_CURSOR_MODE)"
    }
    set ::env(QEMU_VIRTIO_GPU_XRES) "1280"
    set ::env(QEMU_VIRTIO_GPU_YRES) "800"
    set qemu_append "root=/dev/disk0 video=1280x800 netsurf=0 webkit=0 glsmoke=0 r9_cursor_visible_probe=1"
    if {[info exists ::env(QEMU_APPEND_EXTRA)] &&
        $::env(QEMU_APPEND_EXTRA) ne ""} {
        append qemu_append " " $::env(QEMU_APPEND_EXTRA)
    }
    foreach {key value} {
        virtio_gpu_cursor_trace 1
        virtio_gpu_injected_cursor_trace 1
        mouseinject_cursor 1
    } {
        if {![regexp "(^| )$key=" $qemu_append]} {
            append qemu_append " $key=$value"
        }
    }
    set ::env(QEMU_APPEND) $qemu_append

    set extra "-monitor unix:$monitor,server,nowait -qmp unix:$qmp_monitor,server,nowait"
    if {[info exists ::env(R9_CURSOR_VISIBLE_QEMU_EXTRA)] &&
        $::env(R9_CURSOR_VISIBLE_QEMU_EXTRA) ne ""} {
        append extra " " $::env(R9_CURSOR_VISIBLE_QEMU_EXTRA)
    } elseif {[info exists ::env(QEMU_EXTRA)] && $::env(QEMU_EXTRA) ne ""} {
        append extra " " $::env(QEMU_EXTRA)
    }
    set ::env(QEMU_EXTRA) $extra
}

proc run_qemu_dry_run {} {
    global root kernel tmpimg qemu_dry_run_log

    set old_dry ""
    set had_old [info exists ::env(QEMU_DRY_RUN)]
    if {$had_old} {
        set old_dry $::env(QEMU_DRY_RUN)
    }
    set ::env(QEMU_DRY_RUN) "1"
    set rc [catch {
        exec bash "$root/scripts/launch/run-qemu.sh" x86_64 $kernel $tmpimg 2>@1
    } out]
    if {$had_old} {
        set ::env(QEMU_DRY_RUN) $old_dry
    } else {
        unset ::env(QEMU_DRY_RUN)
    }
    write_text_file $qemu_dry_run_log "$out\n"
    if {$rc != 0} {
        error "QEMU dry run failed: $out"
    }
}

proc monitor_command_output {cmd {timeout_sec 4}} {
    global monitor monitor_log outdir

    set cmd_path "$outdir/qemu-monitor-command-[pid]-[clock microseconds].txt"
    write_text_file $cmd_path "$cmd\n"
    set rc [catch {
        exec nc -U -w $timeout_sec -q 0 $monitor < $cmd_path 2>@1
    } out]
    catch { file delete -force $cmd_path }
    append_text_file $monitor_log "cmd=$cmd\nrc=$rc\n$out\n"
    return [list $rc $out]
}

proc monitor_command {cmd {timeout_sec 4}} {
    set result [monitor_command_output $cmd $timeout_sec]
    set rc [lindex $result 0]
    if {$rc != 0} {
        return 0
    }
    return 1
}

proc qmp_command {json {timeout_sec 4}} {
    global qmp_monitor qmp_log outdir

    set cmd_path "$outdir/qemu-qmp-command-[pid]-[clock microseconds].json"
    write_text_file $cmd_path "{\"execute\":\"qmp_capabilities\"}\n$json\n"
    set rc [catch {
        exec nc -U -w $timeout_sec -q 0 $qmp_monitor < $cmd_path 2>@1
    } out]
    catch { file delete -force $cmd_path }
    append_text_file $qmp_log "cmd=$json\nrc=$rc\n$out\n"
    if {$rc != 0} {
        return 0
    }
    if {[regexp {\"error\"} $out]} {
        return 0
    }
    if {![regexp {\"return\"} $out]} {
        return 0
    }
    return 1
}

proc poll_status {} {
    global tmpimg outdir
    set poll_path "$outdir/r9-probe.status.poll"
    return [debugfs_read_guest $tmpimg "/r9-probe.status" $poll_path]
}

proc extract_artifacts {} {
    global tmpimg status_log output_log cmdline_log process_log r9_lines

    set status_ok [lindex [debugfs_dump_file $tmpimg "/r9-probe.status" $status_log] 0]
    set output_ok [lindex [debugfs_dump_file $tmpimg "/r9-probe-output.log" $output_log] 0]
    catch { debugfs_dump_file $tmpimg "/r9-cmdline.txt" $cmdline_log }
    catch { debugfs_dump_file $tmpimg "/r9-process-probe.log" $process_log }

    set lines ""
    if {$output_ok && [file exists $output_log]} {
        foreach line [split [read_text_file $output_log] "\n"] {
            if {[string first "r9_" $line] >= 0} {
                append lines [string trimright $line "\r"] "\n"
            }
        }
    }
    write_text_file $r9_lines $lines
    return [list $status_ok $output_ok]
}

proc write_visible_evidence {status_text output_text} {
    global runlog cmdline_log qemu_dry_run_log qmp_log monitor_log
    global cursor_trace_log visible_evidence_log

    set failures {}
    set run_text ""
    set cmdline_text ""
    set dry_text ""
    set qmp_text ""
    set monitor_text ""

    if {[file exists $runlog]} {
        set run_text [read_text_file $runlog]
    }
    if {[file exists $cmdline_log]} {
        set cmdline_text [read_text_file $cmdline_log]
    }
    if {[file exists $qemu_dry_run_log]} {
        set dry_text [read_text_file $qemu_dry_run_log]
    }
    if {[file exists $qmp_log]} {
        set qmp_text [read_text_file $qmp_log]
    }
    if {[file exists $monitor_log]} {
        set monitor_text [read_text_file $monitor_log]
    }
    set cmdline_flat [string map {\n { } \r { } \t { }} $cmdline_text]

    set trace_lines ""
    set injected_count 0
    set origin_seen 0
    set center_seen 0
    set edge_seen 0
    set out_of_range 0
    foreach line [split $run_text "\n"] {
        if {[regexp {virtio_gpu: (injected cursor|cursor upload|host-cursor-only suppress cursor)} $line]} {
            append trace_lines [string trimright $line "\r"] "\n"
        }
        if {[regexp {virtio_gpu: injected cursor x_abs=([0-9]+) y_abs=([0-9]+) x=([0-9]+) y=([0-9]+) } $line -> x_abs y_abs x y]} {
            incr injected_count
            if {$x > 1279 || $y > 799} {
                set out_of_range 1
            }
            if {$x_abs == 0 && $y_abs == 0 && $x == 0 && $y == 0} {
                set origin_seen 1
            }
            if {$x_abs == 32768 && $y_abs == 32768 && $x == 640 && $y == 400} {
                set center_seen 1
            }
            if {$x_abs == 65535 && $y_abs == 65535 && $x == 1279 && $y == 799} {
                set edge_seen 1
            }
        }
    }
    write_text_file $cursor_trace_log $trace_lines

    if {![regexp {show-cursor=off} $dry_text]} {
        lappend failures "guest-cursor-mode-dry-run-missing-show-cursor-off"
    }
    if {[regexp {virtio_gpu_host_cursor_only=1} $dry_text] ||
        [regexp {virtio_gpu_host_cursor_only=1} $cmdline_flat]} {
        lappend failures "host-cursor-only-present"
    }
    foreach token {
        virtio_gpu_cursor_trace=1
        virtio_gpu_injected_cursor_trace=1
        mouseinject_cursor=1
    } {
        set token_pattern [format {(^| )%s( |$)} $token]
        if {![regexp -- $token_pattern $cmdline_flat]} {
            lappend failures "cmdline-missing-$token"
        }
    }
    if {![regexp {r9_mouse_sample[^\n]*flags=1} $output_text]} {
        lappend failures "mouse-flags-absolute-missing"
    }
    if {![regexp {r9_summary[^\n]*evdev_abs_samples=([1-9][0-9]*)} $output_text]} {
        lappend failures "evdev-abs-samples-missing"
    }
    if {![regexp {r9_summary[^\n]*libinput_abs_samples=([1-9][0-9]*)} $output_text]} {
        lappend failures "libinput-abs-samples-missing"
    }
    if {![regexp {\"execute\":\"input-send-event\"} $qmp_text]} {
        lappend failures "qmp-input-send-event-missing"
    }
    if {$injected_count < 3} {
        lappend failures "cursor-injected-trace-count-$injected_count"
    }
    if {!$origin_seen} {
        lappend failures "cursor-origin-transform-missing"
    }
    if {!$center_seen} {
        lappend failures "cursor-center-transform-missing"
    }
    if {!$edge_seen} {
        lappend failures "cursor-edge-transform-missing"
    }
    if {$out_of_range} {
        lappend failures "cursor-transform-out-of-range"
    }
    if {![regexp {virtio_gpu: cursor upload visible} $run_text]} {
        lappend failures "cursor-upload-visible-missing"
    }
    if {[regexp -nocase {PANIC|panic:|fatal page fault|kernel trap|KERNEL PAGE FAULT|spin_lock reentry|Out of memory} $run_text]} {
        lappend failures "kernel-crash-marker"
    }
    if {[regexp -nocase {kwin_wayland[^\n]*(#GP|SIGSEGV|crash|coredump)|LibinputBackend[^\n]*(null|nullptr|SIGSEGV|#GP|crash)} $run_text]} {
        lappend failures "kwin-libinputbackend-crash-marker"
    }

    set fh [open $visible_evidence_log w]
    puts $fh "status=[string map {\n { } \r { }} $status_text]"
    puts $fh "qemu_dry_run=$qemu_dry_run_log"
    puts $fh "qmp_log=$qmp_log"
    puts $fh "monitor_log=$monitor_log"
    puts $fh "cursor_trace_log=$cursor_trace_log"
    puts $fh "cmdline=$cmdline_flat"
    puts $fh "guest_cursor_mode_dry_run_show_cursor_off=[expr {[regexp {show-cursor=off} $dry_text] ? 1 : 0}]"
    puts $fh "host_cursor_only_absent=[expr {![regexp {virtio_gpu_host_cursor_only=1} $dry_text] && ![regexp {virtio_gpu_host_cursor_only=1} $cmdline_flat] ? 1 : 0}]"
    puts $fh "qmp_input_send_event=[expr {[regexp {\"execute\":\"input-send-event\"} $qmp_text] ? 1 : 0}]"
    puts $fh "hmp_info_mice_absolute=[expr {[regexp {QEMU Virtio Tablet \(absolute\)} $monitor_text] ? 1 : 0}]"
    puts $fh "mouse_flags_absolute=[expr {[regexp {r9_mouse_sample[^\n]*flags=1} $output_text] ? 1 : 0}]"
    puts $fh "evdev_abs_samples_gt0=[expr {[regexp {r9_summary[^\n]*evdev_abs_samples=([1-9][0-9]*)} $output_text] ? 1 : 0}]"
    puts $fh "libinput_abs_samples_gt0=[expr {[regexp {r9_summary[^\n]*libinput_abs_samples=([1-9][0-9]*)} $output_text] ? 1 : 0}]"
    puts $fh "cursor_injected_trace_count=$injected_count"
    puts $fh "cursor_transform_origin=$origin_seen"
    puts $fh "cursor_transform_center=$center_seen"
    puts $fh "cursor_transform_bottom_right=$edge_seen"
    puts $fh "cursor_transform_out_of_range=$out_of_range"
    puts $fh "cursor_upload_visible=[expr {[regexp {virtio_gpu: cursor upload visible} $run_text] ? 1 : 0}]"
    puts $fh "capture_visibility=NOT_PROVEN"
    puts $fh "capture_reason=QEMU framebuffer captures do not prove the GTK hardware cursor overlay, and this headless harness has no deterministic host-window capture path; cursor visibility is therefore established by guest-cursor mode plus virtio cursor upload/move trace."
    if {[llength $failures] == 0} {
        puts $fh "result=PASS"
    } else {
        puts $fh "result=FAIL"
        puts $fh "failures=[join $failures ,]"
    }
    close $fh

    if {[llength $failures] == 0} {
        return ""
    }
    return [join $failures ","]
}

proc kill_qemu {} {
    global qemu_pid monitor qmp_monitor

    if {[info exists qemu_pid] && $qemu_pid ne ""} {
        catch { exec kill -TERM -- -$qemu_pid }
        catch { exec pkill -P $qemu_pid qemu-system-x86_64 }
        after 1000
        catch { exec kill -KILL -- -$qemu_pid }
        catch { wait }
    }
    catch { file delete -force $monitor $qmp_monitor }
}

proc finish {code label} {
    global runlog outdir summary_log status_log output_log r9_lines
    global cursor_trace_log visible_evidence_log

    kill_qemu
    set extracted [extract_artifacts]
    set status_ok [lindex $extracted 0]
    set output_ok [lindex $extracted 1]

    artifact_note "label=$label"
    artifact_note "exit_code=$code"
    artifact_note "outdir=$outdir"
    artifact_note "runlog=$runlog"
    artifact_note "status_dump=$status_ok"
    artifact_note "output_dump=$output_ok"

    if {$code == 0} {
        if {!$status_ok || !$output_ok} {
            artifact_note "result=FAIL reason=missing-final-artifacts"
            puts "\nR9-CURSOR-VISIBLE-FAIL missing-final-artifacts outdir=$outdir log=$runlog"
            exit 20
        }
        set status_text [read_text_file $status_log]
        set output_text [read_text_file $output_log]
        if {![regexp {phase=done} $status_text] ||
            ![regexp {exit_status=0} $status_text]} {
            artifact_note "result=FAIL reason=bad-final-status status=[string map {\n { } \r { }} $status_text]"
            puts "\nR9-CURSOR-VISIBLE-FAIL bad-final-status outdir=$outdir log=$runlog"
            exit 21
        }
        if {![regexp {r9_cursor_contract} $output_text] ||
            ![regexp {r9_summary[^\n]*result=PASS} $output_text]} {
            artifact_note "result=FAIL reason=missing-or-failed-r9-lines"
            puts "\nR9-CURSOR-VISIBLE-FAIL missing-or-failed-r9-lines outdir=$outdir log=$runlog r9_lines=$r9_lines"
            exit 22
        }
        set evidence_failure [write_visible_evidence $status_text $output_text]
        artifact_note "cursor_trace=$cursor_trace_log"
        artifact_note "visible_evidence=$visible_evidence_log"
        if {$evidence_failure ne ""} {
            artifact_note "result=FAIL reason=visible-evidence-failed failures=$evidence_failure"
            puts "\nR9-CURSOR-VISIBLE-FAIL visible-evidence-failed outdir=$outdir log=$runlog evidence=$visible_evidence_log"
            exit 23
        }
        artifact_note "result=PASS"
        puts "\nR9-CURSOR-VISIBLE-PASS outdir=$outdir log=$runlog r9_lines=$r9_lines evidence=$visible_evidence_log"
        exit 0
    }

    artifact_note "result=FAIL"
    puts "\n$label outdir=$outdir log=$runlog"
    exit $code
}

proc passive_serial_tick {} {
    global timeout

    set old_timeout $timeout
    set timeout 1
    expect {
        -re {PANIC|panic:|fatal page fault|spin_lock reentry|coredump: generating|kernel trap|Out of memory} {
            set timeout $old_timeout
            finish 4 "R9-CURSOR-VISIBLE-FAIL serial-crash-marker"
        }
        timeout {}
        eof {
            set timeout $old_timeout
            finish 5 "R9-CURSOR-VISIBLE-FAIL serial-eof"
        }
    }
    set timeout $old_timeout
}

proc wait_for_armed {} {
    set deadline [expr {[clock seconds] + [expr {[info exists ::env(R9_CURSOR_ARM_TIMEOUT_SECONDS)] ? $::env(R9_CURSOR_ARM_TIMEOUT_SECONDS) : 180}]}]

    while {[clock seconds] < $deadline} {
        passive_serial_tick
        set status [poll_status]
        if {[regexp {phase=armed[^\n]*armed=1[^\n]*pid=([0-9]+)} $status -> pid]} {
            artifact_note "armed_pid=$pid"
            return
        }
        if {[regexp {phase=done} $status]} {
            finish 6 "R9-CURSOR-VISIBLE-FAIL child-done-before-armed"
        }
        if {[regexp {phase=process-timeout} $status]} {
            finish 7 "R9-CURSOR-VISIBLE-FAIL process-probe-timeout"
        }
    }
    finish 8 "R9-CURSOR-VISIBLE-FAIL status-timeout-before-armed"
}

proc inject_mouse_moves {} {
    set moves {
        {0 0}
        {16384 16384}
        {32767 32767}
        {8192 24575}
        {24575 8192}
    }

    artifact_note "absolute_mouse_move_range=0..32767"
    select_absolute_mouse
    foreach move $moves {
        set x [lindex $move 0]
        set y [lindex $move 1]
        if {![qmp_absolute_move $x $y]} {
            finish 9 "R9-CURSOR-VISIBLE-FAIL qmp-absolute-move"
        }
        after 250
    }
}

proc qmp_absolute_move {x y} {
    set json "{\"execute\":\"input-send-event\",\"arguments\":{\"events\":\[{\"type\":\"abs\",\"data\":{\"axis\":\"x\",\"value\":$x}},{\"type\":\"abs\",\"data\":{\"axis\":\"y\",\"value\":$y}}\]}}"
    return [qmp_command $json]
}

proc select_absolute_mouse {} {
    set info_result [monitor_command_output "info mice"]
    set info_rc [lindex $info_result 0]
    set info_text [lindex $info_result 1]
    set mouse_index ""

    if {$info_rc != 0} {
        finish 9 "R9-CURSOR-VISIBLE-FAIL monitor-info-mice"
    }

    foreach line [split $info_text "\n"] {
        if {[regexp {Mouse #([0-9]+): .*\(absolute\)} $line -> index]} {
            set mouse_index $index
            break
        }
    }

    if {$mouse_index eq ""} {
        artifact_note "absolute_mouse_select=FAIL reason=no-absolute-mouse"
        finish 9 "R9-CURSOR-VISIBLE-FAIL monitor-no-absolute-mouse"
    }

    artifact_note "absolute_mouse_index=$mouse_index"
    if {![monitor_command "mouse_set $mouse_index"]} {
        finish 9 "R9-CURSOR-VISIBLE-FAIL monitor-mouse-set-absolute"
    }

    set verify_result [monitor_command_output "info mice"]
    set verify_rc [lindex $verify_result 0]
    set verify_text [lindex $verify_result 1]
    set active_absolute 0

    if {$verify_rc != 0} {
        finish 9 "R9-CURSOR-VISIBLE-FAIL monitor-info-mice-after-set"
    }
    foreach line [split $verify_text "\n"] {
        if {[regexp "\\* Mouse #$mouse_index: .*\\(absolute\\)" $line]} {
            set active_absolute 1
            break
        }
    }
    if {!$active_absolute} {
        artifact_note "absolute_mouse_select=FAIL reason=active-verify-failed index=$mouse_index"
        finish 9 "R9-CURSOR-VISIBLE-FAIL monitor-absolute-mouse-not-active"
    }
    artifact_note "absolute_mouse_select=PASS index=$mouse_index"
}

proc wait_for_done {} {
    set deadline [expr {[clock seconds] + [expr {[info exists ::env(R9_CURSOR_DONE_TIMEOUT_SECONDS)] ? $::env(R9_CURSOR_DONE_TIMEOUT_SECONDS) : 90}]}]

    while {[clock seconds] < $deadline} {
        passive_serial_tick
        set status [poll_status]
        if {[regexp {phase=done} $status]} {
            finish 0 "R9-CURSOR-VISIBLE-PASS"
        }
        if {[regexp {phase=process-timeout} $status]} {
            finish 7 "R9-CURSOR-VISIBLE-FAIL process-probe-timeout"
        }
    }
    finish 10 "R9-CURSOR-VISIBLE-FAIL status-timeout-before-done"
}

if {![file exists $kernel]} {
    puts "R9-CURSOR-VISIBLE-FAIL missing-kernel path=$kernel"
    exit 2
}
if {![file exists $fsimg]} {
    puts "R9-CURSOR-VISIBLE-FAIL missing-fsimg path=$fsimg"
    exit 2
}

catch { file delete -force $monitor $qmp_monitor $runlog $qemu_dry_run_log $monitor_log $qmp_log }
catch { file delete -force $debugfs_cmds $debugfs_log $startup_verify $r9_run_verify }
catch { file delete -force $status_log $output_log $cmdline_log $process_log $r9_lines $cursor_trace_log $visible_evidence_log $summary_log }

artifact_note "phase=copy-image"
if {[catch { exec cp $fsimg $tmpimg } err]} {
    setup_fail 10 "copy-image-failed" $err
}

artifact_note "phase=generate-guest-scripts"
if {[catch { generate_guest_scripts } err]} {
    setup_fail 10 "generate-guest-scripts-failed" $err
}

if {[catch { inject_guest_setup } err]} {
    setup_fail 11 "setup-exception" $err
}
configure_qemu_env

set dry_run [expr {[env_bool R9_CURSOR_VISIBLE_DRY_RUN 0] ||
                   [env_bool R9_CURSOR_PROBE_DRY_RUN 0] ||
                   [env_bool QEMU_DRY_RUN 0]}]
if {[catch { run_qemu_dry_run } err]} {
    artifact_note "label=R9-CURSOR-VISIBLE-DRY-RUN-FAIL"
    artifact_note "result=FAIL"
    artifact_note "reason=qemu-dry-run-failed"
    artifact_note "detail=[string map {\n { } \r { }} $err]"
    artifact_note "outdir=$outdir"
    artifact_note "qemu_dry_run=$qemu_dry_run_log"
    puts "\nR9-CURSOR-VISIBLE-DRY-RUN-FAIL outdir=$outdir qemu_dry_run=$qemu_dry_run_log"
    exit 13
}
artifact_note "qemu_dry_run=$qemu_dry_run_log"
if {$dry_run} {
    artifact_note "label=R9-CURSOR-VISIBLE-DRY-RUN-PASS"
    artifact_note "result=PASS"
    artifact_note "outdir=$outdir"
    artifact_note "tmpimg=$tmpimg"
    artifact_note "qemu_dry_run=$qemu_dry_run_log"
    puts "\nR9-CURSOR-VISIBLE-DRY-RUN-PASS outdir=$outdir image=$tmpimg qemu_dry_run=$qemu_dry_run_log"
    exit 0
}

log_file -a $runlog
spawn timeout --foreground $timeout bash "$root/scripts/launch/run-qemu.sh" x86_64 $kernel $tmpimg
set qemu_pid [exp_pid]

wait_for_armed
inject_mouse_moves
wait_for_done
