+namespace base::trace_event {
+namespace {
+// One exported implementation gives all component DSOs a common process-local
+// ID allocator. Allocation happens once per object, not per traced event.
+std::atomic<uint64_t> g_video_bottleneck_instance{0};
+}  // namespace
+
+VideoBottleneckRecorder::VideoBottleneckRecorder(const char* object, bool stream)
+    : object_(object),
+      instance_id_(g_video_bottleneck_instance.fetch_add(
+                       1, std::memory_order_relaxed) + 1) {
