@@ -0,0 +1,140 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef BASE_TRACE_EVENT_VIDEO_BOTTLENECK_DIAGNOSTICS_H_
+#define BASE_TRACE_EVENT_VIDEO_BOTTLENECK_DIAGNOSTICS_H_
+
+#include <stdint.h>
+
+#include <memory>
+#include <utility>
+
+#include "base/base_export.h"
+#include "base/memory/raw_ref.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/trace_event/trace_event.h"
+#include "base/trace_event/traced_value.h"
+
+namespace base::trace_event {
+
+// Scalar-only diagnostic records. Integer strings preserve full 64-bit IDs in
+// JSON consumers. No resource arrays, payload copies or unbounded side maps.
+class VideoBottleneckFields {
+ public:
+  explicit VideoBottleneckFields(TracedValue& value) : value_(value) {}
+  template <typename T>
+  void I(const char* name, T value) {
+    value_->SetString(name, base::NumberToString(value));
+  }
+  void B(const char* name, bool value) { value_->SetBoolean(name, value); }
+  void S(const char* name, const char* value) { value_->SetString(name, value); }
+  void P(const char* name, const void* value) {
+    I(name, reinterpret_cast<uintptr_t>(value));
+  }
+
+ private:
+  raw_ref<TracedValue> value_;
+};
+
+class BASE_EXPORT VideoBottleneckRecorder {
+ public:
+  explicit VideoBottleneckRecorder(const char* object, bool stream = false);
+  VideoBottleneckRecorder(const VideoBottleneckRecorder&) = delete;
+  VideoBottleneckRecorder& operator=(const VideoBottleneckRecorder&) = delete;
+
+  template <typename Fill>
+  void Record(const char* kind, Fill&& fill) {
+    // Advance even while disabled, so category toggles cannot silently bridge
+    // missing history. Instances are sequence-confined; construction may occur
+    // before ownership is transferred to the eventual sequence.
+    const uint64_t seq = ++event_seq_;
+    bool enabled = false;
+    TRACE_EVENT_CATEGORY_GROUP_ENABLED(
+        "disabled-by-default-media.bottleneck", &enabled);
+    if (!enabled)
+      return;
+    const auto timestamp = TRACE_TIME_TICKS_NOW();
+    // Gate before allocation, formatting, or evaluating any payload lambda.
+    auto value = std::make_unique<TracedValue>();
+    value->SetInteger("schema_version", 1);
+    {
+      VideoBottleneckFields fields(*value);
+      fields.S("kind", kind);
+      fields.S("object", object_);
+      fields.I("instance_id", instance_id_);
+      fields.I("event_seq", seq);
+      std::forward<Fill>(fill)(fields);
+    }
+    TRACE_EVENT_INSTANT("disabled-by-default-media.bottleneck",
+                       "VideoBottleneck", timestamp, "bt", std::move(value));
+  }
+
+ private:
+  const char* const object_;
+  const uint64_t instance_id_;
+  uint64_t event_seq_ = 0;
+};
+
+template <typename Id>
+void VideoBottleneckBundle(VideoBottleneckFields& d, const Id& id) {
+  d.I("bundle_client_id", id.client_id());
+  d.I("bundle_id", id.bundle_id());
+}
+
+inline void VideoBottleneckSink(VideoBottleneckFields& d,
+                                uint32_t client_id,
+                                uint32_t sink_id) {
+  d.I("sink_client_id", client_id);
+  d.I("sink_id", sink_id);
+}
+
+// Scalar membership records describe the three protocol arrays in their own
+// order. batch_id is local observation identity, never an added wire field.
+// The original Mojo call must remain between the matching enter/exit records.
+template <typename Id, typename Acks, typename Begins, typename Reclaims>
+void VideoBottleneckSendBegin(VideoBottleneckRecorder& recorder,
+                             uint64_t batch_id,
+                             const Id& id,
+                             const Acks& acks,
+                             const Begins& begins,
+                             const Reclaims& reclaims) {
+  recorder.Record("bundle.send.enter", [&](auto& d) {
+    VideoBottleneckBundle(d, id);
+    d.I("batch_id", batch_id);
+    d.I("ack_count", acks.size());
+    d.I("begin_frame_count", begins.size());
+    d.I("reclaim_count", reclaims.size());
+  });
+  auto entries = [&](const auto& list, const char* kind) {
+    uint64_t index = 0;
+    for (const auto& entry : list) {
+      recorder.Record("bundle.send.entry", [&](auto& d) {
+        VideoBottleneckBundle(d, id);
+        VideoBottleneckSink(d, id.client_id(), entry->sink_id);
+        d.I("batch_id", batch_id);
+        d.S("entry_kind", kind);
+        d.I("entry_index", index);
+        d.I("resource_count", entry->resources.size());
+      });
+      ++index;
+    }
+  };
+  entries(acks, "ack");
+  entries(reclaims, "reclaim");
+  entries(begins, "begin_frame");
+}
+
+template <typename Id>
+void VideoBottleneckSendEnd(VideoBottleneckRecorder& recorder,
+                           uint64_t batch_id,
+                           const Id& id) {
+  recorder.Record("bundle.send.exit", [&](auto& d) {
+    VideoBottleneckBundle(d, id);
+    d.I("batch_id", batch_id);
+  });
+}
+
+}  // namespace base::trace_event
+
+#endif  // BASE_TRACE_EVENT_VIDEO_BOTTLENECK_DIAGNOSTICS_H_
