+  auto bt_emit = [&](const char* route) {
+    bt_.Record("service.ack.emit", [&](auto& d) {
+      TraceBottleneckState(d);
+      d.I("callback_id", bt_callback);
+      d.I("pending_before", bt_pending_before);
+      d.I("pending_after", pending_frames_);
+      d.I("resource_count", surface_returned_resources_.size());
+      d.S("route", route);
+    });
+  };
+  auto bt_done = [&] {
+    bt_.Record("service.ack.done", [&](auto& d) {
+      TraceBottleneckState(d);
+      d.I("callback_id", bt_callback);
+    });
+  };
 
   if (!client_) {
+    bt_emit("no_client");
+    bt_done();
     return;
   }
 
