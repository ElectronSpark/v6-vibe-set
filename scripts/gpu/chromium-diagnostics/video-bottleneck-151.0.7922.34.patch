+void VideoFrameSubmitter::TraceBottleneckState(
+    base::trace_event::VideoBottleneckFields& d) const {
+  d.I("reset_epoch", bt_epoch_);
+  d.I("binding_epoch", bt_binding_epoch_);
+  d.I("pending_ack", waiting_for_compositor_ack_);
+  d.B("sink_valid", frame_sink_id_.is_valid());
+  base::trace_event::VideoBottleneckSink(
+      d, frame_sink_id_.client_id(), frame_sink_id_.sink_id());
+  d.B("sink_bound", !!compositor_frame_sink_);
+  d.P("client_address",
+      static_cast<const viz::mojom::blink::CompositorFrameSinkClient*>(this));
+  d.B("bundle_valid", !!bundle_proxy_);
+  d.B("bundle_alive",
+      bundle_proxy_ && bundle_proxy_->diagnostic_bundle_alive());
+  if (bundle_proxy_) {
+    base::trace_event::VideoBottleneckBundle(
+        d, bundle_proxy_->diagnostic_bundle_id());
+  } else {
+    d.I("bundle_client_id", 0);
+    d.I("bundle_id", 0);
+  }
+  d.B("surface_visible", is_surface_visible_);
+  d.B("page_visible", is_page_visible_);
+  d.B("force_submit", force_submit_);
+  d.B("force_begin_frames", force_begin_frames_);
+  d.B("is_rendering", is_rendering_);
+  d.B("last_frame_id_valid", last_frame_id_.has_value());
+  d.I("last_frame_id", last_frame_id_ ? last_frame_id_->GetUnsafeValue() : 0);
+  d.I("current_width", frame_size_.width());
+  d.I("current_height", frame_size_.height());
+  d.I("default_rotation", static_cast<int>(transform_.rotation));
+  d.B("default_mirrored", transform_.mirrored);
+}
+
+void VideoFrameSubmitter::TraceBottleneckLifecycle(const char* kind,
+                                                   const char* cause) {
+  bt_.Record(kind, [&](auto& d) {
+    TraceBottleneckState(d);
+    d.S("cause", cause);
+  });
+}
