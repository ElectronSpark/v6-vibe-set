#!/usr/bin/env expect

set timeout 230
set root [exec sh -c "cd [file dirname [info script]]/../.. && pwd"]
set build "$root/build-x86_64"
set kernel "$build/kernel/build/kernel/xv6.bin"
set fsimg "$build/fs.img"
set outdir "$build/host-python-repl-proof"
exec mkdir -p $outdir
set runlog "$outdir/run.log"
set tmpimg "$outdir/host-python-repl.fs.img"
set app_log "/tmp/host-gui-host-python-repl.log"

set guest_before "/host-python-repl-before.ppm"
set guest_launch "/host-python-repl-launch.ppm"
set guest_input "/host-python-repl-input.ppm"
set guest_exit "/host-python-repl-exit.ppm"
set host_before "$outdir/host-python-repl-before.ppm"
set host_launch "$outdir/host-python-repl-launch.ppm"
set host_input "$outdir/host-python-repl-input.ppm"
set host_exit "$outdir/host-python-repl-exit.ppm"
set png_before "$outdir/host-python-repl-before.png"
set png_launch "$outdir/host-python-repl-launch.png"
set png_input "$outdir/host-python-repl-input.png"
set png_exit "$outdir/host-python-repl-exit.png"
set diff_launch "$outdir/host-python-repl-launch-diff.png"
set diff_input "$outdir/host-python-repl-input-diff.png"
set diff_exit "$outdir/host-python-repl-exit-diff.png"
set diff_launch_txt "$outdir/diff-launch-ae.txt"
set diff_input_txt "$outdir/diff-input-ae.txt"
set diff_exit_txt "$outdir/diff-exit-ae.txt"

exec sh -c "rm -f '$runlog' '$tmpimg' '$host_before' '$host_launch' '$host_input' '$host_exit' '$png_before' '$png_launch' '$png_input' '$png_exit' '$diff_launch' '$diff_input' '$diff_exit' '$diff_launch_txt' '$diff_input_txt' '$diff_exit_txt'"
exec cp $fsimg $tmpimg
foreach guest [list $guest_before $guest_launch $guest_input $guest_exit] {
    catch { exec sh -c "debugfs -w -R 'rm $guest' '$tmpimg' >/dev/null 2>&1" }
}

set env(DISPLAY_MODE)          "gtk"
set env(USE_KVM)               "1"
set env(QEMU_GPU)              "virtio-vga-gl-primary"
set env(QEMU_INPUT)            "virtio"
set env(QEMU_NET)              "0"
set env(QEMU_ALLOW_WSL_SDL_GL) "1"
set env(QEMU_VIRTIO_GPU_XRES)  "1280"
set env(QEMU_VIRTIO_GPU_YRES)  "800"
set env(QEMU_APPEND) "root=/dev/disk0 weston=1 video=1280x800 netsurf=0 webkit=0"
set send_slow {1 .01}

proc fail {code label} {
    global qemu_pid runlog

    catch { exec pkill -P $qemu_pid qemu-system-x86_64 }
    puts "\n$label log=$runlog"
    exit $code
}

proc optional_prompt {} {
    global timeout

    set old_timeout $timeout
    set timeout 2
    expect {
        -re {root:/#} {}
        timeout {}
        eof {}
    }
    set timeout $old_timeout
}

proc capture_fb {guest marker label} {
    send "fbstat ppm-current $guest 0 0 1280 800; sync; echo $marker\r"
    expect {
        -re "fb_ppm_current path=$guest screen=1280x800 scanout=1280x800" {}
        -re {fbstat: [^\r\n]+} { fail 20 "$label fbstat-error" }
        timeout { fail 20 "$label fbstat-timeout" }
        eof { fail 20 "$label fbstat-eof" }
    }
    expect {
        -re $marker {}
        timeout { fail 21 "$label marker-timeout" }
        eof { fail 21 "$label marker-eof" }
    }
    optional_prompt
}

proc extract_artifacts {} {
    global tmpimg guest_before guest_launch guest_input guest_exit
    global host_before host_launch host_input host_exit
    global png_before png_launch png_input png_exit
    global diff_launch diff_input diff_exit
    global diff_launch_txt diff_input_txt diff_exit_txt

    foreach pair [list \
        [list $guest_before $host_before $png_before] \
        [list $guest_launch $host_launch $png_launch] \
        [list $guest_input $host_input $png_input] \
        [list $guest_exit $host_exit $png_exit]] {
        set guest [lindex $pair 0]
        set ppm [lindex $pair 1]
        set png [lindex $pair 2]
        if {[catch { exec sh -c "debugfs -R 'dump $guest $ppm' '$tmpimg' >/dev/null 2>&1" } dump_out]} {
            puts "\nHOSTPYREPL-FAIL extract $guest $dump_out"
            exit 30
        }
        if {[catch { exec convert $ppm $png } convert_out]} {
            puts "\nHOSTPYREPL-FAIL convert $ppm $convert_out"
            exit 31
        }
    }

    set launch_ae [exec sh -c "compare -metric AE '$host_before' '$host_launch' '$diff_launch' 2>&1 || true"]
    set input_ae [exec sh -c "compare -metric AE '$host_launch' '$host_input' '$diff_input' 2>&1 || true"]
    set exit_ae [exec sh -c "compare -metric AE '$host_input' '$host_exit' '$diff_exit' 2>&1 || true"]
    exec sh -c "printf '%s\\n' '$launch_ae' > '$diff_launch_txt'; printf '%s\\n' '$input_ae' > '$diff_input_txt'; printf '%s\\n' '$exit_ae' > '$diff_exit_txt'"
    if {$launch_ae < 1000} {
        puts "\nHOSTPYREPL-FAIL launch-screenshot-unchanged changed_pixels=$launch_ae"
        exit 32
    }
    if {$input_ae < 100} {
        puts "\nHOSTPYREPL-FAIL input-screenshot-unchanged changed_pixels=$input_ae"
        exit 33
    }
    if {$exit_ae < 1000} {
        puts "\nHOSTPYREPL-FAIL exit-screenshot-unchanged changed_pixels=$exit_ae"
        exit 34
    }
    return [list $launch_ae $input_ae $exit_ae]
}

log_file -a $runlog
spawn timeout --foreground 220 bash scripts/launch/run-qemu.sh x86_64 $kernel $tmpimg
set qemu_pid [exp_pid]

expect {
    -re {weston-desktop-shell: loaded [0-9]+ desktop entries} {}
    -re {panic|fatal page fault|coredump: generating|virtio_gpu: async command} {
        fail 3 "HOSTPYREPL-FAIL crash-marker"
    }
    timeout { fail 4 "HOSTPYREPL-FAIL no-desktop" }
    eof { fail 5 "HOSTPYREPL-FAIL early-eof" }
}

sleep 2
send "\r"
expect {
    -re {root:/#} {}
    timeout { fail 6 "HOSTPYREPL-FAIL no-fresh-prompt" }
    eof { fail 6 "HOSTPYREPL-FAIL fresh-prompt-eof" }
}

capture_fb $guest_before "HOSTPYREPL_BASE_DONE" "HOSTPYREPL-FAIL base"

send "rm -f $app_log; /bin/host-python-repl &\r"
expect {
    -re {root:/#} {}
    -re {exec .*failed|not found|cannot execute} { fail 7 "HOSTPYREPL-FAIL launch" }
    timeout { fail 7 "HOSTPYREPL-FAIL no-prompt-after-launch" }
    eof { fail 7 "HOSTPYREPL-FAIL launch-eof" }
}

sleep 5
send "cat $app_log; echo HOSTPYREPL_LOG_DONE\r"
set saw_python_ready 0
set saw_mapped 0
set saw_log_done 0
while {!($saw_python_ready && $saw_mapped && $saw_log_done)} {
    expect {
        -re {host-python-repl: Python ready} { set saw_python_ready 1 }
        -re {host-python-repl: mapped Wayland window} { set saw_mapped 1 }
        -re {HOSTPYREPL_LOG_DONE} { set saw_log_done 1 }
        -re {No such file|cannot|failed} { fail 8 "HOSTPYREPL-FAIL app-log-error" }
        timeout {
            if {!$saw_python_ready} { fail 9 "HOSTPYREPL-FAIL python-ready-timeout" }
            if {!$saw_mapped} { fail 8 "HOSTPYREPL-FAIL mapped-log-timeout" }
            fail 10 "HOSTPYREPL-FAIL log-marker-timeout"
        }
        eof { fail 10 "HOSTPYREPL-FAIL log-eof" }
    }
}
optional_prompt

capture_fb $guest_launch "HOSTPYREPL_LAUNCH_FB_DONE" "HOSTPYREPL-FAIL launch"

send "mouseinject 32768 32768 0; mouseinject 32768 32768 1; mouseinject 32768 32768 0; echo HOSTPYREPL_FOCUS_DONE\r"
expect {
    -re {HOSTPYREPL_FOCUS_DONE} {}
    timeout { fail 11 "HOSTPYREPL-FAIL focus-timeout" }
    eof { fail 11 "HOSTPYREPL-FAIL focus-eof" }
}
optional_prompt

sleep 1
send "keyinject text \"6*7\"; keyinject key enter; echo HOSTPYREPL_KEYS_DONE\r"
expect {
    -re {HOSTPYREPL_KEYS_DONE} {}
    timeout { fail 12 "HOSTPYREPL-FAIL key-timeout" }
    eof { fail 12 "HOSTPYREPL-FAIL key-eof" }
}
optional_prompt

sleep 2
send "cat $app_log; echo HOSTPYREPL_EVAL_LOG_DONE\r"
expect {
    -re {host-python-repl: eval 6\*7} {}
    timeout { fail 15 "HOSTPYREPL-FAIL eval-log-timeout" }
    eof { fail 15 "HOSTPYREPL-FAIL eval-log-eof" }
}
expect {
    -re {HOSTPYREPL_EVAL_LOG_DONE} {}
    timeout { fail 15 "HOSTPYREPL-FAIL eval-log-marker-timeout" }
    eof { fail 15 "HOSTPYREPL-FAIL eval-log-marker-eof" }
}
optional_prompt

capture_fb $guest_input "HOSTPYREPL_INPUT_FB_DONE" "HOSTPYREPL-FAIL input"

send "keyinject key esc; echo HOSTPYREPL_ESC_DONE\r"
expect {
    -re {HOSTPYREPL_ESC_DONE} {}
    timeout { fail 13 "HOSTPYREPL-FAIL esc-timeout" }
    eof { fail 13 "HOSTPYREPL-FAIL esc-eof" }
}
optional_prompt

sleep 3
send "ps; echo HOSTPYREPL_AFTER_ESC_PS_DONE\r"
set saw_after_esc_done 0
while {!$saw_after_esc_done} {
    expect {
        -re {([0-9]+) /opt/host-gui/host-python-repl/bin/host-python-repl} {
            fail 14 "HOSTPYREPL-FAIL process-still-running-after-esc"
        }
        -re {HOSTPYREPL_AFTER_ESC_PS_DONE} {
            if {[regexp {([0-9]+) /opt/host-gui/host-python-repl/bin/host-python-repl} $expect_out(buffer) -> found_pid]} {
                fail 14 "HOSTPYREPL-FAIL process-still-running-after-esc"
            }
            set saw_after_esc_done 1
        }
        timeout { fail 14 "HOSTPYREPL-FAIL after-esc-ps-timeout" }
        eof { fail 14 "HOSTPYREPL-FAIL after-esc-ps-eof" }
    }
}
optional_prompt

capture_fb $guest_exit "HOSTPYREPL_EXIT_FB_DONE" "HOSTPYREPL-FAIL exit"

catch { exec pkill -P $qemu_pid qemu-system-x86_64 }
sleep 1
set aes [extract_artifacts]
puts "\nHOSTPYREPL-PASS launch_changed_pixels=[lindex $aes 0] input_changed_pixels=[lindex $aes 1] exit_changed_pixels=[lindex $aes 2] launch_png=$png_launch input_png=$png_input exit_png=$png_exit log=$runlog"
exit 0
