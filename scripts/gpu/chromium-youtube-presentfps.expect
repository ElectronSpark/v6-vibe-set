        [list player-state-api-missing [dict create force_hd720 1 \
            force_player_state_api 0 force_player_state -1]] \
        [list player-not-playing [dict create force_hd720 1 \
            force_player_state 3]] \
        [list range-api-missing [dict create force_hd720 1 \
            force_range_present 0 force_range_invoked 0]] \
        [list quality-api-missing [dict create force_hd720 1 \
            force_quality_present 0 force_quality_invoked 0]] \
        [list range-api-throw [dict create force_hd720 1 \
            force_range_threw 1]] \
        [list quality-api-throw [dict create force_hd720 1 \
            force_quality_threw 1]] \
        [list api-noop [dict create force_hd720 1 \
            force_observe_selected medium force_stable_count 0]] \
        [list observe-unstable [dict create force_hd720 1 \
