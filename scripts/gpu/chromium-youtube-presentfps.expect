    set static_fb_v2_initial_wc_guard {if [ "$#" -ne 3 ] || ! valid_decimal "$1" || ! valid_decimal "$2" || ! valid_decimal "$3"; then exit 68; fi}
    set static_fb_v2_retained_wc_guard {if [ "$#" -ne 3 ] || ! valid_decimal "$1" || ! valid_decimal "$2" || ! valid_decimal "$3" || [ "$3" != "$payload_bytes" ]; then exit 71; fi}
