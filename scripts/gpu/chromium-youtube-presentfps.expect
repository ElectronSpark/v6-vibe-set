    }
    set manifest_synthetic "trace=/chromium-egl-trace.509.log rows=12\ntrace=/chromium-egl-trace.412.log rows=32\n"
    if {[parse_forensic_manifest_paths $manifest_synthetic] ne $listing_paths} {
        fail_preflight "static-check-forensic-manifest-enumeration"
    }
    set provider_synthetic {chromium_egl_trace phase=provider pid=412 first_call=eglGetDisplay provider_addr=0x1 provider_path="/lib/libEGL.so.1" provider_symbol="eglGetDisplay" provider_base=0x2 mapped_provider_path="/lib/libEGL.so.1.0.0" map_line="1000-2000 r-xp /lib/libEGL.so.1.0.0" map_line_truncated=0 maps_any_line_truncated=0 map_found=1 maps_stream_status=truncated maps_total_bytes=1048576 maps_cap_bytes=1048576 egl_reserved_row=1 egl_row_cap=32}
    set cap_preload "$provider_synthetic\n"
    for {set row 2} {$row <= 32} {incr row} {
        append cap_preload "chromium_egl_trace phase=eglGetError pid=412 ret=0x3000\n"
    }
    set cap_mesa ""
    for {set row 1} {$row <= 16} {incr row} {
        append cap_mesa "xv6_mesa_egl_context_trace phase=context_failure pid=412 row=$row cap=16 bound_api=0x30a0 attribs=\"EGL_NONE(0x3038)\"\n"
    }
    set cap_pass [forensic_trace_caps [list $cap_preload] $cap_mesa]
    if {![lindex $cap_pass 0]} {
        fail_preflight "static-check-forensic-cap-pass parsed=$cap_pass"
    }
    set cap_preload_over "$cap_preload\nchromium_egl_trace phase=eglGetError pid=412 ret=0x3000\n"
    if {[lindex [forensic_trace_caps [list $cap_preload_over] $cap_mesa] 0]} {
        fail_preflight "static-check-preload-cap-overflow-accepted"
    }
    append cap_mesa "xv6_mesa_egl_context_trace phase=context_failure pid=412 row=17 cap=16 bound_api=0x30a0 attribs=\"EGL_NONE(0x3038)\"\n"
    if {[lindex [forensic_trace_caps [list $cap_preload] $cap_mesa] 0]} {
        fail_preflight "static-check-mesa-cap-overflow-accepted"
    }
    set provider_paths [forensic_provider_paths [list $cap_preload]]
    if {$provider_paths ne {/lib/libEGL.so.1 /lib/libEGL.so.1.0.0}} {
        fail_preflight "static-check-provider-paths parsed=$provider_paths"
    }
    set provider_contract [forensic_provider_contract [list $cap_preload]]
    if {![lindex $provider_contract 0]} {
        fail_preflight "static-check-provider-contract parsed=$provider_contract"
    }
    set provider_bad_total [string map \
        {maps_total_bytes=1048576 maps_total_bytes=1048575} \
        $provider_synthetic]
    if {[lindex [forensic_provider_contract [list $provider_bad_total]] 0]} {
        fail_preflight "static-check-provider-truncation-total-accepted"
    }
    set provider_bad_status [string map \
        {maps_stream_status=truncated maps_stream_status=unavailable} \
