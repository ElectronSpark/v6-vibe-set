    $capture_completeness_diag $c1_terminal_reducer]
if {![lindex $c1_terminal_reducer_contract 0]} {
    fail_preflight [lindex $c1_terminal_reducer_contract 1]
}
set media_probe_extension_id "edfilgocpdgbkehcgdillfgnnhclphol"
