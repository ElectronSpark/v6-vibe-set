            {index=1 video_width=1280 video_height=720 src_id=blob:https://www.youtube.com/<redacted> current_time=1.000 playback_rate=1.000 paused=0 ended=0 quality_selected=hd720 quality_available=hd1080,hd720,large quality_selected_api=1 quality_available_api=1 ready_state=4 network_state=2 buffered_ahead=12.500 vpq_available=0 vpq_total=0}]]] {
