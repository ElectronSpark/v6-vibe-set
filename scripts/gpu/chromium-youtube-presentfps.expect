    }
    set listing_synthetic {
/2/040755/0/0/.//
/17/100644/0/0/chromium-egl-trace.412.log/2048/
/18/100644/0/0/chromium-egl-trace.509.log/4096/
/19/100644/0/0/chromium-egl-trace.bad.log/128/
}
    set listing_paths [parse_guest_trace_listing $listing_synthetic]
    if {$listing_paths ne {/chromium-egl-trace.412.log /chromium-egl-trace.509.log}} {
