    set static_fb_payload_path "$static_fb_helper_dir/payload.bin"
    set static_fb_records_path "$static_fb_helper_dir/records.txt"
    set static_fb_bin "$static_fb_helper_dir/fbstat"
    set static_fb_recorder "$static_fb_helper_dir/_consolerecord"
    set static_fb_stub_helper [fbstat_transport_guest_helper_script $static_fb_recorder]
    if {[string first "recorder=$static_fb_recorder" $static_fb_stub_helper] < 0 ||
