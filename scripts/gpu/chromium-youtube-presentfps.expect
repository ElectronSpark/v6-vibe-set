    if {[lindex [forensic_provider_contract [list $provider_bad_status]] 0]} {
        fail_preflight "static-check-provider-unavailable-status-accepted"
    }
    set provider_sha [string repeat a 64]
    set build_id_valid "provider_guest=/lib/libEGL.so resolved=/lib/libEGL.so.1 host=/tmp/libEGL.so size=4096 sha256=$provider_sha build_id=474e8b157e8629734b76eebf9ca5383e44b56252"
    if {![lindex [provider_artifact_build_id_contract $build_id_valid] 0]} {
        fail_preflight "static-check-valid-provider-build-id-rejected"
    }
    foreach invalid_build_id {
        unavailable
        xyz
        0123456789abcde
        0123456789abcdef0
    } {
        set invalid_manifest "provider_guest=/lib/libEGL.so resolved=/lib/libEGL.so.1 host=/tmp/libEGL.so size=4096 sha256=$provider_sha build_id=$invalid_build_id"
        if {[lindex [provider_artifact_build_id_contract $invalid_manifest] 0]} {
            fail_preflight "static-check-invalid-provider-build-id-accepted-$invalid_build_id"
        }
    }
    set attr_preload {chromium_egl_trace phase=eglCreateContext_enter pid=412 dpy=0x1 config=0x2 share=(nil) attribs="EGL_CONTEXT_OPENGL_NO_ERROR_KHR(0x31b3)=0x1,EGL_CONTEXT_CLIENT_VERSION(0x3098)=0x3,EGL_NONE"}
    set attr_mesa {xv6_mesa_egl_context_trace phase=context_failure pid=412 row=1 cap=16 first_rejected_attr=0x31b3 attribs="0x31b3=0x1,0x3098=0x3,EGL_NONE(0x3038)"}
    set attr_contract [forensic_attr_format_contract $attr_preload $attr_mesa]
    if {![lindex $attr_contract 0]} {
        fail_preflight "static-check-forensic-attr-format parsed=$attr_contract"
    }
    # Expect/forkpty already creates a distinct session/process-group leader.
    # Directly execing the launcher preserves one owned PID through EOF/wait;
    # wrapping this leader in plain util-linux setsid would fork and break that
    # identity, which the negative contract below rejects.
    set ownership_payload {pgid=$(ps -o pgid= -p $$ | tr -d ' '); sid=$(ps -o sid= -p $$ | tr -d ' '); printf 'STATIC_OWNER pid=%s pgid=%s sid=%s\n' "$$" "$pgid" "$sid"; sleep 0.05; printf 'STATIC_OWNER_DONE\n'}
    set ownership_old_timeout $timeout
    set timeout 3
    log_user 0
    spawn -noecho sh -c $ownership_payload
    set ownership_leader [exp_pid]
    set ownership_child -1
    set ownership_pgid -1
    set ownership_sid -1
    set ownership_done 0
    set ownership_timed_out 0
    expect {
        -re {STATIC_OWNER pid=([0-9]+) pgid=([0-9]+) sid=([0-9]+)} {
            set ownership_child $expect_out(1,string)
            set ownership_pgid $expect_out(2,string)
            set ownership_sid $expect_out(3,string)
            exp_continue
        }
        -re {STATIC_OWNER_DONE} {
            set ownership_done 1
            exp_continue
        }
        eof {}
        timeout { set ownership_timed_out 1 }
    }
    set ownership_wait [wait]
    log_user 1
    set timeout $ownership_old_timeout
    set ownership_contract [qemu_spawn_ownership_contract \
        $ownership_leader $ownership_child $ownership_pgid $ownership_sid \
        [expr {$ownership_done && !$ownership_timed_out}] \
        [lindex $ownership_wait 0] [lindex $ownership_wait 3]]
    if {![lindex $ownership_contract 0]} {
        fail_preflight "static-check-direct-spawn-ownership parsed=$ownership_contract wait=$ownership_wait"
    }
    set ownership_bad [qemu_spawn_ownership_contract 100 101 101 101 0 100 0]
    if {[lindex $ownership_bad 0]} {
        fail_preflight "static-check-forked-wrapper-ownership-accepted"
    }

    set freshness_path "$outdir/debugcon-freshness-reducer.log"
    wf $freshness_path "stale-prior-run\n"
    file mtime $freshness_path [expr {[clock seconds] - 60}]
    set freshness_prepare [prepare_debugcon_path $freshness_path]
    if {![lindex $freshness_prepare 0] || [file exists $freshness_path]} {
        fail_preflight "static-check-debugcon-preparation parsed=$freshness_prepare"
    }
    set freshness_epoch [lindex $freshness_prepare 1]
    set freshness_missing [debugcon_freshness $freshness_path 1 $freshness_epoch]
    if {[lindex $freshness_missing 0] ne "missing"} {
        fail_preflight "static-check-debugcon-missing parsed=$freshness_missing"
    }
    wf $freshness_path "current-run\n"
    file mtime $freshness_path $freshness_epoch
    set freshness_current [debugcon_freshness $freshness_path 1 $freshness_epoch]
    if {[lindex $freshness_current 0] ne "present-current"} {
        fail_preflight "static-check-debugcon-current parsed=$freshness_current"
    }
    file mtime $freshness_path [expr {$freshness_epoch - 1}]
    set freshness_stale [debugcon_freshness $freshness_path 1 $freshness_epoch]
    if {[lindex $freshness_stale 0] ne "stale"} {
        fail_preflight "static-check-debugcon-stale parsed=$freshness_stale"
    }
    wf $freshness_path ""
    file mtime $freshness_path $freshness_epoch
    set freshness_empty [debugcon_freshness $freshness_path 1 $freshness_epoch]
    if {[lindex $freshness_empty 0] ne "empty-current"} {
        fail_preflight "static-check-debugcon-empty parsed=$freshness_empty"
    }
    set freshness_unprepared [debugcon_freshness $freshness_path 0 $freshness_epoch]
    if {[lindex $freshness_unprepared 0] ne "unprepared"} {
        fail_preflight "static-check-debugcon-unprepared parsed=$freshness_unprepared"
    }
    catch {file delete -force $freshness_path}

    # Reducer for the complete serial command frame.  Expect waits through the
    # explicit fence; only the offline frame parser may grant the single RC.
    set marker_reducer YTREDUCERC7
    set marker_fence_regex [guest_fence_regex $marker_reducer]
    proc static_guest_fence_expect {pattern payload} {
        global timeout
        set old_timeout $timeout
        set timeout 2
        set matched ""
        log_user 0
        spawn -noecho sh -c {printf '%s\n' "$1"} sh $payload
        expect {
            -re $pattern { set matched $expect_out(buffer) }
            eof {}
            timeout {}
        }
        catch {wait}
        log_user 1
        set timeout $old_timeout
        return $matched
    }
    set valid_frame "noise\n$marker_reducer:RC:73\n$marker_reducer:FENCE\n"
    set valid_frame_parse [guest_command_frame_parse $valid_frame $marker_reducer]
    set expect_frame [static_guest_fence_expect $marker_fence_regex $valid_frame]
    set expect_frame_parse [guest_command_frame_parse $expect_frame $marker_reducer]
    set newline_frames {}
    foreach terminator [list "\n" "\r\n" "\r\r\n"] {
        set newline_frame "$marker_reducer:RC:73$terminator$marker_reducer:FENCE$terminator"
        set newline_match [regexp -- $marker_fence_regex $newline_frame]
        set newline_parse [guest_command_frame_parse $newline_frame $marker_reducer]
        lappend newline_frames [list $newline_match $newline_parse]
    }
    set newline_frames_ok 1
    foreach newline_result $newline_frames {
        if {![lindex $newline_result 0] ||
            ![lindex [lindex $newline_result 1] 0] ||
            [lindex [lindex $newline_result 1] 2] ne "73"} {
            set newline_frames_ok 0
        }
    }
    set three_cr_frame "$marker_reducer:RC:73\r\r\r\n$marker_reducer:FENCE\r\r\r\n"
    set three_cr_match [regexp -- $marker_fence_regex $three_cr_frame]
    set three_cr_parse [guest_command_frame_parse $three_cr_frame $marker_reducer]
    set missing_newline_frame "$marker_reducer:RC:73\r\r\n$marker_reducer:FENCE\r\r"
    set missing_newline_match [regexp -- $marker_fence_regex $missing_newline_frame]
    set missing_newline_parse [guest_command_frame_parse $missing_newline_frame $marker_reducer]
    set wrong_nonce_frame "YTWRONGC7:RC:73\r\r\nYTWRONGC7:FENCE\r\r\n"
    set wrong_nonce_match [regexp -- $marker_fence_regex $wrong_nonce_frame]
    set wrong_nonce_parse [guest_command_frame_parse $wrong_nonce_frame $marker_reducer]
    set spoof_frame "prefix$marker_reducer:RC:73\r\r\nprefix$marker_reducer:FENCE\r\r\n"
    set spoof_match [regexp -- $marker_fence_regex $spoof_frame]
    set spoof_parse [guest_command_frame_parse $spoof_frame $marker_reducer]
    set unknown_spoof_frame "$marker_reducer:RC:73\r\r\n$marker_reducer:FENCE:spoof\r\r\n"
    set unknown_spoof_parse [guest_command_frame_parse \
        $unknown_spoof_frame $marker_reducer]

    # Replay the two retained raw terminal transcripts byte-for-byte.  Their
    # immutable hashes and exact final CRCRLF frames are the regression
    # fixture; Tcl regexp is the same matcher used by Expect's `-re` arm.
    set retained_fence_replays [list \
        [list \
            "$root/build-x86_64/chromium-youtube-m7/20260710T194123Z-a1-hd720-hostwait-t1-mp1-audio1/run.log" \
            4141ff01c02cc8d903893249ead83a7b7be055452acae879dac6ceb3ed9f8fe4 \
            YTP3243321783712483847858C1] \
        [list \
            "$root/build-x86_64/chromium-youtube-m7/20260710T194313Z-a1-hd720-hostwait-t1r1-mp1-audio1/run.log" \
            895f22c253a573abeac2538486778598e3044e2a404f842f32ba90a6d38fbea7 \
            YTP3264071783712593687233C1]]
    set retained_fence_results {}
    foreach replay $retained_fence_replays {
        lassign $replay replay_path replay_sha replay_marker
        set replay_fh [open $replay_path rb]
        fconfigure $replay_fh -translation binary -encoding binary
        set replay_raw [read $replay_fh]
        close $replay_fh
        set replay_regex [guest_fence_regex $replay_marker]
        set replay_expected \
            "$replay_marker:RC:0\r\r\n$replay_marker:FENCE\r\r\n"
        set replay_parse [guest_command_frame_parse $replay_raw $replay_marker]
        lappend retained_fence_results [list \
            [expr {[sha256_file $replay_path] eq $replay_sha}] \
            [expr {[string first $replay_expected $replay_raw] >= 0}] \
            [regexp -- $replay_regex $replay_raw] \
            $replay_parse]
    }
    set retained_fence_results_ok 1
    foreach replay_result $retained_fence_results {
        if {![lindex $replay_result 0] ||
            ![lindex $replay_result 1] ||
            ![lindex $replay_result 2] ||
            ![lindex [lindex $replay_result 3] 0] ||
            [lindex [lindex $replay_result 3] 2] ne "0"} {
            set retained_fence_results_ok 0
        }
    }
    set guest_cmd_body [info body guest_cmd]
    set fail_timeout_body [info body fail_timeout]
    set fatal_timeout_contract [expr {
        [string first "timeout {\n            set timeout \$old_timeout\n            fail_timeout \$label\n        }" \
            $guest_cmd_body] >= 0 &&
        [string first {finish $code "FAIL timeout phase=$phase crash_grep=clean"} \
            $fail_timeout_body] >= 0}]
    set conflict_frame [guest_command_frame_parse \
        "$marker_reducer:RC:0\n$marker_reducer:RC:9\n$marker_reducer:RC:9\n$marker_reducer:FENCE\n" \
        $marker_reducer]
    set conflict_expect_frame [guest_command_frame_parse \
        [static_guest_fence_expect $marker_fence_regex \
            "$marker_reducer:RC:0\n$marker_reducer:RC:9\n$marker_reducer:RC:9\n$marker_reducer:FENCE\n"] \
        $marker_reducer]
    set duplicate_frame [guest_command_frame_parse \
        "$marker_reducer:RC:0\n$marker_reducer:RC:0\n$marker_reducer:FENCE\n" \
        $marker_reducer]
    set missing_fence_frame [guest_command_frame_parse \
        "$marker_reducer:RC:0\n" $marker_reducer]
    set missing_rc_frame [guest_command_frame_parse \
        "$marker_reducer:FENCE\n" $marker_reducer]
    set reversed_frame [guest_command_frame_parse \
        "$marker_reducer:FENCE\n$marker_reducer:RC:0\n" $marker_reducer]
    set duplicate_fence_frame [guest_command_frame_parse \
        "$marker_reducer:RC:0\n$marker_reducer:FENCE\n$marker_reducer:FENCE\n" \
        $marker_reducer]
    set unknown_frame [guest_command_frame_parse \
        "$marker_reducer:RC:notnumeric\n$marker_reducer:FENCE\n" \
        $marker_reducer]

    # EOF is a terminal control condition, not a receipt result.  Exercise the
    # actual artifact writer with a partial C6 echo and helper bytes, a truthful
    # cap/truncation case, and a synthetic pre-cleanup owned-group snapshot.
    set static_eof_phase render-start-receipt-probe1
    set static_eof_marker YTEOFSTATICC6
    set static_eof_snapshot [eof_control_snapshot_text \
        2026-07-12T00:00:00Z ps-owned-pgid 4242 \
        {pid=4242 ppid=17 pgid=4242 sid=4242 state=Ssl live=1 comm=qemu-system-x86_64}]
    set static_eof_cap_saved $eof_control_raw_cap
    set eof_control_raw_cap 128
    set static_eof_partial "true;/bin/bash /ytrenderstartreceipt.sh deadbeef 1;rc=\$?;m=$static_eof_marker;printf partial-helper-bytes"
    set static_eof_partial_paths [retain_eof_control_evidence \
        $static_eof_phase $static_eof_marker $static_eof_partial $static_eof_snapshot]
    set static_eof_partial_artifact [read_text [lindex $static_eof_partial_paths 0]]
    set static_eof_partial_snapshot [read_text [lindex $static_eof_partial_paths 1]]
    set static_eof_partial_meta [regexp -line \
        {^EOF_CONTROL_EVIDENCE version=1 timestamp=[^ ]+ phase=render-start-receipt-probe1 marker=YTEOFSTATICC6 source=guest_cmd_eof raw_bytes=([0-9]+) retained_bytes=([0-9]+) truncated=([01])$} \
        $static_eof_partial_artifact -> static_eof_partial_raw_bytes \
        static_eof_partial_retained_bytes static_eof_partial_truncated]
    set static_eof_partial_hex_ok [regexp -line {^EOF_CONTROL_RAW_HEX ([0-9a-f]*)$} \
        $static_eof_partial_artifact -> static_eof_partial_hex]
    set static_eof_partial_decoded ""
    if {$static_eof_partial_hex_ok &&
        ![catch {binary decode hex $static_eof_partial_hex} static_eof_partial_decoded]} {
        set static_eof_partial_hex_ok [expr {$static_eof_partial_decoded eq $static_eof_partial}]
    } else {
        set static_eof_partial_hex_ok 0
    }
    set static_eof_partial_frame [guest_command_frame_parse \
        $static_eof_partial $static_eof_marker]
    set static_eof_helper_bytes "$static_eof_marker:RC:0\nYT_RENDER_START_RECEIPT_BEGIN nonce=deadbeef probe=1\n"
    set static_eof_helper_paths [retain_eof_control_evidence \
        $static_eof_phase $static_eof_marker $static_eof_helper_bytes $static_eof_snapshot]
    set static_eof_helper_artifact [read_text [lindex $static_eof_helper_paths 0]]
    regexp -line {^EOF_CONTROL_RAW_HEX ([0-9a-f]*)$} $static_eof_helper_artifact \
        -> static_eof_helper_hex
    set static_eof_helper_decoded ""
    set static_eof_helper_decode_ok [expr {![catch {binary decode hex $static_eof_helper_hex} static_eof_helper_decoded] &&
        $static_eof_helper_decoded eq $static_eof_helper_bytes}]
    set static_eof_helper_frame [guest_command_frame_parse \
        $static_eof_helper_bytes $static_eof_marker]
    set static_eof_over_raw "prefix-$static_eof_marker-[string repeat X 160]"
    set static_eof_over_paths [retain_eof_control_evidence \
        $static_eof_phase $static_eof_marker $static_eof_over_raw $static_eof_snapshot]
    set static_eof_over_artifact [read_text [lindex $static_eof_over_paths 0]]
    set static_eof_over_meta [regexp -line \
        {^EOF_CONTROL_EVIDENCE version=1 timestamp=[^ ]+ phase=render-start-receipt-probe1 marker=YTEOFSTATICC6 source=guest_cmd_eof raw_bytes=([0-9]+) retained_bytes=([0-9]+) truncated=([01])$} \
        $static_eof_over_artifact -> static_eof_over_raw_bytes \
        static_eof_over_retained_bytes static_eof_over_truncated]
    regexp -line {^EOF_CONTROL_RAW_HEX ([0-9a-f]*)$} $static_eof_over_artifact \
        -> static_eof_over_hex
    set static_eof_over_decoded ""
    set static_eof_over_decode_ok [expr {![catch {binary decode hex $static_eof_over_hex} static_eof_over_decoded] &&
        $static_eof_over_decoded eq [string range $static_eof_over_raw end-127 end]}]
    set static_eof_complete "$static_eof_marker:RC:0\n$static_eof_marker:FENCE\n"
    set static_eof_complete_frame [guest_command_frame_parse \
        $static_eof_complete $static_eof_marker]
    set static_eof_guest_cmd_body [info body guest_cmd]
    set static_eof_finish_body [info body finish]
    set static_eof_retain_body [info body retain_eof_control_evidence]
    set static_eof_eof_branch [string first "eof \{\n            set timeout \$old_timeout" \
        $static_eof_guest_cmd_body]
    set static_eof_retain_index [string first \
        {retain_eof_control_evidence $label $marker $eof_raw} $static_eof_guest_cmd_body]
    set static_eof_finish_index [string first {finish 5 "FAIL eof phase=$label"} \
        $static_eof_guest_cmd_body]
    set static_eof_order_ok [expr {
        $static_eof_eof_branch >= 0 && $static_eof_retain_index > $static_eof_eof_branch &&
        $static_eof_finish_index > $static_eof_retain_index &&
        [string first {set snapshot [owned_qemu_pre_cleanup_snapshot]} $static_eof_retain_body] >= 0 &&
        [string first {stop_qemu} $static_eof_finish_body] >= 0
    }]
    set static_eof_no_credit [expr {
        [finish_extraction_path 5 0 0 1 NOT_RUN] eq "evidence-only" &&
        [lindex $static_eof_complete_frame 0] && [lindex $static_eof_complete_frame 2] eq "0" &&
        ![lindex $static_eof_partial_frame 0] && ![lindex $static_eof_helper_frame 0]
    }]
    set eof_control_raw_cap $static_eof_cap_saved
    foreach static_eof_paths [list $static_eof_partial_paths $static_eof_helper_paths \
            $static_eof_over_paths] {
        foreach static_eof_path $static_eof_paths { catch {file delete -force $static_eof_path} }
    }
    if {![lindex $valid_frame_parse 0] ||
        [lindex $valid_frame_parse 2] ne "73" ||
        ![lindex $expect_frame_parse 0] ||
        [lindex $expect_frame_parse 2] ne "73" ||
        !$newline_frames_ok ||
        $three_cr_match || [lindex $three_cr_parse 0] ||
        $missing_newline_match || [lindex $missing_newline_parse 0] ||
        $wrong_nonce_match || [lindex $wrong_nonce_parse 0] ||
        $spoof_match || [lindex $spoof_parse 0] ||
        [lindex $unknown_spoof_parse 0] ||
        !$retained_fence_results_ok ||
        !$fatal_timeout_contract ||
        [lindex $conflict_frame 0] ||
        ![string match {frame-rc-count-3} [lindex $conflict_frame 1]] ||
        [lindex $conflict_expect_frame 0] ||
        ![string match {frame-rc-count-3} \
            [lindex $conflict_expect_frame 1]] ||
        [lindex $duplicate_frame 0] ||
        ![string match {frame-rc-count-2} [lindex $duplicate_frame 1]] ||
        [lindex $missing_fence_frame 0] ||
        [lindex $missing_rc_frame 0] ||
        [lindex $reversed_frame 0] ||
        [lindex $duplicate_fence_frame 0] ||
        [lindex $unknown_frame 0] ||
        !$static_eof_partial_meta || $static_eof_partial_raw_bytes != [string length $static_eof_partial] ||
        $static_eof_partial_retained_bytes != [string length $static_eof_partial] ||
        $static_eof_partial_truncated != 0 || !$static_eof_partial_hex_ok ||
        [string first $static_eof_snapshot $static_eof_partial_artifact] < 0 ||
        $static_eof_partial_snapshot ne $static_eof_snapshot ||
        !$static_eof_helper_decode_ok ||
        !$static_eof_over_meta || $static_eof_over_raw_bytes != [string length $static_eof_over_raw] ||
        $static_eof_over_retained_bytes != 128 || $static_eof_over_truncated != 1 ||
        !$static_eof_over_decode_ok || !$static_eof_order_ok || !$static_eof_no_credit} {
        fail_preflight "static-check-guest-command-frame valid=$valid_frame_parse expect=$expect_frame_parse newline=$newline_frames three_cr=$three_cr_parse missing_newline=$missing_newline_parse wrong_nonce=$wrong_nonce_parse spoof=$spoof_parse unknown_spoof=$unknown_spoof_parse retained=$retained_fence_results fatal_timeout=$fatal_timeout_contract conflict=$conflict_frame conflict_expect=$conflict_expect_frame duplicate=$duplicate_frame missing_fence=$missing_fence_frame missing_rc=$missing_rc_frame reversed=$reversed_frame duplicate_fence=$duplicate_fence_frame unknown=$unknown_frame eof_partial=$static_eof_partial_meta,$static_eof_partial_raw_bytes,$static_eof_partial_retained_bytes,$static_eof_partial_truncated,$static_eof_partial_hex_ok eof_helper=$static_eof_helper_decode_ok eof_over=$static_eof_over_meta,$static_eof_over_raw_bytes,$static_eof_over_retained_bytes,$static_eof_over_truncated,$static_eof_over_decode_ok eof_order=$static_eof_order_ok eof_no_credit=$static_eof_no_credit"
    }

    # Exact relevant t2 rows from completed C1.  FB_GPU_GET_STATS is one locked
    # snapshot: generic bo_presents counts admitted requests, while the
    # virgl-specific counter counts later successful virgl presentations.
    # Virgl is canonical under the backend proof, so 6199/6198 must parse as
    # 6198 rather than conflict or max-select 6199.
    set c1_t2_fbstat_excerpt {
backend virgl flags 0x27 renderer OpenGL via virtio-gpu virgl
backend_opengl_submit 1
backend_opengl_submit_gate open
backend_virgl_opengl 1
opengl_submit_backend_separation_matrix backend=virgl dxg_transport=0 d3dkmt=0 virgl_opengl=1 backend_opengl_submit=1 allowed_submit_backend=virgl hyperv_dxg_transport_is_submit=0 hyperv_d3dkmt_is_submit=0 kvm_virgl_submit_allowed=1 native_present_credit=0 opengl_submit_credit=1 status=PASS
d3d12_native_completion_not_kms_matrix generic_display_last_complete=6198 kms_vblank_display_correlated=1 kms_vblank_source_software_display=1 kms_vblank_source_native_hw=0 kms_atomic_out_fence_display_correlated=0 kms_atomic_out_fence_software_scanout_correlated=0 kms_page_flip_events=6197 page_flip_events_software_blit=6197 page_flip_events_native_hw=0 display_wait_is_native=0 kms_generic_display_credit=0 native_present_credit=0 opengl_submit_credit=0 status=PASS
bo_presents 6199
virgl_bo_presents 6198
}
    set c1_t2_parsed [parse_fbstat_counters $c1_t2_fbstat_excerpt]
    if {![lindex $c1_t2_parsed 0] || [lindex $c1_t2_parsed 1] ne "6197" ||
        [lindex $c1_t2_parsed 2] ne "6198" ||
        ![string match {*generic_present_diagnostic=*6199*} [lindex $c1_t2_parsed 3]]} {
        fail_preflight "static-check-c1-t2-nonatomic-drift parsed=$c1_t2_parsed"
    }
    set c1_same_value [string map [list {bo_presents 6199} {bo_presents 6198}] $c1_t2_fbstat_excerpt]
    set c1_same_parsed [parse_fbstat_counters $c1_same_value]
    if {![lindex $c1_same_parsed 0] || [lindex $c1_same_parsed 2] ne "6198"} {
        fail_preflight "static-check-c1-same-value parsed=$c1_same_parsed"
    }
    set c1_no_generic [string map [list {bo_presents 6199} {old_bo_presents 6199}] $c1_t2_fbstat_excerpt]
    set c1_no_generic_parsed [parse_fbstat_counters $c1_no_generic]
    if {![lindex $c1_no_generic_parsed 0] || [lindex $c1_no_generic_parsed 2] ne "6198" ||
        ![string match {*generic_present_diagnostic=none} [lindex $c1_no_generic_parsed 3]]} {
        fail_preflight "static-check-c1-no-generic-counter parsed=$c1_no_generic_parsed"
    }
    set c1_same_authoritative [parse_fbstat_counters "$c1_t2_fbstat_excerpt\nvirgl_bo_presents 6198\n"]
    if {[lindex $c1_same_authoritative 0] ||
        ![string match {duplicate-authoritative-virgl_bo_presents*} [lindex $c1_same_authoritative 3]]} {
        fail_preflight "static-check-c1-same-authoritative-duplicate-accepted parsed=$c1_same_authoritative"
    }
    set c1_authoritative_conflict [parse_fbstat_counters "$c1_t2_fbstat_excerpt\nvirgl_bo_presents 6200\n"]
    if {[lindex $c1_authoritative_conflict 0] ||
        ![string match {duplicate-authoritative-virgl_bo_presents*} [lindex $c1_authoritative_conflict 3]]} {
        fail_preflight "static-check-c1-authoritative-conflict parsed=$c1_authoritative_conflict"
    }
    set c1_missing_authoritative [string map [list {virgl_bo_presents 6198} {old_virgl_bo_presents 6198}] $c1_t2_fbstat_excerpt]
    set c1_missing_authoritative_parsed [parse_fbstat_counters $c1_missing_authoritative]
    if {[lindex $c1_missing_authoritative_parsed 0] ||
        ![string match {missing-virgl_bo_presents*} [lindex $c1_missing_authoritative_parsed 3]]} {
        fail_preflight "static-check-c1-authoritative-missing parsed=$c1_missing_authoritative_parsed"
    }
    set c1_wrong_backend [string map [list \
        {backend virgl flags 0x27 renderer OpenGL via virtio-gpu virgl} \
        {backend bochs flags 0x0 renderer software framebuffer}] $c1_t2_fbstat_excerpt]
    set c1_wrong_backend_parsed [parse_fbstat_counters $c1_wrong_backend]
    if {[lindex $c1_wrong_backend_parsed 0] ||
        ![string match {wrong-backend*} [lindex $c1_wrong_backend_parsed 3]]} {
        fail_preflight "static-check-c1-wrong-backend parsed=$c1_wrong_backend_parsed"
    }
    set c1_missing_backend [string map [list \
        {backend virgl flags 0x27 renderer OpenGL via virtio-gpu virgl} \
        {old_backend virgl flags 0x27 renderer OpenGL via virtio-gpu virgl}] $c1_t2_fbstat_excerpt]
    set c1_missing_backend_parsed [parse_fbstat_counters $c1_missing_backend]
    if {[lindex $c1_missing_backend_parsed 0] ||
        ![string match {missing-backend*} [lindex $c1_missing_backend_parsed 3]]} {
        fail_preflight "static-check-c1-missing-backend parsed=$c1_missing_backend_parsed"
    }
    set c1_missing_flip [string map [list {kms_page_flip_events=6197} {old_kms_page_flip_events=6197}] $c1_t2_fbstat_excerpt]
    set c1_missing_flip_parsed [parse_fbstat_counters $c1_missing_flip]
    if {[lindex $c1_missing_flip_parsed 0] ||
        ![string match {missing-kms_page_flip_events*} [lindex $c1_missing_flip_parsed 3]]} {
        fail_preflight "static-check-c1-flip-missing parsed=$c1_missing_flip_parsed"
    }
    set c1_flip_conflict [parse_fbstat_counters "$c1_t2_fbstat_excerpt\nd3d12_native_completion_not_kms_matrix kms_page_flip_events=6199\n"]
    if {[lindex $c1_flip_conflict 0] ||
        ![string match {conflicting-kms_page_flip_events*} [lindex $c1_flip_conflict 3]]} {
        fail_preflight "static-check-c1-flip-conflict parsed=$c1_flip_conflict"
    }

    if {0} {
    # Retired V1 single-HEX static corpus. V2 below is the only C1 transport
    # oracle; retain this text temporarily as review context, never execution.
    # The transport uses a 128 KiB decoded cap (262144 lower-hex bytes) so the
    # observed 58,986-byte fbstat payload fits with substantial headroom while
    # the UART frame remains far below guest_cmd's 2 MiB match_max.  The
    # current parser still receives its original complete text only after the
    # C5/tag/nonce/count/cap/hex/digest frame has verified.
    set static_fb_tag probe1
    set static_fb_nonce fbfstatstaticnonce
    set static_fb_marker YTFBSTATSTATICC5
    set static_fb_payload "$c1_t2_fbstat_excerpt\n"
    set static_fb_target_bytes 58986
    if {[string bytelength $static_fb_payload] > $static_fb_target_bytes} {
        fail_preflight "static-check-fbstat-transport-fixture-too-large"
    }
    append static_fb_payload [string repeat x [expr {$static_fb_target_bytes - [string bytelength $static_fb_payload]}]]
    set static_fb_frame [fbstat_transport_static_frame $static_fb_tag \
        $static_fb_nonce $static_fb_payload]
    set static_fb_frame_lines [split [string trimright $static_fb_frame "\n"] "\n"]
    set static_fb_logical "$static_fb_frame$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_wire_results {}
    foreach static_fb_wire_case [list \
            [list lf "\n"] [list crlf "\r\n"] [list crcrlf "\r\r\n"]] {
        lassign $static_fb_wire_case wire_name wire_eol
        set static_fb_serial [string map [list "\n" $wire_eol] $static_fb_logical]
        set static_fb_decoded [fbstat_transport_decode $static_fb_serial \
            $static_fb_tag $static_fb_nonce $static_fb_marker]
        set static_fb_classified [expr {[lindex $static_fb_decoded 0] ? \
            [classify_fbstat_sample [lindex $static_fb_decoded 2] 1] : {INVALID {}}}]
        lappend static_fb_wire_results [list $wire_name $static_fb_decoded $static_fb_classified]
        if {![lindex $static_fb_decoded 0] ||
            [string bytelength [lindex $static_fb_decoded 2]] != $static_fb_target_bytes ||
            [lindex $static_fb_classified 0] ne "PASS"} {
            fail_preflight "static-check-fbstat-transport-wire-$wire_name decoded=$static_fb_decoded classified=$static_fb_classified"
        }
    }
    set static_fb_crlf_blank "[lindex $static_fb_frame_lines 0]\r\n[lindex $static_fb_frame_lines 1]\r\n\r\n[lindex $static_fb_frame_lines 2]\r\n[lindex $static_fb_frame_lines 3]\r\n$static_fb_marker:RC:0\r\n$static_fb_marker:FENCE\r\n"
    set static_fb_noise [binary decode hex {1b5b3f323030346c0d5b0a}]
    set static_fb_lone_cr_noise "$static_fb_noise[string map [list "\n" "\r\r\n"] $static_fb_logical]"
    set static_fb_noise_decoded [fbstat_transport_decode $static_fb_lone_cr_noise \
        $static_fb_tag $static_fb_nonce $static_fb_marker]
    set static_fb_noise_classified [expr {[lindex $static_fb_noise_decoded 0] ? \
        [classify_fbstat_sample [lindex $static_fb_noise_decoded 2] 1] : {INVALID {}}}]
    if {![lindex $static_fb_noise_decoded 0] ||
        [lindex $static_fb_noise_classified 0] ne "PASS"} {
        fail_preflight "static-check-fbstat-transport-lone-cr-noise decoded=$static_fb_noise_decoded classified=$static_fb_noise_classified"
    }
    set static_fb_midrow [string map \
        [list "tag=$static_fb_tag nonce=" "tag=$static_fb_tag\r nonce="] \
        [string map [list "\n" "\r\n"] $static_fb_logical]]
    set static_fb_decode_body [info body fbstat_transport_decode]
    if {[string first {foreach raw_record [split $serial "\n"]} $static_fb_decode_body] < 0 ||
        [string first {set line [string trimright $raw_record "\r"]} $static_fb_decode_body] < 0 ||
        [string first {set normalized [string map} $static_fb_decode_body] >= 0} {
        fail_preflight "static-check-fbstat-transport-candidate-local-scanner"
    }
    set static_fb_interleaved [join [list \
        [lindex $static_fb_frame_lines 0] [lindex $static_fb_frame_lines 1] \
        {virtio_gpu: page-flip present resource=4 size=1280x800} \
        [lindex $static_fb_frame_lines 2] [lindex $static_fb_frame_lines 3]] "\n"]
    append static_fb_interleaved "\n$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_duplicate "$static_fb_frame$static_fb_frame$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_wrong_tag "[fbstat_transport_static_frame wrongtag $static_fb_nonce $static_fb_payload]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_wrong_nonce "[fbstat_transport_static_frame $static_fb_tag wrongnonce $static_fb_payload]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_bad_status "[fbstat_transport_static_frame $static_fb_tag $static_fb_nonce $static_fb_payload [dict create status COMMAND_FAILED]]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_bad_count "[fbstat_transport_static_frame $static_fb_tag $static_fb_nonce $static_fb_payload [dict create payload_bytes [expr {$static_fb_target_bytes + 1}]] ]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_bad_cap "[fbstat_transport_static_frame $static_fb_tag $static_fb_nonce $static_fb_payload [dict create cap [expr {$fbstat_transport_payload_cap - 1}]] ]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_bad_length "[fbstat_transport_static_frame $static_fb_tag $static_fb_nonce $static_fb_payload [dict create hex_bytes 1]]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_bad_digest "[fbstat_transport_static_frame $static_fb_tag $static_fb_nonce $static_fb_payload [dict create digest [string repeat 0 64]] ]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_bad_hex "[fbstat_transport_static_frame $static_fb_tag $static_fb_nonce $static_fb_payload [dict create payload_hex g]]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_nonregular "[fbstat_transport_static_frame $static_fb_tag $static_fb_nonce $static_fb_payload [dict create status FILE_INVALID]]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_capped_payload [string repeat x $fbstat_transport_payload_cap]
    set static_fb_truthful_truncated "[fbstat_transport_static_frame $static_fb_tag $static_fb_nonce $static_fb_capped_payload [dict create raw_bytes [expr {$fbstat_transport_payload_cap + 1}] truncated 1]]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    foreach static_fb_case [list \
        [list crlfcrlf_blank $static_fb_crlf_blank transport-frame-noncontiguous] \
        [list midrow_cr $static_fb_midrow transport-wire-cr] \
        [list interleaved $static_fb_interleaved transport-frame-noncontiguous] \
        [list duplicate $static_fb_duplicate transport-frame-count-8] \
        [list tag $static_fb_wrong_tag transport-tag-or-nonce-drift] \
        [list nonce $static_fb_wrong_nonce transport-tag-or-nonce-drift] \
        [list status $static_fb_bad_status transport-status-COMMAND_FAILED] \
        [list count $static_fb_bad_count transport-count-order] \
        [list cap $static_fb_bad_cap transport-cap-] \
        [list length $static_fb_bad_length transport-hex-length] \
        [list digest $static_fb_bad_digest transport-digest-drift] \
        [list hex $static_fb_bad_hex transport-hex-shape] \
        [list nonregular $static_fb_nonregular transport-status-FILE_INVALID] \
        [list truncation $static_fb_truthful_truncated transport-truncated]] {
        lassign $static_fb_case name serial expected
        set decoded [fbstat_transport_decode $serial $static_fb_tag $static_fb_nonce $static_fb_marker]
        if {[lindex $decoded 0] || ![string match "${expected}*" [lindex $decoded 1]]} {
            fail_preflight "static-check-fbstat-transport-$name decoded=$decoded"
        }
    }
    set static_fb_helper [fbstat_transport_guest_helper_script]
    foreach required_fragment [list \
        {cap=131072} {fbstat >"$capture" 2>&1} {[ ! -f "$capture" ]} \
        {[ -L "$capture" ]} {/bin/wc} {/bin/dd} {/bin/xxd -p} \
        {/bin/openssl dgst -sha256 -r} {YT_FBSTAT_TRANSPORT_META}] {
        if {[string first $required_fragment $static_fb_helper] < 0} {
            fail_preflight "static-check-fbstat-transport-helper-missing fragment=$required_fragment"
        }
    }
    }

    # C1 V2 static wire corpus: V2 accepts whole ordinary serial gaps but no
    # foreign, partial, reordered, or binding-drift transport candidate.
    set static_fb_tag probe1
    set static_fb_nonce fbfstatstaticnonce
    set static_fb_marker YTFBSTATSTATICC5
    set static_fb_payload "$c1_t2_fbstat_excerpt\n"
    set static_fb_target_bytes 58986
    append static_fb_payload [string repeat x [expr {$static_fb_target_bytes - [string bytelength $static_fb_payload]}]]
    set static_fb_frame [fbstat_transport_static_frame $static_fb_tag $static_fb_nonce $static_fb_payload]
    set static_fb_logical "$static_fb_frame$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    # Retain the exact live C1 shape that exposed the ordinary outer-terminal
    # contamination: 56,424 decoded bytes become 301 chunks plus BEGIN/META/END
    # (304 recorder rows).  A 26-byte run nonce reproduces its exact bounded
    # logical and CRLF-physical envelope sizes.
    set static_fb_observed_payload [string repeat o 56424]
    set static_fb_observed_nonce [string repeat n 26]
    set static_fb_observed_marker [string repeat M 28]
    set static_fb_observed_frame [fbstat_transport_static_frame idle \
        $static_fb_observed_nonce $static_fb_observed_payload]
    set static_fb_observed_rows [split [string trimright \
        $static_fb_observed_frame "\n"] "\n"]
    set static_fb_observed_logical_bytes [string bytelength \
        $static_fb_observed_frame]
    set static_fb_observed_physical_bytes [expr {
        $static_fb_observed_logical_bytes + [llength $static_fb_observed_rows]}]
    set static_fb_observed_wire \
        "$static_fb_observed_frame$static_fb_observed_marker:RC:0\n$static_fb_observed_marker:FENCE\n"
    if {[llength $static_fb_observed_rows] != 304 ||
        $static_fb_observed_logical_bytes != 148306 ||
        $static_fb_observed_physical_bytes != 148610 ||
        [string first \
            {digest=a1a9707f4ded4a6e2f36f6079023736741c322a7d11763f757240de513aab038} \
            $static_fb_observed_frame] < 0 ||
        ![lindex [fbstat_transport_decode $static_fb_observed_wire idle \
            $static_fb_observed_nonce $static_fb_observed_marker] 0]} {
        fail_preflight "static-check-fbstat-v2-observed-304-row-shape rows=[llength $static_fb_observed_rows] logical=$static_fb_observed_logical_bytes physical=$static_fb_observed_physical_bytes"
    }
    foreach {wire_name wire_eol} [list lf "\n" crlf "\r\n" crcrlf "\r\r\n"] {
        set observed_decoded [fbstat_transport_decode \
            [string map [list "\n" $wire_eol] $static_fb_observed_wire] idle \
            $static_fb_observed_nonce $static_fb_observed_marker]
        if {![lindex $observed_decoded 0] ||
            [binary encode hex [lindex $observed_decoded 2]] ne \
                [binary encode hex $static_fb_observed_payload]} {
            fail_preflight "static-check-fbstat-v2-observed-$wire_name decoded=[fbstat_transport_v2_bounded_report $observed_decoded 256]"
        }
    }
    foreach {wire_name wire_eol} [list lf "\n" crlf "\r\n" crcrlf "\r\r\n"] {
        set decoded [fbstat_transport_decode [string map [list "\n" $wire_eol] $static_fb_logical] \
            $static_fb_tag $static_fb_nonce $static_fb_marker]
        if {![lindex $decoded 0] || [string bytelength [lindex $decoded 2]] != $static_fb_target_bytes} {
            fail_preflight "static-check-fbstat-v2-wire-$wire_name decoded=$decoded"
        }
    }
    set static_fb_preamble [binary format H* 1b5b3f323030346c0d]
    set static_fb_outside_gap "${static_fb_preamble}\nprompt-before\n${static_fb_frame}ordinary-after-end\n$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    if {![lindex [fbstat_transport_decode $static_fb_outside_gap $static_fb_tag $static_fb_nonce $static_fb_marker] 0]} {
        fail_preflight "static-check-fbstat-v2-outside-gap"
    }
    set static_fb_interior_gap [string map [list "\nYT_FBSTAT_TRANSPORT_V2_META" "\nordinary-interior-gap\nYT_FBSTAT_TRANSPORT_V2_META"] $static_fb_outside_gap]
    set static_fb_lines [split [string trimright $static_fb_frame "\n"] "\n"]
    set static_fb_begin [lindex $static_fb_lines 0]
    set static_fb_meta [lindex $static_fb_lines 1]
    set static_fb_chunks [lrange $static_fb_lines 2 end-1]
    set static_fb_end [lindex $static_fb_lines end]
    set static_fb_mid_hex [string map [list {data=} {data=aa
virtio_gpu: historical-mid-hex-weave
bb}] [lindex $static_fb_chunks 0]]
    set static_fb_mid_hex [join [concat [list $static_fb_begin $static_fb_meta $static_fb_mid_hex] [lrange $static_fb_chunks 1 end] [list $static_fb_end "$static_fb_marker:RC:0" "$static_fb_marker:FENCE"]] "\n"]
    append static_fb_mid_hex "\n"
    set static_fb_duplicate "$static_fb_frame$static_fb_frame$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_missing [join [concat [list $static_fb_begin $static_fb_meta] [lrange $static_fb_chunks 1 end] [list $static_fb_end "$static_fb_marker:RC:0" "$static_fb_marker:FENCE"]] "\n"]
    append static_fb_missing "\n"
    set static_fb_reordered [join [concat [list $static_fb_begin $static_fb_meta] [lreverse $static_fb_chunks] [list $static_fb_end "$static_fb_marker:RC:0" "$static_fb_marker:FENCE"]] "\n"]
    append static_fb_reordered "\n"
    set static_fb_foreign "YT_FBSTAT_TRANSPORT_V1_BEGIN tag=x nonce=y\n$static_fb_logical"
    set static_fb_candidate_gap "ordinary\nYT_FBSTAT_TRANSPORT_GARBAGE foreign=1\n$static_fb_logical"
    set static_fb_bad_tag [string map [list "tag=$static_fb_tag" {tag=wrongtag}] $static_fb_logical]
    set static_fb_bad_nonce [string map [list "nonce=$static_fb_nonce" {nonce=wrongnonce}] $static_fb_logical]
    set static_fb_bad_count [string map [list {total_chunks=} {total_chunks=9999 bogus=}] $static_fb_logical]
    set static_fb_bad_status [string map [list {status=OK} {status=COMMAND_FAILED}] $static_fb_logical]
    set static_fb_bad_offset [string map [list {hex_offset=0} {hex_offset=2}] $static_fb_logical]
    set static_fb_bad_len [string map [list {hex_bytes=376} {hex_bytes=375}] $static_fb_logical]
    set static_fb_bad_oversize [string map [list {chunk_hex_max=376} {chunk_hex_max=377}] $static_fb_logical]
    set static_fb_bad_hex [string map [list {data=} {data=g}] $static_fb_logical]
    set static_fb_bad_cursor [string map [list "cursor=$static_fb_target_bytes" {cursor=0}] $static_fb_logical]
    set static_fb_bad_cap [string map [list {cap=131072} {cap=131071}] $static_fb_logical]
    set static_fb_bad_truncated [string map [list {truncated=0} {truncated=1}] $static_fb_logical]
    set static_fb_bad_digest [string map [list "digest=[fbstat_transport_digest $static_fb_payload]" "digest=[string repeat 0 64]"] $static_fb_logical]
    set static_fb_exact_payload [string repeat x $fbstat_transport_payload_cap]
    set static_fb_exact "[fbstat_transport_static_frame $static_fb_tag $static_fb_nonce $static_fb_exact_payload]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_v2_binary_hex 00ff0a7f
    set static_fb_v2_binary_sha 26f9f592b06d4c3c0dd2116492991fff5e4f013a884de18a0c7261ea85de931d
    set static_fb_v2_binary_payload [binary decode hex $static_fb_v2_binary_hex]
    set static_fb_v2_binary_frame "[fbstat_transport_static_frame $static_fb_tag $static_fb_nonce $static_fb_v2_binary_payload]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    set static_fb_v2_binary_decoded [fbstat_transport_decode $static_fb_v2_binary_frame \
        $static_fb_tag $static_fb_nonce $static_fb_marker]
    if {![lindex $static_fb_v2_binary_decoded 0] ||
        [binary encode hex [lindex $static_fb_v2_binary_decoded 2]] ne $static_fb_v2_binary_hex} {
        fail_preflight "static-check-fbstat-v2-binary-decoder decoded=$static_fb_v2_binary_decoded"
    }
    set static_fb_over_payload [string repeat x [expr {$fbstat_transport_payload_cap + 1}]]
    set static_fb_over "[fbstat_transport_static_frame $static_fb_tag $static_fb_nonce $static_fb_over_payload]$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
    foreach {name frame} [list interior_gap $static_fb_interior_gap midhex $static_fb_mid_hex duplicate $static_fb_duplicate missing $static_fb_missing reorder $static_fb_reordered foreign $static_fb_foreign candidate_gap $static_fb_candidate_gap tag $static_fb_bad_tag nonce $static_fb_bad_nonce count $static_fb_bad_count status $static_fb_bad_status offset $static_fb_bad_offset len $static_fb_bad_len oversize $static_fb_bad_oversize hex $static_fb_bad_hex cursor $static_fb_bad_cursor cap $static_fb_bad_cap truncation $static_fb_bad_truncated digest $static_fb_bad_digest overcap $static_fb_over] {
        if {[lindex [fbstat_transport_decode $frame $static_fb_tag $static_fb_nonce $static_fb_marker] 0]} {
            fail_preflight "static-check-fbstat-v2-adversary-accepted name=$name"
        }
    }
    if {![lindex [fbstat_transport_decode $static_fb_exact $static_fb_tag $static_fb_nonce $static_fb_marker] 0]} {
        fail_preflight "static-check-fbstat-v2-exact-cap"
    }
    foreach bad_outer [list \
            [string map [list "$static_fb_marker:RC:0" "$static_fb_marker:RC:7"] $static_fb_logical] \
            [string map [list "$static_fb_marker:FENCE\n" {}] $static_fb_logical] \
            [string map [list "$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n" \
                "$static_fb_marker:RC:0\nnoise-gap\n$static_fb_marker:FENCE\n"] \
                $static_fb_logical]] {
        if {[lindex [fbstat_transport_decode $bad_outer $static_fb_tag $static_fb_nonce $static_fb_marker] 0]} {
            fail_preflight "static-check-fbstat-v2-outer-adversary-accepted"
        }
    }
    set static_fb_timeout [fbstat_transport_v2_timeout_contract $static_fb_marker]
    set static_fb_live_marker_timeout [fbstat_transport_v2_timeout_contract \
        $static_fb_observed_marker]
    set static_fb_v2_timed_wire_bytes [expr {
        [dict get $static_fb_timeout physical_bytes] +
        [dict get $static_fb_timeout outer_physical_bytes] +
        [dict get $static_fb_timeout normal_writer_physical_bytes]
    }]
    if {[dict get $static_fb_timeout chunk_hex_max] != 376 ||
        [dict get $static_fb_timeout total_chunks] != 698 ||
        [dict get $static_fb_timeout record_count] != 701 ||
        [dict get $static_fb_timeout marker_bytes] != [string bytelength $static_fb_marker] ||
        [dict get $static_fb_timeout physical_bytes] != 357781 ||
        [dict get $static_fb_timeout outer_physical_bytes] != 143 ||
        [dict get $static_fb_timeout normal_writer_physical_bytes] != 128 ||
        $static_fb_v2_timed_wire_bytes != 358052 ||
        [dict get $static_fb_timeout wire_ms] != 31081 ||
        [dict get $static_fb_timeout envelope_lock_acquisitions] != 1 ||
        [dict get $static_fb_timeout atomic_terminal_lock_acquisitions] != 1 ||
        [dict get $static_fb_timeout total_lock_acquisitions] != 2 ||
        [dict get $static_fb_timeout per_record_drain_ms] != 0 ||
        [dict get $static_fb_timeout per_record_drain_total_ms] != 0 ||
        [dict get $static_fb_timeout lock_ms] != 100 ||
        [dict get $static_fb_timeout helper_reserve_ms] != 5000 ||
        [dict get $static_fb_timeout total_ms] != 36181 ||
        [dict get $static_fb_timeout seconds] != 37} {
        fail_preflight "static-check-fbstat-v2-timeout-algebra value=$static_fb_timeout"
    }
    set static_fb_live_37_pass [expr {
        37 * 1000 >= [dict get $static_fb_live_marker_timeout total_ms]}]
    set static_fb_live_36_fail [expr {
        36 * 1000 < [dict get $static_fb_live_marker_timeout total_ms]}]
    if {[dict get $static_fb_live_marker_timeout marker_bytes] != 28 ||
        [dict get $static_fb_live_marker_timeout outer_physical_bytes] != 143 ||
        [dict get $static_fb_live_marker_timeout wire_ms] != 31081 ||
        [dict get $static_fb_live_marker_timeout total_lock_acquisitions] != 2 ||
        [dict get $static_fb_live_marker_timeout per_record_drain_ms] != 0 ||
        [dict get $static_fb_live_marker_timeout total_ms] != 36181 ||
        [dict get $static_fb_live_marker_timeout seconds] != 37 ||
        !$static_fb_live_37_pass || !$static_fb_live_36_fail} {
        fail_preflight "static-check-fbstat-v2-live-marker-boundary value=$static_fb_live_marker_timeout pass37=$static_fb_live_37_pass fail36=$static_fb_live_36_fail"
    }

    # Execute the actual generated atomic-terminal shell on the host with a
    # silent recorder stub.  This is C1-only static coverage: the ordinary
    # guest_cmd string is asserted byte-for-byte below and no guest/VM runs.
    set static_c1_atomic_dir "$outdir/c1-atomic-terminal-static"
    if {[file exists $static_c1_atomic_dir]} {
        fail_preflight "static-check-c1-atomic-dir-preexists"
    }
    file mkdir $static_c1_atomic_dir
    set static_c1_atomic_marker YTC1ATOMICSTATICC1
    set static_c1_atomic_prefix "$static_c1_atomic_dir/terminal"
    set static_c1_atomic_path \
        "${static_c1_atomic_prefix}-${static_c1_atomic_marker}"
    set static_c1_atomic_calls "$static_c1_atomic_dir/calls.txt"
    set static_c1_atomic_rows "$static_c1_atomic_dir/rows.txt"
    set static_c1_atomic_mode "$static_c1_atomic_dir/mode.txt"
    set static_c1_atomic_recorder "$static_c1_atomic_dir/consolerecord"
    set static_c1_atomic_recorder_fail \
        "$static_c1_atomic_dir/consolerecord-fail"
    wf $static_c1_atomic_recorder [string map [list \
        @CALLS@ $static_c1_atomic_calls @ROWS@ $static_c1_atomic_rows \
        @MODE@ $static_c1_atomic_mode] {#!/bin/bash
[ "$#" -eq 3 ] && [ "$1" = --terminal-batch-file ] || exit 92
printf 'call\n' >> @CALLS@ || exit 93
/usr/bin/stat -c '%a' "$2" > @MODE@ || exit 94
/bin/cp "$2" @ROWS@ || exit 95
[ "$(/usr/bin/head -n 1 "$2")" = "$3:RC:0" ] || exit 96
/bin/rm "$2" || exit 97
[ ! -e "$2" ] && [ ! -L "$2" ] || exit 98
exit 0
}]
    wf $static_c1_atomic_recorder_fail [string map [list \
        @CALLS@ $static_c1_atomic_calls] {#!/bin/bash
[ "$#" -eq 3 ] && [ "$1" = --terminal-batch-file ] || exit 92
printf 'call\n' >> @CALLS@ || exit 93
/bin/rm "$2" || exit 94
exit 4
