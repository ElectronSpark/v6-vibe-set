        [string first $static_fb_v2_decimal_literal $static_fb_helper] < 0 ||
        [string first $static_fb_v2_initial_wc_guard $static_fb_helper] < 0 ||
        [string first $static_fb_v2_retained_wc_guard $static_fb_helper] < 0 ||
        [string first {if [ "$#" -ne 3 ] || ! valid_decimal "$3"; then exit 68; fi} $static_fb_helper] >= 0 ||
