        $static_render_role_tail_true_frame $static_render_nonce 1 \
        $static_render_launch_marker $static_render_launch_digest \
        $static_render_argv_marker $static_render_argv_digest \
        $static_render_command_marker]
    set static_render_role_tail_valid_frame [string map [list \
        "role_total=[string length $static_render_live_role]" {role_total=4096} \
        {role_tail_truncated=0} {role_tail_truncated=1}] \
        $static_render_valid_frame]
    set static_render_role_tail_valid [render_start_receipt_parse \
        $static_render_role_tail_valid_frame $static_render_nonce 1 \
        $static_render_launch_marker $static_render_launch_digest \
        $static_render_argv_marker $static_render_argv_digest \
        $static_render_command_marker]
    set static_render_tail_outcomes [list \
        [static_render_receipt_outcome $static_render_source_tail_false] \
        [static_render_receipt_outcome $static_render_source_tail_true] \
        [static_render_receipt_outcome $static_render_role_tail_false] \
        [static_render_receipt_outcome $static_render_role_tail_true] \
        [static_render_receipt_outcome $static_render_source_tail_valid] \
        [static_render_receipt_outcome $static_render_role_tail_valid]]
    set static_render_sequence_receipts [list [lindex $static_render_valid 2]]
    for {set static_probe 2} {$static_probe <= 5} {incr static_probe} {
        set marker "YTSTATICRECEIPTC$static_probe"
        set frame [static_render_start_receipt_fixture $static_render_nonce \
            $static_probe $static_render_launch_marker $static_render_launch_digest \
            $static_render_argv_marker $static_render_argv_digest $marker regular \
            $static_render_source 0 $static_render_live_role]
        set parsed [render_start_receipt_parse $frame $static_render_nonce \
            $static_probe $static_render_launch_marker $static_render_launch_digest \
            $static_render_argv_marker $static_render_argv_digest $marker]
        lappend static_render_sequence_receipts [lindex $parsed 2]
    }
    set static_render_sequence_good [render_start_receipt_probe_sequence_valid \
        $static_render_sequence_receipts]
    set static_render_sequence_bad [render_start_receipt_probe_sequence_valid \
        [list [lindex $static_render_sequence_receipts 1] \
              [lindex $static_render_sequence_receipts 0]]]
    set static_render_threshold_edges [list \
        [expr {103 > 3 + 100 && 5 > 4}] \
        [expr {104 > 3 + 100 && 4 > 4}] \
        [expr {104 > 3 + 100 && 5 > 4}]]
    set static_render_threshold_needle [join [list \
        {if } [format %c 123] {[lindex $sample 0] > [expr } \
        [format %c 123] {[lindex $idle 0] + 100} [format %c 125] {] &&}] ""]
    set static_render_threshold_source [expr {
        [string first $static_render_threshold_needle $static_present_source] >= 0 &&
        [string first {[lindex $sample 1] > [lindex $idle 1]} \
            $static_present_source] >= 0
    }]
    set static_render_receipt_body [info body render_start_receipt_probe]
    set static_render_v3_isolation [expr {
        [string first {capture_completeness_diag_v3} $static_render_receipt_body] < 0 &&
        [string first {capture_completeness_diag_v3} \
            [render_start_receipt_guest_helper_script]] < 0
    }]
    set static_render_diag0_arm $capture_completeness_diag
    rename capture_completeness_diag_v3_run static_render_saved_v3_runner
    proc capture_completeness_diag_v3_run {} { error "static-render-v3-route-invoked" }
    set capture_completeness_diag 0
    set static_render_diag0_dispatch [capture_completeness_diag_dispatch]
    set capture_completeness_diag $static_render_diag0_arm
    rename capture_completeness_diag_v3_run {}
    rename static_render_saved_v3_runner capture_completeness_diag_v3_run
    set static_render_js_guest_runtime UNEXECUTED
    set static_render_portability_counts [list \
        [static_render_helper_count_valid "0 0 0\n"] \
        [static_render_helper_count_valid "1 2 2147483647\n"] \
        [static_render_helper_count_valid ""] \
        [static_render_helper_count_valid "1 2 3 4"] \
        [static_render_helper_count_valid "1 x 3"] \
        [static_render_helper_count_valid "1 2 2147483648"]]
    set static_render_portability_hex [list \
        [static_render_helper_hex_valid "" 0] \
        [static_render_helper_hex_valid "000a\n6162" 4] \
        [static_render_helper_hex_valid "00zz" 2] \
        [static_render_helper_hex_valid "00" 2]]
    set static_render_digest [string repeat a 64]
    set static_render_portability_digest [list \
        [static_render_helper_digest_valid "$static_render_digest */tmp/receipt" /tmp/receipt] \
        [static_render_helper_digest_valid "[string repeat A 64] */tmp/receipt" /tmp/receipt] \
        [static_render_helper_digest_valid "$static_render_digest */tmp/wrong" /tmp/receipt] \
        [static_render_helper_digest_valid "$static_render_digest */tmp/receipt extra" /tmp/receipt]]
    set static_render_portability_failclosed [expr {
        [string first {strict_count "$source_log" || fail} $static_render_helper] >= 0 &&
        [string first {/bin/dd if="$source_log"} $static_render_helper] >= 0 &&
        [string first {strict_hex "$source_frame" "$source_bytes" || fail} $static_render_helper] >= 0 &&
        [string first {sha256sum "$} $static_render_helper] < 0 &&
        [string first {| awk} $static_render_helper] < 0 &&
        [string first {| tr} $static_render_helper] < 0 &&
        [string first {od -An} $static_render_helper] < 0
    }]
    set static_render_fbstat_drift_frame [string map [list \
        "fbstat_marker=$static_render_fbstat_marker" {fbstat_marker=YTSTATICFBSTATC9}] \
        $static_render_valid_frame]
    set static_render_fbstat_drift [render_start_receipt_parse \
        $static_render_fbstat_drift_frame $static_render_nonce 1 \
        $static_render_launch_marker $static_render_launch_digest \
        $static_render_argv_marker $static_render_argv_digest \
        $static_render_command_marker $static_render_fbstat_marker]
    set static_c5_marker_drift_rejected [expr {
        ![lindex $static_render_fbstat_drift 0] &&
        [lindex $static_render_fbstat_drift 1] eq "receipt-fbstat-marker-drift"
    }]
    set static_render_source_diag_good "YT_MEDIA_PROBE_V1 kind=start schema=1 nonce=$static_render_nonce samples=20\nYT_MEDIA_PROBE_V1 kind=force_ready schema=1 nonce=$static_render_nonce player_present=1 video_present=1 ready_state=4 video_width=1280 video_height=720\nYT_MEDIA_PROBE_V1 kind=force_observation schema=1 nonce=$static_render_nonce current_time_first=1.000 current_time_last=2.000\n"
    set static_render_source_diag_stalled [string map [list {current_time_last=2.000} {current_time_last=1.000}] $static_render_source_diag_good]
    set static_render_source_diag_missing {YT_MEDIA_PROBE_V1 kind=start schema=1 nonce=__NONCE__ samples=20
}
    set static_render_source_diag_missing [string map [list __NONCE__ $static_render_nonce] $static_render_source_diag_missing]
    set static_render_source_diag_bad_nonce [string map [list "nonce=$static_render_nonce" {nonce=00000000000000000000000000000000}] $static_render_source_diag_good]
    set static_render_source_diag_malformed "YT_MEDIA_PROBE_V1 kind=start schema=1 nonce=$static_render_nonce malformed\n"
    set static_render_source_diag_results [list \
        [render_start_source_diagnostic regular $static_render_source_diag_good $static_render_nonce] \
        [render_start_source_diagnostic regular $static_render_source_diag_stalled $static_render_nonce] \
        [render_start_source_diagnostic regular $static_render_source_diag_missing $static_render_nonce] \
        [render_start_source_diagnostic regular $static_render_source_diag_bad_nonce $static_render_nonce] \
        [render_start_source_diagnostic regular $static_render_source_diag_malformed $static_render_nonce] \
        [render_start_source_diagnostic missing "" $static_render_nonce]]
    set static_render_source_diag_matrix [expr {
        [dict get [lindex $static_render_source_diag_results 0] state] eq "COMPLETE" &&
        [dict get [lindex $static_render_source_diag_results 0] navigation] eq "observed" &&
        [dict get [lindex $static_render_source_diag_results 0] player] eq "ready" &&
        [dict get [lindex $static_render_source_diag_results 0] progress] eq "advancing" &&
        [dict get [lindex $static_render_source_diag_results 1] state] eq "COMPLETE" &&
        [dict get [lindex $static_render_source_diag_results 1] progress] eq "stalled" &&
        [dict get [lindex $static_render_source_diag_results 2] state] eq "INCOMPLETE" &&
        [dict get [lindex $static_render_source_diag_results 3] state] eq "INVALID" &&
        [dict get [lindex $static_render_source_diag_results 4] state] eq "INVALID" &&
        [dict get [lindex $static_render_source_diag_results 5] state] eq "INCOMPLETE"
    }]
    set static_render_fbstat_binding_source [expr {
        [string first {return [list $flips $presents $hms [lindex $result 3]]} \
            [info body fb_sample]] >= 0 &&
        [string first {fbstat_marker} [info body render_start_receipt_probe]] >= 0 &&
        [string first {[lindex $sample 3]} $static_present_source] >= 0
    }]
    set static_render_diagnostic_no_credit [expr {
        [string first {source_diagnostic} [info body render_start_receipt_classify]] < 0 &&
        [string first {diagnostic_only=1 no_fps_claim=1} \
            [info body render_start_receipt_probe]] >= 0
    }]
    # C7's complete control deliberately matches the observed 65--82 KiB
    # census range.  The vector below exists only after host rehash/decode.
    set static_c7_marker YTSTATICC7C7
    set static_c7_payload [join [list \
        {kde_chromium_process_evidence fast phase=fast-001 pid=101 ppid=1 comm="chrome" role="browser" cmd="/chrome" role_source="root_chrome"} \
        {kde_chromium_process_evidence fast phase=fast-001 pid=102 ppid=1 comm="chrome" role="gpu-process" cmd="/chrome --type=gpu-process" role_source="type_arg"} \
        {kde_chromium_process_evidence fast phase=fast-001 pid=103 ppid=1 comm="chrome" role="renderer" cmd="/chrome --type=renderer" role_source="type_arg"} \
        {kde_chromium_process_evidence fast phase=fast-001 pid=104 ppid=1 comm="chrome" role="utility" cmd="/chrome --type=utility --utility-sub-type=network.mojom.NetworkService" role_source="type_arg"} \
        {kde_chromium_process_evidence fast phase=fast-001 pid=105 ppid=1 comm="chrome" role="utility" cmd="/chrome --type=utility --utility-sub-type=audio.mojom.AudioService" role_source="type_arg"} \
        {kde_chromium_process_evidence fast phase=fast-001 pid=106 ppid=1 comm="chrome" role="zygote" cmd="/chrome --type=zygote" role_source="type_arg"} \
        {kde_chromium_process_evidence fast phase=fast-001 pid=107 ppid=1 comm="chrome" role="spare" cmd="/chrome --type=spare" role_source="type_arg"}] "\n"]
    append static_c7_payload "\n"
    append static_c7_payload [string repeat x [expr {70000 - [string bytelength $static_c7_payload]}]]
    set static_c7_valid_frame [static_role_census_diag_frame $static_render_nonce 1 \
        $static_render_launch_marker $static_render_launch_digest \
        $static_render_argv_marker $static_render_argv_digest \
        $static_render_fbstat_marker $static_c7_marker $static_c7_payload]
    set static_c7_valid [role_census_diag_parse $static_c7_valid_frame \
        $static_render_nonce 1 $static_render_launch_marker $static_render_launch_digest \
        $static_render_argv_marker $static_render_argv_digest $static_render_fbstat_marker \
        $static_c7_marker]
    set static_c7_vector [role_census_diag_derive_vector $static_c7_payload]
    set static_c7_complete [expr {[lindex $static_c7_valid 0] &&
        [dict get [lindex $static_c7_valid 2] host_digest] eq [render_start_receipt_digest $static_c7_payload] &&
        [string bytelength $static_c7_payload] >= 65000 &&
        [string bytelength $static_c7_payload] <= 82000 &&
        [dict get $static_c7_vector semantic_rows] == 7 &&
        [dict get $static_c7_vector browser] == 1 && [dict get $static_c7_vector gpu] == 1 &&
        [dict get $static_c7_vector renderer] == 1 && [dict get $static_c7_vector utility] == 2 &&
        [dict get $static_c7_vector network] == 1 && [dict get $static_c7_vector audio] == 1 &&
        [dict get $static_c7_vector zygote] == 1 && [dict get $static_c7_vector other] == 1}]
    set static_c7_lines [split [string trimright $static_c7_valid_frame "\n"] "\n"]
    set static_c7_protocol "[join [lrange $static_c7_lines 0 3] \n]\n"
    set static_c7_terminal "[join [lrange $static_c7_lines 4 end] \n]\n"
    set static_c7_preamble [binary format H* 1b5b3f323030346c0d]
    set static_c7_live_preamble [string map [list \
        YT_ROLE_CENSUS_DIAG_BEGIN "${static_c7_preamble}YT_ROLE_CENSUS_DIAG_BEGIN"] \
        $static_c7_valid_frame]
    set static_c7_preamble_valid [role_census_diag_parse $static_c7_live_preamble \
        $static_render_nonce 1 $static_render_launch_marker $static_render_launch_digest \
        $static_render_argv_marker $static_render_argv_digest $static_render_fbstat_marker \
        $static_c7_marker]
    set static_c7_preamble_foreign "foreign${static_c7_preamble}[string range $static_c7_valid_frame 0 end]"
    set static_c7_preamble_mutated [string map [list \
        YT_ROLE_CENSUS_DIAG_BEGIN "[binary format H* 1b5b3f323030346c]XYT_ROLE_CENSUS_DIAG_BEGIN"] \
        $static_c7_valid_frame]
    set static_c7_preamble_duplicate "${static_c7_preamble}${static_c7_protocol}${static_c7_preamble}${static_c7_protocol}${static_c7_terminal}"
    set static_c7_preamble_nonbegin [string map [list \
        YT_ROLE_CENSUS_DIAG_META "${static_c7_preamble}YT_ROLE_CENSUS_DIAG_META"] \
        $static_c7_valid_frame]
    set static_c7_bad_outer_rc [string map [list "${static_c7_marker}:RC:0" "${static_c7_marker}:RC:7"] $static_c7_valid_frame]
    set static_c7_bad_fence [string map [list "${static_c7_marker}:FENCE\n" ""] $static_c7_valid_frame]
    # Duplicate candidate rows while leaving one valid outer C7 RC/FENCE.
    set static_c7_duplicate "$static_c7_protocol$static_c7_protocol$static_c7_terminal"
    set static_c7_interleave [string map [list \
        "YT_ROLE_CENSUS_DIAG_META" "not-a-census-row\nYT_ROLE_CENSUS_DIAG_META"] $static_c7_valid_frame]
    set static_c7_mid_cr [string map [list {tag=role-census-v1 nonce=} "tag=role-census-v1\r nonce="] $static_c7_valid_frame]
    set static_c7_extra_digest [static_role_census_diag_meta_mutate \
        $static_c7_valid_frame { hex_bytes=} " full_digest=[string repeat 0 64] hex_bytes="]
    set static_c7_extra_vector [static_role_census_diag_meta_mutate \
        $static_c7_valid_frame { hex_bytes=} { browser=999 hex_bytes=}]
    # Every per-field drift is META-only, so this reaches the explicit C7
    # expected-value table instead of being hidden by BEGIN/END rejection.
    set static_c7_wrong_tag [static_role_census_diag_meta_mutate \
        $static_c7_valid_frame {tag=role-census-v1} {tag=wrong-census-v1}]
    set static_c7_wrong_nonce [static_role_census_diag_meta_mutate \
        $static_c7_valid_frame "nonce=$static_render_nonce" {nonce=00000000000000000000000000000000}]
    set static_c7_wrong_probe [static_role_census_diag_meta_mutate \
        $static_c7_valid_frame {probe=1} {probe=2}]
    set static_c7_wrong_c3 [static_role_census_diag_meta_mutate \
        $static_c7_valid_frame "launch_marker=$static_render_launch_marker" {launch_marker=YTSTATICLAUNCHC9}]
    set static_c7_wrong_c4 [static_role_census_diag_meta_mutate \
        $static_c7_valid_frame "argv_marker=$static_render_argv_marker" {argv_marker=YTSTATICARGVC9}]
    set static_c7_wrong_c5 [static_role_census_diag_meta_mutate \
        $static_c7_valid_frame "fbstat_marker=$static_render_fbstat_marker" {fbstat_marker=YTSTATICFBSTATC9}]
    set static_c7_wrong_c7 [static_role_census_diag_meta_mutate \
        $static_c7_valid_frame "c7_marker=$static_c7_marker" {c7_marker=YTSTATICC7C9}]
    set static_c7_key_leading_digit [static_role_census_diag_meta_mutate \
        $static_c7_valid_frame { c7_marker=} { 7_marker=}]
    set static_c7_key_uppercase [static_role_census_diag_meta_mutate \
        $static_c7_valid_frame { c7_marker=} { C7_marker=}]
    set static_c7_key_punctuation [static_role_census_diag_meta_mutate \
        $static_c7_valid_frame { c7_marker=} { c7-marker=}]
    set static_c7_bad_raw [string map [list {raw_bytes=70000} {raw_bytes=69999}] $static_c7_valid_frame]
    set static_c7_bad_payload [string map [list {payload_bytes=70000} {payload_bytes=69999}] $static_c7_valid_frame]
    set static_c7_bad_cap [string map [list {cap=131072} {cap=131071}] $static_c7_valid_frame]
    set static_c7_bad_tail [string map [list {truncated=0} {truncated=1}] $static_c7_valid_frame]
    set static_c7_bad_length [string map [list {hex_bytes=140000} {hex_bytes=1}] $static_c7_valid_frame]
    set static_c7_bad_hex [string map [list {data=6b} {data=g}] $static_c7_valid_frame]
    set static_c7_bad_digest [string map [list "digest=[render_start_receipt_digest $static_c7_payload]" "digest=[string repeat 0 64]"] $static_c7_valid_frame]
    set static_c7_over_payload [string repeat x $role_census_diag_payload_cap]
    set static_c7_truthful_overcap [static_role_census_diag_frame $static_render_nonce 1 \
        $static_render_launch_marker $static_render_launch_digest $static_render_argv_marker \
        $static_render_argv_digest $static_render_fbstat_marker $static_c7_marker \
        $static_c7_over_payload [dict create raw_bytes [expr {$role_census_diag_payload_cap + 1}] truncated 1]]
    set static_c7_file_invalid [static_role_census_diag_frame $static_render_nonce 1 \
        $static_render_launch_marker $static_render_launch_digest $static_render_argv_marker \
        $static_render_argv_digest $static_render_fbstat_marker $static_c7_marker "" \
        [dict create status FILE_INVALID digest unavailable]]
    set static_c7_wire_matrix 1
    set static_c7_wire_details {}
    foreach {wire_name wire_eol} [list lf "\n" crlf "\r\n" crcrlf "\r\r\n"] {
        set parsed [role_census_diag_parse [string map [list "\n" $wire_eol] $static_c7_valid_frame] \
            $static_render_nonce 1 $static_render_launch_marker $static_render_launch_digest \
            $static_render_argv_marker $static_render_argv_digest $static_render_fbstat_marker $static_c7_marker]
        if {![lindex $parsed 0] || [dict get [lindex $parsed 2] host_digest] ne \
                [render_start_receipt_digest $static_c7_payload]} {
            set static_c7_wire_matrix 0
            lappend static_c7_wire_details "$wire_name:$parsed"
        }
    }
    set static_c7_rejects 1
    set static_c7_reject_details {}
    foreach {name frame expected_detail} [list \
            preamble_foreign $static_c7_preamble_foreign census-preamble-invalid \
            preamble_mutated $static_c7_preamble_mutated census-preamble-invalid \
            preamble_duplicate $static_c7_preamble_duplicate census-preamble-duplicate \
            preamble_nonbegin $static_c7_preamble_nonbegin census-preamble-placement \
            outer_rc $static_c7_bad_outer_rc census-command-status-7 \
            fence $static_c7_bad_fence census-command-frame-frame-fence-count-0 \
            duplicate $static_c7_duplicate census-frame-count-8 \
            interleave $static_c7_interleave census-frame-noncontiguous \
            mid_cr $static_c7_mid_cr census-wire-cr \
            extra_digest $static_c7_extra_digest census-meta-field-count-drift \
            extra_vector $static_c7_extra_vector census-meta-field-count-drift \
            tag $static_c7_wrong_tag census-meta-tag-drift \
            nonce $static_c7_wrong_nonce census-meta-nonce-drift \
            probe $static_c7_wrong_probe census-meta-probe-drift \
            c3 $static_c7_wrong_c3 census-meta-launch_marker-drift \
            c4 $static_c7_wrong_c4 census-meta-argv_marker-drift \
            c5 $static_c7_wrong_c5 census-meta-fbstat_marker-drift \
            c7 $static_c7_wrong_c7 census-meta-c7_marker-drift \
            key_digit $static_c7_key_leading_digit census-meta-parse-drift \
            key_upper $static_c7_key_uppercase census-meta-parse-drift \
            key_punctuation $static_c7_key_punctuation census-meta-parse-drift \
            raw $static_c7_bad_raw census-count-order \
            payload $static_c7_bad_payload census-truncation-drift \
            cap $static_c7_bad_cap census-cap-drift \
            truncation $static_c7_bad_tail census-truncation-drift \
            length $static_c7_bad_length census-hex-length \
            hex $static_c7_bad_hex census-hex-shape \
            digest $static_c7_bad_digest census-digest-drift \
            overcap $static_c7_truthful_overcap census-over-cap \
            status $static_c7_file_invalid census-status-FILE_INVALID] {
        set parsed [role_census_diag_parse $frame $static_render_nonce 1 \
            $static_render_launch_marker $static_render_launch_digest \
            $static_render_argv_marker $static_render_argv_digest $static_render_fbstat_marker \
            $static_c7_marker]
        if {[lindex $parsed 0] || ![string match "${expected_detail}*" [lindex $parsed 1]]} {
            set static_c7_rejects 0
            lappend static_c7_reject_details "$name:$parsed"
        }
    }
    if {![lindex $static_c7_preamble_valid 0] ||
        [dict get [lindex $static_c7_preamble_valid 2] host_digest] ne \
