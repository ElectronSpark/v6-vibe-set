            "$static_c1_atomic_marker:FENCE\n" \
            "$static_c1_atomic_marker:FENCE\n$static_c1_atomic_marker:RC:0\n" \
            "$static_c1_atomic_marker:RC:0\n$static_c1_atomic_marker:RC:0\n$static_c1_atomic_marker:FENCE\n" \
            "WRONGMARKER:RC:0\nWRONGMARKER:FENCE\n" \
            "$static_c1_atomic_marker:RC:notnumeric\n$static_c1_atomic_marker:FENCE\n" \
            "$static_c1_atomic_marker:RC:7\n$static_c1_atomic_marker:FENCE\n" \
