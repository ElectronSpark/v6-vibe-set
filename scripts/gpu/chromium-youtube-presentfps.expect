}
set force_hd720 [expr {[info exists env(YT_FORCE_HD720)] ? $env(YT_FORCE_HD720) : "0"}]
set force_hd720_contract [force_hd720_arm_contract \
    $multiprocess $disable_audio $egl_forensics $media_probe $force_hd720]
if {![lindex $force_hd720_contract 0]} {
    fail_preflight [lindex $force_hd720_contract 1]
}
set capture_completeness_diag [expr {[info exists env(YT_CAPTURE_COMPLETENESS_DIAG)] ? $env(YT_CAPTURE_COMPLETENESS_DIAG) : "0"}]
set capture_completeness_diag_contract [capture_completeness_diag_arm_contract \
    $multiprocess $disable_audio $egl_forensics $media_probe $force_hd720 \
    $capture_completeness_diag]
if {![lindex $capture_completeness_diag_contract 0]} {
