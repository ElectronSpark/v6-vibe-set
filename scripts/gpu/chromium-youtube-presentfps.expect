            $static_c1_atomic_recorder $static_c1_atomic_prefix]]
    if {[lsearch -exact $static_c1_atomic_preexist_results 0] >= 0 ||
        ![dict get $static_c1_atomic_create_failure caught] ||
        [dict get $static_c1_atomic_create_failure stdout] ne "" ||
        [dict get $static_c1_atomic_create_failure stderr] ne "" ||
        ![dict get $static_c1_atomic_command_failure caught] ||
        [dict get $static_c1_atomic_command_failure stdout] ne "" ||
