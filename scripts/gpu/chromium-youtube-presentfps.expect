}
set arm [expr {$c1_terminal_reducer eq "1" ? "c1-terminal-reducer" :
               ($capture_completeness_diag eq "1" ? "media-probe-hd720-capturediag" :
               ($force_hd720 eq "1" ? "media-probe-hd720" :
               ($media_probe eq "1" ? "media-probe" :
               ($egl_forensics eq "1" ? "egl-forensics" :
               ($multiprocess eq "1" ? "multiprocess" : "single-process")))))}]

