#!/usr/bin/env expect
# Strict A1 YouTube frame-supply A/B driver.  Each invocation runs one arm;
# callers must provide both arm values explicitly and use N>=2 runs per arm.
#
# Required environment:
#   YT_MULTIPROCESS=0|1
#   YT_DISABLE_AUDIO_OUTPUT=1
#
# Optional environment:
#   YT_EGL_FORENSICS=0|1               (default 0; only valid with MP/audio=1)
#   YT_MEDIA_PROBE=0|1                 (default 0; 1 requires MP/audio=1,
#                                       forensics=0 and proves source before FPS)
#   YT_FORCE_HD720=0|1                 (default 0; 1 additionally requires the
#                                       exact media-probe arm and forces hd720)
#   YT_CAPTURE_COMPLETENESS_DIAG=0|1    (default 0; 1 is a diagnostic-only
#                                       forced-hd720 media arm.  It collects
#                                       bounded timer/rVFC/fbstat context and
#                                       exits before FPS windows.)
#   YT_C1_TERMINAL_REDUCER=0|1          (default 0; 1 is a host-driver-only,
#                                       diagnostic reducer that exits before
#                                       Chromium, capture, and FPS paths.)
#   YT_OUTDIR=<new/empty run directory>  (default is a unique timestamped dir)
#   YT_WINDOW_SECONDS=<seconds>           (default 60)
#   YT_PLAYER_CROP=<WxH+X+Y>              (default 960x540+160+130)
#   YT_PLAYER_DELTA_MIN=<pixels>          (default 1000 per window)
#
# Normal runs report compositor page-flip/BO-present rates and require guest-fb
# player deltas.  The default-off media probe injects a bounded content
# extension and additionally captures media state, playback-quality counters,
# rVFC cadence and long tasks.  A probe run reaches the FPS windows only after
# independently proving 1280x720 at approximately 16.7ms source cadence.
# PERF-VIDEO remains the separate local-video comparison instrument.

set timeout 900
set root [exec sh -c "cd [file dirname [info script]]/../.. && pwd"]
set kernel "$root/build-x86_64/kernel/build/kernel/xv6.bin"
set fsimg "$root/build-x86_64/fs.img"

proc fail_preflight {message {code 2}} {
    puts stderr "YT-PRESENTFPS-PREFLIGHT-FAIL $message"
    exit $code
}

proc forensics_arm_contract {multiprocess disable_audio forensics} {
    if {$forensics ne "0" && $forensics ne "1"} {
        return [list 0 "YT_EGL_FORENSICS-must-be-0-or-1 value=$forensics"]
    }
    if {$forensics eq "1" &&
        ($multiprocess ne "1" || $disable_audio ne "1")} {
        return [list 0 "YT_EGL_FORENSICS-requires-multiprocess-1-audio-1 multiprocess=$multiprocess audio=$disable_audio"]
    }
    return [list 1 "forensics=$forensics multiprocess=$multiprocess audio=$disable_audio"]
}

proc media_probe_arm_contract {multiprocess disable_audio forensics media_probe} {
    if {$media_probe ne "0" && $media_probe ne "1"} {
        return [list 0 "YT_MEDIA_PROBE-must-be-0-or-1 value=$media_probe"]
    }
    if {$media_probe eq "1" &&
        ($multiprocess ne "1" || $disable_audio ne "1" || $forensics ne "0")} {
        return [list 0 "YT_MEDIA_PROBE-requires-multiprocess-1-audio-1-forensics-0 multiprocess=$multiprocess audio=$disable_audio forensics=$forensics"]
    }
    return [list 1 "media_probe=$media_probe multiprocess=$multiprocess audio=$disable_audio forensics=$forensics"]
}

proc force_hd720_arm_contract {multiprocess disable_audio forensics media_probe force_hd720} {
    if {$force_hd720 ne "0" && $force_hd720 ne "1"} {
        return [list 0 "YT_FORCE_HD720-must-be-0-or-1 value=$force_hd720"]
    }
    if {$force_hd720 eq "1" &&
        ($multiprocess ne "1" || $disable_audio ne "1" ||
         $forensics ne "0" || $media_probe ne "1")} {
        return [list 0 "YT_FORCE_HD720-requires-multiprocess-1-audio-1-forensics-0-media-probe-1 multiprocess=$multiprocess audio=$disable_audio forensics=$forensics media_probe=$media_probe"]
    }
    return [list 1 "force_hd720=$force_hd720 media_probe=$media_probe multiprocess=$multiprocess audio=$disable_audio forensics=$forensics"]
}

proc capture_completeness_diag_arm_contract {
    multiprocess disable_audio forensics media_probe force_hd720 diagnostic
} {
    if {$diagnostic ne "0" && $diagnostic ne "1"} {
        return [list 0 "YT_CAPTURE_COMPLETENESS_DIAG-must-be-0-or-1 value=$diagnostic"]
    }
    if {$diagnostic eq "1" &&
        ($multiprocess ne "1" || $disable_audio ne "1" ||
         $forensics ne "0" || $media_probe ne "1" || $force_hd720 ne "1")} {
        return [list 0 "YT_CAPTURE_COMPLETENESS_DIAG-requires-multiprocess-1-audio-1-forensics-0-media-probe-1-force-hd720-1 multiprocess=$multiprocess audio=$disable_audio forensics=$forensics media_probe=$media_probe force_hd720=$force_hd720"]
    }
    return [list 1 "capture_completeness_diag=$diagnostic force_hd720=$force_hd720 media_probe=$media_probe multiprocess=$multiprocess audio=$disable_audio forensics=$forensics"]
}

proc c1_terminal_reducer_arm_contract {capture_diagnostic reducer} {
    if {$reducer ne "0" && $reducer ne "1"} {
        return [list 0 "YT_C1_TERMINAL_REDUCER-must-be-0-or-1 value=$reducer"]
    }
    if {$reducer eq "1" && $capture_diagnostic eq "1"} {
        return [list 0 "YT_C1_TERMINAL_REDUCER-mutually-exclusive-with-capture-diagnostic"]
    }
    return [list 1 "c1_terminal_reducer=$reducer capture_diagnostic=$capture_diagnostic"]
}

# Diagnostic capture has its own terminal evidence.  It retains the shared
# renderer/fbstat safety gate, but must not create or require the normal
# pre/steady/window/media frame set before it can report timer/rVFC liveness.
proc capture_completeness_diag_requires_normal_frames {diagnostic} {
    return [expr {$diagnostic ne "1"}]
}

proc media_probe_random_nonce {} {
    if {[catch {exec sh -c {od -An -N16 -tx1 /dev/urandom | tr -d ' \n'}} nonce]} {
        return [list 0 "urandom-read-failed"]
    }
    set nonce [string trim $nonce]
    if {![regexp {^[0-9a-f]{32}$} $nonce]} {
        return [list 0 "urandom-nonce-invalid"]
    }
    return [list 1 $nonce]
}

proc media_probe_process_filter_command {} {
    # Guest `ps` prints parent/name rather than argv.  Therefore the literal
    # middle substring matches chrome, Chromium, and chrome_crashpad names but
    # does not match the transient bash/grep row itself.
    return {ps 2>/dev/null | grep hrom}
}

proc guest_helper_grep_option_contract {name script} {
    set errors {}
    set line_number 0
    foreach raw_line [split $script "\n"] {
        incr line_number
        set line [string trim $raw_line]
        if {$line eq "" || [string index $line 0] eq "#"} { continue }
        if {[regexp {(^|[ \t|;&])(/bin/)?pgrep([ \t]|$)} $line]} {
            lappend errors "line-$line_number-pgrep-forbidden"
        }
        set search_from 0
        while {[regexp -indices -start $search_from \
            {(^|[ \t|;&])(/bin/)?grep[ \t]+([^|;&]*)} $line \
            whole prefix binary arguments]} {
            set argument_text [string range $line \
                [lindex $arguments 0] [lindex $arguments 1]]
            if {[regexp {(^|[ \t])['\"]?--?[A-Za-z]} $argument_text]} {
                lappend errors "line-$line_number-grep-option-operand"
            }
            set search_from [expr {[lindex $whole 1] + 1}]
        }
        if {[string first {"$grep_bin"} $line] >= 0} {
            set variable_arguments [string range $line \
                [expr {[string first {"$grep_bin"} $line] + 11}] end]
            if {[regexp {(^|[ \t])['\"]?--?[A-Za-z]} $variable_arguments]} {
                lappend errors "line-$line_number-variable-grep-option-operand"
            }
        }
    }
    if {[llength $errors] > 0} {
        return [list 0 "helper=$name errors=[join $errors ,]"]
    }
    return [list 1 "helper=$name guest_grep_options=none pgrep=none"]
}

proc media_probe_guest_helper_script {nonce {overrides {}}} {
    if {![regexp {^[0-9a-f]{32}$} $nonce]} {
        error "invalid media-probe helper nonce"
    }
    set config [dict create \
        grep_bin /bin/grep \
        source_log /host-gui-wayland-chromium.log \
        capture_log /yt-media-probe.log \
        temp_prefix /tmp/yt-media-probe \
        do_sync 1]
    if {[catch {dict size $overrides}]} {
        error "media-probe helper overrides must be a dictionary"
    }
    dict for {key value} $overrides {
        if {![dict exists $config $key]} {
            error "unknown media-probe helper option: $key"
        }
        dict set config $key $value
    }
    foreach key {grep_bin source_log capture_log temp_prefix} {
        set value [dict get $config $key]
        if {![regexp {^/[A-Za-z0-9._/+:-]+$} $value] ||
            [regexp {(^|/)\.\.?(/|$)} $value]} {
            error "invalid media-probe helper path for $key"
        }
    }
    set do_sync [dict get $config do_sync]
    if {$do_sync ne "0" && $do_sync ne "1"} {
        error "invalid media-probe helper do_sync"
    }
    return [string map [list \
        @NONCE@ $nonce \
        @GREP_BIN@ [dict get $config grep_bin] \
        @SOURCE_LOG@ [dict get $config source_log] \
        @CAPTURE_LOG@ [dict get $config capture_log] \
        @TEMP_PREFIX@ [dict get $config temp_prefix] \
        @DO_SYNC@ $do_sync] {#!/bin/bash
set +e
grep_bin='@GREP_BIN@'
source_log='@SOURCE_LOG@'
capture_log='@CAPTURE_LOG@'
temp_prefix='@TEMP_PREFIX@'
do_sync='@DO_SYNC@'
capture_tmp="${temp_prefix}.capture"
rm -f "$capture_tmp" "$capture_log"
"$grep_bin" 'YT_MEDIA_PROBE_V1 kind=.* schema=1 nonce=@NONCE@ ' "$source_log" > "$capture_tmp" 2>/dev/null
/bin/dd if="$capture_tmp" of="$capture_log" bs=1024 count=48 2>/dev/null
echo YT_MEDIA_PROBE_CAPTURE_BEGIN nonce=@NONCE@ status=oneshot polls=0 byte_cap=49152
cat "$capture_log" 2>/dev/null
echo YT_MEDIA_PROBE_CAPTURE_END nonce=@NONCE@ status=oneshot polls=0 byte_cap=49152
rm -f "$capture_tmp"
if [ "$do_sync" = 1 ]; then sync; fi
}]
}

# Normal A1 render-start forensics use a short role census plus a bounded tail
# of the authoritative launcher log.  The payload is hex framed so arbitrary
# launcher/role text cannot forge a receipt delimiter on the serial stream.
proc render_start_receipt_guest_helper_script {} {
    return {#!/bin/bash
nonce="$1"
probe="$2"
launch_marker="$3"
launch_digest="$4"
argv_marker="$5"
argv_digest="$6"
fbstat_marker="$7"
if [ "${#nonce}" -ne 32 ]; then exit 64; fi
case "$nonce" in *[!0-9a-f]*) exit 64 ;; esac
case "$probe" in ''|*[!0-9]*) exit 64 ;; esac
case "$launch_marker" in ''|*[!A-Za-z0-9]*) exit 64 ;; esac
case "$argv_marker" in ''|*[!A-Za-z0-9]*) exit 64 ;; esac
case "$fbstat_marker" in ''|*[!A-Za-z0-9]*) exit 64 ;; esac
if [ "${#launch_digest}" -ne 64 ] || [ "${#argv_digest}" -ne 64 ]; then exit 64; fi
case "$launch_digest" in *[!0-9a-f]*) exit 64 ;; esac
case "$argv_digest" in *[!0-9a-f]*) exit 64 ;; esac

# The current guest intentionally has neither awk/tr/od/sha256sum nor a
# `wc -c` option parser.  These helpers accept only the exact output grammar
# from the tools we stage in the current rootfs; a utility/format failure is a
# failed command, never a fabricated receipt status.
set -f
strict_count() {
  count_text=$(/bin/wc < "$1") || return 1
  set -- $count_text
  [ "$#" -eq 3 ] || return 1
  case "$1" in ''|*[!0-9]*) return 1 ;; esac
  case "$2" in ''|*[!0-9]*) return 1 ;; esac
  case "$3" in ''|*[!0-9]*) return 1 ;; esac
  [ "$3" -le 2147483647 ] 2>/dev/null || return 1
  STRICT_COUNT=$3
}
strict_hex() {
  hex_path=$1
  hex_bytes=$2
  hex_text=$(/bin/xxd -p "$hex_path") || return 1
  set -- $hex_text
  joined_hex=
  for hex_token in "$@"; do
    case "$hex_token" in ''|*[!0-9a-f]*) return 1 ;; esac
    joined_hex="${joined_hex}${hex_token}"
  done
  [ "${#joined_hex}" -eq $((2 * hex_bytes)) ] 2>/dev/null || return 1
  STRICT_HEX=$joined_hex
}
strict_digest() {
  digest_path=$1
  digest_text=$(/bin/openssl dgst -sha256 -r "$digest_path") || return 1
  set -- $digest_text
  [ "$#" -eq 2 ] || return 1
  [ "${#1}" -eq 64 ] || return 1
  case "$1" in *[!0-9a-f]*) return 1 ;; esac
  [ "$2" = "*$digest_path" ] || return 1
  STRICT_DIGEST=$1
}
classify_role_state() {
  role_state=none_or_exited
  if [ "$role_status" -ne 0 ]; then
    role_state=command_failed
  else
    while IFS= read -r role_line; do
      if [[ "$role_line" =~ ^kde_chromium_process_evidence[[:space:]]+fast[[:space:]].*comm=\"chrome\"[[:space:]]+role=\"[A-Za-z0-9_-]+\"[[:space:]].*cmd=\" ]]; then
        role_state=live
        break
      fi
    done < "$role_frame"
  fi
}
cleanup() { rm -f "$source_frame" "$role_stdout" "$role_frame"; }
fail() { exit 70; }
source_log=/host-gui-wayland-chromium.log
source_cap=2048
role_cap=4096
tmp=/tmp/yt-render-start-receipt-$$
source_frame="$tmp.source"
role_evidence=/kde-chromium-process-evidence.log
role_stdout="$tmp.role.stdout"
role_frame="$tmp.role"
rm -f "$source_frame" "$role_stdout" "$role_frame"
trap cleanup EXIT
: > "$source_frame"
: > "$role_frame"

capture_role_evidence() {
  rm -f "$role_evidence" || return 1
  if [ -e "$role_evidence" ] || [ -L "$role_evidence" ]; then return 1; fi
  if [ "${YT_RENDER_START_ROLE_TEST_ONLY:-0}" = 1 ]; then
    role_test_mode=${YT_RENDER_START_ROLE_TEST_MODE-}
    role_test_stdout=${YT_RENDER_START_ROLE_TEST_STDOUT-}
    role_test_evidence=${YT_RENDER_START_ROLE_TEST_EVIDENCE-}
    printf '%s' "$role_test_stdout" > "$role_stdout" || return 1
    case "$role_test_mode" in
      fresh|over-cap)
        printf '%s' "$role_test_evidence" > "$role_evidence" || return 1
        role_status=0
        ;;
      missing|stdout-only|stale)
        role_status=0
        ;;
      nonregular)
        mkdir "$role_evidence" || return 1
        role_status=0
        ;;
      unreadable)
        printf '%s' "$role_test_evidence" > "$role_evidence" || return 1
        chmod 000 "$role_evidence" || return 1
        role_status=0
        ;;
      command-failed)
        role_status=17
        ;;
      *) return 1 ;;
    esac
  else
    KDE_APP_LAUNCH_PROBE_STDERR_TO_STDOUT=1 /bin/kde-app-launch-probe \
      --chromium-fast-census-only --fast-census-ms 500 --fast-census-interval-ms 100 \
      > "$role_stdout" 2>&1
    role_status=$?
  fi
  if [ "$role_status" -ne 0 ]; then
    : > "$role_frame" || return 1
    return 0
  fi
  [ -e "$role_evidence" ] && [ -r "$role_evidence" ] && \
    [ -f "$role_evidence" ] && [ ! -L "$role_evidence" ] || return 1
  /bin/dd if="$role_evidence" of="$role_frame" bs=1024 count=4 2>/dev/null || return 1
  strict_count "$role_evidence" || return 1
  role_total=$STRICT_COUNT
  strict_count "$role_frame" || return 1
  role_bytes=$STRICT_COUNT
  strict_digest "$role_frame" || return 1
  role_digest=$STRICT_DIGEST
  role_tail_truncated=0
  if [ "$role_total" -gt "$role_bytes" ]; then role_tail_truncated=1; fi
  return 0
}

if [ "${YT_RENDER_START_ROLE_TEST_ONLY:-0}" = 1 ]; then
  role_evidence=${YT_RENDER_START_ROLE_TEST_EVIDENCE_PATH-}
  [ -n "$role_evidence" ] || exit 64
  capture_role_evidence || exit 70
  if [ "$role_status" -ne 0 ]; then
    role_total=0
    role_bytes=0
    role_digest=$(printf '' | /bin/openssl dgst -sha256 -r 2>/dev/null) || exit 70
    set -- $role_digest
    [ "$#" -eq 2 ] && [ "${#1}" -eq 64 ] || exit 70
    role_digest=$1
    role_tail_truncated=0
  fi
  classify_role_state
  printf 'YT_RENDER_START_ROLE_TEST_STATE %s total=%s bytes=%s truncated=%s digest=%s\n' \
    "$role_state" "$role_total" "$role_bytes" "$role_tail_truncated" "$role_digest"
  exit 0
fi

source_status=missing
source_cursor=0
source_bytes=0
source_digest=unavailable
source_tail_truncated=0
if [ -e "$source_log" ] || [ -L "$source_log" ]; then
  if [ ! -r "$source_log" ]; then
    source_status=unreadable
  elif [ ! -f "$source_log" ] || [ -L "$source_log" ]; then
    source_status=nonregular
  else
    source_status=regular
    strict_count "$source_log" || fail
    source_cursor=$STRICT_COUNT
    source_offset=0
    if [ "$source_cursor" -gt "$source_cap" ]; then
      source_offset=$((source_cursor - source_cap))
    fi
    /bin/dd if="$source_log" of="$source_frame" bs=1 skip="$source_offset" count="$source_cap" 2>/dev/null || fail
    strict_count "$source_frame" || fail
    source_bytes=$STRICT_COUNT
    strict_digest "$source_frame" || fail
    source_digest=$STRICT_DIGEST
    if [ "$source_cursor" -gt "$source_bytes" ]; then source_tail_truncated=1; fi
  fi
fi

capture_role_evidence || fail
if [ "$role_status" -ne 0 ]; then
  role_total=0
  role_bytes=0
  strict_digest "$role_frame" || fail
  role_digest=$STRICT_DIGEST
  role_tail_truncated=0
fi
classify_role_state
strict_hex "$source_frame" "$source_bytes" || fail
source_hex=$STRICT_HEX
strict_hex "$role_frame" "$role_bytes" || fail
role_hex=$STRICT_HEX
printf 'YT_RENDER_START_RECEIPT_BEGIN nonce=%s probe=%s\n' "$nonce" "$probe"
printf 'YT_RENDER_START_RECEIPT_META nonce=%s probe=%s launch_marker=%s launch_digest=%s argv_marker=%s argv_digest=%s fbstat_marker=%s source_status=%s source_cursor=%s source_bytes=%s source_digest=%s source_tail_truncated=%s role_command=fast-census-v1 role_status=%s role_total=%s role_bytes=%s role_digest=%s role_tail_truncated=%s role_state=%s\n' \
  "$nonce" "$probe" "$launch_marker" "$launch_digest" "$argv_marker" "$argv_digest" "$fbstat_marker" \
  "$source_status" "$source_cursor" "$source_bytes" "$source_digest" "$source_tail_truncated" \
  "$role_status" "$role_total" "$role_bytes" "$role_digest" "$role_tail_truncated" "$role_state"
printf 'YT_RENDER_START_RECEIPT_SOURCE_HEX %s\n' "$source_hex"
printf 'YT_RENDER_START_RECEIPT_ROLE_HEX %s\n' "$role_hex"
printf 'YT_RENDER_START_RECEIPT_END nonce=%s probe=%s\n' "$nonce" "$probe"
exit 0
}
}

proc capture_completeness_diag_guest_helper_script {nonce {overrides {}}} {
    if {![regexp {^[0-9a-f]{32}$} $nonce]} {
        error "invalid capture-completeness helper nonce"
    }
    set config [dict create \
        grep_bin /bin/grep \
        source_log /host-gui-wayland-chromium.log \
        capture_log /yt-capture-completeness.log \
        temp_prefix /tmp/yt-capture-completeness \
        do_sync 1]
    if {[catch {dict size $overrides}]} {
        error "capture-completeness helper overrides must be a dictionary"
    }
    dict for {key value} $overrides {
        if {![dict exists $config $key]} {
            error "unknown capture-completeness helper option: $key"
        }
        dict set config $key $value
    }
    foreach key {grep_bin source_log capture_log temp_prefix} {
        set value [dict get $config $key]
        if {![regexp {^/[A-Za-z0-9._/+:-]+$} $value] ||
            [regexp {(^|/)\.\.?(/|$)} $value]} {
            error "invalid capture-completeness helper path for $key"
        }
    }
    set do_sync [dict get $config do_sync]
    if {$do_sync ne "0" && $do_sync ne "1"} {
        error "invalid capture-completeness helper do_sync"
    }
    return [string map [list \
        @NONCE@ $nonce \
        @GREP_BIN@ [dict get $config grep_bin] \
        @SOURCE_LOG@ [dict get $config source_log] \
        @CAPTURE_LOG@ [dict get $config capture_log] \
        @TEMP_PREFIX@ [dict get $config temp_prefix] \
        @DO_SYNC@ $do_sync] {#!/bin/bash
set +e
grep_bin='@GREP_BIN@'
source_log='@SOURCE_LOG@'
capture_log='@CAPTURE_LOG@'
temp_prefix='@TEMP_PREFIX@'
do_sync='@DO_SYNC@'
capture_tmp="${temp_prefix}.capture"
source_tmp="${temp_prefix}.source"
ready_tmp="${temp_prefix}.ready"
mode="${1:-legacy}"
rm -f "$capture_tmp" "$capture_log" "$source_tmp" "$ready_tmp"
case "$mode" in
  legacy)
    "$grep_bin" 'YT_CAPTURE_COMPLETENESS_V1 kind=.* schema=1 nonce=@NONCE@ ' "$source_log" > "$capture_tmp" 2>/dev/null
    /bin/dd if="$capture_tmp" of="$capture_log" bs=1024 count=16 2>/dev/null
    echo YT_CAPTURE_COMPLETENESS_CAPTURE_BEGIN nonce=@NONCE@ status=oneshot byte_cap=16384
    cat "$capture_log" 2>/dev/null
    echo YT_CAPTURE_COMPLETENESS_CAPTURE_END nonce=@NONCE@ status=oneshot byte_cap=16384
    ;;
  producer-start|post-video-hd720|collect)
    source_status=missing
    source_bytes=0
    source_digest=unavailable
    grep_status=unavailable
    matched_rows=0
    matched_bytes=0
    ready_digest=unavailable
    case "$mode" in
      producer-start)
        phase=producer_start
        capture_pattern='YT_CAPTURE_COMPLETENESS_V2 kind=producer_start schema=2 nonce=@NONCE@ '
        need_ready_digest=0
        ;;
      post-video-hd720)
        phase=post_video_hd720
        capture_pattern='YT_CAPTURE_COMPLETENESS_V2 kind=post_video_hd720_ready schema=2 nonce=@NONCE@ '
        need_ready_digest=1
        ;;
      collect)
        phase=collect
        capture_pattern='YT_CAPTURE_COMPLETENESS_V2 kind=\(timer_arm\|timer_fire\|rvfc_checkpoint\|done\) schema=2 nonce=@NONCE@ '
        need_ready_digest=1
        ;;
    esac
    if [ -e "$source_log" ] || [ -L "$source_log" ]; then
      if [ ! -r "$source_log" ]; then
        source_status=unreadable
      elif [ ! -f "$source_log" ] || [ -L "$source_log" ]; then
        source_status=nonregular
      else
        source_status=readable
        /bin/dd if="$source_log" of="$source_tmp" bs=1024 count=64 2>/dev/null
        source_bytes=$(wc -c < "$source_tmp" 2>/dev/null)
        source_bytes=${source_bytes//[[:space:]]/}
        source_digest=$(sha256sum "$source_tmp" 2>/dev/null | awk '{print $1}')
        if [ -z "$source_digest" ]; then source_digest=unavailable; fi
        "$grep_bin" "$capture_pattern" "$source_log" > "$capture_tmp" 2>/dev/null
        grep_status=$?
        /bin/dd if="$capture_tmp" of="$capture_log" bs=1024 count=16 2>/dev/null
        matched_rows=$(wc -l < "$capture_log" 2>/dev/null)
        matched_rows=${matched_rows//[[:space:]]/}
        matched_bytes=$(wc -c < "$capture_log" 2>/dev/null)
        matched_bytes=${matched_bytes//[[:space:]]/}
        if [ "$need_ready_digest" = 1 ]; then
          "$grep_bin" 'YT_CAPTURE_COMPLETENESS_V2 kind=post_video_hd720_ready schema=2 nonce=@NONCE@ ' "$source_log" > "$ready_tmp" 2>/dev/null
          ready_grep_status=$?
          ready_rows=$(wc -l < "$ready_tmp" 2>/dev/null)
          ready_rows=${ready_rows//[[:space:]]/}
          if [ "$ready_grep_status" = 0 ] && [ "$ready_rows" = 1 ]; then
            ready_digest=$(sha256sum "$ready_tmp" 2>/dev/null | awk '{print $1}')
            if [ -z "$ready_digest" ]; then ready_digest=unavailable; fi
          fi
        fi
      fi
    fi
    echo YT_CAPTURE_COMPLETENESS_SOURCE_V2 nonce=@NONCE@ phase=$phase source_status=$source_status source_bytes=$source_bytes source_digest=$source_digest grep_status=$grep_status matched_rows=$matched_rows matched_bytes=$matched_bytes ready_digest=$ready_digest
    echo YT_CAPTURE_COMPLETENESS_CAPTURE_BEGIN nonce=@NONCE@ status=oneshot byte_cap=16384
    cat "$capture_log" 2>/dev/null
    echo YT_CAPTURE_COMPLETENESS_CAPTURE_END nonce=@NONCE@ status=oneshot byte_cap=16384
    ;;
  *)
    echo YT_CAPTURE_COMPLETENESS_SOURCE_V2 nonce=@NONCE@ phase=producer_start source_status=nonregular source_bytes=0 source_digest=unavailable grep_status=unavailable matched_rows=0 matched_bytes=0 ready_digest=unavailable
    ;;
esac
rm -f "$capture_tmp" "$source_tmp" "$ready_tmp"
if [ "$do_sync" = 1 ]; then sync; fi
}]
}

foreach required {YT_MULTIPROCESS YT_DISABLE_AUDIO_OUTPUT} {
    if {![info exists env($required)]} {
        fail_preflight "missing-required-env=$required"
    }
}
