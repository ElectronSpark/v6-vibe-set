        }
        set run [static_c1_atomic_run \
            [c1_atomic_outer_terminal_shell_command true \
                $static_c1_atomic_marker $static_c1_atomic_recorder \
                $static_c1_atomic_prefix]]
        lappend static_c1_atomic_preexist_results [expr {
            [dict get $run caught] && [dict get $run stdout] eq "" &&
            [dict get $run stderr] eq "" &&
