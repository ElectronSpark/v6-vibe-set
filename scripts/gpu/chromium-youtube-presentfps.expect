        catch {file delete -force "$static_c1_atomic_dir/symlink-target"}
    }
    static_c1_atomic_reset $static_c1_atomic_artifacts
    set static_c1_atomic_create_failure [static_c1_atomic_run \
        [c1_atomic_outer_terminal_shell_command true \
            $static_c1_atomic_marker $static_c1_atomic_recorder \
            "$static_c1_atomic_dir/missing/terminal"]]
    static_c1_atomic_reset $static_c1_atomic_artifacts
    set static_c1_atomic_command_failure [static_c1_atomic_run \
