    }
    set static_fb_v2_decimal_validator_matrix [expr {
        [lsearch -exact $static_fb_v2_decimal_accepts 0] < 0 &&
        [lsearch -exact $static_fb_v2_decimal_rejects 0] < 0
    }]
    # Static C1 actual-helper children keep a finite rlimit without changing
    # the generated helper's own capture/transport behavior.  2048 512-byte
    # blocks are 1 MiB: above the helper's 999999-byte capture guard, the
    # 131072-byte valid input cap (and its one-byte over-cap fixture), and the
    # calculated 357781-byte inner CRLF recorder envelope (the static stub's
    # LF rows file is 357080 bytes).  Outer marker and normal-writer terms
    # remain in the timeout algebra, not this child-file bound.  The child
    # cannot create an unbounded capture, row, or combined-output artifact.
    set static_fb_v2_file_limit_blocks 2048
    set static_fb_v2_file_limit_bytes [expr {$static_fb_v2_file_limit_blocks * 512}]
    set static_fb_v2_max_capture_bytes 999999
    set static_fb_v2_max_valid_input_bytes $fbstat_transport_payload_cap
    set static_fb_v2_max_fixture_input_bytes [expr {$fbstat_transport_payload_cap + 1}]
    set static_fb_v2_max_recorder_rows_bytes [dict get $static_fb_timeout physical_bytes]
    set static_fb_v2_max_stub_rows_bytes [expr {
        $static_fb_v2_max_recorder_rows_bytes - [dict get $static_fb_timeout record_count]
    }]
    if {$static_fb_v2_file_limit_blocks != 2048 ||
        $static_fb_v2_file_limit_bytes != 1048576 ||
        $static_fb_v2_max_valid_input_bytes != 131072 ||
        $static_fb_v2_max_capture_bytes >= $static_fb_v2_file_limit_bytes ||
        $static_fb_v2_max_fixture_input_bytes >= $static_fb_v2_file_limit_bytes ||
        $static_fb_v2_max_recorder_rows_bytes != 357781 ||
        $static_fb_v2_max_stub_rows_bytes != 357080 ||
        $static_fb_v2_max_recorder_rows_bytes >= $static_fb_v2_file_limit_bytes ||
        $static_fb_v2_max_stub_rows_bytes >= $static_fb_v2_file_limit_bytes ||
        [string first {raw_bytes=$3; [ "$raw_bytes" -le 999999 ] || exit 68} $static_fb_helper] < 0} {
        fail_preflight "static-check-fbstat-v2-helper-observer-file-bound blocks=$static_fb_v2_file_limit_blocks bytes=$static_fb_v2_file_limit_bytes max_capture=$static_fb_v2_max_capture_bytes max_input=$static_fb_v2_max_valid_input_bytes fixture_input=$static_fb_v2_max_fixture_input_bytes max_rows=$static_fb_v2_max_recorder_rows_bytes max_stub_rows=$static_fb_v2_max_stub_rows_bytes"
    }
    proc static_fb_v2_write_binary {path payload} {
        set fh [open $path wb]
        fconfigure $fh -translation binary -encoding binary
        puts -nonewline $fh $payload
        close $fh
    }
    proc static_fb_v2_bounded_report {value {cap 128}} {
        set bytes [string bytelength $value]
        set first [string range $value 0 [expr {$cap - 1}]]
        set last [expr {$bytes > $cap ? [string range $value end-[expr {$cap - 1}] end] : $first}]
        return "bytes=$bytes first_hex=[binary encode hex $first] last_hex=[binary encode hex $last] truncated=[expr {$bytes > $cap}]"
    }
    proc static_fb_v2_file_snapshot {path {cap 256}} {
        if {[catch {file type $path} type] || $type ne "file"} {
            return [dict create present 0 regular 0 bytes 0 first_hex {} last_hex {} truncated 0]
        }
        set bytes [file size $path]
        if {[catch {open $path rb} fh]} {
            return [dict create present 1 regular 1 bytes $bytes first_hex {} last_hex {} truncated 1]
        }
        fconfigure $fh -translation binary -encoding binary
        set first [read $fh [expr {$bytes < $cap ? $bytes : $cap}]]
        if {$bytes > $cap} {
            seek $fh [expr {$bytes - $cap}] start
            set last [read $fh $cap]
        } else {
            set last $first
        }
        close $fh
        return [dict create present 1 regular 1 bytes $bytes \
            first_hex [binary encode hex $first] last_hex [binary encode hex $last] \
            truncated [expr {$bytes > $cap}]]
    }
    proc static_fb_v2_child_status {caught options} {
        set errorcode {}
        if {$caught && [dict exists $options -errorcode]} {
            set errorcode [dict get $options -errorcode]
        }
        set exit_code [expr {$caught ? "unavailable" : 0}]
        set signal none
        if {[lindex $errorcode 0] eq "CHILDSTATUS" && [llength $errorcode] == 3} {
            set exit_code [lindex $errorcode 2]
        } elseif {[lindex $errorcode 0] eq "CHILDKILLED" && [llength $errorcode] >= 3} {
            set signal [lindex $errorcode 2]
        }
        return [dict create caught $caught errorcode $errorcode exit_code $exit_code signal $signal]
    }
    set static_fb_v2_childstatus_fixture [static_fb_v2_child_status 1 \
        [dict create -errorcode [list CHILDSTATUS 4242 68]]]
    set static_fb_v2_childkilled_fixture [static_fb_v2_child_status 1 \
        [dict create -errorcode [list CHILDKILLED 4243 SIGTERM observer-test]]]
    set static_fb_v2_other_errorcode_fixture [static_fb_v2_child_status 1 \
        [dict create -errorcode [list POSIX EACCES observer-test]]]
    set static_fb_v2_child_status_source_lock [expr {
        [string first {eq "CHILDSTATUS"} [info body static_fb_v2_child_status]] >= 0 &&
        [string first {eq "CHILDKILLED"} [info body static_fb_v2_child_status]] >= 0
    }]
    set static_fb_v2_child_status_fixture_matrix [expr {
        $static_fb_v2_child_status_source_lock &&
        [dict get $static_fb_v2_childstatus_fixture caught] &&
        [dict get $static_fb_v2_childstatus_fixture errorcode] eq {CHILDSTATUS 4242 68} &&
        [dict get $static_fb_v2_childstatus_fixture exit_code] == 68 &&
        [dict get $static_fb_v2_childstatus_fixture signal] eq "none" &&
        [dict get $static_fb_v2_childkilled_fixture caught] &&
        [dict get $static_fb_v2_childkilled_fixture errorcode] eq {CHILDKILLED 4243 SIGTERM observer-test} &&
        [dict get $static_fb_v2_childkilled_fixture exit_code] eq "unavailable" &&
        [dict get $static_fb_v2_childkilled_fixture signal] eq "SIGTERM" &&
        [dict get $static_fb_v2_other_errorcode_fixture caught] &&
        [dict get $static_fb_v2_other_errorcode_fixture errorcode] eq {POSIX EACCES observer-test} &&
        [dict get $static_fb_v2_other_errorcode_fixture exit_code] eq "unavailable" &&
        [dict get $static_fb_v2_other_errorcode_fixture signal] eq "none"
    }]
    if {!$static_fb_v2_child_status_fixture_matrix} {
        fail_preflight "static-check-fbstat-v2-helper-observer-child-status exit=$static_fb_v2_childstatus_fixture killed=$static_fb_v2_childkilled_fixture other=$static_fb_v2_other_errorcode_fixture"
    }
    proc static_fb_v2_row_metadata {row} {
        return "bytes=[string bytelength $row] sha256=[fbstat_transport_digest $row] [static_fb_v2_bounded_report $row 64]"
    }
    proc static_fb_v2_stub_rows_snapshot {path {cap 524288}} {
        set snapshot [static_fb_v2_file_snapshot $path 128]
        dict set snapshot count unavailable
        dict set snapshot rows {}
        dict set snapshot first_row none
        dict set snapshot last_row none
        if {![dict get $snapshot present] || ![dict get $snapshot regular] ||
            [dict get $snapshot bytes] > $cap} {
            return $snapshot
        }
        set fh [open $path rb]
        fconfigure $fh -translation binary -encoding binary
        set text [read $fh]
        close $fh
        set trimmed [string trimright $text "\n"]
        set rows [expr {$trimmed eq "" ? {} : [split $trimmed "\n"]}]
        dict set snapshot count [llength $rows]
        dict set snapshot rows $rows
        if {[llength $rows] > 0} {
            dict set snapshot first_row [static_fb_v2_row_metadata [lindex $rows 0]]
            dict set snapshot last_row [static_fb_v2_row_metadata [lindex $rows end]]
        }
        return $snapshot
    }
    proc static_fb_v2_residue_snapshot {tag nonce} {
        set paths [glob -nocomplain "/dev/shm/yt-fbstat-${tag}-${nonce}-*"]
        set names {}
        foreach path [lrange $paths 0 3] {
            lappend names [file tail $path]
        }
        return [dict create count [llength $paths] names [join $names ,] \
            truncated [expr {[llength $paths] > 4}]]
    }
    proc static_fb_v2_case_not_run {name} {
        return [dict create name $name ran 0 status not-run exit_code unavailable \
            signal none errorcode {} child_message none child_io {} input_size unavailable \
            input_sha unavailable input_file [dict create present 0 regular 0 bytes 0 first_hex {} last_hex {} truncated 0] \
            helper_sha unavailable argv {} row_count unavailable \
            first_row none last_row none cleanup unavailable rows {} \
            row_file [dict create present 0 regular 0 bytes 0 first_hex {} last_hex {} truncated 0] \
            count_file [dict create present 0 regular 0 bytes 0 first_hex {} last_hex {} truncated 0] \
            count_artifact_file [dict create present 0 regular 0 bytes 0 first_hex {} last_hex {} truncated 0] \
            residue [dict create count unavailable names none truncated 0]]
    }
    proc static_fb_v2_case_compact {record} {
        set errorcode [dict get $record errorcode]
        set errorcode [expr {$errorcode eq {} ? "none" : [join $errorcode ,]}]
        set row_file [dict get $record row_file]
        set count_file [dict get $record count_file]
        set count_artifact_file [dict get $record count_artifact_file]
        set residue [dict get $record residue]
        return "[dict get $record name](ran=[dict get $record ran],status=[dict get $record status],exit=[dict get $record exit_code],signal=[dict get $record signal],errorcode=$errorcode,msg=[dict get $record child_message],input=[dict get $record input_size]/[dict get $record input_sha],helper=[dict get $record helper_sha],argv=[dict get $record argv],io=[dict get $record child_io],rows=present:[dict get $row_file present],regular:[dict get $row_file regular],bytes:[dict get $row_file bytes],count:[dict get $record row_count],first:[dict get $record first_row],last:[dict get $record last_row],count_file=present:[dict get $count_file present],regular:[dict get $count_file regular],bytes:[dict get $count_file bytes],first_hex:[dict get $count_file first_hex],last_hex:[dict get $count_file last_hex],count_artifact=present:[dict get $count_artifact_file present],regular:[dict get $count_artifact_file regular],bytes:[dict get $count_artifact_file bytes],first_hex:[dict get $count_artifact_file first_hex],last_hex:[dict get $count_artifact_file last_hex],cleanup:[dict get $record cleanup],residue:[dict get $residue count]/[dict get $residue names]/[dict get $residue truncated])"
    }
    proc static_fb_v2_case_records_compact {records} {
        set report {}
        foreach name {empty binary multiline exact_cap overcap} {
            lappend report [static_fb_v2_case_compact [dict get $records $name]]
        }
        return [join $report { | }]
    }
    proc static_fb_v2_helper_run {name dir helper payload_path records_path payload fail_at} {
        if {![regexp {^[a-z_]+$} $name]} {
            error "invalid static fbstat V2 case name"
        }
        set input_artifact "$dir/actual-$name.input.bin"
        set child_output "$dir/actual-$name.child-output.txt"
        set rows_artifact "$dir/actual-$name.rows.txt"
        set count_artifact "$dir/actual-$name.count.txt"
        static_fb_v2_write_binary $input_artifact $payload
        static_fb_v2_write_binary $payload_path $payload
        catch {file delete -force $records_path "$dir/count" $child_output $rows_artifact $count_artifact}
        set command [list /bin/bash -c {ulimit -f 2048; exec "$@"} \
            static-fbstat-v2-io-limit env "PATH=$dir:$::env(PATH)" "YT_FBSTAT_STATIC_PAYLOAD=$payload_path" \
            "YT_FBSTAT_STATIC_RECORDS=$records_path" "YT_FBSTAT_STATIC_COUNT=$dir/count" \
            "YT_FBSTAT_STATIC_FAIL_AT=$fail_at" bash $helper probe1 fbfstatstaticnonce]
        set caught [catch {exec {*}$command >$child_output 2>@1} child_message options]
        set child_status [static_fb_v2_child_status $caught $options]
        set child_io [static_fb_v2_file_snapshot $child_output 256]
        set rows_snapshot [static_fb_v2_stub_rows_snapshot $records_path]
        set count_snapshot [static_fb_v2_file_snapshot "$dir/count" 64]
        if {[dict get $rows_snapshot present] && [dict get $rows_snapshot regular] &&
            [dict get $rows_snapshot bytes] <= 524288} {
            catch {file copy -force $records_path $rows_artifact}
        }
        if {[dict get $count_snapshot present] && [dict get $count_snapshot regular] &&
            [dict get $count_snapshot bytes] <= 64} {
            catch {file copy -force "$dir/count" $count_artifact}
        }
        set count_artifact_snapshot [static_fb_v2_file_snapshot $count_artifact 64]
        set input_snapshot [static_fb_v2_file_snapshot $input_artifact 64]
        set residue [static_fb_v2_residue_snapshot probe1 fbfstatstaticnonce]
        set command_argv {bash -c <bounded-io-wrapper> env PATH=<case-dir> YT_FBSTAT_STATIC_PAYLOAD=<payload> YT_FBSTAT_STATIC_RECORDS=<rows> YT_FBSTAT_STATIC_COUNT=<count> YT_FBSTAT_STATIC_FAIL_AT=<controlled> bash <helper> probe1 fbfstatstaticnonce}
        return [dict create name $name ran 1 status [expr {$caught ? "failed" : "ok"}] \
            exit_code [dict get $child_status exit_code] signal [dict get $child_status signal] \
            errorcode [dict get $child_status errorcode] \
            child_message [static_fb_v2_bounded_report $child_message] child_io $child_io \
            input_size [dict get $input_snapshot bytes] input_sha [sha256_file $input_artifact] \
            input_file $input_snapshot \
            helper_sha [sha256_file $helper] argv $command_argv row_file $rows_snapshot \
            count_file $count_snapshot \
            count_artifact_file $count_artifact_snapshot \
            row_count [dict get $rows_snapshot count] first_row [dict get $rows_snapshot first_row] \
            last_row [dict get $rows_snapshot last_row] \
            cleanup [expr {[dict get $residue count] == 0}] residue $residue \
            rows [dict get $rows_snapshot rows] input_artifact $input_artifact \
            child_output $child_output rows_artifact $rows_artifact count_artifact $count_artifact]
    }
    if {[string first {ulimit -f 2048; exec "$@"} [info body static_fb_v2_helper_run]] < 0} {
        fail_preflight "static-check-fbstat-v2-helper-observer-rlimit-source"
    }
    proc static_fb_v2_helper_clean {tag nonce} {
        return [expr {[llength [glob -nocomplain "/dev/shm/yt-fbstat-${tag}-${nonce}-*"]] == 0}]
    }
    set static_fb_v2_case_records {}
    foreach name {empty binary multiline exact_cap overcap} {
        dict set static_fb_v2_case_records $name [static_fb_v2_case_not_run $name]
    }
    foreach {name payload expect_pass} [list \
            empty {} 1 binary $static_fb_v2_binary_payload 1 \
            multiline "first\nsecond\nthird\n" 1 \
            exact_cap [string repeat x $fbstat_transport_payload_cap] 1 \
            overcap [string repeat x [expr {$fbstat_transport_payload_cap + 1}]] 0] {
        set run [static_fb_v2_helper_run $name $static_fb_helper_dir $static_fb_helper_path \
            $static_fb_payload_path $static_fb_records_path $payload 0]
        dict set static_fb_v2_case_records $name $run
        if {[dict get $run status] ne "ok"} {
            fail_preflight "static-check-fbstat-v2-helper-case-failed cases=[static_fb_v2_case_records_compact $static_fb_v2_case_records]"
        }
        set call_count [dict get $run count_file]
        if {![dict get $call_count present] || ![dict get $call_count regular] ||
            [dict get $call_count bytes] != 2 ||
            [dict get $call_count first_hex] ne "310a"} {
            fail_preflight "static-check-fbstat-v2-helper-batch-call-count cases=[static_fb_v2_case_records_compact $static_fb_v2_case_records]"
        }
        if {$name eq "binary"} {
            set input_file [dict get $run input_file]
            if {[dict get $run input_size] != 4 ||
                [dict get $run input_sha] ne $static_fb_v2_binary_sha ||
                ![dict get $input_file present] || ![dict get $input_file regular] ||
                [dict get $input_file bytes] != 4 ||
                [dict get $input_file first_hex] ne $static_fb_v2_binary_hex ||
                [dict get $input_file last_hex] ne $static_fb_v2_binary_hex} {
                fail_preflight "static-check-fbstat-v2-helper-binary-fixture record=[static_fb_v2_case_compact $run]"
            }
        }
        set rows [dict get $run rows]
        foreach row $rows {
            if {[string first "\n" $row] >= 0 || [string bytelength $row] > 510} {
                fail_preflight "static-check-fbstat-v2-helper-case-record-bound cases=[static_fb_v2_case_records_compact $static_fb_v2_case_records]"
            }
        }
        set wire "[join $rows \n]\n$static_fb_marker:RC:0\n$static_fb_marker:FENCE\n"
        set decoded [fbstat_transport_decode $wire probe1 fbfstatstaticnonce $static_fb_marker]
        if {[lindex $decoded 0] != $expect_pass ||
            ($expect_pass && [binary encode hex [lindex $decoded 2]] ne [binary encode hex $payload]) ||
            (!$expect_pass && ![string match {transport-truncated*} [lindex $decoded 1]])} {
            fail_preflight "static-check-fbstat-v2-helper-case-decoded cases=[static_fb_v2_case_records_compact $static_fb_v2_case_records] decoded=[static_fb_v2_bounded_report $decoded 256]"
        }
        if {![dict get $run cleanup]} {
            fail_preflight "static-check-fbstat-v2-helper-case-cleanup cases=[static_fb_v2_case_records_compact $static_fb_v2_case_records]"
        }
    }
    set recorder_failure [static_fb_v2_helper_run recorder_failure $static_fb_helper_dir $static_fb_helper_path \
        $static_fb_payload_path $static_fb_records_path "failure" 1]
    if {[dict get $recorder_failure status] eq "ok"} {
        fail_preflight "static-check-fbstat-v2-recorder-failure-claimed record=[static_fb_v2_case_compact $recorder_failure]"
    }
    set recorder_failure_count [dict get $recorder_failure count_file]
    if {![dict get $recorder_failure_count present] ||
        [dict get $recorder_failure_count first_hex] ne "310a"} {
        fail_preflight "static-check-fbstat-v2-recorder-failure-call-count record=[static_fb_v2_case_compact $recorder_failure]"
    }
    if {![dict get $recorder_failure cleanup]} {
        fail_preflight "static-check-fbstat-v2-recorder-failure-cleanup record=[static_fb_v2_case_compact $recorder_failure]"
    }
    set static_c1_v2_contiguity [expr {![lindex [fbstat_transport_decode $static_fb_interior_gap $static_fb_tag $static_fb_nonce $static_fb_marker] 0] && [lindex [fbstat_transport_decode $static_fb_outside_gap $static_fb_tag $static_fb_nonce $static_fb_marker] 0]}]
    set static_c1_v2_wc_route [expr {
        [string first {retained_count=$(/bin/wc < "$retained"} $static_fb_helper] >= 0 &&
        [string first {/bin/wc -c} $static_fb_helper] < 0 &&
        $static_fb_v2_decimal_source_lock && $static_fb_v2_decimal_validator_matrix &&
        $static_fb_v2_decoder_source_lock
    }]
    set static_c1_v2_recorder_route [expr {
        [string first {recorder=/bin/consolerecord} $static_fb_helper] >= 0 &&
        [string first {recorder=/bin/_consolerecord} $static_fb_helper] < 0 &&
        [string first "recorder=$static_fb_recorder" $static_fb_stub_helper] >= 0 &&
        [string first {"$recorder" --batch-file "$envelope" || exit 77} $static_fb_helper] >= 0 &&
        [string first {"$recorder" "$1"} $static_fb_helper] < 0 &&
        $static_fb_v2_batch_call_first >= 0 &&
        [string first $static_fb_v2_batch_call $static_fb_helper \
            [expr {$static_fb_v2_batch_call_first + 1}]] < 0
    }]
    set static_c1_v2_cleanup [static_fb_v2_helper_clean probe1 fbfstatstaticnonce]
    set static_c1_v2_timeout_expected [expr {int(ceil(double(
        [dict get $static_fb_timeout wire_ms] + 100 + 5000) / 1000.0))}]
    set static_c1_v2_timeout [expr {
        [dict get $static_fb_timeout record_count] == 701 &&
        [dict get $static_fb_timeout normal_writer_physical_bytes] == 128 &&
        [dict get $static_fb_timeout envelope_lock_acquisitions] == 1 &&
        [dict get $static_fb_timeout atomic_terminal_lock_acquisitions] == 1 &&
        [dict get $static_fb_timeout total_lock_acquisitions] == 2 &&
        [dict get $static_fb_timeout per_record_drain_ms] == 0 &&
        [dict get $static_fb_timeout per_record_drain_total_ms] == 0 &&
        [dict get $static_fb_timeout lock_ms] == 100 &&
        [dict get $static_fb_timeout total_ms] ==
            [expr {[dict get $static_fb_timeout wire_ms] + 100 + 5000}] &&
        [dict get $static_fb_timeout seconds] == $static_c1_v2_timeout_expected
    }]
    set static_c1_v2_case_matrix [expr {
        $static_c1_v2_contiguity && $static_c1_v2_wc_route &&
        $static_c1_v2_recorder_route && $static_c1_v2_cleanup &&
        $static_c1_v2_timeout && $static_c1_atomic_source_contract &&
        $static_fb_live_37_pass && $static_fb_live_36_fail &&
        $static_fb_v2_child_status_fixture_matrix
    }]

    # Exact relevant shape from T1 idle attempt 1: scalar/backend rows were
    # clean, but an asynchronous virtio log split the separation matrix.  The
    # continuation must never be spliced back onto the candidate row.
    set t1_corrupt_fbstat_excerpt {
backend virgl flags 0x27 renderer OpenGL via virtio-gpu virgl
backend_opengl_submit 1
backend_opengl_submit_gate open
backend_virgl_opengl 1
opengl_submit_backend_separation_matrix backend=virgl dxg_t[r4an2s2p1o5rt4=704 1d134]d kvmit=r0t ivoi_rggl_poup: enpgalge-f=1 lbiapck epnrde_soepnetn grle_ssuoubrmciet==1 al4lo wesdi_szue=1b280mxi8t0_b0a caklerneda=dvy_biorugln hdy=p0e rv_drxegg_itsrtanesrpeodr=t1_i s_rseubbimnidt==00  sheytp_ecrovu_nd3dtk=m3 ats_yins_cs_uscbamniotu=t0= 0kv
m_virgl_submit_allowed=1 native_present_credit=0 opengl_submit_credit=1 status=PASS
d3d12_native_completion_not_kms_matrix generic_display_last_complete=6 kms_vblank_display_correlated=1 kms_vblank_source_software_display=1 kms_vblank_source_native_hw=0 kms_atomic_out_fence_display_correlated=0 kms_atomic_out_fence_software_scanout_correlated=0 kms_page_flip_events=5 page_flip_events_software_blit=5 page_flip_events_native_hw=0 display_wait_is_native=0 kms_generic_display_credit=0 native_present_credit=0 opengl_submit_credit=0 status=PASS
virgl_bo_presents 6
}
    set t1_corrupt_classified [classify_fbstat_sample $t1_corrupt_fbstat_excerpt 1]
    if {[lindex $t1_corrupt_classified 0] ne "RETRY" ||
        ![string match {corrupt-opengl-submit-backend-separation-matrix*} [lindex $t1_corrupt_classified 2]]} {
        fail_preflight "static-check-t1-corrupt-classification parsed=$t1_corrupt_classified"
    }
    set t1_retry_selected [select_prelaunch_fbstat_attempt [list $t1_corrupt_fbstat_excerpt $c1_t2_fbstat_excerpt]]
    if {![lindex $t1_retry_selected 0] || [lindex $t1_retry_selected 1] ne "2" ||
        [lindex [lindex $t1_retry_selected 2] 2] ne "6198"} {
        fail_preflight "static-check-t1-corrupt-then-clean-retry parsed=$t1_retry_selected"
    }
    set t1_all_corrupt [select_prelaunch_fbstat_attempt [list \
        $t1_corrupt_fbstat_excerpt $t1_corrupt_fbstat_excerpt $t1_corrupt_fbstat_excerpt]]
    if {[lindex $t1_all_corrupt 0] ||
        ![string match {retry-exhausted*} [lindex $t1_all_corrupt 3]]} {
        fail_preflight "static-check-t1-all-corrupt-accepted parsed=$t1_all_corrupt"
    }
    set inconsistent_separation [string map [list \
        {opengl_submit_credit=1 status=PASS} \
        {opengl_submit_credit=0 status=PASS}] $c1_t2_fbstat_excerpt]
    set inconsistent_selected [select_prelaunch_fbstat_attempt [list $inconsistent_separation $c1_t2_fbstat_excerpt]]
    if {[lindex $inconsistent_selected 0] ||
        ![string match {hard-reject*inconsistent-opengl-submit-backend-separation-matrix*} [lindex $inconsistent_selected 3]]} {
        fail_preflight "static-check-single-inconsistent-matrix-accepted parsed=$inconsistent_selected"
    }
    set duplicate_separation "$c1_t2_fbstat_excerpt\nopengl_submit_backend_separation_matrix backend=virgl dxg_transport=0 d3dkmt=0 virgl_opengl=1 backend_opengl_submit=1 allowed_submit_backend=virgl hyperv_dxg_transport_is_submit=0 hyperv_d3dkmt_is_submit=0 kvm_virgl_submit_allowed=1 native_present_credit=0 opengl_submit_credit=1 status=PASS\n"
    set duplicate_separation_classified [classify_fbstat_sample $duplicate_separation 1]
    if {[lindex $duplicate_separation_classified 0] ne "HARD" ||
        ![string match {*duplicate-opengl-submit-backend-separation-matrix*} [lindex $duplicate_separation_classified 2]]} {
        fail_preflight "static-check-duplicate-separation-matrix parsed=$duplicate_separation_classified"
    }
    set mixed_missing_flip_duplicate_authority [string map [list \
        {kms_page_flip_events=6197} {old_kms_page_flip_events=6197}] $c1_t2_fbstat_excerpt]
    append mixed_missing_flip_duplicate_authority "\nvirgl_bo_presents 6198\n"
    set mixed_authority_classified [classify_fbstat_sample $mixed_missing_flip_duplicate_authority 1]
    if {[lindex $mixed_authority_classified 0] ne "HARD" ||
        ![string match {*duplicate-authoritative-virgl_bo_presents*} [lindex $mixed_authority_classified 2]]} {
        fail_preflight "static-check-missing-flip-masked-duplicate-authority parsed=$mixed_authority_classified"
    }
    set mixed_missing_matrix_conflicting_flip [string map [list \
        {opengl_submit_backend_separation_matrix backend=virgl} \
        {old_opengl_submit_backend_separation_matrix backend=virgl}] $c1_t2_fbstat_excerpt]
    append mixed_missing_matrix_conflicting_flip "\nd3d12_native_completion_not_kms_matrix kms_page_flip_events=6199\n"
    set mixed_flip_classified [classify_fbstat_sample $mixed_missing_matrix_conflicting_flip 1]
    if {[lindex $mixed_flip_classified 0] ne "HARD" ||
        ![string match {*conflicting-kms_page_flip_events*} [lindex $mixed_flip_classified 2]]} {
        fail_preflight "static-check-missing-matrix-masked-conflicting-flip parsed=$mixed_flip_classified"
    }
    set mixed_missing_flip_fatal "$mixed_missing_flip_duplicate_authority\nPANIC synthetic-static-marker\n"
    set mixed_fatal_classified [classify_fbstat_sample $mixed_missing_flip_fatal 1]
    if {[lindex $mixed_fatal_classified 0] ne "HARD" ||
        ![string match {*fatal-runtime-marker*} [lindex $mixed_fatal_classified 2]]} {
        fail_preflight "static-check-missing-proof-masked-fatal-marker parsed=$mixed_fatal_classified"
    }

    set redirected_launcher_log {
wayland-chromium-launcher: starting argc=2
wayland-chromium-launcher: launch_marker pid=412
wayland-chromium-launcher: argv_17="--enable-logging=stderr"
wayland-chromium-launcher: child_exec path=/opt/host-gui/wayland-chromium/chrome-linux64/chrome
}
    set redirected_contract [chromium_redirect_log_contract $redirected_launcher_log "" ""]
    if {![lindex $redirected_contract 0]} {
        fail_preflight "static-check-redirected-log-contract parsed=$redirected_contract"
    }
    set missing_log_contract [chromium_redirect_log_contract "" "" ""]
    if {[lindex $missing_log_contract 0] ||
        ![string match {missing-authoritative-launcher-log*} [lindex $missing_log_contract 1]]} {
        fail_preflight "static-check-all-diagnostic-logs-missing parsed=$missing_log_contract"
    }
    set optional_log_contract [chromium_redirect_log_contract \
        $redirected_launcher_log {optional chrome diagnostic line} ""]
    if {![lindex $optional_log_contract 0] ||
        ![string match {*chrome_log=nonempty*} [lindex $optional_log_contract 1]]} {
        fail_preflight "static-check-optional-chrome-log parsed=$optional_log_contract"
    }
    set optional_without_authority [chromium_redirect_log_contract \
        "" {optional chrome diagnostic line} {outer stdio diagnostic line}]
    if {[lindex $optional_without_authority 0]} {
        fail_preflight "static-check-optional-logs-without-authority parsed=$optional_without_authority"
    }
    set launcher_marker_evidence [chromium_diagnostic_evidence "" \
        "$redirected_launcher_log\nEGL_BAD_ATTRIBUTE\nGoogle SwiftShader\nGPU process exited unexpectedly" \
        "" "" "" ""]
    if {![gpu_init_failure_marker $launcher_marker_evidence] ||
        ![software_marker $launcher_marker_evidence] ||
        ![fatal_runtime_marker $launcher_marker_evidence]} {
        fail_preflight "static-check-authoritative-launcher-marker-scan"
    }
    set optional_marker_evidence [chromium_diagnostic_evidence "" \
        $redirected_launcher_log {EGL_BAD_ATTRIBUTE} "" "" ""]
    if {![gpu_init_failure_marker $optional_marker_evidence]} {
        fail_preflight "static-check-optional-log-marker-scan"
    }
    set synthetic {wayland-chromium-launcher: argv_17="--disable-audio-output"}
    if {![regexp "wayland-chromium-launcher: argv_\\d+=\"[regex_quote --disable-audio-output]\"" $synthetic]} {
        fail_preflight "static-check-launcher-regex"
    }
    if {![software_marker {OpenGL renderer string: llvmpipe}] ||
        ![software_marker {GL_RENDERER=Google SwiftShader}] ||
        ![software_marker {ANGLE renderer selected software backend}] ||
        [software_marker {backend virgl renderer OpenGL via virtio-gpu virgl}]} {
        fail_preflight "static-check-software-marker"
    }
    foreach signature {
        {eglCreateContext ES 3.0 failed with error EGL_BAD_ATTRIBUTE}
        {No suitable EGL configs found for initialization.}
        {Fallback eglCreateContext ES 2.0 failed with error EGL_BAD_ATTRIBUTE}
        {Exiting GPU process due to errors during initialization}
    } {
        if {![gpu_init_failure_marker $signature]} {
            fail_preflight "static-check-gpu-init-marker signature=$signature"
        }
    }
    set role_synthetic {kde_chromium_process_evidence fast phase=fast-001 pid=412 ppid=300 comm="chrome" role="gpu-process" cmd="/proc/self/exe --type=gpu-process --use-gl=angle" role_source="type_arg" type_arg="gpu-process" argv0="exe" use_gl="angle"
}
    if {![chromium_gpu_role_marker $role_synthetic]} {
        fail_preflight "static-check-semantic-gpu-role"
    }

    # Host-only reducer for the normal (capturediag=0) render-start receipt.
    # It exercises the exact serial frame grammar and every bounded evidence
    # branch without staging helpers, running guest JS, or starting a VM.
    proc static_render_start_receipt_fixture {
        nonce probe launch_marker launch_digest argv_marker argv_digest
        command_marker source_status source_frame role_status role_frame
        {fbstat_marker YTSTATICFBSTATC5}
    } {
        set source_cursor 0
        set source_bytes 0
        set source_digest unavailable
        set source_tail_truncated 0
        if {$source_status eq "regular"} {
            set source_cursor [string length $source_frame]
            set source_bytes $source_cursor
            set source_digest [render_start_receipt_digest $source_frame]
        } else {
            set source_frame ""
        }
        set role_bytes [string length $role_frame]
        set role_total $role_bytes
        set role_digest [render_start_receipt_digest $role_frame]
        set role_tail_truncated 0
        if {$role_status != 0} {
            set role_state command_failed
        } elseif {[regexp {comm="chrome"[^\n]*role="[^"]+"} $role_frame]} {
            set role_state live
        } else {
            set role_state none_or_exited
        }
        return "YT_RENDER_START_RECEIPT_BEGIN nonce=$nonce probe=$probe\nYT_RENDER_START_RECEIPT_META nonce=$nonce probe=$probe launch_marker=$launch_marker launch_digest=$launch_digest argv_marker=$argv_marker argv_digest=$argv_digest fbstat_marker=$fbstat_marker source_status=$source_status source_cursor=$source_cursor source_bytes=$source_bytes source_digest=$source_digest source_tail_truncated=$source_tail_truncated role_command=fast-census-v1 role_status=$role_status role_total=$role_total role_bytes=$role_bytes role_digest=$role_digest role_tail_truncated=$role_tail_truncated role_state=$role_state\nYT_RENDER_START_RECEIPT_SOURCE_HEX [binary encode hex $source_frame]\nYT_RENDER_START_RECEIPT_ROLE_HEX [binary encode hex $role_frame]\nYT_RENDER_START_RECEIPT_END nonce=$nonce probe=$probe\n${command_marker}:RC:0\n${command_marker}:FENCE\n"
    }
    proc static_role_census_diag_frame {
        nonce probe launch_marker launch_digest argv_marker argv_digest fbstat_marker
        c7_marker payload {overrides {}}
    } {
        global role_census_diag_payload_cap
        set payload_bytes [string bytelength $payload]
        set values [dict create status OK raw_bytes $payload_bytes \
            payload_bytes $payload_bytes cap $role_census_diag_payload_cap truncated 0 \
            digest [render_start_receipt_digest $payload] hex_bytes [expr {$payload_bytes * 2}] \
            payload_hex [binary encode hex $payload]]
        dict for {key value} $overrides {
            if {![dict exists $values $key]} {
                error "static census unknown override $key"
            }
            dict set values $key $value
        }
        set binding "tag=role-census-v1 nonce=$nonce probe=$probe launch_marker=$launch_marker launch_digest=$launch_digest argv_marker=$argv_marker argv_digest=$argv_digest fbstat_marker=$fbstat_marker c7_marker=$c7_marker"
        return "YT_ROLE_CENSUS_DIAG_BEGIN $binding\nYT_ROLE_CENSUS_DIAG_META $binding status=[dict get $values status] raw_bytes=[dict get $values raw_bytes] payload_bytes=[dict get $values payload_bytes] cap=[dict get $values cap] truncated=[dict get $values truncated] digest=[dict get $values digest] hex_bytes=[dict get $values hex_bytes]\nYT_ROLE_CENSUS_DIAG_HEX $binding data=[dict get $values payload_hex]\nYT_ROLE_CENSUS_DIAG_END $binding\n${c7_marker}:RC:0\n${c7_marker}:FENCE\n"
    }
    proc static_role_census_diag_meta_mutate {frame from to} {
        set changed 0
        set output {}
        foreach line [split [string trimright $frame "\n"] "\n"] {
            if {[string match {YT_ROLE_CENSUS_DIAG_META *} $line]} {
                if {[string first $from $line] < 0} {
                    error "static census META mutation source missing: $from"
                }
                set line [string map [list $from $to] $line]
                incr changed
            }
            lappend output $line
        }
        if {$changed != 1} { error "static census META mutation count $changed" }
        return "[join $output \n]\n"
    }
    proc static_source_prethreshold_frame {
        nonce probe launch_marker launch_digest argv_marker argv_digest fbstat_marker
        c8_marker payload {overrides {}}
    } {
        global source_prethreshold_payload_cap
        set payload_bytes [string bytelength $payload]
        set values [dict create status OK source_cursor $payload_bytes \
            payload_bytes $payload_bytes cap $source_prethreshold_payload_cap truncated 0 \
            digest [render_start_receipt_digest $payload] hex_bytes [expr {$payload_bytes * 2}] \
            payload_hex [binary encode hex $payload]]
        dict for {key value} $overrides {
            if {![dict exists $values $key]} {
                error "static source-prethreshold unknown override $key"
            }
            dict set values $key $value
        }
        set binding "tag=source-prethreshold-v1 nonce=$nonce probe=$probe launch_marker=$launch_marker launch_digest=$launch_digest argv_marker=$argv_marker argv_digest=$argv_digest fbstat_marker=$fbstat_marker c8_marker=$c8_marker"
        return "YT_SOURCE_PRETHRESHOLD_BEGIN $binding\nYT_SOURCE_PRETHRESHOLD_META $binding source_path=host-gui-wayland-chromium.log status=[dict get $values status] source_cursor=[dict get $values source_cursor] payload_bytes=[dict get $values payload_bytes] cap=[dict get $values cap] truncated=[dict get $values truncated] digest=[dict get $values digest] hex_bytes=[dict get $values hex_bytes]\nYT_SOURCE_PRETHRESHOLD_HEX $binding data=[dict get $values payload_hex]\nYT_SOURCE_PRETHRESHOLD_END $binding\n${c8_marker}:RC:0\n${c8_marker}:FENCE\n"
    }
    proc static_source_prethreshold_console {payload extension_id {line_number 321}} {
        return "\[412:412:0710/120000.123456:INFO:CONSOLE:$line_number\] \"$payload\", source: chrome-extension://$extension_id/probe.js ($line_number)"
    }
    # C8's static harness executes the production-generated Bash with only
    # source/temp overrides, then subjects its literal stdout to the same C8
    # serial parser used at runtime.  It is host-only: no guest/rootfs claim.
    proc static_source_prethreshold_write_binary {path payload} {
        set fh [open $path wb]
        fconfigure $fh -translation binary -encoding binary
        puts -nonewline $fh $payload
        close $fh
    }
    proc static_source_prethreshold_helper_run {
        helper source source_payload nonce probe launch_marker launch_digest
        argv_marker argv_digest fbstat_marker c8_marker child_output
    } {
        static_source_prethreshold_write_binary $source $source_payload
        catch {file delete -force $child_output}
        set command [list /bin/bash -c {ulimit -f 512; exec "$@"} \
            static-source-prethreshold-io-limit /bin/bash $helper $nonce $probe \
            $launch_marker $launch_digest $argv_marker $argv_digest $fbstat_marker $c8_marker]
        set caught [catch {exec {*}$command >$child_output 2>@1} child_message options]
        set child_status [static_fb_v2_child_status $caught $options]
        set child_io [static_fb_v2_file_snapshot $child_output 256]
        set output {}
        set readable [expr {[dict get $child_io present] && [dict get $child_io regular] &&
            [dict get $child_io bytes] <= 131072}]
        if {$readable} {
            set fh [open $child_output rb]
            fconfigure $fh -translation binary -encoding binary
            set output [read $fh]
            close $fh
        }
        return [dict create run [expr {!$caught && $readable}] output $output \
            errorcode [dict get $child_status errorcode] child_status $child_status \
            child_io $child_io child_message [static_fb_v2_bounded_report $child_message] \
            output_acceptable $readable]
    }
    proc static_source_prethreshold_decimal_validator_run {checker value} {
        set command [list /bin/bash $checker $value]
        return [expr {![catch {exec {*}$command 2>@1}]}]
    }
    proc static_source_prethreshold_helper_clean {prefix} {
        return [expr {[llength [glob -nocomplain "${prefix}-*"]] == 0}]
    }
    proc static_source_prethreshold_rows {text} {
        set rows [split [string trimright $text "\n"] "\n"]
        if {[llength $rows] != 4} {
            error "static source-prethreshold helper row count [llength $rows]"
        }
        foreach {index label} {0 BEGIN 1 META 2 HEX 3 END} {
            if {![string match "YT_SOURCE_PRETHRESHOLD_${label} *" [lindex $rows $index]]} {
                error "static source-prethreshold helper row $index is not $label"
            }
        }
        return $rows
    }
    proc static_source_prethreshold_rows_report {text} {
        set trimmed [string trimright $text "\n"]
        if {$trimmed eq ""} {
            return [dict create ok 0 count 0 detail empty rows {}]
        }
        set rows [split $trimmed "\n"]
        set count [llength $rows]
        if {$count != 4} {
            return [dict create ok 0 count $count detail "count-$count" rows {}]
        }
        foreach {index label} {0 BEGIN 1 META 2 HEX 3 END} {
            if {![string match "YT_SOURCE_PRETHRESHOLD_${label} *" [lindex $rows $index]]} {
                return [dict create ok 0 count $count \
                    detail "label-$index-$label" rows {}]
            }
        }
        return [dict create ok 1 count $count detail pass rows $rows]
    }
    proc static_source_prethreshold_report_token {value {cap 128}} {
        set value [string map [list " " _ "\n" _ "\r" _ "\t" _] $value]
        if {$value eq ""} { return none }
        return [string range $value 0 [expr {$cap - 1}]]
    }
    # Preserve each actual-helper input/output before the next case overwrites
    # the shared source fixture.  The terminal record contains only bounded
    # metadata; the binary source/frame/wire artifacts remain under YT_OUTDIR.
    proc static_source_prethreshold_actual_case {
        name helper source source_payload artifact_dir temp_prefix nonce probe
        launch_marker launch_digest argv_marker argv_digest fbstat_marker c8_marker
        eol preamble expected_payload match_kind extension_id
    } {
        if {![regexp {^[a-z_]+$} $name] || $match_kind ni {exact overcap_prefix}} {
            error "invalid static source-prethreshold actual case"
        }
        set source_artifact "$artifact_dir/actual-$name.source"
        set frame_artifact "$artifact_dir/actual-$name.frame"
        set wire_artifact "$artifact_dir/actual-$name.wire"
        set child_output_artifact "$artifact_dir/actual-$name.child-output.txt"
        static_source_prethreshold_write_binary $source_artifact $source_payload
        set run [static_source_prethreshold_helper_run $helper $source $source_payload \
            $nonce $probe $launch_marker $launch_digest $argv_marker $argv_digest \
            $fbstat_marker $c8_marker $child_output_artifact]
        set frame [dict get $run output]
        static_source_prethreshold_write_binary $frame_artifact $frame
        set rows_report [static_source_prethreshold_rows_report $frame]
        set parsed [list 0 [dict get $rows_report detail] {}]
        if {[dict get $rows_report ok]} {
            set wire [static_source_prethreshold_wire [dict get $rows_report rows] \
                $c8_marker $eol $preamble]
            static_source_prethreshold_write_binary $wire_artifact $wire
            if {[catch {
                source_prethreshold_parse $wire $nonce $probe $launch_marker $launch_digest \
                    $argv_marker $argv_digest $fbstat_marker $c8_marker
            } parse_error]} {
                set parsed [list 0 "parser-error-[static_source_prethreshold_report_token $parse_error]" {}]
            } else {
                set parsed $parse_error
            }
        } else {
            static_source_prethreshold_write_binary $wire_artifact ""
        }
        set meta [lindex $parsed 2]
        set parser_pass [lindex $parsed 0]
        set parser_detail [lindex $parsed 1]
        foreach key {status source_cursor payload_bytes cap truncated hex_bytes} {
            set "meta_$key" unavailable
            if {$parser_pass && [dict exists $meta $key]} {
                set "meta_$key" [dict get $meta $key]
            }
        }
        set payload_match 0
        set derive_state unavailable
        set derive_detail unavailable
        if {$parser_pass && [dict exists $meta payload]} {
            set expected_hex [binary encode hex $expected_payload]
            set payload_match [expr {
                [binary encode hex [dict get $meta payload]] eq $expected_hex
            }]
            set derived [source_prethreshold_derive [dict get $meta payload] $nonce \
                $extension_id 1 0]
            set derive_state [dict get $derived state]
            set derive_detail [dict get $derived detail]
        }
        return [dict create name $name run [dict get $run run] \
            run_error [dict get $run errorcode] \
            run_exit_code [dict get [dict get $run child_status] exit_code] \
            run_signal [dict get [dict get $run child_status] signal] \
            run_child_message [dict get $run child_message] \
            run_child_io [dict get $run child_io] \
            run_output_acceptable [dict get $run output_acceptable] \
            row_ok [dict get $rows_report ok] \
            row_count [dict get $rows_report count] row_detail [dict get $rows_report detail] \
            rows [dict get $rows_report rows] parsed $parsed parser_pass $parser_pass \
            parser_detail $parser_detail meta_status $meta_status \
            meta_source_cursor $meta_source_cursor meta_payload_bytes $meta_payload_bytes \
            meta_cap $meta_cap meta_truncated $meta_truncated meta_hex_bytes $meta_hex_bytes \
            match_kind $match_kind payload_match $payload_match derive_state $derive_state \
            derive_detail $derive_detail cleanup [static_source_prethreshold_helper_clean $temp_prefix] \
            source_artifact $source_artifact frame_artifact $frame_artifact \
            wire_artifact $wire_artifact child_output_artifact $child_output_artifact \
            input_size [string bytelength $source_payload] input_sha [sha256_file $source_artifact] \
            helper_sha [sha256_file $helper] \
            argv {bash -c <bounded-io-wrapper> bash <helper> <nonce> <probe> <launch-marker> <launch-digest> <argv-marker> <argv-digest> <fbstat-marker> <c8-marker>}]
    }
    proc static_source_prethreshold_actual_case_compact {record} {
        set match_label [dict get $record match_kind]
        return [format {%s(run=%s,exit=%s,signal=%s,err=%s,msg=%s,io=%s,rowcount=%s/%s,parse=%s/%s,meta=status:%s,cursor:%s,payload:%s,cap:%s,truncated:%s,hex:%s,%s=%s,derive=%s/%s,input=%s/%s,helper=%s,argv=%s,clean=%s)} \
            [dict get $record name] [dict get $record run] \
            [dict get $record run_exit_code] [dict get $record run_signal] \
            [static_source_prethreshold_report_token [dict get $record run_error]] \
            [dict get $record run_child_message] [dict get $record run_child_io] \
            [dict get $record row_count] [dict get $record row_detail] \
            [dict get $record parser_pass] \
            [static_source_prethreshold_report_token [dict get $record parser_detail]] \
            [dict get $record meta_status] [dict get $record meta_source_cursor] \
            [dict get $record meta_payload_bytes] [dict get $record meta_cap] \
            [dict get $record meta_truncated] [dict get $record meta_hex_bytes] \
            $match_label [dict get $record payload_match] [dict get $record derive_state] \
            [static_source_prethreshold_report_token [dict get $record derive_detail]] \
            [dict get $record input_size] [dict get $record input_sha] \
            [dict get $record helper_sha] [dict get $record argv] \
            [dict get $record cleanup]]
    }
    proc static_source_prethreshold_wire {
        rows marker eol {preamble ""} {outer_rc 0} {outer_fences 1}
    } {
        if {![regexp {^[A-Za-z0-9]+$} $marker] ||
            ![string is integer -strict $outer_fences] || $outer_fences < 0 ||
            !($outer_rc eq "" || [regexp {^[0-9]+$} $outer_rc])} {
            error "invalid static source-prethreshold wire arguments"
        }
        set wire ""
        set index -1
        foreach row $rows {
            incr index
            if {$index == 0} { append wire $preamble }
            append wire "$row$eol"
        }
        if {$outer_rc ne ""} { append wire "${marker}:RC:${outer_rc}$eol" }
        for {set i 0} {$i < $outer_fences} {incr i} {
            append wire "${marker}:FENCE$eol"
        }
        return $wire
    }
    # Execute the generated Bash helper's own fresh-evidence route.  The
    # test-only producer never starts a guest command, but uses the identical
    # purge, regular-file, cap, digest, and semantic-role decisions.
    proc static_render_generated_helper_role_output_parse {output} {
        if {[string first "\r" $output] >= 0} {
            return [list 0 role-output-cr]
        }
        set final_lf 0
        set body $output
        if {[string first "\n" $output] >= 0} {
            if {[string index $output end] ne "\n" ||
                [string first "\n" [string range $output 0 end-1]] >= 0} {
                return [list 0 role-output-lf-shape]
            }
            set final_lf 1
            set body [string range $output 0 end-1]
        }
        if {![regexp {^YT_RENDER_START_ROLE_TEST_STATE (none_or_exited|live|command_failed) total=([0-9]+) bytes=([0-9]+) truncated=([01]) digest=([0-9a-f]{64})$} \
                $body -> state total bytes truncated digest]} {
            return [list 0 role-output-shape]
        }
        return [list 1 $state $total $bytes $truncated $digest $final_lf]
    }
    proc static_render_generated_helper_role_capture {
        helper nonce mode evidence stdout tag {stale ""}
    } {
        global outdir
        set evidence_path "$outdir/static-render-role-evidence-$tag-[pid]"
        set output_path "$outdir/static-render-role-output-$tag-[pid]"
        if {$stale ne ""} { wf $evidence_path $stale }
        set launch_digest [string repeat a 64]
        set argv_digest [string repeat b 64]
        set output {}
        catch {file delete -force $output_path}
        set command [list /bin/bash -c {ulimit -f 128; exec "$@"} \
            static-render-role-io-limit /usr/bin/env YT_RENDER_START_ROLE_TEST_ONLY=1 \
            "YT_RENDER_START_ROLE_TEST_MODE=$mode" \
            "YT_RENDER_START_ROLE_TEST_EVIDENCE=$evidence" \
            "YT_RENDER_START_ROLE_TEST_STDOUT=$stdout" \
            "YT_RENDER_START_ROLE_TEST_EVIDENCE_PATH=$evidence_path" \
            /bin/bash $helper \
            $nonce 1 YTSTATICLAUNCHC1 $launch_digest YTSTATICARGVC2 $argv_digest \
            YTSTATICFBSTATC5]
        set caught [catch {exec {*}$command >$output_path 2>@1} child_message options]
        set child_status [static_fb_v2_child_status $caught $options]
        set child_io [static_fb_v2_file_snapshot $output_path 256]
        set readable [expr {[dict get $child_io present] && [dict get $child_io regular] &&
            [dict get $child_io bytes] <= 32768}]
        if {$readable} {
            set fh [open $output_path rb]
            fconfigure $fh -translation binary -encoding binary
            set output [read $fh]
            close $fh
        }
        set succeeded [expr {!$caught && $readable}]
        set residual [file exists $evidence_path]
        if {!$residual && ![catch {file type $evidence_path}]} { set residual 1 }
        catch {file attributes $evidence_path -permissions 0644}
        catch {file delete -force $evidence_path}
        if {!$succeeded} {
            return [list 0 [static_fb_v2_bounded_report $child_message] $residual \
                $child_status $child_io $output_path]
        }
        set parsed_output [static_render_generated_helper_role_output_parse $output]
        if {![lindex $parsed_output 0]} {
            error "static generated helper role-capture output invalid tag=$tag detail=[lindex $parsed_output 1] io=$child_io message=[static_fb_v2_bounded_report $child_message]"
        }
        lassign [lrange $parsed_output 1 5] state total bytes truncated digest
        return [list 1 $state $total $bytes $truncated $digest $residual \
            $child_status $child_io $output_path]
    }
    proc static_render_generated_helper_role_compact {name record} {
        set succeeded [lindex $record 0]
        if {$succeeded} {
            set child_status [lindex $record 7]
            set child_io [lindex $record 8]
            set output_path [lindex $record 9]
            set message none
        } else {
            set child_status [lindex $record 3]
            set child_io [lindex $record 4]
            set output_path [lindex $record 5]
            set message [lindex $record 1]
        }
        set errorcode [dict get $child_status errorcode]
        set errorcode [expr {$errorcode eq {} ? "none" : [join $errorcode ,]}]
        return [format {%s(success=%s,exit=%s,signal=%s,errorcode=%s,msg=%s,io=%s,artifact=%s)} \
            $name $succeeded [dict get $child_status exit_code] \
            [dict get $child_status signal] $errorcode $message $child_io \
            [file tail $output_path]]
    }
    set static_render_role_compact_fixture_record [list \
        1 none_or_exited 0 0 0 [string repeat 0 64] 0 \
        [dict create caught 0 errorcode {} exit_code 0 signal none] \
        [dict create present 1 regular 1 bytes 42 first_hex aa last_hex bb truncated 0] \
        /tmp/compact-fixture-artifact]
    set static_render_role_compact_fixture \
        [static_render_generated_helper_role_compact compact-fixture \
            $static_render_role_compact_fixture_record]
    set static_render_role_compact_expected \
        {compact-fixture(success=1,exit=0,signal=none,errorcode=none,msg=none,io=present 1 regular 1 bytes 42 first_hex aa last_hex bb truncated 0,artifact=compact-fixture-artifact)}
    set static_render_role_compact_source_lock [expr {
        [string first {return [format {%s(success=%s,exit=%s,signal=%s,errorcode=%s,msg=%s,io=%s,artifact=%s)}} \
            [info body static_render_generated_helper_role_compact]] >= 0 &&
        [string first {$name(} [info body static_render_generated_helper_role_compact]] < 0
    }]
    set static_render_role_compact_contract [expr {
        $static_render_role_compact_source_lock &&
