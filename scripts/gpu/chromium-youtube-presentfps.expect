            {kind=summary schema=1 nonce=0123456789abcdef0123456789abcdef samples=20 width_min=1280 width_max=1280 height_min=720 height_max=720 src_id=blob:https://www.youtube.com/<redacted> quality_selected=hd720 quality_available=hd1080,hd720,large quality_selected_api=1 quality_available_api=1 vpq_available=1 vpq_total_first=1060 vpq_total_last=2200 vpq_total_delta=1140 vpq_dropped_first=11 vpq_dropped_last=30 vpq_dropped_delta=19 webkit_available=1 webkit_decoded_first=1060 webkit_decoded_last=2200 webkit_decoded_delta=1140 webkit_dropped_first=11 webkit_dropped_last=30 webkit_dropped_delta=19 longtask_available=1 longtask_count=5 longtask_duration_ms=120.000}]] \
        [list unavailable-shape [media_probe_mutate_once $media_missing_optional \
