    }
    if {![lindex $static_c1_atomic_clean_async_parse 0] ||
        [lindex $static_c1_atomic_clean_async_parse 2] ne "0" ||
        [lindex $static_c1_atomic_gap_parse 0] ||
        [lindex $static_c1_atomic_contaminated_parse 0] ||
