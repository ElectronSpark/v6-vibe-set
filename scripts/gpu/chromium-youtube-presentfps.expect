set c1_terminal_reducer_raw "$outdir/c1-terminal-reducer.raw.txt"
set c1_terminal_reducer_summary "$outdir/c1-terminal-reducer.txt"
set media_probe_capture_timeout_ms 30000
set media_probe_host_wait_ms 60000
