#!/usr/bin/env expect

set timeout 240
set root [exec sh -c "cd [file dirname [info script]]/../.. && pwd"]
set build "$root/build-x86_64"
set kernel "$build/kernel/build/kernel/xv6.bin"
set fsimg "$build/fs.img"
set outdir "$build/linuxsyscallabitest"
exec mkdir -p $outdir
set runlog "$outdir/run.log"
set tmpimg "$outdir/linuxsyscallabitest.fs.img"
set empty "$outdir/empty-startup"

exec rm -f $runlog $tmpimg $empty
exec cp $fsimg $tmpimg
exec touch $empty
catch { exec debugfs -w -R "rm /etc/startup" $tmpimg >/dev/null 2>@1 }
exec debugfs -w -R "write $empty /etc/startup" $tmpimg >/dev/null 2>@1

set env(DISPLAY_MODE) "nographic"
set env(USE_KVM) "1"
set env(QEMU_GPU) "none"
set env(QEMU_INPUT) "virtio"
set env(QEMU_NET) "0"
set env(QEMU_APPEND) "root=/dev/disk0 netsurf=0 webkit=0 glsmoke=0 video=80x25"

log_file -a $runlog

spawn timeout --foreground 230 bash scripts/launch/run-qemu.sh x86_64 $kernel $tmpimg

expect {
    -re {root:/#} {}
    -re {panic|fatal page fault|coredump: generating} {
        puts "\nLINUXSYSCALLABITEST-FAIL crash log=$runlog"
        exit 2
    }
    timeout {
        puts "\nLINUXSYSCALLABITEST-FAIL no-prompt log=$runlog"
        exit 3
    }
    eof {
        puts "\nLINUXSYSCALLABITEST-FAIL early-eof log=$runlog"
        exit 4
    }
}

send "linuxsyscallabitest; echo LINUXSYSCALLABITEST_RC=\\$?; /bin/shutdown\r"

expect {
    -re {linuxsyscallabitest: all tests passed} {
        exp_continue
    }
    -re {Linux openat absolute dirfd ignore failed} {
        puts "\nLINUXSYSCALLABITEST-FAIL openat log=$runlog"
        exit 5
    }
    -re {LINUXSYSCALLABITEST_RC=0} {
        puts "\nLINUXSYSCALLABITEST-PASS log=$runlog"
        catch { exec pkill -P [exp_pid] qemu-system-x86_64 }
        exit 0
    }
    -re {LINUXSYSCALLABITEST_RC=[1-9][0-9]*} {
        puts "\nLINUXSYSCALLABITEST-FAIL rc log=$runlog"
        exit 6
    }
    -re {panic|fatal page fault|coredump: generating} {
        puts "\nLINUXSYSCALLABITEST-FAIL crash log=$runlog"
        exit 7
    }
    timeout {
        puts "\nLINUXSYSCALLABITEST-FAIL timeout log=$runlog"
        exit 8
    }
    eof {
        puts "\nLINUXSYSCALLABITEST-FAIL eof log=$runlog"
        exit 9
    }
}
