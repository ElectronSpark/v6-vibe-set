# Imported host GUI payloads generated by image/import scripts.
/rootfs-overlay/bin/wayland-chromium
/rootfs-overlay/bin/dbus-daemon-host
/rootfs-overlay/bin/host-*
/rootfs-overlay/bin/kde-*
/rootfs-overlay/bin/xv6-desktop-session
