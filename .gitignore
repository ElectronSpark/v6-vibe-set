# KDE/Qt package payloads are staged from apt archives into build overlays.
/rootfs-overlay/opt/kde-noble/
/rootfs-overlay/usr/bin/
/rootfs-overlay/usr/lib/
/rootfs-overlay/usr/lib64/
/rootfs-overlay/usr/libexec/
/rootfs-overlay/usr/sbin/
/rootfs-overlay/usr/share/*
!/rootfs-overlay/usr/share/alsa/
/rootfs-overlay/usr/share/alsa/*
!/rootfs-overlay/usr/share/alsa/alsa.conf
!/rootfs-overlay/usr/share/dbus-1/
/rootfs-overlay/usr/share/dbus-1/*
!/rootfs-overlay/usr/share/dbus-1/xv6-session.conf
!/rootfs-overlay/usr/share/dbus-1/xv6-system.conf
/rootfs-overlay/var/cache/
/rootfs-overlay/var/lib/

# Captures and generated media stay in build dirs.
/xv6-*.png
/tmp/

# Local Docker WebKit runtime context; large binary payload, never commit.
/.docker-webkit-ref-sysroot/

# Local Hyper-V VM disk image; large binary payload, never commit.

# Hyper-V/WSL GPU-PV D3D12 user-mode runtime staged by scripts/stage-gpup-umd.sh.
# Proprietary NVIDIA/Microsoft binaries; never commit, never redistribute.
/rootfs-overlay/usr/lib/wsl/

# d3d12probe build artifacts and staged binary (built from source on demand).
/user/programs/d3d12probe/d3d12probe-host
/rootfs-overlay/bin/d3d12probe
