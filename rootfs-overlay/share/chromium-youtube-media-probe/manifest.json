{
  "manifest_version": 3,
  "name": "xv6 YouTube media-state probe",
  "version": "1.1.0",
  "description": "Default-off bounded media-state and optional hd720 selector evidence for the xv6 YouTube performance harness.",
  "key": "",
  "permissions": ["tabs", "webNavigation"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["document-start.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["probe-lib.js", "probe.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
