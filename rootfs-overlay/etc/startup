# /etc/startup — services launched by init at boot.
#
# One command per line; lines beginning with '#' are comments.
# Tokens are split on whitespace; no quoting or shell expansion.
# Each entry is fork()+exec()'d as an independent process.

/bin/dbus-daemon-host --config-file=/usr/share/dbus-1/xv6-system.conf --nofork --nopidfile
/bin/dbus-daemon-host --config-file=/usr/share/dbus-1/xv6-session.conf --nofork --nopidfile
DBUS_SYSTEM_BUS_ADDRESS=unix:abstract=xv6_system_bus /bin/xv6-login1-shim
XV6_DESKTOP_DEFAULT=kde /bin/xv6-desktop-session
